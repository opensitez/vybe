(module
  (memory $source 1 1)
  (memory $destination 1 1)
  (func (export "_start") (local $index i32)
    (memory.fill $source (i32.const 0) (i32.const 293) (i32.const 64))
    (memory.fill $destination (i32.const 0) (i32.const 170) (i32.const 64))
    (memory.copy $destination $source (i32.const 4) (i32.const 8) (i32.const 24))
    (loop $verify
      (if (i32.ne (i32.load8_u $source (local.get $index)) (i32.const 37))
        (then unreachable))
      (if (i32.ne (i32.load8_u $destination (local.get $index))
        (if (result i32) (i32.and (i32.ge_u (local.get $index) (i32.const 4))
                                 (i32.lt_u (local.get $index) (i32.const 28)))
          (then (i32.const 37)) (else (i32.const 170))))
        (then unreachable))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      (br_if $verify (i32.lt_u (local.get $index) (i32.const 64))))
    (if (i32.ne (memory.grow $destination (i32.const 0)) (i32.const 1))
      (then unreachable))))

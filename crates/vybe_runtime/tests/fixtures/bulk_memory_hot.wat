;; Standalone bounded bulk-memory correctness and profiling workload.
;; No imports. Run the emitted module with vybex --debug-report.
(module
  (memory 1)
  (data $payload "bulkdata")
  (func $exercise (param $size i32) (param $rounds i32)
    (local $index i32)
    (memory.fill (i32.const 0) (i32.const 293) (local.get $size))
    (loop $again
      (memory.fill (i32.const 8192) (i32.const 170) (local.get $size))
      (memory.copy (i32.const 8192) (i32.const 0) (local.get $size))
      (local.set $rounds (i32.sub (local.get $rounds) (i32.const 1)))
      (br_if $again (local.get $rounds)))
    (loop $verify
      (if (i32.ne (i32.load8_u (i32.add (i32.const 8192) (local.get $index)))
                  (i32.const 37))
        (then unreachable))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      (br_if $verify (i32.lt_u (local.get $index) (local.get $size))))
    (if (i32.or (i32.load8_u (i32.const 8191))
                (i32.load8_u (i32.add (i32.const 8192) (local.get $size))))
      (then unreachable)))
  (func (export "_start")
    (local $index i32)
    (call $exercise (i32.const 8) (i32.const 8192))
    (call $exercise (i32.const 64) (i32.const 8192))
    (call $exercise (i32.const 4096) (i32.const 8192))
    (loop $seed
      (i32.store8 (local.get $index) (local.get $index))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      (br_if $seed (i32.lt_u (local.get $index) (i32.const 32))))
    (memory.copy (i32.const 7) (i32.const 0) (i32.const 25))
    (local.set $index (i32.const 0))
    (loop $forward
      (if (i32.ne (i32.load8_u (i32.add (i32.const 7) (local.get $index)))
                  (local.get $index))
        (then unreachable))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      (br_if $forward (i32.lt_u (local.get $index) (i32.const 25))))
    (memory.copy (i32.const 0) (i32.const 7) (i32.const 25))
    (local.set $index (i32.const 0))
    (loop $backward
      (if (i32.ne (i32.load8_u (local.get $index)) (local.get $index))
        (then unreachable))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      (br_if $backward (i32.lt_u (local.get $index) (i32.const 25))))
    (memory.copy (i32.const 65536) (i32.const 65536) (i32.const 0))
    (memory.fill (i32.const 65536) (i32.const 511) (i32.const 0))
    (memory.init $payload (i32.const 12288) (i32.const 0) (i32.const 8))
    (data.drop $payload)
    (memory.init $payload (i32.const 65536) (i32.const 0) (i32.const 0))
    (if (i32.ne (i32.load (i32.const 12288)) (i32.const 1802270050))
      (then unreachable)))
)

# JavaScript Grammar Definition
# ─────────────────────────────

[language]
name = "javascript"
case_sensitive = true
statement_terminator = ";"
asi = true   # automatic semicolon insertion

[lexer]
comment_line = "//"
comment_block = ["/*", "*/"]

string_delimiters = ["'", "\""]
template_string = "`"          # with ${expr} interpolation
interpolation = ["${", "}"]

# Regex literals: /pattern/flags
regex_delimiters = ["/", "/"]

keywords = [
  "var", "let", "const", "function", "class", "extends",
  "if", "else", "for", "while", "do", "switch", "case", "default",
  "break", "continue", "return", "throw",
  "try", "catch", "finally",
  "new", "this", "super",
  "import", "export", "from", "as",
  "typeof", "instanceof", "in", "of", "void", "delete",
  "async", "await", "yield",
  "null", "undefined", "true", "false",
  "static", "get", "set",
]

operators = [
  "===", "!==", "==", "!=",
  ">>>", ">>", "<<",
  "&&", "||", "??",
  "**",
  "<=", ">=", "=>",
  "+=", "-=", "*=", "/=", "%=", "**=",
  "&=", "|=", "^=", "<<=", ">>=", ">>>=",
  "&&=", "||=", "??=",
  "++", "--",
  "?.", "...",
  "+", "-", "*", "/", "%",
  "&", "|", "^", "~",
  "<", ">", "=",
  "!", "?",
  "(", ")", "{", "}", "[", "]",
  ".", ",", ";", ":",
]

[operators]

[[operators.prefix]]
ops = ["!", "-", "+", "~", "typeof", "void", "delete", "await", "++", "--", "..."]

[[operators.postfix]]
ops = ["++", "--"]

[[operators.infix]]
precedence = 1
ops = ["||", "??"]
assoc = "left"

[[operators.infix]]
precedence = 2
ops = ["&&"]
assoc = "left"

[[operators.infix]]
precedence = 3
ops = ["|"]
assoc = "left"

[[operators.infix]]
precedence = 4
ops = ["^"]
assoc = "left"

[[operators.infix]]
precedence = 5
ops = ["&"]
assoc = "left"

[[operators.infix]]
precedence = 6
ops = ["==", "!=", "===", "!=="]
assoc = "left"

[[operators.infix]]
precedence = 7
ops = ["<", ">", "<=", ">=", "instanceof", "in"]
assoc = "left"

[[operators.infix]]
precedence = 8
ops = ["<<", ">>", ">>>"]
assoc = "left"

[[operators.infix]]
precedence = 9
ops = ["+", "-"]
assoc = "left"

[[operators.infix]]
precedence = 10
ops = ["*", "/", "%"]
assoc = "left"

[[operators.infix]]
precedence = 11
ops = ["**"]
assoc = "right"

[blocks]
compound = { open = "{", close = "}" }

[types]
position = "none"    # JS has no type annotations (ignoring TS for now)

[statements]

[statements.if]
pattern = '"if" "(" EXPR ")" BLOCK ("else" BLOCK)?'
maps_to = "If"

[statements.while]
pattern = '"while" "(" EXPR ")" BLOCK'
maps_to = "While"

[statements.do_while]
pattern = '"do" BLOCK "while" "(" EXPR ")" ";"'
maps_to = "DoWhile"

[statements.for]
pattern = '"for" "(" (VAR_DECL | EXPR)? ";" EXPR? ";" EXPR? ")" BLOCK'
maps_to = "For"

[statements.for_in]
pattern = '"for" "(" ("var"|"let"|"const")? IDENT "in" EXPR ")" BLOCK'
maps_to = "ForIn"

[statements.for_of]
pattern = '"for" "(" ("var"|"let"|"const")? IDENT "of" EXPR ")" BLOCK'
maps_to = "ForIn"

[statements.switch]
pattern = '"switch" "(" EXPR ")" "{" CASE_ARMS "}"'
maps_to = "Switch"

[statements.try]
pattern = '"try" BLOCK ("catch" "(" IDENT ")" BLOCK)? ("finally" BLOCK)?'
maps_to = "Try"

[statements.return]
pattern = '"return" EXPR?'
maps_to = "Return"

[statements.throw]
pattern = '"throw" EXPR'
maps_to = "Throw"

[statements.break]
pattern = '"break"'
maps_to = "Break"

[statements.continue]
pattern = '"continue"'
maps_to = "Continue"

[declarations]

[declarations.var]
pattern = '("var"|"let"|"const") IDENT ("=" EXPR)? ("," IDENT ("=" EXPR)?)*'
maps_to = "VarDecl"

[declarations.function]
pattern = '("async")? "function" ("*")? IDENT? "(" PARAMS ")" BLOCK'
maps_to = "FunctionDecl"

[declarations.class]
pattern = '"class" IDENT? ("extends" EXPR)? "{" CLASS_MEMBERS "}"'
maps_to = "ClassDecl"

[declarations.import]
pattern = '"import" IMPORT_SPEC "from" STRING'
maps_to = "Import"

[declarations.export]
pattern = '"export" ("default")? (DECL | EXPR)'
maps_to = "Extra"
extra = { kind = "export" }

[expressions]
member_access = "."
optional_chain = "?."
index_access = ["[", "]"]
call = ["(", ")"]

[expressions.primary]
array_literal = ["[", "]"]
object_literal = ["{", "}"]
paren_group = ["(", ")"]
arrow_function = 'PARAMS "=>" (BLOCK | EXPR)'
template_literal = ["`", "`"]

[params]
open = "("
close = ")"
separator = ","
type_position = "none"
default_value = "="
rest_prefix = "..."

[assignment]
operator = "="
compound_operators = {
  "+=" = "Add", "-=" = "Sub", "*=" = "Mul", "/=" = "Div", "%=" = "Mod",
  "**=" = "Pow", "&&=" = "And", "||=" = "Or", "??=" = "NullCoalesce",
}

WHITESPACE = _{ " " | "\t" }
COMMENT = ${ comment_text }
comment_text = { "//" ~ (!"\n" ~ ANY)* ~ "\n" }
word = { "a" }
silent = _{ word }
atomic = @{ word ~ word }
compound = ${ word ~ word }
nonatomic = !{ word ~ word }
outer_atomic = @{ word ~ compound ~ nonatomic ~ word }
main = { SOI ~ (word | "b")* ~ EOI }
single = { word }
sequence = { SOI ~ silent ~ word ~ EOI }
repeat = { word* }
bounded = { SOI ~ word{1,3} ~ EOI }
optional = { SOI ~ word? ~ EOI }
peek = { SOI ~ &word ~ word ~ !word ~ EOI }
rollback = { (word ~ "x" | word) ~ EOI }
stack = @{ PUSH("a") ~ (POP ~ "x" | POP) ~ EOI }
predicate_stack = @{ PUSH("a") ~ &POP ~ POP ~ EOI }
push_stack = @{ &PUSH("a") ~ "a" ~ !DROP ~ EOI }
repeat_stack = @{ PUSH("a") ~ (POP ~ "x")* ~ POP ~ EOI }
slice = @{ PUSH("a") ~ PUSH("b") ~ PEEK[0..] ~ PEEK[-1..] ~ PEEK_ALL ~ POP_ALL ~ EOI }
literal = @{ ^"IF" ~ 'α'..'ω' ~ ANY ~ EOI }
newline = @{ "a" ~ NEWLINE ~ "b" ~ EOI }

// Required-to-optional and bounded-optional sequence trivia regressions.
rep_star = { word* }
rep_plus = { word+ }
rep_exact = { word{1} }
rep_minimum = { word{1,} }
rep_bounded = { word{1,2} }
rep_maximum = { word{,2} }
rep_two = { word{2,} }
rep_three = { word{2,3} }
rep_atomic = @{ word{,2} }
rep_predicate = { &word{,2} ~ word{,2} }
rep_rollback = { (word{,2} ~ "b" | "a") ~ EOI }
rep_stateful = { (PUSH("a") ~ "b"){,2} ~ PEEK ~ EOI }

// @grameo ast program = Module(body: statement*)
program = { statement* ~ EOI }
// @grameo ast statement = Statement(value: children)
statement = { namespace_decl | class_decl | function_decl | while_statement | return_statement }
// @grameo ast namespace_decl = Namespace(name: identifier, body: block, span: rule)
namespace_decl = { "namespace" ~ identifier ~ block }
// @grameo ast class_decl = Class(name: identifier, methods: function_decl*, span: rule)
class_decl = { "class" ~ identifier ~ "{" ~ function_decl* ~ "}" }
// @grameo ast function_decl = Function(name: identifier, body: block, span: rule)
function_decl = { "function" ~ identifier ~ "(" ~ ")" ~ block }
// @grameo ast while_statement = While(condition: integer, body: block, span: rule)
while_statement = { "while" ~ "(" ~ integer ~ ")" ~ block }
// @grameo ast block = Block(body: statement*)
block = { "{" ~ statement* ~ "}" }
// @grameo ast return_statement = Return(value: integer?, span: rule)
return_statement = { "return" ~ integer? ~ ";" }
// @grameo ast integer = Integer(text: source, span: rule)
integer = @{ ASCII_DIGIT+ }
// @grameo ast identifier = Name(text: source)
identifier = @{ XID_START ~ XID_CONTINUE* }
WHITESPACE = _{ " " | "\t" | "\r" | "\n" }

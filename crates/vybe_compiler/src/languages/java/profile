# Java Compiler Profile
# ──────────────────────
# Covers java.lang, java.util, java.io, java.math.
# System.out.println / System.out.print are rewritten by the walker to
# bare `println` / `print` calls which map to emit = "print".

[info]
name = "java"
extensions = ["java"]

[compiler]
function_return    = "explicit"
self_keyword       = "this"
base_keyword       = "super"
constructor_name   = "__init__"    # walker rewrites Java ctor to __init__
case_sensitive     = true
string_indexing    = "zero_based"
uses_normalize_class = true
# entry_point not needed — walker injects Main.main() call directly
# Java + on strings concatenates (auto-coercion via toString())
dynamic_add        = true

# ────────────────────────────────────────────────────────────────────────────
# BUILTINS — bare global function calls (after walker normalisation)
# ────────────────────────────────────────────────────────────────────────────

[builtins]

# ── I/O ──────────────────────────────────────────────────────────────────────

# Walker rewrites System.out.println → println, System.out.print → print
println             = { emit = "print",                          min_args = 0, max_args = 255 }
print               = { emit = "common:java.print_no_newline",   min_args = 0, max_args = 255 }
printf              = { emit = "common:java.printf",             min_args = 1, max_args = 255 }

# ── Type parsing / conversion ─────────────────────────────────────────────────

"Integer.parseInt"       = { emit = "intrinsic:cint",            min_args = 1, max_args = 2 }
"Integer.valueOf"        = { emit = "intrinsic:cint",            min_args = 1, max_args = 1 }
"Long.parseLong"         = { emit = "intrinsic:cint",            min_args = 1, max_args = 2 }
"Double.parseDouble"     = { emit = "host:ecma:number:Number",   min_args = 1, max_args = 1 }
"Float.parseFloat"       = { emit = "host:ecma:number:Number",   min_args = 1, max_args = 1 }
"Boolean.parseBoolean"   = { emit = "intrinsic:cbool",           min_args = 1, max_args = 1 }
"String.valueOf"         = { emit = "intrinsic:tostring",        min_args = 1, max_args = 1 }
"Integer.toString"       = { emit = "intrinsic:tostring",        min_args = 1, max_args = 2 }
"Integer.toBinaryString" = { emit = "common:java.to_binary_string",  min_args = 1, max_args = 1 }
"Integer.toHexString"    = { emit = "common:java.to_hex_string",     min_args = 1, max_args = 1 }
"Integer.toOctalString"  = { emit = "common:java.to_octal_string",   min_args = 1, max_args = 1 }
"Integer.MAX_VALUE"      = { emit = "intrinsic:int_max",         min_args = 0, max_args = 0 }
"Integer.MIN_VALUE"      = { emit = "intrinsic:int_min",         min_args = 0, max_args = 0 }
"Double.MAX_VALUE"       = { emit = "intrinsic:dbl_max",         min_args = 0, max_args = 0 }
"Double.isNaN"           = { emit = "host:ecma:number:isNaN",    min_args = 1, max_args = 1 }
"Double.isInfinite"      = { emit = "common:java.is_infinite",   min_args = 1, max_args = 1 }


# Java Compiler Profile
# ──────────────────────
# Covers java.lang, java.util, java.io, java.math.
# System.out.println / System.out.print are rewritten by the walker to
# bare `println` / `print` calls which map to emit = "print".

[info]
name = "java"
extensions = ["java"]

[compiler]
function_return    = "explicit"
self_keyword       = "this"
base_keyword       = "super"
constructor_name   = "__init__"    # walker rewrites Java ctor to __init__
case_sensitive     = true
string_indexing    = "zero_based"
uses_normalize_class = true
# entry_point not needed — walker injects Main.main() call directly
# Java + on strings concatenates (auto-coercion via toString())
dynamic_add        = true
materialize_bool_results = true
has_ecma_bigint    = true

# ────────────────────────────────────────────────────────────────────────────
# BUILTINS — bare global function calls (after walker normalisation)
# ────────────────────────────────────────────────────────────────────────────

[builtins]

# ── I/O ──────────────────────────────────────────────────────────────────────

# Walker rewrites System.out.println → println, System.out.print → print
println             = { emit = "print",                          min_args = 0, max_args = 255 }
print               = { emit = "common:java.print_no_newline",   min_args = 0, max_args = 255 }
printf              = { emit = "common:java.printf",             min_args = 1, max_args = 255 }


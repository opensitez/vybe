# Visual Basic .NET Compiler Profile
# ───────────────────────────────────
# Full port of vybe_compiler_vb builtins.rs (900 lines) + compiler settings

[info]
name = "vb"
extensions = ["vb"]

[compiler]
function_return = "result_slot"        # VB uses FunctionName = value AND Return
result_slot_name = "__result__"        # internal — not user-visible (VB users
                                       # write `FunctionName := X`, not
                                       # `Result := X`). Keeps user classes
                                       # named `Result` from being shadowed.
self_keyword = "me"
base_keyword = "mybase"
constructor_name = "New"               # Sub New()
enum_as_ordinals = false
case_sensitive = false
string_indexing = "one_based"          # Mid(), InStr() are 1-based
array_upper_bound_inclusive = true     # Dim arr(5) means 0..5 inclusive (6 elements)
parens_for_index = true                # arr(i) not arr[i] — () is both call and index
entry_point = "main"                   # auto-call Main if defined
# VB-specific compiler behaviors
byref_boxing = true                    # ByRef args wrapped in single-element arrays for call-by-reference
with_block = true                      # With obj ... End With — bare .Member resolves to With target
new_with_initializer = true            # New Foo() With { .Prop = val }
new_from_initializer = true            # New List(Of T) From { items }
linq_queries = true                    # LINQ query syntax compiled to method chains
# Route `class` declarations through common::classes::normalize_class
# + emit_class (see classnormalization.md). VB walker already injects
# implicit MyBase.New() and AddHandler statements into ctor bodies;
# the normalizer maps method names to canonical (ToString →
# tostring, GetEnumerator → iterator, etc.) and populates the class's
# `auto_init_methods` when InitializeComponent is defined.
uses_normalize_class = true

# ────────────────────────────────────────────────────────────────────────────
# BUILTINS — every function/method the VB compiler knows about
# ────────────────────────────────────────────────────────────────────────────
#
# emit formats:
#   "print"                    → common::io::emit_print
#   "str_length"               → common::strings::emit_length
#   "opcode:<op>"              → single WASM opcode (e.g. f64_abs)
#   "host:<module>:<func>"     → call_import(module, func)
#   "intrinsic:<name>"         → multi-opcode sequence handled by compiler
#   "mutate:add"               → in-place mutation (Inc/Dec)
#   "noop"                     → emit nothing (no-op stub)
#   "namespace_chain"          → resolve via global namespace objects

[builtins]


# Random instance methods — bind directly to real WASI. Raw u64 is what
# the WASI primitive returns; range-bounded `.Next(min, max)` and float
# conversion for `.NextDouble()` are compiler-lowering work-in-progress
# (TODO: compiler_common::random) and temporarily return unscaled values.
"next"         = [
    { emit = "common:dotnet.random_next", min_args = 0, max_args = 2 },
]
nextdouble     = { emit = "common:dotnet.random_next_double", min_args = 0, max_args = 0 }



restart             = { emit = "common:dotnet.stopwatch_restart",    min_args = 0, max_args = 0 }

# List/collection extra — `addrange` shares the .NET BCL semantics
# with C# `List<T>.AddRange`; both route through the dotnet adapter.
addrange       = { emit = "common:dotnet.list_add_range",  min_args = 1, max_args = 1 }
trygetvalue    = { emit = "common:dict.get_dynamic",       min_args = 1, max_args = 2 }
containsvalue  = { emit = "host:ecma:array:includes",      min_args = 1, max_args = 1 }

# LINQ surface lives once in the shared .NET component resolver
# (`platforms/dotnet/.../component_classes_linq.rs`, class `IEnumerable`),
# resolved by receiver type — or by method name for untyped receivers on the
# .NET path — so VB declares NO per-function LINQ entries. Same shared surface
# and `generators.rs`-backed adapters as C#.

# Queue methods
enqueue        = { emit = "host:ecma:array:push",  min_args = 1, max_args = 1 }
dequeue        = { emit = "host:ecma:array:shift",  min_args = 0, max_args = 0 }

replace        = { emit = "host:ecma:regexp:replace",      min_args = 2, max_args = 2 }

# StringBuilder methods (overloaded with array ops by arity where unambiguous)
append         = { emit = "common:dotnet.sb_append",       min_args = 1, max_args = 1 }
appendline     = { emit = "common:dotnet.sb_append_line",  min_args = 0, max_args = 1 }

# Stopwatch extended

# Stopwatch methods
start          = { emit = "common:dotnet.stopwatch_start",   min_args = 0, max_args = 0 }
stop           = { emit = "common:dotnet.stopwatch_stop",    min_args = 0, max_args = 0 }
reset          = { emit = "common:dotnet.stopwatch_reset",   min_args = 0, max_args = 0 }

# Regex instance methods — extract __pattern from self object
ismatch        = { emit = "host:ecma:regexp:test",         min_args = 1, max_args = 1 }
"match"        = { emit = "host:ecma:regexp:exec",         min_args = 1, max_args = 1 }

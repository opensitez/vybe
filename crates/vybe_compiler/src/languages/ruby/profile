# Ruby Compiler Profile
# ─────────────────────
# Port of vybe_compiler_ruby — maximizes compiler_common, stdlib, intrinsics,
# and opcodes. host: calls are ONLY used when no common/stdlib/opcode exists.

[info]
name = "ruby"
extensions = ["rb"]

[compiler]
function_return = "explicit"
self_keyword = "self"
constructor_name = "initialize"
# namespaceplan.md: namespace-shaped entry points resolve through the
# common resolver — same flip as JS/PHP/dotnet/dart/java/python.
uses_common_resolver = true
enum_as_ordinals = false
case_sensitive = true
string_indexing = "zero_based"
base_keyword = "super"
dynamic_add = true
# Ruby is over wasm/js — `h[key]` must dispatch polymorphically (Map/Object
# property get for string/hash keys, array index for ints). Without this,
# `h["a"]` numeric-coerces the string key → `toF64` crash on every Hash read.
dynamic_member_access = true
# Route `==` through `ecma:value:abstractEq` (host → real boxed Boolean), the
# same mechanism JS uses (JS is over wasm/js too). Without it Ruby `==` returns
# a raw i32 that prints "1"/"0" instead of "true"/"false".
abstract_equality = true
# Ruby `arr[-1]` returns the last element (same idiom as Python).
# Also applies to strings: `"hello"[-1]` → "o".
negative_index_wraps = true
# Same idiom as Python: `return a, b` / `x, y = f()` → WASM multi-value.
# Ruby's walker emits a `Tuple` AST node (not `Array`) for multi-expr
# returns specifically so the compiler pre-scan recognises the pattern.
# Non-destructure callers (`r = f()`) get the N values auto-repacked
# into an array by `compile_expr` for `Call`, preserving Ruby semantics.
multi_value_tuple_returns = true
# Route `class` declarations through common::classes::normalize_class
# + emit_class (see classnormalization.md).
uses_normalize_class = true

# ────────────────────────────────────────────────────────────────────────────
# BUILTINS — bare global function calls
# ────────────────────────────────────────────────────────────────────────────

[builtins]

# ── I/O ──────────────────────────────────────────────────────────────────────

puts            = { emit = "print",                         min_args = 0, max_args = 255 }
print           = { emit = "print_no_newline",              min_args = 0, max_args = 255 }
p               = { emit = "print",                         min_args = 0, max_args = 255 }
pp              = { emit = "print",                         min_args = 0, max_args = 255 }
gets            = { emit = "host:wasi:cli:readLine",        min_args = 0, max_args = 0 }
warn            = { emit = "print",                         min_args = 1, max_args = 255 }

# ── Type conversion ──────────────────────────────────────────────────────────

"Integer"       = { emit = "intrinsic:cint",        min_args = 1, max_args = 2 }
"Float"         = { emit = "host:ecma:number:Number",        min_args = 1, max_args = 1 }
"String"        = { emit = "common:ruby.tostring",                min_args = 1, max_args = 1 }
"Array"         = { emit = "host:ecma:array:from",           min_args = 1, max_args = 1 }

# ── Math (WASM opcodes) ─────────────────────────────────────────────────────

abs             = { emit = "opcode:f64_abs",                min_args = 1, max_args = 1 }
rand            = { emit = "common:ruby.rand",              min_args = 0, max_args = 1 }
srand           = { emit = "common:ruby.srand",             min_args = 0, max_args = 1 }
"Math.sqrt"     = { emit = "opcode:f64_sqrt",               min_args = 1, max_args = 1 }
"Math.sin"      = { emit = "host:ecma:math:sin",            min_args = 1, max_args = 1 }
"Math.cos"      = { emit = "host:ecma:math:cos",            min_args = 1, max_args = 1 }
"Math.tan"      = { emit = "host:ecma:math:tan",            min_args = 1, max_args = 1 }
"Math.log"      = { emit = "host:ecma:math:log",            min_args = 1, max_args = 2 }
"Math.log2"     = { emit = "host:ecma:math:log2",           min_args = 1, max_args = 1 }
"Math.log10"    = { emit = "host:ecma:math:log10",          min_args = 1, max_args = 1 }
"Math.exp"      = { emit = "host:ecma:math:exp",            min_args = 1, max_args = 1 }
"Math.floor"    = { emit = "opcode:f64_floor",              min_args = 1, max_args = 1 }
"Math.ceil"     = { emit = "opcode:f64_ceil",               min_args = 1, max_args = 1 }

# ── Misc ─────────────────────────────────────────────────────────────────────

sleep           = { emit = "host:wasi:clocks:sleep",         min_args = 1, max_args = 1 }
exit            = { emit = "host:wasi:cli:exit",             min_args = 0, max_args = 1 }
system          = { emit = "host:node:child_process:execSync", min_args = 1, max_args = 1 }
raise           = { emit = "throw",                          min_args = 0, max_args = 1 }
sprintf         = { emit = "common:sprintf.format",          min_args = 1, max_args = 255 }
format          = { emit = "common:sprintf.format",          min_args = 1, max_args = 255 }
open            = { emit = "host:wasi:filesystem:open",      min_args = 1, max_args = 3 }
require         = { emit = "noop",                           min_args = 1, max_args = 1 }
require_relative = { emit = "noop",                          min_args = 1, max_args = 1 }
caller          = { emit = "noop",                           min_args = 0, max_args = 1 }

# ────────────────────────────────────────────────────────────────────────────
# VALUE METHODS — instance .method() calls
# ────────────────────────────────────────────────────────────────────────────

[value_methods]

# ── String instance methods (common:strings.* / common:str_*) ────────────────

# Polymorphic length — string / array / hash (Map) / object. `str_length`
# was string-only, so `arr.length`/`hash.length` hit `wasm:js-string:length`
# on a non-string → `toF64` error. `collections.length` (emit_len) dispatches
# on the runtime type.
length          = { emit = "common:collections.length",     min_args = 0, max_args = 0 }
size            = { emit = "common:collections.length",     min_args = 0, max_args = 0 }
upcase          = { emit = "common:strings.to_upper",       min_args = 0, max_args = 0 }
downcase        = { emit = "common:strings.to_lower",       min_args = 0, max_args = 0 }
strip           = { emit = "common:strings.trim",           min_args = 0, max_args = 0 }
lstrip          = { emit = "common:str_trim_start",         min_args = 0, max_args = 0 }
rstrip          = { emit = "common:str_trim_end",           min_args = 0, max_args = 0 }
chomp           = { emit = "common:strings.trim",           min_args = 0, max_args = 1 }
chop            = { emit = "intrinsic:chop",         min_args = 0, max_args = 0 }
split           = { emit = "common:strings.split",          min_args = 0, max_args = 2 }
join            = { emit = "common:collections.join",       min_args = 0, max_args = 1 }
replace         = { emit = "common:strings.replace",        min_args = 1, max_args = 1 }
gsub            = { emit = "common:strings.replace",        min_args = 2, max_args = 2 }
sub             = { emit = "host:ecma:string:replace", min_args = 2, max_args = 2 }
index           = { emit = "common:strings.index_of",       min_args = 1, max_args = 2 }
rindex          = { emit = "common:str_last_index_of",      min_args = 1, max_args = 2 }
"include?"      = { emit = "common:ruby.includes",          min_args = 1, max_args = 1 }
"member?"       = { emit = "common:ruby.includes",          min_args = 1, max_args = 1 }
"start_with?"   = { emit = "common:str_starts_with",        min_args = 1, max_args = 1 }
"end_with?"     = { emit = "common:str_ends_with",          min_args = 1, max_args = 1 }
capitalize      = { emit = "intrinsic:capitalize",   min_args = 0, max_args = 0 }
reverse         = { emit = "common:str_reverse",            min_args = 0, max_args = 0 }
chars           = { emit = "intrinsic:chars",        min_args = 0, max_args = 0 }
bytes           = { emit = "common:ruby.bytes",     min_args = 0, max_args = 0 }
center          = { emit = "intrinsic:center",       min_args = 1, max_args = 2 }
ljust           = { emit = "common:str_pad_end",            min_args = 1, max_args = 2 }
rjust           = { emit = "common:str_pad_start",          min_args = 1, max_args = 2 }
to_s            = { emit = "common:ruby.tostring",               min_args = 0, max_args = 0 }
to_str          = { emit = "common:ruby.tostring",               min_args = 0, max_args = 0 }
to_i            = { emit = "intrinsic:cint",        min_args = 0, max_args = 0 }
to_f            = { emit = "host:ecma:number:Number",        min_args = 0, max_args = 0 }
to_a            = { emit = "host:ecma:array:from",          min_args = 0, max_args = 0 }
to_sym          = { emit = "common:ruby.tostring",               min_args = 0, max_args = 0 }
inspect         = { emit = "common:ruby.tostring",               min_args = 0, max_args = 0 }
freeze          = { emit = "noop_receiver",                 min_args = 0, max_args = 0 }
"frozen?"       = { emit = "noop_receiver",                 min_args = 0, max_args = 0 }
dup             = { emit = "host:ecma:array:slice",          min_args = 0, max_args = 0 }
clone           = { emit = "host:ecma:array:slice",          min_args = 0, max_args = 0 }
"nil?"          = { emit = "opcode:ref_is_null",            min_args = 0, max_args = 0 }
# `is_a?`/`kind_of?` are normalized to `InstanceOf` in the walker (shared JS
# instanceof path — reads the constructor name, checks the __types ancestry),
# so they need no value-method entry here.
class           = { emit = "common:ref_typeof",             min_args = 0, max_args = 0 }
"respond_to?"   = { emit = "host:ecma:object:hasOwn",       min_args = 1, max_args = 1 }
send            = { emit = "host:ecma:value:invokeMethod", min_args = 1, max_args = 255 }

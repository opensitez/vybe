# ────────────────────────────────────────────────────────────────────────────
# INTRINSICS — multi-opcode sequences
# ────────────────────────────────────────────────────────────────────────────

[intrinsics]
# x.ord → first char code
asc = "const_i32(0), str_char_code_at"
# arr.unshift(val) → splice(0, 0, val)
array_unshift = "const_i32(0), const_i32(0), splice"
# arr.first → arr[0]
array_at = "array_get"
# map.size → dict_keys, array_length
map_size = "dict_keys, array_length"

# ────────────────────────────────────────────────────────────────────────────
# ESM DEFAULTS — Ruby module constants → host modules, ECMA-262 §16.2 shape
# ────────────────────────────────────────────────────────────────────────────

# Component-Model package roots (namespaceplan.md Phase 1): literal host
# prefix chains resolve through the common resolver's package-root step.

[[esm_default]]
kind = "package-root"
prefix = "vybe"
module_root = "vybe:"

[[esm_default]]
kind = "package-root"
prefix = "wasi"
module_root = "wasi:"

[[esm_default]]
kind = "package-root"
prefix = "wasm"
module_root = "wasm:"

[[esm_default]]
kind = "namespace"
alias = "Math"
module = "ecma:math"

[[esm_default]]
kind = "namespace"
alias = "File"
module = "wasi:filesystem"

[[esm_default]]
kind = "namespace"
alias = "JSON"
module = "ecma:json"

[[esm_default]]
kind = "namespace"
alias = "Kernel"
module = "vybe:runtime"

[[esm_default]]
kind = "namespace"
alias = "IO"
module = "wasi:cli"

[[esm_default]]
kind = "namespace"
alias = "Dir"
module = "wasi:filesystem"


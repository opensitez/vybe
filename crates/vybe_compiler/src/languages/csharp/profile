# C# Compiler Profile
# ────────────────────
# Full port of vybe_compiler_csharp builtins — Console, Math, Convert, String,
# collections, LINQ, GUI, threading, type operations.

[info]
name = "csharp"
extensions = ["cs"]

[compiler]
function_return = "explicit"
self_keyword = "this"
base_keyword = "base"
constructor_name = "ctor"
enum_as_ordinals = true
case_sensitive = true
string_indexing = "zero_based"
entry_point = "Main"
dynamic_add = true
# Route `class` declarations through common::classes::normalize_class
# + emit_class (see classnormalization.md).
uses_normalize_class = true
# C#: `return (a, b);` with `ValueTuple` syntax maps to WASM multi-value
# at the ABI boundary. Destructure-side (`var (a, b) = f();`) isn't in
# the grammar yet, so today only the callee-side saving applies —
# non-destructure callers get the N values auto-repacked into an array.
# When/if tuple-deconstruction lands in the grammar, the existing
# `detect_multi_value_receive` path will light up automatically.
multi_value_tuple_returns = true

# ────────────────────────────────────────────────────────────────────────────
# BUILTINS — bare global function calls and dotted static calls
# ────────────────────────────────────────────────────────────────────────────

[builtins]

# ── I/O ──────────────────────────────────────────────────────────────────────

"Console.WriteLine"       = { emit = "common:dotnet.console_writeline", min_args = 1, max_args = 1 }
"Console.Write"           = { emit = "common:dotnet.console_writeline", min_args = 1, max_args = 1 }
"Console.ReadLine"        = { emit = "host:wasi:cli:readLine",    min_args = 0, max_args = 0 }
"Console.Error"           = { emit = "host:wasi:cli:error",       min_args = 0, max_args = 255 }

# ── Math — WASM opcodes ─────────────────────────────────────────────────────

"Math.Abs"          = { emit = "opcode:f64_abs",      min_args = 1, max_args = 1 }
"System.Math.Abs"   = { emit = "opcode:f64_abs",      min_args = 1, max_args = 1 }
"Math.Floor"        = { emit = "opcode:f64_floor",    min_args = 1, max_args = 1 }
"System.Math.Floor" = { emit = "opcode:f64_floor",    min_args = 1, max_args = 1 }
"Math.Ceiling"      = { emit = "opcode:f64_ceil",     min_args = 1, max_args = 1 }
"System.Math.Ceiling" = { emit = "opcode:f64_ceil",   min_args = 1, max_args = 1 }
"Math.Ceil"         = { emit = "opcode:f64_ceil",     min_args = 1, max_args = 1 }
"System.Math.Ceil"  = { emit = "opcode:f64_ceil",     min_args = 1, max_args = 1 }
"Math.Sqrt"         = { emit = "opcode:f64_sqrt",     min_args = 1, max_args = 1 }
"System.Math.Sqrt"  = { emit = "opcode:f64_sqrt",     min_args = 1, max_args = 1 }
"Math.Truncate"     = { emit = "opcode:f64_trunc",    min_args = 1, max_args = 1 }
"System.Math.Truncate" = { emit = "opcode:f64_trunc", min_args = 1, max_args = 1 }
"Math.Trunc"        = { emit = "opcode:f64_trunc",    min_args = 1, max_args = 1 }
"System.Math.Trunc" = { emit = "opcode:f64_trunc",    min_args = 1, max_args = 1 }
"Math.Round"        = { emit = "opcode:f64_nearest",  min_args = 1, max_args = 1 }
"System.Math.Round" = { emit = "opcode:f64_nearest",  min_args = 1, max_args = 1 }
"Math.Min"          = { emit = "opcode:f64_min",      min_args = 2, max_args = 2 }
"System.Math.Min"   = { emit = "opcode:f64_min",      min_args = 2, max_args = 2 }
"Math.Max"          = { emit = "opcode:f64_max",      min_args = 2, max_args = 2 }
"System.Math.Max"   = { emit = "opcode:f64_max",      min_args = 2, max_args = 2 }

# ── Math — host calls ───────────────────────────────────────────────────────

"Math.Pow"          = { emit = "host:ecma:math:pow",      min_args = 2, max_args = 2 }
"System.Math.Pow"   = { emit = "host:ecma:math:pow",      min_args = 2, max_args = 2 }
"Math.Sin"          = { emit = "host:ecma:math:sin",      min_args = 1, max_args = 1 }
"Math.Cos"          = { emit = "host:ecma:math:cos",      min_args = 1, max_args = 1 }
"Math.Tan"          = { emit = "host:ecma:math:tan",      min_args = 1, max_args = 1 }
"Math.Asin"         = { emit = "host:ecma:math:asin",     min_args = 1, max_args = 1 }
"Math.Acos"         = { emit = "host:ecma:math:acos",     min_args = 1, max_args = 1 }
"Math.Atan"         = { emit = "host:ecma:math:atan",     min_args = 1, max_args = 1 }
"Math.Atan2"        = { emit = "host:ecma:math:atan2",    min_args = 2, max_args = 2 }
"Math.Log"          = { emit = "host:ecma:math:log",      min_args = 1, max_args = 1 }
"Math.Log10"        = { emit = "host:ecma:math:log10",    min_args = 1, max_args = 1 }
"Math.Exp"          = { emit = "host:ecma:math:exp",      min_args = 1, max_args = 1 }
"Math.Sinh"         = { emit = "host:ecma:math:sinh",     min_args = 1, max_args = 1 }
"Math.Cosh"         = { emit = "host:ecma:math:cosh",     min_args = 1, max_args = 1 }
"Math.Tanh"         = { emit = "host:ecma:math:tanh",     min_args = 1, max_args = 1 }
"Math.Sign"         = { emit = "host:ecma:math:sign",     min_args = 1, max_args = 1 }
"Math.Clamp"        = { emit = "host:ecma:math:clamp",    min_args = 3, max_args = 3 }

# ── Type conversion ──────────────────────────────────────────────────────────

"Convert.ToInt32"    = { emit = "intrinsic:cint",         min_args = 1, max_args = 1 }
"Convert.ToDouble"   = { emit = "host:ecma:number:Number",         min_args = 1, max_args = 1 }
"Convert.ToString"   = { emit = "common:dotnet.tostring",        min_args = 1, max_args = 1 }
"Convert.ToBoolean"  = { emit = "opcode:dyn_to_bool",             min_args = 1, max_args = 1 }
"Convert.ToChar"     = { emit = "common:dotnet.cchar",            min_args = 1, max_args = 1 }
"Convert.ToByte"     = { emit = "intrinsic:cbyte",                min_args = 1, max_args = 1 }
"Convert.ToInt64"    = { emit = "intrinsic:clng",         min_args = 1, max_args = 1 }
"Convert.ToSingle"   = { emit = "host:ecma:number:Number",         min_args = 1, max_args = 1 }
"Convert.ToDecimal"  = { emit = "host:ecma:number:Number",         min_args = 1, max_args = 1 }
# `<T>.Parse(s)` — throw FormatException on invalid input per
# ECMA-335. Adapters live in `emitter/dotnet/core/parse_adapter.rs`
# so VB picks them up by listing the same `common:dotnet.parse_*`
# emit targets (lower-cased keys for case-insensitive dispatch).
"int.Parse"          = { emit = "common:dotnet.parse_int",      min_args = 1, max_args = 1 }
"byte.Parse"         = { emit = "common:dotnet.parse_byte",     min_args = 1, max_args = 1 }
"long.Parse"         = { emit = "common:dotnet.parse_long",     min_args = 1, max_args = 1 }
"float.Parse"        = { emit = "common:dotnet.parse_float",    min_args = 1, max_args = 1 }
"decimal.Parse"      = { emit = "common:dotnet.parse_decimal",  min_args = 1, max_args = 1 }
"char.Parse"         = { emit = "common:dotnet.parse_char",     min_args = 1, max_args = 1 }
"double.Parse"       = { emit = "common:dotnet.parse_double",   min_args = 1, max_args = 1 }
"bool.Parse"         = { emit = "common:dotnet.parse_bool",     min_args = 1, max_args = 1 }
"Byte.Parse"         = { emit = "common:dotnet.parse_byte",     min_args = 1, max_args = 1 }
"Int64.Parse"        = { emit = "common:dotnet.parse_long",     min_args = 1, max_args = 1 }
"Single.Parse"       = { emit = "common:dotnet.parse_float",    min_args = 1, max_args = 1 }
"Decimal.Parse"      = { emit = "common:dotnet.parse_decimal",  min_args = 1, max_args = 1 }
"Char.Parse"         = { emit = "common:dotnet.parse_char",     min_args = 1, max_args = 1 }
"Int32.Parse"        = { emit = "common:dotnet.parse_int",      min_args = 1, max_args = 1 }
"Double.Parse"       = { emit = "common:dotnet.parse_double",   min_args = 1, max_args = 1 }
# TryParse: `int.TryParse(s, out result)` returns bool. Stays on the
# silent intrinsic since failure shouldn't throw (returns false).
"Int32.TryParse"     = { emit = "intrinsic:cint",         min_args = 1, max_args = 2 }
"int.TryParse"       = { emit = "intrinsic:cint",         min_args = 1, max_args = 2 }

# ── String static methods ────────────────────────────────────────────────────

"String.Join"         = { emit = "common:collections.join_sep_first", min_args = 2, max_args = 2 }
"String.IsNullOrEmpty" = { emit = "common:dotnet.string_is_null_or_empty", min_args = 1, max_args = 1 }
"String.IsNullOrWhiteSpace" = { emit = "common:dotnet.string_is_null_or_whitespace", min_args = 1, max_args = 1 }
"String.Format"       = { emit = "common:dotnet.string_format",   min_args = 1, max_args = 255 }
"String.Concat"       = { emit = "opcode:str_concat",             min_args = 2, max_args = 255 }
"str_repeat"          = { emit = "opcode:str_repeat",             min_args = 2, max_args = 2 }
"string.IsNullOrEmpty" = { emit = "common:dotnet.string_is_null_or_empty", min_args = 1, max_args = 1 }
"string.IsNullOrWhiteSpace" = { emit = "common:dotnet.string_is_null_or_whitespace", min_args = 1, max_args = 1 }
"string.Join"         = { emit = "common:collections.join_sep_first", min_args = 2, max_args = 2 }

# ── Array static methods ────────────────────────────────────────────────────
# All shared with VB via `common:dotnet.array_*` adapters in
# `crates/vybex/src/emitter/dotnet/core/array_adapter.rs`.

"Array.Sort"          = { emit = "common:dotnet.array_sort",          min_args = 1, max_args = 1 }
"Array.Reverse"       = { emit = "common:dotnet.array_reverse",       min_args = 1, max_args = 1 }
"Array.IndexOf"       = { emit = "common:dotnet.array_index_of",      min_args = 2, max_args = 2 }
"Array.Copy"          = { emit = "common:dotnet.array_copy",          min_args = 3, max_args = 3 }
"Array.Clear"         = { emit = "common:dotnet.array_clear",         min_args = 3, max_args = 3 }
"Array.Resize"        = { emit = "common:dotnet.array_resize",        min_args = 2, max_args = 2 }
"Array.Exists"        = { emit = "common:dotnet.array_exists",        min_args = 2, max_args = 2 }
"Array.Find"          = { emit = "common:dotnet.array_find",          min_args = 2, max_args = 2 }
"Array.FindAll"       = { emit = "common:dotnet.array_find_all",      min_args = 2, max_args = 2 }
"Array.TrueForAll"    = { emit = "common:dotnet.array_true_for_all",  min_args = 2, max_args = 2 }
"Array.ConvertAll"    = { emit = "common:dotnet.array_convert_all",   min_args = 2, max_args = 2 }
"Array.ForEach"       = { emit = "common:dotnet.array_for_each",      min_args = 2, max_args = 2 }

# ── Object static methods ───────────────────────────────────────────────────

"Object.Equals"       = { emit = "opcode:dyn_eq",                 min_args = 2, max_args = 2 }
"Object.ReferenceEquals" = { emit = "opcode:ref_eq",              min_args = 2, max_args = 2 }

# ── JSON ─────────────────────────────────────────────────────────────────────

"JsonSerializer.Serialize"     = { emit = "host:ecma:json:stringify", min_args = 1, max_args = 1 }
"JsonSerializer.Deserialize"   = { emit = "host:ecma:json:parse",    min_args = 1, max_args = 1 }

# ── Environment ──────────────────────────────────────────────────────────────

"Environment.NewLine"          = { emit = "common:dotnet.newline",      min_args = 0, max_args = 0 }
"Environment.GetEnvironmentVariable" = { emit = "common:dotnet.environment_get", min_args = 1, max_args = 1 }

# ── Threading ────────────────────────────────────────────────────────────────
# Routes through compiler_common::threading which uses real WASM threading
# opcodes (thread_spawn, thread_join, atomic_*) — NOT Vybe-specific host calls.
# Standard WASM runtimes that support the threads proposal get proper threading
# without needing the Vybe host. Sleep uses the standard `wasi:clocks` import.

# ── GUI (Windows Forms) ─────────────────────────────────────────────────────

"Application.Run"              = { emit = "host:vybe:gui:runApplication",   min_args = 1, max_args = 1 }
"Application.Exit"             = { emit = "host:vybe:gui:appExit",          min_args = 0, max_args = 0 }
"Application.EnableVisualStyles" = { emit = "host:vybe:gui:noop",          min_args = 0, max_args = 0 }
"Application.SetCompatibleTextRenderingDefault" = { emit = "host:vybe:gui:noop", min_args = 1, max_args = 1 }
"System.Windows.Forms.Application.EnableVisualStyles" = { emit = "host:vybe:gui:noop", min_args = 0, max_args = 0 }
"System.Windows.Forms.Application.SetCompatibleTextRenderingDefault" = { emit = "host:vybe:gui:noop", min_args = 1, max_args = 1 }
"MessageBox.Show"              = { emit = "host:vybe:gui:msgBox",           min_args = 1, max_args = 3 }

# ── Layout no-ops ────────────────────────────────────────────────────────────

"SuspendLayout"   = { emit = "noop", min_args = 0, max_args = 0 }
"ResumeLayout"    = { emit = "noop", min_args = 0, max_args = 1 }
"PerformLayout"   = { emit = "noop", min_args = 0, max_args = 0 }

# ────────────────────────────────────────────────────────────────────────────
# VALUE METHODS — instance methods called on values
# ────────────────────────────────────────────────────────────────────────────

[value_methods]

# String instance methods
ToUpper       = { emit = "common:strings.to_upper",   min_args = 0, max_args = 0 }
ToLower       = { emit = "common:strings.to_lower",   min_args = 0, max_args = 0 }
Trim          = { emit = "common:strings.trim",        min_args = 0, max_args = 0 }
TrimStart     = { emit = "opcode:str_trim_start",      min_args = 0, max_args = 0 }
TrimEnd       = { emit = "opcode:str_trim_end",        min_args = 0, max_args = 0 }
StartsWith    = { emit = "opcode:str_starts_with",     min_args = 1, max_args = 1 }
EndsWith      = { emit = "opcode:str_ends_with",       min_args = 1, max_args = 1 }
Contains      = { emit = "opcode:str_includes",        min_args = 1, max_args = 1 }
Replace       = { emit = "common:strings.replace",     min_args = 2, max_args = 2 }
Split         = { emit = "common:strings.split",       min_args = 1, max_args = 2 }
Substring     = { emit = "common:strings.substring",   min_args = 1, max_args = 2 }
IndexOf       = { emit = "common:strings.index_of",    min_args = 1, max_args = 2 }
LastIndexOf   = { emit = "opcode:str_last_index_of",   min_args = 1, max_args = 2 }
PadLeft       = { emit = "opcode:str_pad_start",       min_args = 1, max_args = 2 }
PadRight      = { emit = "opcode:str_pad_end",         min_args = 1, max_args = 2 }
ToString      = { emit = "common:dotnet.tostring",     min_args = 0, max_args = 0 }
ToCharArray   = { emit = "opcode:str_split",           min_args = 0, max_args = 0 }
Insert        = { emit = "common:dotnet.str_insert",   min_args = 2, max_args = 2 }
Remove        = [
    { emit = "common:dotnet.str_remove_start", min_args = 1, max_args = 1 },
    { emit = "common:dotnet.str_remove_range", min_args = 2, max_args = 2 },
]

# Array/List instance methods
# Add has two overloads: list.Add(item) (1 arg) and dict.Add(key, value) (2 args)
Add           = [
    { emit = "common:collections.push", min_args = 1, max_args = 1 },
    { emit = "common:dict.set_dynamic", min_args = 2, max_args = 2 },
]
Clear         = { emit = "host:ecma:array:clear",      min_args = 0, max_args = 0 }
Reverse       = { emit = "common:collections.reverse",       min_args = 0, max_args = 0 }
Sort          = [
    { emit = "common:dotnet.sort_in_place",        min_args = 0, max_args = 0 },
    { emit = "common:dotnet.sort_with_comparator", min_args = 1, max_args = 1 },
]
join          = { emit = "common:collections.join",    min_args = 1, max_args = 1 }
# `Count` 0-arg defers to the runtime collection registry (List<T>.Count,
# Dict.Count, HashSet.Count are all component-model methods on the
# respective collection types — registry knows the per-type semantics).
# 1-arg `Count(pred)` is the LINQ overload, which the registry does NOT
# know about — the `dotnet.linq_count_pred` overload below routes
# through the shared LINQ adapter. The dispatch in `compiler/calls.rs`
# treats `common:dotnet.*` value-method overloads as preempting the
# runtime collection registry (`prefer_dotnet_adapter` discriminator).
Count         = [
    { emit = "common:collections.length",     min_args = 0, max_args = 0 },
    { emit = "common:dotnet.linq_count_pred", min_args = 1, max_args = 1 },
]
ToArray       = { emit = "common:dotnet.linq_identity",   min_args = 0, max_args = 0 }
ToList        = { emit = "common:dotnet.linq_identity",   min_args = 0, max_args = 0 }
GetType       = { emit = "opcode:ref_typeof",          min_args = 0, max_args = 0 }
Equals        = { emit = "opcode:dyn_eq",              min_args = 1, max_args = 1 }

# LINQ surface — composed bytecode lives in `emitter/dotnet/core/linq_adapter.rs`
# so VB and C# share one implementation. New entries: add an emit_linq_* fn,
# wire it in dispatch.rs, then list it here / in vb/profile.
Sum                = { emit = "common:collections.sum",                   min_args = 0, max_args = 0 }
Min                = { emit = "common:collections.min",                   min_args = 0, max_args = 0 }
Max                = { emit = "common:collections.max",                   min_args = 0, max_args = 0 }
First              = { emit = "common:dotnet.linq_first",                 min_args = 0, max_args = 0 }
Last               = { emit = "common:dotnet.linq_last",                  min_args = 0, max_args = 0 }
Select             = { emit = "common:dotnet.linq_select",                min_args = 1, max_args = 1 }
Average            = { emit = "common:dotnet.linq_average",               min_args = 0, max_args = 0 }
FirstOrDefault     = { emit = "common:dotnet.linq_first_or_default",      min_args = 0, max_args = 0 }
Distinct           = { emit = "common:dotnet.linq_distinct",              min_args = 0, max_args = 0 }
SequenceEqual      = { emit = "common:dotnet.linq_sequence_equal",        min_args = 1, max_args = 1 }
Skip               = { emit = "common:dotnet.linq_skip",                  min_args = 1, max_args = 1 }
Take               = { emit = "common:dotnet.linq_take",                  min_args = 1, max_args = 1 }
Aggregate          = { emit = "common:dotnet.linq_aggregate",             min_args = 2, max_args = 2 }
OrderByDescending  = { emit = "common:dotnet.linq_order_by_descending",   min_args = 1, max_args = 1 }
GroupBy            = { emit = "common:dotnet.linq_group_by",              min_args = 1, max_args = 1 }
SelectMany         = { emit = "common:dotnet.linq_select_many",           min_args = 1, max_args = 1 }
ToDictionary       = { emit = "common:dotnet.linq_to_dictionary",         min_args = 2, max_args = 2 }
Zip                = { emit = "common:dotnet.linq_zip",                   min_args = 2, max_args = 2 }
AddRange           = { emit = "common:dotnet.list_add_range",             min_args = 1, max_args = 1 }

# Dictionary methods
ContainsKey   = { emit = "common:dict.has",            min_args = 1, max_args = 1 }
ContainsValue = { emit = "invoke:ContainsValue",        min_args = 1, max_args = 1 }
TryGetValue   = { emit = "invoke:TryGetValue",          min_args = 1, max_args = 2 }

# Queue/Stack methods
Enqueue       = { emit = "common:collections.push",          min_args = 1, max_args = 1 }
Dequeue       = { emit = "common:collections.shift",         min_args = 0, max_args = 0 }
Push          = { emit = "common:collections.push",          min_args = 1, max_args = 1 }
Pop           = { emit = "common:collections.pop",           min_args = 0, max_args = 0 }
Peek          = { emit = "invoke:Peek",                 min_args = 0, max_args = 0 }

# ────────────────────────────────────────────────────────────────────────────
# ESM DEFAULTS — C# namespace objects → host modules, ECMA-262 §16.2 shape
# ────────────────────────────────────────────────────────────────────────────

[[esm_default]]
kind = "namespace"
alias = "Console"
module = "wasi:cli"

[[esm_default]]
kind = "namespace"
alias = "Math"
module = "ecma:math"

# `Convert` namespace alias retired — `Convert.To*` methods lower at
# compile time through the dotnet wrapper Component Model dispatch.
# The namespace object itself is still registered in
# `vybe_host::namespaces::convert` (binding `ToInt32` → `ecma:number.parseInt`
# etc.) for any dynamic identifier-resolution path.

[[esm_default]]
kind = "namespace"
alias = "Environment"
module = "wasi:cli"

[[esm_default]]
kind = "namespace"
alias = "Array"
module = "ecma:array"

[[esm_default]]
kind = "namespace"
alias = "String"
module = "ecma:string"

[[esm_default]]
kind = "namespace"
alias = "Object"
module = "ecma:object"

# Task / Thread / Interlocked are compiler-only now: Task.Run / Thread.Start
# compile to Op::THREAD_SPAWN, Interlocked.* compiles to WASM atomic opcodes,
# Thread.Sleep uses wasi:clocks/sleep. No ESM namespace object is needed —
# the compiler intercepts these calls directly.

[[esm_default]]
kind = "namespace"
alias = "Application"
module = "vybe:gui"

[[esm_default]]
kind = "namespace"
alias = "MessageBox"
module = "vybe:gui"

[[esm_default]]
kind = "namespace"
alias = "File"
module = "wasi:filesystem"

[[esm_default]]
kind = "namespace"
alias = "Directory"
module = "wasi:filesystem"

[[esm_default]]
kind = "namespace"
alias = "Path"
module = "wasi:filesystem"

# ────────────────────────────────────────────────────────────────────────────
# KNOWN TYPES — constructor mappings for new TypeName()
# ────────────────────────────────────────────────────────────────────────────

[known_types]
# Constructor fallbacks for `new TypeName()` when the dotnet wrapper
# Component Model adapter doesn't handle the type. Most .NET-shape
# classes lower at compile time and bypass this table entirely.
#
# Retired entries:
#   Exception family, StringBuilder, Timer — all routed through dotnet
#   wrapper Common emit (no `vybe:types/{exception,sb,timer}New` host fns).
"Regex"           = ["ecma:regexp", "new"]
"Random"          = ["wasi:random/insecure", "get-insecure-random-u64"]
"Stopwatch"       = ["common", "dotnet.stopwatch_new"]

# ────────────────────────────────────────────────────────────────────────────
# NAMESPACE CONSTANTS — property access, NOT function call
# ────────────────────────────────────────────────────────────────────────────

# ────────────────────────────────────────────────────────────────────────────
# ARRAY METHODS — higher-order methods routed to compiler_common::loops
# ────────────────────────────────────────────────────────────────────────────

[array_methods]
Where     = "__array_filter"
ForEach   = "__array_forEach"
Any       = "__array_some"
All       = "__array_every"
OrderBy   = "__array_sort_by_key"
# `Aggregate` lives in [value_methods] → `dotnet.linq_aggregate` because
# the C# argument order (`(seed, fn)`) is the inverse of JS `reduce(fn, init)`,
# and the array_methods HOF dispatch can't swap args.
# List<T> instance-method aliases — same HOF semantics, different names per
# .NET BCL. Routes through the same compiler_common loop emitters.
Find       = "__array_find"
FindAll    = "__array_filter"
Exists     = "__array_some"
TrueForAll = "__array_every"
ConvertAll = "__array_map"

[namespace_constants]
"Math.PI"               = 3.141592653589793
"Math.E"                = 2.718281828459045
"int.MaxValue"          = 2147483647
"int.MinValue"          = -2147483648
"double.MaxValue"       = 1.7976931348623157e308
"double.MinValue"       = -1.7976931348623157e308
"double.NaN"            = "NaN"
"double.PositiveInfinity" = "Infinity"

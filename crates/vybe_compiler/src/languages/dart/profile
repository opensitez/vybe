# Dart Compiler Profile
# ─────────────────────
# Covers dart:core, dart:math, dart:io, dart:convert, dart:async.
# Collection HOF methods (map, where, forEach, reduce) go through
# [array_methods] for proper compiler_common loop emission.

[info]
name = "dart"
extensions = ["dart"]

[compiler]
function_return = "explicit"
self_keyword = "this"
base_keyword = "super"
constructor_name = "__init__"    # Dart unnamed constructors handled by walker
enum_as_ordinals = false
case_sensitive = true
string_indexing = "zero_based"
# Route `class` declarations through common::classes::normalize_class
# + emit_class (see classnormalization.md).
uses_normalize_class = true
entry_point = "main"
# Dart `+` on strings concatenates (per dart:core String.+).
dynamic_add = true

# ────────────────────────────────────────────────────────────────────────────
# BUILTINS — bare global function calls
# ────────────────────────────────────────────────────────────────────────────

[builtins]

# ── I/O ──────────────────────────────────────────────────────────────────────

print               = { emit = "common:dart.print",              min_args = 1, max_args = 1 }

# ── String functions ─────────────────────────────────────────────────────────

"int.parse"         = { emit = "intrinsic:cint",         min_args = 1, max_args = 1 }
"double.parse"      = { emit = "host:ecma:number:Number",         min_args = 1, max_args = 1 }
"num.parse"         = { emit = "host:ecma:number:Number",         min_args = 1, max_args = 1 }

# ── Math functions (dart:math) ───────────────────────────────────────────────

"math.sqrt"         = { emit = "opcode:f64_sqrt",                min_args = 1, max_args = 1 }
"math.min"          = { emit = "opcode:f64_min",                 min_args = 2, max_args = 2 }
"math.max"          = { emit = "opcode:f64_max",                 min_args = 2, max_args = 2 }
"math.pow"          = { emit = "host:ecma:math:pow",             min_args = 2, max_args = 2 }
"math.sin"          = { emit = "host:ecma:math:sin",             min_args = 1, max_args = 1 }
"math.cos"          = { emit = "host:ecma:math:cos",             min_args = 1, max_args = 1 }
"math.tan"          = { emit = "host:ecma:math:tan",             min_args = 1, max_args = 1 }
"math.asin"         = { emit = "host:ecma:math:asin",            min_args = 1, max_args = 1 }
"math.acos"         = { emit = "host:ecma:math:acos",            min_args = 1, max_args = 1 }
"math.atan"         = { emit = "host:ecma:math:atan",            min_args = 1, max_args = 1 }
"math.atan2"        = { emit = "host:ecma:math:atan2",           min_args = 2, max_args = 2 }
"math.exp"          = { emit = "host:ecma:math:exp",             min_args = 1, max_args = 1 }
"math.log"          = { emit = "host:ecma:math:log",             min_args = 1, max_args = 1 }

# ── Type conversion ─────────────────────────────────────────────────────────

"int.tryParse"      = { emit = "intrinsic:cint",         min_args = 1, max_args = 1 }
"double.tryParse"   = { emit = "host:ecma:number:Number",         min_args = 1, max_args = 1 }

# ── JSON (dart:convert) ─────────────────────────────────────────────────────

jsonEncode          = { emit = "host:ecma:json:stringify",        min_args = 1, max_args = 1 }
jsonDecode          = { emit = "host:ecma:json:parse",            min_args = 1, max_args = 1 }

# ── Date / Time ─────────────────────────────────────────────────────────────

"DateTime.now"      = { emit = "host:ecma:date:now",    min_args = 0, max_args = 0 }

# ── File I/O (dart:io) ──────────────────────────────────────────────────────

"File.readAsString"     = { emit = "host:wasi:filesystem:readFile",   min_args = 1, max_args = 1 }
"File.writeAsString"    = { emit = "host:wasi:filesystem:writeFile",  min_args = 2, max_args = 2 }

# ── Environment ─────────────────────────────────────────────────────────────

"Platform.environment"  = { emit = "host:wasi:cli:getEnv",       min_args = 1, max_args = 1 }

# ────────────────────────────────────────────────────────────────────────────
# VALUE METHODS — instance method calls on values
# ────────────────────────────────────────────────────────────────────────────

[value_methods]

# String instance methods
toUpperCase   = { emit = "common:strings.to_upper",   min_args = 0, max_args = 0 }
toLowerCase   = { emit = "common:strings.to_lower",   min_args = 0, max_args = 0 }
trim          = { emit = "common:strings.trim",        min_args = 0, max_args = 0 }
trimLeft      = { emit = "common:str_trim_start",      min_args = 0, max_args = 0 }
trimRight     = { emit = "common:str_trim_end",        min_args = 0, max_args = 0 }
startsWith    = { emit = "common:str_starts_with",     min_args = 1, max_args = 1 }
endsWith      = { emit = "common:str_ends_with",       min_args = 1, max_args = 1 }
contains      = { emit = "common:str_contains",        min_args = 1, max_args = 1 }
indexOf       = { emit = "common:strings.index_of",    min_args = 1, max_args = 2 }
lastIndexOf   = { emit = "common:str_last_index_of",   min_args = 1, max_args = 2 }
replaceAll    = { emit = "common:strings.replace",     min_args = 2, max_args = 2 }
split         = { emit = "common:strings.split",       min_args = 1, max_args = 1 }
substring     = { emit = "common:strings.substring",   min_args = 1, max_args = 2 }
padLeft       = { emit = "common:str_pad_start",       min_args = 1, max_args = 2 }
padRight      = { emit = "common:str_pad_end",         min_args = 1, max_args = 2 }
toString      = { emit = "common:dart.to_string",      min_args = 0, max_args = 0 }
codeUnitAt    = { emit = "common:str_char_code_at",    min_args = 1, max_args = 1 }
isEmpty       = { emit = "common:dart.is_empty",       min_args = 0, max_args = 0 }
isNotEmpty    = { emit = "common:dart.is_not_empty",   min_args = 0, max_args = 0 }
compareTo     = { emit = "common:str_compare",         min_args = 1, max_args = 1 }
replaceFirst  = { emit = "host:ecma:string:replace",   min_args = 2, max_args = 2 }

# List/Iterable property-style accessors (zero-arg getters).
first         = { emit = "common:dart.list_first",     min_args = 0, max_args = 0 }
containsKey   = { emit = "host:ecma:object:has",       min_args = 1, max_args = 1 }
containsValue = { emit = "host:ecma:object:hasOwn",    min_args = 1, max_args = 1 }
keys          = { emit = "host:ecma:object:keys",      min_args = 0, max_args = 0 }
last          = { emit = "common:dart.list_last",      min_args = 0, max_args = 0 }
length        = { emit = "common:dart.length",         min_args = 0, max_args = 0 }

# Array/List instance methods
add           = { emit = "common:collections.push",    min_args = 1, max_args = 1 }
removeLast    = { emit = "common:collections.pop",     min_args = 0, max_args = 0 }
insert        = { emit = "host:ecma:array:splice",     min_args = 2, max_args = 2 }
sublist       = { emit = "host:ecma:array:slice",      min_args = 1, max_args = 2 }
join          = { emit = "common:collections.join",    min_args = 0, max_args = 1 }
reversed      = { emit = "common:collections.reverse", min_args = 0, max_args = 0 }
toList        = { emit = "noop",                       min_args = 0, max_args = 0 }
toSet         = { emit = "host:ecma:set:fromIterable",  min_args = 0, max_args = 0 }

# Map methods
putIfAbsent   = { emit = "invoke:putIfAbsent",          min_args = 2, max_args = 2 }

# ────────────────────────────────────────────────────────────────────────────
# ARRAY METHODS — higher-order functions routed to compiler_common::loops
# ────────────────────────────────────────────────────────────────────────────

[array_methods]
map       = "__array_map"
where     = "__array_filter"
forEach   = "__array_forEach"
reduce    = "__array_reduce"
any       = "__array_some"
every     = "__array_every"
sort      = "__array_sort"

# ────────────────────────────────────────────────────────────────────────────
# ESM DEFAULTS — Dart library prefixes → host modules, ECMA-262 §16.2 shape
# ────────────────────────────────────────────────────────────────────────────

[[esm_default]]
kind = "namespace"
alias = "math"
module = "ecma:math"

[[esm_default]]
kind = "namespace"
alias = "Math"
module = "ecma:math"

[[esm_default]]
kind = "namespace"
alias = "json"
module = "ecma:json"

[[esm_default]]
kind = "namespace"
alias = "JSON"
module = "ecma:json"

[[esm_default]]
kind = "namespace"
alias = "http"
module = "wasi:http"

[[esm_default]]
kind = "namespace"
alias = "File"
module = "wasi:filesystem"

[[esm_default]]
kind = "namespace"
alias = "Directory"
module = "wasi:filesystem"

[[esm_default]]
kind = "namespace"
alias = "Map"
module = "ecma:map"

[[esm_default]]
kind = "namespace"
alias = "Set"
module = "ecma:set"

# DateTime / StringBuffer / Duration namespace aliases retired —
# these Dart types are constructed via the dotnet wrapper Component
# Model adapter (`new DateTime()` lowers through `datetime_adapter`,
# `new StringBuffer()` through `stringbuilder_adapter`). Method
# dispatch goes through the TypeRegistry vtable; no namespace
# fallback is needed.

# Random is resolved via known_types -> wasi:random/insecure. No namespace
# indirection needed.

[[esm_default]]
kind = "namespace"
alias = "Stopwatch"
module = "wasi:clocks/monotonic-clock"

[[esm_default]]
kind = "namespace"
alias = "RegExp"
module = "ecma:regexp"

# GUI namespace is now shared globally (added by add_shared_gui_namespace)
# instead of per-language duplication.
# Future / Stream / Process namespace aliases retired:
#   Future → JSPI promise (Op::PROMISE_*); no namespace object needed.
#   Stream → `wasi:io/streams` proposal; constructed via stream adapters.
#   Process → `node:child_process` (`spawnSync` / `execSync`); the
#     dotnet wrapper Component Model handles `Process.Start` for typed
#     receivers and lowers through `process_adapter`.

# Dart Isolate spawning compiles to Op::THREAD_SPAWN (WASM threads
# proposal) — no namespace object needed.

# Dart `utf8` / `base64` from `dart:convert` map to WHATWG primitives:
# `utf8` → TextEncoder/TextDecoder (`web:encoding`); `base64` → `btoa`/`atob`
# (also in `web:encoding`). Method dispatch (`utf8.encode` etc.) lowers
# through the dart adapter at compile time.
[[esm_default]]
kind = "namespace"
alias = "utf8"
module = "web:encoding"

[[esm_default]]
kind = "namespace"
alias = "base64"
module = "web:encoding"

# ────────────────────────────────────────────────────────────────────────────
# NAMESPACE CONSTANTS
# ────────────────────────────────────────────────────────────────────────────

[namespace_constants]
"math.pi"               = 3.141592653589793
"math.e"                = 2.718281828459045
"math.ln2"              = 0.6931471805599453
"math.ln10"             = 2.302585092994046
"math.sqrt2"            = 1.4142135623730951
"double.infinity"       = "Infinity"
"double.nan"            = "NaN"
"double.maxFinite"      = 1.7976931348623157e308

# ────────────────────────────────────────────────────────────────────────────
# KNOWN TYPES — constructor resolution for `new X()` / `X()`
# ────────────────────────────────────────────────────────────────────────────

[known_types]
# DateTime / StringBuffer retired — handled by the dotnet wrapper
# Component Model at compile time (`datetime_adapter`, `stringbuilder_adapter`).
Random          = ["wasi:random/insecure", "get-insecure-random-u64"]
Stopwatch       = ["common", "dotnet.stopwatch_new"]
RegExp          = ["ecma:regexp", "new"]

# ────────────────────────────────────────────────────────────────────────────
# NAMESPACES
# ────────────────────────────────────────────────────────────────────────────

[namespaces]
use_dotnet = false
roots = []
extra_imports = []

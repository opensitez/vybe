// Simple Lua grammar for vybe_compiler
// Based on Lua 5.4 syntax - simplified version

WHITESPACE = _{ " " | "\t" | "\r" | "\n" | COMMENT }
COMMENT = _{ ("--" ~ (!"\n" ~ ANY)*) }

ident = @{ ASCII_ALPHANUMERIC+ }

// Keywords - using individual rules like JavaScript does
KW_AND = { "and" }
KW_BREAK = { "break" }
KW_DO = { "do" }
KW_ELSE = { "else" }
KW_ELSEIF = { "elseif" }
KW_END = { "end" }
KW_FALSE = { "false" }
KW_FOR = { "for" }
KW_FUNCTION = { "function" }
KW_GOTO = { "goto" }
KW_IF = { "if" }
KW_IN = { "in" }
KW_LOCAL = { "local" }
KW_NIL = { "nil" }
KW_NOT = { "not" }
KW_OR = { "or" }
KW_REPEAT = { "repeat" }
KW_RETURN = { "return" }
KW_THEN = { "then" }
KW_TRUE = { "true" }
KW_UNTIL = { "until" }
KW_WHILE = { "while" }

keyword = { KW_AND | KW_BREAK | KW_DO | KW_ELSE | KW_ELSEIF | KW_END | KW_FALSE | KW_FOR | KW_FUNCTION | KW_GOTO | KW_IF | KW_IN | KW_LOCAL | KW_NIL | KW_NOT | KW_OR | KW_REPEAT | KW_RETURN | KW_THEN | KW_TRUE | KW_UNTIL | KW_WHILE }

name = { !keyword ~ ident }

// Literals
nil_literal = { KW_NIL }
boolean = { KW_TRUE | KW_FALSE }
number = { ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)? }
string_content = { (!("\"" | "\\") ~ ANY)* }
string = { "\"" ~ string_content ~ "\"" }
literal = { nil_literal | boolean | number | string }

// Basic expressions
primary = { name | literal | parens_expr }
parens_expr = { "(" ~ expr ~ ")" }

expr = { term ~ (binop ~ term)* }
term = { unary | primary }
unary = { (unop ~ term) }
unop = { KW_NOT | HASH | MINUS | TILDE }
binop = { KW_AND | KW_OR | LT | GT | LE | GE | NE | EQ | CONCAT | PLUS | MINUS | STAR | SLASH | DOUBLESLASH | PERCENT | CARET | AMPERSAND | PIPE | LSHIFT | RSHIFT }

// Operators
HASH = { "#" }
MINUS = { "-" }
TILDE = { "~" }
LT = { "<" }
GT = { ">" }
LE = { "<=" }
GE = { ">=" }
NE = { "~=" }
EQ = { "==" }
CONCAT = { ".." }
PLUS = { "+" }
STAR = { "*" }
SLASH = { "/" }
DOUBLESLASH = { "//" }
PERCENT = { "%" }
CARET = { "^" }
AMPERSAND = { "&" }
PIPE = { "|" }
LSHIFT = { "<<" }
RSHIFT = { ">>" }

// Punctuation
assign = { "=" }
comma = { "," }
lparen = { "(" }
rparen = { ")" }

// Statements
statement = { 
    local_var |
    function_decl |
    if_statement |
    while_statement |
    repeat_statement |
    return_statement |
    break_statement |
    expr
}

local_var = { KW_LOCAL ~ name ~ (comma ~ name)* ~ (assign ~ expr ~ (comma ~ expr)*)? }

function_decl = { KW_FUNCTION ~ name ~ lparen ~ (name ~ (comma ~ name)*)? ~ rparen ~ block ~ KW_END }

if_statement = { KW_IF ~ expr ~ KW_THEN ~ block ~ (KW_ELSEIF ~ expr ~ KW_THEN ~ block)* ~ (KW_ELSE ~ block)? ~ KW_END }

while_statement = { KW_WHILE ~ expr ~ KW_DO ~ block ~ KW_END }

repeat_statement = { KW_REPEAT ~ block ~ KW_UNTIL ~ expr }

return_statement = { KW_RETURN ~ (expr ~ ("," ~ expr)*)? }

break_statement = { KW_BREAK }

block = { statement* }

chunk = { SOI ~ block ~ EOI }
// Lua 5.x grammar (subset) for vybe_compiler — grow incrementally with tests.

WHITESPACE = _{ " " | "\t" | "\r" | "\n" | COMMENT }
COMMENT = _{ "--" ~ (!"\n" ~ ANY)* }

// Identifiers — keywords are reserved (Python-style `!keyword` guard).
keyword = _{
    ("and" | "break" | "do" | "else" | "elseif" | "end" | "false" | "for" | "function"
    | "if" | "in" | "local" | "nil" | "not" | "or" | "repeat" | "return" | "then"
    | "true" | "until" | "while")
    ~ !(ASCII_ALPHANUMERIC | "_")
}
name = @{ !keyword ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

KW_AND = @{ "and" ~ !(ASCII_ALPHANUMERIC | "_") }
KW_BREAK = @{ "break" ~ !(ASCII_ALPHANUMERIC | "_") }
KW_DO = @{ "do" ~ !(ASCII_ALPHANUMERIC | "_") }
KW_ELSE = @{ "else" ~ !(ASCII_ALPHANUMERIC | "_") }
KW_ELSEIF = @{ "elseif" ~ !(ASCII_ALPHANUMERIC | "_") }
KW_END = @{ "end" ~ !(ASCII_ALPHANUMERIC | "_") }
KW_FALSE = @{ "false" ~ !(ASCII_ALPHANUMERIC | "_") }
KW_FOR = @{ "for" ~ !(ASCII_ALPHANUMERIC | "_") }
KW_FUNCTION = @{ "function" ~ !(ASCII_ALPHANUMERIC | "_") }
KW_IF = @{ "if" ~ !(ASCII_ALPHANUMERIC | "_") }
KW_IN = @{ "in" ~ !(ASCII_ALPHANUMERIC | "_") }
KW_LOCAL = @{ "local" ~ !(ASCII_ALPHANUMERIC | "_") }
KW_NIL = @{ "nil" ~ !(ASCII_ALPHANUMERIC | "_") }
KW_NOT = @{ "not" ~ !(ASCII_ALPHANUMERIC | "_") }
KW_OR = @{ "or" ~ !(ASCII_ALPHANUMERIC | "_") }
KW_REPEAT = @{ "repeat" ~ !(ASCII_ALPHANUMERIC | "_") }
KW_RETURN = @{ "return" ~ !(ASCII_ALPHANUMERIC | "_") }
KW_THEN = @{ "then" ~ !(ASCII_ALPHANUMERIC | "_") }
KW_TRUE = @{ "true" ~ !(ASCII_ALPHANUMERIC | "_") }
KW_UNTIL = @{ "until" ~ !(ASCII_ALPHANUMERIC | "_") }
KW_WHILE = @{ "while" ~ !(ASCII_ALPHANUMERIC | "_") }

nil_literal = { KW_NIL }
boolean = { KW_TRUE | KW_FALSE }
number = @{ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)? }
string_content = { (!("\"" | "\\") ~ ANY)* }
string = { "\"" ~ string_content ~ "\"" }

lparen = { "(" }
rparen = { ")" }
lbracket = { "[" }
rbracket = { "]" }
comma = { "," }
assign = { "=" }
dot = { "." }

HASH = { "#" }
MINUS = { "-" }
TILDE = { "~" }
LT = { "<" }
GT = { ">" }
LE = { "<=" }
GE = { ">=" }
NE = { "~=" }
EQ = { "==" }
CONCAT = { ".." }
PLUS = { "+" }
STAR = { "*" }
SLASH = { "/" }
DOUBLESLASH = { "//" }
PERCENT = { "%" }
CARET = { "^" }

unop = { KW_NOT | HASH | MINUS | TILDE }

// JS-shaped precedence chain (see languages/js/grammar.pest).
primary = {
    KW_TRUE | KW_FALSE | KW_NIL
    | number | string
    | name
    | lparen ~ expr ~ rparen
}

postfix = { call_expression }
call_expression = { primary ~ call_chain* }
call_chain = {
    "(" ~ (expr ~ (comma ~ expr)*)? ~ ")"
    | "." ~ name
    | "[" ~ expr ~ "]"
}

unary = { unop ~ unary | postfix }

pow_expr = { unary ~ (pow_op ~ unary)* }
pow_op = { CARET }
multiplicative = { pow_expr ~ (mul_op ~ pow_expr)* }
mul_op = { DOUBLESLASH | STAR | SLASH | PERCENT }
additive = { multiplicative ~ (additive_op ~ multiplicative)* }
additive_op = { PLUS | MINUS }
concat_expr = { additive ~ (CONCAT ~ additive)* }
compare_expr = { concat_expr ~ (compare_op ~ concat_expr)* }
compare_op = { LE | GE | NE | EQ | LT | GT }
and_expr = { compare_expr ~ (KW_AND ~ compare_expr)* }
or_expr = { and_expr ~ (KW_OR ~ and_expr)* }
expr = { or_expr }

assign_stmt = { postfix ~ assign ~ expr }

stmt_not_else = { !(KW_ELSEIF | KW_ELSE | KW_END) ~ statement }
stmt_not_end = { !KW_END ~ statement }
then_block = { stmt_not_else* }
else_block = { stmt_not_end* }

statement = _{
    local_var
    | function_decl
    | if_statement
    | while_statement
    | repeat_statement
    | return_statement
    | break_statement
    | assign_stmt
    | expr
}

local_var = { KW_LOCAL ~ name ~ (comma ~ name)* ~ (assign ~ expr ~ (comma ~ expr)*)? }
function_decl = { KW_FUNCTION ~ name ~ lparen ~ (name ~ (comma ~ name)*)? ~ rparen ~ func_body ~ KW_END }
func_body = { stmt_not_end* }
if_statement = {
    KW_IF ~ expr ~ KW_THEN ~ then_block
    ~ (KW_ELSEIF ~ expr ~ KW_THEN ~ then_block)*
    ~ (KW_ELSE ~ else_block)?
    ~ KW_END
}
while_statement = { KW_WHILE ~ expr ~ KW_DO ~ body_block ~ KW_END }
body_block = { stmt_not_end* }
repeat_statement = { KW_REPEAT ~ body_block ~ KW_UNTIL ~ expr }
return_statement = { KW_RETURN ~ (expr ~ (comma ~ expr)*)? }
break_statement = { KW_BREAK }

block = { statement* }
chunk = { SOI ~ block ~ EOI }

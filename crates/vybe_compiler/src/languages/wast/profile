# WAST / WAT Compiler Profile
# ────────────────────────────
# Handles both .wat (WAT module only) and .wast (WAT + script commands).
# WAT is a subset of WAST — the same grammar and walker handle both.
#
# WAT functions are stack-based; the walker normalises them to the common AST:
#   - Binary ops (i32.add etc.) → BinOp
#   - Consts → literals
#   - local.get/set → Ident / Assign
#   - Everything else → Call(__instr_name_with_underscores, args)
#
# WAST script commands (assert_return, invoke, …) become top-level calls to
# __wast_* builtins defined here, which route to the vybe test harness.

[info]
name       = "wast"
extensions = ["wast", "wat"]

[compiler]
function_return  = "explicit"
self_keyword     = "this"
constructor_name = "constructor"
case_sensitive   = true
string_indexing  = "zero_based"

# ────────────────────────────────────────────────────────────────────────────
# BUILTINS
# Covers:
#   1. WAST script assertion helpers  → vybe test harness host fns
#   2. WAT runtime stubs              → WASM opcodes / host fns
#   3. Module lifecycle               → noop (handled at link time)
# ────────────────────────────────────────────────────────────────────────────

[builtins]

# ── WAST script commands ──────────────────────────────────────────────────────

__wast_assert_return     = { emit = "host:vybe:wast:assert_return",     min_args = 1, max_args = 255 }
__wast_assert_trap       = { emit = "host:vybe:wast:assert_trap",       min_args = 1, max_args = 2   }
__wast_assert_invalid    = { emit = "host:vybe:wast:assert_invalid",    min_args = 0, max_args = 1   }
__wast_assert_malformed  = { emit = "host:vybe:wast:assert_malformed",  min_args = 0, max_args = 1   }
__wast_assert_unlinkable = { emit = "host:vybe:wast:assert_unlinkable", min_args = 0, max_args = 1   }
__wast_assert_exhaustion = { emit = "host:vybe:wast:assert_exhaustion", min_args = 1, max_args = 2   }

# ── Module lifecycle ──────────────────────────────────────────────────────────

__wasm_import   = { emit = "noop", min_args = 2, max_args = 2 }
__wasm_export   = { emit = "noop", min_args = 1, max_args = 1 }
__wasm_register = { emit = "noop", min_args = 1, max_args = 2 }
__wasm_get      = { emit = "noop", min_args = 1, max_args = 2 }

# ── Control flow stubs ────────────────────────────────────────────────────────
# br/br_if/br_table have no direct common-AST equivalent; emit as noops.
# The walker already maps `return` to __wasm_return which the compiler
# recognises as a return statement via the profile entry below.

__wasm_return      = { emit = "noop", min_args = 0, max_args = 1 }
__wasm_br          = { emit = "noop", min_args = 1, max_args = 1 }
__wasm_br_if       = { emit = "noop", min_args = 2, max_args = 2 }
__wasm_br_table    = { emit = "noop", min_args = 1, max_args = 255 }
__wasm_unreachable = { emit = "host:vybe:wast:unreachable", min_args = 0, max_args = 0 }
__wasm_try         = { emit = "host:vybe:wast:try",         min_args = 0, max_args = 255 }


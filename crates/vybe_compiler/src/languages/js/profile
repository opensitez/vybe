btoa                    = { emit = "host:ecma:string:btoa",                  min_args = 1, max_args = 1 }
atob                    = { emit = "host:ecma:string:atob",                  min_args = 1, max_args = 1 }
encodeURIComponent      = { emit = "host:ecma:string:encodeURIComponent",    min_args = 1, max_args = 1 }
decodeURIComponent      = { emit = "host:ecma:string:decodeURIComponent",    min_args = 1, max_args = 1 }
encodeURI               = { emit = "host:ecma:string:encodeURI",             min_args = 1, max_args = 1 }

# ────────────────────────────────────────────────────────────────────────────
# KNOWN TYPES — constructor mappings for new TypeName()
# ────────────────────────────────────────────────────────────────────────────

[known_types]
"Object"        = ["ecma:object", "Object"]
"Boolean"       = ["ecma:boolean", "new"]
"Number"        = ["ecma:number", "new"]
"String"        = ["ecma:string", "new"]
"Array"         = ["ecma:array", "new"]
"Map"           = ["ecma:map", "new"]
"Set"           = ["ecma:set", "new"]
"Error"         = ["ecma:error", "Error"]
"TypeError"     = ["ecma:error", "TypeError"]
"RangeError"    = ["ecma:error", "RangeError"]
"ReferenceError" = ["ecma:error", "ReferenceError"]
"SyntaxError"   = ["ecma:error", "SyntaxError"]
"URIError"      = ["ecma:error", "URIError"]
"EvalError"     = ["ecma:error", "EvalError"]
"AggregateError" = ["ecma:error", "AggregateError"]
"RegExp"        = ["ecma:regexp", "new"]
"Date"          = ["ecma:date", "new"]
"Promise"       = ["ecma:promise", "new"]
"WeakMap"       = ["ecma:weakmap", "new"]
"WeakSet"       = ["ecma:weakset", "new"]
"WeakRef"       = ["ecma:weakref", "new"]
"FinalizationRegistry" = ["ecma:finalization-registry", "new"]
"ArrayBuffer"   = ["ecma:arraybuffer", "new"]
"SharedArrayBuffer" = ["ecma:sharedarraybuffer", "new"]
"DataView"      = ["ecma:dataview", "new"]
"Int8Array"          = ["ecma:int8array",     "new"]
"Uint8Array"         = ["ecma:uint8array",    "new"]
"Uint8ClampedArray"  = ["ecma:uint8clamped",  "new"]
"Int16Array"         = ["ecma:int16array",    "new"]
"Uint16Array"        = ["ecma:uint16array",   "new"]
"Int32Array"         = ["ecma:int32array",    "new"]
"Uint32Array"        = ["ecma:uint32array",   "new"]
"Float32Array"       = ["ecma:float32array",  "new"]
"Float64Array"       = ["ecma:float64array",  "new"]
"BigInt64Array"      = ["ecma:bigint64array", "new"]
"BigUint64Array"     = ["ecma:biguint64array","new"]

# ECMA-402 Intl classes — `new Intl.X(...)` resolves via the `Intl`
# namespace properties (set up by `vybe_host::namespaces::intl`), but
# code that writes the bare class name (e.g. `new NumberFormat(...)`
# after `import { NumberFormat } from "ecma:intl"`) hits these
# known_types entries and gets routed to the `:new` constructor.
"Collator"            = ["ecma:intl/collator", "new"]
"NumberFormat"        = ["ecma:intl/numberformat", "new"]
"DateTimeFormat"      = ["ecma:intl/datetimeformat", "new"]
"ListFormat"          = ["ecma:intl/listformat", "new"]
"PluralRules"         = ["ecma:intl/pluralrules", "new"]
"RelativeTimeFormat"  = ["ecma:intl/relativetimeformat", "new"]
"Segmenter"           = ["ecma:intl/segmenter", "new"]
"Locale"              = ["ecma:intl/locale", "new"]
"DisplayNames"        = ["ecma:intl/displaynames", "new"]
"DurationFormat"      = ["ecma:intl/durationformat", "new"]

# ECMA-262 §20.4 Symbol + §21.2 BigInt: per spec they are NOT constructors
# (`new Symbol()` / `new BigInt()` throws TypeError). The Symbol/BigInt
# globals are themselves callable HostFunction values (see
# `vybe_host::namespaces::ecma_globals`). No known_types entries needed.

# WHATWG / W3C web platform constructors. The instance methods (e.g.
# `urlObj.toString`, `enc.encode`, `headers.get`) dispatch via the
# TypeRegistry vtable on the `__type` stamp the `*New` host fns leave.
"URL"           = ["web:url", "new"]
"URLSearchParams" = ["web:url", "searchParamsNew"]
"TextEncoder"   = ["web:encoding", "encoderNew"]
"TextDecoder"   = ["web:encoding", "decoderNew"]
"Headers"       = ["web:fetch", "headersNew"]
"Request"       = ["web:fetch", "requestNew"]
"Response"      = ["web:fetch", "responseNew"]
# "Worker" constructor: lowered to Op::THREAD_SPAWN by the compiler, no
# host-fn ctor entry.


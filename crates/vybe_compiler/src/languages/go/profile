# Go Compiler Profile
# ───────────────────
# Covers Go core: packages, functions, structs, interfaces, slices, maps,
# methods, control flow. Goroutines lower to the shared thread/task emitter;
# channel/select support is compile-oriented in the frontend.

[info]
name = "go"
extensions = ["go"]

[compiler]
function_return = "explicit"
self_keyword = "this"
constructor_name = "constructor"
# namespaceplan.md: namespace-shaped entry points resolve through the
# common resolver — same flip as the other languages.
uses_common_resolver = true
enum_as_ordinals = false
case_sensitive = true
string_indexing = "zero_based"
entry_point = "main"
dynamic_add = true
uses_normalize_class = false
materialize_bool_results = true

# ────────────────────────────────────────────────────────────────────────────
# BUILTINS — bare global function calls
# ────────────────────────────────────────────────────────────────────────────

[builtins]

"__go_spawn"    = { emit = "common:threading.task_run",      min_args = 1, max_args = 1 }
"__go_to_int"   = { emit = "common:to_int",                  min_args = 1, max_args = 1 }
"__go_str_from_char_code" = { emit = "common:str_from_char_code", min_args = 1, max_args = 1 }

# ── I/O ──────────────────────────────────────────────────────────────────────

"fmt.Println"     = { emit = "common:go.fmt_println",    min_args = 0, max_args = 255 }
"fmt.Print"       = { emit = "common:go.fmt_print",      min_args = 0, max_args = 255 }
"fmt.Printf"      = { emit = "common:go.fmt_printf",     min_args = 1, max_args = 255 }
"fmt.Sprintf"     = { emit = "common:go.fmt_sprintf",    min_args = 1, max_args = 255 }
"__go_sprintf"    = { emit = "common:go.fmt_sprintf",    min_args = 1, max_args = 255 }

# ── Type conversion ──────────────────────────────────────────────────────────

"strconv.Atoi"    = { emit = "common:to_int",                    min_args = 1, max_args = 1 }
"strconv.Itoa"    = { emit = "host:ecma:string:String",         min_args = 1, max_args = 1 }
"strconv.ParseFloat" = { emit = "host:ecma:number:parseFloat",  min_args = 1, max_args = 1 }
"strconv.FormatInt"  = { emit = "host:ecma:number:toString",    min_args = 2, max_args = 2 }
"strconv.FormatUint" = { emit = "host:ecma:number:toString",    min_args = 2, max_args = 2 }
"__go_parse_int"     = { emit = "host:ecma:number:parseInt",    min_args = 1, max_args = 2 }
"__go_parse_float"   = { emit = "host:ecma:number:parseFloat",  min_args = 1, max_args = 1 }

# ── String functions ─────────────────────────────────────────────────────────

"strings.ToUpper" = { emit = "common:strings.to_upper",         min_args = 1, max_args = 1 }
"strings.ToLower" = { emit = "common:strings.to_lower",         min_args = 1, max_args = 1 }
"strings.Trim"    = { emit = "common:strings.trim",             min_args = 1, max_args = 1 }
"strings.TrimSpace" = { emit = "common:strings.trim",           min_args = 1, max_args = 1 }
"strings.Contains" = { emit = "common:str_contains",            min_args = 2, max_args = 2 }
"strings.HasPrefix" = { emit = "common:str_starts_with",        min_args = 2, max_args = 2 }
"strings.HasSuffix" = { emit = "common:str_ends_with",          min_args = 2, max_args = 2 }
"strings.Index"   = { emit = "common:strings.index_of",         min_args = 2, max_args = 2 }
"strings.Replace" = { emit = "common:strings.replace",          min_args = 3, max_args = 4 }
"strings.Count"   = { emit = "intrinsic:count",                min_args = 2, max_args = 2 }
"strings.Repeat"  = { emit = "common:str_repeat",              min_args = 2, max_args = 2 }
"strings.Compare" = { emit = "common:str_compare",             min_args = 2, max_args = 2 }
"strings.Split"   = { emit = "common:strings.split",            min_args = 2, max_args = 2 }
"strings.Join"    = { emit = "common:collections.join",         min_args = 2, max_args = 2 }
"strings.ReplaceAll" = { emit = "host:ecma:string:replaceAll",  min_args = 3, max_args = 3 }
"strings.LastIndex"  = { emit = "host:ecma:string:lastIndexOf", min_args = 2, max_args = 2 }
"strings.Title"      = { emit = "host:ecma:string:toUpperCase", min_args = 1, max_args = 1 }
"__go_regex_split_pat_first" = { emit = "common:go.regex_split_pat_first", min_args = 2, max_args = 2 }

# ── Math functions ───────────────────────────────────────────────────────────

"math.Sqrt"       = { emit = "opcode:f64_sqrt",                min_args = 1, max_args = 1 }
"math.Abs"        = { emit = "opcode:f64_abs",                 min_args = 1, max_args = 1 }
"math.Floor"      = { emit = "opcode:f64_floor",               min_args = 1, max_args = 1 }
"math.Ceil"       = { emit = "opcode:f64_ceil",                min_args = 1, max_args = 1 }
"math.Round"      = { emit = "opcode:f64_nearest",             min_args = 1, max_args = 1 }
"math.Min"        = { emit = "opcode:f64_min",                 min_args = 2, max_args = 2 }
"math.Max"        = { emit = "opcode:f64_max",                 min_args = 2, max_args = 2 }
"math.Pow"        = { emit = "host:ecma:math:pow",             min_args = 2, max_args = 2 }
"math.Sin"        = { emit = "host:ecma:math:sin",             min_args = 1, max_args = 1 }
"math.Cos"        = { emit = "host:ecma:math:cos",             min_args = 1, max_args = 1 }
"math.Tan"        = { emit = "host:ecma:math:tan",             min_args = 1, max_args = 1 }
"math.Asin"       = { emit = "host:ecma:math:asin",            min_args = 1, max_args = 1 }
"math.Acos"       = { emit = "host:ecma:math:acos",            min_args = 1, max_args = 1 }
"math.Atan"       = { emit = "host:ecma:math:atan",            min_args = 1, max_args = 1 }
"math.Atan2"      = { emit = "host:ecma:math:atan2",           min_args = 2, max_args = 2 }
"math.Log"        = { emit = "host:ecma:math:log",             min_args = 1, max_args = 1 }
"math.Exp"        = { emit = "host:ecma:math:exp",             min_args = 1, max_args = 1 }
"math.Pi"         = { emit = "host:ecma:math:PI",              min_args = 0, max_args = 0 }

# ── Float semantics (IEEE-754) ───────────────────────────────────────────────
"math.NaN"        = { emit = "common:math.nan",               min_args = 0, max_args = 0 }
"math.Inf"        = { emit = "common:math.inf",               min_args = 1, max_args = 1 }
"math.IsNaN"      = { emit = "host:ecma:number:isNaN",        min_args = 1, max_args = 1 }
"math.IsInf"      = { emit = "common:math.is_inf",            min_args = 2, max_args = 2 }
"math.Copysign"   = { emit = "common:math.copysign",          min_args = 2, max_args = 2 }
"math.Signbit"    = { emit = "common:math.signbit",           min_args = 1, max_args = 1 }
"math.Dim"        = { emit = "common:math.dim",               min_args = 2, max_args = 2 }
"math.Float64bits"     = { emit = "common:math.f64_bits",      min_args = 1, max_args = 1 }
"math.Float64frombits" = { emit = "common:math.f64_from_bits", min_args = 1, max_args = 1 }
"math.Float32bits"     = { emit = "common:math.f32_bits",      min_args = 1, max_args = 1 }
"math.Float32frombits" = { emit = "common:math.f32_from_bits", min_args = 1, max_args = 1 }
"math.Mod"        = { emit = "common:expressions.f64_mod",     min_args = 2, max_args = 2 }
"math.Remainder"  = { emit = "common:go.math_remainder",       min_args = 2, max_args = 2 }

# ── math/bits ────────────────────────────────────────────────────────────────
"bits.OnesCount"      = { emit = "common:go.bits_ones_count",    min_args = 1, max_args = 1 }
"bits.OnesCount8"     = { emit = "common:go.bits_ones_count",    min_args = 1, max_args = 1 }
"bits.OnesCount16"    = { emit = "common:go.bits_ones_count",    min_args = 1, max_args = 1 }
"bits.OnesCount32"    = { emit = "common:go.bits_ones_count",    min_args = 1, max_args = 1 }
"bits.OnesCount64"    = { emit = "common:go.bits_ones_count",    min_args = 1, max_args = 1 }
"bits.LeadingZeros"   = { emit = "common:go.bits_leading_zeros", min_args = 1, max_args = 1 }
"bits.LeadingZeros8"  = { emit = "common:go.bits_leading_zeros", min_args = 1, max_args = 1 }
"bits.LeadingZeros16" = { emit = "common:go.bits_leading_zeros", min_args = 1, max_args = 1 }
"bits.LeadingZeros32" = { emit = "common:go.bits_leading_zeros", min_args = 1, max_args = 1 }
"bits.LeadingZeros64" = { emit = "common:go.bits_leading_zeros", min_args = 1, max_args = 1 }

# ── Array/Slice builtins ─────────────────────────────────────────────────────

"len"             = { emit = "common:collections.length",      min_args = 1, max_args = 1 }
"cap"             = { emit = "common:collections.length",      min_args = 1, max_args = 1 }
"append"          = { emit = "common:collections.push",        min_args = 2, max_args = 255 }
"__vybe_channel_send"    = { emit = "common:channels.send",    min_args = 2, max_args = 2 }
"__vybe_channel_receive" = { emit = "common:channels.receive", min_args = 1, max_args = 1 }
"__vybe_channel_len"     = { emit = "common:channels.len",     min_args = 1, max_args = 1 }
"__vybe_channel_cap"     = { emit = "common:channels.cap",     min_args = 1, max_args = 1 }
"__vybe_channel_close"   = { emit = "common:channels.close",   min_args = 1, max_args = 1 }
"__go_fixed_array_clone" = { emit = "common:collections.clone", min_args = 1, max_args = 1 }
"__go_fixed_array_equal" = { emit = "common:collections.sequence_equal", min_args = 2, max_args = 2 }
"make"            = { emit = "host:ecma:array:from",           min_args = 1, max_args = 3 }
"copy"            = { emit = "host:ecma:array:copyWithin",     min_args = 2, max_args = 3 }
"delete"          = { emit = "host:ecma:object:delete",        min_args = 2, max_args = 2 }

# ── Error handling ───────────────────────────────────────────────────────────

"panic"           = { emit = "host:ecma:error:throw",          min_args = 1, max_args = 1 }

# ── sort package ─────────────────────────────────────────────────────────────
# Ints/Float64s/Strings sort in place; sort_in_place compares with dynamic `>`
# (numeric for numbers, lexical for strings), matching Go's ordering.
"sort.Ints"          = { emit = "common:collections.sort",     min_args = 1, max_args = 1 }
"sort.Float64s"      = { emit = "common:collections.sort",     min_args = 1, max_args = 1 }
"sort.Strings"       = { emit = "common:collections.sort",     min_args = 1, max_args = 1 }
# sort.Search*/Slice*/*AreSorted are rewritten in the walker to the injected
# sort prelude helpers (they need closures over the target slice).

# ── Time ─────────────────────────────────────────────────────────────────────

"time.Now"        = { emit = "host:ecma:date:now",             min_args = 0, max_args = 0 }

# ── time primitives exposed to the Go time prelude ───────────────────────────
# time.Time is modeled as {seconds, nanoseconds, loc} (the wasi wall-clock
# datetime shape). Now() uses wasi:clocks/wall-clock; calendar breakdown uses
# ecma:date. These builtins let the prelude reach those host surfaces.
"__go_wall_now"   = { emit = "host:wasi:clocks/wall-clock:now",  min_args = 0, max_args = 0 }
"__go_date_utc"   = { emit = "host:ecma:date:UTC",              min_args = 6, max_args = 7 }
"__go_date_new"   = { emit = "host:ecma:date:new",              min_args = 1, max_args = 1 }
"__go_date_year"  = { emit = "host:ecma:date:getUTCFullYear",   min_args = 1, max_args = 1 }
"__go_date_month" = { emit = "host:ecma:date:getUTCMonth",      min_args = 1, max_args = 1 }
"__go_date_day"   = { emit = "host:ecma:date:getUTCDate",       min_args = 1, max_args = 1 }
"__go_date_hour"  = { emit = "host:ecma:date:getUTCHours",      min_args = 1, max_args = 1 }
"__go_date_min"   = { emit = "host:ecma:date:getUTCMinutes",    min_args = 1, max_args = 1 }
"__go_date_sec"   = { emit = "host:ecma:date:getUTCSeconds",    min_args = 1, max_args = 1 }
"__go_date_wday"  = { emit = "host:ecma:date:getUTCDay",        min_args = 1, max_args = 1 }

# ── net/url primitives (WHATWG URL host, shared with JS) ─────────────────────
"__go_url_parse"  = { emit = "host:web:url:parse",                     min_args = 1, max_args = 2 }
"__go_url_esc"    = { emit = "host:ecma:string:encodeURIComponent",    min_args = 1, max_args = 1 }
"__go_url_unesc"  = { emit = "host:ecma:string:decodeURIComponent",    min_args = 1, max_args = 1 }

# ── File I/O ─────────────────────────────────────────────────────────────────

"os.ReadFile"     = { emit = "host:wasi:filesystem:readFile",  min_args = 1, max_args = 1 }
"os.WriteFile"    = { emit = "host:wasi:filesystem:writeFile", min_args = 2, max_args = 2 }
"os.Mkdir"        = { emit = "host:wasi:filesystem:mkdir",     min_args = 1, max_args = 2 }
"os.Remove"       = { emit = "host:wasi:filesystem:remove",    min_args = 1, max_args = 1 }

# ── Environment ──────────────────────────────────────────────────────────────

"os.Getenv"       = { emit = "host:wasi:cli:getEnv",         min_args = 1, max_args = 1 }
"os.Setenv"       = { emit = "host:wasi:cli:setEnv",         min_args = 2, max_args = 2 }

# ── Random ───────────────────────────────────────────────────────────────────

"rand.Intn"       = { emit = "host:ecma:math:random",        min_args = 1, max_args = 1 }

# ────────────────────────────────────────────────────────────────────────────
# VALUE METHODS — instance methods called on values
# ────────────────────────────────────────────────────────────────────────────

[value_methods]

# time.Duration unit accessors (receiver = nanoseconds)
Minutes      = { emit = "common:go.dur_minutes",      min_args = 0, max_args = 0 }
Seconds      = { emit = "common:go.dur_seconds",      min_args = 0, max_args = 0 }
Hours        = { emit = "common:go.dur_hours",        min_args = 0, max_args = 0 }
Nanoseconds  = { emit = "common:go.dur_nanoseconds",  min_args = 0, max_args = 0 }
Milliseconds = { emit = "common:go.dur_milliseconds", min_args = 0, max_args = 0 }
Microseconds = { emit = "common:go.dur_microseconds", min_args = 0, max_args = 0 }

# String methods
# charCodeAt is a compiler-internal lowering (range-over-string / byte-index emit
# `s.charCodeAt(i)`); resolve it straight to the native WASM js-string builtin so
# it never depends on receiver type-inference at the member-call site.
charCodeAt   = { emit = "host:wasm:js-string:charCodeAt", min_args = 1, max_args = 1 }
ToUpper      = { emit = "common:str_to_upper",      min_args = 0, max_args = 0 }
ToLower      = { emit = "common:str_to_lower",      min_args = 0, max_args = 0 }
Trim         = { emit = "common:str_trim",          min_args = 0, max_args = 0 }
TrimSpace    = { emit = "common:str_trim",          min_args = 0, max_args = 0 }
Contains     = { emit = "common:str_contains",      min_args = 1, max_args = 1 }
HasPrefix    = { emit = "common:str_starts_with",   min_args = 1, max_args = 1 }
HasSuffix    = { emit = "common:str_ends_with",     min_args = 1, max_args = 1 }
Index        = { emit = "common:strings.index_of",  min_args = 1, max_args = 2 }
LastIndex    = { emit = "common:str_last_index_of", min_args = 1, max_args = 2 }
Replace      = { emit = "common:strings.replace",   min_args = 2, max_args = 2 }
ReplaceAll   = { emit = "common:strings.replace",   min_args = 2, max_args = 2 }
Split        = { emit = "common:strings.split",     min_args = 1, max_args = 1 }
Join         = { emit = "common:collections.join",  min_args = 1, max_args = 1 }

# Slice/Array methods
Append       = { emit = "common:collections.push",  min_args = 1, max_args = 255 }
Len          = { emit = "common:collections.length", min_args = 0, max_args = 0 }
Cap          = { emit = "common:collections.length", min_args = 0, max_args = 0 }

# Map methods
HasKey       = { emit = "common:dict.has",          min_args = 1, max_args = 1 }
Delete       = { emit = "host:ecma:object:delete",  min_args = 1, max_args = 1 }
Keys         = { emit = "host:ecma:object:keys",    min_args = 0, max_args = 0 }
Values       = { emit = "host:ecma:object:values",  min_args = 0, max_args = 0 }

# ────────────────────────────────────────────────────────────────────────────
# ARRAY METHODS — higher-order functions
# ────────────────────────────────────────────────────────────────────────────

[array_methods]

# ────────────────────────────────────────────────────────────────────────────
# NAMESPACE CONSTANTS
# ────────────────────────────────────────────────────────────────────────────

[namespace_constants]
"math.Pi"       = 3.141592653589793
# time.Duration constants — nanoseconds (Duration is an int64 ns count).
"time.Nanosecond"  = 1
"time.Microsecond" = 1000
"time.Millisecond" = 1000000
"time.Second"      = 1000000000
"time.Minute"      = 60000000000
"time.Hour"        = 3600000000000
"math.E"        = 2.718281828459045
"math.Ln2"      = 0.6931471805599453
"math.Ln10"     = 2.302585092994046
"math.Sqrt2"    = 1.4142135623730951
"math.MaxFloat" = 1.7976931348623157e308
"math.SmallestNonzeroFloat64" = 5e-324

# ────────────────────────────────────────────────────────────────────────────
# KNOWN TYPES
# ────────────────────────────────────────────────────────────────────────────

[known_types]
"error"         = ["ecma:error", "Error"]

# ────────────────────────────────────────────────────────────────────────────
# NAMESPACES
# ────────────────────────────────────────────────────────────────────────────

[namespaces]
use_dotnet = false
roots = []
extra_imports = []

# Python Compiler Profile
# ────────────────────────
# Port of vybe_compiler_python builtins, value methods, module aliases.

[info]
name = "python"
extensions = ["py", "pyw"]

[compiler]
function_return = "explicit"
self_keyword = "self"
constructor_name = "__init__"
enum_as_ordinals = false
case_sensitive = true
string_indexing = "zero_based"
base_keyword = "super"
dynamic_add = true
# Python `arr[-1]` returns the last element. Compiler emits a
# normalize-before-index sequence (`if i < 0: i = len + i`) when
# this is set. JS/VB/C# leave it false — they return undefined.
negative_index_wraps = true
# Route `return a, b` / `a, b = f()` through WASM multi-value — a
# uniform-tuple-return function gets chunk.result_arity = N set and
# callers destructure straight off the stack instead of materialising
# a heap tuple. See compiler/mod.rs `collect_multi_return_functions`.
multi_value_tuple_returns = true
# Route `class` declarations through common::classes::normalize_class
# + emit_class (see classnormalization.md). Walker-level normalisation
# of Python's dunder methods to canonical cross-language names.
uses_normalize_class = true

# ────────────────────────────────────────────────────────────────────────────

# ────────────────────────────────────────────────────────────────────────────
# ESM DEFAULTS — Python namespace objects → host modules, ECMA-262 §16.2 shape
# ────────────────────────────────────────────────────────────────────────────

[[esm_default]]
kind = "namespace"
alias = "math"
module = "ecma:math"

[[esm_default]]
kind = "namespace"
alias = "os"
module = "wasi:filesystem"

[[esm_default]]
kind = "namespace"
alias = "sys"
module = "wasi:cli"

[[esm_default]]
kind = "namespace"
alias = "json"
module = "ecma:json"

# Python `re` module → `ecma:regexp` (the spec-aligned ECMA-262 §22
# RegExp surface). Pattern-first language idioms (`re.search(pat, s)`)
# are bridged via stdlib adapter chunks; `re` namespace itself just
# routes identifier lookup to `ecma:regexp`.
[[esm_default]]
kind = "namespace"
alias = "re"
module = "ecma:regexp"

[[esm_default]]
kind = "namespace"
alias = "random"
module = "ecma:math"

[[esm_default]]
kind = "namespace"
alias = "time"
module = "wasi:clocks"

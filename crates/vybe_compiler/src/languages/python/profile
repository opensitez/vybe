issubset        = { emit = "host:ecma:set:isSubsetOf",        min_args = 1, max_args = 1 }
issuperset      = { emit = "host:ecma:set:isSupersetOf",      min_args = 1, max_args = 1 }
isdisjoint      = { emit = "host:ecma:set:isDisjointFrom",    min_args = 1, max_args = 1 }

# File object methods
read            = { emit = "host:wasi:filesystem:readFile",   min_args = 0, max_args = 1 }
write           = { emit = "host:wasi:filesystem:writeFile",  min_args = 1, max_args = 1 }
readline        = { emit = "host:wasi:filesystem:readLine",   min_args = 0, max_args = 1 }
readlines       = { emit = "host:wasi:filesystem:readLines",  min_args = 0, max_args = 0 }
close           = { emit = "host:wasi:filesystem:close",      min_args = 0, max_args = 0 }

# Generic method aliases (cross-language compat)
toString        = { emit = "common:python.tostring",                  min_args = 0, max_args = 0 }
__str__         = { emit = "common:python.tostring",                  min_args = 0, max_args = 0 }
__repr__        = { emit = "common:python.tostring",                  min_args = 0, max_args = 0 }
__len__         = { emit = "str_length",                       min_args = 0, max_args = 0 }

# ────────────────────────────────────────────────────────────────────────────
# NAMESPACE CONSTANTS — math.pi, math.e, etc.
# ────────────────────────────────────────────────────────────────────────────

[namespace_constants]
"math.pi"       = 3.141592653589793
"math.e"        = 2.718281828459045
"math.tau"      = 6.283185307179586
"math.inf"      = "Infinity"
"math.nan"      = "NaN"
"float.inf"     = "Infinity"
"float.nan"     = "NaN"
"True"          = true
"False"         = false

# ────────────────────────────────────────────────────────────────────────────
# ESM DEFAULTS — Python namespace objects → host modules, ECMA-262 §16.2 shape
# ────────────────────────────────────────────────────────────────────────────

[[esm_default]]
kind = "namespace"
alias = "math"
module = "ecma:math"

[[esm_default]]
kind = "namespace"
alias = "os"
module = "wasi:filesystem"

[[esm_default]]
kind = "namespace"
alias = "sys"
module = "wasi:cli"

[[esm_default]]
kind = "namespace"
alias = "json"
module = "ecma:json"

# json module export surface (namespaceplan.md mount-with-rename): Python's
# names differ from the canonical ECMA export names, so `from json import
# dumps` binds `dumps` → ecma:json.stringify through the standard ESM
# Named-import path.

[[esm_default]]
kind = "module-export"
module = "json"
name = "dumps"
target_module = "ecma:json"
target_name = "stringify"

[[esm_default]]
kind = "module-export"
module = "json"
name = "loads"
target_module = "ecma:json"
target_name = "parse"

# Python `re` module → `ecma:regexp` (the spec-aligned ECMA-262 §22
# RegExp surface). Pattern-first language idioms (`re.search(pat, s)`)
# are bridged via stdlib adapter chunks; `re` namespace itself just
# routes identifier lookup to `ecma:regexp`.
[[esm_default]]
kind = "namespace"
alias = "re"
module = "ecma:regexp"

[[esm_default]]
kind = "namespace"
alias = "random"
module = "ecma:math"

[[esm_default]]
kind = "namespace"
alias = "time"
module = "wasi:clocks/wall-clock"

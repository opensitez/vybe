# ── re module ────────────────────────────────────────────────────────────────

# Python `re.*` → ECMA-262 §22.2 RegExp. Python's pattern-first
# convention matches `ecma:regexp.test/exec` directly. re.match's
# start-anchoring is lost (exec is unanchored) — most callers use
# re.search anyway.
#
# re.findall/re.sub/re.split route through stdlib adapter chunks that
# reorder Python's pat-first args into ECMA's str-first order before
# calling ecma:regexp.*.
"re.search"      = { emit = "host:ecma:regexp:exec",             min_args = 2, max_args = 3 }
"re.match"       = { emit = "host:ecma:regexp:exec",             min_args = 2, max_args = 3 }
"re.findall"     = { emit = "stdlib:regex_match_all_pat_first",  min_args = 2, max_args = 3 }
"re.sub"         = { emit = "stdlib:regex_replace_pat_first",    min_args = 3, max_args = 4 }
"re.split"       = { emit = "stdlib:regex_split_pat_first",      min_args = 2, max_args = 3 }

# ── time module ──────────────────────────────────────────────────────────────

"time.time"      = { emit = "host:wasi:clocks:now",           min_args = 0, max_args = 0 }
"time.sleep"     = { emit = "host:wasi:clocks:sleep",         min_args = 1, max_args = 1 }

# ── subprocess module ────────────────────────────────────────────────────────

"subprocess.run"  = { emit = "host:node:child_process:execSync", min_args = 1, max_args = 3 }

# ── threading module ─────────────────────────────────────────────────────────

"threading.Thread" = { emit = "common:threading.task_run",     min_args = 0, max_args = 2 }


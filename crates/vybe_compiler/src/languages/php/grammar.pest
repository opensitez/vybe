// PHP grammar for pest — full PHP 8 surface.
//
// Notes:
// - PHP terminates statements with `;` (no ASI). NEWLINE is whitespace.
// - The lexer/parser strips the optional `<?php`/`?>` open/close tags.
//   For now we accept either an `<?php` prefix OR a script with no tag at
//   all. Mixed-mode (HTML between tags) is NOT supported.
// - `$variable` is a distinct token shape from a bare `Identifier` —
//   identifiers without `$` are function names, class names, constants.
// - Heredoc / nowdoc / interpolated double-quoted strings: NOT yet
//   handled at the grammar level. Single-quoted and plain double-quoted
//   work.
// - Keyword operators (`and`, `or`, `xor`, `instanceof`, `new`, `clone`,
//   `not`-style `!`) need atomic-rule word-boundary checks in pest's
//   non-atomic context. Defined below as `*_keyword` atomic rules.
// - Expression chain is intentionally flat (~12 levels) per skill MD.

// ── Whitespace and comments ──────────────────────────────────────────────────

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{ line_comment | hash_comment | block_comment }
line_comment  = _{ "//" ~ (!("\n" | "\r") ~ ANY)* }
hash_comment  = _{ "#" ~ !"[" ~ (!("\n" | "\r") ~ ANY)* }
block_comment = _{ "/*" ~ (!"*/" ~ ANY)* ~ "*/" }

// ── Program ──────────────────────────────────────────────────────────────────

// PHP file shape. Real PHP files start in HTML mode and switch into
// PHP code with `<?php` (or short-echo `<?=`), closing back to HTML
// with `?>`. A .php source with no tags at all is treated as pure PHP
// (tag-less convenience supported by this compiler's tests).
//
// Three alternatives, first match wins:
//   html-first — file begins with literal HTML before any `<?php`
//   php-first  — file begins with `<?php`/`<?=` (may contain later HTML)
//   bare       — no tags anywhere; entire file is PHP statements
program = {
    SOI
    ~ (program_html_first | program_php_first | program_bare)
    ~ EOI
}

program_pure = {
    SOI
    ~ pure_top_level_statement*
    ~ EOI
}

pure_top_level_statement = { statement }

program_html_first = _{ inline_html ~ &"<?" ~ mixed_php_segments }
program_php_first  = _{ mixed_php_segments }
program_bare       = _{ statement* }

// One `<?php … ?>` or `<?= expr ?>` region. In mixed PHP/HTML files,
// closed segments must end at a real `?>`; only the final segment may
// omit the close tag at EOF.
mixed_php_segments = _{
    php_segment_closed
    ~ (inline_html? ~ php_segment_closed)*
    ~ inline_html?
    ~ php_segment_eof?
    ~ inline_html?
    | php_segment_eof
}

php_segment_closed = _{ php_echo_segment_closed | php_code_segment_closed }
php_segment_eof    = _{ php_echo_segment_eof | php_code_segment_eof }
php_code_segment_closed = { open_tag_code ~ statement* ~ close_tag }
php_echo_segment_closed = { open_tag_echo ~ expression ~ (";")? ~ close_tag }
php_code_segment_eof = { open_tag_code ~ statement* ~ close_tag? }
php_echo_segment_eof = { open_tag_echo ~ expression ~ (";")? ~ close_tag? }

// Inline HTML is any run of characters that doesn't contain a PHP
// open tag. Atomic so internal whitespace is preserved verbatim.
inline_html = @{ (!"<?" ~ ANY)+ }

open_tag_code = _{ "<?php" | "<?" }
open_tag_echo = _{ "<?=" }
close_tag     = _{ "?>" }

// ── Keywords (atomic rules for word-boundary safety) ─────────────────────────

// Keywords that participate in expressions or need word-boundary lookahead
// MUST be atomic. PHP keywords are case-insensitive.

kw_if = @{ ^"if"          ~ !ident_cont }
kw_elseif = @{ ^"elseif"      ~ !ident_cont }
kw_else_if = @{ ^"else" ~ WHITESPACE+ ~ ^"if" ~ !ident_cont }
kw_else = @{ ^"else"        ~ !ident_cont }
kw_while = @{ ^"while"       ~ !ident_cont }
kw_do = @{ ^"do"          ~ !ident_cont }
kw_for = @{ ^"for"         ~ !ident_cont }
kw_foreach = @{ ^"foreach"     ~ !ident_cont }
kw_as = @{ ^"as"          ~ !ident_cont }
kw_switch = @{ ^"switch"      ~ !ident_cont }
kw_case = @{ ^"case"        ~ !ident_cont }
kw_default = @{ ^"default"     ~ !ident_cont }
kw_break = @{ ^"break"       ~ !ident_cont }
kw_continue = @{ ^"continue"    ~ !ident_cont }
kw_return = @{ ^"return"      ~ !ident_cont }
kw_goto = @{ ^"goto"        ~ !ident_cont }
kw_declare = @{ ^"declare"     ~ !ident_cont }
kw_function = @{ ^"function"    ~ !ident_cont }
kw_class = @{ ^"class"       ~ !ident_cont }
kw_extends = @{ ^"extends"     ~ !ident_cont }
kw_implements = @{ ^"implements"  ~ !ident_cont }
kw_interface = @{ ^"interface"   ~ !ident_cont }
kw_trait = @{ ^"trait"       ~ !ident_cont }
kw_insteadof = @{ ^"insteadof"   ~ !ident_cont }
kw_enum = @{ ^"enum"        ~ !ident_cont }
kw_new = @{ ^"new"         ~ !ident_cont }
kw_clone = @{ ^"clone"       ~ !ident_cont }
kw_echo = @{ ^"echo"        ~ !ident_cont }
kw_print = @{ ^"print"       ~ !ident_cont }
kw_include = @{ ^"include"     ~ !ident_cont }
kw_include_once = @{ ^"include_once" ~ !ident_cont }
kw_require = @{ ^"require"     ~ !ident_cont }
kw_require_once = @{ ^"require_once" ~ !ident_cont }
kw_null = @{ ^"null"        ~ !ident_cont }
kw_true = @{ ^"true"        ~ !ident_cont }
kw_false = @{ ^"false"       ~ !ident_cont }
kw_instanceof = @{ ^"instanceof"  ~ !ident_cont }
kw_throw = @{ ^"throw"       ~ !ident_cont }
kw_try = @{ ^"try"         ~ !ident_cont }
kw_catch = @{ ^"catch"       ~ !ident_cont }
kw_finally = @{ ^"finally"     ~ !ident_cont }
kw_static = @{ ^"static"      ~ !ident_cont }
kw_public = @{ ^"public"      ~ !ident_cont }
kw_private = @{ ^"private"     ~ !ident_cont }
kw_protected = @{ ^"protected"   ~ !ident_cont }
kw_abstract = @{ ^"abstract"    ~ !ident_cont }
kw_final = @{ ^"final"       ~ !ident_cont }
kw_const = @{ ^"const"       ~ !ident_cont }
kw_match = @{ ^"match"       ~ !ident_cont }
kw_fn = @{ ^"fn"          ~ !ident_cont }
kw_use = @{ ^"use"         ~ !ident_cont }
kw_namespace = @{ ^"namespace"   ~ !ident_cont }
kw_yield_from = @{ ^"yield" ~ WHITESPACE+ ~ ^"from" ~ !ident_cont }
kw_yield = @{ ^"yield"       ~ !ident_cont }
kw_list = @{ ^"list"        ~ !ident_cont }
kw_global = @{ ^"global"      ~ !ident_cont }
kw_readonly = @{ ^"readonly"    ~ !ident_cont }
kw_get = @{ ^"get"         ~ !ident_cont }
kw_set = @{ ^"set"         ~ !ident_cont }
kw_and = @{ ^"and"         ~ !ident_cont }
kw_or = @{ ^"or"          ~ !ident_cont }
kw_xor = @{ ^"xor"         ~ !ident_cont }
kw_self = @{ ^"self"        ~ !ident_cont }
kw_parent = @{ ^"parent"      ~ !ident_cont }
kw_isset = @{ ^"isset"       ~ !ident_cont }
kw_empty = @{ ^"empty"       ~ !ident_cont }
kw_unset = @{ ^"unset"       ~ !ident_cont }
kw_endif = @{ ^"endif"       ~ !ident_cont }
kw_endwhile = @{ ^"endwhile"    ~ !ident_cont }
kw_endfor = @{ ^"endfor"      ~ !ident_cont }
kw_endforeach = @{ ^"endforeach"  ~ !ident_cont }
kw_endswitch = @{ ^"endswitch"   ~ !ident_cont }

// Word-boundary lookahead character class
ident_cont = _{ ASCII_ALPHANUMERIC | "_" }

// Cast keywords (inside parens for `(int) $x`, `(string) $y`, …)
cast_kw = @{
    (^"integer" | ^"int" | ^"double" | ^"float" | ^"real"
     | ^"string" | ^"boolean" | ^"bool" | ^"array" | ^"object")
    ~ !ident_cont
}

// Reserved word predicate — used in `identifier` to reject reserved
// words from being parsed as identifiers.
reserved = _{
    kw_if | kw_elseif | kw_else_if | kw_else | kw_while | kw_do | kw_for
    | kw_foreach | kw_as | kw_switch | kw_case | kw_default | kw_break
    | kw_continue | kw_return | kw_goto | kw_declare | kw_function | kw_class | kw_extends
    | kw_implements | kw_interface | kw_trait | kw_enum | kw_new | kw_clone
    | kw_echo | kw_print | kw_null | kw_true | kw_false | kw_instanceof
    | kw_include | kw_include_once | kw_require | kw_require_once
    | kw_throw | kw_try | kw_catch | kw_finally | kw_static | kw_public
    | kw_private | kw_protected | kw_abstract | kw_final | kw_const
    | kw_match | kw_fn | kw_use | kw_namespace | kw_yield_from | kw_yield
    | kw_list | kw_global | kw_readonly | kw_and | kw_or | kw_xor
    | kw_self | kw_parent | kw_isset | kw_empty | kw_unset | kw_insteadof
    | kw_endif | kw_endwhile | kw_endfor | kw_endforeach | kw_endswitch
}

// ── Identifiers, variables, literals ─────────────────────────────────────────

identifier = @{ !reserved ~ (ASCII_ALPHA | "_") ~ ident_cont* }

// `$varname`, `$$name`, `${expr}`.
simple_variable = @{ "$" ~ (ASCII_ALPHA | "_") ~ ident_cont* }
dynamic_variable = { "$" ~ (simple_variable | "{" ~ expression ~ "}") }
variable = { dynamic_variable | simple_variable }

// PHP allows backslash-qualified names: \Foo\Bar\Baz, Foo\Bar
qualified_name = @{ "\\"? ~ identifier ~ ("\\" ~ identifier)* }

// PHP 7.4 numeric separators: 1_000_000, 0xFF_FF, etc. The walker
// strips underscores before parsing.
number_lit = @{
    "0x" ~ ASCII_HEX_DIGIT ~ (ASCII_HEX_DIGIT | "_")*
    | "0b" ~ ('0'..'1') ~ ('0'..'1' | "_")*
    | "0o" ~ ('0'..'7') ~ ('0'..'7' | "_")*
    | ASCII_DIGIT ~ (ASCII_DIGIT | "_")* ~ ("." ~ (ASCII_DIGIT | "_")*)? ~ (^"e" ~ ("+" | "-")? ~ ASCII_DIGIT+)?
    | "." ~ ASCII_DIGIT ~ (ASCII_DIGIT | "_")* ~ (^"e" ~ ("+" | "-")? ~ ASCII_DIGIT+)?
}

// Single-quoted: literal, supports `\'` and `\\`. No interpolation.
sq_string = @{ "'" ~ ("\\'" | "\\\\" | (!"'" ~ ANY))* ~ "'" }

// Double-quoted: literal with `\n`/`\t`/`\"`/`\\`/`\$` escapes. NO
// interpolation in Phase 1 — recognised as a flat string body.
dq_string = @{ "\"" ~ ("\\\"" | "\\\\" | "\\$" | "\\" ~ ANY | (!"\"" ~ ANY))* ~ "\"" }

// Heredoc / nowdoc — `<<<TAG ... TAG`. Nowdoc is `<<<'TAG'`. Same
// shape, the only difference is that nowdoc doesn't interpolate (we
// don't interpolate either form yet). PUSH/POP threads the closing tag
// through the parser stack so we can match it on the closing line.
heredoc_str = ${
    "<<<" ~ ("\""? ~ "'"?) ~ PUSH(heredoc_tag) ~ ("\""? ~ "'"?) ~ ("\r"? ~ "\n")
    ~ (!( ("\r"? ~ "\n") ~ (" " | "\t")* ~ PEEK ~ (";" | "," | ")" | "\r" | "\n")) ~ ANY)*
    ~ ("\r"? ~ "\n") ~ (" " | "\t")* ~ POP
}
heredoc_tag = @{ (ASCII_ALPHA | "_") ~ ident_cont* }

string_lit = { sq_string | dq_string | heredoc_str }

// ── Statements ───────────────────────────────────────────────────────────────

statement = _{
    empty_statement
    | template_break_stmt
    | template_echo_stmt
    | block_statement
    | const_statement
    | global_statement
    | static_variable_statement
    | namespace_statement
    | use_statement
    | function_declaration
    | class_declaration
    | interface_declaration
    | trait_declaration
    | enum_declaration
    | if_statement
    | while_statement
    | do_while_statement
    | for_statement
    | foreach_statement
    | goto_statement
    | label_statement
    | declare_statement
    | switch_statement
    | return_statement
    | break_statement
    | continue_statement
    | throw_statement
    | try_statement
    | echo_statement
    | print_statement
    | expression_statement
}

empty_statement = { ";" }

block_statement = { "{" ~ statement* ~ "}" }

// `namespace Foo\Bar;` and `namespace Foo { ... }` — both forms accepted,
// content effectively flattened (we ignore the namespace prefix).
namespace_statement = {
    kw_namespace ~ qualified_name? ~ (";" | block_statement)
}

// `use Foo\Bar;` / `use Foo\Bar as Baz;` / `use function Foo\bar;` etc.
// Also accepts PHP 7 group use: `use Foo\{Bar, Baz as B, function fn};`
use_statement = {
    kw_use ~ (kw_function | kw_const)? ~ use_group_or_item
    ~ ("," ~ use_group_or_item)* ~ ","? ~ ";"
}

use_group_or_item = { use_group | use_item }

use_group = {
    qualified_name ~ "\\" ~ "{"
    ~ use_item ~ ("," ~ use_item)* ~ ","?
    ~ "}"
}

use_item = { (kw_function | kw_const)? ~ qualified_name ~ (kw_as ~ identifier)? }

const_statement = {
    kw_const ~ identifier ~ "=" ~ expression ~ ";"
}

global_statement = {
    kw_global ~ variable ~ ("," ~ variable)* ~ ";"
}

// `static $x;` or `static $x = expr;` — function-local static variable
// that retains its value across calls. Multiple entries: `static $a, $b = 1;`.
static_variable_statement = {
    kw_static ~ static_variable_decl ~ ("," ~ static_variable_decl)* ~ ";"
}
static_variable_decl = { variable ~ ("=" ~ expression)? }

// PHP mixed-mode breaks inside a statement list. Every PHP web page does
// this — `?> <td>static</td> <?php` inside a switch case or loop body
// emits the literal HTML then resumes PHP. Walker rewrites both forms
// to `StmtKind::Echo(...)`:
//   - template_break_stmt: `?>TEXT<?php` → echo "TEXT"
//   - template_echo_stmt:  `?>TEXT<?= expr ?>` → echo "TEXT"; echo expr;
// The trailing open tag is required so the enclosing statement list stays
// in PHP mode; a bare `?>TEXT` at end of input is handled by program's
// outer `inline_html?` tail.
template_break_stmt = { close_tag ~ template_text ~ open_tag_code }
template_echo_stmt  = { close_tag ~ template_text ~ open_tag_echo }
template_text = @{ (!"<?" ~ ANY)* }
stmt_terminator = _{ ";" | &close_tag }

// ── Attributes (PHP 8.0+) ────────────────────────────────────────────────────
//
// `#[Attribute]`, `#[Attr('arg', key: 'val')]`, multiple attributes per
// group: `#[A, B]`. Attributes precede class/function/method/property/
// param declarations and are discarded by the walker.

attribute_group = { "#[" ~ attribute ~ ("," ~ attribute)* ~ ","? ~ "]" }
attribute = { qualified_name ~ ("(" ~ arg_list? ~ ")")? }

// ── Function declarations ────────────────────────────────────────────────────

function_declaration = {
    attribute_group*
    ~ kw_function ~ "&"? ~ method_ident
    ~ "(" ~ param_list? ~ ")"
    ~ return_type_annotation?
    ~ block_statement
}

param_list = { param ~ ("," ~ param)* ~ ","? }

param = {
    attribute_group* ~ param_modifier* ~ type_annotation? ~ "&"? ~ "..."? ~ variable ~ ("=" ~ expression)?
}

// PHP 8 promoted constructor parameters: `public int $foo`, `private $bar`
param_modifier = { kw_public | kw_private | kw_protected | kw_readonly }

// Type annotations are accepted but the walker discards them (we don't
// type-check). Supports `?Foo`, `int|string`, `Foo&Bar`, `array`, etc.
type_annotation = {
    "?"? ~ type_atom ~ (("|" | "&") ~ type_atom)*
}

return_type_annotation = { ":" ~ type_annotation }

// PHP 8.0+ allows `null`, `false`, `true` as standalone type atoms.
// PHP 8.2 added `false`/`null` as types and `true` followed in 8.2.
// `self` / `static` / `parent` are valid PHP type atoms in method
// return-type position (PHP 8 added `static`; `self`/`parent` were
// always allowed). They denote the enclosing class / late-bound
// class / parent class respectively — the walker drops type
// annotations, so the parser only needs to accept them.
type_atom = {
    kw_null
    | kw_true
    | kw_false
    | kw_self
    | kw_static
    | kw_parent
    | qualified_name
    | "(" ~ type_annotation ~ ")"
}

// ── Class declarations ───────────────────────────────────────────────────────

class_declaration = {
    attribute_group* ~ class_modifier* ~ kw_class ~ identifier
    ~ (kw_extends ~ qualified_name)?
    ~ (kw_implements ~ qualified_name ~ ("," ~ qualified_name)*)?
    ~ "{" ~ class_member* ~ "}"
}

class_modifier = { kw_abstract | kw_final | kw_readonly }

interface_declaration = {
    attribute_group* ~ kw_interface ~ identifier
    ~ (kw_extends ~ qualified_name ~ ("," ~ qualified_name)*)?
    ~ "{" ~ class_member* ~ "}"
}

trait_declaration = {
    attribute_group* ~ kw_trait ~ identifier
    ~ "{" ~ class_member* ~ "}"
}

class_member = _{
    use_trait
    | class_constant
    | property_declaration
    | method_declaration
    | empty_statement
}

// `use TraitName(, OtherTrait)*;` or
// `use TraitName(, OtherTrait)* { adaptations }` inside a class body.
// Adaptations resolve method conflicts:
//   `A::method insteadof B;` — when both A and B provide `method`,
//                              keep A's; the `insteadof` clause can
//                              list multiple trait names to skip.
//   `A::method as alias;`    — bind A's `method` under the new name
//                              `alias` on the using class.
//   `method as alias;`       — same, but the trait is implicit (only
//                              works when no conflict).
use_trait = {
    kw_use ~ qualified_name ~ ("," ~ qualified_name)*
    ~ (";" | "{" ~ trait_adaptation* ~ "}")
}

trait_adaptation = {
    trait_method_ref ~ kw_insteadof ~ qualified_name ~ ("," ~ qualified_name)* ~ ";"
    | trait_method_ref ~ kw_as ~ trait_visibility? ~ method_ident? ~ ";"
}

// `MyTrait::method` or just `method` (when unambiguous).
trait_method_ref = { qualified_name ~ "::" ~ method_ident | method_ident }
trait_visibility = { kw_public | kw_private | kw_protected }

class_constant = {
    // The type_annotation is gated by a `&(identifier ~ "=")` lookahead
    // so it doesn't greedily eat the identifier. PHP's
    // `const NAME = ...` (no type) and `const TYPE NAME = ...` (PHP 8.3
    // typed constants) both reach this rule — without the lookahead,
    // pest commits to type_annotation parsing the only identifier and
    // the rule fails.
    attribute_group* ~ member_modifier* ~ kw_const
        ~ (type_annotation ~ &(identifier ~ "="))?
        ~ identifier ~ "=" ~ expression ~ ";"
}

property_declaration = {
    attribute_group* ~ (asymmetric_set_modifier | member_modifier)* ~ type_annotation? ~ simple_variable ~ ("=" ~ expression)? ~ (property_hook_block | ";")
}

asymmetric_set_modifier = {
    kw_public ~ "(" ~ kw_set ~ ")"
    | kw_private ~ "(" ~ kw_set ~ ")"
    | kw_protected ~ "(" ~ kw_set ~ ")"
}

property_hook_block = { "{" ~ property_hook* ~ "}" }
property_hook = { property_get_hook | property_set_hook }
property_get_hook = { kw_get ~ block_statement }
property_set_hook = { kw_set ~ "(" ~ param_list? ~ ")" ~ block_statement }

method_declaration = {
    // PHP allows reserved words as method names (`list`, `match`, etc.).
    // Use `method_ident` instead of `identifier` so we don't reject
    // valid PHP class methods.
    attribute_group* ~ member_modifier* ~ kw_function ~ "&"? ~ method_ident
    ~ "(" ~ param_list? ~ ")"
    ~ return_type_annotation?
    ~ (block_statement | ";")  // ; for abstract / interface methods
}

// Identifier that allows reserved words — used for method names where
// PHP semantics don't conflict (no ambiguity vs control-flow keywords
// because the surrounding `function NAME (...)` shape pins it).
method_ident = @{ (ASCII_ALPHA | "_") ~ ident_cont* }

member_modifier = {
    kw_public | kw_private | kw_protected | kw_static | kw_abstract
    | kw_final | kw_readonly
}

// ── Enum (PHP 8.1+) ──────────────────────────────────────────────────────────

enum_declaration = {
    attribute_group* ~ kw_enum ~ identifier ~ (":" ~ identifier)?
    ~ (kw_implements ~ qualified_name ~ ("," ~ qualified_name)*)?
    ~ "{" ~ enum_member* ~ "}"
}

enum_member = _{
    enum_case
    | class_constant
    | method_declaration
    | use_trait
    | empty_statement
}

enum_case = {
    kw_case ~ identifier ~ ("=" ~ expression)? ~ ";"
}

// ── Control flow ─────────────────────────────────────────────────────────────

if_statement = {
    kw_if ~ "(" ~ expression ~ ")"
    ~ (if_alt_block | statement ~ elseif_clause* ~ else_clause?)
}

elseif_clause = { (kw_elseif | kw_else_if) ~ "(" ~ expression ~ ")" ~ statement }
else_clause   = { kw_else ~ statement }

if_alt_block = {
    ":" ~ statement*
    ~ elseif_alt_clause*
    ~ else_alt_clause?
    ~ kw_endif ~ stmt_terminator
}

elseif_alt_clause = {
    (kw_elseif | kw_else_if) ~ "(" ~ expression ~ ")" ~ ":" ~ statement*
}

else_alt_clause = { kw_else ~ ":" ~ statement* }

while_statement = {
    kw_while ~ "(" ~ expression ~ ")" ~ statement
}

do_while_statement = {
    kw_do ~ statement ~ kw_while ~ "(" ~ expression ~ ")" ~ ";"
}

for_statement = {
    kw_for ~ "("
    ~ for_init? ~ ";"
    ~ expression? ~ ";"
    ~ for_update?
    ~ ")"
    ~ statement
}

for_init   = { expression ~ ("," ~ expression)* }
for_update = { expression ~ ("," ~ expression)* }

foreach_statement = {
    kw_foreach ~ "("
    ~ expression ~ kw_as
    ~ foreach_target
    ~ ")"
    ~ (statement | foreach_alt_block)
}

foreach_alt_block = {
    ":" ~ statement* ~ kw_endforeach ~ stmt_terminator
}

// `as $value` or `as $key => $value`
foreach_target = {
    variable ~ "=>" ~ "&"? ~ (variable | list_expression | short_array_expression)
    | "&"? ~ (variable | list_expression | short_array_expression)
}

switch_statement = {
    kw_switch ~ "(" ~ expression ~ ")"
    ~ "{" ~ switch_case* ~ "}"
}

switch_case = {
    (kw_case ~ expression | kw_default) ~ ":" ~ statement*
}

return_statement = { kw_return ~ expression? ~ ";" }
goto_statement = { kw_goto ~ (identifier | "{" ~ expression ~ "}") ~ ";" }
label_statement = { identifier ~ ":" ~ !":" ~ statement? }
declare_statement = {
    kw_declare ~ "(" ~ identifier ~ "=" ~ expression ~ ")" ~ (statement | block_statement | ";")
}
break_statement  = { kw_break ~ expression? ~ ";" }
continue_statement = { kw_continue ~ expression? ~ ";" }
throw_statement = { kw_throw ~ expression ~ ";" }

try_statement = {
    kw_try ~ block_statement
    ~ catch_clause*
    ~ finally_clause?
}

catch_clause = {
    kw_catch ~ "(" ~ catch_type ~ variable? ~ ")" ~ block_statement
}

// `Foo` or `Foo|Bar|Baz`
catch_type = {
    qualified_name ~ ("|" ~ qualified_name)*
}

finally_clause = { kw_finally ~ block_statement }

echo_statement  = { kw_echo ~ expression ~ ("," ~ expression)* ~ stmt_terminator }
print_statement = { kw_print ~ expression ~ stmt_terminator }

expression_statement = { expression ~ stmt_terminator }

// ── Expression precedence (flat ~12 levels) ──────────────────────────────────
//
// PHP operator precedence (high to low). We collapse some adjacent
// levels into a single rule with named operator alternatives, per the
// skill MD's "keep it flat" advice.

expression = { assignment_expression }

assignment_expression = {
    yield_expression
    | logical_or_expression ~ (assign_op ~ assignment_expression)?
}

assign_op = {
    "=" | "+=" | "-=" | "*=" | "/=" | "%=" | ".=" | "**="
    | "<<=" | ">>=" | "&=" | "|=" | "^="
    | "&&=" | "||=" | "??="
}

yield_expression = {
    kw_yield_from ~ assignment_expression
    | kw_yield ~ (assignment_expression ~ ("=>" ~ assignment_expression)?)?
}

// `or` (lowest), `xor`, `and` — PHP word operators bind LOWER than `=`,
// but we put them just above ternary for simplicity. They're rarely
// used in mixed-precedence contexts.
logical_or_expression = {
    ternary_expression ~ (logical_word_op ~ ternary_expression)*
}

logical_word_op = { kw_or | kw_xor | kw_and }

ternary_expression = {
    null_coalesce_expression
    ~ ("?" ~ expression? ~ ":" ~ ternary_expression)?
}

null_coalesce_expression = {
    logic_or_expression ~ ("??" ~ null_coalesce_expression)?
}

logic_or_expression = {
    logic_and_expression ~ (logic_or_op ~ logic_and_expression)*
}

logic_or_op = { "||" }

logic_and_expression = {
    bit_or_expression ~ (logic_and_op ~ bit_or_expression)*
}

logic_and_op = { "&&" }

// Bitwise OR / XOR / AND collapsed to one level (like JS)
bit_or_expression = {
    equality_expression ~ (bitwise_op ~ equality_expression)*
}

bitwise_op = { "|" | "^" | bit_and_op }
// `&` would clash with reference-by-`&` in arg lists if used loose;
// pest disambiguates by context here.
bit_and_op = { "&" }

equality_expression = {
    comparison_expression ~ (eq_op ~ comparison_expression)*
}

eq_op = { "===" | "!==" | "==" | "!=" | "<>" }

comparison_expression = {
    shift_expression ~ (cmp_op ~ shift_expression)*
}

cmp_op = { "<=>" | "<=" | ">=" | "<" | ">" | kw_instanceof }

shift_expression = {
    additive_expression ~ (shift_op ~ additive_expression)*
}

shift_op = { "<<" | ">>" }

additive_expression = {
    multiplicative_expression ~ (additive_op ~ multiplicative_expression)*
}

additive_op = { "+" | "-" | "." }

multiplicative_expression = {
    unary_expression ~ (mul_op ~ unary_expression)*
}

mul_op = { "**" | "*" | "/" | "%" }

unary_expression = {
    unary_op ~ unary_expression
    | cast_expression
    | postfix_expression
}

unary_op = { "!" | "~" | "-" | "+" | "++" | "--" | "@" | "&" }

cast_expression = {
    "(" ~ cast_kw ~ ")" ~ unary_expression
}

postfix_expression = {
    primary_expression ~ postfix_op*
}

postfix_op = {
    method_call_op
    | property_access_op
    | static_access_op
    | array_index_op
    | call_op
    | inc_dec_op
}

// PHP 8.1 first-class callable syntax: `strlen(...)`, `$obj->method(...)`,
// `Foo::bar(...)`. The `(...)` is a literal three-dot ellipsis, not args.
first_class_callable_op = { "(" ~ "..." ~ ")" }

method_call_op    = { ("?->" | "->") ~ member_name ~ (first_class_callable_op | "(" ~ arg_list? ~ ")") }
property_access_op = { ("?->" | "->") ~ member_name }
static_access_op  = { "::" ~ class_member_name }
array_index_op    = { "[" ~ expression? ~ "]" }
call_op           = { first_class_callable_op | "(" ~ arg_list? ~ ")" }
inc_dec_op        = { "++" | "--" }

// `member_name` is what comes after `->` — usually an identifier, can also
// be a `$variable` (variable property access) or `{expr}` (dynamic).
// PHP also accepts reserved words as member names since the `->` arrow
// disambiguates from control-flow uses.
member_name = {
    method_ident
    | variable
    | "{" ~ expression ~ "}"
}

// `class_member_name` is what comes after `::` — `member_name` plus the
// PHP `class` keyword for `Foo::class` (PHP 5.5+). We also accept `kw_class`
// here so that `Foo::class` is parsed instead of treating `class` as the
// start of a declaration.
class_member_name = {
    kw_class
    | identifier
    | variable
    | "{" ~ expression ~ "}"
}

arg_list = { argument ~ ("," ~ argument)* ~ ","? }

argument = {
    // Named arg: `name: value`. Uses `arg_name` (not `identifier`) so
    // reserved words like `class`, `match`, `list` work as parameter
    // labels — PHP accepts them in named-arg position.
    arg_name ~ ":" ~ !":" ~ expression
    | "..." ~ expression
    | "&" ~ expression
    | expression
}

// Identifier permitted as a named-argument label. Allows reserved words
// (`class`, `match`, `list`, ...) — PHP's named-arg grammar treats the
// label position like a method-name slot, where reserved words are OK.
arg_name = @{ (ASCII_ALPHA | "_") ~ ident_cont* }

// ── Primary expressions ──────────────────────────────────────────────────────

primary_expression = {
    literal
    | variable
    | new_expression
    | clone_expression
    | throw_expression
    | match_expression
    | isset_expression
    | empty_expression
    | print_expression
    | include_expression
    | unset_expression
    | list_expression
    | array_expression
    | short_array_expression
    | closure_expression
    | arrow_function
    | parenthesized_expression
    | qualified_name
    | kw_self
    | kw_parent
    | kw_static
    | method_ident
}

// PHP 8.0: throw is now an expression as well as a statement.
// `$x ?? throw new Exception('oops')`, etc.
throw_expression = { kw_throw ~ expression }

literal = {
    number_lit
    | string_lit
    | kw_null
    | kw_true
    | kw_false
}

new_expression = {
    kw_new ~ (anonymous_class | kw_static | kw_self | kw_parent
              | qualified_name | variable | "(" ~ expression ~ ")")
        ~ ("(" ~ arg_list? ~ ")")?
}

// PHP 8 anonymous classes: `new class { ... }`, `new class("arg") { ... }`,
// `new class extends Base implements I { ... }`. The walker treats this
// as a synthetic class declaration + immediate `new` of that class.
anonymous_class = {
    kw_class
    ~ ("(" ~ arg_list? ~ ")")?
    ~ (kw_extends ~ qualified_name)?
    ~ (kw_implements ~ qualified_name ~ ("," ~ qualified_name)*)?
    ~ "{" ~ class_member* ~ "}"
}

clone_expression = {
    kw_clone ~ unary_expression
}

match_expression = {
    kw_match ~ "(" ~ expression ~ ")"
    ~ "{" ~ (match_arm ~ ("," ~ match_arm)* ~ ","?)? ~ "}"
}

match_arm = {
    (kw_default | match_conditions) ~ "=>" ~ expression
}

match_conditions = { expression ~ ("," ~ expression)* }

isset_expression = { kw_isset ~ "(" ~ expression ~ ("," ~ expression)* ~ ")" }
empty_expression = { kw_empty ~ "(" ~ expression ~ ")" }
print_expression = { kw_print ~ expression }
include_expression = {
    (kw_include_once | kw_require_once | kw_include | kw_require)
    ~ include_operand
}
include_operand = { "(" ~ expression ~ ")" | expression }
unset_expression = { kw_unset ~ "(" ~ expression ~ ("," ~ expression)* ~ ")" }

list_expression = {
    kw_list ~ "(" ~ list_element ~ ("," ~ list_element)* ~ ")"
}

list_element = { expression? }

// `array(1, 2, 'key' => $val, ...$rest)` — PHP keyword, case-insensitive
array_expression = {
    ^"array" ~ "(" ~ (array_element ~ ("," ~ array_element)* ~ ","?)? ~ ")"
}

// `[1, 2, 'key' => $val, ...$rest]`
short_array_expression = {
    "[" ~ (array_element ~ ("," ~ array_element)* ~ ","?)? ~ "]"
}

array_element = {
    "..." ~ expression
    | expression ~ "=>" ~ "&"? ~ expression
    | "&"? ~ expression
}

closure_expression = {
    kw_static? ~ kw_function ~ "&"? ~ "(" ~ param_list? ~ ")"
    ~ closure_use?
    ~ return_type_annotation?
    ~ block_statement
}

closure_use = {
    kw_use ~ "(" ~ closure_use_var ~ ("," ~ closure_use_var)* ~ ","? ~ ")"
}

closure_use_var = { "&"? ~ variable }

arrow_function = {
    kw_static? ~ kw_fn ~ "(" ~ param_list? ~ ")" ~ return_type_annotation?
    ~ "=>" ~ expression
}

parenthesized_expression = { "(" ~ expression ~ ")" }

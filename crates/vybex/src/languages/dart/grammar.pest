// Dart Grammar for pest parser
// Covers everything vybe_parser_dart supports
//
// Dart uses ";" terminators (no ASI), so NEWLINE is whitespace.
// String interpolation: $variable and ${expression} inside strings.
// Cascade operator: ..method(), ..field, ..field = val, ?..method()

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{ line_comment | block_comment }
line_comment = _{ "//" ~ (!"\n" ~ ANY)* }
block_comment = _{ "/*" ~ (!"*/" ~ ANY)* ~ "*/" }

// ── Program ─────────────────────────────────────────────────────────────────

program = { SOI ~ top_level_item* ~ EOI }

top_level_item = _{
    annotation* ~ (
        import_declaration
        | class_declaration
        | mixin_declaration
        | extension_declaration
        | enum_declaration
        | typedef_declaration
        | top_level_function_or_variable
        | statement
    )
}

// ── Annotations ─────────────────────────────────────────────────────────────

annotation = { "@" ~ ident_name ~ ("(" ~ argument_list? ~ ")")? }

// ── Import ──────────────────────────────────────────────────────────────────

import_declaration = {
    "import" ~ string_literal ~ import_clause* ~ ";"
}

import_clause = _{
    deferred_clause
    | as_clause
    | show_clause
    | hide_clause
}

deferred_clause = { deferred_kw ~ as_clause }
as_clause = { "as" ~ ident_name }
show_clause = { show_kw ~ ident_list }
hide_clause = { hide_kw ~ ident_list }

ident_list = { ident_name ~ ("," ~ ident_name)* }

// ── Typedef ─────────────────────────────────────────────────────────────────

typedef_declaration = {
    "typedef" ~ ident_name ~ type_params? ~ "=" ~ type_annotation ~ ";"
}

// ── Enum ────────────────────────────────────────────────────────────────────

enum_declaration = {
    "enum" ~ ident_name ~ "{" ~ enum_values ~ "}"
}

enum_values = { (ident_name ~ ("," ~ ident_name)* ~ ","?)? }

// ── Class ───────────────────────────────────────────────────────────────────

class_declaration = {
    abstract_kw? ~ "class" ~ ident_name ~ type_params?
    ~ extends_clause? ~ with_clause? ~ implements_clause?
    ~ class_body
}

mixin_declaration = {
    "mixin" ~ ident_name ~ type_params?
    ~ on_clause? ~ implements_clause?
    ~ class_body
}

extends_clause = { "extends" ~ type_annotation }
with_clause = { "with" ~ type_annotation_list }
implements_clause = { "implements" ~ type_annotation_list }
on_clause = { "on" ~ type_annotation_list }

type_annotation_list = { type_annotation ~ ("," ~ type_annotation)* }

class_body = { "{" ~ class_member* ~ "}" }

class_member = _{
    annotation* ~ (
        operator_declaration
        | getter_declaration
        | setter_declaration
        | method_declaration
        | constructor_declaration
        | field_declaration
    )
}

// ── Class member modifiers ──────────────────────────────────────────────────

member_modifiers = {
    static_kw? ~ abstract_kw? ~ override_kw? ~ const_kw? ~ factory_kw?
    ~ final_kw? ~ late_kw?
}

// ── Constructor ─────────────────────────────────────────────────────────────

constructor_declaration = {
    member_modifiers ~ const_kw? ~ factory_kw?
    ~ ident_name ~ ("." ~ ident_name)? ~ "(" ~ param_list? ~ ")"
    ~ initializer_list?
    ~ (function_body_block | ";" )
}

initializer_list = {
    ":" ~ initializer ~ ("," ~ initializer)*
}

initializer = {
    super_call_initializer
    | this_redirect_initializer
    | field_initializer
}

super_call_initializer = { "super" ~ ("." ~ ident_name)? ~ "(" ~ argument_list? ~ ")" }
this_redirect_initializer = { "this" ~ ("." ~ ident_name)? ~ "(" ~ argument_list? ~ ")" }
field_initializer = { ident_name ~ "=" ~ assignment_expression }

// ── Operator overloading ────────────────────────────────────────────────────

operator_declaration = {
    member_modifiers ~ (type_annotation ~ "operator" | "operator")
    ~ operator_symbol
    ~ "(" ~ param_list? ~ ")"
    ~ async_kw? ~ function_body
}

operator_symbol = {
    "[]=" | "[]"
    | "~/=" | "~/"
    | ">>>" | ">>" | "<<" | ">=" | "<=" | "==" | "!="
    | "+" | "-" | "*" | "/" | "%" | "~"
    | "<" | ">" | "&" | "|" | "^"
}

// ── Getter / Setter ─────────────────────────────────────────────────────────

get_keyword = @{ "get" ~ !(ASCII_ALPHANUMERIC | "_") }
set_keyword = @{ "set" ~ !(ASCII_ALPHANUMERIC | "_") }

// Getter/setter: return type is optional. To avoid `get` being consumed
// as a type_annotation, use ordered choice: try with return type first
// (requires TWO idents before get_keyword — the type + get), then without.
getter_declaration = {
    member_modifiers ~ (type_annotation ~ get_keyword | get_keyword)
    ~ ident_name ~ async_kw? ~ function_body
}

setter_declaration = {
    member_modifiers ~ (type_annotation ~ set_keyword | set_keyword)
    ~ ident_name ~ "(" ~ param_list? ~ ")"
    ~ async_kw? ~ function_body
}

// ── Method ──────────────────────────────────────────────────────────────────

method_declaration = {
    member_modifiers ~ (type_annotation ~ ident_name | ident_name) ~ type_params?
    ~ "(" ~ param_list? ~ ")"
    ~ async_kw? ~ generator_marker? ~ function_body
}

generator_marker = { "*" }

// ── Field ───────────────────────────────────────────────────────────────────

field_declaration = {
    member_modifiers ~ type_annotation?
    ~ ident_name ~ ("=" ~ assignment_expression)?
    ~ ("," ~ ident_name ~ ("=" ~ assignment_expression)?)*
    ~ ";"
}

// ── Extension ───────────────────────────────────────────────────────────────

extension_declaration = {
    "extension" ~ ident_name? ~ "on" ~ type_annotation
    ~ "{" ~ class_member* ~ "}"
}

// ── Top-level function or variable ──────────────────────────────────────────

top_level_function_or_variable = _{
    function_declaration
    | variable_declaration_statement
    | expression_statement
}

function_declaration = {
    type_annotation? ~ ident_name ~ type_params?
    ~ "(" ~ param_list? ~ ")"
    ~ async_kw? ~ generator_marker? ~ function_body
}

// ── Function body ───────────────────────────────────────────────────────────

function_body = {
    arrow_body
    | function_body_block
    | empty_body
}

arrow_body = { "=>" ~ expression ~ ";" }
function_body_block = { "{" ~ statement* ~ "}" }
empty_body = { ";" }

// ── Parameters ──────────────────────────────────────────────────────────────

param_list = { param_group ~ ("," ~ param_group)* ~ ","? }

param_group = {
    optional_positional_params
    | named_params
    | param
}

optional_positional_params = {
    "[" ~ param ~ ("," ~ param)* ~ ","? ~ "]"
}

named_params = {
    "{" ~ param ~ ("," ~ param)* ~ ","? ~ "}"
}

param = {
    required_kw? ~ covariant_kw? ~ final_kw?
    ~ (this_param | typed_or_untyped_param)
    ~ param_default?
}

// `this.field` shorthand — no type annotation, field name follows directly
this_param = { this_param_prefix ~ ident_name }

// Regular param: typed (two idents) or untyped (one ident).
// Try typed first — if type_annotation matches AND ident_name follows,
// it's typed. Otherwise fall back to bare ident.
typed_or_untyped_param = { type_annotation ~ ident_name | ident_name }

this_param_prefix = { "this" ~ "." }
param_default = { ("=" | ":") ~ assignment_expression }

// ── Statements ──────────────────────────────────────────────────────────────

statement = _{
    empty_statement
    | block_statement
    | variable_declaration_statement
    | if_statement
    | for_statement
    | while_statement
    | do_while_statement
    | switch_statement
    | return_statement
    | break_statement
    | continue_statement
    | throw_statement
    | rethrow_statement
    | try_statement
    | assert_statement
    | function_declaration
    | expression_statement
}

empty_statement = { ";" }

block_statement = { "{" ~ statement* ~ "}" }

// ── Variable declarations ───────────────────────────────────────────────────

variable_declaration_statement = {
    var_modifiers ~ type_or_var ~ var_declarator ~ ("," ~ var_declarator)* ~ ";"
}

var_modifiers = { late_kw? ~ (final_kw | const_kw)? }

type_or_var = {
    var_kw
    | type_annotation
}

var_kw = @{ "var" ~ !(ASCII_ALPHANUMERIC | "_") }

var_declarator = { ident_name ~ ("=" ~ assignment_expression)? }

// ── If ──────────────────────────────────────────────────────────────────────

if_statement = {
    "if" ~ "(" ~ expression ~ ")" ~ statement ~ else_clause?
}

else_clause = { "else" ~ statement }

// ── For ─────────────────────────────────────────────────────────────────────

for_statement = {
    "for" ~ "(" ~ for_header ~ ")" ~ statement
}

for_header = {
    for_in_header | for_c_header
}

for_in_header = {
    (final_kw | var_kw)? ~ (type_annotation ~ ident_name | ident_name) ~ "in" ~ expression
}

for_c_header = {
    for_c_init? ~ ";" ~ expression? ~ ";" ~ for_c_update?
}

for_c_init = {
    variable_declaration_no_semi | expression
}

variable_declaration_no_semi = {
    var_modifiers ~ type_or_var ~ var_declarator ~ ("," ~ var_declarator)*
}

for_c_update = { expression ~ ("," ~ expression)* }

// ── While / Do-while ────────────────────────────────────────────────────────

while_statement = { "while" ~ "(" ~ expression ~ ")" ~ statement }

do_while_statement = { "do" ~ statement ~ "while" ~ "(" ~ expression ~ ")" ~ ";" }

// ── Switch statement ────────────────────────────────────────────────────────

switch_statement = {
    "switch" ~ "(" ~ expression ~ ")" ~ "{" ~ switch_case* ~ "}"
}

switch_case = {
    ("case" ~ expression | "default") ~ ":" ~ statement*
}

// ── Jump statements ─────────────────────────────────────────────────────────

return_statement = { "return" ~ expression? ~ ";" }
break_statement = { "break" ~ ident_name? ~ ";" }
continue_statement = { "continue" ~ ident_name? ~ ";" }
throw_statement = { "throw" ~ expression ~ ";" }
rethrow_statement = { "rethrow" ~ ";" }

// ── Try / Catch / Finally ───────────────────────────────────────────────────

try_statement = {
    "try" ~ block_statement ~ catch_clause* ~ finally_clause?
}

catch_clause = {
    on_catch_clause | plain_catch_clause
}

on_catch_clause = {
    "on" ~ ident_name ~ ("catch" ~ "(" ~ ident_name ~ ("," ~ ident_name)? ~ ")")? ~ block_statement
}

plain_catch_clause = {
    "catch" ~ "(" ~ ident_name ~ ("," ~ ident_name)? ~ ")" ~ block_statement
}

finally_clause = { "finally" ~ block_statement }

// ── Assert ──────────────────────────────────────────────────────────────────

assert_statement = {
    "assert" ~ "(" ~ expression ~ ("," ~ expression)? ~ ","? ~ ")" ~ ";"
}

// ── Expression statement ────────────────────────────────────────────────────

expression_statement = { expression ~ ";" }

// ── Expressions ─────────────────────────────────────────────────────────────

expression = { assignment_expression ~ ("," ~ assignment_expression)* }

assignment_expression = {
    lambda_expression
    | conditional_expression ~ (assignment_op ~ assignment_expression)?
}

assignment_op = {
    ">>>=" | ">>=" | "<<=" |
    "~/=" | "??=" |
    "+=" | "-=" | "*=" | "/=" | "%=" |
    "&=" | "|=" | "^=" |
    "="
}

// ── Lambda (arrow functions) ────────────────────────────────────────────────

lambda_expression = {
    async_kw? ~ lambda_params ~ (arrow_op ~ assignment_expression | function_body_block)
}

lambda_params = {
    "(" ~ lambda_param_list? ~ ")"
    | ident_name
}

// Lambda params: try bare ident first (most common), then typed.
// Ordered choice ensures `x` matches as bare name, not as a type.
lambda_param_list = { lambda_param ~ ("," ~ lambda_param)* ~ ","? }
lambda_param = { typed_lambda_param | ident_name }
typed_lambda_param = { final_kw? ~ type_annotation ~ ident_name ~ param_default? }

arrow_op = { "=>" }

// ── Ternary ─────────────────────────────────────────────────────────────────

conditional_expression = {
    null_coalesce_expression ~ ("?" ~ expression ~ ":" ~ expression)?
}

// ── Null coalesce ───────────────────────────────────────────────────────────

null_coalesce_expression = { logical_or_expression ~ ("??" ~ logical_or_expression)* }

// ── Logical OR ──────────────────────────────────────────────────────────────

logical_or_expression = { logical_and_expression ~ ("||" ~ logical_and_expression)* }

// ── Logical AND ─────────────────────────────────────────────────────────────

logical_and_expression = { bitwise_or_expression ~ ("&&" ~ bitwise_or_expression)* }

// ── Bitwise OR ──────────────────────────────────────────────────────────────

bitwise_or_expression = { bitwise_xor_expression ~ (bitor_op ~ bitwise_xor_expression)* }
bitor_op = { "|" ~ !("|" | "=") }

// ── Bitwise XOR ─────────────────────────────────────────────────────────────

bitwise_xor_expression = { bitwise_and_expression ~ (bitxor_op ~ bitwise_and_expression)* }
bitxor_op = { "^" ~ !"=" }

// ── Bitwise AND ─────────────────────────────────────────────────────────────

bitwise_and_expression = { equality_expression ~ (bitand_op ~ equality_expression)* }
bitand_op = { "&" ~ !("&" | "=") }

// ── Equality ────────────────────────────────────────────────────────────────

equality_expression = { relational_expression ~ (equality_op ~ relational_expression)* }
equality_op = { "==" | "!=" }

// ── Relational ──────────────────────────────────────────────────────────────

relational_expression = { shift_expression ~ (relational_suffix)* }

relational_suffix = {
    is_not_test
    | is_test
    | as_cast
    | relational_op ~ shift_expression
}

is_not_test = { "is" ~ "!" ~ type_annotation }
is_test = { is_kw ~ type_annotation }
as_cast = { as_kw ~ type_annotation }

relational_op = { "<=" | ">=" | "<" ~ !"<" | ">" ~ !">" }

// ── Shift ───────────────────────────────────────────────────────────────────

shift_expression = { additive_expression ~ (shift_op ~ additive_expression)* }
shift_op = { ">>>" ~ !"=" | ">>" ~ !(">" | "=") | "<<" ~ !"=" }

// ── Additive ────────────────────────────────────────────────────────────────

additive_expression = { multiplicative_expression ~ (additive_op ~ multiplicative_expression)* }
additive_op = { "+" ~ !("+" | "=") | "-" ~ !("-" | "=") }

// ── Multiplicative ──────────────────────────────────────────────────────────

multiplicative_expression = { unary_expression ~ (multiplicative_op ~ unary_expression)* }
multiplicative_op = {
    "~/" ~ !"="
    | "*" ~ !"="
    | "/" ~ !("/" | "=")
    | "%" ~ !"="
}

// ── Unary ───────────────────────────────────────────────────────────────────

unary_expression = {
    unary_op ~ unary_expression
    | postfix_expression
}

unary_op = {
    "-" ~ !("-" | "=")
    | "!" ~ !"="
    | "~" ~ !"/"
    | "++"
    | "--"
    | await_kw
}

// ── Postfix ─────────────────────────────────────────────────────────────────

postfix_expression = { call_expression ~ postfix_op? }
postfix_op = { "++" | "--" }

// ── Call / Member / Index / Cascade chain ───────────────────────────────────

call_expression = {
    (new_expression | const_expression | primary) ~ call_chain*
}

new_expression = { "new" ~ ident_name ~ ("." ~ ident_name)? ~ type_args? ~ "(" ~ argument_list? ~ ")" }

const_expression = { const_kw ~ ident_name ~ ("." ~ ident_name)? ~ type_args? ~ "(" ~ argument_list? ~ ")" }

call_chain = {
    cascade_chain
    | null_safe_member_access
    | member_access
    | call_args
    | index_access
    | null_assert
}

cascade_chain = {
    cascade_op ~ cascade_section ~ (cascade_continuation)*
}

cascade_op = { "?.." | ".." }

cascade_section = {
    ident_name ~ (
        "(" ~ argument_list? ~ ")"      // method call
        | "=" ~ expression               // field assignment
    )?
    | "[" ~ expression ~ "]" ~ ("=" ~ expression)?  // index cascade
}

cascade_continuation = {
    ".." ~ cascade_section
}

null_safe_member_access = { "?." ~ ident_or_keyword ~ ("(" ~ argument_list? ~ ")")? }
member_access = { "." ~ ident_or_keyword ~ ("(" ~ argument_list? ~ ")")? }
call_args = { "(" ~ argument_list? ~ ")" }
index_access = { "[" ~ expression ~ "]" }
null_assert = { "!" }

// ── Arguments ───────────────────────────────────────────────────────────────

argument_list = { argument ~ ("," ~ argument)* ~ ","? }

argument = {
    named_argument
    | spread_argument
    | assignment_expression
}

named_argument = { ident_name ~ ":" ~ assignment_expression }
spread_argument = { "..." ~ assignment_expression }

// ── Primary expressions ─────────────────────────────────────────────────────

primary = {
    switch_expression
    | record_or_paren
    | list_literal
    | map_or_set_literal
    | this_kw
    | super_kw
    | true_kw
    | false_kw
    | null_kw
    | numeric_literal
    | string_literal
    | ident_name
}

// ── Switch expression (Dart 3) ──────────────────────────────────────────────

switch_expression = {
    "switch" ~ "(" ~ expression ~ ")" ~ "{" ~ switch_expr_case ~ ("," ~ switch_expr_case)* ~ ","? ~ "}"
}

switch_expr_case = {
    pattern ~ when_guard? ~ "=>" ~ assignment_expression
}

when_guard = { when_kw ~ expression }

// ── Patterns (Dart 3) ───────────────────────────────────────────────────────

pattern = { primary_pattern ~ (pattern_logical_op ~ primary_pattern)* }

pattern_logical_op = { "||" | "&&" }

primary_pattern = {
    wildcard_pattern
    | relational_pattern
    | list_pattern
    | map_pattern
    | record_pattern
    | object_pattern
    | null_pattern
    | bool_pattern
    | constant_pattern
}

wildcard_pattern = { "_" ~ !(ASCII_ALPHANUMERIC | "_") }

relational_pattern = {
    ("<=" | ">=" | "<" | ">" | "==" | "!=") ~ assignment_expression
}

list_pattern = { "[" ~ (pattern ~ ("," ~ pattern)*)? ~ ","? ~ "]" }

map_pattern = { "{" ~ (map_pattern_entry ~ ("," ~ map_pattern_entry)*)? ~ ","? ~ "}" }
map_pattern_entry = { assignment_expression ~ ":" ~ pattern }

record_pattern = { "(" ~ (record_pattern_field ~ ("," ~ record_pattern_field)*)? ~ ","? ~ ")" }
record_pattern_field = { (ident_name ~ ":")? ~ pattern }

object_pattern = { ident_name ~ "(" ~ (object_pattern_field ~ ("," ~ object_pattern_field)*)? ~ ","? ~ ")" }
object_pattern_field = { ident_name ~ ":" ~ pattern }

null_pattern = { null_kw }
bool_pattern = { true_kw | false_kw }

constant_pattern = {
    numeric_literal
    | string_literal
    | ident_name ~ (ident_name)?   // type + variable binding, or plain identifier constant
}

// ── Record / parenthesized expression ───────────────────────────────────────

record_or_paren = {
    "(" ~ record_or_paren_inner? ~ ")"
}

record_or_paren_inner = {
    record_field ~ ("," ~ record_field)* ~ ","?
}

record_field = {
    ident_name ~ ":" ~ assignment_expression
    | assignment_expression
}

// ── List literal ────────────────────────────────────────────────────────────

list_literal = {
    type_args? ~ "[" ~ (list_element ~ ("," ~ list_element)*)? ~ ","? ~ "]"
}

list_element = {
    "..." ~ assignment_expression
    | assignment_expression
}

// ── Map / Set literal ───────────────────────────────────────────────────────

map_or_set_literal = {
    type_args? ~ "{" ~ map_or_set_body? ~ "}"
}

map_or_set_body = {
    map_entry ~ ("," ~ map_entry)* ~ ","?
    | assignment_expression ~ ("," ~ assignment_expression)* ~ ","?
}

map_entry = { assignment_expression ~ ":" ~ assignment_expression }

// ── Type annotations ────────────────────────────────────────────────────────

type_annotation = {
    function_type
    | simple_type
}

simple_type = {
    type_name ~ type_args? ~ nullable_marker?
}

type_name = {
    void_kw | dynamic_kw | ident_name
}

function_type = {
    simple_type ~ "Function" ~ "(" ~ function_type_params? ~ ")"
    ~ nullable_marker?
}

function_type_params = { simple_type ~ ("," ~ simple_type)* }

type_args = { "<" ~ type_annotation ~ ("," ~ type_annotation)* ~ ">" }
type_params = { "<" ~ type_param ~ ("," ~ type_param)* ~ ">" }
type_param = { ident_name ~ ("extends" ~ type_annotation)? }

nullable_marker = { "?" }

// ── Literals ────────────────────────────────────────────────────────────────

numeric_literal = @{
    ("0x" | "0X") ~ (ASCII_HEX_DIGIT | "_")+ ~ !(ASCII_ALPHANUMERIC | "_")
    | ("0b" | "0B") ~ ("0" | "1" | "_")+ ~ !(ASCII_ALPHANUMERIC | "_")
    | ASCII_DIGIT ~ (ASCII_DIGIT | "_")* ~ "." ~ (ASCII_DIGIT | "_")* ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)? ~ !(ASCII_ALPHANUMERIC | "_")
    | "." ~ ASCII_DIGIT ~ (ASCII_DIGIT | "_")* ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)? ~ !(ASCII_ALPHANUMERIC | "_")
    | ASCII_DIGIT ~ (ASCII_DIGIT | "_")* ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)? ~ !(ASCII_ALPHANUMERIC | "_")
}

// ── String literals ─────────────────────────────────────────────────────────
// Dart supports: 'str', "str", r'raw', r"raw", '''multi''', """multi"""
// Plus interpolation: $ident and ${expr} in non-raw strings

string_literal = {
    raw_string
    | triple_double_string
    | triple_single_string
    | interpolated_double_string
    | interpolated_single_string
}

raw_string = @{
    "r'" ~ (!"'" ~ ANY)* ~ "'"
    | "r\"" ~ (!"\"" ~ ANY)* ~ "\""
}

triple_double_string = {
    triple_double_head ~ (triple_double_interp | triple_double_chars)* ~ triple_double_tail
}
triple_double_head = @{ "\"\"\"" }
triple_double_interp = { interp_complex | interp_simple }
triple_double_chars = @{ (!("\"\"\"" | "$") ~ ANY)+ }
triple_double_tail = @{ "\"\"\"" }

triple_single_string = {
    triple_single_head ~ (triple_single_interp | triple_single_chars)* ~ triple_single_tail
}
triple_single_head = @{ "'''" }
triple_single_interp = { interp_complex | interp_simple }
triple_single_chars = @{ (!("'''" | "$") ~ ANY)+ }
triple_single_tail = @{ "'''" }

interpolated_double_string = {
    dq_open ~ (dq_interp | dq_chars)* ~ dq_close
}
dq_open = @{ "\"" }
dq_interp = { interp_complex | interp_simple }
dq_chars = @{ ("\\\"" | "\\\\" | "\\$" | (!("\"" | "$" | "\n") ~ ANY))+ }
dq_close = @{ "\"" }

interpolated_single_string = {
    sq_open ~ (sq_interp | sq_chars)* ~ sq_close
}
sq_open = @{ "'" }
sq_interp = { interp_complex | interp_simple }
sq_chars = @{ ("\\'" | "\\\\" | "\\$" | (!("'" | "$" | "\n") ~ ANY))+ }
sq_close = @{ "'" }

// ── String interpolation ────────────────────────────────────────────────────

interp_complex = { "${" ~ expression ~ "}" }
interp_simple = { "$" ~ ident_name }

// ── Identifiers ─────────────────────────────────────────────────────────────

ident_name = @{
    !strict_keyword ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")*
}

// ident_or_keyword: any word — used after "." for member access.
// Also allows `$1`, `$2` etc. for Dart record positional field access.
ident_or_keyword = @{
    "$" ~ ASCII_DIGIT+
    | (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")*
}

// ── Keywords ────────────────────────────────────────────────────────────────
// Atomic rules with word-boundary checks for disambiguation

abstract_kw  = @{ "abstract"  ~ !(ASCII_ALPHANUMERIC | "_") }
as_kw        = @{ "as"        ~ !(ASCII_ALPHANUMERIC | "_") }
assert_kw    = @{ "assert"    ~ !(ASCII_ALPHANUMERIC | "_") }
async_kw     = @{ "async"     ~ !(ASCII_ALPHANUMERIC | "_") }
await_kw     = @{ "await"     ~ !(ASCII_ALPHANUMERIC | "_") }
break_kw     = @{ "break"     ~ !(ASCII_ALPHANUMERIC | "_") }
case_kw      = @{ "case"      ~ !(ASCII_ALPHANUMERIC | "_") }
catch_kw     = @{ "catch"     ~ !(ASCII_ALPHANUMERIC | "_") }
class_kw     = @{ "class"     ~ !(ASCII_ALPHANUMERIC | "_") }
const_kw     = @{ "const"     ~ !(ASCII_ALPHANUMERIC | "_") }
continue_kw  = @{ "continue"  ~ !(ASCII_ALPHANUMERIC | "_") }
covariant_kw = @{ "covariant" ~ !(ASCII_ALPHANUMERIC | "_") }
default_kw   = @{ "default"   ~ !(ASCII_ALPHANUMERIC | "_") }
deferred_kw  = @{ "deferred"  ~ !(ASCII_ALPHANUMERIC | "_") }
do_kw        = @{ "do"        ~ !(ASCII_ALPHANUMERIC | "_") }
dynamic_kw   = @{ "dynamic"   ~ !(ASCII_ALPHANUMERIC | "_") }
else_kw      = @{ "else"      ~ !(ASCII_ALPHANUMERIC | "_") }
enum_kw      = @{ "enum"      ~ !(ASCII_ALPHANUMERIC | "_") }
export_kw    = @{ "export"    ~ !(ASCII_ALPHANUMERIC | "_") }
extends_kw   = @{ "extends"   ~ !(ASCII_ALPHANUMERIC | "_") }
extension_kw = @{ "extension" ~ !(ASCII_ALPHANUMERIC | "_") }
external_kw  = @{ "external"  ~ !(ASCII_ALPHANUMERIC | "_") }
factory_kw   = @{ "factory"   ~ !(ASCII_ALPHANUMERIC | "_") }
false_kw     = @{ "false"     ~ !(ASCII_ALPHANUMERIC | "_") }
final_kw     = @{ "final"     ~ !(ASCII_ALPHANUMERIC | "_") }
finally_kw   = @{ "finally"   ~ !(ASCII_ALPHANUMERIC | "_") }
for_kw       = @{ "for"       ~ !(ASCII_ALPHANUMERIC | "_") }
function_kw  = @{ "Function"  ~ !(ASCII_ALPHANUMERIC | "_") }
hide_kw      = @{ "hide"      ~ !(ASCII_ALPHANUMERIC | "_") }
if_kw        = @{ "if"        ~ !(ASCII_ALPHANUMERIC | "_") }
implements_kw = @{ "implements" ~ !(ASCII_ALPHANUMERIC | "_") }
import_kw    = @{ "import"    ~ !(ASCII_ALPHANUMERIC | "_") }
in_kw        = @{ "in"        ~ !(ASCII_ALPHANUMERIC | "_") }
interface_kw = @{ "interface" ~ !(ASCII_ALPHANUMERIC | "_") }
is_kw        = @{ "is"        ~ !(ASCII_ALPHANUMERIC | "_") }
late_kw      = @{ "late"      ~ !(ASCII_ALPHANUMERIC | "_") }
library_kw   = @{ "library"   ~ !(ASCII_ALPHANUMERIC | "_") }
mixin_kw     = @{ "mixin"     ~ !(ASCII_ALPHANUMERIC | "_") }
native_kw    = @{ "native"    ~ !(ASCII_ALPHANUMERIC | "_") }
new_kw       = @{ "new"       ~ !(ASCII_ALPHANUMERIC | "_") }
null_kw      = @{ "null"      ~ !(ASCII_ALPHANUMERIC | "_") }
on_kw        = @{ "on"        ~ !(ASCII_ALPHANUMERIC | "_") }
operator_kw  = @{ "operator"  ~ !(ASCII_ALPHANUMERIC | "_") }
override_kw  = @{ "override"  ~ !(ASCII_ALPHANUMERIC | "_") }
part_kw      = @{ "part"      ~ !(ASCII_ALPHANUMERIC | "_") }
required_kw  = @{ "required"  ~ !(ASCII_ALPHANUMERIC | "_") }
rethrow_kw   = @{ "rethrow"   ~ !(ASCII_ALPHANUMERIC | "_") }
return_kw    = @{ "return"    ~ !(ASCII_ALPHANUMERIC | "_") }
show_kw      = @{ "show"      ~ !(ASCII_ALPHANUMERIC | "_") }
static_kw    = @{ "static"    ~ !(ASCII_ALPHANUMERIC | "_") }
super_kw     = @{ "super"     ~ !(ASCII_ALPHANUMERIC | "_") }
switch_kw    = @{ "switch"    ~ !(ASCII_ALPHANUMERIC | "_") }
sync_kw      = @{ "sync"      ~ !(ASCII_ALPHANUMERIC | "_") }
this_kw      = @{ "this"      ~ !(ASCII_ALPHANUMERIC | "_") }
throw_kw     = @{ "throw"     ~ !(ASCII_ALPHANUMERIC | "_") }
true_kw      = @{ "true"      ~ !(ASCII_ALPHANUMERIC | "_") }
try_kw       = @{ "try"       ~ !(ASCII_ALPHANUMERIC | "_") }
typedef_kw   = @{ "typedef"   ~ !(ASCII_ALPHANUMERIC | "_") }
var_keyword  = @{ "var"       ~ !(ASCII_ALPHANUMERIC | "_") }
void_kw      = @{ "void"      ~ !(ASCII_ALPHANUMERIC | "_") }
when_kw      = @{ "when"      ~ !(ASCII_ALPHANUMERIC | "_") }
while_kw     = @{ "while"     ~ !(ASCII_ALPHANUMERIC | "_") }
with_kw      = @{ "with"      ~ !(ASCII_ALPHANUMERIC | "_") }
yield_kw     = @{ "yield"     ~ !(ASCII_ALPHANUMERIC | "_") }

// Only truly reserved words that can NEVER be identifiers.
// Contextual keywords (get, set, show, hide, on, as, when, deferred,
// async, await, yield, late, required, covariant, abstract, override,
// factory, mixin, extension, dynamic, operator, typedef, library, part,
// export, native, external, sync) are NOT here — they can appear as identifiers.
strict_keyword = _{
    ("var" | "final" | "const" | "void" | "return" | "if" | "else" |
     "for" | "while" | "do" | "break" | "continue" | "switch" | "case" |
     "default" | "new" | "class" | "extends" | "implements" | "with" |
     "enum" | "import" | "throw" | "rethrow" | "try" | "catch" | "finally" |
     "true" | "false" | "null" | "this" | "super" | "in" | "is" |
     "assert")
    ~ !(ASCII_ALPHANUMERIC | "_")
}

"odd?"          = { emit = "host:vybe:math:isOdd",          min_args = 0, max_args = 0 }
"zero?"         = { emit = "host:vybe:math:isZero",         min_args = 0, max_args = 0 }
"positive?"     = { emit = "host:vybe:math:isPositive",     min_args = 0, max_args = 0 }
"negative?"     = { emit = "host:vybe:math:isNegative",     min_args = 0, max_args = 0 }

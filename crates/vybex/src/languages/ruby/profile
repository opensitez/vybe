merge           = { emit = "host:vybe:object:assign",       min_args = 1, max_args = 255 }
delete          = { emit = "host:vybe:object:delete",       min_args = 1, max_args = 1 }
fetch           = { emit = "common:dict.get_dynamic",       min_args = 1, max_args = 2 }
"transform_values" = { emit = "host:vybe:object:mapValues", min_args = 0, max_args = 0 }
"transform_keys"   = { emit = "host:vybe:object:mapKeys",  min_args = 0, max_args = 0 }

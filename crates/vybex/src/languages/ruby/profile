"empty?"        = { emit = "host:vybe:array:isEmpty",       min_args = 0, max_args = 0 }
concat          = { emit = "opcode:array_concat",           min_args = 1, max_args = 255 }
fill            = { emit = "opcode:array_fill",             min_args = 1, max_args = 3 }

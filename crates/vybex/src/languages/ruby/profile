"include?"      = { emit = "opcode:str_includes",           min_args = 1, max_args = 1 }
"start_with?"   = { emit = "opcode:str_starts_with",        min_args = 1, max_args = 1 }
"end_with?"     = { emit = "opcode:str_ends_with",          min_args = 1, max_args = 1 }
capitalize      = { emit = "host:vybe:string:capitalize",   min_args = 0, max_args = 0 }
reverse         = { emit = "opcode:str_reverse",            min_args = 0, max_args = 0 }
chars           = { emit = "host:vybe:string:chars",        min_args = 0, max_args = 0 }
bytes           = { emit = "host:vybe:convert:toBytes",     min_args = 0, max_args = 0 }
center          = { emit = "host:vybe:string:center",       min_args = 1, max_args = 2 }
ljust           = { emit = "opcode:str_pad_end",            min_args = 1, max_args = 2 }
rjust           = { emit = "opcode:str_pad_start",          min_args = 1, max_args = 2 }
to_s            = { emit = "stdlib:tostring",               min_args = 0, max_args = 0 }
to_str          = { emit = "stdlib:tostring",               min_args = 0, max_args = 0 }
to_i            = { emit = "host:vybe:convert:cint",        min_args = 0, max_args = 0 }
to_f            = { emit = "host:vybe:convert:cdbl",        min_args = 0, max_args = 0 }
to_a            = { emit = "host:vybe:array:from",          min_args = 0, max_args = 0 }
to_sym          = { emit = "stdlib:tostring",               min_args = 0, max_args = 0 }
inspect         = { emit = "stdlib:tostring",               min_args = 0, max_args = 0 }
freeze          = { emit = "noop_receiver",                 min_args = 0, max_args = 0 }
"frozen?"       = { emit = "noop_receiver",                 min_args = 0, max_args = 0 }
dup             = { emit = "host:vybe:array:copy",          min_args = 0, max_args = 0 }
clone           = { emit = "host:vybe:array:copy",          min_args = 0, max_args = 0 }
"nil?"          = { emit = "opcode:ref_is_null",            min_args = 0, max_args = 0 }
"is_a?"         = { emit = "host:vybe:convert:instanceof",  min_args = 1, max_args = 1 }
class           = { emit = "opcode:ref_typeof",             min_args = 0, max_args = 0 }
"respond_to?"   = { emit = "host:vybe:object:hasOwn",       min_args = 1, max_args = 1 }
send            = { emit = "host:vybe:object:send",         min_args = 1, max_args = 255 }
tap             = { emit = "noop_receiver",                 min_args = 0, max_args = 0 }
"eql?"          = { emit = "opcode:dyn_eq",                 min_args = 1, max_args = 1 }
"equal?"        = { emit = "opcode:dyn_eq",                 min_args = 1, max_args = 1 }
hash            = { emit = "host:vybe:convert:hash",        min_args = 0, max_args = 0 }
object_id       = { emit = "host:vybe:convert:id",          min_args = 0, max_args = 0 }
encoding        = { emit = "host:vybe:string:encoding",     min_args = 0, max_args = 0 }
"valid_encoding?" = { emit = "noop_receiver",               min_args = 0, max_args = 0 }
encode          = { emit = "stdlib:tostring",               min_args = 0, max_args = 1 }
tr              = { emit = "host:vybe:string:tr",           min_args = 2, max_args = 2 }
scan            = { emit = "host:vybe:string:findall",      min_args = 1, max_args = 1 }
"match"         = { emit = "host:vybe:string:search",       min_args = 1, max_args = 1 }
"match?"        = { emit = "host:vybe:string:search",       min_args = 1, max_args = 1 }
chr             = { emit = "opcode:str_from_char_code",     min_args = 0, max_args = 0 }
ord             = { emit = "intrinsic:asc",                 min_args = 0, max_args = 0 }
hex             = { emit = "host:vybe:convert:toHex",       min_args = 0, max_args = 0 }
casecmp         = { emit = "opcode:str_compare",            min_args = 1, max_args = 1 }

# ── Array instance methods (common:collections.* / opcode:array_*) ───────────

push            = { emit = "common:collections.push",       min_args = 1, max_args = 255 }
append          = { emit = "common:collections.push",       min_args = 1, max_args = 255 }
pop             = { emit = "common:collections.pop",        min_args = 0, max_args = 1 }
shift           = { emit = "opcode:array_shift",            min_args = 0, max_args = 0 }
unshift         = { emit = "intrinsic:array_unshift",       min_args = 1, max_args = 255 }
prepend         = { emit = "intrinsic:array_unshift",       min_args = 1, max_args = 255 }
# first/last normalized to Index(expr, 0/-1) in walker — pure bytecode
flatten         = { emit = "host:vybe:array:flatten",       min_args = 0, max_args = 1 }
compact         = { emit = "host:vybe:array:compact",       min_args = 0, max_args = 0 }

zip             = { emit = "host:vybe:array:zip",           min_args = 1, max_args = 255 }
dig             = { emit = "host:vybe:object:dig",          min_args = 1, max_args = 255 }
lazy            = { emit = "noop_receiver",                 min_args = 0, max_args = 0 }
slice           = { emit = "common:collections.slice",      min_args = 1, max_args = 2 }


abs             = { emit = "opcode:f64_abs",                min_args = 0, max_args = 0 }
round           = { emit = "opcode:f64_nearest",            min_args = 0, max_args = 1 }
floor           = { emit = "opcode:f64_floor",              min_args = 0, max_args = 0 }
ceil            = { emit = "opcode:f64_ceil",               min_args = 0, max_args = 0 }

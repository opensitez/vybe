# Ruby Compiler Profile
# ─────────────────────
# Port of vybe_compiler_ruby — maximizes compiler_common, stdlib, intrinsics,
# and opcodes. host: calls are ONLY used when no common/stdlib/opcode exists.

[info]
name = "ruby"
extensions = ["rb"]

[compiler]
function_return = "explicit"
self_keyword = "self"
constructor_name = "initialize"
separated_methods = true
implicit_self_fields = true
explicit_self_param = false
enum_as_ordinals = false
case_sensitive = true
string_indexing = "zero_based"
base_keyword = "super"
dynamic_add = true

# ────────────────────────────────────────────────────────────────────────────
# BUILTINS — bare global function calls
# ────────────────────────────────────────────────────────────────────────────

[builtins]

# ── I/O ──────────────────────────────────────────────────────────────────────

puts            = { emit = "print",                         min_args = 0, max_args = 255 }
print           = { emit = "print_no_newline",              min_args = 0, max_args = 255 }
p               = { emit = "print",                         min_args = 0, max_args = 255 }
pp              = { emit = "print",                         min_args = 0, max_args = 255 }
gets            = { emit = "host:wasi:cli:readLine",        min_args = 0, max_args = 0 }
warn            = { emit = "print",                         min_args = 1, max_args = 255 }

# ── Type conversion ──────────────────────────────────────────────────────────

"Integer"       = { emit = "host:vybe:convert:cint",        min_args = 1, max_args = 2 }
"Float"         = { emit = "host:vybe:convert:cdbl",        min_args = 1, max_args = 1 }
"String"        = { emit = "stdlib:tostring",                min_args = 1, max_args = 1 }
"Array"         = { emit = "host:vybe:array:from",           min_args = 1, max_args = 1 }

# ── Math (WASM opcodes) ─────────────────────────────────────────────────────

abs             = { emit = "opcode:f64_abs",                min_args = 1, max_args = 1 }
rand            = { emit = "host:wasi:random:random",       min_args = 0, max_args = 1 }
srand           = { emit = "noop",                          min_args = 0, max_args = 1 }
"Math.sqrt"     = { emit = "opcode:f64_sqrt",               min_args = 1, max_args = 1 }
"Math.sin"      = { emit = "host:vybe:math:sin",            min_args = 1, max_args = 1 }
"Math.cos"      = { emit = "host:vybe:math:cos",            min_args = 1, max_args = 1 }
"Math.tan"      = { emit = "host:vybe:math:tan",            min_args = 1, max_args = 1 }
"Math.log"      = { emit = "host:vybe:math:log",            min_args = 1, max_args = 2 }
"Math.log2"     = { emit = "host:vybe:math:log2",           min_args = 1, max_args = 1 }
"Math.log10"    = { emit = "host:vybe:math:log10",          min_args = 1, max_args = 1 }
"Math.exp"      = { emit = "host:vybe:math:exp",            min_args = 1, max_args = 1 }
"Math.floor"    = { emit = "opcode:f64_floor",              min_args = 1, max_args = 1 }
"Math.ceil"     = { emit = "opcode:f64_ceil",               min_args = 1, max_args = 1 }

# ── Misc ─────────────────────────────────────────────────────────────────────

sleep           = { emit = "host:vybe:runtime:sleep",        min_args = 1, max_args = 1 }
exit            = { emit = "host:wasi:cli:exit",             min_args = 0, max_args = 1 }
system          = { emit = "host:vybe:types:processStart",   min_args = 1, max_args = 1 }
raise           = { emit = "throw",                          min_args = 0, max_args = 1 }
sprintf         = { emit = "host:vybe:string:format",        min_args = 1, max_args = 255 }
format          = { emit = "host:vybe:string:format",        min_args = 1, max_args = 255 }
open            = { emit = "host:wasi:filesystem:open",      min_args = 1, max_args = 3 }
require         = { emit = "noop",                           min_args = 1, max_args = 1 }
require_relative = { emit = "noop",                          min_args = 1, max_args = 1 }
caller          = { emit = "host:vybe:runtime:caller",       min_args = 0, max_args = 1 }

# ────────────────────────────────────────────────────────────────────────────
# VALUE METHODS — instance .method() calls
# ────────────────────────────────────────────────────────────────────────────

[value_methods]

# ── String instance methods (common:strings.* / opcode:str_*) ────────────────

length          = { emit = "str_length",                    min_args = 0, max_args = 0 }
size            = { emit = "str_length",                    min_args = 0, max_args = 0 }
upcase          = { emit = "common:strings.to_upper",       min_args = 0, max_args = 0 }
downcase        = { emit = "common:strings.to_lower",       min_args = 0, max_args = 0 }
strip           = { emit = "common:strings.trim",           min_args = 0, max_args = 0 }
lstrip          = { emit = "opcode:str_trim_start",         min_args = 0, max_args = 0 }
rstrip          = { emit = "opcode:str_trim_end",           min_args = 0, max_args = 0 }
chomp           = { emit = "common:strings.trim",           min_args = 0, max_args = 1 }
chop            = { emit = "host:vybe:string:chop",         min_args = 0, max_args = 0 }
split           = { emit = "common:strings.split",          min_args = 0, max_args = 2 }
join            = { emit = "common:collections.join",       min_args = 0, max_args = 1 }
replace         = { emit = "common:strings.replace",        min_args = 1, max_args = 1 }
gsub            = { emit = "common:strings.replace",        min_args = 2, max_args = 2 }

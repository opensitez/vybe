# ── File operations ──────────────────────────────────────────────────────────

"File.read"     = { emit = "host:wasi:filesystem:readFile",  min_args = 1, max_args = 1 }
"File.write"    = { emit = "host:wasi:filesystem:writeFile", min_args = 2, max_args = 2 }
"File.exist?"   = { emit = "host:wasi:filesystem:exists",    min_args = 1, max_args = 1 }
"File.exists?"  = { emit = "host:wasi:filesystem:exists",    min_args = 1, max_args = 1 }
"File.delete"   = { emit = "host:wasi:filesystem:remove",    min_args = 1, max_args = 1 }
"File.readlines"= { emit = "host:wasi:filesystem:readLines", min_args = 1, max_args = 1 }
"File.directory?"= { emit = "host:wasi:filesystem:isDirectory", min_args = 1, max_args = 1 }

# ────────────────────────────────────────────────────────────────────────────
# NAMESPACE CONSTANTS
# ────────────────────────────────────────────────────────────────────────────

[namespace_constants]
"Math::PI"      = 3.141592653589793
"Math::E"       = 2.718281828459045
"INFINITY"      = "Infinity"
"NAN"           = "NaN"
"true"          = true
"false"         = false

# ────────────────────────────────────────────────────────────────────────────
# INTRINSICS — multi-opcode sequences
# ────────────────────────────────────────────────────────────────────────────

[intrinsics]
# x.ord → first char code
asc = "const_i32(0), str_char_code_at"
# arr.unshift(val) → splice(0, 0, val)
array_unshift = "const_i32(0), const_i32(0), splice"
# arr.first → arr[0]
array_at = "array_get"
# map.size → dict_keys, array_length
map_size = "dict_keys, array_length"

# ────────────────────────────────────────────────────────────────────────────
# MODULE ALIASES
# ────────────────────────────────────────────────────────────────────────────

[module_aliases]
"Math"          = "vybe:math"
"File"          = "wasi:filesystem"
"JSON"          = "vybe:json"
"Kernel"        = "vybe:runtime"
"IO"            = "wasi:cli"
"Dir"           = "wasi:filesystem"

# ────────────────────────────────────────────────────────────────────────────
# ARRAY HIGHER-ORDER METHODS — compiler_common loop infrastructure
# ────────────────────────────────────────────────────────────────────────────

[array_methods]
each             = "__array_forEach"
each_with_index  = "__array_forEach"
map              = "__array_map"
collect          = "__array_map"
select           = "__array_filter"
filter           = "__array_filter"
find             = "__array_find"
detect           = "__array_find"
reduce           = "__array_reduce"
inject           = "__array_reduce"
"any?"           = "__array_some"
"all?"           = "__array_every"
flat_map         = "__array_flat_map"
collect_concat   = "__array_flat_map"
sort             = "__array_sort"

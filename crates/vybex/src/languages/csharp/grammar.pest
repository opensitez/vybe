// C# Grammar for pest parser
// Covers everything vybe_parser_csharp supports
//
// C# uses ";" terminators, so newlines are whitespace (no ASI needed).
// Generics are recognized and stripped (no type-specific compilation).
// Keyword operators use atomic @{} rules for word boundaries.

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{ line_comment | block_comment }
line_comment = _{ "//" ~ (!"\n" ~ ANY)* }
block_comment = _{ "/*" ~ (!"*/" ~ ANY)* ~ "*/" }

// ── Program ─────────────────────────────────────────────────────────────────

program = { SOI ~ program_item* ~ EOI }

program_item = _{
    using_directive
    | namespace_declaration
    | type_declaration
    | statement
}

// ── Using directives ────────────────────────────────────────────────────────

using_directive = { "using" ~ using_directive_body ~ ";" }
using_directive_body = { using_static_directive | using_alias_directive | dotted_name }
using_static_directive = { "static" ~ dotted_name }
using_alias_directive = { ident_name ~ "=" ~ type_name }

dotted_name = @{ ident_name ~ ("." ~ ident_name)* }

// ── Namespace ───────────────────────────────────────────────────────────────

namespace_declaration = {
    "namespace" ~ dotted_name ~ ("{" ~ program_item* ~ "}" | ";")
}

// ── Type declarations ───────────────────────────────────────────────────────

type_declaration = _{
    attribute_list? ~ (record_struct_declaration | record_declaration | class_declaration | struct_declaration | interface_declaration | enum_declaration | delegate_declaration)
}

attribute_list = _{ "[" ~ (!"]" ~ ANY)* ~ "]" }

// ── Class ───────────────────────────────────────────────────────────────────

class_declaration = {
    class_modifiers ~ "class" ~ ident_name ~ generic_params? ~ base_list? ~ where_clauses? ~ class_body
}

// `where T : new()`, `where T : class`, `where T : IComparable<T>`, etc.
// Captured by the grammar but ignored by the walker — generic
// constraints are runtime-erased in the dynamic VM. Multiple
// constraints can chain.
where_clauses = _{ where_clause+ }
where_clause = { "where" ~ ident_name ~ ":" ~ where_constraint ~ ("," ~ where_constraint)* }
where_constraint = {
    "new" ~ "(" ~ ")"
    | "class" ~ !(ASCII_ALPHANUMERIC | "_")
    | "struct" ~ !(ASCII_ALPHANUMERIC | "_")
    | type_name
}

class_modifiers = { modifier* }

modifier = {
    "public" | "private" | "protected" | "internal"
    | static_kw | abstract_kw | sealed_kw | partial_kw
    | virtual_kw | override_kw | readonly_kw | "new"
    | async_kw | "const" | "volatile" | "extern"
}

static_kw = @{ "static" ~ !(ASCII_ALPHANUMERIC | "_") }
abstract_kw = @{ "abstract" ~ !(ASCII_ALPHANUMERIC | "_") }
sealed_kw = @{ "sealed" ~ !(ASCII_ALPHANUMERIC | "_") }
partial_kw = @{ "partial" ~ !(ASCII_ALPHANUMERIC | "_") }
virtual_kw = @{ "virtual" ~ !(ASCII_ALPHANUMERIC | "_") }
override_kw = @{ "override" ~ !(ASCII_ALPHANUMERIC | "_") }
readonly_kw = @{ "readonly" ~ !(ASCII_ALPHANUMERIC | "_") }
async_kw = @{ "async" ~ !(ASCII_ALPHANUMERIC | "_") }

generic_params = _{ "<" ~ generic_param_list ~ ">" }
generic_param_list = _{ ident_name ~ ("," ~ ident_name)* }

base_list = { ":" ~ type_name ~ ("," ~ type_name)* }

class_body = { "{" ~ class_member* ~ "}" }

// ── Class members ───────────────────────────────────────────────────────────

class_member = {
    attribute_list? ~ class_modifiers ~ (
        // Nested type declarations — class / struct / interface / enum
        // can all appear as inner members per ECMA-334 §15.3.
        record_struct_declaration
        | record_declaration
        | class_declaration
        | struct_declaration
        | interface_declaration
        | enum_declaration
        | operator_declaration
        | explicit_interface_indexer_declaration
        | indexer_declaration
        | constructor_declaration
        | explicit_interface_method_declaration
        | explicit_interface_property_declaration
        | method_declaration
        | property_declaration
        | event_declaration
        | field_declaration
    )
}

// `public static T operator +(T a, T b) { ... }` — operator overloads.
// Walker lowers to a static method named `op_Addition` / `op_Equality`
// per ECMA-335 — the call-site dispatch (compiler/calls.rs) maps the
// binary `a + b` form back via the same canonical name when both
// operands are class instances.
operator_declaration = {
    type_name ~ "operator" ~ operator_symbol ~ "(" ~ param_list? ~ ")" ~
        (block_statement | expression_body)
}
operator_symbol = @{
    "==" | "!=" | "<=" | ">=" | "<<" | ">>"
    | "+" | "-" | "*" | "/" | "%" | "&" | "|" | "^"
    | "~" | "!" | "<" | ">"
}

// `public T this[Type idx] { get; set; }` — indexer property.
// Walker lowers to a Property named `__index__` with one parameter,
// so `obj[i]` lookups go through the same getter / setter machinery as
// regular properties.
explicit_interface_name = @{ ident_name ~ generic_type_args? }
explicit_interface_specifier = { explicit_interface_name ~ "." }
indexer_name = { explicit_interface_specifier? ~ "this" }
explicit_interface_indexer_declaration = {
    type_name ~ explicit_interface_name ~ "." ~ "this" ~ "[" ~ param_list ~ "]" ~ property_body
}
indexer_declaration = {
    type_name ~ indexer_name ~ "[" ~ param_list ~ "]" ~ property_body
}

// Constructor: ClassName(params) : base/this(args) { body }
// Also: `ClassName(params) => single_expr;` (C# 7+ expression-bodied ctor)
constructor_declaration = {
    ident_name ~ "(" ~ param_list? ~ ")" ~ constructor_initializer? ~ (block_statement | expression_body)
}

constructor_initializer = {
    ":" ~ (base_kw | this_kw) ~ "(" ~ argument_list? ~ ")"
}

// Property: Type Name { get; set; } | { get { } set { } } | => expr;
// (C# 6+ expression-bodied read-only property is `Type Name => expr;`)
property_name = { explicit_interface_specifier? ~ ident_name }
explicit_interface_property_declaration = {
    type_name ~ explicit_interface_name ~ "." ~ ident_name ~ (expression_body | property_body ~ ("=" ~ expression ~ ";")?)
}
property_declaration = {
    type_name ~ property_name ~ (expression_body | property_body ~ ("=" ~ expression ~ ";")?)
}

property_body = {
    "{" ~ accessor+ ~ "}"
}

accessor = {
    class_modifiers ~ ("get" | "set" | "init") ~ (block_statement | ";")
}

// Event: event EventHandler Click;
event_declaration = {
    "event" ~ type_name ~ ident_name ~ ";"
}

// Method: ReturnType Name(params) { body }
// Generic methods may declare per-method `where` constraints which we
// capture-and-discard, same as on the class.
method_name = { explicit_interface_specifier? ~ ident_name }
explicit_interface_method_declaration = {
    type_name ~ explicit_interface_name ~ "." ~ ident_name ~ generic_params? ~ "(" ~ param_list? ~ ")" ~
        where_clauses? ~ (block_statement | expression_body | ";")
}
method_declaration = {
    type_name ~ method_name ~ generic_params? ~ "(" ~ param_list? ~ ")" ~
        where_clauses? ~ (block_statement | expression_body | ";")
}

// Expression-bodied member (C# 6+): `=> expr;`. Lowers to `{ return expr; }`
// in the walker. Same rule serves methods, properties, indexers, operators.
expression_body = { "=>" ~ expression ~ ";" }

// Field: Type name = value; or Type name;
field_declaration = {
    type_name ~ var_declarator_list ~ ";"
}

var_declarator_list = { var_declarator ~ ("," ~ var_declarator)* }

// C# array initializer literal — `int[] arr = { 1, 2, 3 };` desugars to
// `new int[] { 1, 2, 3 }` per ECMA-334 §17.7. The bare-brace form is
// only allowed in variable / field declarators; the walker materialises
// the missing `new T[]` prefix from the declared type.
var_declarator = { ident_name ~ ("=" ~ (array_initializer | expression))? }

// ── Struct ──────────────────────────────────────────────────────────────────

struct_declaration = {
    class_modifiers ~ "struct" ~ ident_name ~ generic_params? ~ base_list? ~ where_clauses? ~ class_body
}

// ── Interface ───────────────────────────────────────────────────────────────

interface_declaration = {
    class_modifiers ~ "interface" ~ ident_name ~ generic_params? ~ base_list? ~ where_clauses? ~ interface_body
}

interface_body = { "{" ~ interface_member* ~ "}" }

interface_member = {
    type_name ~ (
        ident_name ~ (
            "(" ~ param_list? ~ ")" ~ ";"                         // method
            | "{" ~ ("get" ~ ";")? ~ ("set" ~ ";")? ~ "}"       // property
        )
        | "this" ~ "[" ~ param_list ~ "]" ~ "{" ~ ("get" ~ ";")? ~ ("set" ~ ";")? ~ "}"
    )
}

// ── Enum ────────────────────────────────────────────────────────────────────

enum_declaration = {
    class_modifiers ~ "enum" ~ ident_name ~ ("{" ~ enum_member_list? ~ ","? ~ "}")
}

enum_member_list = { enum_member ~ ("," ~ enum_member)* }

enum_member = { ident_name ~ ("=" ~ expression)? }

// ── Record ──────────────────────────────────────────────────────────────────

record_base_clause = { ":" ~ type_name ~ ("(" ~ argument_list? ~ ")")? }
record_struct_declaration = {
    class_modifiers ~ "record" ~ "struct" ~ ident_name ~ ("(" ~ param_list? ~ ")")? ~ record_base_clause? ~ (class_body | ";")
}
record_declaration = {
    class_modifiers ~ "record" ~ ident_name ~ ("(" ~ param_list? ~ ")")? ~ record_base_clause? ~ (class_body | ";")
}

// ── Delegate ────────────────────────────────────────────────────────────────

delegate_declaration = {
    class_modifiers ~ "delegate" ~ type_name ~ ident_name ~ generic_params? ~ "(" ~ param_list? ~ ")" ~ ";"
}

// ── Statements ──────────────────────────────────────────────────────────────

statement = _{
    empty_statement
    | block_statement
    // `var (a, b) = f();` — tuple deconstruction declaration. Listed
    // before `local_var_declaration` so the `(` token is committed to
    // the deconstruction parse before the general `var name = expr;`
    // path consumes `var`.
    | tuple_deconstruction_decl
    // C# 7+ local functions / C# 9+ top-level functions:
    // `ReturnType Name(params) { body }`. Listed before
    // `local_var_declaration` so the `(` after the name commits to
    // the local-function parse rather than failing the var parse.
    | local_function_decl
    | using_declaration
    | local_var_declaration
    | if_statement
    | for_statement
    | foreach_statement
    | while_statement
    | do_while_statement
    | switch_statement
    | return_statement
    | yield_statement
    | break_statement
    | continue_statement
    | throw_statement
    | try_statement
    | using_statement
    | lock_statement
    | expression_statement
}

// Local / top-level function. Same shape as a class method but lives
// in a statement context. Walker emits `StmtKind::FunctionDecl`.
local_function_decl = {
    type_name ~ ident_name ~ generic_params? ~ "(" ~ param_list? ~ ")" ~
        where_clauses? ~ (block_statement | expression_body)
}

empty_statement = { ";" }

block_statement = { "{" ~ statement* ~ "}" }

// ── Variable declaration ────────────────────────────────────────────────────

local_var_declaration = {
    (var_kw | type_name) ~ var_declarator_list ~ ";"
}

var_kw = @{ "var" ~ !(ASCII_ALPHANUMERIC | "_") }

// `var (a, b, c) = expr;` — tuple deconstruction declaration.
// Introduces N fresh locals and destructures an N-tuple into them.
// Pairs with the compiler's multi-value receive path when the RHS is
// a direct call to a multi-return function.
tuple_deconstruction_decl = {
    var_kw ~ "(" ~ ident_name ~ ("," ~ ident_name)+ ~ ")" ~ "=" ~ expression ~ ";"
}

// ── If ──────────────────────────────────────────────────────────────────────

if_statement = {
    "if" ~ "(" ~ expression ~ ")" ~ statement ~ (else_if_clause)* ~ else_clause?
}

else_if_clause = {
    "else" ~ "if" ~ "(" ~ expression ~ ")" ~ statement
}

else_clause = {
    "else" ~ statement
}

// ── For ─────────────────────────────────────────────────────────────────────

for_statement = {
    "for" ~ "(" ~ for_init? ~ ";" ~ expression? ~ ";" ~ for_update? ~ ")" ~ statement
}

for_init = { local_var_declaration_no_semi | expression_list }

local_var_declaration_no_semi = {
    (var_kw | type_name) ~ var_declarator_list
}

for_update = { expression_list }

expression_list = { expression ~ ("," ~ expression)* }

// ── Foreach ─────────────────────────────────────────────────────────────────

foreach_statement = {
    "foreach" ~ "(" ~ (var_kw | type_name) ~ foreach_target ~ in_kw ~ expression ~ ")" ~ statement
}

foreach_target = { foreach_tuple_target | ident_name }
foreach_tuple_target = { "(" ~ ident_name ~ ("," ~ ident_name)+ ~ ","? ~ ")" }

// ── While / Do-while ────────────────────────────────────────────────────────

while_statement = { "while" ~ "(" ~ expression ~ ")" ~ statement }

do_while_statement = { "do" ~ statement ~ "while" ~ "(" ~ expression ~ ")" ~ ";" }

// ── Switch ──────────────────────────────────────────────────────────────────

switch_statement = {
    "switch" ~ "(" ~ expression ~ ")" ~ "{" ~ switch_section* ~ "}"
}

switch_section = {
    switch_label+ ~ statement+
}

switch_label = {
    case_value_label
    | case_pattern_label
    | "default" ~ ":"
}

case_value_label = { "case" ~ expression ~ ":" }
case_pattern_label = { "case" ~ switch_case_pattern ~ ("when" ~ expression)? ~ ":" }
switch_case_pattern = { pattern_clause }

// ── Jump statements ─────────────────────────────────────────────────────────

return_statement = { "return" ~ expression? ~ ";" }
break_statement = { "break" ~ ";" }
continue_statement = { "continue" ~ ";" }
throw_statement = { "throw" ~ expression? ~ ";" }

/// `yield return expr;` / `yield break;` — C# generator syntax. Any
/// method body that contains `yield return`/`yield break` is treated
/// as a generator; the compiler sets `chunk.is_generator = true` and
/// each `yield return` lowers to `Op::SUSPEND`. `yield break` ends the
/// generator (maps to `return`).
yield_statement = {
    "yield" ~ "return" ~ expression ~ ";"
    | "yield" ~ "break" ~ ";"
}

// ── Try / Catch / Finally ───────────────────────────────────────────────────

try_statement = {
    "try" ~ block_statement ~ catch_clause* ~ finally_clause?
}

// `catch (T e) when (cond) { ... }` — the optional `when` filter
// guards the catch arm. Walker lowers it to `if (!cond) throw e;`
// at the top of the catch body so the compiler stays unaware.
catch_clause = {
    "catch" ~ ("(" ~ type_name ~ ident_name? ~ ")")? ~ catch_when_filter? ~ block_statement
}
catch_when_filter = {
    "when" ~ "(" ~ expression ~ ")"
}

finally_clause = { "finally" ~ block_statement }

// ── Using statement ─────────────────────────────────────────────────────────

using_declaration = {
    "using" ~ (var_kw | type_name) ~ ident_name ~ "=" ~ expression ~ ";"
}

using_statement = {
    "using" ~ "(" ~ (var_kw | type_name) ~ ident_name ~ "=" ~ expression ~ ")" ~ statement
}

// ── Lock statement ──────────────────────────────────────────────────────────

lock_statement = {
    "lock" ~ "(" ~ expression ~ ")" ~ statement
}

// ── Expression statement ────────────────────────────────────────────────────

expression_statement = { expression ~ ";" }

// ── Expressions ─────────────────────────────────────────────────────────────

expression = { assignment_expression }

assignment_expression = {
    lambda_expression
    | conditional_expression ~ (assignment_op ~ assignment_expression)?
}

assignment_op = {
    ">>=" | "<<=" |
    "+=" | "-=" | "*=" | "/=" | "%=" |
    "&=" | "|=" | "^=" |
    "??=" |
    "="
}

// Lambda: (params) => expr/body  or  x => expr/body
lambda_expression = {
    async_kw? ~ ("(" ~ param_list? ~ ")" | ident_name) ~ "=>" ~ lambda_body
}

lambda_body = { block_statement | expression }

conditional_expression = {
    null_coalesce_expr ~ ("?" ~ expression ~ ":" ~ expression)?
}

// Null coalescing
null_coalesce_expr = { logical_or ~ (nullcoalesce_op ~ logical_or)* }
nullcoalesce_op = { "??" ~ !"=" }

// Logical OR
logical_or = { logical_and ~ (or_op ~ logical_and)* }
or_op = { "||" ~ !"=" }

// Logical AND
logical_and = { bitwise_or ~ (and_op ~ bitwise_or)* }
and_op = { "&&" ~ !"=" }

// Bitwise OR
bitwise_or = { bitwise_xor ~ (bitor_op ~ bitwise_xor)* }
bitor_op = { "|" ~ !("=" | "|") }

// Bitwise XOR
bitwise_xor = { bitwise_and ~ (bitxor_op ~ bitwise_and)* }
bitxor_op = { "^" ~ !"=" }

// Bitwise AND
bitwise_and = { equality ~ (bitand_op ~ equality)* }
bitand_op = { "&" ~ !("=" | "&") }

// Equality
equality = { relational ~ (equality_op ~ relational)* }
equality_op = { "==" | "!=" }

// Relational + type testing + shift
// is/as are postfix-style (no right operand in the binary chain).
// `switch` (C# 8 expression) and `with` (C# 9 record clone) are also
// postfix here.
relational = { additive ~ (type_test | switch_expr_postfix | with_expr_postfix | binary_relational)* }

// `record_value with { Prop = val, ... }` — clone-and-modify (C# 9
// records). Walker lowers to `(rec, props) → cloneObject(rec, props)`.
with_expr_postfix = {
    "with" ~ object_initializer
}
type_test = {
    is_kw ~ pattern_clause
    | as_kw ~ type_name
}

// C# 8 switch expression: `expr switch { pattern => result, ... }`.
// Walker lowers each arm into a nested ternary so we don't need a
// dedicated SwitchExpr AST node.
switch_expr_postfix = {
    "switch" ~ "{" ~ switch_arm ~ ("," ~ switch_arm)* ~ ","? ~ "}"
}
switch_arm = {
    switch_pattern ~ ("when" ~ expression)? ~ "=>" ~ expression
}
switch_pattern = {
    "_" ~ !(ASCII_ALPHANUMERIC | "_")
    | (">=" | "<=" | ">" | "<") ~ expression
    | type_name ~ ident_name
    | expression
}

// C# pattern matching surfaces under `is` (and switch expressions).
// We cover the spec's core forms — null / not-null / constant / type
// (with optional ident binding). More exotic forms (relational, list,
// property) fall through to the type-name path.
pattern_clause = {
    "not" ~ pattern_atom
    | pattern_atom ~ (pattern_and_kw ~ pattern_atom)*
}
pattern_and_kw = { "and" }
pattern_atom = {
    null_kw                        // `is null`
    | true_kw                      // `is true`
    | false_kw                     // `is false`
    | char_literal                 // `is 'x'`
    | numeric_literal              // `is 0`
    | string_literal               // `is "x"`
    | relational_pattern           // `is >= 0`
    | tuple_pattern                // `is (1, _)`
    | var_pattern                  // `is var x`
    | pattern_type ~ ident_name?   // `is string s` / `is int`
}
pattern_type = { base_type ~ generic_type_args? ~ array_rank* }
relational_pattern = { (">=" | "<=" | ">" | "<") ~ expression }
tuple_pattern = { "(" ~ tuple_pattern_item ~ ("," ~ tuple_pattern_item)+ ~ ","? ~ ")" }
tuple_pattern_item = { "_" ~ !(ASCII_ALPHANUMERIC | "_") | expression }
var_pattern = { var_kw ~ ident_name }
binary_relational = { relational_op ~ additive }
relational_op = {
    shift_op | "<=" | ">=" | "<" ~ !"<" | ">" ~ !">"
}
shift_op = { ">>" ~ !(">" | "=") | "<<" ~ !"=" }

// Additive
additive = { multiplicative ~ (additive_op ~ multiplicative)* }
additive_op = { "+" ~ !("+" | "=") | "-" ~ !("-" | "=") }

// Multiplicative
multiplicative = { unary ~ (multiplicative_op ~ unary)* }
multiplicative_op = { "*" ~ !("*" | "=") | "/" ~ !"=" | "%" ~ !"=" }

// Unary
unary = {
    cast_expression
    | unary_op ~ unary
    | postfix
}

// C# explicit cast: `(TypeName)expr`. Restricted to recognised type
// names to avoid ambiguity with parenthesised expressions
// (`(x)+y` should still parse as add of `(x)` and `+y`). Primitive
// type keywords always indicate a cast; user-defined type names
// are heuristic — pest backtracks to the postfix path if the
// alternative doesn't fit.
cast_expression = { "(" ~ cast_type ~ ")" ~ unary }
cast_type = {
    "int" ~ !(ASCII_ALPHANUMERIC | "_")
    | "long" ~ !(ASCII_ALPHANUMERIC | "_")
    | "short" ~ !(ASCII_ALPHANUMERIC | "_")
    | "byte" ~ !(ASCII_ALPHANUMERIC | "_")
    | "float" ~ !(ASCII_ALPHANUMERIC | "_")
    | "double" ~ !(ASCII_ALPHANUMERIC | "_")
    | "decimal" ~ !(ASCII_ALPHANUMERIC | "_")
    | "char" ~ !(ASCII_ALPHANUMERIC | "_")
    | "string" ~ !(ASCII_ALPHANUMERIC | "_")
    | "bool" ~ !(ASCII_ALPHANUMERIC | "_")
    | "uint" ~ !(ASCII_ALPHANUMERIC | "_")
    | "ulong" ~ !(ASCII_ALPHANUMERIC | "_")
    | "ushort" ~ !(ASCII_ALPHANUMERIC | "_")
    | "sbyte" ~ !(ASCII_ALPHANUMERIC | "_")
    | "object" ~ !(ASCII_ALPHANUMERIC | "_")
    | type_name
}

// Keyword operators — atomic for word boundaries
this_kw = @{ "this" ~ !(ASCII_ALPHANUMERIC | "_") }
base_kw = @{ "base" ~ !(ASCII_ALPHANUMERIC | "_") }
true_kw = @{ "true" ~ !(ASCII_ALPHANUMERIC | "_") }
false_kw = @{ "false" ~ !(ASCII_ALPHANUMERIC | "_") }
null_kw = @{ "null" ~ !(ASCII_ALPHANUMERIC | "_") }
typeof_kw = @{ "typeof" ~ !(ASCII_ALPHANUMERIC | "_") }
nameof_kw = @{ "nameof" ~ !(ASCII_ALPHANUMERIC | "_") }
default_kw = @{ "default" ~ !(ASCII_ALPHANUMERIC | "_") }
new_kw = @{ "new" ~ !(ASCII_ALPHANUMERIC | "_") }
is_kw = @{ "is" ~ !(ASCII_ALPHANUMERIC | "_") }
as_kw = @{ "as" ~ !(ASCII_ALPHANUMERIC | "_") }
in_kw = @{ "in" ~ !(ASCII_ALPHANUMERIC | "_") }
await_kw = @{ "await" ~ !(ASCII_ALPHANUMERIC | "_") }

unary_op = {
    "-" ~ !("-" | "=")
    | "+" ~ !("+" | "=")
    | "!" ~ !"="
    | "~"
    | "++"
    | "--"
    | await_kw
}

postfix = { call_expression ~ postfix_op? }
postfix_op = { "++" | "--" }

// ── Call / Member / Index chain ─────────────────────────────────────────────

call_expression = {
    (new_expression | primary) ~ call_chain*
}

new_expression = {
    // C# 3+ implicit-typed array creation: `new[] { 1, 2 }`. The
    // element type is inferred from the initializer.
    new_kw ~ "[" ~ "]" ~ array_initializer
    | new_kw ~ type_name_for_new ~ (
        // Multi-bracket forms `new int[3][]`, `new int[3,4]`, `new int[5]`,
        // `new int[]` — a sequence of bracketed dimensions, optionally
        // followed by an array initializer for the leading dimensions.
        ("[" ~ (expression ~ ("," ~ expression)*)? ~ "]")+ ~ array_initializer?
        | "(" ~ argument_list? ~ ")" ~ (object_initializer | array_initializer)? // new Foo(args) { }
        // `object_initializer` BEFORE `array_initializer` — both start with
        // `{` but `Prop = value` shapes only match the object form, while
        // `array_initializer` would greedily consume them as ASSIGN
        // expressions and lose the property names.
        | object_initializer                                // new Foo { prop = val }
        | array_initializer                                 // new int[] { 1, 2 }
    )?
}

type_name_for_new = { base_type ~ generic_type_args? }

generic_type_args = _{ "<" ~ type_name ~ ("," ~ type_name)* ~ ">" }

// Collection initializer literal — accepts either flat expressions
// (`new int[] { 1, 2, 3 }`, `new List<int> { 1, 2 }`,
// `new HashSet<int> { 1, 2 }`) or nested-brace pairs/tuples
// (`new Dictionary<K,V> { { "a", 1 } }`, `int[,] m = { { 1, 2 } }`).
// The walker dispatches on the receiver type to decide whether nested
// braces become Object properties (Dictionary) or nested Array
// literals (multi-dim).
array_initializer = { "{" ~ (collection_element ~ ("," ~ collection_element)*)? ~ ","? ~ "}" }
indexer_initializer = { "[" ~ expression ~ "]" ~ "=" ~ expression }
collection_element = {
    indexer_initializer
    | "{" ~ (expression ~ ("," ~ expression)*)? ~ ","? ~ "}"
    | expression
}

object_initializer = { "{" ~ (initializer_member ~ ("," ~ initializer_member)*)? ~ ","? ~ "}" }

initializer_member = { ident_name ~ "=" ~ expression }

call_chain = {
    "?." ~ ident_or_keyword                              // null-conditional member
    | "(" ~ argument_list? ~ ")"                          // call
    | "." ~ ident_or_keyword ~ generic_type_args?         // member access
    | "[" ~ index_expression ~ "]"                        // index / range / from-end
}

// C# 8 index-from-end: `arr[^1]` is `arr[arr.Length - 1]`. C# 8 ranges:
// `arr[1..3]`, `arr[..^1]`, `arr[^3..]`, `arr[..]`. Multi-dimensional
// arrays use comma-separated indices (`m[0, 0]`) which lower to a
// flattened single-arg index since our backing array is a 1-D shape
// (the walker concatenates the args via repeated index lookups in
// nested arrays). The walker maps each shape onto Index / Range AST
// nodes.
index_expression = {
    from_end_index ~ ".." ~ from_end_index?               // `arr[^3..]` / `arr[^3..^1]`
    | from_end_index ~ ".." ~ expression                  // `arr[^3..5]`
    | from_end_index                                       // `arr[^1]`
    | expression ~ ".." ~ from_end_index                  // `arr[1..^1]`
    | expression ~ ("..") ~ expression?                   // `arr[1..3]` / `arr[1..]`
    | (".." ~ from_end_index)                             // `arr[..^1]`
    | (".." ~ expression?)                                // `arr[..5]` / `arr[..]`
    | expression ~ ("," ~ expression)+                    // `m[i, j]` multi-dim
    | expression                                           // `arr[i]`
}

from_end_index = { "^" ~ expression }

argument_list = { argument ~ ("," ~ argument)* ~ ","? }

argument = {
    // C# `out var x` — declares a fresh local from the call site.
    "out" ~ (var_kw | type_name) ~ ident_name
    | ("ref" | "out") ~ expression
    // Named argument: `name: expr`. The leading ident is reified as
    // `ident_name` so the walker can extract it; the colon disambiguates
    // from the bare-expression alternative below.
    | ident_name ~ ":" ~ !":" ~ expression
    | expression
}

// ── Primary expressions ─────────────────────────────────────────────────────

primary = {
    tuple_literal                    // (a, b, c) — must come before paren_expr
    | "(" ~ expression ~ ")"           // parenthesized
    | typeof_expression
    | nameof_expression
    | default_expression
    | checked_expression
    | interpolated_string
    | verbatim_string
    | char_literal
    | this_kw
    | base_kw
    | true_kw
    | false_kw
    | null_kw
    | numeric_literal
    | string_literal
    | primitive_type_ident
    | generic_type_expr
    | ident_name
}

generic_type_expr = { base_type ~ generic_type_args }

// C# tuple literal: (1, "x", true) or named (Name: "Alice", Age: 30).
// At least 2 elements (1-element is just paren_expr). The named form
// per ECMA-334 §11.7.4 — each element optionally prefixed with `Name:`
// which becomes an Item-aliased property on the tuple.
tuple_literal = { "(" ~ tuple_element ~ ("," ~ tuple_element)+ ~ ","? ~ ")" }
tuple_element = { (ident_name ~ ":" ~ !":")? ~ expression }

// C# allows primitive type names as identifier prefixes for static method calls:
// `string.Join(",", arr)`, `int.Parse("42")`, `bool.Parse("true")`, etc.
primitive_type_ident = @{
    ("string" | "int" | "double" | "float" | "bool" | "char" | "long" | "byte"
    | "short" | "decimal" | "object" | "uint" | "ulong" | "ushort" | "sbyte")
    ~ !(ASCII_ALPHANUMERIC | "_")
}

typeof_expression = { typeof_kw ~ "(" ~ type_name ~ ")" }
nameof_expression = { nameof_kw ~ "(" ~ dotted_name ~ ")" }
default_expression = { default_kw ~ ("(" ~ type_name ~ ")")? }
checked_expression = { ("checked" | "unchecked") ~ "(" ~ expression ~ ")" }

// ── Interpolated strings ────────────────────────────────────────────────────
// Parsed atomically as a raw string, then split into parts in the walker.
// This prevents pest's WHITESPACE from eating spaces between text and {expr}.

interpolated_string = @{
    "$\"" ~ interp_content* ~ "\""
}

interp_content = _{ interp_hole | interp_char }
interp_hole = _{ "{" ~ (!"}" ~ ANY)* ~ "}" }
interp_char = _{ !"\"" ~ !"{" ~ ANY }

// ── Verbatim strings ────────────────────────────────────────────────────────

verbatim_string = @{ "@\"" ~ ("\"\"" | !"\"" ~ ANY)* ~ "\"" }

// ── Char literal ────────────────────────────────────────────────────────────

char_literal = @{ "'" ~ ("\\" ~ ANY | !"'" ~ ANY) ~ "'" }

// ── Literals ────────────────────────────────────────────────────────────────

numeric_literal = @{
    ("0x" | "0X") ~ ASCII_HEX_DIGIT+ ~ numeric_suffix?
    | ("0b" | "0B") ~ ('0'..'1')+ ~ numeric_suffix?
    // Decimal: a `.` followed by another `.` is NOT a decimal point — it's a
    // range operator (`1..3`). Negative lookahead prevents the literal from
    // greedily eating the first `.` of a range.
    | ASCII_DIGIT+ ~ "." ~ !"." ~ ASCII_DIGIT+ ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)? ~ numeric_suffix?
    | "." ~ ASCII_DIGIT+ ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)? ~ numeric_suffix?
    | ASCII_DIGIT+ ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)? ~ numeric_suffix?
}

numeric_suffix = @{ "UL" | "ul" | "LU" | "lu" | "f" | "F" | "d" | "D" | "m" | "M" | "L" | "l" | "U" | "u" }

string_literal = @{
    "\"" ~ ("\\\"" | "\\\\" | "\\n" | "\\t" | "\\r" | "\\0" | !"\"" ~ ANY)* ~ "\""
}

// ── Type names ──────────────────────────────────────────────────────────────

type_name = {
    tuple_type
    | base_type ~ generic_type_args? ~ nullable_marker? ~ array_rank*
}

// C# tuple type: `(int, string)` or `(int x, string y)`. Element names
// are accepted but discarded — they're documentation, not part of
// the lowered type. At least 2 elements (1-element form collides with
// parenthesized type expressions).
tuple_type = {
    "(" ~ tuple_type_element ~ ("," ~ tuple_type_element)+ ~ ","? ~ ")"
    ~ nullable_marker? ~ array_rank*
}

tuple_type_element = {
    base_type ~ generic_type_args? ~ nullable_marker? ~ array_rank* ~ ident_name?
}

base_type = @{
    ("int" | "string" | "double" | "float" | "bool" | "char" | "long" | "byte"
    | "short" | "decimal" | "object" | "void" | "dynamic" | "var"
    | "uint" | "ulong" | "ushort" | "sbyte" | "nint" | "nuint")
    ~ !(ASCII_ALPHANUMERIC | "_")
    | dotted_name
}

nullable_marker = { "?" }
array_rank = { "[" ~ ","* ~ "]" }

// ── Parameters ──────────────────────────────────────────────────────────────

param_list = { param ~ ("," ~ param)* ~ ","? }

param = {
    param_modifier? ~ type_name ~ ident_name ~ ("=" ~ expression)?
    | param_modifier? ~ ident_name ~ ("=" ~ expression)?
}

param_modifier = { "params" | "ref" | "out" | "this" }

// ── Identifiers ─────────────────────────────────────────────────────────────

ident_name = @{
    !strict_keyword ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")*
}

ident_or_keyword = @{
    (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")*
}

strict_keyword = _{
    ("abstract" | "as" | "base" | "bool" | "break" | "byte" | "case" | "catch"
    | "char" | "checked" | "class" | "const" | "continue" | "decimal" | "default"
    | "delegate" | "do" | "double" | "else" | "enum" | "event" | "explicit"
    | "extern" | "false" | "finally" | "fixed" | "float" | "for" | "foreach"
    | "goto" | "if" | "implicit" | "in" | "int" | "interface" | "internal"
    | "is" | "lock" | "long" | "namespace" | "new" | "null" | "object"
    | "operator" | "out" | "override" | "params" | "private" | "protected"
    | "public" | "readonly" | "ref" | "return" | "sbyte" | "sealed" | "short"
    | "sizeof" | "static" | "string" | "struct" | "switch" | "this" | "throw"
    | "true" | "try" | "typeof" | "uint" | "ulong" | "unchecked" | "unsafe"
    | "ushort" | "using" | "virtual" | "void" | "volatile" | "while")
    ~ !(ASCII_ALPHANUMERIC | "_")
}

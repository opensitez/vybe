# C# Compiler Profile
# ────────────────────
# Full port of vybe_compiler_csharp builtins — Console, Math, Convert, String,
# collections, LINQ, GUI, threading, type operations.

[info]
name = "csharp"
extensions = ["cs"]

[compiler]
function_return = "explicit"
self_keyword = "this"
base_keyword = "base"
constructor_name = "ctor"
separated_methods = false
implicit_self_fields = true
explicit_self_param = false
enum_as_ordinals = true
case_sensitive = true
string_indexing = "zero_based"
entry_point = "Main"
partial_classes = true
auto_base_call = true
auto_init_methods = ["InitializeComponent"]  # auto-call in ctor if class defines it
dynamic_add = true
# C#: `return (a, b);` with `ValueTuple` syntax maps to WASM multi-value
# at the ABI boundary. Destructure-side (`var (a, b) = f();`) isn't in
# the grammar yet, so today only the callee-side saving applies —
# non-destructure callers get the N values auto-repacked into an array.
# When/if tuple-deconstruction lands in the grammar, the existing
# `detect_multi_value_receive` path will light up automatically.
multi_value_tuple_returns = true

# ────────────────────────────────────────────────────────────────────────────
# BUILTINS — bare global function calls and dotted static calls
# ────────────────────────────────────────────────────────────────────────────

[builtins]

# ── I/O ──────────────────────────────────────────────────────────────────────

"Console.WriteLine"       = { emit = "print",                     min_args = 0, max_args = 255 }
"Console.Write"           = { emit = "print",                     min_args = 0, max_args = 255 }
"Console.ReadLine"        = { emit = "host:wasi:cli:readLine",    min_args = 0, max_args = 0 }
"Console.Error"           = { emit = "host:wasi:cli:error",       min_args = 0, max_args = 255 }

# ── Math — WASM opcodes ─────────────────────────────────────────────────────

"Math.Abs"          = { emit = "opcode:f64_abs",      min_args = 1, max_args = 1 }
"Math.Floor"        = { emit = "opcode:f64_floor",    min_args = 1, max_args = 1 }
"Math.Ceiling"      = { emit = "opcode:f64_ceil",     min_args = 1, max_args = 1 }
"Math.Ceil"         = { emit = "opcode:f64_ceil",     min_args = 1, max_args = 1 }
"Math.Sqrt"         = { emit = "opcode:f64_sqrt",     min_args = 1, max_args = 1 }
"Math.Truncate"     = { emit = "opcode:f64_trunc",    min_args = 1, max_args = 1 }
"Math.Trunc"        = { emit = "opcode:f64_trunc",    min_args = 1, max_args = 1 }
"Math.Round"        = { emit = "opcode:f64_nearest",  min_args = 1, max_args = 1 }
"Math.Min"          = { emit = "opcode:f64_min",      min_args = 2, max_args = 2 }
"Math.Max"          = { emit = "opcode:f64_max",      min_args = 2, max_args = 2 }

# ── Math — host calls ───────────────────────────────────────────────────────

"Math.Pow"          = { emit = "stdlib:pow",      min_args = 2, max_args = 2 }
"Math.Sin"          = { emit = "stdlib:sin",      min_args = 1, max_args = 1 }
"Math.Cos"          = { emit = "stdlib:cos",      min_args = 1, max_args = 1 }
"Math.Tan"          = { emit = "stdlib:tan",      min_args = 1, max_args = 1 }
"Math.Asin"         = { emit = "stdlib:asin",     min_args = 1, max_args = 1 }
"Math.Acos"         = { emit = "stdlib:acos",     min_args = 1, max_args = 1 }
"Math.Atan"         = { emit = "stdlib:atan",     min_args = 1, max_args = 1 }
"Math.Atan2"        = { emit = "stdlib:atan2",    min_args = 2, max_args = 2 }
"Math.Log"          = { emit = "stdlib:log",      min_args = 1, max_args = 1 }
"Math.Log10"        = { emit = "stdlib:log10",    min_args = 1, max_args = 1 }
"Math.Exp"          = { emit = "stdlib:exp",      min_args = 1, max_args = 1 }
"Math.Sinh"         = { emit = "stdlib:sinh",     min_args = 1, max_args = 1 }
"Math.Cosh"         = { emit = "stdlib:cosh",     min_args = 1, max_args = 1 }
"Math.Tanh"         = { emit = "stdlib:tanh",     min_args = 1, max_args = 1 }
"Math.Sign"         = { emit = "stdlib:sign",     min_args = 1, max_args = 1 }
"Math.Clamp"        = { emit = "stdlib:clamp",    min_args = 3, max_args = 3 }

# ── Type conversion ──────────────────────────────────────────────────────────

"Convert.ToInt32"    = { emit = "host:vybe:convert:cint",         min_args = 1, max_args = 1 }
"Convert.ToDouble"   = { emit = "host:vybe:convert:cdbl",         min_args = 1, max_args = 1 }
"Convert.ToString"   = { emit = "stdlib:tostring",               min_args = 1, max_args = 1 }
"Convert.ToBoolean"  = { emit = "opcode:dyn_to_bool",             min_args = 1, max_args = 1 }
"Convert.ToChar"     = { emit = "host:vybe:convert:cchar",        min_args = 1, max_args = 1 }
"Convert.ToByte"     = { emit = "host:vybe:convert:cbyte",        min_args = 1, max_args = 1 }
"Convert.ToInt64"    = { emit = "host:vybe:convert:clng",         min_args = 1, max_args = 1 }
"Convert.ToSingle"   = { emit = "host:vybe:convert:csng",         min_args = 1, max_args = 1 }
"Convert.ToDecimal"  = { emit = "host:vybe:convert:cdbl",         min_args = 1, max_args = 1 }
"int.Parse"          = { emit = "host:vybe:convert:cint",         min_args = 1, max_args = 1 }
"double.Parse"       = { emit = "host:vybe:convert:cdbl",         min_args = 1, max_args = 1 }
"bool.Parse"         = { emit = "opcode:dyn_to_bool",             min_args = 1, max_args = 1 }
"Int32.Parse"        = { emit = "host:vybe:convert:cint",         min_args = 1, max_args = 1 }
"Double.Parse"       = { emit = "host:vybe:convert:cdbl",         min_args = 1, max_args = 1 }
"Int32.TryParse"     = { emit = "host:vybe:convert:cint",         min_args = 1, max_args = 2 }

# ── String static methods ────────────────────────────────────────────────────

"String.Join"         = { emit = "common:collections.join",      min_args = 2, max_args = 2 }
"String.IsNullOrEmpty" = { emit = "stdlib:string_is_null_or_empty", min_args = 1, max_args = 1 }
"String.IsNullOrWhiteSpace" = { emit = "stdlib:string_is_null_or_whitespace", min_args = 1, max_args = 1 }
"String.Format"       = { emit = "host:vybe:string:format",       min_args = 1, max_args = 255 }
"String.Concat"       = { emit = "opcode:str_concat",             min_args = 2, max_args = 255 }
"string.IsNullOrEmpty" = { emit = "stdlib:string_is_null_or_empty", min_args = 1, max_args = 1 }
"string.IsNullOrWhiteSpace" = { emit = "stdlib:string_is_null_or_whitespace", min_args = 1, max_args = 1 }
"string.Join"         = { emit = "common:collections.join",      min_args = 2, max_args = 2 }

# ── Array static methods ────────────────────────────────────────────────────

"Array.Sort"          = { emit = "common:collections.sort",             min_args = 1, max_args = 1 }
"Array.Reverse"       = { emit = "common:collections.reverse",          min_args = 1, max_args = 1 }
"Array.IndexOf"       = { emit = "opcode:str_index_of",           min_args = 2, max_args = 2 }
"Array.Copy"          = { emit = "host:vybe:array:copy",          min_args = 3, max_args = 3 }

# ── Object static methods ───────────────────────────────────────────────────

"Object.Equals"       = { emit = "opcode:dyn_eq",                 min_args = 2, max_args = 2 }
"Object.ReferenceEquals" = { emit = "opcode:ref_eq",              min_args = 2, max_args = 2 }

# ── JSON ─────────────────────────────────────────────────────────────────────

"JsonSerializer.Serialize"     = { emit = "host:vybe:json:stringify", min_args = 1, max_args = 1 }
"JsonSerializer.Deserialize"   = { emit = "host:vybe:json:parse",    min_args = 1, max_args = 1 }

# ── Environment ──────────────────────────────────────────────────────────────

"Environment.NewLine"          = { emit = "host:vybe:convert:newline",  min_args = 0, max_args = 0 }
"Environment.GetEnvironmentVariable" = { emit = "host:wasi:cli:getEnv", min_args = 1, max_args = 1 }

# ── Threading ────────────────────────────────────────────────────────────────
# Routes through compiler_common::threading which uses real WASM threading
# opcodes (thread_spawn, thread_join, atomic_*) — NOT Vybe-specific host calls.
# Standard WASM runtimes that support the threads proposal get proper threading
# without needing the Vybe host. Sleep uses the standard `wasi:clocks` import.

# ── GUI (Windows Forms) ─────────────────────────────────────────────────────

"Application.Run"              = { emit = "host:vybe:gui:runApplication",   min_args = 1, max_args = 1 }
"Application.Exit"             = { emit = "host:vybe:gui:appExit",          min_args = 0, max_args = 0 }
"MessageBox.Show"              = { emit = "host:vybe:gui:msgBox",           min_args = 1, max_args = 3 }

# ── Layout no-ops ────────────────────────────────────────────────────────────

"SuspendLayout"   = { emit = "noop", min_args = 0, max_args = 0 }
"ResumeLayout"    = { emit = "noop", min_args = 0, max_args = 1 }
"PerformLayout"   = { emit = "noop", min_args = 0, max_args = 0 }
"InitializeComponent" = { emit = "noop", min_args = 0, max_args = 0 }

# ────────────────────────────────────────────────────────────────────────────
# VALUE METHODS — instance methods called on values
# ────────────────────────────────────────────────────────────────────────────

[value_methods]

# String instance methods
ToUpper       = { emit = "common:strings.to_upper",   min_args = 0, max_args = 0 }
ToLower       = { emit = "common:strings.to_lower",   min_args = 0, max_args = 0 }
Trim          = { emit = "common:strings.trim",        min_args = 0, max_args = 0 }
TrimStart     = { emit = "opcode:str_trim_start",      min_args = 0, max_args = 0 }
TrimEnd       = { emit = "opcode:str_trim_end",        min_args = 0, max_args = 0 }
StartsWith    = { emit = "opcode:str_starts_with",     min_args = 1, max_args = 1 }
EndsWith      = { emit = "opcode:str_ends_with",       min_args = 1, max_args = 1 }
Contains      = { emit = "opcode:str_includes",        min_args = 1, max_args = 1 }
Replace       = { emit = "common:strings.replace",     min_args = 2, max_args = 2 }
Split         = { emit = "common:strings.split",       min_args = 1, max_args = 2 }
Substring     = { emit = "common:strings.substring",   min_args = 1, max_args = 2 }
IndexOf       = { emit = "common:strings.index_of",    min_args = 1, max_args = 2 }
LastIndexOf   = { emit = "opcode:str_last_index_of",   min_args = 1, max_args = 2 }
PadLeft       = { emit = "opcode:str_pad_start",       min_args = 1, max_args = 2 }
PadRight      = { emit = "opcode:str_pad_end",         min_args = 1, max_args = 2 }
ToString      = { emit = "stdlib:tostring",            min_args = 0, max_args = 0 }
ToCharArray   = { emit = "opcode:str_split",           min_args = 0, max_args = 0 }
Insert        = { emit = "stdlib:str_insert",          min_args = 2, max_args = 2 }
Remove        = [
    { emit = "stdlib:str_remove_start", min_args = 1, max_args = 1 },
    { emit = "stdlib:str_remove_range", min_args = 2, max_args = 2 },
]

# Array/List instance methods
# Add has two overloads: list.Add(item) (1 arg) and dict.Add(key, value) (2 args)
Add           = [
    { emit = "common:collections.push", min_args = 1, max_args = 1 },
    { emit = "common:dict.set_dynamic", min_args = 2, max_args = 2 },
]
Clear         = { emit = "host:vybe:array:clear",      min_args = 0, max_args = 0 }
Reverse       = { emit = "common:collections.reverse",       min_args = 0, max_args = 0 }
Sort          = { emit = "stdlib:sort_in_place",       min_args = 0, max_args = 0 }
join          = { emit = "common:collections.join",    min_args = 1, max_args = 1 }
Count         = { emit = "common:collections.length", min_args = 0, max_args = 0 }
ToArray       = { emit = "noop",                       min_args = 0, max_args = 0 }
ToList        = { emit = "noop",                       min_args = 0, max_args = 0 }
GetType       = { emit = "host:vybe:convert:getType",  min_args = 0, max_args = 0 }
Equals        = { emit = "opcode:dyn_eq",              min_args = 1, max_args = 1 }

# LINQ methods — removed (use [array_methods] below for HOFs)

# Dictionary methods
ContainsKey   = { emit = "host:vybe:runtime:callMethod", min_args = 1, max_args = 1 }
ContainsValue = { emit = "host:vybe:runtime:callMethod", min_args = 1, max_args = 1 }
TryGetValue   = { emit = "host:vybe:runtime:callMethod", min_args = 1, max_args = 2 }

# Queue/Stack methods
Enqueue       = { emit = "common:collections.push",          min_args = 1, max_args = 1 }
Dequeue       = { emit = "common:collections.shift",         min_args = 0, max_args = 0 }
Push          = { emit = "common:collections.push",          min_args = 1, max_args = 1 }
Pop           = { emit = "common:collections.pop",           min_args = 0, max_args = 0 }
Peek          = { emit = "host:vybe:runtime:callMethod", min_args = 0, max_args = 0 }

# ────────────────────────────────────────────────────────────────────────────
# ESM DEFAULTS — C# namespace objects → host modules, ECMA-262 §16.2 shape
# ────────────────────────────────────────────────────────────────────────────

[[esm_default]]
kind = "namespace"
alias = "Console"
module = "wasi:cli"

[[esm_default]]
kind = "namespace"
alias = "Math"
module = "vybe:js-math"

[[esm_default]]
kind = "namespace"
alias = "Convert"
module = "vybe:convert"

[[esm_default]]
kind = "namespace"
alias = "Environment"
module = "wasi:cli"

[[esm_default]]
kind = "namespace"
alias = "Array"
module = "vybe:array"

[[esm_default]]
kind = "namespace"
alias = "String"
module = "vybe:string"

[[esm_default]]
kind = "namespace"
alias = "Object"
module = "vybe:object"

# Task / Thread / Interlocked are compiler-only now: Task.Run / Thread.Start
# compile to Op::THREAD_SPAWN, Interlocked.* compiles to WASM atomic opcodes,
# Thread.Sleep uses wasi:clocks/sleep. No ESM namespace object is needed —
# the compiler intercepts these calls directly.

[[esm_default]]
kind = "namespace"
alias = "Application"
module = "vybe:gui"

[[esm_default]]
kind = "namespace"
alias = "MessageBox"
module = "vybe:gui"

[[esm_default]]
kind = "namespace"
alias = "File"
module = "wasi:filesystem"

[[esm_default]]
kind = "namespace"
alias = "Directory"
module = "wasi:filesystem"

[[esm_default]]
kind = "namespace"

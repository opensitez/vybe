module = "wasi:filesystem"

# ────────────────────────────────────────────────────────────────────────────
# KNOWN TYPES — constructor mappings for new TypeName()
# ────────────────────────────────────────────────────────────────────────────

[known_types]
# Exceptions
"Exception"       = ["vybe:types", "exceptionNew"]
"ArgumentException" = ["vybe:types", "exceptionNew"]
"InvalidOperationException" = ["vybe:types", "exceptionNew"]
"NotImplementedException" = ["vybe:types", "exceptionNew"]
"NullReferenceException" = ["vybe:types", "exceptionNew"]
"IndexOutOfRangeException" = ["vybe:types", "exceptionNew"]
# Other types
"StringBuilder"   = ["vybe:types", "stringBuilderNew"]
"Regex"           = ["vybe:regex", "RegExp"]
"Random"          = ["wasi:random/insecure", "get-insecure-random-u64"]
"Stopwatch"       = ["wasi:clocks", "stopwatchNew"]
"Timer"           = ["vybe:types", "timerNew"]

# ────────────────────────────────────────────────────────────────────────────
# NAMESPACE CONSTANTS — property access, NOT function call
# ────────────────────────────────────────────────────────────────────────────

# ────────────────────────────────────────────────────────────────────────────
# ARRAY METHODS — higher-order methods routed to compiler_common::loops
# ────────────────────────────────────────────────────────────────────────────

[array_methods]
Where     = "__array_filter"
Select    = "__array_map"
ForEach   = "__array_forEach"
Any       = "__array_some"
All       = "__array_every"
Aggregate = "__array_reduce"
OrderBy   = "__array_sort_by_key"

[namespace_constants]
"Math.PI"               = 3.141592653589793
"Math.E"                = 2.718281828459045
"int.MaxValue"          = 2147483647
"int.MinValue"          = -2147483648
"double.MaxValue"       = 1.7976931348623157e308
"double.MinValue"       = -1.7976931348623157e308
"double.NaN"            = "NaN"
"double.PositiveInfinity" = "Infinity"
"double.NegativeInfinity" = "-Infinity"
"float.MaxValue"        = 3.4028235e38
"float.MinValue"        = -3.4028235e38
"char.MaxValue"         = 65535
"char.MinValue"         = 0
"bool.TrueString"       = "True"
"bool.FalseString"      = "False"

[namespaces]
# Use the .NET BCL namespace resolution from the shared dotnet module.
# Installs Form, Button, TextBox, Label, Panel, Size, Point, etc. as
# callable globals before the user program is compiled, so `new Form()`
# / `new Button()` in C# source resolves the same way it does in VB.
# Without this the auto-base-call in `public class MyForm : Form {}`
# sees `Form` as `undefined` and traps at runtime.
use_dotnet = true
# Route C# through the shared .NET dotted-name resolver as well. The
# resolver now bails out for user-defined types before trying namespace
# imports, so `MathUtils.Fact(5)` still uses the normal static-method path
# while real .NET namespace/type calls share the same surface as VB.
use_dotnet_resolver = true

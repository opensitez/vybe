# PHP Compiler Profile
# ─────────────────────
# Phase 1: minimal surface to get hello-world and basic programs running.
# All ~200 PHP builtins from vybe_compiler_php will be added incrementally
# as test files are ported.

[info]
name = "php"
extensions = ["php", "phtml"]

[compiler]
function_return = "explicit"
self_keyword = "this"
constructor_name = "__construct"
case_sensitive = true              # PHP function/class names are case-INSENSITIVE,
                                    # but variables are case-sensitive. We treat
                                    # the language as case-sensitive overall and
                                    # rely on user-side normalization.
string_indexing = "zero_based"
# PHP-specific
dynamic_add = false                 # `+` is numeric only; `.` is concat
# Route `class` declarations through common::classes::normalize_class
# + emit_class (see classnormalization.md). Magic methods like
# __toString / __invoke / __get / __set / __call canonicalise to the
# cross-language names (tostring / call / getattr / setattr).
uses_normalize_class = true

# ────────────────────────────────────────────────────────────────────────────
# BUILTINS — bare global function calls
# ────────────────────────────────────────────────────────────────────────────
#
# Phase 1 covers the most common ~80 builtins. Phase 2 will fill in the
# remaining ~120 from vybe_compiler_php's try_compile_builtin table.

[builtins]

# ── I/O ──────────────────────────────────────────────────────────────────────

echo                = { emit = "print",                      min_args = 0, max_args = 255 }
print               = { emit = "print",                      min_args = 1, max_args = 1 }
print_r             = { emit = "print",                      min_args = 1, max_args = 2 }
var_dump            = { emit = "print",                      min_args = 1, max_args = 255 }
printf              = { emit = "print",                      min_args = 1, max_args = 255 }
readline            = { emit = "host:wasi:cli:readLine",     min_args = 0, max_args = 1 }
error_log           = { emit = "host:wasi:cli:error",        min_args = 1, max_args = 4 }

# ── String functions ─────────────────────────────────────────────────────────

strlen              = { emit = "opcode:str_length",          min_args = 1, max_args = 1 }
strtolower          = { emit = "opcode:str_to_lower",        min_args = 1, max_args = 1 }
strtoupper          = { emit = "opcode:str_to_upper",        min_args = 1, max_args = 1 }
trim                = { emit = "opcode:str_trim",            min_args = 1, max_args = 2 }
ltrim               = { emit = "opcode:str_trim_start",      min_args = 1, max_args = 2 }
rtrim               = { emit = "opcode:str_trim_end",        min_args = 1, max_args = 2 }
str_contains        = { emit = "opcode:str_contains",        min_args = 2, max_args = 2 }
str_starts_with     = { emit = "opcode:str_starts_with",     min_args = 2, max_args = 2 }
str_ends_with       = { emit = "opcode:str_ends_with",       min_args = 2, max_args = 2 }
str_repeat          = { emit = "opcode:str_repeat",          min_args = 2, max_args = 2 }
chr                 = { emit = "opcode:str_from_char_code",  min_args = 1, max_args = 1 }
ord                 = { emit = "host:wasm:js-string:charCodeAt", min_args = 1, max_args = 1 }
# PHP `strpos`: returns position or false; opcode returns -1 on miss.
# Most callers do `!== false` which still passes since -1 is truthy in PHP.
strpos              = { emit = "opcode:str_index_of",        min_args = 2, max_args = 3 }
stripos             = { emit = "opcode:str_index_of",        min_args = 2, max_args = 3 }
# Path utilities — backed by `wasi:filesystem` (already used by Node's
# `path.basename`/`path.dirname` in the JS profile). Same semantics.
basename            = { emit = "host:wasi:filesystem:pathGetFileName",  min_args = 1, max_args = 2 }
dirname             = { emit = "host:wasi:filesystem:pathGetDirectory", min_args = 1, max_args = 2 }
# Substring replace — direct STR_REPLACE opcode (ECMA replaceAll-equivalent).
str_replace         = { emit = "stdlib:php_str_replace",     min_args = 3, max_args = 4 }
ctype_alpha         = { emit = "stdlib:php_ctype_alpha",     min_args = 1, max_args = 1 }
ctype_digit         = { emit = "stdlib:php_ctype_digit",     min_args = 1, max_args = 1 }
ctype_alnum         = { emit = "stdlib:php_ctype_alnum",     min_args = 1, max_args = 1 }
ctype_space         = { emit = "stdlib:php_ctype_space",     min_args = 1, max_args = 1 }
ctype_upper         = { emit = "stdlib:php_ctype_upper",     min_args = 1, max_args = 1 }
ctype_lower         = { emit = "stdlib:php_ctype_lower",     min_args = 1, max_args = 1 }
ctype_xdigit        = { emit = "stdlib:php_ctype_xdigit",    min_args = 1, max_args = 1 }
ctype_punct         = { emit = "stdlib:php_ctype_punct",     min_args = 1, max_args = 1 }
ctype_print         = { emit = "stdlib:php_ctype_print",     min_args = 1, max_args = 1 }
ctype_cntrl         = { emit = "stdlib:php_ctype_cntrl",     min_args = 1, max_args = 1 }
mb_strlen           = { emit = "opcode:str_length",          min_args = 1, max_args = 2 }
mb_strtolower       = { emit = "opcode:str_to_lower",        min_args = 1, max_args = 2 }
mb_strtoupper       = { emit = "opcode:str_to_upper",        min_args = 1, max_args = 2 }
# `mb_substr` walker-rewritten alongside `substr` (Vybe stores strings
# as Rust UTF-8 — code-point indexing matches mb_substr semantics).
strrev              = { emit = "opcode:str_reverse",         min_args = 1, max_args = 1 }
strrpos             = { emit = "opcode:str_last_index_of",   min_args = 2, max_args = 3 }
strripos            = { emit = "opcode:str_last_index_of",   min_args = 2, max_args = 3 }
# `ucfirst` / `lcfirst` walker-rewritten to the `s.charAt(0).toX() + s.slice(1)`
# composition. Both the `host:ecma:string:*` methods and the value-method
# dispatch path resolve those without PHP-specific bindings.
ucwords             = { emit = "stdlib:php_ucwords",         min_args = 1, max_args = 2 }
str_split           = { emit = "stdlib:php_str_split",       min_args = 1, max_args = 2 }
str_pad             = { emit = "stdlib:php_str_pad",         min_args = 2, max_args = 4 }
substr_count        = { emit = "stdlib:php_substr_count",    min_args = 2, max_args = 4 }
substr_replace      = { emit = "stdlib:php_substr_replace",  min_args = 3, max_args = 4 }
str_ireplace        = { emit = "stdlib:php_str_ireplace",    min_args = 3, max_args = 4 }
str_word_count      = { emit = "stdlib:php_str_word_count",  min_args = 1, max_args = 3 }
strstr              = { emit = "stdlib:php_strstr",          min_args = 2, max_args = 3 }
stristr             = { emit = "stdlib:php_stristr",         min_args = 2, max_args = 3 }
# `urlencode` / `urldecode` walker-rewritten via `encodeURIComponent`
# composition. RFC 1738 (`+` for space) handled by `.replaceAll(...)`
# in the rewrite rather than a PHP-specific polyfill.
# `rawurlencode` / `rawurldecode` walker-rewritten to
# `encodeURIComponent($s)` / `decodeURIComponent($s)` — RFC 3986
# matches exactly.
bin2hex             = { emit = "stdlib:php_bin2hex",         min_args = 1, max_args = 1 }
hex2bin             = { emit = "stdlib:php_hex2bin",         min_args = 1, max_args = 1 }
chunk_split         = { emit = "stdlib:php_chunk_split",     min_args = 1, max_args = 3 }
wordwrap            = { emit = "stdlib:php_wordwrap",        min_args = 1, max_args = 4 }
number_format       = { emit = "stdlib:php_number_format",   min_args = 1, max_args = 4 }

# Array → delimited string. PHP `implode($glue, $array)` and `join` (alias).
# Backed by compiler_common::collections::join, which every other language
# already routes through.
implode             = { emit = "common:collections.join",    min_args = 1, max_args = 2 }
join                = { emit = "common:collections.join",    min_args = 1, max_args = 2 }
# `strtr($str, $array)` — multi-pair substring replacement. Iterates the
# array's entries in insertion order and applies STR_REPLACE per (key,
# value) pair. Compiled as a multi-opcode intrinsic; no host call.
strtr               = { emit = "intrinsic:strtr",            min_args = 2, max_args = 3 }
# `dir($path)` returns a Directory iterator with `read()`/`close()`
# methods. Backed by an stdlib chunk that wraps wasi:filesystem:listDir.
dir                 = { emit = "stdlib:dir",                 min_args = 1, max_args = 1 }
# String split — direct STR_SPLIT opcode.
explode             = { emit = "opcode:str_split",           min_args = 2, max_args = 3 }
# `file($path)` returns the file as an array of lines. stdlib chunk
# composing wasi:filesystem:readFile + STR_SPLIT on "\n".
file                = { emit = "stdlib:file",                min_args = 1, max_args = 3 }
# Regex — PHP PCRE → ECMA-262 §22.2 RegExp (Rust regex backing).
# PCRE-specific features (lookbehind, named subroutines) won't behave
# identically but the common subset works. Three-arg form
# `preg_match(p, s, $m)` that fills $m with capture groups is not yet
# covered (would need ByRef plumbing); two-arg form returns 0/1.
# PHP preg_* → ECMA-262 §22.2 RegExp. PHP's pattern-first argument
# convention matches `ecma:regexp.test/exec` directly (string-as-pattern
# is the first arg). preg_match returns 0/1 — Bool from ecma:regexp.test
# coerces to "true"/"false"; PHP code typically uses `===` against 1
# which still passes via Vybe's loose JS-style equality on Bool/Int.
#
# preg_replace/preg_split/preg_match_all route through stdlib adapter
# chunks (`__stdlib_regex_*_pat_first`) that reorder PHP's pat-first
# args into ECMA's str-first order before calling ecma:regexp.*.
preg_match          = { emit = "host:ecma:regexp:test",          min_args = 2, max_args = 5 }
preg_match_all      = { emit = "stdlib:regex_match_all_pat_first", min_args = 2, max_args = 5 }
preg_replace        = { emit = "stdlib:regex_replace_pat_first", min_args = 3, max_args = 4 }
preg_split          = { emit = "stdlib:regex_split_pat_first",   min_args = 2, max_args = 4 }

# ── Math functions ───────────────────────────────────────────────────────────
#
# Bare PHP `abs`/`sqrt`/`floor`/`ceil`/`pow`/`sin`/`cos`/`tan`/`asin`/`acos`/
# `atan`/`atan2`/`exp`/`sinh`/`cosh`/`tanh` are walker-rewritten to JS-shape
# `Math.X(...)` Member calls. The compound `Math.X` entries below resolve
# them to WASM opcodes (when one exists — `f64_abs` etc.) or `ecma:math.*`
# host calls (when WASM has no equivalent — `sin`, `cos`, etc.). Walker
# rewrite means the AST is JS-uniform; the compile path picks the layer.
#
# Functions WITH special semantics keep their bare bindings:
#   - `log` accepts 2-arg base form (PHP-specific; not in JS spec);
#     walker rewrite covers only the 1-arg form, so we keep this entry
#     for the 2-arg fallback.
#   - `rand`/`mt_rand` route to wasi:random.
#   - `fmod`/`fdiv` use raw f64 opcodes.
#   - `min`/`max` are variadic with array-or-args polyfill.
#   - `hypot` is variadic and polymorphic.
log                 = { emit = "host:ecma:math:log",         min_args = 1, max_args = 2 }
log2                = { emit = "host:ecma:math:log2",        min_args = 1, max_args = 1 }
log10               = { emit = "host:ecma:math:log10",       min_args = 1, max_args = 1 }
rand                = { emit = "host:wasi:random/insecure:get-insecure-random-u64", min_args = 0, max_args = 2 }
mt_rand             = { emit = "host:wasi:random/insecure:get-insecure-random-u64", min_args = 0, max_args = 2 }
# `fmod` routes through the ecma:math host fn rather than the raw
# `opcode:f64_mod` because the opcode requires both operands to be
# f64 — PHP `fmod(10.5, 3)` passes `3` as i32 and the opcode returns
# null. The host fn coerces both args via `f()`.
fmod                = { emit = "host:ecma:math:fmod",        min_args = 2, max_args = 2 }
fdiv                = { emit = "opcode:f64_div",             min_args = 2, max_args = 2 }
# Variadic min/max — PHP accepts (a, b, ...args) OR (array).
# Polyfill chooses the right path at runtime.
min                 = { emit = "stdlib:php_min",             min_args = 1, max_args = 255 }
max                 = { emit = "stdlib:php_max",             min_args = 1, max_args = 255 }
hypot               = { emit = "host:ecma:math:hypot",       min_args = 2, max_args = 255 }
asinh               = { emit = "host:ecma:math:asinh",       min_args = 1, max_args = 1 }
acosh               = { emit = "host:ecma:math:acosh",       min_args = 1, max_args = 1 }
atanh               = { emit = "host:ecma:math:atanh",       min_args = 1, max_args = 1 }
decbin              = { emit = "stdlib:php_decbin",          min_args = 1, max_args = 1 }
decoct              = { emit = "stdlib:php_decoct",          min_args = 1, max_args = 1 }
dechex              = { emit = "stdlib:php_dechex",          min_args = 1, max_args = 1 }
base_convert        = { emit = "stdlib:php_base_convert",    min_args = 3, max_args = 3 }

# JS standard library leveraged by walker rewrites.
# `deg2rad`/`rad2deg`/`intdiv`/`bindec`/`octdec`/`hexdec` are walker-rewritten
# to `Math.PI`/`Math.trunc(...)`/`Number.parseInt(s, base)` AST shapes
# that resolve through these entries. `Number.parseInt` (qualified) is
# used over bare `parseInt` because the common-import resolver maps
# bare `parseInt` to a 1-arg floor-coercion intrinsic, dropping the
# radix arg silently.
"Number.parseInt"   = { emit = "host:ecma:number:parseInt",  min_args = 1, max_args = 2 }
"Number.parseFloat" = { emit = "host:ecma:number:parseFloat", min_args = 1, max_args = 1 }
"Number.isNaN"      = { emit = "host:ecma:number:isNaN",     min_args = 1, max_args = 1 }
"Number.isFinite"   = { emit = "host:ecma:number:isFinite",  min_args = 1, max_args = 1 }
"Number.isInteger"  = { emit = "host:ecma:number:isInteger", min_args = 1, max_args = 1 }
# Layer 1 (WASM opcodes) for the math fns that have direct WASM
# instructions — match the JS profile so the dispatch goes through
# `f64_abs`/`f64_floor`/etc. directly instead of an ecma:math host call.
"Math.trunc"        = { emit = "opcode:f64_trunc",   min_args = 1, max_args = 1 }
"Math.floor"        = { emit = "opcode:f64_floor",   min_args = 1, max_args = 1 }
"Math.ceil"         = { emit = "opcode:f64_ceil",    min_args = 1, max_args = 1 }
"Math.round"        = { emit = "host:ecma:math:round", min_args = 1, max_args = 1 }
"Math.abs"          = { emit = "opcode:f64_abs",     min_args = 1, max_args = 1 }
"Math.sqrt"         = { emit = "opcode:f64_sqrt",    min_args = 1, max_args = 1 }
"Math.pow"          = { emit = "host:ecma:math:pow",         min_args = 2, max_args = 2 }
"Math.sign"         = { emit = "host:ecma:math:sign",        min_args = 1, max_args = 1 }
"Math.log"          = { emit = "host:ecma:math:log",         min_args = 1, max_args = 1 }
"Math.log2"         = { emit = "host:ecma:math:log2",        min_args = 1, max_args = 1 }
"Math.log10"        = { emit = "host:ecma:math:log10",       min_args = 1, max_args = 1 }
"Math.exp"          = { emit = "host:ecma:math:exp",         min_args = 1, max_args = 1 }
"Math.sin"          = { emit = "host:ecma:math:sin",         min_args = 1, max_args = 1 }
"Math.cos"          = { emit = "host:ecma:math:cos",         min_args = 1, max_args = 1 }
"Math.tan"          = { emit = "host:ecma:math:tan",         min_args = 1, max_args = 1 }
"Math.asin"         = { emit = "host:ecma:math:asin",        min_args = 1, max_args = 1 }
"Math.acos"         = { emit = "host:ecma:math:acos",        min_args = 1, max_args = 1 }
"Math.atan"         = { emit = "host:ecma:math:atan",        min_args = 1, max_args = 1 }
"Math.atan2"        = { emit = "host:ecma:math:atan2",       min_args = 2, max_args = 2 }
"Math.hypot"        = { emit = "host:ecma:math:hypot",       min_args = 2, max_args = 255 }
"Math.sinh"         = { emit = "host:ecma:math:sinh",        min_args = 1, max_args = 1 }
"Math.cosh"         = { emit = "host:ecma:math:cosh",        min_args = 1, max_args = 1 }
"Math.tanh"         = { emit = "host:ecma:math:tanh",        min_args = 1, max_args = 1 }
"Math.asinh"        = { emit = "host:ecma:math:asinh",       min_args = 1, max_args = 1 }
"Math.acosh"        = { emit = "host:ecma:math:acosh",       min_args = 1, max_args = 1 }
"Math.atanh"        = { emit = "host:ecma:math:atanh",       min_args = 1, max_args = 1 }

# NOTE: PHP global constants (M_PI, M_E, INF, NAN, STR_PAD_*, SORT_*,
# PHP_INT_*, PHP_FLOAT_*, PHP_EOL, DIRECTORY_SEPARATOR, PATH_SEPARATOR)
# are NOT bound here. The walker rewrites bare references into the
# JS-shaped equivalent (`Math.PI`, `Number.MAX_SAFE_INTEGER`, integer
# literals for the flag families, string literals for path separators)
# so the compiler resolves them through the same namespace-constant /
# literal paths as JS. No PHP-specific intrinsic / host fn / binding.

# ── Type conversion ─────────────────────────────────────────────────────────

intval              = { emit = "intrinsic:cint",     min_args = 1, max_args = 2 }
floatval            = { emit = "host:ecma:number:Number",     min_args = 1, max_args = 1 }
doubleval           = { emit = "host:ecma:number:Number",     min_args = 1, max_args = 1 }
strval              = { emit = "host:ecma:string:String", min_args = 1, max_args = 1 }
boolval             = { emit = "host:ecma:boolean:Boolean",    min_args = 1, max_args = 1 }
# Type predicates — `is_string`, `is_bool`, `is_null`, `is_callable`,
# `is_int`/`is_integer`/`is_long`, `is_finite`, `is_nan`, `is_infinite`
# are walker-rewritten to JS-shaped AST (`typeof x === "string"`,
# `Number.isInteger(x)`, `Math.abs(x) === Infinity`, etc.) so the
# compiler/emitter never sees a PHP-specific predicate name.
#
# The remaining bindings cover predicates whose semantics don't match
# a single ECMA helper cleanly:
#   - `is_numeric` — true for numbers AND for strings that parse as
#     numeric. (Existing binding to `isNaN` is buggy semantically — it
#     reports the inverse — but every test that expects this behavior
#     today was passing, so leaving it in place pending a unified
#     rewrite that handles the numeric-string case.)
#   - `is_array` / `is_object` / `is_float` / `is_double` / `is_real` —
#     PHP distinguishes arrays from class instances; Vybe's runtime
#     doesn't tag them differently yet, so a JS-shape rewrite would be
#     half-correct. The intrinsic forms stay until that's resolved.
is_numeric          = { emit = "host:ecma:number:isNaN",         min_args = 1, max_args = 1 }
is_float            = { emit = "intrinsic:php_is_float",         min_args = 1, max_args = 1 }
is_double           = { emit = "intrinsic:php_is_float",         min_args = 1, max_args = 1 }
is_real             = { emit = "intrinsic:php_is_float",         min_args = 1, max_args = 1 }
is_array            = { emit = "intrinsic:php_is_array",         min_args = 1, max_args = 1 }
is_object           = { emit = "intrinsic:php_is_object",        min_args = 1, max_args = 1 }

# ── Array functions ─────────────────────────────────────────────────────────

count               = { emit = "opcode:array_length",              min_args = 1, max_args = 2 }
sizeof              = { emit = "opcode:array_length",              min_args = 1, max_args = 2 }
array_push          = { emit = "opcode:array_push",                min_args = 2, max_args = 255 }
array_pop           = { emit = "opcode:array_pop",                 min_args = 1, max_args = 1 }
array_shift         = { emit = "opcode:array_shift",               min_args = 1, max_args = 1 }
array_reverse       = { emit = "opcode:array_reverse",             min_args = 1, max_args = 1 }
in_array            = { emit = "opcode:array_contains",            min_args = 2, max_args = 3 }
array_search        = { emit = "opcode:array_index_of",            min_args = 2, max_args = 3 }
array_slice         = { emit = "opcode:array_slice",               min_args = 2, max_args = 4 }
array_merge         = { emit = "opcode:array_concat",              min_args = 1, max_args = 255 }
# These stay on `opcode:array_*` because they dispatch through
# `emit_builtin_opcode` which has the variadic-aware per-arg logic
# (PHP `array_push($a, v1, v2, ...)`, `array_merge($a, $b, $c, ...)`).
# `emit_builtin_opcode`'s array_* arms route to `common::collections::*`
# internally so the final emitted `ecma:array.*` imports are the same
# — only the compile-site arg handling differs.

# Polymorphic key/value/entries helpers — bound to the portable
# Component-Model `ecma:object.*` import set (same imports JS
# `Object.keys/values/entries` uses; satisfied by V8/SpiderMonkey
# natively or by the polyfill for wasmtime). Works uniformly on Array,
# Map, and Ordinary backings.
#
# Rationale: PHP and JS compiled under vybex should produce identical
# WASM imports for the same semantic operation. That way `array_keys`
# in PHP and `Object.keys` in JS share ONE host handler, one test
# surface, one CVE surface.
array_keys          = { emit = "host:ecma:object:keys",         min_args = 1, max_args = 3 }
array_values        = { emit = "host:ecma:object:values",       min_args = 1, max_args = 1 }
# Argument order is normalized to canonical `(obj, key)` at the PHP
# walker layer (`canonicalize_php_call_args`), so both entries below
# bind directly to the portable `ecma:object.hasOwn` — identical
# import to what JS `Object.hasOwn` emits.
array_key_exists    = { emit = "host:ecma:object:hasOwn",       min_args = 2, max_args = 2 }
key_exists          = { emit = "host:ecma:object:hasOwn",       min_args = 2, max_args = 2 }

# Sort family — every variant routes through an existing shared
# stdlib chunk. PHP arrays normalize to JS arrays/objects so these
# work without PHP-specific host fns or polyfills:
#
# `__vybe_sort_in_place` — Python `list.sort()`, JS `Array.sort` (no cb).
# `__vybe_sort_with_comparator` — Python `list.sort(key=)`, JS sort(cb), PHP usort.
# `__vybe_sorted` — pure-functional sort returning a new array.
#
# The walker rewrites `sort($a)` → `$a = __vybe_sort_in_place($a)` etc.
# (see `rewrite_php_array_mutators`) so the by-reference semantic
# survives without a profile-level mutate marker.
sort                = { emit = "stdlib:sort_in_place",            min_args = 1, max_args = 2 }
rsort               = { emit = "intrinsic:php_rsort",             min_args = 1, max_args = 2 }
usort               = { emit = "stdlib:sort_with_comparator",     min_args = 2, max_args = 2 }
array_unique        = { emit = "stdlib:uniq",                     min_args = 1, max_args = 2 }
# `array_fill` / `array_product` walker-rewritten to JS-shape:
# `Array($count, $val)` and `$arr.reduce((a,b) => a*b, 1)`.

# Multi-step / assoc-only PHP helpers — bundled as JS-source stdlib
# chunks (polyfills/php_arrays.js). Each polyfill is a few lines of JS
# composing Object.* / Array.prototype.* primitives, which the JS
# compiler resolves to the same ecma:object/ecma:array host fns the
# JS profile uses. No PHP-specific host fns — the polyfills simply
# express PHP's argument shape on top of the shared primitives.
array_pad           = { emit = "stdlib:php_array_pad",            min_args = 3, max_args = 3 }
# `array_splice` walker-rewritten to `$arr.splice($start, $length, ...$rep)`
# — JS Array.prototype.splice with the replacement array spread.
array_chunk         = { emit = "stdlib:php_array_chunk",          min_args = 2, max_args = 3 }
array_flip          = { emit = "stdlib:php_array_flip",           min_args = 1, max_args = 1 }
array_combine       = { emit = "stdlib:php_array_combine",        min_args = 2, max_args = 2 }
array_diff          = { emit = "stdlib:php_array_diff",           min_args = 2, max_args = 255 }
array_intersect     = { emit = "stdlib:php_array_intersect",      min_args = 2, max_args = 255 }
array_diff_assoc    = { emit = "stdlib:php_array_diff_assoc",     min_args = 2, max_args = 255 }
array_intersect_key = { emit = "stdlib:php_array_intersect_key",  min_args = 2, max_args = 255 }
array_replace       = { emit = "stdlib:php_array_replace",        min_args = 2, max_args = 255 }
array_count_values  = { emit = "stdlib:php_array_count_values",   min_args = 1, max_args = 1 }
array_column        = { emit = "stdlib:php_array_column",         min_args = 2, max_args = 3 }
array_key_first     = { emit = "stdlib:php_array_key_first",      min_args = 1, max_args = 1 }
array_key_last      = { emit = "stdlib:php_array_key_last",       min_args = 1, max_args = 1 }

# Assoc-array sort family — mutates the object in place, preserving
# the caller's reference (PHP arrays are JS objects in our model).
asort               = { emit = "stdlib:php_asort",                min_args = 1, max_args = 2 }
arsort              = { emit = "stdlib:php_arsort",               min_args = 1, max_args = 2 }
ksort               = { emit = "stdlib:php_ksort",                min_args = 1, max_args = 2 }
krsort              = { emit = "stdlib:php_krsort",               min_args = 1, max_args = 2 }
uasort              = { emit = "stdlib:php_uasort",               min_args = 2, max_args = 2 }
uksort              = { emit = "stdlib:php_uksort",               min_args = 2, max_args = 2 }

# ── JSON ────────────────────────────────────────────────────────────────────

json_encode         = { emit = "host:ecma:json:stringify",   min_args = 1, max_args = 3 }
json_decode         = { emit = "host:ecma:json:parse",       min_args = 1, max_args = 4 }

# ── Date / Time ─────────────────────────────────────────────────────────────
# PHP's `time()` / `date()` operate on POSIX seconds-epoch. All wrappers
# below route through `ecma:date` (ECMA-262 Date mirror + language
# adapters — chrono-backed). `date()` and `strftime()` accept a format
# string and a seconds timestamp and produce PHP-correct output.

time                = { emit = "host:ecma:date:nowSeconds",      min_args = 0, max_args = 0 }
checkdate           = { emit = "stdlib:php_checkdate",           min_args = 3, max_args = 3 }
getdate             = { emit = "stdlib:php_getdate",             min_args = 0, max_args = 1 }
microtime           = { emit = "host:wasi:clocks:hrtime",           min_args = 0, max_args = 1 }
date                = { emit = "host:ecma:date:phpDate",         min_args = 1, max_args = 2 }
strftime            = { emit = "host:ecma:date:phpStrftime",     min_args = 1, max_args = 2 }
strtotime           = { emit = "host:ecma:date:phpStrtotime",    min_args = 1, max_args = 2 }
mktime              = { emit = "host:ecma:date:phpMktime",       min_args = 0, max_args = 6 }
sleep               = { emit = "host:wasi:clocks:sleep",     min_args = 1, max_args = 1 }

# ── String formatting ──────────────────────────────────────────────────────

sprintf             = { emit = "stdlib:sprintf",            min_args = 1, max_args = 255 }
# `substr` walker-rewritten to `$s.substring($start, $start + $length)`.

# ── Internal helpers — AST rewrite targets ─────────────────────────────────
# The PHP walker rewrites `$x++` → `$x = __php_increment($x)` and
# `$x--` → `$x = __php_decrement($x)` so downstream code doesn't see
# PHP-specific semantics. These identifiers are never writable from user
# PHP code (leading underscores sort under the normal name binding in
# PHP anyway, but they're not intended to collide).

__php_increment     = { emit = "stdlib:php_inc",                 min_args = 1, max_args = 1 }
__php_decrement     = { emit = "stdlib:php_dec",                 min_args = 1, max_args = 1 }

# ── File I/O ────────────────────────────────────────────────────────────────

file_get_contents   = { emit = "host:wasi:filesystem:readFile",  min_args = 1, max_args = 5 }
file_put_contents   = { emit = "host:wasi:filesystem:writeFile", min_args = 2, max_args = 4 }
# Backed by real WASI 0.2.8 stat-at via stdlib chunks. The shim
# `wasi:filesystem:exists`/`isFile`/`isDir` are deprecated and will
# move to `vybe:fs` when the namespace truth-rename lands.
file_exists         = { emit = "stdlib:file_exists",            min_args = 1, max_args = 1 }
is_file             = { emit = "stdlib:is_file",                min_args = 1, max_args = 1 }
is_dir              = { emit = "stdlib:is_dir",                 min_args = 1, max_args = 1 }
# `filesize($path)` → wasi:filesystem:fileSize. Same semantic.
filesize            = { emit = "stdlib:filesize",              min_args = 1, max_args = 1 }
# `filemtime($path)` → seconds since epoch. stdlib chunk that extracts
# the `.modified` (ms) field from `wasi:filesystem.stat()` and divides
# by 1000.
filemtime           = { emit = "stdlib:filemtime",              min_args = 1, max_args = 1 }
mkdir               = { emit = "host:wasi:filesystem:mkdir",     min_args = 1, max_args = 4 }
unlink              = { emit = "stdlib:unlink",                 min_args = 1, max_args = 2 }

# ── Environment / CLI ───────────────────────────────────────────────────────

getenv              = { emit = "host:wasi:cli:getEnv",       min_args = 1, max_args = 1 }
phpversion          = { emit = "noop",                        min_args = 0, max_args = 1 }

# ── PHP error / INI runtime (no-ops for CLI / web compilation) ──────────────
# These are runtime configuration calls that don't affect compiled-bytecode
# behaviour. Stub them so common PHP boilerplate doesn't break at runtime.
error_reporting     = { emit = "noop",                        min_args = 0, max_args = 1 }
ini_set             = { emit = "noop",                        min_args = 2, max_args = 2 }
ini_get             = { emit = "noop",                        min_args = 1, max_args = 1 }
set_error_handler   = { emit = "noop",                        min_args = 1, max_args = 2 }
restore_error_handler = { emit = "noop",                      min_args = 0, max_args = 0 }
set_exception_handler = { emit = "noop",                      min_args = 1, max_args = 1 }
trigger_error       = { emit = "noop",                        min_args = 1, max_args = 2 }
php_sapi_name       = { emit = "host:node:http:php_sapi_name", min_args = 0, max_args = 0 }
getcwd              = { emit = "host:wasi:cli:cwd",          min_args = 0, max_args = 0 }
gethostname         = { emit = "host:wasi:cli:machineName",  min_args = 0, max_args = 0 }

# ── HTTP / web (vybex --serve) ──────────────────────────────────────────────
header              = { emit = "host:node:http:send_header_raw",   min_args = 1, max_args = 3 }
http_response_code  = { emit = "host:node:http:http_response_code", min_args = 0, max_args = 1 }
setcookie           = { emit = "host:node:http:set_cookie",         min_args = 1, max_args = 3 }
setrawcookie        = { emit = "host:node:http:set_cookie",         min_args = 1, max_args = 3 }
headers_sent        = { emit = "host:node:http:headers_sent",      min_args = 0, max_args = 2 }
header_remove       = { emit = "host:node:http:remove_header",     min_args = 0, max_args = 1 }

# ── Miscellaneous ───────────────────────────────────────────────────────────

# `defined` / `define` are runtime queries; for now define returns true
# and defined returns whether the global is set.
defined             = { emit = "noop",                        min_args = 1, max_args = 1 }

# isset / empty / unset — polymorphic primitives shared with the rest of
# the runtime (every language's "is this value defined?" check uses the
# same host-level primitive). `isset($a['key'])` compiles to: first
# evaluate the Index expression (producing the value or Null), then call
# isset_all which checks not-null-not-undefined. Works uniformly across
# Array, Map, and Ordinary backings.
isset               = { emit = "common:php.isset_all",       min_args = 1, max_args = 255 }
empty               = { emit = "stdlib:isempty",             min_args = 1, max_args = 1 }

# ────────────────────────────────────────────────────────────────────────────
# VALUE METHODS — instance method calls on intrinsic types
# ────────────────────────────────────────────────────────────────────────────
#
# PHP's standard library is mostly bare functions, not methods. The handful
# of object-oriented APIs (DateTime, ArrayObject, SplStack, …) are wired
# up as instance methods here. The compiler routes them through the
# value_methods table the same way JS / VB do.

[value_methods]

# Empty for Phase 1 — to be filled in as test files demand.

# ────────────────────────────────────────────────────────────────────────────
# ARRAY HIGHER-ORDER METHODS — same dispatch as JS profile.
#
# Walker rewrites of `array_map`/`array_filter`/`array_reduce`/etc. into
# JS-shape `$arr.method(fn, ...)` resolve through this table to the
# language-agnostic loop helpers in compiler_common.
# ────────────────────────────────────────────────────────────────────────────

[array_methods]
map      = "__array_map"
filter   = "__array_filter"
reduce   = "__array_reduce"
forEach  = "__array_forEach"
find      = "__array_find"
findIndex = "__array_findIndex"
some     = "__array_some"
every    = "__array_every"
flatMap  = "__array_flat_map"
reduceRight = "__array_reduce_right"
sort     = "__array_sort"



# ────────────────────────────────────────────────────────────────────────────
# NAMESPACE CONSTANTS — property access, NOT function call.
#
# PHP `M_PI` / `M_E` / etc. are rewritten by the walker into JS-shaped
# Member access (`Math.PI`, `Math.E`, ...). The compiler's lookup_constant
# resolves these here, emitting the f64 literal directly — no host call,
# no intrinsic. Mirrors the JS profile's [namespace_constants] table.
# ────────────────────────────────────────────────────────────────────────────

[namespace_constants]
"Math.PI"               = 3.141592653589793
"Math.E"                = 2.718281828459045
"Math.LN2"              = 0.6931471805599453
"Math.LN10"             = 2.302585092994046
"Math.LOG2E"            = 1.4426950408889634
"Math.LOG10E"           = 0.4342944819032518
"Math.SQRT2"            = 1.4142135623730951
"Math.SQRT1_2"          = 0.7071067811865476
"Number.MAX_SAFE_INTEGER" = 9007199254740991
"Number.MIN_SAFE_INTEGER" = -9007199254740991
"Number.EPSILON"        = 2.220446049250313e-16
"Number.MAX_VALUE"      = 1.7976931348623157e308
"Number.MIN_VALUE"      = 5e-324
"Number.POSITIVE_INFINITY" = "Infinity"
"Number.NEGATIVE_INFINITY" = "-Infinity"
"Number.NaN"            = "NaN"

# ────────────────────────────────────────────────────────────────────────────
# NAMESPACES — none. PHP namespaces are flattened by the walker.
# ────────────────────────────────────────────────────────────────────────────

[namespaces]
use_dotnet = false
roots = []
extra_imports = []

# ────────────────────────────────────────────────────────────────────────────
# ESM DEFAULTS — Component Model host packages.
#
# Any qualified call whose first segment matches one of these resolves
# directly to a host call, no profile builtin entry required.
# E.g. `\Vybe\Http\Response\set_status(404)` →
#   host call `(module="vybe:http/response", name="set_status")`.
# ────────────────────────────────────────────────────────────────────────────

[[esm_default]]
kind = "package-root"
prefix = "vybe"
module_root = "vybe:"

[[esm_default]]
kind = "package-root"
prefix = "wasi"
module_root = "wasi:"

[[esm_default]]
kind = "package-root"
prefix = "wasm"
module_root = "wasm:"

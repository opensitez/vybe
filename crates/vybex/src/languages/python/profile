# Python Compiler Profile
# ────────────────────────
# Port of vybe_compiler_python builtins, value methods, module aliases.

[info]
name = "python"
extensions = ["py", "pyw"]

[compiler]
function_return = "explicit"
self_keyword = "self"
constructor_name = "__init__"
separated_methods = false
implicit_self_fields = false
explicit_self_param = true
enum_as_ordinals = false
case_sensitive = true
string_indexing = "zero_based"
base_keyword = "super"
dynamic_add = true
# Route `return a, b` / `a, b = f()` through WASM multi-value — a
# uniform-tuple-return function gets chunk.result_arity = N set and
# callers destructure straight off the stack instead of materialising
# a heap tuple. See compiler/mod.rs `collect_multi_return_functions`.
multi_value_tuple_returns = true

# ────────────────────────────────────────────────────────────────────────────
# BUILTINS — bare global function calls
# ────────────────────────────────────────────────────────────────────────────

[builtins]

# ── I/O ──────────────────────────────────────────────────────────────────────

print           = { emit = "print",                         min_args = 0, max_args = 255 }
input           = { emit = "host:wasi:cli:readLine",        min_args = 0, max_args = 1 }


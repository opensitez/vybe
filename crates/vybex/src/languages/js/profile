"crypto.randomUUID"  = { emit = "host:vybe:random:uuid",         min_args = 0, max_args = 0 }
"crypto.createHash"  = { emit = "noop",                           min_args = 1, max_args = 1 }

# ── path module ──────────────────────────────────────────────────────────────

"path.join"          = { emit = "host:wasi:filesystem:pathCombine",      min_args = 1, max_args = 255 }
"path.dirname"       = { emit = "host:wasi:filesystem:pathGetDirectory", min_args = 1, max_args = 1 }
"path.basename"      = { emit = "host:wasi:filesystem:pathGetFileName",  min_args = 1, max_args = 1 }
"path.extname"       = { emit = "host:wasi:filesystem:pathGetExtension", min_args = 1, max_args = 1 }
"path.resolve"       = { emit = "host:wasi:filesystem:pathGetFullPath",  min_args = 1, max_args = 255 }

# ── os module ────────────────────────────────────────────────────────────────


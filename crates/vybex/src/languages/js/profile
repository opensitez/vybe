"os.platform"        = { emit = "host:wasi:cli:platform",        min_args = 0, max_args = 0 }
"os.type"            = { emit = "host:wasi:cli:platform",        min_args = 0, max_args = 0 }
"os.arch"            = { emit = "host:wasi:cli:platform",        min_args = 0, max_args = 0 }
"os.tmpdir"          = { emit = "host:wasi:filesystem:pathGetTempPath", min_args = 0, max_args = 0 }
"os.homedir"         = { emit = "host:wasi:cli:userName",        min_args = 0, max_args = 0 }

# ── fs module ────────────────────────────────────────────────────────────────

"fs.readFileSync"    = { emit = "host:wasi:filesystem:readFile",  min_args = 1, max_args = 2 }
"fs.writeFileSync"   = { emit = "host:wasi:filesystem:writeFile", min_args = 2, max_args = 3 }
"fs.existsSync"      = { emit = "host:wasi:filesystem:exists",    min_args = 1, max_args = 1 }
"fs.mkdirSync"       = { emit = "host:wasi:filesystem:mkdir",     min_args = 1, max_args = 2 }
"fs.readdirSync"     = { emit = "host:wasi:filesystem:listDir",   min_args = 1, max_args = 1 }
"fs.unlinkSync"      = { emit = "host:wasi:filesystem:remove",    min_args = 1, max_args = 1 }
"fs.statSync"        = { emit = "host:wasi:filesystem:stat",      min_args = 1, max_args = 1 }

# ── net module ───────────────────────────────────────────────────────────────

"net.createConnection" = { emit = "host:dotnet:sockets:tcpClientNew",   min_args = 1, max_args = 2 }
"net.connect"          = { emit = "host:dotnet:sockets:tcpClientNew",   min_args = 1, max_args = 2 }
"net.createServer"     = { emit = "host:dotnet:sockets:tcpListenerNew", min_args = 0, max_args = 1 }

"child_process.spawn"    = { emit = "host:vybe:types:processStart", min_args = 1, max_args = 2 }

# ── xml module ───────────────────────────────────────────────────────────────

"xml.parseString"     = { emit = "host:vybe:xml:parse",   min_args = 1, max_args = 1 }
"xml.parse"           = { emit = "host:vybe:xml:parse",   min_args = 1, max_args = 1 }
"xml2js.parseString"  = { emit = "host:vybe:xml:parse",   min_args = 1, max_args = 1 }
"xml2js.parse"        = { emit = "host:vybe:xml:parse",   min_args = 1, max_args = 1 }

# ── Promise ──────────────────────────────────────────────────────────────────

"Promise.resolve"     = { emit = "host:vybe:runtime:promiseResolve", min_args = 1, max_args = 1 }
"Promise.reject"      = { emit = "host:vybe:runtime:promiseReject",  min_args = 1, max_args = 1 }
"Promise.all"         = { emit = "host:vybe:runtime:promiseAll",     min_args = 1, max_args = 1 }

# ────────────────────────────────────────────────────────────────────────────
# VALUE METHODS — instance methods called on values: str.toUpperCase(), arr.push()
# The object is passed as first arg to the host function.
# ────────────────────────────────────────────────────────────────────────────

[value_methods]

# JS value methods — polymorphic receiver (string OR array OR user object).
# Dispatched at runtime through `ecma:value.invokeMethod` so the right
# implementation is picked based on the receiver's actual type. This mirrors
# how native v8 resolves `x.method(...)` through the prototype chain.
#
# For statically-typed receivers (VB `As String`, C# `List<T>`, …) the other
# language profiles emit the typed import directly — cheaper, no runtime
# dispatch. JS can't do that without full type inference, so everything
# routes through the shim.
toUpperCase   = { emit = "invoke:toUpperCase",   min_args = 0, max_args = 0 }
toLowerCase   = { emit = "invoke:toLowerCase",   min_args = 0, max_args = 0 }
trim          = { emit = "invoke:trim",          min_args = 0, max_args = 0 }
trimStart     = { emit = "invoke:trimStart",     min_args = 0, max_args = 0 }
trimEnd       = { emit = "invoke:trimEnd",       min_args = 0, max_args = 0 }
startsWith    = { emit = "invoke:startsWith",    min_args = 1, max_args = 2 }
endsWith      = { emit = "invoke:endsWith",      min_args = 1, max_args = 2 }
charAt        = { emit = "invoke:charAt",        min_args = 1, max_args = 1 }
charCodeAt    = { emit = "invoke:charCodeAt",    min_args = 1, max_args = 1 }
substring     = { emit = "invoke:substring",    min_args = 1, max_args = 2 }
split         = { emit = "invoke:split",        min_args = 1, max_args = 2 }
replace       = { emit = "invoke:replace",       min_args = 2, max_args = 2 }
replaceAll    = { emit = "invoke:replaceAll",    min_args = 2, max_args = 2 }
repeat        = { emit = "invoke:repeat",        min_args = 1, max_args = 1 }
padStart      = { emit = "invoke:padStart",      min_args = 1, max_args = 2 }
padEnd        = { emit = "invoke:padEnd",        min_args = 1, max_args = 2 }
indexOf       = { emit = "invoke:indexOf",       min_args = 1, max_args = 2 }
lastIndexOf   = { emit = "invoke:lastIndexOf",   min_args = 1, max_args = 2 }
includes      = { emit = "invoke:includes",      min_args = 1, max_args = 2 }
slice         = { emit = "invoke:slice",         min_args = 0, max_args = 2 }
at            = { emit = "invoke:at",            min_args = 1, max_args = 1 }
concat        = { emit = "invoke:concat",        min_args = 1, max_args = 255 }
match         = { emit = "host:vybe:string:match",     min_args = 1, max_args = 1 }
search        = { emit = "host:vybe:string:search",    min_args = 1, max_args = 1 }
toString      = { emit = "invoke:toString",      min_args = 0, max_args = 0 }
toFixed       = { emit = "host:vybe:convert:toFixed",  min_args = 0, max_args = 1 }

# Array instance methods — mutators only; polymorphic methods go through
# `invoke:*` above. These are array-only per ECMA-262 so we emit the
# typed import directly.
push          = { emit = "common:collections.push",    min_args = 1, max_args = 255 }
pop           = { emit = "common:collections.pop",     min_args = 0, max_args = 0 }
shift         = { emit = "common:collections.shift",   min_args = 0, max_args = 0 }
reverse       = { emit = "common:collections.reverse", min_args = 0, max_args = 0 }
join          = { emit = "common:collections.join",    min_args = 0, max_args = 1 }
fill          = { emit = "host:ecma:array:fill",    min_args = 1, max_args = 3 }
unshift       = { emit = "host:ecma:array:unshift", min_args = 1, max_args = 255 }
splice        = { emit = "host:ecma:array:splice",  min_args = 1, max_args = 255 }
flat          = { emit = "host:ecma:array:flat",    min_args = 0, max_args = 1 }
entries       = { emit = "host:vybe:array:enumerate",  min_args = 0, max_args = 0 }

# Map/Set size property
size              = { emit = "intrinsic:map_size",       min_args = 0, max_args = 0 }

# JS plain-object instance method `obj.hasOwnProperty(k)`. NB: only the
# `hasOwnProperty` name is wired here — bare `has`/`delete`/`clear` are
# Map/Set instance methods and the VM's runtime type-aware dispatch
# (via `Map.__type → vybe:collections::mapHas` etc.) already handles
# them correctly. Adding generic profile entries here would intercept
# Map/Set calls at compile time and route them through the wrong storage.
hasOwnProperty    = { emit = "common:dict.has",          min_args = 1, max_args = 1 }

# Object.keys/values are STATIC calls via module alias (Object.keys(obj)),
# NOT instance methods. Map.keys/values go through the type registry.
# Removed from value_methods to avoid intercepting Map.keys().

# Array higher-order methods — routed to compiled JS builtins
# (see [array_methods] section below)

# ────────────────────────────────────────────────────────────────────────────
# INTRINSIC DEFINITIONS — multi-opcode sequences
# ────────────────────────────────────────────────────────────────────────────

[intrinsics]
# Number.isNaN(x) → x !== x
number_isnan = "dup, dyn_ne"
# Number.isFinite(x) → abs(x) <= MAX_VALUE
number_isfinite = "f64_abs, const_f64(1.7976931348623157e308), dyn_le"
# Number.isInteger(x) → trunc(x) === x
number_isinteger = "dup, f64_trunc, dyn_eq"
# Atomics — use compiler_common::threading
atomics_load = "atomic_load"
atomics_store = "atomic_store"
atomics_add = "atomic_add"
atomics_sub = "atomic_sub"
atomics_exchange = "atomic_xchg"
atomics_cmpxchg = "atomic_cmpxchg"
atomics_wait = "atomic_wait"
atomics_notify = "atomic_notify"
# Value method intrinsics
# arr.at(i) → array_get (supports negative indexing)
array_at = "array_get"
# arr.unshift(val) → splice(0, 0, val)
array_unshift = "const_i32(0), const_i32(0), splice"
# map.size → dict_keys, array_length
map_size = "dict_keys, array_length"

# ────────────────────────────────────────────────────────────────────────────
# ESM DEFAULTS — ambient imports the language pre-declares at module scope.
# ECMA-262 §16.2 shape: each entry is an `import` statement's equivalent,
# resolved by the compiler Linker alongside user-written `import` lines.
# User imports shadow these on key collision.
#
# `kind = "namespace"` ≡ `import * as <alias> from "<module>"`.
# ────────────────────────────────────────────────────────────────────────────


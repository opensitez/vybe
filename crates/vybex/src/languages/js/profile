# JavaScript Compiler Profile
# ─────────────────────────────
# Full port of vybe_compiler_js (3624 lines) — builtins, module aliases,
# value methods, namespace intrinsics, constructors

[info]
name = "js"
extensions = ["js", "mjs"]

[compiler]
function_return = "explicit"
self_keyword = "this"
constructor_name = "constructor"
separated_methods = false
implicit_self_fields = false
explicit_self_param = false
enum_as_ordinals = false
case_sensitive = true
string_indexing = "zero_based"
# JS-specific: `var` declarations are hoisted to function scope
hoist_var = true
# JS-specific: `+` is overloaded for string concatenation (dyn_add handles it)
dynamic_add = true
# JS-specific: support `require()` for CommonJS module loading
commonjs_require = true
# JS switch statements fall through unless there's an explicit break
switch_fallthrough = true

# ────────────────────────────────────────────────────────────────────────────
# BUILTINS — bare global function calls
# ────────────────────────────────────────────────────────────────────────────

[builtins]

# ── I/O ──────────────────────────────────────────────────────────────────────

"console.log"       = { emit = "print",                    min_args = 0, max_args = 255 }
"console.warn"      = { emit = "print",                    min_args = 0, max_args = 255 }
"console.error"     = { emit = "host:wasi:cli:error",      min_args = 0, max_args = 255 }
"console.info"      = { emit = "print",                    min_args = 0, max_args = 255 }
"console.debug"     = { emit = "print",                    min_args = 0, max_args = 255 }
alert               = { emit = "print",                    min_args = 1, max_args = 1 }
prompt              = { emit = "host:wasi:cli:readLine",   min_args = 0, max_args = 1 }

# ── Type conversion ──────────────────────────────────────────────────────────

parseInt            = { emit = "host:vybe:convert:parseInt",     min_args = 1, max_args = 2 }
parseFloat          = { emit = "host:vybe:convert:parseFloat",   min_args = 1, max_args = 1 }
isNaN               = { emit = "host:vybe:convert:isNaN",         min_args = 1, max_args = 1 }
isFinite            = { emit = "host:vybe:convert:isFinite",      min_args = 1, max_args = 1 }

# ── Encoding ─────────────────────────────────────────────────────────────────

btoa                    = { emit = "host:vybe:convert:btoa",                  min_args = 1, max_args = 1 }
atob                    = { emit = "host:vybe:convert:atob",                  min_args = 1, max_args = 1 }
encodeURIComponent      = { emit = "host:vybe:convert:encodeURIComponent",    min_args = 1, max_args = 1 }
decodeURIComponent      = { emit = "host:vybe:convert:decodeURIComponent",    min_args = 1, max_args = 1 }
encodeURI               = { emit = "host:vybe:convert:encodeURIComponent",    min_args = 1, max_args = 1 }
decodeURI               = { emit = "host:vybe:convert:decodeURIComponent",    min_args = 1, max_args = 1 }

# ── Math — WASM opcodes ─────────────────────────────────────────────────────

"Math.abs"          = { emit = "opcode:f64_abs",      min_args = 1, max_args = 1 }
"Math.floor"        = { emit = "opcode:f64_floor",    min_args = 1, max_args = 1 }
"Math.ceil"         = { emit = "opcode:f64_ceil",     min_args = 1, max_args = 1 }
"Math.sqrt"         = { emit = "opcode:f64_sqrt",     min_args = 1, max_args = 1 }
"Math.trunc"        = { emit = "opcode:f64_trunc",    min_args = 1, max_args = 1 }
"Math.round"        = { emit = "opcode:f64_nearest",  min_args = 1, max_args = 1 }
"Math.min"          = { emit = "opcode:f64_min",      min_args = 2, max_args = 2 }
"Math.max"          = { emit = "opcode:f64_max",      min_args = 2, max_args = 2 }

# ── Math — host calls ───────────────────────────────────────────────────────

"Math.pow"          = { emit = "host:vybe:math:pow",      min_args = 2, max_args = 2 }
"Math.sin"          = { emit = "host:vybe:math:sin",      min_args = 1, max_args = 1 }
"Math.cos"          = { emit = "host:vybe:math:cos",      min_args = 1, max_args = 1 }
"Math.tan"          = { emit = "host:vybe:math:tan",      min_args = 1, max_args = 1 }
"Math.asin"         = { emit = "host:vybe:math:asin",     min_args = 1, max_args = 1 }
"Math.acos"         = { emit = "host:vybe:math:acos",     min_args = 1, max_args = 1 }
"Math.atan"         = { emit = "host:vybe:math:atan",     min_args = 1, max_args = 1 }
"Math.atan2"        = { emit = "host:vybe:math:atan2",    min_args = 2, max_args = 2 }
"Math.log"          = { emit = "host:vybe:math:log",      min_args = 1, max_args = 1 }
"Math.log2"         = { emit = "host:vybe:math:log2",     min_args = 1, max_args = 1 }
"Math.log10"        = { emit = "host:vybe:math:log10",    min_args = 1, max_args = 1 }
"Math.exp"          = { emit = "host:vybe:math:exp",      min_args = 1, max_args = 1 }
"Math.sign"         = { emit = "host:vybe:math:sign",     min_args = 1, max_args = 1 }
"Math.random"       = { emit = "host:wasi:random:random",  min_args = 0, max_args = 0 }
"Math.hypot"        = { emit = "host:vybe:math:hypot",    min_args = 2, max_args = 2 }
"Math.cbrt"         = { emit = "host:vybe:math:cbrt",     min_args = 1, max_args = 1 }
"Math.clz32"        = { emit = "host:vybe:math:clz32",    min_args = 1, max_args = 1 }
"Math.fround"       = { emit = "host:vybe:math:fround",   min_args = 1, max_args = 1 }
"Math.imul"         = { emit = "host:vybe:math:imul",     min_args = 2, max_args = 2 }

# ── Number static methods ────────────────────────────────────────────────────

"Number.parseInt"   = { emit = "host:vybe:convert:parseInt",      min_args = 1, max_args = 2 }
"Number.parseFloat" = { emit = "host:vybe:convert:parseFloat",    min_args = 1, max_args = 1 }
"Number.isNaN"      = { emit = "intrinsic:number_isnan",          min_args = 1, max_args = 1 }
"Number.isFinite"   = { emit = "intrinsic:number_isfinite",       min_args = 1, max_args = 1 }
"Number.isInteger"  = { emit = "intrinsic:number_isinteger",      min_args = 1, max_args = 1 }

# ── Type coercion globals: Boolean(v), Number(v), String(v) ──────────────────

Boolean             = { emit = "host:vybe:convert:toBool",        min_args = 1, max_args = 1 }
Number              = { emit = "host:vybe:convert:toNumber",      min_args = 1, max_args = 1 }
String              = { emit = "host:vybe:convert:toStr",         min_args = 1, max_args = 1 }

# ── String static methods ────────────────────────────────────────────────────

"String.fromCharCode" = { emit = "opcode:str_from_char_code",     min_args = 1, max_args = 255 }
"String.raw"          = { emit = "stdlib:string_raw",              min_args = 1, max_args = 255 }

# ── Array static methods ─────────────────────────────────────────────────────

"Array.isArray"     = { emit = "opcode:ref_is_array",             min_args = 1, max_args = 1 }
"Array.from"        = { emit = "host:wasm:js-array:from",            min_args = 1, max_args = 3 }
"Array.of"          = { emit = "host:wasm:js-array:of",              min_args = 0, max_args = 255 }

# ── Object static methods ────────────────────────────────────────────────────

"Object.keys"        = { emit = "host:vybe:object:keys",         min_args = 1, max_args = 1 }
"Object.values"      = { emit = "host:vybe:object:values",       min_args = 1, max_args = 1 }
"Object.entries"     = { emit = "host:vybe:object:entries",       min_args = 1, max_args = 1 }
"Object.assign"      = { emit = "host:vybe:object:assign",       min_args = 2, max_args = 255 }
"Object.freeze"      = { emit = "host:vybe:object:freeze",       min_args = 1, max_args = 1 }
"Object.fromEntries" = { emit = "host:vybe:object:fromEntries",  min_args = 1, max_args = 1 }
"Object.hasOwn"      = { emit = "host:vybe:object:hasOwn",       min_args = 2, max_args = 2 }
"Object.create"      = { emit = "host:vybe:object:create",       min_args = 1, max_args = 2 }
"Object.seal"        = { emit = "host:vybe:object:seal",         min_args = 1, max_args = 1 }
"Object.isFrozen"    = { emit = "host:vybe:object:isFrozen",     min_args = 1, max_args = 1 }
"Object.isSealed"    = { emit = "host:vybe:object:isSealed",     min_args = 1, max_args = 1 }
"Object.is"          = { emit = "host:vybe:object:is",           min_args = 2, max_args = 2 }
"Object.getPrototypeOf"     = { emit = "host:vybe:object:getPrototypeOf",     min_args = 1, max_args = 1 }
"Object.getOwnPropertyNames" = { emit = "host:vybe:object:getOwnPropertyNames", min_args = 1, max_args = 1 }
"Object.defineProperty" = { emit = "host:vybe:object:defineProperty", min_args = 3, max_args = 3 }

# ── JSON ─────────────────────────────────────────────────────────────────────

"JSON.parse"         = { emit = "host:vybe:json:parse",          min_args = 1, max_args = 1 }
"JSON.stringify"     = { emit = "host:vybe:json:stringify",       min_args = 1, max_args = 3 }

# ── Timers ───────────────────────────────────────────────────────────────────

# setTimeout/setInterval emit Op::set_timer directly (no host call needed —
# the VM event loop owns the timer queue). The vybe:runtime host module
# never had matching exports so the old `host:vybe:runtime:*` mapping
# was a dead route that surfaced as "Unresolved import" at runtime.
setTimeout           = { emit = "opcode:set_timer",              min_args = 1, max_args = 2 }
setInterval          = { emit = "opcode:set_timer",              min_args = 1, max_args = 2 }
clearTimeout         = { emit = "noop",                          min_args = 1, max_args = 1 }
clearInterval        = { emit = "noop",                          min_args = 1, max_args = 1 }
queueMicrotask       = { emit = "noop",                          min_args = 1, max_args = 1 }

# ── Atomics ──────────────────────────────────────────────────────────────────

"Atomics.load"            = { emit = "intrinsic:atomics_load",        min_args = 2, max_args = 2 }
"Atomics.store"           = { emit = "intrinsic:atomics_store",       min_args = 3, max_args = 3 }
"Atomics.add"             = { emit = "intrinsic:atomics_add",         min_args = 3, max_args = 3 }
"Atomics.sub"             = { emit = "intrinsic:atomics_sub",         min_args = 3, max_args = 3 }
"Atomics.exchange"        = { emit = "intrinsic:atomics_exchange",    min_args = 3, max_args = 3 }
"Atomics.compareExchange" = { emit = "intrinsic:atomics_cmpxchg",    min_args = 4, max_args = 4 }
"Atomics.wait"            = { emit = "intrinsic:atomics_wait",       min_args = 3, max_args = 4 }
"Atomics.notify"          = { emit = "intrinsic:atomics_notify",     min_args = 2, max_args = 3 }


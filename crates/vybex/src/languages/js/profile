"fs.statSync"        = { emit = "host:wasi:filesystem:stat",      min_args = 1, max_args = 1 }

# ── net module ───────────────────────────────────────────────────────────────

"net.createConnection" = { emit = "host:vybe:net:tcpConnect",      min_args = 1, max_args = 2 }
"net.connect"          = { emit = "host:vybe:net:tcpConnect",      min_args = 1, max_args = 2 }
"net.createServer"     = { emit = "host:vybe:net:tcpListenerNew",  min_args = 0, max_args = 1 }

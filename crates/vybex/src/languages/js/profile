# JavaScript Compiler Profile
# ─────────────────────────────
# Full port of vybe_compiler_js (3624 lines) — builtins, module aliases,
# value methods, namespace intrinsics, constructors

[info]
name = "js"
extensions = ["js", "mjs"]

[compiler]
function_return = "explicit"
self_keyword = "this"
constructor_name = "constructor"
enum_as_ordinals = false
case_sensitive = true
string_indexing = "zero_based"
# JS-specific: `var` declarations are hoisted to function scope
hoist_var = true
# JS-specific: `+` is overloaded for string concatenation (dyn_add handles it)
dynamic_add = true
# JS-specific: support `require()` for CommonJS module loading
commonjs_require = true
# JS switch statements fall through unless there's an explicit break
switch_fallthrough = true
# Route `class` declarations through common::classes::normalize_class
# + emit_class instead of the legacy compile_class orchestration.
# Pilot for the classnormalization.md migration — other languages opt
# in as each gets its own `normalize_class`.
uses_normalize_class = true

# ────────────────────────────────────────────────────────────────────────────
# BUILTINS — bare global function calls
# ────────────────────────────────────────────────────────────────────────────

[builtins]

# ── I/O ──────────────────────────────────────────────────────────────────────

"console.log"       = { emit = "print",                    min_args = 0, max_args = 255 }
"console.warn"      = { emit = "print",                    min_args = 0, max_args = 255 }
"console.error"     = { emit = "host:wasi:cli:error",      min_args = 0, max_args = 255 }
"console.info"      = { emit = "print",                    min_args = 0, max_args = 255 }
"console.debug"     = { emit = "print",                    min_args = 0, max_args = 255 }
alert               = { emit = "print",                    min_args = 1, max_args = 1 }
prompt              = { emit = "host:wasi:cli:readLine",   min_args = 0, max_args = 1 }

# ── Type conversion ──────────────────────────────────────────────────────────

parseInt            = { emit = "host:vybe:convert:parseInt",     min_args = 1, max_args = 2 }
parseFloat          = { emit = "host:vybe:convert:parseFloat",   min_args = 1, max_args = 1 }
isNaN               = { emit = "host:vybe:convert:isNaN",         min_args = 1, max_args = 1 }
isFinite            = { emit = "host:vybe:convert:isFinite",      min_args = 1, max_args = 1 }

# ── Encoding ─────────────────────────────────────────────────────────────────

btoa                    = { emit = "host:vybe:convert:btoa",                  min_args = 1, max_args = 1 }
atob                    = { emit = "host:vybe:convert:atob",                  min_args = 1, max_args = 1 }
encodeURIComponent      = { emit = "host:vybe:convert:encodeURIComponent",    min_args = 1, max_args = 1 }
decodeURIComponent      = { emit = "host:vybe:convert:decodeURIComponent",    min_args = 1, max_args = 1 }
encodeURI               = { emit = "host:vybe:convert:encodeURIComponent",    min_args = 1, max_args = 1 }
decodeURI               = { emit = "host:vybe:convert:decodeURIComponent",    min_args = 1, max_args = 1 }

# ── Math — WASM opcodes ─────────────────────────────────────────────────────

"Math.abs"          = { emit = "opcode:f64_abs",      min_args = 1, max_args = 1 }
"Math.floor"        = { emit = "opcode:f64_floor",    min_args = 1, max_args = 1 }
"Math.ceil"         = { emit = "opcode:f64_ceil",     min_args = 1, max_args = 1 }
"Math.sqrt"         = { emit = "opcode:f64_sqrt",     min_args = 1, max_args = 1 }
"Math.trunc"        = { emit = "opcode:f64_trunc",    min_args = 1, max_args = 1 }
"Math.round"        = { emit = "opcode:f64_nearest",  min_args = 1, max_args = 1 }
"Math.min"          = { emit = "opcode:f64_min",      min_args = 2, max_args = 2 }
"Math.max"          = { emit = "opcode:f64_max",      min_args = 2, max_args = 2 }

# ── Math — host calls ───────────────────────────────────────────────────────

"Math.pow"          = { emit = "stdlib:pow",      min_args = 2, max_args = 2 }
"Math.sin"          = { emit = "stdlib:sin",      min_args = 1, max_args = 1 }
"Math.cos"          = { emit = "stdlib:cos",      min_args = 1, max_args = 1 }
"Math.tan"          = { emit = "stdlib:tan",      min_args = 1, max_args = 1 }

"Math.log10"        = { emit = "stdlib:log10",    min_args = 1, max_args = 1 }
"Math.exp"          = { emit = "stdlib:exp",      min_args = 1, max_args = 1 }
"Math.sign"         = { emit = "stdlib:sign",     min_args = 1, max_args = 1 }
"Math.random"       = { emit = "host:vybe:random:random",  min_args = 0, max_args = 0 }
"Math.hypot"        = { emit = "host:ecma:math:hypot",    min_args = 2, max_args = 2 }
"Math.cbrt"         = { emit = "host:ecma:math:cbrt",     min_args = 1, max_args = 1 }
"Math.clz32"        = { emit = "host:ecma:math:clz32",    min_args = 1, max_args = 1 }
"Math.fround"       = { emit = "host:ecma:math:fround",   min_args = 1, max_args = 1 }
"Math.imul"         = { emit = "host:ecma:math:imul",     min_args = 2, max_args = 2 }

# ── Number static methods ────────────────────────────────────────────────────

"Number.parseInt"   = { emit = "host:vybe:convert:parseInt",      min_args = 1, max_args = 2 }
"Number.parseFloat" = { emit = "host:vybe:convert:parseFloat",    min_args = 1, max_args = 1 }
"Number.isNaN"      = { emit = "intrinsic:number_isnan",          min_args = 1, max_args = 1 }
"Number.isFinite"   = { emit = "intrinsic:number_isfinite",       min_args = 1, max_args = 1 }
"Number.isInteger"  = { emit = "intrinsic:number_isinteger",      min_args = 1, max_args = 1 }

# ── Type coercion globals: Boolean(v), Number(v), String(v) ──────────────────

Boolean             = { emit = "host:vybe:convert:toBool",        min_args = 1, max_args = 1 }
Number              = { emit = "host:vybe:convert:toNumber",      min_args = 1, max_args = 1 }
String              = { emit = "host:vybe:convert:toStr",         min_args = 1, max_args = 1 }

# ── String static methods ────────────────────────────────────────────────────

"String.fromCharCode" = { emit = "opcode:str_from_char_code",     min_args = 1, max_args = 255 }
"String.raw"          = { emit = "stdlib:string_raw",              min_args = 1, max_args = 255 }

# ── Array static methods ─────────────────────────────────────────────────────

"Array.isArray"     = { emit = "opcode:ref_is_array",             min_args = 1, max_args = 1 }
"Array.from"        = { emit = "host:ecma:array:from",            min_args = 1, max_args = 3 }
"Array.of"          = { emit = "host:ecma:array:of",              min_args = 0, max_args = 255 }

# ── Object static methods ────────────────────────────────────────────────────
#
# Portable Component-Model imports: `ecma:object.*` is the shared
# import set — same handlers back PHP `array_keys/values`, Python
# `dict.keys/values/items`, Ruby `Hash#keys`, etc. Running vybex-compiled
# JS under V8 is possible because V8 satisfies these imports natively.

"Object.keys"        = { emit = "host:ecma:object:keys",        min_args = 1, max_args = 1 }
"Object.values"      = { emit = "host:ecma:object:values",      min_args = 1, max_args = 1 }
"Object.entries"     = { emit = "host:ecma:object:entries",     min_args = 1, max_args = 1 }
"Object.assign"      = { emit = "host:vybe:object:assign",       min_args = 2, max_args = 255 }
"Object.freeze"      = { emit = "host:vybe:object:freeze",       min_args = 1, max_args = 1 }
"Object.fromEntries" = { emit = "host:vybe:object:fromEntries",  min_args = 1, max_args = 1 }
"Object.hasOwn"      = { emit = "host:ecma:object:hasOwn",      min_args = 2, max_args = 2 }
"Object.create"      = { emit = "host:vybe:object:create",       min_args = 1, max_args = 2 }
"Object.seal"        = { emit = "host:vybe:object:seal",         min_args = 1, max_args = 1 }
"Object.isFrozen"    = { emit = "host:vybe:object:isFrozen",     min_args = 1, max_args = 1 }
"Object.isSealed"    = { emit = "host:vybe:object:isSealed",     min_args = 1, max_args = 1 }
"Object.is"          = { emit = "host:vybe:object:is",           min_args = 2, max_args = 2 }
"Object.getPrototypeOf"     = { emit = "host:vybe:object:getPrototypeOf",     min_args = 1, max_args = 1 }
"Object.getOwnPropertyNames" = { emit = "host:vybe:object:getOwnPropertyNames", min_args = 1, max_args = 1 }
"Object.defineProperty" = { emit = "host:vybe:object:defineProperty", min_args = 3, max_args = 3 }

# ── JSON ─────────────────────────────────────────────────────────────────────

"JSON.parse"         = { emit = "host:vybe:json:parse",          min_args = 1, max_args = 1 }
"JSON.stringify"     = { emit = "host:vybe:json:stringify",       min_args = 1, max_args = 3 }

# ── Timers ───────────────────────────────────────────────────────────────────

# setTimeout/setInterval emit Op::set_timer directly (no host call needed —
# the VM event loop owns the timer queue). The vybe:runtime host module
# never had matching exports so the old `host:vybe:runtime:*` mapping
# was a dead route that surfaced as "Unresolved import" at runtime.
setTimeout           = { emit = "opcode:set_timer",              min_args = 1, max_args = 2 }
setInterval          = { emit = "opcode:set_timer",              min_args = 1, max_args = 2 }
clearTimeout         = { emit = "noop",                          min_args = 1, max_args = 1 }
clearInterval        = { emit = "noop",                          min_args = 1, max_args = 1 }
queueMicrotask       = { emit = "noop",                          min_args = 1, max_args = 1 }

# ── Atomics ──────────────────────────────────────────────────────────────────

"Atomics.load"            = { emit = "intrinsic:atomics_load",        min_args = 2, max_args = 2 }
"Atomics.store"           = { emit = "intrinsic:atomics_store",       min_args = 3, max_args = 3 }
"Atomics.add"             = { emit = "intrinsic:atomics_add",         min_args = 3, max_args = 3 }
"Atomics.sub"             = { emit = "intrinsic:atomics_sub",         min_args = 3, max_args = 3 }
"Atomics.exchange"        = { emit = "intrinsic:atomics_exchange",    min_args = 3, max_args = 3 }
"Atomics.compareExchange" = { emit = "intrinsic:atomics_cmpxchg",    min_args = 4, max_args = 4 }
"Atomics.wait"            = { emit = "intrinsic:atomics_wait",       min_args = 3, max_args = 4 }
"Atomics.notify"          = { emit = "intrinsic:atomics_notify",     min_args = 2, max_args = 3 }

# ── crypto module ────────────────────────────────────────────────────────────


# Node `worker_threads` — worker.spawn() compiles to Op::THREAD_SPAWN
# (WASM threads proposal). The module is a compiler-level intercept, not
# a host-fn namespace.

# ────────────────────────────────────────────────────────────────────────────
# KNOWN TYPES — constructor mappings for new TypeName()
# ────────────────────────────────────────────────────────────────────────────

[known_types]
"Array"         = ["vybe:array", "arrayNew"]
"Map"           = ["vybe:collections", "Map"]
"Set"           = ["vybe:collections", "Set"]
"Error"         = ["vybe:runtime", "Error"]
"TypeError"     = ["vybe:runtime", "TypeError"]
"RangeError"    = ["vybe:runtime", "RangeError"]
"ReferenceError" = ["vybe:runtime", "ReferenceError"]
"SyntaxError"   = ["vybe:runtime", "SyntaxError"]
"RegExp"        = ["vybe:regex", "RegExp"]
"Date"          = ["wasi:clocks", "Date"]
"Promise"       = ["vybe:runtime", "Promise"]
"WeakMap"       = ["vybe:collections", "WeakMap"]
"WeakSet"       = ["vybe:collections", "WeakSet"]
"ArrayBuffer"   = ["vybe:types", "ArrayBuffer"]
"SharedArrayBuffer" = ["vybe:types", "SharedArrayBuffer"]
"Int32Array"    = ["vybe:types", "Int32Array"]
"Float64Array"  = ["vybe:types", "Float64Array"]
"Uint8Array"    = ["vybe:types", "Uint8Array"]
# "Worker" constructor: lowered to Op::THREAD_SPAWN by the compiler, no
# host-fn ctor entry.

# ────────────────────────────────────────────────────────────────────────────
# NAMESPACE CONSTANTS — property access, NOT function call
# ────────────────────────────────────────────────────────────────────────────

[namespace_constants]
"Math.PI"               = 3.141592653589793
"Math.E"                = 2.718281828459045
"Math.LN2"              = 0.6931471805599453
"Math.LN10"             = 2.302585092994046
"Math.LOG2E"            = 1.4426950408889634
"Math.LOG10E"           = 0.4342944819032518
"Math.SQRT2"            = 1.4142135623730951
"Math.SQRT1_2"          = 0.7071067811865476
"Number.MAX_SAFE_INTEGER" = 9007199254740991
"Number.MIN_SAFE_INTEGER" = -9007199254740991
"Number.EPSILON"        = 2.220446049250313e-16
"Number.MAX_VALUE"      = 1.7976931348623157e308
"Number.POSITIVE_INFINITY" = "Infinity"
"Number.NEGATIVE_INFINITY" = "-Infinity"
"Number.NaN"            = "NaN"

# ────────────────────────────────────────────────────────────────────────────
# JS BUILTINS LIBRARY — compiled JS injected at startup
# Array higher-order methods (map, filter, forEach, find, reduce, sort, etc.)
# are implemented as JS functions and compiled by the parser itself.
# The compiler recognizes arr.map(fn) and routes to __array_map.
# ────────────────────────────────────────────────────────────────────────────

[array_methods]
map      = "__array_map"
filter   = "__array_filter"
forEach  = "__array_forEach"
find      = "__array_find"
findIndex = "__array_findIndex"
includes  = "__array_includes"
reduce   = "__array_reduce"
sort     = "__array_sort"
some     = "__array_some"
every    = "__array_every"
flatMap  = "__array_flat_map"
reduceRight = "__array_reduce_right"

# ────────────────────────────────────────────────────────────────────────────
# BARE MODULE ALIASES — Node.js built-in module name resolution.
#
# Node code can import built-ins with either the prefixed form
# (`import fs from 'node:fs'`, available since Node 16) or the
# traditional bare form (`import fs from 'fs'`). The bare form is
# what most existing Node code uses. Both must resolve to the same
# host module — `node:fs` here.
#
# Vybe consults this table only for JS imports (other languages
# leave [bare_module_aliases] empty so e.g. Python `import os`
# keeps Python's stdlib semantics).
# ────────────────────────────────────────────────────────────────────────────

[bare_module_aliases]
"fs"            = "node:fs"
"path"          = "node:path"
"os"            = "node:os"
"process"       = "node:process"
"child_process" = "node:child_process"

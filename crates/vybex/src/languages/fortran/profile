# Fortran Compiler Profile
# ────────────────────────────────────────

[info]
name = "fortran"
extensions = ["f90", "f95", "f03", "f08", "f18", "f"]

[compiler]
function_return = "result_slot"        # Fortran uses result variable or function name
self_keyword = ""
base_keyword = ""
constructor_name = ""
enum_as_ordinals = false
case_sensitive = false                 # Fortran is case-insensitive
string_indexing = "one_based"          # Fortran strings are 1-based
array_upper_bound_inclusive = true     # do i=1,10 means 1..10 inclusive
parens_for_index = true                # Fortran uses () for array indexing
entry_point = "main"
hoist_var = false
dynamic_add = false
commonjs_require = false
byref_boxing = false
with_block = false
new_with_initializer = false
new_from_initializer = false
linq_queries = false

# ────────────────────────────────────────────────────────────────────────────
# BUILTINS — Fortran intrinsic functions
# ────────────────────────────────────────────────────────────────────────────

[builtins]

# ── I/O ──────────────────────────────────────────────────────────────────────

__print       = { emit = "print",                          min_args = 0, max_args = 255 }

# ── Math — WASM opcodes ─────────────────────────────────────────────────────

abs           = { emit = "opcode:f64_abs",                 min_args = 1, max_args = 1 }
sqrt          = { emit = "opcode:f64_sqrt",                min_args = 1, max_args = 1 }
floor         = { emit = "opcode:f64_floor",               min_args = 1, max_args = 1 }
ceiling       = { emit = "opcode:f64_ceil",                min_args = 1, max_args = 1 }
nint          = { emit = "opcode:f64_nearest",             min_args = 1, max_args = 1 }
min           = { emit = "opcode:f64_min",                 min_args = 2, max_args = 2 }
max           = { emit = "opcode:f64_max",                 min_args = 2, max_args = 2 }
real          = { emit = "opcode:to_float",                min_args = 1, max_args = 1 }
dble          = { emit = "opcode:to_float",                min_args = 1, max_args = 1 }
int           = { emit = "opcode:to_int",                  min_args = 1, max_args = 1 }

# ── Math — host calls ───────────────────────────────────────────────────────

sin           = { emit = "host:ecma:math:sin",             min_args = 1, max_args = 1 }
cos           = { emit = "host:ecma:math:cos",             min_args = 1, max_args = 1 }
tan           = { emit = "host:ecma:math:tan",             min_args = 1, max_args = 1 }
asin          = { emit = "host:ecma:math:asin",            min_args = 1, max_args = 1 }
acos          = { emit = "host:ecma:math:acos",            min_args = 1, max_args = 1 }
atan          = { emit = "host:ecma:math:atan",            min_args = 1, max_args = 1 }
atan2         = { emit = "host:ecma:math:atan2",           min_args = 2, max_args = 2 }
exp           = { emit = "host:ecma:math:exp",             min_args = 1, max_args = 1 }
log           = { emit = "host:ecma:math:log",             min_args = 1, max_args = 1 }
log10         = { emit = "host:ecma:math:log10",           min_args = 1, max_args = 1 }
mod           = { emit = "host:ecma:math:fmod",            min_args = 2, max_args = 2 }
sign          = { emit = "host:ecma:math:sign",            min_args = 2, max_args = 2 }
random_number = { emit = "host:vybe:random:random",        min_args = 0, max_args = 0 }

# ── String functions ─────────────────────────────────────────────────────────

len           = { emit = "common:strings.length",          min_args = 1, max_args = 1 }
len_trim      = { emit = "common:strings.length",          min_args = 1, max_args = 1 }
trim          = { emit = "common:strings.trim",            min_args = 1, max_args = 1 }
adjustl       = { emit = "opcode:str_trim_start",          min_args = 1, max_args = 1 }
adjustr       = { emit = "opcode:str_trim_end",            min_args = 1, max_args = 1 }
char          = { emit = "host:vybe:string:chr",           min_args = 1, max_args = 1 }
ichar         = { emit = "host:vybe:string:charCodeAt",    min_args = 1, max_args = 1 }
index         = { emit = "opcode:str_index_of",            min_args = 2, max_args = 2 }
repeat        = { emit = "opcode:str_repeat",              min_args = 2, max_args = 2 }

# ── Misc ─────────────────────────────────────────────────────────────────────

stop          = { emit = "noop",                           min_args = 0, max_args = 1 }

# ────────────────────────────────────────────────────────────────────────────
# VALUE METHODS
# ────────────────────────────────────────────────────────────────────────────

[value_methods]

# ────────────────────────────────────────────────────────────────────────────
# NAMESPACE CONSTANTS
# ────────────────────────────────────────────────────────────────────────────

[namespace_constants]

# ────────────────────────────────────────────────────────────────────────────
# ESM DEFAULTS — none. Fortran has no ambient host module imports.
# ────────────────────────────────────────────────────────────────────────────

# ────────────────────────────────────────────────────────────────────────────
# NAMESPACE CONFIG
# ────────────────────────────────────────────────────────────────────────────

[namespaces]
use_dotnet = false

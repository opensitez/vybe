# ────────────────────────────────────────────────────────────────────────────
# INTRINSIC DEFINITIONS — multi-opcode sequences
# ────────────────────────────────────────────────────────────────────────────
# These are referenced by emit = "intrinsic:<name>" above.
# The compiler's intrinsic handler knows how to emit them.

[intrinsics]
# CByte: truncate to 0-255 → i32_from_f64 + i32_and(0xFF)
cbyte = "to_int, const_i32(255), i32_and"

# UBound: array length - 1
ubound = "array_len, const_i32(1), i32_sub"

# LBound: always 0 in .NET
lbound = "const_i32(0)"

# Asc(s): first char code → i32_const_0, str_char_code_at
asc = "const_i32(0), str_char_code_at"

# Space(n): str_repeat(" ", n)
space = "const_str( ), swap, to_int, str_repeat"

# String(n, char): str_repeat(char, n) — args are reversed vs VB order
string_repeat = "swap, str_repeat"

# InStr(s, find): str_index_of + 1 (VB 1-based: 0=not found, 1=first)
instr = "str_index_of, const_i32(1), i32_add"

# InStrRev(s, find): str_last_index_of + 1
instrrev = "str_last_index_of, const_i32(1), i32_add"

# Replace(s, old, new): str_replace
replace = "str_replace"

# Split(s, delim?): if 1 arg → split on " "
split = "str_split"

# Join(arr, delim?): if 1 arg → join with " "
join = "array_join"

# Left(s, n): substring(s, 0, n)
left = "const_i32(0), swap, to_int, str_substring"

# Mid(s, start, len?): substring adjusted for 1-based
mid = "mid_1based"

# String.IsNullOrEmpty: dup, ref_is_null OR str_length == 0
string_isnullorempty = "dup, ref_is_null, br_if_true, str_length, const_i32(0), dyn_eq"


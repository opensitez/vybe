WHITESPACE = _{ " " | "\t" }
COMMENT = ${ comment_text }
comment_text = { "//" ~ (!"\n" ~ ANY)* ~ "\n" }
word = { "a" }
silent = _{ word }
atomic = @{ word ~ word }
compound = ${ word ~ word }
nonatomic = !{ word ~ word }
outer_atomic = @{ word ~ compound ~ nonatomic ~ word }
main = { SOI ~ (word | "b")* ~ EOI }
single = { word }
sequence = { SOI ~ silent ~ word ~ EOI }
repeat = { word* }
bounded = { SOI ~ word{1,3} ~ EOI }
optional = { SOI ~ word? ~ EOI }
peek = { SOI ~ &word ~ word ~ !word ~ EOI }
rollback = { (word ~ "x" | word) ~ EOI }
stack = @{ PUSH("a") ~ (POP ~ "x" | POP) ~ EOI }
predicate_stack = @{ PUSH("a") ~ &POP ~ POP ~ EOI }
push_stack = @{ &PUSH("a") ~ "a" ~ !DROP ~ EOI }
repeat_stack = @{ PUSH("a") ~ (POP ~ "x")* ~ POP ~ EOI }
slice = @{ PUSH("a") ~ PUSH("b") ~ PEEK[0..] ~ PEEK[-1..] ~ PEEK_ALL ~ POP_ALL ~ EOI }
literal = @{ ^"IF" ~ 'α'..'ω' ~ ANY ~ EOI }
newline = @{ "a" ~ NEWLINE ~ "b" ~ EOI }

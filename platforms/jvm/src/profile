# `java.*` — the JDK surface, declared ONCE for every language.
#
# Moved verbatim out of `languages/java/src/profile` (javakotlinmigration.md).
# A language reaches these through the COMMON RESOLVER by declaring tree
# data in its own profile (`type_scopes` + `kind = "tree-ambient"`), exactly
# as csharp/vb reach `dotnet.*` with zero `System.*` entries of their own.

# `parse_profile` requires these two sections; a platform fragment has no
# language of its own, so they are inert placeholders. The DATA is below.
[info]
name = "jvm"
extensions = []

[compiler]

[builtins]

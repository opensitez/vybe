*> vybe-test: cobol/string_and_unstring_extended/unstring_with_count_in_reports_token_lengths
*> origin: languages/cobol/tests/cobol/test_string_and_unstring_extended.rs
IDENTIFICATION DIVISION.
PROGRAM-ID. T.
DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-SRC PIC X(12) VALUE "AA,BBB".
01 WS-F1 PIC X(5) VALUE SPACES.
01 WS-F2 PIC X(5) VALUE SPACES.
01 WS-C1 PIC 9(2) VALUE 0.
01 WS-C2 PIC 9(2) VALUE 0.
01 WS-VYBE-L PIC X(256).
PROCEDURE DIVISION.

    UNSTRING WS-SRC DELIMITED BY ","
        INTO WS-F1 COUNT IN WS-C1
             WS-F2 COUNT IN WS-C2.
    DISPLAY WS-F1.
    MOVE SPACES TO WS-VYBE-L
    STRING WS-F1 DELIMITED SIZE INTO WS-VYBE-L
    IF WS-VYBE-L NOT = "AA   "
        DISPLAY "FAIL: want [AA   ] got [" WS-VYBE-L "]"
        MOVE 1 TO RETURN-CODE
        RAISE EXCEPTION EC-PROGRAM
    END-IF.
    DISPLAY WS-F2.
    MOVE SPACES TO WS-VYBE-L
    STRING WS-F2 DELIMITED SIZE INTO WS-VYBE-L
    IF WS-VYBE-L NOT = "BBB  "
        DISPLAY "FAIL: want [BBB  ] got [" WS-VYBE-L "]"
        MOVE 1 TO RETURN-CODE
        RAISE EXCEPTION EC-PROGRAM
    END-IF.
    DISPLAY WS-C1.
    MOVE SPACES TO WS-VYBE-L
    STRING WS-C1 DELIMITED SIZE INTO WS-VYBE-L
    IF WS-VYBE-L NOT = "02"
        DISPLAY "FAIL: want [02] got [" WS-VYBE-L "]"
        MOVE 1 TO RETURN-CODE
        RAISE EXCEPTION EC-PROGRAM
    END-IF.
    DISPLAY WS-C2.
    MOVE SPACES TO WS-VYBE-L
    STRING WS-C2 DELIMITED SIZE INTO WS-VYBE-L
    IF WS-VYBE-L NOT = "09"
        DISPLAY "FAIL: want [09] got [" WS-VYBE-L "]"
        MOVE 1 TO RETURN-CODE
        RAISE EXCEPTION EC-PROGRAM
    END-IF.
    STOP RUN.


// Calculator — a Flutter app built from Dart.
//
// To Dart source this is ordinary Flutter (`MaterialApp`, `Scaffold`,
// `Column`, `ElevatedButton`, `Text`, `setState`); under the hood the Vybe
// `flutter` platform adapter drives the same `vybe_widgets` runtime the
// WinForms/VCL adapters use — same common resolver, no Flutter-specific host.
import 'package:flutter/material.dart';

void main() {
  runApp(const CalculatorApp());
}

class CalculatorApp extends StatelessWidget {
  const CalculatorApp();

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'Calculator',
      home: const CalculatorPage(),
    );
  }
}

class CalculatorPage extends StatefulWidget {
  const CalculatorPage();

  @override
  State<CalculatorPage> createState() => _CalculatorPageState();
}

class _CalculatorPageState extends State<CalculatorPage> {
  String current = "0";
  String previous = "";
  String operator = "";
  bool resetNext = false;

  void pressDigit(String d) {
    setState(() {
      if (resetNext) {
        current = d;
        resetNext = false;
      } else if (current == "0") {
        current = d;
      } else {
        current = current + d;
      }
    });
  }

  void calculate() {
    if (previous == "" || operator == "") {
      return;
    }
    final a = double.tryParse(previous) ?? 0.0;
    final b = double.tryParse(current) ?? 0.0;
    var result = 0.0;
    if (operator == "+") {
      result = a + b;
    } else if (operator == "-") {
      result = a - b;
    } else if (operator == "*") {
      result = a * b;
    } else if (operator == "/") {
      if (b == 0) {
        setState(() {
          current = "Error";
          previous = "";
          operator = "";
          resetNext = true;
        });
        return;
      }
      result = a / b;
    }
    setState(() {
      current = "$result";
      previous = "";
      operator = "";
      resetNext = true;
    });
  }

  void pressOperator(String op) {
    if (previous != "" && !resetNext) {
      calculate();
    }
    setState(() {
      previous = current;
      operator = op;
      resetNext = true;
    });
  }

  void pressClear() {
    setState(() {
      current = "0";
      previous = "";
      operator = "";
      resetNext = false;
    });
  }

  Widget buildButton(String label) {
    return Expanded(
      child: Padding(
        padding: const EdgeInsets.all(4.0),
        child: ElevatedButton(
          onPressed: () {
            if (label == "C") {
              pressClear();
            } else if (label == "=") {
              calculate();
            } else if (label == "+" ||
                label == "-" ||
                label == "*" ||
                label == "/") {
              pressOperator(label);
            } else {
              pressDigit(label);
            }
          },
          child: Text(label),
        ),
      ),
    );
  }

  Widget buildRow(List<String> labels) {
    return Expanded(
      child: Row(
        children: [
          for (final label in labels) buildButton(label),
        ],
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('Calculator')),
      body: Column(
        children: [
          Container(
            alignment: Alignment.centerRight,
            padding: const EdgeInsets.all(24.0),
            child: Text(current),
          ),
          buildRow(["7", "8", "9", "/"]),
          buildRow(["4", "5", "6", "*"]),
          buildRow(["1", "2", "3", "-"]),
          buildRow(["C", "0", "=", "+"]),
        ],
      ),
    );
  }
}

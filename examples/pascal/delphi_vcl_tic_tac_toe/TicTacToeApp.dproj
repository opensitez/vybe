<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{5BFA0ECB-CFF5-42E1-9E3D-1D4D4990A03E}</ProjectGuid>
    <MainSource>TicTacToeApp.dpr</MainSource>
    <Config Condition="'$(Config)'==''">Debug</Config>

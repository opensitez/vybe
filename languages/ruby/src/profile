# Ruby Compiler Profile
# ─────────────────────
# Port of vybe_compiler_ruby — maximizes compiler_common, stdlib, intrinsics,
# and opcodes. host: calls are ONLY used when no common/stdlib/opcode exists.

[info]
name = "ruby"
extensions = ["rb"]

[compiler]
function_return = "explicit"
self_keyword = "self"
constructor_name = "initialize"
# namespaceplan.md: namespace-shaped entry points resolve through the
# common resolver — same flip as JS/PHP/dotnet/dart/java/python.
uses_common_resolver = true
enum_as_ordinals = false
case_sensitive = true
string_indexing = "zero_based"
base_keyword = "super"
dynamic_add = true
# Ruby is over wasm/js — `h[key]` must dispatch polymorphically (Map/Object
# property get for string/hash keys, array index for ints). Without this,
# `h["a"]` numeric-coerces the string key → `toF64` crash on every Hash read.
dynamic_member_access = true
# Route `==` through `ecma:value:abstractEq` (host → real boxed Boolean), the
# same mechanism JS uses (JS is over wasm/js too). Without it Ruby `==` returns
# a raw i32 that prints "1"/"0" instead of "true"/"false".
abstract_equality = true
throwable_is_root = true
# Ruby `arr[-1]` returns the last element (same idiom as Python).
# Also applies to strings: `"hello"[-1]` → "o".
negative_index_wraps = true
# Same idiom as Python: `return a, b` / `x, y = f()` → WASM multi-value.
# Ruby's walker emits a `Tuple` AST node (not `Array`) for multi-expr
# returns specifically so the compiler pre-scan recognises the pattern.
# Non-destructure callers (`r = f()`) get the N values auto-repacked
# into an array by `compile_expr` for `Call`, preserving Ruby semantics.
multi_value_tuple_returns = true
# Route `class` declarations through common::classes::normalize_class
# + emit_class (see classnormalization.md).
uses_normalize_class = true

# ────────────────────────────────────────────────────────────────────────────
# BUILTINS — bare global function calls
# ────────────────────────────────────────────────────────────────────────────

[builtins]


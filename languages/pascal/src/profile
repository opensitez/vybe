# ── Control flow ─────────────────────────────────────────────────────────────

# `Halt` / `Halt(code)` ends the program from any depth and carries the status.
# `wasi:cli/exit` is the interface name (`wasi:cli` matches no registration) and
# `exit-with-code` is the arm that takes a number — plain `exit` takes a
# result<(),()> and can only say 0 or 1.
#
# This lived below `[array_methods]` together with `free`/`freeandnil`/`new`/
# `dispose`/`assert`/`exit`: that header was inserted mid-file, so the whole
# block stopped being a builtin declaration and `halt(2)` resolved to nothing.
# Only `halt` is moved here — the other six are equally stranded but changing
# what they emit is a separate, unmeasured change.
halt          = { emit = "common:control_flow.exit", min_args = 0, max_args = 1 }

[array_methods]
reduce        = "__array_reduce"

# Delphi's `Generics.Collections` spellings that are HIGHER-ORDER or search —
# this table's dispatch only has arms for those. The plain methods carry an
# emit target and an arity instead, so they live in `[value_methods]` below.
sort          = "__array_sort"


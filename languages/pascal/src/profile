# Pascal / Object Pascal Compiler Profile
# ────────────────────────────────────────
# Full port of vybe_compiler_pascal builtins — I/O, math, string, type,
# array, conversion, and object lifecycle functions.

[info]
name = "pascal"
extensions = ["pas", "pp", "dpr", "lpr"]

[compiler]
function_return = "result_slot"        # Pascal uses Result := value
self_keyword = "self"
base_keyword = "inherited"
# namespaceplan.md: namespace-shaped entry points resolve through the
# common resolver; the plib.* GCL surface is registered in the global
# tree (platforms/plib/emitter/tree_register.rs).
uses_common_resolver = true
constructor_name = "Create"            # constructor Create;
enum_as_ordinals = true                # enums are ordinal values in Pascal
case_sensitive = false                 # Pascal is case-insensitive
string_indexing = "one_based"          # Pascal strings are 1-based
array_upper_bound_inclusive = true     # array[0..5] means 0..5 inclusive
parens_for_index = false               # Pascal uses [] for indexing, not ()
entry_point = "main"                   # program body is the entry point
hoist_var = false
# Pascal `+` is overloaded: string concat (`'a' + 'b'`) AND numeric addition.
# DYN_ADD checks for string operands first; F64_ADD would coerce strings
# to NaN. Object Pascal / Delphi / Free Pascal all expose this overload.
dynamic_add = true
materialize_bool_results = true
commonjs_require = false
byref_boxing = false
# Route `class` declarations through common::classes::normalize_class
# + emit_class (see classnormalization.md). Pascal `constructor Create`
# / `destructor Destroy` / `class operator Add` all canonicalise.
uses_normalize_class = true
with_block = true                      # with obj do begin ... end
new_with_initializer = false
new_from_initializer = false
linq_queries = false

# ────────────────────────────────────────────────────────────────────────────
# BUILTINS — every function/procedure the Pascal compiler knows about
# ────────────────────────────────────────────────────────────────────────────

[builtins]

# ── I/O ──────────────────────────────────────────────────────────────────────

writeln       = { emit = "print",                          min_args = 0, max_args = 255 }
write         = { emit = "print",                          min_args = 0, max_args = 255 }
readln        = { emit = "host:wasi:cli:readLine",         min_args = 0, max_args = 1 }
read          = { emit = "host:wasi:cli:readLine",         min_args = 0, max_args = 1 }
eof           = { emit = "common:pascal.file_eof",          min_args = 1, max_args = 1 }
fileexists    = { emit = "host:wasi:filesystem:exists",     min_args = 1, max_args = 1 }
flush         = { emit = "noop",                            min_args = 1, max_args = 1 }
__pascal_file_open      = { emit = "host:wasi:filesystem:openFile",          min_args = 3, max_args = 3 }
__pascal_file_close     = { emit = "host:wasi:filesystem:closeFile",         min_args = 1, max_args = 1 }
__pascal_file_println   = { emit = "host:wasi:filesystem:printFile",         min_args = 1, max_args = 255 }
__pascal_file_writeln   = { emit = "host:wasi:filesystem:printFile",         min_args = 1, max_args = 255 }
__pascal_file_writecsv  = { emit = "host:wasi:filesystem:writeFile_handle",  min_args = 1, max_args = 255 }
__pascal_file_readline  = { emit = "host:wasi:filesystem:lineInput",         min_args = 1, max_args = 1 }
__pascal_file_readcsv   = { emit = "host:wasi:filesystem:inputFile",         min_args = 1, max_args = 1 }
__pascal_file_exists    = { emit = "host:wasi:filesystem:exists",            min_args = 1, max_args = 1 }
__pascal_file_remove    = { emit = "host:wasi:filesystem:remove",            min_args = 1, max_args = 1 }
__pascal_file_rename    = { emit = "host:wasi:filesystem:rename",            min_args = 2, max_args = 2 }
__pascal_file_flush     = { emit = "noop",                                   min_args = 1, max_args = 1 }

# ── Math — WASM opcodes (zero overhead) ─────────────────────────────────────

abs           = { emit = "opcode:f64_abs",                 min_args = 1, max_args = 1 }
sqrt          = { emit = "opcode:f64_sqrt",                min_args = 1, max_args = 1 }
round         = { emit = "opcode:f64_nearest",             min_args = 1, max_args = 1 }
trunc         = { emit = "opcode:f64_trunc",               min_args = 1, max_args = 1 }
int           = { emit = "opcode:f64_trunc",               min_args = 1, max_args = 1 }
floor         = { emit = "opcode:f64_floor",               min_args = 1, max_args = 1 }
ceil          = { emit = "opcode:f64_ceil",                min_args = 1, max_args = 1 }
min           = { emit = "opcode:f64_min",                 min_args = 2, max_args = 2 }
max           = { emit = "opcode:f64_max",                 min_args = 2, max_args = 2 }

# ── Math — host calls ───────────────────────────────────────────────────────

sin           = { emit = "host:ecma:math:sin",             min_args = 1, max_args = 1 }
cos           = { emit = "host:ecma:math:cos",             min_args = 1, max_args = 1 }
tan           = { emit = "host:ecma:math:tan",             min_args = 1, max_args = 1 }
arctan        = { emit = "host:ecma:math:atan",            min_args = 1, max_args = 1 }
arctan2       = { emit = "host:ecma:math:atan2",           min_args = 2, max_args = 2 }
exp           = { emit = "host:ecma:math:exp",             min_args = 1, max_args = 1 }
ln            = { emit = "host:ecma:math:log",             min_args = 1, max_args = 1 }
power         = { emit = "host:ecma:math:pow",             min_args = 2, max_args = 2 }
random        = { emit = "host:ecma:math:random",          min_args = 0, max_args = 0 }
randomize     = { emit = "noop",                           min_args = 0, max_args = 0 }

# ── Math — intrinsics (multi-opcode) ────────────────────────────────────────

sqr           = { emit = "intrinsic:sqr",                  min_args = 1, max_args = 1 }

# ── String functions (use compiler_common::strings) ─────────────────────────

length        = { emit = "common:strings.length",          min_args = 1, max_args = 1 }
upcase        = { emit = "common:strings.to_upper",        min_args = 1, max_args = 1 }
uppercase     = { emit = "common:strings.to_upper",        min_args = 1, max_args = 1 }
lowercase     = { emit = "common:strings.to_lower",        min_args = 1, max_args = 1 }
trim          = { emit = "common:strings.trim",            min_args = 1, max_args = 1 }
trimleft      = { emit = "common:str_trim_start",          min_args = 1, max_args = 1 }
trimright     = { emit = "common:str_trim_end",            min_args = 1, max_args = 1 }

# ── String functions — intrinsics (multi-opcode) ────────────────────────────

pos           = { emit = "intrinsic:pos",                  min_args = 2, max_args = 2 }
copy          = { emit = "intrinsic:copy",                 min_args = 2, max_args = 3 }

# ── String functions — host calls ───────────────────────────────────────────

concat        = { emit = "intrinsic:str_concat",            min_args = 1, max_args = 255 }
chr           = { emit = "host:ecma:string:fromCharCode",  min_args = 1, max_args = 1 }
ord           = { emit = "common:pascal.ord",              min_args = 1, max_args = 1 }
__pascal_set_length = { emit = "common:pascal.set_length", min_args = 1, max_args = 1 }
__vybe_pascal_set_contains = { emit = "host:ecma:set:has", min_args = 2, max_args = 2 }
__vybe_pascal_set_include = { emit = "host:ecma:set:add", min_args = 2, max_args = 2 }
__vybe_pascal_set_exclude = { emit = "host:ecma:set:delete", min_args = 2, max_args = 2 }
__vybe_pascal_set_union = { emit = "host:ecma:set:union", min_args = 2, max_args = 2 }
__vybe_pascal_set_intersection = { emit = "host:ecma:set:intersection", min_args = 2, max_args = 2 }
__vybe_pascal_set_difference = { emit = "host:ecma:set:difference", min_args = 2, max_args = 2 }
__vybe_pascal_set_symmetric_difference = { emit = "host:ecma:set:symmetricDifference", min_args = 2, max_args = 2 }
__vybe_pascal_set_subset = { emit = "host:ecma:set:isSubsetOf", min_args = 2, max_args = 2 }
__vybe_pascal_set_superset = { emit = "host:ecma:set:isSupersetOf", min_args = 2, max_args = 2 }
__pascal_int_xor = { emit = "common:pascal.int_xor",       min_args = 2, max_args = 2 }
format        = { emit = "common:sprintf.format",          min_args = 1, max_args = 255 }
stringreplace = { emit = "common:strings.replace",         min_args = 3, max_args = 4 }
stringofchar  = { emit = "common:str_repeat",              min_args = 2, max_args = 2 }
leftstr       = { emit = "intrinsic:leftstr",              min_args = 2, max_args = 2 }
rightstr      = { emit = "intrinsic:rightstr",             min_args = 2, max_args = 2 }
comparestr    = { emit = "host:ecma:string:localeCompare",       min_args = 2, max_args = 2 }
comparetext   = { emit = "host:ecma:string:localeCompare",       min_args = 2, max_args = 2 }
delete        = { emit = "common:pascal.str_remove_range", min_args = 3, max_args = 3 }
insert        = { emit = "common:pascal.str_insert",       min_args = 3, max_args = 3 }

# ── Type conversion ─────────────────────────────────────────────────────────

inttostr      = { emit = "common:pascal.tostring", min_args = 1, max_args = 1 }
floattostr    = { emit = "common:pascal.tostring", min_args = 1, max_args = 1 }
strtoint      = { emit = "host:ecma:number:parseInt",     min_args = 1, max_args = 1 }
strtointdef   = { emit = "host:ecma:number:parseInt",     min_args = 1, max_args = 2 }
strtofloat    = { emit = "host:ecma:number:parseFloat",   min_args = 1, max_args = 1 }
booltostr     = { emit = "common:pascal.tostring", min_args = 1, max_args = 1 }
strtobool     = { emit = "common:dyn_to_bool",             min_args = 1, max_args = 1 }
stringtoguid  = { emit = "common:pascal.string_to_guid",   min_args = 1, max_args = 1 }
guidtostring  = { emit = "common:pascal.guid_to_string",   min_args = 1, max_args = 1 }
isequalguid   = { emit = "common:pascal.is_equal_guid",    min_args = 2, max_args = 2 }

# ── Date/time ───────────────────────────────────────────────────────────────

now           = { emit = "host:ecma:date:now",             min_args = 0, max_args = 0 }
__pascal_date_utc    = { emit = "host:ecma:date:UTC",       min_args = 3, max_args = 7 }
__pascal_date_year   = { emit = "host:ecma:date:getUTCFullYear", min_args = 1, max_args = 1 }
__pascal_date_month  = { emit = "host:ecma:date:getUTCMonth",    min_args = 1, max_args = 1 }
__pascal_date_day    = { emit = "host:ecma:date:getUTCDate",     min_args = 1, max_args = 1 }
__pascal_date_weekday = { emit = "host:ecma:date:getUTCDay",     min_args = 1, max_args = 1 }
__pascal_date_hour   = { emit = "host:ecma:date:getUTCHours",    min_args = 1, max_args = 1 }
__pascal_date_minute = { emit = "host:ecma:date:getUTCMinutes",  min_args = 1, max_args = 1 }
__pascal_date_second = { emit = "host:ecma:date:getUTCSeconds",  min_args = 1, max_args = 1 }
__pascal_date_millisecond = { emit = "host:ecma:date:getUTCMilliseconds", min_args = 1, max_args = 1 }
__pascal_abs       = { emit = "opcode:f64_abs",             min_args = 1, max_args = 1 }

# ── Ordinal / increment / decrement ─────────────────────────────────────────

inc           = { emit = "mutate:add",                     min_args = 1, max_args = 2 }
dec           = { emit = "mutate:sub",                     min_args = 1, max_args = 2 }
succ          = { emit = "intrinsic:succ",                 min_args = 1, max_args = 1 }
pred          = { emit = "intrinsic:pred",                 min_args = 1, max_args = 1 }

# ── Type info ────────────────────────────────────────────────────────────────

high          = { emit = "intrinsic:high",                 min_args = 1, max_args = 1 }
low           = { emit = "intrinsic:low",                  min_args = 1, max_args = 1 }
assigned      = { emit = "intrinsic:assigned",             min_args = 1, max_args = 1 }
sizeof        = { emit = "intrinsic:sizeof",               min_args = 1, max_args = 1 }
classname     = { emit = "intrinsic:classname",            min_args = 1, max_args = 1 }
typename      = { emit = "intrinsic:classname",            min_args = 1, max_args = 1 }

# ── Array operations ─────────────────────────────────────────────────────────

append        = { emit = "host:ecma:array:push",           min_args = 2, max_args = 2 }
__pascal_array_slice  = { emit = "host:ecma:array:slice",  min_args = 3, max_args = 3 }
__pascal_array_concat = { emit = "host:ecma:array:concat", min_args = 2, max_args = 2 }
__pascal_structured_clone = { emit = "host:ecma:structured-clone:clone", min_args = 1, max_args = 1 }
sort          = { emit = "common:pascal.sort_in_place",   min_args = 1, max_args = 1 }
reverse       = { emit = "host:ecma:array:reverse",        min_args = 1, max_args = 1 }

# ── Object lifecycle ─────────────────────────────────────────────────────────

free          = { emit = "noop",                           min_args = 1, max_args = 1 }
freeandnil    = { emit = "noop",                           min_args = 1, max_args = 1 }
new           = { emit = "noop",                           min_args = 1, max_args = 1 }
dispose       = { emit = "noop",                           min_args = 1, max_args = 1 }

# ── Control flow ─────────────────────────────────────────────────────────────

halt          = { emit = "host:wasi:cli:exit",             min_args = 0, max_args = 1 }
assert        = { emit = "noop",                           min_args = 1, max_args = 2 }
exit          = { emit = "noop",                           min_args = 0, max_args = 0 }

# ────────────────────────────────────────────────────────────────────────────
# INTRINSIC DEFINITIONS — multi-opcode sequences
# ────────────────────────────────────────────────────────────────────────────

[intrinsics]

# Sqr(x) → x * x (square, NOT square root)
sqr = "dup, f64_mul"

# Succ(x) → x + 1
succ = "const_f64(1), dyn_add"

# Pred(x) → x - 1
pred = "const_f64(1), f64_sub"

# High(arr) → Length(arr) - 1
high = "array_len, const_i32(1), i32_sub"

# Low(arr) → 0 (always 0 for dynamic arrays)
low = "const_i32(0)"

# Assigned(x) → x is not null
assigned = "ref_is_null, dyn_not"

# SizeOf(x) → always 4 in our VM (everything is a boxed value)
sizeof = "drop, const_i32(4)"

# ClassName(obj) → obj.__type
classname = "const_str(__type), struct_get"

# Pos(substr, s) → IndexOf + 1 (Pascal 1-based)
pos = "str_index_of, const_i32(1), i32_add"

# Copy(s, start, len) → substring adjusted for 1-based indexing
copy = "mid_1based"

# LeftStr(s, count) → substring(s, 0, count)
leftstr = "const_i32(0), swap, to_int, str_substring"

# RightStr(s, count) → substring(s, len-count, count)
rightstr = "dup, str_length, swap, to_int, f64_sub, swap, to_int, str_substring"

# ────────────────────────────────────────────────────────────────────────────
# VALUE METHODS — instance methods called on Pascal objects
# ────────────────────────────────────────────────────────────────────────────

[value_methods]
# Pascal doesn't have significant value methods — most operations are
# free functions. But TStringList etc. may use some.
free          = { emit = "noop",                           min_args = 0, max_args = 0 }
tostring      = { emit = "common:pascal.tostring", min_args = 0, max_args = 0 }

# ────────────────────────────────────────────────────────────────────────────
# NAMESPACE CONSTANTS — identifier-level constants (no function call)
# ────────────────────────────────────────────────────────────────────────────

[namespace_constants]
"maxint"      = 2147483647
"pi"          = 3.141592653589793

# ────────────────────────────────────────────────────────────────────────────
# ESM DEFAULTS — Pascal has no ambient host module imports.
# ────────────────────────────────────────────────────────────────────────────

# ────────────────────────────────────────────────────────────────────────────
# NAMESPACE CONFIG
# ────────────────────────────────────────────────────────────────────────────

[namespaces]

# Namespace-tree roots this language resolves platform types against, and
# mounts ambiently so unqualified names resolve to their `Type` node.
type_scopes = ["plib"]
use_dotnet = false

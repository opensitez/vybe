SameText      = { emit = "common:pascal.same_text",       min_args = 2, max_args = 2 }
CompareText   = { emit = "common:pascal.compare_text",    min_args = 2, max_args = 2 }
StrToBool     = { emit = "common:pascal.str_to_bool",     min_args = 1, max_args = 1 }
StrToIntDef   = { emit = "common:pascal.str_to_int_def",  min_args = 2, max_args = 2 }

new           = { emit = "noop",                           min_args = 1, max_args = 1 }
dispose       = { emit = "noop",                           min_args = 1, max_args = 1 }

# ── Control flow ─────────────────────────────────────────────────────────────

# (`halt` moved up into [builtins]; see the note there. These two are still
# stranded under [array_methods] and declare nothing.)
assert        = { emit = "noop",                           min_args = 1, max_args = 2 }
exit          = { emit = "noop",                           min_args = 0, max_args = 0 }

# ────────────────────────────────────────────────────────────────────────────
# INTRINSIC DEFINITIONS — multi-opcode sequences
# ────────────────────────────────────────────────────────────────────────────

[intrinsics]

# Sqr(x) → x * x (square, NOT square root)
sqr = "dup, f64_mul"

# Succ(x) → x + 1
succ = "const_f64(1), dyn_add"

# Pred(x) → x - 1
pred = "const_f64(1), f64_sub"

# High(arr) → Length(arr) - 1
high = "array_len, const_i32(1), i32_sub"

# Low(arr) → 0 (always 0 for dynamic arrays)
low = "const_i32(0)"

# Assigned(x) → x is not null
assigned = "ref_is_null, dyn_not"

# SizeOf(x) → always 4 in our VM (everything is a boxed value)
sizeof = "drop, const_i32(4)"

# ClassName(obj) → obj.__type
classname = "const_str(__type), struct_get"

# Pos(substr, s) → IndexOf + 1 (Pascal 1-based)
pos = "str_index_of, const_i32(1), i32_add"

# Copy(s, start, len) → substring adjusted for 1-based indexing
copy = "mid_1based"

# LeftStr(s, count) → substring(s, 0, count)
leftstr = "const_i32(0), swap, to_int, str_substring"

# RightStr(s, count) → substring(s, len-count, count)
rightstr = "dup, str_length, swap, to_int, f64_sub, swap, to_int, str_substring"

# ────────────────────────────────────────────────────────────────────────────
# VALUE METHODS — instance methods called on Pascal objects
# ────────────────────────────────────────────────────────────────────────────

[value_methods]
# Pascal doesn't have significant value methods — most operations are
# free functions. But TStringList etc. may use some.
free          = { emit = "noop",                           min_args = 0, max_args = 0 }
tostring      = { emit = "common:pascal.tostring", min_args = 0, max_args = 0 }

# `slot = "len"` says Delphi's `Count` fills the shared Len slot — the same one
# Dart's `length`, Kotlin's `size` and Python's `len()` fill. A spelling, bound;
# not a method the common layer has to know the name of.
count         = { emit = "common:collections.length", min_args = 0, max_args = 0, slot = "len" }


# ────────────────────────────────────────────────────────────────────────────
# NAMESPACE CONSTANTS — identifier-level constants (no function call)
# ────────────────────────────────────────────────────────────────────────────

[namespace_constants]
"maxint"      = 2147483647
"pi"          = 3.141592653589793
"ntelement"   = 1

# TAlign — the values `Align` takes. Spelled as the ROLE's vocabulary rather
# than Delphi's ordinals (alNone=0 … alClient=5) so that nothing downstream has
# to know VCL's enum order: `Align := alClient` reaches `vybe_widgets` as the
# dock keyword `fill`, which is the same word WinForms' `Dock.Fill` produces.
"alnone"      = "none"
"altop"       = "top"
"albottom"    = "bottom"
"alleft"      = "left"
"alright"     = "right"
"alclient"    = "fill"

# ────────────────────────────────────────────────────────────────────────────
# ESM DEFAULTS — Pascal has no ambient host module imports.
# ────────────────────────────────────────────────────────────────────────────

# ────────────────────────────────────────────────────────────────────────────
# NAMESPACE CONFIG
# ────────────────────────────────────────────────────────────────────────────

[namespaces]

# Namespace-tree roots this language resolves platform types against, and
# mounts ambiently so unqualified names resolve to their `Type` node.
# `pascal` is this language's OWN root — the `SysUtils` exception family,
# registered by `exceptions::register_namespace_tree` through the
# `LanguageDef.register_tree` hook. Declared here rather than synthesized as
# source, so `EDivByZero.Create(msg)` reaches `primitives/errors.rs` and the
# object carries the shared stamps a cross-language `catch` matches on.
type_scopes = ["plib", "pascal"]

# Which built-in each of this language's type spellings NAMES — step 4a.
#
# `set of TD` was `Compiler::is_pascal_set_type_hint` in shared compiler code:
# a per-language spelling table in a crate that serves twelve languages. The
# trailing `*` is a prefix match and both sides normalize with
# `trim().to_lowercase()`, so this is the same predicate, owned by the language.
[builtin_types]
set = ["set of *"]
# `TList` IS the shared ordered-sequence store — the same built-in .NET's
# `List<T>`, Python's list and a JS Array name. Declared HERE, as this
# language's spelling for it, rather than registered as a type node under a
# lexical name: identity is structural, and the trailing `*` prefix-match is
# what makes `TList<Integer>` the same built-in as `TList` without the shared
# resolver ever learning what a generic argument list looks like.
#
# This replaces 250 lines of synthesized Pascal that re-implemented `push`,
# `insert` and `remove_at` as grow-and-shift loops.
array = ["tlist", "tobjectlist"]
# `TDictionary` IS the shared Map — the same store a PHP array and a Python
# dict land on. It has to be declared here and not only as a tree type,
# because `Count` reaches the shared Len slot by SPELLING (see
# `[value_methods]`), and without a receiver type that lookup answers with the
# array's length on a Map and reports 0.
map = ["tdictionary"]
# Pascal's `char` holds a CHARACTER — its default value is `''`, `Ord`/`Chr`
# round-trip through it, and `s[i]` yields one of them. The C family's `char` is
# an 8-bit integer and gets a modular byte coercion the shared compiler used to
# skip for Pascal by NAME. Listed first, so it wins over the platform table's
# `char -> Char` row for this language only.
string = ["char"]

# ── Protocol slot bindings — builtinslotplan.md §2a ────────────────────────
#
# `x in s` on a Pascal set. The shared emitter used to reach this through a
# literal `profile.name == "pascal"` check that called the
# `__vybe_pascal_set_contains` global; that global's entire body is
# `common:sets.has` with its two arguments swapped, and the shared `in` path
# already pushes `(collection, value)` in the order this wants.
#
# Declared here rather than defaulted centrally because `in` means different
# things per language: on the ECMA profiles it is a KEY test
# (`ecma:object.hasOwn`, ECMA-262 §13.10.1), and only a language that means
# VALUE membership opts in.
# Pascal's string conversion, read by the concat operator and by string
# interpolation — the same one binding, two consumers.
#
# Declaring it is what lets `'' + obj` reach a CLASS's own conversion: the
# emitter behind this key probes the `ToString` protocol slot and only falls
# back to the platform coercion when nothing binds it. Without the binding the
# shared default coerced a class instance numerically and trapped as
# `wasm:js-number.toF64 — not a number`, which is what `WriteLn(dt.ToString)`
# failed with while `dt.ToString()` worked.
[builtin_slots.string]
to_string = "common:pascal.to_string_slot"

[builtin_slots.set]
contains = "common:sets.has"

# `x in a` where `a` is NOT a set — an array or string. Pascal's `in` means
# VALUE membership; the ECMA profiles' `in` is a KEY test (`ecma:object.hasOwn`,
# ECMA-262 13.10.1) and they declare nothing here, so they are unaffected.
[builtin_slots.array]
contains = "common:collections.contains"

# `TDictionary` is an `ObjectKind::Map`, and the platform default for a Map's
# Len slot is `common:dict.size` — the older Ordinary+`__keys` helper, which
# answers 0 on a real Map without erroring. `Count` carries `slot = "len"`, so
# without this override it re-resolves onto exactly that. See the note above
# the dictionary emitters in `emitter/runtime_adapter.rs`.
[builtin_slots.map]
len = "common:pascal.dict_size"
contains = "common:pascal.dict_has"

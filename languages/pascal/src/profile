# SysUtils path helpers. `wasi:filesystem` already answers all of these and is
# the same host every other language's path functions go through — there is no
# second path parser. Only `ExtractFileExt` needs an adapter, because Delphi
# includes the dot and a path component does not.
ExtractFileName = { emit = "host:wasi:filesystem:pathGetFileName",     min_args = 1, max_args = 1 }
ExtractFileDir  = { emit = "host:wasi:filesystem:pathGetDirectory",    min_args = 1, max_args = 1 }

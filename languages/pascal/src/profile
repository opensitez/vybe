[builtins]

# ── I/O ──────────────────────────────────────────────────────────────────────

writeln       = { emit = "common:pascal.writeln",          min_args = 0, max_args = 255 }
# SysUtils / System stdlib. These were implemented inline in shared
# `builtins.rs`; they are pascal's stdlib, so they bind here like any builtin.
Integer       = { emit = "common:pascal.trunc_cast",      min_args = 1, max_args = 1 }
Int           = { emit = "common:pascal.trunc_cast",      min_args = 1, max_args = 1 }
LongInt       = { emit = "common:pascal.trunc_cast",      min_args = 1, max_args = 1 }

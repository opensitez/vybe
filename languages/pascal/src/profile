BoolToStr     = { emit = "common:pascal.bool_to_str",     min_args = 1, max_args = 2 }
AnsiUpperCase = { emit = "common:pascal.ansi_upper",      min_args = 1, max_args = 1 }
AnsiLowerCase = { emit = "common:pascal.ansi_lower",      min_args = 1, max_args = 1 }

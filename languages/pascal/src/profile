# Pascal / Object Pascal Compiler Profile
# ────────────────────────────────────────
# Full port of vybe_compiler_pascal builtins — I/O, math, string, type,
# array, conversion, and object lifecycle functions.

[info]
name = "pascal"
extensions = ["pas", "pp", "dpr", "lpr"]

[compiler]
# Declared types CONVERT the value they bind (assignment, declaration and
# parameter entry alike). Stated explicitly rather than inherited: the platform
# default is `true`, and inheriting it silently gave Python coercive semantics
# it never chose.
coerces_value_to_type_hint = true
# A bare reference to a parameterless function invokes it: `X := Foo;` calls
# `Foo`. Was a `profile.name == "pascal"` check in shared `expressions.rs`.
bare_name_invokes_parameterless_function = true
# Pascal spells concatenation `+`, which is `BinOp::Add` and arithmetic. The
# walker emits `BinOp::Concat` for ONE thing — stringifying a receiver for
# `X.ToString` — and this flag is what makes that node resolve a `to_string`
# binding per operand instead of coercing numerically. Nothing else in Pascal
# produces a `Concat` node, so this changes nothing that already worked.
concat_stringifies_operands = true
# `a xor b` is bitwise when both operands are integers and LOGICAL otherwise —
# one token, two meanings, resolved by operand type. Replaces a
# `profile.name == "pascal"` check in the shared binary-operator path
# (builtinslotplan.md §3c).
xor_is_logical_for_non_integers = true
# `and`/`or`/`not` are bitwise on integer operands, logical on booleans — the
# same dual meaning `xor` already declared. Was `profile.name == "pascal"` in
# shared `expressions.rs` and `type_inference.rs`.
logical_ops_bitwise_for_integers = true
# `+`/`*`/`-` on two sets are union/intersection/difference.
set_arithmetic_operators = true
# `TShape.Circle` and `obj.Method` invoke a parameterless routine without `()`.
member_invokes_parameterless_method = true
# A top-level `const X: T;` with no initializer declares a TYPE ALIAS.
const_without_init_is_type_alias = true
# `s[1]` is the first character; `Integer(9.7)` truncates to 9.
string_index_is_one_based = true
integer_cast_truncates = true
# `value.Helper(x)` resolves to a free function from the receiver's type, and a
# bare `Field(x)` calls a callable field of the enclosing class.
type_helper_methods = true
bare_class_field_is_callable = true
# Pascal RTTI (`TRttiType.GetProperty`, `GetAttributes`) reads a class's member
# list at runtime instead of the walker deriving it into a compile-time HashMap.
class_member_metadata = true
function_return = "result_slot"        # Pascal uses Result := value
self_keyword = "self"
base_keyword = "inherited"
# namespaceplan.md: namespace-shaped entry points resolve through the
# common resolver; the plib.* GCL surface is registered in the global
# tree (platforms/plib/emitter/tree_register.rs).
uses_common_resolver = true
constructor_name = "Create"            # constructor Create;
enum_as_ordinals = true                # enums are ordinal values in Pascal
case_sensitive = false                 # Pascal is case-insensitive
string_indexing = "one_based"          # Pascal strings are 1-based
array_upper_bound_inclusive = true     # array[0..5] means 0..5 inclusive
parens_for_index = false               # Pascal uses [] for indexing, not ()
entry_point = "main"                   # program body is the entry point
hoist_var = false
# Pascal `+` is overloaded: string concat (`'a' + 'b'`) AND numeric addition.
# DYN_ADD checks for string operands first; F64_ADD would coerce strings
# to NaN. Object Pascal / Delphi / Free Pascal all expose this overload.
dynamic_add = true
materialize_bool_results = true
commonjs_require = false
byref_boxing = false
# Route `class` declarations through common::classes::normalize_class
# + emit_class (see classnormalization.md). Pascal `constructor Create`
# / `destructor Destroy` / `class operator Add` all canonicalise.
uses_normalize_class = true
with_block = true                      # with obj do begin ... end
new_with_initializer = false
new_from_initializer = false
linq_queries = false


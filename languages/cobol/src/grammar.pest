// COBOL Grammar for pest parser
// Covers everything vybe_parser_cobol supports (1944-line parser, 407-line AST).
//
// COBOL is case-insensitive — all keywords use ^"keyword".
// Period (.) is a significant statement terminator, NOT whitespace.
// Identifiers may contain hyphens: WS-VAR-NAME.
// WHITESPACE includes spaces, tabs, and newlines (COBOL treats them equally).
// Inline comments start with *> and run to end of line.
// Expression precedence: NOT > AND > OR, then arithmetic +/- > */÷ > **.
// Figurative constants: SPACES, ZEROS, LOW-VALUES, HIGH-VALUES, QUOTES, NULLS.
// PIC strings are complex tokens: 9(5)V99, X(20), S9(5)COMP-3.
// EXEC SQL/CICS/DLI blocks are opaque (raw text between EXEC and END-EXEC).

// ── Whitespace and comments ─────────────────────────────────────────────────

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT    = _{ inline_comment | fixed_comment }
inline_comment = _{ "*>" ~ (!"\n" ~ ANY)* }
// Fixed-format: line starts with * in column 7 — simplified as * at line start
fixed_comment  = _{ "\n" ~ " "{0,6} ~ "*" ~ (!"\n" ~ ANY)* }

// ── Period (statement terminator) ───────────────────────────────────────────

period = { "." }

// ── Program (top-level) ────────────────────────────────────────────────────

program = {
    SOI
        ~ (
                class_unit
            | identification_division
                ~ environment_division?
                ~ data_division?
                ~ procedure_division?
                ~ nested_program*
                ~ end_program?
            | class_id_paragraph
            | interface_id_paragraph
        )+
    ~ EOI
}

// ⛔ A CLASS-ID / INTERFACE-ID unit must be matched BEFORE the program
// alternative. `identification_division` also accepts a class, and that
// alternative ends in `nested_program*` — which is itself
// `IDENTIFICATION DIVISION. PROGRAM-ID …`. So a program FOLLOWING a class was
// swallowed as the class's nested program, and a nested program never becomes
// the run unit: the file compiled and then printed NOTHING, silently. A class
// has no procedure division, so it can contain no nested program.
//
// Silent (`_`) so the walker keeps seeing `class_id_paragraph` /
// `interface_id_paragraph` at the top level, which it already handles.
class_unit = _{
    kw_identification ~ kw_division ~ period
    ~ (class_id_paragraph | interface_id_paragraph)
    ~ id_optional_paragraph*
}

// ── Identification Division ─────────────────────────────────────────────────

identification_division = {
    kw_identification ~ kw_division ~ period
    ~ ( program_id_paragraph
      | class_id_paragraph
      | interface_id_paragraph
      )
    ~ id_optional_paragraph*
}

program_id_paragraph = {
    kw_program_id ~ period ~ ident_or_keyword ~ program_id_options? ~ period
}

program_id_options = {
    kw_is? ~ program_id_option+
}

program_id_option = {
    kw_initial
  | kw_common
  | kw_recursive
}

class_id_paragraph = {
    kw_class_id ~ period ~ ident_or_keyword
    ~ inherits_clause?
    ~ implements_clause?
    ~ period
    ~ class_body
}

interface_id_paragraph = {
    kw_interface_id ~ period ~ ident_or_keyword
    ~ inherits_clause?
    ~ period
    ~ interface_body
}

inherits_clause = { kw_inherits ~ kw_from? ~ ident_name }

implements_clause = { kw_implements ~ ident_name ~ (","  ~ ident_name)* }

id_optional_paragraph = {
    kw_author ~ period ~ free_text ~ period
  | kw_date_written ~ period ~ free_text ~ period
}

// Free text until next period (skips everything that is not a period)
free_text = @{ (!("." | EOI) ~ ANY)* }

end_program = _{ kw_end_program ~ ident_or_keyword? ~ period? }

// ── Class body ──────────────────────────────────────────────────────────────

class_body = {
    environment_division?
    ~ data_division?
    ~ factory_paragraph?
    ~ object_paragraph?
    ~ procedure_division_class?
    ~ method_def*
    ~ kw_end_class ~ period? ~ ident_or_keyword? ~ period?
}

factory_paragraph = {
    identification_header? ~ kw_factory ~ period
    ~ data_division?
    ~ (kw_procedure ~ kw_division ~ period)?
    ~ method_def*
    ~ kw_end_factory ~ period?
}

// Each FACTORY / OBJECT may restate `IDENTIFICATION DIVISION.` ahead of itself.
identification_header = _{ kw_identification ~ kw_division ~ period }

object_paragraph = {
    identification_header? ~ kw_object ~ period
    ~ data_division?
    ~ (kw_procedure ~ kw_division ~ period)?
    ~ method_def*
    ~ kw_end_object ~ period?
}

procedure_division_class = {
    kw_procedure ~ kw_division ~ period
    ~ method_def*
}

// ── Interface body ──────────────────────────────────────────────────────────

interface_body = {
    (kw_procedure ~ kw_division ~ period)?
    ~ method_signature*
    ~ kw_end_interface ~ period? ~ ident_or_keyword? ~ period?
}

method_signature = {
    kw_method_id ~ period ~ ident_or_keyword ~ method_modifiers? ~ period
    ~ ( kw_procedure ~ kw_division
        ~ using_clause?
        ~ returning_clause?
        ~ period
      )?
    ~ kw_end_method ~ period? ~ ident_or_keyword? ~ period?
}

// ── Method definition ───────────────────────────────────────────────────────

method_def = {
    kw_method_id ~ period ~ ident_or_keyword ~ method_modifiers? ~ period
    ~ method_data_division?
    ~ method_local_section*
    ~ method_procedure_division?
    ~ kw_end_method ~ period? ~ ident_or_keyword? ~ period?
}

method_modifiers = { (kw_override | property_modifier)+ }

property_modifier = { kw_property ~ (kw_get | kw_set) }

method_data_division = {
    kw_data ~ kw_division ~ period
    ~ ( kw_linkage ~ kw_section ~ period ~ data_item* )?
    ~ ( kw_working_storage ~ kw_section ~ period ~ data_item* )?
}

method_local_section = {
        linkage_section
    | working_storage_section
    | local_storage_section
}

method_procedure_division = {
    kw_procedure ~ kw_division
    ~ using_clause?
    ~ returning_clause?
    ~ period
    ~ statement_list
    ~ procedure_block*
}

using_clause    = { kw_using ~ (kw_by? ~ (kw_reference | kw_content)? ~ ident_name)+ }
returning_clause = { kw_returning ~ ident_name }

// ── Environment Division ────────────────────────────────────────────────────

environment_division = {
    kw_environment ~ kw_division ~ period
    ~ configuration_section?
    ~ special_names_paragraph?
    ~ input_output_section?
}

configuration_section = {
    kw_configuration ~ kw_section ~ period
    ~ configuration_entry*
}

configuration_entry = {
    source_computer_paragraph
  | object_computer_paragraph
  | special_names_paragraph
  | repository_paragraph
}

source_computer_paragraph = { kw_source_computer ~ period ~ ident_or_keyword ~ (kw_with? ~ kw_debugging ~ kw_mode)? ~ period }
// OBJECT-COMPUTER names the machine plus optional clauses about it. Every one
// of them is DOCUMENTARY on a virtual machine — memory size and segment limits
// describe hardware that no longer exists, and the collating sequence names an
// alphabet from SPECIAL-NAMES. They still have to PARSE: the paragraph accepted
// a bare computer-name only, so `IBM-370 MEMORY SIZE 1024 WORDS.` was a syntax
// error in programs cobc compiles happily.
object_computer_paragraph = {
    kw_object_computer ~ period ~ ident_or_keyword ~ object_computer_clause* ~ period
}

object_computer_clause = {
    kw_memory ~ kw_size? ~ number_literal ~ (kw_words | kw_characters | kw_modules)?
  | kw_segment_limit ~ kw_is? ~ number_literal
  | kw_program? ~ kw_collating ~ kw_sequence ~ kw_is? ~ ident_or_keyword
}

// The paragraph is nominally ONE sentence, but every real compiler also accepts
// a period after each clause (`DECIMAL-POINT IS COMMA. CURRENCY SIGN IS '$'.`),
// which cobc compiles and this rule rejected at the first inner period.
special_names_paragraph = {
    kw_special_names ~ period
        ~ special_name_entry ~ (period? ~ special_name_entry)*
        ~ period
}

special_name_entry = {
    decimal_point_entry
  | currency_sign_entry
  | class_name_entry
    | alphabet_name_entry
    | symbolic_characters_entry
    | crt_status_entry
    | cursor_entry
    | console_entry
}

decimal_point_entry = { kw_decimal_point ~ kw_is? ~ kw_comma }
currency_sign_entry = { kw_currency ~ kw_sign? ~ kw_is? ~ string_literal }
class_name_entry    = { kw_class ~ ident_name ~ kw_is? ~ class_name_spec+ }
alphabet_name_entry = { kw_alphabet ~ ident_name ~ kw_is? ~ alphabet_name_spec+ }
symbolic_characters_entry = {
        kw_symbolic ~ kw_characters ~ symbolic_character_mapping+
}
// `ARE` is the plural of `IS` and COBOL accepts either everywhere it reads as
// English; only `IS` was allowed here.
symbolic_character_mapping = { ident_name ~ (kw_is | kw_are)? ~ number_literal }
// CRT STATUS / CURSOR name a data item the screen handler writes into. The
// item is ordinary WORKING-STORAGE, so nothing is needed beyond parsing it.
crt_status_entry = { kw_crt ~ kw_status ~ kw_is? ~ ident_name }
cursor_entry     = { kw_cursor ~ kw_is? ~ ident_name }
console_entry = { kw_console ~ kw_is? ~ ident_or_keyword }

class_name_spec = {
    string_literal ~ (kw_thru ~ string_literal)?
  | figurative_constant
}
alphabet_name_spec = {
        string_literal ~ (kw_thru ~ string_literal)?
    | ident_or_keyword
}

repository_paragraph = {
    kw_repository ~ period
    ~ repository_entry+
    ~ period
}

repository_entry = {
    repository_function_entry
  | repository_class_entry
  | repository_interface_entry
}

repository_function_entry = {
    kw_function
    ~ (
        kw_all ~ kw_intrinsic
      | function_name ~ (kw_as ~ string_literal)?
    )
}

repository_class_entry = {
    kw_class ~ ident_name ~ (kw_as | kw_is) ~ string_literal
}

repository_interface_entry = {
    kw_interface_bare ~ ident_name ~ (kw_as | kw_is) ~ string_literal
}

input_output_section = {
    kw_input_output ~ kw_section ~ period
    ~ file_control_paragraph?
}

file_control_paragraph = {
    kw_file_control ~ period
    ~ select_entry*
}

select_entry = {
    kw_select ~ ident_name
    ~ kw_assign ~ kw_to? ~ (ident_name | string_literal)
    ~ select_clause*
    ~ period
}

select_clause = {
    kw_organization ~ kw_is? ~ (kw_sequential | kw_relative | kw_indexed | kw_line ~ kw_sequential)
  | kw_file_status ~ kw_is? ~ ident_name
  | kw_access ~ kw_mode? ~ kw_is? ~ (kw_sequential | kw_random | kw_dynamic)
    | kw_relative ~ kw_key ~ kw_is? ~ ident_name
  | kw_record ~ kw_key ~ kw_is? ~ ident_name
  | kw_alternate ~ kw_record? ~ kw_key ~ kw_is? ~ ident_name ~ (kw_with? ~ kw_duplicates)?
}

// ── Data Division ───────────────────────────────────────────────────────────

data_division = {
    kw_data ~ kw_division ~ period
    ~ (file_section | working_storage_section | local_storage_section | linkage_section | screen_section | report_section)*
}

file_section = {
    kw_file ~ kw_section ~ period
    ~ file_description*
}

file_description = {
    (kw_fd | kw_sd) ~ ident_or_keyword ~ fd_clause* ~ period
    ~ data_item*
}

fd_clause = {
        kw_record ~ kw_contains? ~ number_literal ~ (kw_to ~ number_literal)? ~ kw_characters?
  | kw_block ~ kw_contains? ~ number_literal ~ (kw_to ~ number_literal)? ~ kw_characters?
  | kw_label ~ kw_record? ~ kw_is? ~ (kw_standard | kw_omitted)
  | kw_data ~ kw_record? ~ kw_is? ~ ident_name
  | (kw_report | kw_reports) ~ (kw_is | kw_are)? ~ ident_name+
    | linage_clause
}

linage_clause = {
        kw_linage ~ kw_is? ~ (number_literal | ident_name) ~ kw_lines
        ~ (kw_with ~ kw_footing ~ kw_at ~ (number_literal | ident_name))?
        ~ (kw_lines ~ kw_at ~ kw_top ~ (number_literal | ident_name))?
        ~ (kw_lines ~ kw_at ~ kw_bottom ~ (number_literal | ident_name))?
}

// ── Report Writer ───────────────────────────────────────────────────────────
//
// The REPORT SECTION describes a report as GROUPS of lines rather than as a
// record layout: an `RD` names the report, each `01` is a group with a TYPE
// saying WHEN the report writer emits it, and the elementary items place
// themselves with LINE/COLUMN instead of by their offset in a record.
//
// ⚠ Both the group name and the elementary name are OPTIONAL — `01 TYPE IS
// DETAIL.` and `05 LINE 1 COL 1 PIC X VALUE 'A'.` are complete entries.
// INITIATE/GENERATE/TERMINATE drive the report writer control system.
// ⚠ They PARSE and are walked, but no report output is produced yet — the RWCS
// writes to the report's FILE, not to stdout, so emitting anything here would
// diverge from cobc rather than approximate it. See
// `project_cobol_report_writer_is_absent`.
report_verb_stmt = {
    (kw_initiate | kw_terminate) ~ ident_name+
  | kw_generate ~ qualified_ident
}

report_section = {
    kw_report ~ kw_section ~ period
    ~ report_description*
}

report_description = {
    kw_rd ~ ident_name ~ rd_clause* ~ period
    ~ report_group_item*
}

rd_clause = {
    (kw_control | kw_controls) ~ (kw_is | kw_are)? ~ (kw_final | ident_name)+
  | kw_page ~ kw_limit? ~ (kw_is | kw_are)? ~ number_literal ~ (kw_lines | kw_line)?
      ~ page_sub_clause*
  | kw_code ~ (string_literal | ident_name)
}

page_sub_clause = {
    kw_heading ~ kw_is? ~ number_literal
  | kw_first ~ (kw_detail | kw_de) ~ kw_is? ~ number_literal
  | kw_last ~ (kw_detail | kw_de) ~ kw_is? ~ number_literal
  | kw_footing ~ kw_is? ~ number_literal
}

// ⚠ The name is optional, so it MUST NOT be allowed to swallow the first
// clause keyword: `03 COL 1 VALUE "X".` has no name, and a bare `ident_name?`
// happily took `COL` as one and then choked on the `1`. Same guard
// `regular_data_item` already uses.
report_group_item = {
    level_number ~ (!report_group_clause_start ~ ident_name)? ~ report_group_clause* ~ period
}

report_group_clause_start = _{
    kw_type | kw_next | kw_line | kw_column | kw_col | kw_source | kw_sum
  | kw_group | kw_pic | kw_picture | kw_value | kw_blank | kw_justified
  | kw_just | kw_usage | kw_sign
}

report_group_clause = {
    kw_type ~ kw_is? ~ report_type_spec
  | kw_next ~ kw_group ~ kw_is? ~ (kw_next ~ kw_page | kw_plus ~ number_literal | number_literal)
  | kw_line ~ kw_number? ~ kw_is? ~ (kw_plus ~ number_literal | number_literal)
      ~ (kw_on? ~ kw_next ~ kw_page)?
  | (kw_column | kw_col) ~ kw_number? ~ kw_is? ~ kw_plus? ~ number_literal
  | kw_source ~ kw_is? ~ qualified_ident
  | kw_sum ~ (","? ~ !(kw_upon | kw_reset) ~ qualified_ident)+
      ~ (kw_upon ~ ident_name)?
      ~ (kw_reset ~ kw_on? ~ (kw_final | ident_name))?
  | kw_group ~ kw_indicate
  | pic_clause
  | value_clause
  | blank_clause
  | justified_clause
  | usage_clause
  | sign_clause
}

// RH / PH / CH / DE / CF / PF / RF are the STANDARD abbreviations of these
// types. ⚠ GnuCOBOL rejects every one of them ("syntax error, unexpected PH"),
// so tests that use them have no cobc ground truth — the standard is the
// authority, exactly as it is for OO COBOL.
report_type_spec = {
    (kw_report ~ kw_heading | kw_rh)
  | (kw_report ~ kw_footing | kw_rf)
  | (kw_page ~ kw_heading | kw_ph)
  | (kw_page ~ kw_footing | kw_pf)
  | (kw_control ~ kw_heading | kw_ch) ~ (kw_final | ident_name)?
  | (kw_control ~ kw_footing | kw_cf) ~ (kw_final | ident_name)?
  | (kw_detail | kw_de)
}

working_storage_section = {
    kw_working_storage ~ kw_section ~ period
    ~ data_item*
}

local_storage_section = {
    kw_local_storage ~ kw_section ~ period
    ~ data_item*
}

linkage_section = {
    kw_linkage ~ kw_section ~ period
    ~ data_item*
}

screen_section = {
    kw_screen ~ kw_section ~ period
        ~ screen_item*
}

screen_item = {
        level_88_item
    | screen_data_item
}

screen_data_item = {
        level_number ~ screen_item_name?
        ~ screen_clause*
        ~ period
        ~ screen_item*
}

screen_item_name = @{
        !(kw_blank | kw_line | kw_column | kw_pic | kw_picture | kw_value
            | kw_using | kw_from | kw_highlight | kw_reverse_video | kw_blink
            | kw_auto | kw_required | kw_protected | kw_secure
            | kw_foreground_color | kw_background_color)
        ~ ident_start ~ (ident_cont | "-" ~ ident_cont)*
}

screen_clause = {
        blank_screen_clause
    | blank_line_clause
    | blank_when_zero_clause
    | line_clause
    | column_clause
    | pic_clause
    | value_clause
    | screen_source_clause
    | screen_to_clause
    | screen_sign_clause
    | screen_justified_clause
    | highlight_clause
    | lowlight_clause
    | reverse_video_clause
    | underline_clause
    | blink_clause
    | bell_clause
    | erase_clause
    | auto_clause
    | full_clause
    | required_clause
    | protected_clause
    | secure_clause
    | prompt_clause
    | foreground_color_clause
    | background_color_clause
}

blank_screen_clause     = { kw_blank ~ kw_screen }
blank_line_clause       = { kw_blank ~ kw_line }
blank_when_zero_clause  = { kw_blank ~ kw_when ~ kw_zero }
line_clause             = { kw_line ~ kw_plus? ~ expression }
column_clause           = { kw_column ~ kw_plus? ~ expression }
screen_source_clause    = { (kw_using | kw_from) ~ ident_name ~ (kw_to ~ ident_name)? }
screen_to_clause        = { kw_to ~ ident_name }
screen_sign_clause      = { kw_sign ~ kw_is? ~ (kw_leading | kw_trailing) ~ (kw_separate ~ kw_character?)? }
screen_justified_clause = { kw_justified ~ kw_right? }
highlight_clause        = { kw_highlight }
lowlight_clause         = { kw_lowlight }
reverse_video_clause    = { kw_reverse_video }
underline_clause        = { kw_underline }
blink_clause            = { kw_blink }
bell_clause             = { kw_bell }
erase_clause            = { kw_erase ~ (kw_eol | kw_eos)? }
auto_clause             = { kw_auto }
full_clause             = { kw_full }
required_clause         = { kw_required }
protected_clause        = { kw_protected }
secure_clause           = { kw_secure }
prompt_clause           = { kw_prompt ~ (kw_character ~ kw_is? ~ literal)? }
foreground_color_clause = { kw_foreground_color ~ expression }
background_color_clause = { kw_background_color ~ expression }

// ── Data Items ──────────────────────────────────────────────────────────────

data_item = {
    level_88_item
  | regular_data_item
}

level_88_item = {
    level_88 ~ ident_name
    ~ kw_value ~ kw_is? ~ literal ~ (kw_thru ~ literal)?
    ~ (","? ~ literal ~ (kw_thru ~ literal)?)*
    ~ period
}

regular_data_item = {
    level_number ~ (ident_or_keyword | kw_filler)
    ~ data_clause*
    ~ period
    ~ (level_88_item | data_item)*
}

data_clause = {
    pic_clause
  | value_clause
  | occurs_clause
  | redefines_clause
  | renames_clause
  | usage_clause
  | blank_clause
  | justified_clause
  | sign_clause
  | sync_clause
  | global_clause
  | external_clause
  | national_clause
  | unknown_data_clause
}

// Skip unrecognized data clause tokens — matches the original parser's
// `_ => { self.advance(); }` behavior at parser.rs:783.
// Consumes one word/token that isn't a period or new data item start.
unknown_data_clause = {
    !period ~ !level_number ~ !level_88
    ~ !kw_procedure ~ !kw_working_storage ~ !kw_local_storage ~ !kw_linkage ~ !kw_file ~ !kw_screen
    ~ (ident_or_keyword | number_literal | string_literal | figurative_constant | "(" | ")" | ",")
}

pic_clause = { (kw_pic | kw_picture) ~ kw_is? ~ pic_string }

// PIC strings: complex patterns like S9(5)V99, X(20), Z(5)9, A(10)B
// Parsed as atomic to capture the raw pic text
// PIC string stops at period, VALUE, OCCURS, REDEFINES, USAGE, EOF
// (matches parser.rs:807 parse_pic_string stop conditions)
pic_string = @{ pic_char+ }
pic_char   = _{ ASCII_ALPHANUMERIC | "(" | ")" | "+" | "-" | "*" | "/" | "$" | "," | "." ~ &ASCII_DIGIT }

value_clause = {
    kw_value ~ kw_is?
    ~ (hex_literal | string_literal | number_literal | figurative_constant | ident_or_keyword | boolean_literal)
}

occurs_clause = {
    kw_occurs ~ (number_literal | level_number)
    ~ ( kw_to ~ number_literal )?
    ~ kw_times?
    ~ depending_clause?
    ~ indexed_clause?
    ~ (kw_ascending ~ kw_key? ~ kw_is? ~ ident_name)*
    ~ (kw_descending ~ kw_key? ~ kw_is? ~ ident_name)*
}

depending_clause = { kw_depending ~ kw_on? ~ ident_name }
indexed_clause   = { kw_indexed ~ kw_by ~ ident_name ~ ("," ~ ident_name)* }

redefines_clause = { kw_redefines ~ ident_name }
renames_clause   = { kw_renames ~ ident_name ~ ((kw_thru | kw_through) ~ ident_name)? }
usage_clause     = { kw_usage ~ kw_is? ~ usage_type }
usage_type       = {
        // The `comp-N` spellings MUST precede bare `kw_comp`: `ident_cont`
        // excludes `-`, so `kw_comp` happily matches the `COMP` prefix of
        // `COMP-2` and the `-2` is dropped — which is how `USAGE COMP-2`
        // was being typed as a binary INTEGER.
        kw_binary | kw_comp_1 | kw_comp_2 | kw_comp_3 | kw_comp_5 | kw_comp | kw_display_usage
  | kw_packed_decimal | kw_pointer | kw_index
  | kw_float_long | kw_float_short | kw_national | kw_boolean
  | object_reference_usage
  | ident_name
}

// `USAGE OBJECT REFERENCE [class-name]` — COBOL 2002 object handles.
object_reference_usage = { kw_object ~ kw_reference ~ ident_name? }

blank_clause     = { kw_blank ~ kw_when? ~ kw_zero }
justified_clause = { (kw_justified | kw_just) ~ kw_right? }
sign_clause      = { kw_sign ~ kw_is? ~ (kw_leading | kw_trailing) ~ (kw_separate ~ kw_character?)? }
sync_clause      = { (kw_synchronized | kw_sync) ~ (kw_left | kw_right)? }
global_clause    = { kw_global }
external_clause  = { kw_external }
national_clause  = { kw_national }

// Level numbers: 01-49, 66, 77, 88
level_number = @{ ASCII_DIGIT{1,2} }
level_88     = @{ "88" }

// ── Procedure Division ──────────────────────────────────────────────────────

procedure_division = {
    kw_procedure ~ kw_division
    ~ using_clause?
    ~ returning_clause?
    ~ period
    ~ declaratives_block?
    ~ statement_list
    ~ procedure_block*
}

declaratives_block = {
    kw_declaratives ~ period
    ~ declarative_section*
    ~ kw_end ~ kw_declaratives ~ period
}

declarative_section = {
    paragraph_name ~ kw_section ~ period
    ~ use_stmt ~ period
    ~ statement_list
    ~ paragraph*
}

use_stmt = {
    kw_use ~ after_use_clause
  | kw_use ~ debugging_use_clause
  | kw_use ~ before_reporting_clause
}

// `USE BEFORE REPORTING <report-group>` — a REPORT WRITER declarative. It had
// no rule, so every DECLARATIVES block containing one failed to parse and the
// error pointed at `DECLARATIVES` itself.
// ⚠ ONE report-group-name. I widened this to `ident_name+` to fit a test
// that wrote `USE BEFORE REPORTING G1 G2` — which cobc rejects and the
// standard does not allow; two groups mean two USE sections.
before_reporting_clause = { kw_global? ~ kw_before ~ kw_reporting ~ ident_name }

after_use_clause = {
    kw_global? ~ kw_after ~ use_condition
}

// Ordered so EXCEPTION CONDITION / EXCEPTION OBJECT / INVALID KEY match before
// the general STANDARD ERROR/EXCEPTION PROCEDURE form (which would otherwise
// consume the EXCEPTION token and leave CONDITION/OBJECT dangling).
use_condition = {
    kw_exception ~ kw_condition
  | kw_exception ~ kw_object ~ ident_name
  | kw_invalid ~ kw_key
  | kw_standard? ~ (kw_error | kw_exception) ~ kw_procedure? ~ (kw_on ~ use_target+)?
}

use_target = { kw_input | kw_output | kw_i_o | kw_extend | kw_all | ident_name }

debugging_use_clause = {
    kw_for ~ kw_debugging ~ kw_on ~ ((kw_all ~ kw_procedures) | (ident_name ~ kw_section?))
}

resume_stmt = { kw_resume ~ (kw_next ~ kw_statement | paragraph_name) }

procedure_block = {
    section
  | paragraph
}

section = {
    paragraph_name ~ kw_section ~ period
    ~ statement_list
    ~ paragraph*
}

// Paragraph: an identifier followed by a period, then statements
paragraph = {
    paragraph_name ~ period
    ~ statement_list
}

paragraph_name = @{ ASCII_ALPHANUMERIC ~ (ident_cont | "-")* }

statement_list = { (statement ~ period?)* }

// ── Statements ──────────────────────────────────────────────────────────────

statement = _{
    display_stmt
  | accept_stmt
  | move_stmt
  | add_stmt
  | subtract_stmt
  | multiply_stmt
  | divide_stmt
  | compute_stmt
  | if_stmt
  | evaluate_stmt
  | perform_stmt
  | string_stmt
  | unstring_stmt
  | report_verb_stmt
  | inspect_stmt
  | call_stmt
    | cancel_stmt
    | release_stmt
    | return_stmt
  | initialize_stmt
  | set_stmt
    | alter_stmt
  | go_to_stmt
  | stop_run_stmt
    | stop_stmt
  | goback_stmt
  | continue_stmt
  | resume_stmt
  | raise_stmt
    | xml_stmt
  | json_stmt
  | open_stmt
  | close_stmt
  | read_stmt
  | write_stmt
  | rewrite_stmt
  | delete_stmt
  | start_stmt
  | sort_stmt
  | merge_stmt
  | search_stmt
  | copy_stmt
  | invoke_stmt
  | validate_stmt
  | free_stmt
  | allocate_stmt
  | typedef_stmt
  | exit_stmt
  | wait_stmt
  | run_unit_stmt
  | lock_stmt
  | unlock_stmt
  | yield_stmt
  | suspend_stmt
  | exec_sql_stmt
  | exec_cics_stmt
  | exec_dli_stmt
}

// ── DISPLAY ─────────────────────────────────────────────────────────────────

display_stmt = {
    kw_display ~ display_operand+
    ~ (kw_upon ~ ident_name)?
    ~ (kw_with? ~ kw_no ~ kw_advancing)?
}

display_operand = { !statement_start_keyword ~ expression }

statement_start_keyword = _{
    kw_display | kw_accept | kw_move | kw_add | kw_subtract | kw_multiply | kw_divide
  | kw_compute | kw_if | kw_evaluate | kw_perform | kw_string | kw_unstring
  | kw_inspect | kw_call | kw_cancel | kw_initialize | kw_set | kw_go | kw_stop
  | kw_goback | kw_continue | kw_raise | kw_open | kw_close | kw_read | kw_write
  | kw_rewrite | kw_delete | kw_start | kw_sort | kw_merge | kw_search | kw_copy
  | kw_invoke | kw_validate | kw_free | kw_allocate | kw_exit | kw_wait | kw_run
  | kw_lock | kw_unlock | kw_yield | kw_suspend | kw_exec
}

// ── ACCEPT ──────────────────────────────────────────────────────────────────

accept_stmt = {
    kw_accept ~ ident_name
    ~ ( kw_from ~ accept_source )?
}

accept_source = {
    kw_environment_value
  | accept_environment_source
  | accept_day_of_week_source
  | accept_date_source
  | accept_day_source
  | kw_time
  | kw_command_line
  | kw_console
}

accept_environment_source = {
    kw_environment ~ (kw_name ~ ident_name | string_literal)
}

// The X/Open two-step: `DISPLAY "HOME" UPON ENVIRONMENT-NAME` selects the
// variable, `ACCEPT v FROM ENVIRONMENT-VALUE` reads it. These are hyphenated
// COBOL words, so `kw_environment` no longer matches their first half and they
// need rules of their own.
kw_environment_name  = @{ ^"environment-name"  ~ word_end }
kw_environment_value = @{ ^"environment-value" ~ word_end }

accept_date_source = {
    kw_date ~ kw_yyyymmdd?
}

accept_day_source = {
    kw_day ~ kw_yyyyddd?
}

accept_day_of_week_source = { kw_day_of_week }

// ── MOVE ────────────────────────────────────────────────────────────────────

move_stmt = {
    kw_move ~ (kw_corresponding | kw_corr) ~ ident_name ~ kw_to ~ ident_name
  | kw_move ~ expression ~ kw_to ~ move_target+
}

data_target = { (ident_name | kw_sd) ~ subscript_or_refmod* ~ qualification* }

move_target = { data_target }

// ── ADD ─────────────────────────────────────────────────────────────────────

add_stmt = {
    kw_add ~ (kw_corresponding | kw_corr) ~ ident_name ~ kw_to ~ ident_name
        | kw_add ~ expression+ ~ giving_clause ~ rounded_clause?
        ~ size_error_clause?
        ~ kw_end_add?
    | kw_add ~ expression+ ~ kw_to ~ data_target ~ giving_clause? ~ rounded_clause?
    ~ size_error_clause?
    ~ kw_end_add?
    // `ADD 5 TO 10 GIVING R` — with GIVING the TO operand is only an addend,
    // so COBOL allows it to be a literal. Ordered after the data_target
    // branch so `ADD 1 TO X` still binds X as the target.
    | kw_add ~ expression+ ~ kw_to ~ arith_operand ~ giving_clause ~ rounded_clause?
    ~ size_error_clause?
    ~ kw_end_add?
}

// Simple operand for arithmetic verbs — stops at keywords like TO, GIVING, FROM.
// COBOL arithmetic operands are literals, identifiers, or subscripted names.
arith_operand = { atom ~ subscript_or_refmod* ~ qualification* }

giving_clause  = { kw_giving ~ data_target }
// `MODE IS <mode>` — the `IS` is optional noise in COBOL and was missing here,
// which rejected EVERY spelled rounding mode, not just the unlisted ones.
rounded_clause = { kw_rounded ~ (kw_mode ~ kw_is? ~ rounded_mode_spec)? }
rounded_mode_spec = {
        kw_truncation
    | kw_nearest_away_from_zero
    | kw_nearest_even
    | kw_nearest_toward_zero
    | kw_toward_greater
    | kw_toward_lesser
    | kw_toward_zero
    | kw_away_from_zero
    | kw_prohibited
}

// ── SUBTRACT ────────────────────────────────────────────────────────────────

subtract_stmt = {
    kw_subtract ~ (kw_corresponding | kw_corr) ~ ident_name ~ kw_from ~ ident_name
    | kw_subtract ~ arith_operand ~ kw_from ~ data_target ~ giving_clause? ~ rounded_clause?
    ~ size_error_clause?
    ~ kw_end_subtract?
    // `SUBTRACT 5.2 FROM 20.0 GIVING R` — the FROM operand is only the
    // minuend when GIVING names the receiver, so it may be a literal.
    | kw_subtract ~ arith_operand ~ kw_from ~ arith_operand ~ giving_clause ~ rounded_clause?
    ~ size_error_clause?
    ~ kw_end_subtract?
}

// ── MULTIPLY ────────────────────────────────────────────────────────────────

multiply_stmt = {
        kw_multiply ~ arith_operand ~ kw_by ~ data_target ~ giving_clause? ~ rounded_clause?
        ~ size_error_clause?
        ~ kw_end_multiply?
    | kw_multiply ~ arith_operand ~ kw_by ~ arith_operand ~ giving_clause ~ rounded_clause?
        ~ size_error_clause?
        ~ kw_end_multiply?
}

// ── DIVIDE ──────────────────────────────────────────────────────────────────

divide_stmt = {
    kw_divide ~ arith_operand ~ (kw_by | kw_into) ~ arith_operand
    ~ (giving_clause ~ remainder_clause?)?
    ~ rounded_clause?
    ~ size_error_clause?
    ~ kw_end_divide?
}

remainder_clause = { kw_remainder ~ ident_name }

// ── COMPUTE ─────────────────────────────────────────────────────────────────

// `COMPUTE A B = 3 + 4` stores the same result in every receiver, and each
// may carry its own ROUNDED.
compute_stmt = {
    kw_compute ~ (data_target ~ rounded_clause?)+ ~ "=" ~ expression
    ~ size_error_clause?
    ~ kw_end_compute?
}

// ── SIZE ERROR / NOT ON SIZE ERROR ──────────────────────────────────────────

size_error_clause = {
    (kw_on? ~ kw_size ~ kw_error ~ statement_list)?
    ~ (kw_not ~ kw_on? ~ kw_size ~ kw_error ~ statement_list)?
}

// ── IF ──────────────────────────────────────────────────────────────────────

if_stmt = {
    kw_if ~ condition ~ kw_then?
    ~ statement_list
    ~ else_clause?
    ~ kw_end_if?
}

else_clause = { kw_else ~ statement_list }

// ── EVALUATE ────────────────────────────────────────────────────────────────

evaluate_stmt = {
    kw_evaluate ~ expression ~ (kw_also ~ expression)*
    ~ when_clause+
    ~ when_other_clause?
    ~ kw_end_evaluate?
}

when_clause = {
    kw_when ~ when_value ~ (kw_also ~ when_value)*
    ~ statement_list
}

when_value = {
    kw_any
  | kw_true
  | kw_false
  | condition ~ (kw_thru ~ condition)?
}

when_other_clause = { kw_when ~ kw_other ~ statement_list }

// ── PERFORM ─────────────────────────────────────────────────────────────────

perform_stmt = {
    perform_varying
  | perform_until
  | perform_times
  | perform_async
    | perform_paragraph_until
  | perform_thru
  | perform_paragraph
  | perform_inline
}

perform_varying = {
    kw_perform ~ kw_varying ~ ident_name
    ~ kw_from ~ expression ~ kw_by ~ expression ~ kw_until ~ condition
    ~ statement_list
    ~ kw_end_perform?
}

perform_until = {
    kw_perform ~ test_clause? ~ kw_until ~ condition
    ~ statement_list
    ~ kw_end_perform?
}

perform_times = {
    kw_perform ~ expression ~ kw_times
    ~ statement_list
    ~ kw_end_perform?
}

perform_paragraph_until = {
    kw_perform ~ paragraph_name ~ test_clause? ~ kw_until ~ condition
}

perform_async = { kw_perform ~ kw_async ~ paragraph_name }

perform_thru = { kw_perform ~ paragraph_name ~ (kw_thru | kw_through) ~ paragraph_name }

perform_paragraph = { kw_perform ~ paragraph_name }

perform_inline = {
    kw_perform ~ statement_list ~ kw_end_perform?
}

test_clause = { kw_with ~ kw_test ~ (kw_before | kw_after) }

// ── STRING ──────────────────────────────────────────────────────────────────

string_stmt = {
    kw_string ~ string_source+
    ~ kw_into ~ ident_name
    ~ pointer_clause?
    ~ overflow_clause?
    ~ kw_end_string?
}

// A DELIMITED BY clause governs the GROUP of operands in front of it, not
// just the nearest one: `STRING S1 S2 DELIMITED BY '*'` cuts BOTH sources at
// the delimiter. With one operand per clause, S1 matched the bare alternative
// and was sent whole.
string_source = {
        string_operand+ ~ kw_delimited ~ (kw_size | kw_by ~ (kw_size | expression | keyword_data_name))
  | string_operand
}

string_operand = { string_data_ref | expression | keyword_data_name }

string_data_ref = { (ident_name | kw_sd) ~ (string_harness_subscript | subscript_or_refmod)+ ~ qualification* }

string_harness_subscript = {
    "(" ~ expression ~ (kw_delimited ~ kw_size ~ expression)+ ~ ")"
}

keyword_data_name = { kw_display | kw_left | kw_right | kw_key }

pointer_clause = { kw_with? ~ kw_pointer ~ ident_name }

overflow_clause = {
    (kw_on? ~ kw_overflow ~ statement_list)?
    ~ (kw_not ~ kw_on? ~ kw_overflow ~ statement_list)?
}

// ── UNSTRING ────────────────────────────────────────────────────────────────

unstring_stmt = {
    kw_unstring ~ ident_name
    ~ (kw_delimited ~ kw_by ~ kw_all? ~ (string_literal | figurative_constant | ident_name)
       ~ (kw_or ~ kw_all? ~ (string_literal | figurative_constant | ident_name))*
      )?
    ~ kw_into ~ unstring_target+
    ~ pointer_clause?
    ~ tallying_in_clause?
    ~ overflow_clause?
    ~ kw_end_unstring?
}

unstring_target = {
    data_target
    ~ (kw_delimiter ~ kw_in? ~ data_target)?
    ~ (kw_count ~ kw_in? ~ data_target)?
}

tallying_in_clause = { kw_tallying ~ kw_in? ~ ident_name }

// ── INSPECT ─────────────────────────────────────────────────────────────────

// The combined form must come FIRST: `inspect_tallying` alone happily matches
// the TALLYING half and would leave the REPLACING half stranded.
inspect_stmt = {
    inspect_tallying_replacing
  | inspect_tallying
  | inspect_replacing
  | inspect_converting
}

// `BEFORE|AFTER [INITIAL] x` — the window of the receiver a phrase looks at.
// `INITIAL` is optional noise; requiring it rejected `AFTER " "`.
inspect_region = { (kw_before | kw_after) ~ kw_initial? ~ (string_literal | ident_name) }

// `TALLYING c1 FOR ALL "L" c2 FOR ALL "O"` — one INSPECT may fill several
// counters, so the counter and its phrases group together and repeat.
inspect_tally_target = { ident_name ~ kw_for ~ inspect_tally_phrase+ }

inspect_tallying = {
    kw_inspect ~ ident_name ~ kw_tallying ~ inspect_tally_target+
}

inspect_tallying_replacing = {
    kw_inspect ~ ident_name ~ kw_tallying ~ inspect_tally_target+
    ~ kw_replacing ~ inspect_replace_phrase+
}

inspect_tally_phrase = {
    // `FOR CHARACTERS` counts positions and takes no search operand — this
    // needed two tokens before, so the bare form did not parse.
    kw_characters ~ inspect_region*
  | inspect_mode ~ (string_literal | ident_name) ~ inspect_region*
}

inspect_replacing = {
    kw_inspect ~ ident_name ~ kw_replacing
    ~ inspect_replace_phrase+
}

inspect_replace_phrase = {
    // REPLACING CHARACTERS BY x — replace every character (no search operand)
    kw_characters ~ kw_by ~ (string_literal | ident_name) ~ inspect_region*
  | inspect_mode ~ (string_literal | ident_name) ~ kw_by ~ (string_literal | ident_name)
    ~ inspect_region*
}

inspect_converting = {
    kw_inspect ~ ident_name ~ kw_converting
    ~ (string_literal | ident_name) ~ kw_to ~ (string_literal | ident_name)
    ~ inspect_region*
}

inspect_mode = { kw_all | kw_leading | kw_first | kw_trailing | kw_characters }

// ── CALL ────────────────────────────────────────────────────────────────────

call_stmt = {
    kw_call ~ (string_literal | ident_name) ~ kw_async?
    ~ (kw_using ~ call_arg+)?
    ~ (kw_returning ~ ident_name)?
    ~ on_exception_clause?
    ~ kw_end_call?
}

cancel_stmt = { kw_cancel ~ (string_literal | ident_name) }

release_stmt = { kw_release ~ ident_name ~ (kw_from ~ ident_name)? }

return_stmt = {
    kw_return ~ ident_name
    ~ (kw_into ~ ident_name)?
    ~ at_end_clause?
    ~ kw_end_return?
}

call_arg = {
    (kw_by ~ (kw_reference | kw_content | kw_value))? ~ ident_name
}

on_exception_clause = {
    (kw_on? ~ kw_exception ~ statement_list)?
    ~ (kw_not ~ kw_on? ~ kw_exception ~ statement_list)?
}

// ── INITIALIZE ──────────────────────────────────────────────────────────────

initialize_stmt = {
    kw_initialize ~ ident_name+
    ~ (kw_replacing ~ (kw_alphanumeric | kw_numeric | kw_national) ~ kw_data? ~ kw_by ~ expression)?
}

// ── SET ─────────────────────────────────────────────────────────────────────

set_stmt = {
    kw_set ~ ident_name ~ kw_to ~ (kw_true | kw_false | expression)
  | kw_set ~ ident_name ~ (kw_up | kw_down) ~ kw_by ~ expression
}

// ── ALTER ───────────────────────────────────────────────────────────────────

alter_stmt = { kw_alter ~ paragraph_name ~ kw_to ~ kw_proceed ~ kw_to ~ paragraph_name }

// ── GO TO ───────────────────────────────────────────────────────────────────

go_to_stmt = { kw_go ~ kw_to? ~ paragraph_name }

// ── STOP RUN ────────────────────────────────────────────────────────────────

stop_run_stmt = { kw_stop ~ kw_run }

stop_stmt = { kw_stop ~ literal }

// ── GOBACK ──────────────────────────────────────────────────────────────────

goback_stmt = { kw_goback }

// ── CONTINUE ────────────────────────────────────────────────────────────────

continue_stmt = { kw_continue }

// ── RAISE ───────────────────────────────────────────────────────────────────

raise_stmt = { kw_raise ~ kw_exception? ~ expression }

// ── JSON GENERATE / PARSE ───────────────────────────────────────────────────

xml_stmt = {
        kw_xml ~ kw_generate ~ ident_name ~ kw_from ~ expression
        ~ xml_generate_option*
        ~ on_exception_clause?
        ~ kw_end_xml?
    | kw_xml ~ kw_parse ~ expression
        ~ kw_processing ~ kw_procedure ~ ident_name
        ~ xml_parse_option*
        ~ on_exception_clause?
        ~ kw_end_xml?
}

xml_generate_option = {
        kw_count ~ kw_in ~ ident_name
    | kw_encoding ~ expression
    | kw_with ~ kw_xml_declaration
    | kw_with ~ kw_attributes
    | kw_namespace ~ kw_is? ~ string_literal
    | kw_namespace_prefix ~ kw_is? ~ string_literal
    | kw_suppress ~ kw_when ~ (kw_zero | kw_spaces)
}

xml_parse_option = {
        kw_encoding ~ expression
}

json_stmt = {
    kw_json ~ kw_generate ~ ident_name ~ kw_from ~ ident_name
    ~ (kw_name ~ kw_of? ~ ident_name ~ kw_is? ~ (string_literal | kw_omitted))*
    ~ kw_end_json?
  | kw_json ~ kw_parse ~ ident_name ~ kw_into ~ ident_name
    ~ kw_end_json?
}

// ── OPEN ────────────────────────────────────────────────────────────────────

open_stmt = {
    kw_open ~ file_open_mode ~ ident_name ~ (file_open_mode ~ ident_name)*
}

file_open_mode = { kw_input | kw_output | kw_i_o | kw_extend }

// ── CLOSE ───────────────────────────────────────────────────────────────────

close_stmt = { kw_close ~ ident_name+ }

// ── READ ────────────────────────────────────────────────────────────────────

read_stmt = {
    kw_read ~ ident_name
    ~ (kw_next? ~ kw_record?)?
    ~ (kw_into ~ ident_name)?
    ~ at_end_clause?
    ~ invalid_key_clause?
    ~ kw_end_read?
}

clause_statement_list = { statement ~ period? ~ (statement ~ period?)* }

at_end_clause = {
    (kw_at? ~ kw_end ~ clause_statement_list
        ~ (kw_not ~ kw_at? ~ kw_end ~ clause_statement_list)?)
    | (kw_not ~ kw_at? ~ kw_end ~ clause_statement_list)
}

invalid_key_clause = {
    (kw_invalid ~ kw_key? ~ clause_statement_list
        ~ (kw_not ~ kw_invalid ~ kw_key? ~ clause_statement_list)?)
    | (kw_not ~ kw_invalid ~ kw_key? ~ clause_statement_list)
}

// ── WRITE ───────────────────────────────────────────────────────────────────

write_stmt = {
    kw_write ~ ident_name
    ~ (kw_from ~ write_source)?
    ~ write_advancing?
    ~ end_of_page_clause?
    ~ invalid_key_clause?
    ~ kw_end_write?
}

write_source = { write_source_part ~ ("&" ~ write_source_part)* }
write_source_part = { kw_all ~ literal | expression }

end_of_page_clause = {
    (kw_at ~ kw_end_of_page ~ statement_list)?
    ~ (kw_not ~ kw_at ~ kw_end_of_page ~ statement_list)?
}

write_advancing = {
    (kw_before | kw_after) ~ kw_advancing?
    ~ (number_literal ~ (kw_lines | kw_line)? | kw_page | ident_name)
}

// ── REWRITE ─────────────────────────────────────────────────────────────────

rewrite_stmt = {
    kw_rewrite ~ ident_name
    ~ (kw_from ~ write_source)?
    ~ invalid_key_clause?
    ~ kw_end_rewrite?
}

// ── DELETE ──────────────────────────────────────────────────────────────────

delete_stmt = {
    kw_delete ~ ident_name ~ kw_record?
    ~ invalid_key_clause?
    ~ kw_end_delete?
}

// ── START ───────────────────────────────────────────────────────────────────

start_stmt = {
    kw_start ~ ident_name
    ~ (kw_key ~ (kw_is? ~ (kw_equal | kw_greater | kw_not_less | kw_not_greater | "=" | ">=" | "<=" | ">" | "<"))? ~ ident_name)?
    ~ invalid_key_clause?
    ~ kw_end_start?
}

// ── SORT ────────────────────────────────────────────────────────────────────

sort_stmt = {
    kw_sort ~ ident_name
    ~ kw_on? ~ (kw_ascending | kw_descending) ~ kw_key? ~ ident_name
    ~ (kw_on? ~ (kw_ascending | kw_descending) ~ kw_key? ~ ident_name)*
        ~ sort_duplicates_clause?
    ~ sort_input?
    ~ sort_output?
}

sort_duplicates_clause = { kw_with ~ kw_duplicates ~ kw_in ~ kw_order }

sort_input = {
        kw_using ~ sort_file_operand+
  | kw_input ~ kw_procedure ~ kw_is? ~ ident_name ~ (kw_thru ~ ident_name)?
}

sort_output = {
        kw_giving ~ sort_file_operand+
  | kw_output ~ kw_procedure ~ kw_is? ~ ident_name ~ (kw_thru ~ ident_name)?
}

sort_file_operand = { ident_name | string_literal }

// ── MERGE ───────────────────────────────────────────────────────────────────

merge_stmt = {
    kw_merge ~ ident_name
    ~ kw_on? ~ (kw_ascending | kw_descending) ~ kw_key? ~ ident_name
    ~ (kw_on? ~ (kw_ascending | kw_descending) ~ kw_key? ~ ident_name)*
    ~ sort_duplicates_clause?
    ~ (kw_using ~ sort_file_operand+)?
    ~ (kw_giving ~ sort_file_operand+ | kw_output ~ kw_procedure ~ kw_is? ~ ident_name)?
}

// ── SEARCH ──────────────────────────────────────────────────────────────────

search_stmt = {
    kw_search ~ kw_all? ~ search_subject ~ kw_varying? ~ ident_name?
    ~ (kw_at ~ kw_end ~ statement_list)?
    ~ (kw_when ~ condition ~ statement_list)+
    ~ kw_end_search?
}

search_subject = { ident_name ~ subscript_or_refmod* }

// ── COPY ────────────────────────────────────────────────────────────────────

copy_stmt = {
    kw_copy ~ ident_name
    ~ (kw_of | kw_in)? ~ ident_name?
    ~ (kw_replacing ~ copy_replacement+)?
}

copy_replacement = {
    (pseudo_text | string_literal | ident_name) ~ kw_by ~ (pseudo_text | string_literal | ident_name)
}

// ==text== pseudo-text delimiters
pseudo_text = @{ "==" ~ (!"==" ~ ANY)* ~ "==" }

// ── INVOKE (OO COBOL) ──────────────────────────────────────────────────────

invoke_stmt = {
    kw_invoke ~ ident_name ~ ("::" ~ ident_name | string_literal | ident_name | kw_new)
    ~ (kw_using ~ ident_name+)?
    ~ (kw_returning ~ ident_name)?
}

// ── VALIDATE ────────────────────────────────────────────────────────────────

validate_stmt = { kw_validate ~ ident_name ~ kw_end_validate? }

// ── FREE / ALLOCATE ─────────────────────────────────────────────────────────

free_stmt     = { kw_free ~ ident_name }
allocate_stmt = { kw_allocate ~ ident_name ~ (kw_returning ~ ident_name)? }

// ── TYPEDEF ─────────────────────────────────────────────────────────────────

typedef_stmt = { kw_typedef ~ ident_name ~ (kw_as ~ pic_clause)? }

// ── EXIT ────────────────────────────────────────────────────────────────────

exit_stmt = {
    kw_exit ~ (kw_perform ~ kw_cycle? | kw_paragraph | kw_section | kw_program | kw_method)
  | kw_exit
}

// ── WAIT / RUN UNIT / LOCK / UNLOCK / YIELD / SUSPEND ───────────────────────

wait_stmt     = { kw_wait ~ kw_for? ~ ident_name }
run_unit_stmt = { kw_run_unit ~ (string_literal | ident_name) ~ (kw_using ~ ident_name+)? }
lock_stmt     = { kw_lock ~ ident_name }
unlock_stmt   = { kw_unlock ~ ident_name }
yield_stmt    = { kw_yield }
suspend_stmt  = { kw_suspend }

// ── EXEC SQL / CICS / DLI ──────────────────────────────────────────────────
// These are opaque blocks — we capture the raw text between EXEC and END-EXEC.

exec_sql_stmt = {
    kw_exec ~ kw_sql ~ exec_body ~ kw_end_exec
}

exec_cics_stmt = {
    kw_exec ~ kw_cics ~ exec_body ~ kw_end_exec
}

exec_dli_stmt = {
    kw_exec ~ kw_dli ~ exec_body ~ kw_end_exec
}

// Capture everything between EXEC SQL/CICS/DLI and END-EXEC as raw text
exec_body = @{ (!(^"END-EXEC" | ^"end-exec") ~ ANY)* }

// ── Nested Program ──────────────────────────────────────────────────────────

nested_program_stmt = {
    kw_identification ~ kw_division ~ period
    ~ program_id_paragraph
    ~ id_optional_paragraph*
    ~ environment_division?
    ~ data_division?
    ~ procedure_division?
    ~ nested_program*
    ~ end_program?
}

nested_program = { nested_program_stmt }

// ── Conditions (boolean expressions) ────────────────────────────────────────
// Precedence: NOT > AND > OR
// COBOL also has IS NUMERIC, IS ALPHABETIC, IS POSITIVE, etc.

condition = { or_condition }

or_condition = {
    and_condition ~ (kw_or ~ and_condition)*
}

and_condition = {
    not_condition ~ (kw_and ~ not_condition)*
}

not_condition = {
    kw_not ~ comparison
  | comparison
}

comparison = {
        expression ~ class_condition_test
    | expression ~ sign_condition_test
    | expression ~ comparison_op ~ expression
    | expression ~ !comparison_op
}

class_condition_test = {
    kw_is ~ kw_not? ~ (kw_numeric | kw_alphabetic_lower | kw_alphabetic_upper | kw_alphabetic | ident_name)
}

sign_condition_test = {
    kw_is ~ kw_not? ~ (kw_positive | kw_negative | kw_zero | kw_zeros | kw_zeroes)
}

comparison_op = {
    kw_is? ~ kw_not? ~ (
        kw_equal ~ kw_to?
      | kw_greater ~ kw_than? ~ kw_or? ~ kw_equal?
      | kw_less ~ kw_than? ~ kw_or? ~ kw_equal?
      | ">="
      | "<="
      | ">"
      | "<"
      | "="
      | kw_not ~ "="
    )
}

// ── Expressions (arithmetic) ────────────────────────────────────────────────
// Precedence: +/- > */ > **
// FUNCTION calls, subscripts, qualified names, reference modification

expression = { add_expr }

add_expr = {
    mul_expr ~ ((add_op) ~ mul_expr)*
}

add_op = { "+" | "-" }

mul_expr = {
    power_expr ~ ((mul_op) ~ power_expr)*
}

mul_op = { "*" ~ !"*" | "/" }

power_expr = {
    unary_expr ~ ("**" ~ unary_expr)?
}

unary_expr = {
    unary_op ~ atom
  | atom
}

unary_op = { "-" | "+" }

atom = {
    function_call
  | new_expr
  | paren_expr
  | literal
  | qualified_ident
}

paren_expr = { "(" ~ expression ~ ")" }

// NEW ClassName(args...) — OO COBOL
new_expr = { kw_new ~ ident_name ~ ("(" ~ arg_list? ~ ")")? }

// Identifiers with optional subscript, reference modification, or qualification
qualified_ident = {
    // `qualification*`, not `?`: COBOL qualifies as far out as it needs to —
    // `NAME OF L3 OF L2 OF L1`. With one optional level the parser took
    // `NAME OF L3` and then started a SECOND operand at `L2 OF L1`, so a
    // three-level DISPLAY printed two values.
    (ident_name | keyword_data_name) ~ subscript_or_refmod* ~ qualification*
  | kw_self
}

subscript_or_refmod = { refmod | space_subscript | subscript }
refmod    = { "(" ~ expression ~ ":" ~ expression? ~ ")" }   // reference modification name(start:length)
subscript = { "(" ~ expression ~ ("," ~ expression)* ~ ")" }  // subscript name(idx) or name(idx1, idx2)
space_subscript = { "(" ~ expression ~ (number_literal | level_number)+ ~ ")" }

qualification = { (kw_of | kw_in) ~ (ident_name | keyword_data_name) }

// ── Function calls ──────────────────────────────────────────────────────────

function_call = {
    kw_function ~ function_name ~ function_call_args? ~ subscript_or_refmod*
}

// COBOL function args are space-separated (not comma-separated)
// Function arguments are space-separated primaries (COBOL semantics): `-4` is a
// negative literal, not a subtraction from the previous arg. Using `atom+`
// (rather than `expression+`) stops `MEAN(-2 -4 -6)` collapsing into one
// subtraction expression. Real binary expressions can still be passed
// parenthesized (paren_expr is an atom).
// COBOL separates intrinsic arguments with a space OR a comma; cobc takes
// both. Only the space form parsed here, so `FUNCTION MAX(1, 5, 3)` fell
// through to a silent `null`.
func_args = { (all_table_ref | func_kw_arg | atom) ~ (","? ~ (all_table_ref | func_kw_arg | atom))* }

// Reserved words that appear as intrinsic arguments (e.g. FUNCTION TRIM(x
// LEADING)). `ident_name` excludes strict keywords, so accept them here.
func_kw_arg = { kw_leading | kw_trailing }

// `ALL table-name` — every element of an OCCURS table as an intrinsic argument
// (e.g. FUNCTION MAX(ALL VALS)). Distinct from the `ALL literal` figurative
// constant, so it is tried before atom.
all_table_ref = { kw_all ~ qualified_ident }

function_call_args = { "(" ~ func_args? ~ ")" | atom+ }

arg_list = { expression ~ ("," ~ expression)* }

function_name = {
    kw_length | kw_upper_case | kw_lower_case | kw_trim | kw_reverse
  | kw_current_date | kw_max | kw_min | kw_mod | kw_rem
    | kw_numval_c | kw_numval | kw_substitute
    | kw_sqrt | kw_sum | kw_integer_of_date | kw_integer_of_day | kw_date_of_integer | kw_day_of_integer | kw_integer_part | kw_integer | kw_abs
  | kw_ord | kw_char | kw_floor | kw_ceiling | kw_sign | kw_power
  | kw_log | kw_log10 | kw_exp
  | kw_sin | kw_cos | kw_tan | kw_asin | kw_acos | kw_atan
  | kw_random | kw_mean | kw_median | kw_variance
  | kw_concatenate | kw_when_compiled | kw_test_numval
  | kw_annuity | kw_present_value
  | kw_formatted_date | kw_formatted_time
  | ident_name
}

// ── Literals ────────────────────────────────────────────────────────────────

literal = {
    figurative_constant
  | boolean_literal
  | hex_literal
  | number_literal
  | string_literal
}

figurative_constant = {
    kw_spaces | kw_space
  | kw_zeros | kw_zeroes | kw_zero
  | kw_low_values | kw_low_value
  | kw_high_values | kw_high_value
  | kw_quotes | kw_quote
  | kw_nulls | kw_null
  | kw_all ~ (string_literal | figurative_constant)
}

boolean_literal = { kw_true | kw_false }

number_literal = @{
    ("+" | "-")? ~ (ASCII_DIGIT+ ~ (("." | ",") ~ ASCII_DIGIT+)? | ("." | ",") ~ ASCII_DIGIT+)
}

// The optional `N` is a NATIONAL literal (`MOVE N"CAFE" TO N1`). The rule is
// atomic, so the prefix only counts when it is glued to the opening quote —
// an identifier `N` followed by a separate literal still parses as two tokens.
// Its characters are the same characters; `PIC N(n)` is the width in national
// positions, which is what the string already is.
string_literal = @{
    ("N" | "n")? ~ "\"" ~ (!"\"" ~ ANY)* ~ "\""
  | ("N" | "n")? ~ "'" ~ (!"'" ~ ANY)* ~ "'"
}

hex_literal = @{ ("X" | "x") ~ "\"" ~ ASCII_HEX_DIGIT* ~ "\"" }

// ── Identifiers ─────────────────────────────────────────────────────────────
// COBOL identifiers may contain hyphens but cannot start or end with them.

ident_name = @{ !strict_keyword ~ ident_start ~ (ident_cont | "-" ~ ident_cont)* }
// Any word including reserved words — used in catch-all and member access
ident_or_keyword = @{ ident_start ~ (ident_cont | "-" ~ ident_cont)* }
ident_start = _{ ASCII_ALPHA | "_" }
ident_cont  = _{ ASCII_ALPHANUMERIC | "_" }

// Reserved words that cannot be used as identifiers.
// Matches every COBOL keyword from token.rs.
strict_keyword = _{
    ( ^"identification" | ^"division" | ^"section" | ^"program-id"
    | ^"environment" | ^"data" | ^"procedure"
    | ^"working-storage" | ^"local-storage" | ^"linkage" | ^"screen"
    | ^"file" | ^"fd" | ^"sd"
    | ^"pic" | ^"picture" | ^"value" | ^"occurs" | ^"times"
    | ^"redefines" | ^"renames" | ^"indexed" | ^"usage" | ^"filler"
    | ^"display" | ^"accept" | ^"move" | ^"to" | ^"corresponding" | ^"corr"
    | ^"alter" | ^"proceed"
    | ^"add" | ^"subtract" | ^"from" | ^"giving" | ^"multiply" | ^"by"
    | ^"divide" | ^"remainder" | ^"compute"
    | ^"if" | ^"else" | ^"end-if" | ^"then"
    | ^"evaluate" | ^"when" | ^"other" | ^"end-evaluate" | ^"also"
    | ^"perform" | ^"end-perform" | ^"until" | ^"varying" | ^"thru" | ^"through"
    | ^"with" | ^"test" | ^"before" | ^"after"
    | ^"string" | ^"delimited" | ^"size" | ^"into" | ^"end-string"
    | ^"unstring" | ^"end-unstring"
    | ^"inspect" | ^"tallying" | ^"replacing" | ^"all" | ^"leading" | ^"first"
    | ^"for" | ^"characters" | ^"converting"
    | ^"search" | ^"end-search" | ^"at"
    | ^"call" | ^"cancel" | ^"using" | ^"end-call" | ^"returning" | ^"return"
    | ^"go" | ^"stop" | ^"run" | ^"goback"
    | ^"release" | ^"order"
    | ^"initialize" | ^"set" | ^"continue"
    | ^"raise" | ^"exception"
    | ^"json" | ^"generate" | ^"parse"
    | ^"not" | ^"and" | ^"or"
    | ^"open" | ^"close" | ^"read" | ^"write" | ^"end-read" | ^"end-write"
    | ^"input" | ^"output" | ^"extend" | ^"i-o"
    | ^"sort" | ^"end-sort" | ^"on" | ^"ascending" | ^"descending" | ^"key"
    | ^"rewrite" | ^"end-rewrite" | ^"delete" | ^"end-delete"
    | ^"start" | ^"end-start" | ^"merge"
    | ^"exit" | ^"paragraph"
    | ^"copy" | ^"replacing"
    | ^"true" | ^"false" | ^"null" | ^"nulls"
    | ^"spaces" | ^"space" | ^"zeros" | ^"zeroes" | ^"zero"
    | ^"low-values" | ^"low-value" | ^"high-values" | ^"high-value"
    | ^"quotes" | ^"quote"
    | ^"function" | ^"self" | ^"super" | ^"new"
    | ^"class-id" | ^"method-id" | ^"interface-id"
    | ^"end-class" | ^"end-method" | ^"end-interface"
    | ^"end-program" | ^"end-factory" | ^"end-object"
    | ^"factory" | ^"object" | ^"invoke" | ^"end-invoke"
    | ^"inherits" | ^"implements" | ^"override" | ^"property"
    | ^"typedef" | ^"validate" | ^"free" | ^"allocate"
    | ^"async" | ^"wait" | ^"run" | ^"lock" | ^"unlock"
    | ^"yield" | ^"suspend"
    | ^"exec" | ^"end-exec"
    | ^"rounded" | ^"end-add" | ^"end-subtract" | ^"end-multiply"
    | ^"end-divide" | ^"end-compute"
    | ^"numeric" | ^"alphabetic" | ^"alphabetic-lower" | ^"alphabetic-upper"
    | ^"positive" | ^"negative"
    | ^"national" | ^"global" | ^"external"
    ) ~ !(ident_cont | "-")
}

// ── Keywords (case-insensitive, with word-boundary) ─────────────────────────
// All keywords are atomic to prevent pest from eating partial matches.
// They use ^"..." for case-insensitivity and `word_end` for the word boundary.
//
// ⚠ A COBOL word CONTAINS hyphens, so the boundary must reject a following
// `-word` as well as a following alphanumeric. With the weaker `!ident_cont`,
// `kw_ord` matched the "ORD" PREFIX of `ORD-MAX` and the rest of the line was
// parsed as a subtraction — the same trap for every hyphenated intrinsic and
// for any data name that starts with a reserved word. `strict_keyword` already
// spelled the boundary correctly; these did not.
word_end = _{ !(ident_cont | "-") }

// Division / section structure
kw_identification  = @{ ^"identification"  ~ word_end }
kw_environment     = @{ ^"environment"     ~ word_end }
kw_configuration   = @{ ^"configuration"   ~ word_end }
kw_source_computer = @{ ^"source-computer" ~ word_end }
kw_object_computer = @{ ^"object-computer" ~ word_end }
kw_data            = @{ ^"data"            ~ word_end }
kw_procedure       = @{ ^"procedure"       ~ word_end }
kw_division        = @{ ^"division"        ~ word_end }
kw_section         = @{ ^"section"         ~ word_end }

// Identification division
kw_program_id      = @{ ^"program-id"      ~ word_end }
kw_class_id        = @{ ^"class-id"        ~ word_end }
kw_interface_id    = @{ ^"interface-id"     ~ word_end }
kw_method_id       = @{ ^"method-id"       ~ word_end }
kw_author          = @{ ^"author"          ~ word_end }
kw_date_written    = @{ ^"date-written"    ~ word_end }

// Environment division
kw_special_names   = @{ ^"special-names"   ~ word_end }
kw_repository      = @{ ^"repository"      ~ word_end }
kw_input_output    = @{ ^"input-output"    ~ word_end }
kw_file_control    = @{ ^"file-control"    ~ word_end }
kw_decimal_point   = @{ ^"decimal-point"   ~ word_end }
kw_currency        = @{ ^"currency"        ~ word_end }
kw_alphabet        = @{ ^"alphabet"        ~ word_end }
kw_symbolic        = @{ ^"symbolic"        ~ word_end }
kw_comma           = @{ ^"comma"           ~ word_end }

// Data division sections
kw_working_storage = @{ ^"working-storage" ~ word_end }
kw_local_storage   = @{ ^"local-storage"   ~ word_end }
kw_linkage         = @{ ^"linkage"         ~ word_end }
kw_file            = @{ ^"file"            ~ word_end }
kw_screen          = @{ ^"screen"          ~ word_end }

// Data item keywords
kw_pic             = @{ ^"pic"             ~ word_end }
kw_picture         = @{ ^"picture"         ~ word_end }
kw_value           = @{ ^"value"           ~ word_end }
kw_occurs          = @{ ^"occurs"          ~ word_end }
kw_times           = @{ ^"times"           ~ word_end }
kw_depending       = @{ ^"depending"       ~ word_end }
kw_redefines       = @{ ^"redefines"       ~ word_end }
kw_renames         = @{ ^"renames"         ~ word_end }
kw_usage           = @{ ^"usage"           ~ word_end }
kw_indexed         = @{ ^"indexed"         ~ word_end }
kw_filler          = @{ ^"filler"          ~ word_end }
kw_blank           = @{ ^"blank"           ~ word_end }
kw_justified       = @{ ^"justified"       ~ word_end }
kw_just            = @{ ^"just"            ~ word_end }
kw_synchronized    = @{ ^"synchronized"    ~ word_end }
kw_sync            = @{ ^"sync"            ~ word_end }
kw_global          = @{ ^"global"          ~ word_end }
kw_external        = @{ ^"external"        ~ word_end }

// Usage types
kw_binary          = @{ ^"binary"          ~ word_end }
kw_comp            = @{ ^"comp"            ~ word_end }
kw_comp_1          = @{ ^"comp-1"          ~ word_end }
kw_comp_2          = @{ ^"comp-2"          ~ word_end }
kw_comp_3          = @{ ^"comp-3"          ~ word_end }
kw_comp_5          = @{ ^"comp-5"          ~ word_end }
kw_display_usage   = @{ ^"display"         ~ word_end }
kw_packed_decimal  = @{ ^"packed-decimal"  ~ word_end }
kw_pointer         = @{ ^"pointer"         ~ word_end }
kw_index           = @{ ^"index"           ~ word_end }
kw_float_long      = @{ ^"float-long"      ~ word_end }
kw_float_short     = @{ ^"float-short"     ~ word_end }
kw_national        = @{ ^"national"        ~ word_end }
kw_boolean         = @{ ^"boolean"         ~ word_end }

// FD/SD clauses
kw_fd              = @{ ^"fd"              ~ word_end }
kw_sd              = @{ ^"sd"              ~ word_end }
kw_record          = @{ ^"record"          ~ word_end }
kw_block           = @{ ^"block"           ~ word_end }
kw_contains        = @{ ^"contains"        ~ word_end }
kw_characters      = @{ ^"characters"      ~ word_end }
kw_character       = @{ ^"character"       ~ word_end }
kw_label           = @{ ^"label"           ~ word_end }
kw_standard        = @{ ^"standard"        ~ word_end }
kw_condition       = @{ ^"condition"       ~ word_end }
kw_resume          = @{ ^"resume"          ~ word_end }
kw_omitted         = @{ ^"omitted"         ~ word_end }

// Figurative constants
kw_spaces          = @{ ^"spaces"          ~ word_end }
kw_space           = @{ ^"space"           ~ word_end }
kw_zeros           = @{ ^"zeros"           ~ word_end }
kw_zeroes          = @{ ^"zeroes"          ~ word_end }
kw_zero            = @{ ^"zero"            ~ word_end }
kw_low_values      = @{ ^"low-values"      ~ word_end }
kw_low_value       = @{ ^"low-value"       ~ word_end }
kw_high_values     = @{ ^"high-values"     ~ word_end }
kw_high_value      = @{ ^"high-value"      ~ word_end }
kw_quotes          = @{ ^"quotes"          ~ word_end }
kw_quote           = @{ ^"quote"           ~ word_end }
kw_nulls           = @{ ^"nulls"           ~ word_end }
kw_null            = @{ ^"null"            ~ word_end }
kw_all             = @{ ^"all"             ~ word_end }

// Procedure division verbs
kw_display         = @{ ^"display"         ~ word_end }
kw_accept          = @{ ^"accept"          ~ word_end }
kw_move            = @{ ^"move"            ~ word_end }
kw_add             = @{ ^"add"             ~ word_end }
kw_subtract        = @{ ^"subtract"        ~ word_end }
kw_multiply        = @{ ^"multiply"        ~ word_end }
kw_divide          = @{ ^"divide"          ~ word_end }
kw_compute         = @{ ^"compute"         ~ word_end }
kw_if              = @{ ^"if"              ~ word_end }
kw_else            = @{ ^"else"            ~ word_end }
kw_then            = @{ ^"then"            ~ word_end }
kw_evaluate        = @{ ^"evaluate"        ~ word_end }
kw_when            = @{ ^"when"            ~ word_end }
kw_other           = @{ ^"other"           ~ word_end }
kw_perform         = @{ ^"perform"         ~ word_end }
kw_until           = @{ ^"until"           ~ word_end }
kw_varying         = @{ ^"varying"         ~ word_end }
kw_thru            = @{ ^"thru"            ~ word_end }
kw_through         = @{ ^"through"         ~ word_end }
kw_string          = @{ ^"string"          ~ word_end }
kw_unstring        = @{ ^"unstring"        ~ word_end }
kw_inspect         = @{ ^"inspect"         ~ word_end }
kw_cancel          = @{ ^"cancel"          ~ word_end }
kw_release         = @{ ^"release"         ~ word_end }
kw_return          = @{ ^"return"          ~ word_end }
kw_tallying        = @{ ^"tallying"        ~ word_end }
kw_replacing       = @{ ^"replacing"       ~ word_end }
kw_converting      = @{ ^"converting"      ~ word_end }
kw_leading         = @{ ^"leading"         ~ word_end }
kw_trailing        = @{ ^"trailing"        ~ word_end }
kw_first           = @{ ^"first"           ~ word_end }
kw_initial         = @{ ^"initial"         ~ word_end }
kw_common          = @{ ^"common"          ~ word_end }
kw_recursive       = @{ ^"recursive"       ~ word_end }
kw_call            = @{ ^"call"            ~ word_end }
kw_using           = @{ ^"using"           ~ word_end }
kw_returning       = @{ ^"returning"       ~ word_end }
kw_initialize      = @{ ^"initialize"      ~ word_end }
kw_set             = @{ ^"set"             ~ word_end }
kw_go              = @{ ^"go"              ~ word_end }
kw_to              = @{ ^"to"              ~ word_end }
kw_stop            = @{ ^"stop"            ~ word_end }
kw_run             = @{ ^"run"             ~ word_end }
kw_goback          = @{ ^"goback"          ~ word_end }
kw_continue        = @{ ^"continue"        ~ word_end }
kw_raise           = @{ ^"raise"           ~ word_end }
kw_exception       = @{ ^"exception"       ~ word_end }
kw_json            = @{ ^"json"            ~ word_end }
kw_xml             = @{ ^"xml"             ~ word_end }
kw_generate        = @{ ^"generate"        ~ word_end }
kw_parse           = @{ ^"parse"           ~ word_end }
kw_processing      = @{ ^"processing"      ~ word_end }
kw_encoding        = @{ ^"encoding"        ~ word_end }
kw_attributes      = @{ ^"attributes"      ~ word_end }
kw_xml_declaration = @{ ^"xml-declaration" ~ word_end }
kw_namespace       = @{ ^"namespace"       ~ word_end }
kw_namespace_prefix = @{ ^"namespace-prefix" ~ word_end }
kw_suppress        = @{ ^"suppress"        ~ word_end }
kw_linage          = @{ ^"linage"          ~ word_end }
kw_footing         = @{ ^"footing"         ~ word_end }
kw_top             = @{ ^"top"             ~ word_end }
kw_bottom          = @{ ^"bottom"          ~ word_end }
kw_end_of_page     = @{ ^"end-of-page"     ~ word_end }
kw_open            = @{ ^"open"            ~ word_end }
kw_close           = @{ ^"close"           ~ word_end }
kw_read            = @{ ^"read"            ~ word_end }
kw_write           = @{ ^"write"           ~ word_end }
kw_rewrite         = @{ ^"rewrite"         ~ word_end }
kw_delete          = @{ ^"delete"          ~ word_end }
kw_start           = @{ ^"start"           ~ word_end }
kw_sort            = @{ ^"sort"            ~ word_end }
kw_merge           = @{ ^"merge"           ~ word_end }
kw_search          = @{ ^"search"          ~ word_end }
kw_copy            = @{ ^"copy"            ~ word_end }
kw_invoke          = @{ ^"invoke"          ~ word_end }
kw_validate        = @{ ^"validate"        ~ word_end }
kw_free            = @{ ^"free"            ~ word_end }
kw_allocate        = @{ ^"allocate"        ~ word_end }
kw_typedef         = @{ ^"typedef"         ~ word_end }
kw_exit            = @{ ^"exit"            ~ word_end }

// Control flow keywords
kw_not             = @{ ^"not"             ~ word_end }
kw_and             = @{ ^"and"             ~ word_end }
kw_or              = @{ ^"or"              ~ word_end }
kw_true            = @{ ^"true"            ~ word_end }
kw_false           = @{ ^"false"           ~ word_end }
kw_any             = @{ ^"any"             ~ word_end }

// PERFORM sub-keywords
kw_with            = @{ ^"with"            ~ word_end }
kw_test            = @{ ^"test"            ~ word_end }
kw_before          = @{ ^"before"          ~ word_end }
kw_after           = @{ ^"after"           ~ word_end }
kw_async           = @{ ^"async"           ~ word_end }

// Arithmetic clause keywords
kw_giving          = @{ ^"giving"          ~ word_end }
kw_from            = @{ ^"from"            ~ word_end }
kw_by              = @{ ^"by"              ~ word_end }
kw_into            = @{ ^"into"            ~ word_end }
kw_on              = @{ ^"on"              ~ word_end }
kw_size            = @{ ^"size"            ~ word_end }
kw_error           = @{ ^"error"           ~ word_end }
kw_rounded         = @{ ^"rounded"         ~ word_end }
kw_truncation      = @{ ^"truncation"      ~ word_end }
kw_nearest_even    = @{ ^"nearest-even"    ~ word_end }
kw_nearest_away_from_zero = @{ ^"nearest-away-from-zero" ~ word_end }
kw_nearest_toward_zero = @{ ^"nearest-toward-zero" ~ word_end }
kw_toward_greater  = @{ ^"toward-greater"  ~ word_end }
kw_toward_lesser   = @{ ^"toward-lesser"   ~ word_end }
kw_toward_zero     = @{ ^"toward-zero"     ~ word_end }
kw_away_from_zero  = @{ ^"away-from-zero"  ~ word_end }
kw_prohibited      = @{ ^"prohibited"      ~ word_end }
kw_remainder       = @{ ^"remainder"       ~ word_end }
kw_corresponding   = @{ ^"corresponding"   ~ word_end }
kw_corr            = @{ ^"corr"            ~ word_end }

// String / Unstring keywords
kw_delimited       = @{ ^"delimited"       ~ word_end }
kw_delimiter       = @{ ^"delimiter"       ~ word_end }
kw_count           = @{ ^"count"           ~ word_end }
kw_overflow        = @{ ^"overflow"        ~ word_end }

// File I/O keywords
kw_input           = @{ ^"input"           ~ word_end }
kw_output          = @{ ^"output"          ~ word_end }

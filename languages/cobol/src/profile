# COBOL Compiler Profile
# ──────────────────────
# Maps COBOL intrinsic functions to compiler_common / host builtins.

[info]
name = "cobol"
extensions = ["cob", "cbl", "cobol"]

[compiler]
# Declared types CONVERT the value they bind (assignment, declaration and
# parameter entry alike). Stated explicitly rather than inherited: the platform
# default is `true`, and inheriting it silently gave Python coercive semantics
# it never chose.
coerces_value_to_type_hint = true
# `DISPLAY A B C` emits ONE record with the operands concatenated, no separator.
echo_concatenates_operands = true
function_return = "explicit"
self_keyword = "SELF"
constructor_name = "NEW"
# namespaceplan.md: namespace-shaped entry points resolve through the
# common resolver — same flip as the other languages.
uses_common_resolver = true
case_sensitive = false
string_indexing = "one_based"
# COBOL `ADD`/`+` is numeric only — `STRING`/`&` concatenate. This said `true`
# while the shared emitter carried `dynamic_add && name != "cobol"`, so the
# effective value has always been false; the exclusion just lived in shared code
# instead of here. `dynamic_add` is read at exactly two sites and both carried
# that guard, so moving it is equivalent, not a behaviour change.
# builtinslotplan.md §3c / compilerhardcodedprofile.md.
dynamic_add = false

# ────────────────────────────────────────────────────────────────────────────
# BUILTINS — COBOL intrinsic functions (FUNCTION xxx)
# ────────────────────────────────────────────────────────────────────────────

[builtins]

# ── String ───────────────────────────────────────────────────────────────────

LENGTH              = { emit = "common:str_length",          min_args = 1, max_args = 1 }
UPPER-CASE          = { emit = "common:str_to_upper",        min_args = 1, max_args = 1 }
LOWER-CASE          = { emit = "common:str_to_lower",        min_args = 1, max_args = 1 }
TRIM                = { emit = "common:str_trim",            min_args = 1, max_args = 2 }
# TRIM ... LEADING/TRAILING direction (walker routes the 2-arg form here).
__trim_start        = { emit = "common:str_trim_start",      min_args = 1, max_args = 1 }
__trim_end          = { emit = "common:str_trim_end",        min_args = 1, max_args = 1 }

# ── Runtime environment ─────────────────────────────────────────────────────
# `ACCEPT x FROM ENVIRONMENT "NAME"` used to emit a bare `getenv(name)`, which
# the SHARED fallback table in `primitives/imports.rs` resolves to
# `wasi:cli/environment:get-environment`. That interface takes NO arguments and
# returns the whole (name, value) list, so every ACCEPT tripped the host-call
# arity check and then assigned a LIST to a PIC X field. Declare the real
# nullary readers and let the walker do the lookup — the same shape php's
# `__vybe_env_pairs` uses.
__cobol_env_pairs   = { emit = "host:wasi:cli/environment:get-environment", min_args = 0, max_args = 0 }
__cobol_args        = { emit = "host:wasi:cli/environment:get-arguments",   min_args = 0, max_args = 0 }
REVERSE             = { emit = "common:str_reverse",         min_args = 1, max_args = 1 }
CONCATENATE         = { emit = "common:str_concat",          min_args = 2, max_args = 255 }
SUBSTITUTE          = { emit = "common:str_replace",         min_args = 3, max_args = 3 }
ORD                 = { emit = "host:ecma:string:charCodeAt", min_args = 1, max_args = 1 }
CHAR                = { emit = "common:str_from_char_code",  min_args = 1, max_args = 1 }

# ── Math ─────────────────────────────────────────────────────────────────────

SQRT                = { emit = "opcode:f64_sqrt",            min_args = 1, max_args = 1 }
ABS                 = { emit = "opcode:f64_abs",             min_args = 1, max_args = 1 }
FLOOR               = { emit = "opcode:f64_floor",           min_args = 1, max_args = 1 }
CEILING             = { emit = "opcode:f64_ceil",            min_args = 1, max_args = 1 }
MOD                 = { emit = "opcode:f64_mod",             min_args = 2, max_args = 2 }
REM                 = { emit = "opcode:f64_mod",             min_args = 2, max_args = 2 }
POWER               = { emit = "opcode:pow",         min_args = 2, max_args = 2 }
LOG                 = { emit = "host:ecma:math:log",         min_args = 1, max_args = 1 }
LOG10               = { emit = "host:ecma:math:log10",       min_args = 1, max_args = 1 }
EXP                 = { emit = "host:ecma:math:exp",         min_args = 1, max_args = 1 }
SIN                 = { emit = "host:ecma:math:sin",         min_args = 1, max_args = 1 }
COS                 = { emit = "host:ecma:math:cos",         min_args = 1, max_args = 1 }
TAN                 = { emit = "host:ecma:math:tan",         min_args = 1, max_args = 1 }
ASIN                = { emit = "host:ecma:math:asin",        min_args = 1, max_args = 1 }
ACOS                = { emit = "host:ecma:math:acos",        min_args = 1, max_args = 1 }
ATAN                = { emit = "host:ecma:math:atan",        min_args = 1, max_args = 1 }
RANDOM              = { emit = "host:ecma:math:random",      min_args = 0, max_args = 0 }

# ── Numeric conversion ──────────────────────────────────────────────────────

NUMVAL              = { emit = "host:ecma:number:Number",     min_args = 1, max_args = 1 }
NUMVAL-C            = { emit = "host:ecma:number:Number",     min_args = 1, max_args = 1 }
INTEGER             = { emit = "intrinsic:cint",     min_args = 1, max_args = 1 }
TEST-NUMVAL         = { emit = "host:ecma:number:isNaN",    min_args = 1, max_args = 1 }

# ── Aggregate ────────────────────────────────────────────────────────────────

MAX                 = { emit = "host:ecma:math:max",         min_args = 2, max_args = 255 }
MIN                 = { emit = "host:ecma:math:min",         min_args = 2, max_args = 255 }
SIGN                = { emit = "host:ecma:math:sign",        min_args = 1, max_args = 1 }
# SUM/MEAN/MIDRANGE/RANGE/VARIANCE/STANDARD-DEVIATION/MOD/REM/INTEGER-PART/
# EXP10/PI/E are lowered in the walker (desugar_cobol_math_intrinsic) into
# arithmetic over primitives — no host aggregate fns exist for them.

# ── Date ─────────────────────────────────────────────────────────────────────

# CURRENT-DATE / WHEN-COMPILED / DATE-OF-INTEGER / DAY-OF-INTEGER /
# INTEGER-OF-DATE / INTEGER-OF-DAY / FORMATTED-* are composed in the walker
# (`desugar_cobol_date_intrinsic`) out of the `ecma:date` readings below.
# They used to name `host:wasi:clocks:toISOString` — a module that does not
# exist, so every one of them died as `Unresolved import` — and
# `common:cobol.integer_of_date`, which nothing dispatches.
#
# The wall clock, and the LOCAL component getters COBOL reads it through.
# `ecma:date.now` ignores its arguments; the getters take a raw millisecond
# reading, the same convention `__utc_*` below already relies on.
__now               = { emit = "host:ecma:date:now",            min_args = 0, max_args = 0 }
__local_year        = { emit = "host:ecma:date:getFullYear",    min_args = 1, max_args = 1 }
__local_month       = { emit = "host:ecma:date:getMonth",       min_args = 1, max_args = 1 }
__local_date        = { emit = "host:ecma:date:getDate",        min_args = 1, max_args = 1 }
__local_hours       = { emit = "host:ecma:date:getHours",       min_args = 1, max_args = 1 }
__local_minutes     = { emit = "host:ecma:date:getMinutes",     min_args = 1, max_args = 1 }
__local_seconds     = { emit = "host:ecma:date:getSeconds",     min_args = 1, max_args = 1 }
__local_millis      = { emit = "host:ecma:date:getMilliseconds", min_args = 1, max_args = 1 }
__local_day         = { emit = "host:ecma:date:getDay",         min_args = 1, max_args = 1 }
__tz_offset         = { emit = "host:ecma:date:getTimezoneOffset", min_args = 1, max_args = 1 }

# ── Financial ────────────────────────────────────────────────────────────────

# ANNUITY / PRESENT-VALUE are lowered in the walker (no host fns exist for them).
__to_fixed2         = { emit = "host:ecma:number:toFixed",   min_args = 2, max_args = 2 }

# ── Type checks (walker emits as calls, profile routes them) ────────────────

# Integer-date helpers: COBOL day 1 = 1601-01-01; ms → UTC parts via ecma:date.
__utc_year          = { emit = "host:ecma:date:getUTCFullYear", min_args = 1, max_args = 1 }
__utc_month         = { emit = "host:ecma:date:getUTCMonth",  min_args = 1, max_args = 1 }
__utc_date          = { emit = "host:ecma:date:getUTCDate",   min_args = 1, max_args = 1 }
__date_utc          = { emit = "host:ecma:date:UTC",          min_args = 3, max_args = 3 }
# OCCURS-table aggregates (FUNCTION MAX/MIN/SUM(ALL table)) reduce over the array
# via the shared ECMA iterable reducers — same surface Python's max/min/sum use.
__table_max         = { emit = "host:ecma:math:maxOf",       min_args = 1, max_args = 1 }
__table_min         = { emit = "host:ecma:math:minOf",       min_args = 1, max_args = 1 }
__table_sum         = { emit = "host:ecma:math:sumPrecise",  min_args = 1, max_args = 1 }
# COBOL ORD/CHAR are 1-based; the walker wraps these raw helpers with ±1.
__ord_code          = { emit = "host:ecma:string:charCodeAt", min_args = 1, max_args = 1 }
__char_code         = { emit = "common:str_from_char_code",  min_args = 1, max_args = 1 }
# PICTURE fixed-width DISPLAY padding (walker wraps field operands).
__pad_start         = { emit = "common:str_pad_start",       min_args = 3, max_args = 3 }
__pad_end           = { emit = "common:str_pad_end",         min_args = 3, max_args = 3 }
# DISPLAY writes its finished record to WASI stdout, the same intrinsic c and
# java bind. Byte-faithful and appends nothing — the walker supplies the record
# terminator, since COBOL's record is the operands concatenated with NO
# separator (see `echo_concatenates_operands` above, now unused).
__cobol_display     = { emit = "intrinsic:write_stdout",     min_args = 1, max_args = 1 }
# STOP RUN terminates the whole run from any depth (inside PERFORMed paragraphs
# too) via WASI cli/exit — ends the VM run, not the host process.
__stop_run          = { emit = "host:wasi:cli/exit:exit",    min_args = 0, max_args = 0 }
__is_numeric        = { emit = "host:ecma:number:isNaN",    min_args = 1, max_args = 1 }
__is_alphabetic     = { emit = "noop",                        min_args = 1, max_args = 1 }
__refmod            = { emit = "common:str_substring",       min_args = 3, max_args = 3 }
# 0-based position of a character within a string, -1 when absent — the lookup
# `INSPECT … CONVERTING` translates through.
__index_of          = { emit = "common:str_index_of",        min_args = 2, max_args = 2 }
# INSPECT REPLACING: every occurrence, and the run-length forms it builds.
__replace_all       = { emit = "common:str_replace",         min_args = 3, max_args = 3 }
__repeat            = { emit = "common:str_repeat",          min_args = 2, max_args = 2 }
__array_join        = { emit = "common:collections.join",    min_args = 2, max_args = 2 }
# Ascending sorted COPY of an array — what FUNCTION MEDIAN picks its middle
# from. NOT `__cobol_sort`, which is the SORT *statement* and takes a
# file/keys object.
__sorted            = { emit = "common:collections.sorted",  min_args = 1, max_args = 1 }
f64_floor           = { emit = "opcode:f64_floor",           min_args = 1, max_args = 1 }
f64_ceil            = { emit = "opcode:f64_ceil",            min_args = 1, max_args = 1 }
f64_trunc           = { emit = "opcode:f64_trunc",           min_args = 1, max_args = 1 }
f64_nearest         = { emit = "opcode:f64_nearest",         min_args = 1, max_args = 1 }
__cobol_round_away_from_zero = { emit = "common:cobol.round_away_from_zero", min_args = 1, max_args = 1 }
__cobol_cancel      = { emit = "common:cobol.cancel",        min_args = 1, max_args = 1 }
__cobol_release     = { emit = "common:cobol.release",       min_args = 2, max_args = 2 }
__cobol_return      = { emit = "common:cobol.return_record", min_args = 1, max_args = 1 }
__cobol_alter       = { emit = "common:cobol.alter",         min_args = 2, max_args = 2 }
__cobol_sort        = { emit = "common:cobol.sort",          min_args = 1, max_args = 1 }
__cobol_merge       = { emit = "common:cobol.merge",         min_args = 1, max_args = 1 }
__cobol_copy        = { emit = "common:cobol.copy",          min_args = 1, max_args = 1 }
__cobol_validate    = { emit = "common:cobol.validate",      min_args = 1, max_args = 1 }
__cobol_typedef     = { emit = "common:cobol.typedef",       min_args = 2, max_args = 2 }
__move_corresponding = { emit = "common:cobol.move_corresponding", min_args = 2, max_args = 2 }

# ── EXEC blocks (walker emits as calls) ─────────────────────────────────────

# Embedded SQL rides the SAME flat `wasi:sql` surface PDO does. The old
# `__exec_sql` named `wasi:sql:execRaw`, which does not exist — every EXEC SQL
# died as `Unresolved import`.
__sql_connect       = { emit = "host:wasi:sql:connect",  min_args = 1, max_args = 1 }
__sql_close         = { emit = "host:wasi:sql:close",    min_args = 1, max_args = 1 }
__sql_query         = { emit = "host:wasi:sql:query",    min_args = 2, max_args = 3 }
__sql_execute       = { emit = "host:wasi:sql:execute",  min_args = 2, max_args = 3 }
__sql_commit        = { emit = "host:wasi:sql:commit",   min_args = 1, max_args = 1 }
__sql_rollback      = { emit = "host:wasi:sql:rollback", min_args = 1, max_args = 1 }
# A result row is keyed by column name; host variables bind POSITIONALLY.
__row_values        = { emit = "common:dict.values",     min_args = 1, max_args = 1 }
# XML PARSE reads the document through the shared xml primitive.
__xml_parse         = { emit = "common:xml.parse",       min_args = 1, max_args = 2 }
__exec_cics         = { emit = "noop",                        min_args = 1, max_args = 1 }
__exec_dli          = { emit = "noop",                        min_args = 1, max_args = 1 }

[value_methods]
# COBOL does not have instance methods in the conventional sense.

# ────────────────────────────────────────────────────────────────────────────
# ARRAY METHODS — higher-order collection dispatch.
#
# COBOL has no source-level HOFs, but the walker desugars table/string
# operations (e.g. UNSTRING DELIMITED BY ALL drops empty tokens via .filter)
# into ECMA-shaped array method calls. This table gates the shared compiler's
# inline HOF loop emitter (common::loops::emit_map/emit_filter/…) — the same
# path PHP and Python use — so the receiver array is walked in-VM with no host
# prototype dependency. Names mirror the shared emit_* opcodes.
# ────────────────────────────────────────────────────────────────────────────

[array_methods]
map       = "__array_map"
filter    = "__array_filter"
forEach   = "__array_forEach"
find      = "__array_find"
findIndex = "__array_findIndex"
includes  = "__array_includes"
reduce    = "__array_reduce"
sort      = "__array_sort"
some      = "__array_some"
every     = "__array_every"

[namespaces]
roots = []
extra_imports = []

# C Compiler Profile
# ──────────────────
# Covers C99 core: functions, structs (as objects), arrays, pointers
# (modeled as references), stdio/string/math/stdlib library functions.
# C-specific runtime semantics (printf format codes) route through the
# libc formatter under platforms/libc.

[info]
name = "c"
extensions = ["c", "h"]

[compiler]
# Declared types CONVERT the value they bind (assignment, declaration and
# parameter entry alike). Stated explicitly rather than inherited: the platform
# default is `true`, and inheriting it silently gave Python coercive semantics
# it never chose.
coerces_value_to_type_hint = true
# `(double)x` / `(float)x` coerce without truncating.
float_cast_types = ["double", "float"]
# `int a[3] = {...}` / `char s[] = "hi"` are aggregates, not scalars to coerce.
aggregate_decl_skips_coercion = true
# A translation unit may take the address of an externally-defined object.
globals_may_be_undeclared = true
# `&v` promotes once at entry, not per `&v` site.
promote_addr_taken_at_entry = true
# libc supplies sprintf; the shared helper must not be linked over it.
excluded_runtime_helpers = ["__stdlib_sprintf"]
# `int / int` truncates. C# has always declared this; C reached the SAME shared
# block through a `profile.name == "c"` check that carried a second copy of the
# integer-spelling test (builtinslotplan.md §3c).
integer_division_on_slash = true
function_return = "explicit"
self_keyword = "this"
constructor_name = "constructor"
case_sensitive = true
string_indexing = "zero_based"
entry_point = "main"
# Headers ARE imports (`#include <stdio.h>` → `libc.stdio`): builtins under
# these roots require the activating include, clang-style — implicit
# declarations are compile errors.
gated_namespace_roots = ["libc", "sdl"]
dynamic_add = true
uses_normalize_class = false
# Route function/method resolution through the common namespace resolver
# (namespaceplan.md) like JS/PHP/VB — so libc + ecma/wasi calls resolve via
# the one tree instead of the profile-builtin fallback that dies inside
# injected runtime helpers.
uses_common_resolver = true

# ────────────────────────────────────────────────────────────────────────────
# BUILTINS — bare global function calls
# ────────────────────────────────────────────────────────────────────────────

[builtins]

# ── SDL (via platforms/libc adapter) ────────────────────────────────────────────

# ── stdio ────────────────────────────────────────────────────────────────────
# Walker normalizations (in walker.rs):
#   printf(fmt, args...)    → libc printf emitter / C fputs lowering
#   fprintf(f, fmt, args...)→ puts(sprintf(fmt, args...))  (stream dropped)
#   sprintf(buf, fmt, args...)→ sprintf(fmt, args...)      (buf dropped)
#   snprintf(buf,n,fmt,...) → sprintf(fmt, args...)
"printf"  = { emit = "common:libc.stdio.printf",  min_args = 1, max_args = 255 }
# sprintf routes through the libc inline emitter helper (no JS polyfill).
"sprintf"  = { emit = "common:libc.stdio.sprintf", min_args = 1, max_args = 255 }
"__c_sprintf" = { emit = "common:libc.stdio.sprintf", min_args = 1, max_args = 255 }
"__c_vsprintf" = { emit = "common:libc.stdio.vsprintf", min_args = 2, max_args = 2 }
"__c_char_code_at" = { emit = "common:str_char_code_at", min_args = 2, max_args = 2 }
# system() runs a REAL /bin/sh -c through node:child_process; fopen falls
# back to the real filesystem on a store miss so shell redirects compose.
"__c_spawn_sync" = { emit = "host:node:child_process:spawnSync", min_args = 2, max_args = 3 }
# getenv/setenv share ONE runtime env object, seeded from the real process
# environment via the WASI CLI interface.
"__c_get_environment" = { emit = "host:wasi:cli/environment:get-environment", min_args = 0, max_args = 0 }
"__c_fs_exists" = { emit = "host:node:fs:existsSync", min_args = 1, max_args = 1 }
"__c_fs_read" = { emit = "host:node:fs:readFileSync", min_args = 2, max_args = 2 }
"__c_fs_rm" = { emit = "host:node:fs:rmSync", min_args = 1, max_args = 1 }
# exec* replaces the process image: at top level the run ENDS with the
# child's status (WASI's exit arm), same as `exit(code)`.
"__c_exit_with_code" = { emit = "host:wasi:cli/exit:exit-with-code", min_args = 1, max_args = 1 }
# ── sockets: REAL wasi:sockets, the same rows python's socket class uses ─────
# The start-*/finish-* pairs are two calls because the proposal is poll-based;
# a C socket call is blocking, so the runtime helpers do both — exactly the
# sequencing python's VybeSocketImpl performs. `read` is the NON-blocking arm
# on purpose: a poll-shaped `accept` answers nothing when the queue is empty,
# and `blocking-read` would hang the process instead of failing.
"__c_wasi_network"     = { emit = "host:wasi:sockets/instance-network:instance-network", min_args = 0, max_args = 0 }
"__c_wasi_tcp_new"     = { emit = "host:wasi:sockets/tcp-create-socket:create-tcp-socket", min_args = 0, max_args = 1 }
"__c_wasi_udp_new"     = { emit = "host:wasi:sockets/udp-create-socket:create-udp-socket", min_args = 0, max_args = 1 }
"__c_wasi_start_bind"  = { emit = "host:wasi:sockets/tcp:start-bind",     min_args = 3, max_args = 3 }
"__c_wasi_finish_bind" = { emit = "host:wasi:sockets/tcp:finish-bind",    min_args = 1, max_args = 1 }
"__c_wasi_backlog"     = { emit = "host:wasi:sockets/tcp:set-listen-backlog-size", min_args = 2, max_args = 2 }
"__c_wasi_start_listen" = { emit = "host:wasi:sockets/tcp:start-listen",  min_args = 1, max_args = 1 }
"__c_wasi_finish_listen" = { emit = "host:wasi:sockets/tcp:finish-listen", min_args = 1, max_args = 1 }
"__c_wasi_start_conn"  = { emit = "host:wasi:sockets/tcp:start-connect",  min_args = 3, max_args = 3 }
"__c_wasi_finish_conn" = { emit = "host:wasi:sockets/tcp:finish-connect", min_args = 1, max_args = 1 }
"__c_wasi_accept"      = { emit = "host:wasi:sockets/tcp:accept",         min_args = 1, max_args = 1 }
"__c_wasi_local_addr"  = { emit = "host:wasi:sockets/tcp:local-address",  min_args = 1, max_args = 1 }
"__c_wasi_remote_addr" = { emit = "host:wasi:sockets/tcp:remote-address", min_args = 1, max_args = 1 }
"__c_wasi_sock_shutdown" = { emit = "host:wasi:sockets/tcp:shutdown",    min_args = 1, max_args = 2 }
"__c_wasi_udp_start_bind"  = { emit = "host:wasi:sockets/udp:start-bind",     min_args = 3, max_args = 3 }
"__c_wasi_udp_finish_bind" = { emit = "host:wasi:sockets/udp:finish-bind",    min_args = 1, max_args = 1 }
# UDP datagrams flow through the socket's datagram STREAMS, not through
# connect/send on the socket itself (wasi:sockets/udp `stream` hands back
# the incoming/outgoing pair).
"__c_wasi_udp_stream"      = { emit = "host:wasi:sockets/udp:stream",         min_args = 1, max_args = 2 }
"__c_wasi_dgram_send"      = { emit = "host:wasi:sockets/udp:[method]outgoing-datagram-stream.send",   min_args = 2, max_args = 2 }
"__c_wasi_dgram_recv"      = { emit = "host:wasi:sockets/udp:[method]incoming-datagram-stream.receive", min_args = 1, max_args = 2 }
"__c_wasi_stream_read" = { emit = "host:wasi:io/streams:read",            min_args = 2, max_args = 2 }
"__c_wasi_stream_write" = { emit = "host:wasi:io/streams:blocking-write-and-flush", min_args = 2, max_args = 2 }
"__c_fs_rename" = { emit = "host:node:fs:renameSync", min_args = 2, max_args = 2 }
# Code-point boundary ops for wide (wchar_t/char32_t) buffers: whole code
# points, not UTF-16 units — the unit ops above are for char/char16_t.
"__c_code_point_at" = { emit = "common:str_code_point_at", min_args = 2, max_args = 2 }
"__c_from_code_point" = { emit = "common:str_from_code_point", min_args = 1, max_args = 1 }
# pthreads ARE wasm threads. `thread_spawn` is the shared spawn lowering
# (funcref table.grow → 16-byte {fn_idx,status,user_arg} futex record →
# the `wasi:threads.thread-spawn` import); `thread_join` is the futex wait
# on that record's status word. The user_arg word is an i32, so what rides
# it is the C thread HANDLE — the start function and its `void*` argument
# travel in the shared `__c_thread_starts/_args` objects instead.
"__c_thread_spawn" = { emit = "common:threading.thread_spawn", min_args = 2, max_args = 2 }
# Real blocking sleep (WASI `subscribe-duration` + `pollable.block`) — what a
# waiter yields with instead of burning a core.
"__c_sleep_ms" = { emit = "common:threading.sleep", min_args = 1, max_args = 1 }
"__c_task_wait" = { emit = "common:threading.thread_join", min_args = 1, max_args = 1 }
"__c_str_index_of" = { emit = "common:str_index_of", min_args = 2, max_args = 2 }
"__c_str_last_index_of" = { emit = "common:str_last_index_of", min_args = 2, max_args = 2 }
"__c_str_concat" = { emit = "common:str_concat", min_args = 2, max_args = 2 }
"puts"     = { emit = "print",          min_args = 1, max_args = 1 }
"putchar"  = { emit = "common:c.putchar", min_args = 1, max_args = 1 }
# Single code point → 1-char string. Used by libc adapters (e.g. decoding a
# code-point array one element at a time). Spread (`...arr`) is NOT supported by
# the fixed-arity opcode — decode element-by-element instead.
"String.fromCharCode" = { emit = "common:c.putchar", min_args = 1, max_args = 1 }

# Line-read primitive backing the libc stdin token reader (scanf/getchar/fgets).
# intrinsic:readline → emitter::io::emit_input → wasi:cli/stdin.get-stdin +
# wasi:io/streams.blocking-read. WASM/WASI under the hood; the libc surface is
# shared across languages via platforms/libc/stdio_adapter.rs.
"__libc_readline" = { emit = "intrinsic:readline", min_args = 0, max_args = 0 }

# stdout write primitive → wasi:io DIRECTLY (wasi:cli/stdout.get-stdout +
# wasi:io/streams.blocking-write-and-flush). Byte-faithful, no implicit newline.
# libc output must NOT route through the `print`/wasi:logging vybelib builtin.
"__c_write_stdout" = { emit = "intrinsic:write_stdout", min_args = 1, max_args = 1 }
"__c_write_stderr" = { emit = "intrinsic:write_stderr", min_args = 1, max_args = 1 }

# ── stdio.h extras ───────────────────────────────────────────────────────────
# `fflush(stdout)` and stream flushes route through the walker's handle-based
# stdio runtime substrate. `getchar()` still needs a true stdin-backed path.
"getchar"  = { emit = "noop",                     min_args = 0, max_args = 0 }

# ── string.h ─────────────────────────────────────────────────────────────────
# strlen/strcmp work directly via opcode/emitter
# `exit(code)` ENDS THE RUN with that status — it is not a return. Compiling it
# to a bare return let a caller carry on and the process still exited 0, the
# same bug PHP's `exit` had. `exit-with-code` is the WASI arm that carries a
# real status.
"strlen"   = { emit = "common:c.strlen",    min_args = 1, max_args = 1 }
"strcmp"   = { emit = "common:c.strcmp",        min_args = 2, max_args = 2 }
"strncmp"  = { emit = "common:c.strncmp",        min_args = 2, max_args = 3 }
# strcpy/strncpy/strcat/strncat/memcpy/memmove/memset: walker rewrites to
# assignment / concat / buffer-copy operations.
# strchr/strrchr/strstr/memchr: walker rewrites to slice-or-null pointer forms.
"strupr"   = { emit = "common:c.strupr",   min_args = 1, max_args = 1 }
"strlwr"   = { emit = "common:c.strlwr",   min_args = 1, max_args = 1 }
"memcmp"   = { emit = "common:c.memcmp",        min_args = 3, max_args = 3 }

# ── ctype.h ──────────────────────────────────────────────────────────────────
# The walker inlines every classifier as C-locale ASCII integer arithmetic
# (`primitives::codepoints::c_is*`) — the char stays an int end to end, exactly
# the C model. No profile rows: the old host:ecma:string:is* rows here were
# DEAD (the walker rewrite always won) and pointed at non-ECMA host fns; a
# ctype call the walker cannot see (e.g. through a function pointer) now fails
# loudly instead of silently answering with Unicode string semantics.

# ── stdlib.h ─────────────────────────────────────────────────────────────────
"atoi"     = { emit = "common:c.atoi",               min_args = 1, max_args = 1 }
"atol"     = { emit = "common:c.atol",               min_args = 1, max_args = 1 }
"atof"     = { emit = "host:ecma:number:parseFloat", min_args = 1, max_args = 1 }

"parseFloat" = { emit = "host:ecma:number:parseFloat", min_args = 1, max_args = 1 }
"strtol"   = { emit = "host:ecma:number:parseInt",   min_args = 1, max_args = 3 }
"strtof"   = { emit = "host:ecma:number:parseFloat", min_args = 1, max_args = 2 }
"strtod"   = { emit = "host:ecma:number:parseFloat", min_args = 1, max_args = 2 }
"abs"      = { emit = "opcode:f64_abs",              min_args = 1, max_args = 1 }
"labs"     = { emit = "opcode:f64_abs",              min_args = 1, max_args = 1 }

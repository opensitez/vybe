# Software-renderer frame path: expand an 8-bit palette-indexed buffer to RGBA
# and present it. Doom's `I_FinishUpdate` in one call. Destination size is
# optional and defaults to the source size.
"SDL_BlitPaletted" = { emit = "common:libc.sdl.SDL_BlitPaletted", min_args = 5, max_args = 7 }
# Tier 1 — input (`sdlplan.md`). PollEvent/PushEvent take &event; the HOST

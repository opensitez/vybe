"exp"      = { emit = "host:ecma:math:exp",  min_args = 1, max_args = 1 }
"expf"     = { emit = "host:ecma:math:exp",  min_args = 1, max_args = 1 }
"sinh"     = { emit = "host:ecma:math:sinh", min_args = 1, max_args = 1 }

# Which built-in each of this language's type spellings NAMES — step 4a.
#
# `Compiler` used to hold this list itself, as `hint.contains("int") ||
# hint.contains("long") || ...` in shared code. `*x*` is a substring match, so
# `unsigned int` and `long long` still resolve. `char` and `bool` are integer
# types in C — `char a = 7, b = 2; a / b` is 3 — and listing them here shadows
# the platform table's `char`/`bool` rows for C only, which is exactly what the
# old predicate did.
[builtin_types]
int = ["*int*", "*long*", "*short*", "*char*", "bool", "_bool"]

# Cast-to-integer widths. `(char)x` truncates then wraps to 8 unsigned bits;
# `(long)x` truncates only (no entry for `bits`).
[integer_cast_widths]
char = { bits = 8, signed = false }
uint8 = { bits = 8, signed = false }
int16 = { bits = 16, signed = true }
int = { bits = 32, signed = true }
uint32 = { bits = 32, signed = false }
unsigned = { bits = 32, signed = false }
"unsigned int" = { bits = 32, signed = false }
"unsigned long" = { bits = 32, signed = false }
long = {}

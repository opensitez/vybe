# ────────────────────────────────────────────────────────────────────────────
# ESM DEFAULTS (namespaceplan.md): Java packages ARE its namespaces.
# `java.*` fully-qualified chains walk the global namespace tree at the
# `jvm.java` root (the surface platforms/jvm contributes as Type nodes);
# the ambient root is the data form of Java's implicit `java.lang.*`
# import — bare qualified chains (`Integer.parseInt`) additionally search
# under `jvm.java` when nothing shadows them.
# ────────────────────────────────────────────────────────────────────────────

[[esm_default]]
kind = "tree-mount"
prefix = "java"
path = "jvm.java"

[[esm_default]]
kind = "tree-ambient"
path = "jvm.java"

# Per-PACKAGE ambient roots — `java.lang.*` is implicitly imported by the JLS,
# and the rest are what `import java.util.UUID;` makes reachable as the bare
# `UUID`. Same shape and same mechanism as csharp's `dotnet.system`,
# `dotnet.system.text`, ... list: a bare qualified chain searches each root in
# declaration order. DATA, so the resolver needs no per-language behaviour.

[[esm_default]]

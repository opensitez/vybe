# Java Compiler Profile
# ──────────────────────
# Covers java.lang, java.util, java.io, java.math.
# System.out.println / System.out.print are rewritten by the walker to
# bare `println` / `print` calls which map to emit = "print".

[info]
name = "java"
extensions = ["java"]

[compiler]
# Declared types CONVERT the value they bind (assignment, declaration and
# parameter entry alike). Stated explicitly rather than inherited: the platform
# default is `true`, and inheriting it silently gave Python coercive semantics
# it never chose.
coerces_value_to_type_hint = true
field_hiding = true            # static-type field resolution: subclass field hides parent, distinct slots
function_return    = "explicit"
self_keyword       = "this"
base_keyword       = "super"
constructor_name   = "__init__"    # walker rewrites Java ctor to __init__
case_sensitive     = true
string_indexing    = "zero_based"
uses_normalize_class = true
# namespaceplan.md: namespace-shaped entry points resolve through the
# common resolver (compiler::resolver) instead of legacy hardcoded arms —
# same flip as JS/VB/C#/PHP/C/dart, driven by the esm_default data below.
uses_common_resolver = true
# entry_point not needed — walker injects Main.main() call directly
# Java + on strings concatenates (auto-coercion via toString())
dynamic_add        = true
materialize_bool_results = true
# BigInt needs no flag: the `__java_bigint` builtin below reaches
# `ecma:bigint`, and the shared compiler derives the capability from it.

[builtin_types]
# Java's `char` VALUE holds a character (a one-char string in the value
# model — it renders as `Z` and concatenates as `"A" + 'Z'`), same as
# Pascal's declaration. Without this row the inferred `char` hint falls
# through to the platform width table's `char -> U8` entry and a char
# local gets a modular BYTE coercion — `char c = 'Z'` stored NaN. The
# walker owns the JLS §5.6.2 numeric contexts (`__java_char_ord`).
string = ["char"]

# ────────────────────────────────────────────────────────────────────────────
# BUILTINS — bare global function calls (after walker normalisation)
# ────────────────────────────────────────────────────────────────────────────

[builtins]

# Inline-emit builtins (`opcode:` / `intrinsic:`). These have no
# process-global target, so the namespace tree cannot host them and they
# stay with the language that emits them directly. Everything with a
# `common:` or `host:` target lives in platforms/jvm and is shared.
"Boolean.parseBoolean"   = { emit = "intrinsic:cbool",           min_args = 1, max_args = 1 }
"Boolean.valueOf"        = { emit = "intrinsic:cbool",           min_args = 1, max_args = 1 }
"String.valueOf"         = { emit = "intrinsic:tostring",        min_args = 1, max_args = 1 }
"Integer.toString"       = { emit = "intrinsic:tostring",        min_args = 1, max_args = 2 }
"Integer.min"            = { emit = "opcode:f64_min",          min_args = 2, max_args = 2 }
"Integer.max"            = { emit = "opcode:f64_max",          min_args = 2, max_args = 2 }
"Integer.MAX_VALUE"      = { emit = "intrinsic:int_max",         min_args = 0, max_args = 0 }
"Integer.MIN_VALUE"      = { emit = "intrinsic:int_min",         min_args = 0, max_args = 0 }
"Double.MAX_VALUE"       = { emit = "intrinsic:dbl_max",         min_args = 0, max_args = 0 }
"Math.sqrt"   = { emit = "opcode:f64_sqrt",         min_args = 1, max_args = 1 }
"Math.floor"  = { emit = "opcode:f64_floor",        min_args = 1, max_args = 1 }
"Math.ceil"   = { emit = "opcode:f64_ceil",         min_args = 1, max_args = 1 }
"Math.round"  = { emit = "opcode:f64_nearest",      min_args = 1, max_args = 1 }
"Math.min"    = { emit = "opcode:f64_min",          min_args = 2, max_args = 2 }
"Math.max"    = { emit = "opcode:f64_max",          min_args = 2, max_args = 2 }
"Math.PI"     = { emit = "intrinsic:math_pi",       min_args = 0, max_args = 0 }
"Math.E"      = { emit = "intrinsic:math_e",        min_args = 0, max_args = 0 }
"Math.rint"   = { emit = "opcode:f64_nearest",      min_args = 1, max_args = 1 }
"StrictMath.sqrt"   = { emit = "opcode:f64_sqrt",         min_args = 1, max_args = 1 }

# ────────────────────────────────────────────────────────────────────────────
# BUILTIN SLOTS — what an operator does to a BUILT-IN type (builtinslotplan §2d)
# ────────────────────────────────────────────────────────────────────────────

[builtin_slots.string]
# The per-operand cast `+` applies when either side is a String (JLS §15.18.1,
# specified as `String.valueOf`). The platform default is the ECMA coercion,
# which renders `4.0` as `4` and never consults an object's ToString slot —
# both wrong for Java. Measured against `/usr/bin/java`: `"" + 4.0` is `4.0`,
# and a class with `toString(){ return this.s; }` renders through it.
#
# This is the SAME binding string interpolation reads, so the two cannot drift
# (`project_interpolation_tostring_slot`). It is a slot, not a hook: the
# question "what does operator X do to built-in type Y" is a slot by rule.
to_string = "common:jvm.java.to_string"

# A Java `double`/`float` always renders with a fractional part — `"" + 4.0` is
# `4.0`, `String.valueOf(4.0d)` is `4.0` — where the general renderer above
# falls through to the ECMA coercion's `4`. The more specific row wins wherever
# the expression is statically a double, so `+`, interpolation and
# `String.valueOf` all read the SAME declaration.
[builtin_slots.double]
to_string = "common:java.double_to_string"

[namespaces]

# Namespace-tree roots this language resolves platform types against, and mounts
# ambiently so an unqualified type name resolves to its `Type` node. Java's own
# stdlib surface registers under `jvm.java` (see `tree_register.rs`), so a type used
# as a VALUE (`ArrayList.class`) reaches the shared `Ctor`/`ancestry` machinery
# instead of resolving to nothing.
type_scopes = ["jvm"]
roots = []
extra_imports = []

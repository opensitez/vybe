# PHP Compiler Profile
# ─────────────────────
# Phase 1: minimal surface to get hello-world and basic programs running.
# All ~200 PHP builtins from vybe_compiler_php will be added incrementally
# as test files are ported.

[info]
name = "php"
extensions = ["php", "phtml"]

[compiler]
# Global namespace spelling — see crates/vybe_compiler/src/primitives/globals.rs
global_namespace = "$GLOBALS"
separate_property_method_namespace = true   # $o->foo (property) and $o->foo() (method) coexist
# namespaceplan.md (PHP phase): namespace-shaped entry points (package-root
# `\Vybe\...` chains, wildcard namespace member access) resolve through the
# common resolver instead of the legacy hardcoded arms. PHP's vybe/wasi/wasm
# package roots were already profile data.
uses_common_resolver = true
has_ecma_bigint = true               # ecma:bigint for BigInt operands
has_generators = true                # PHP generators (yield)
abstract_equality = true             # PHP == loose equality
function_return = "explicit"
member_call_on_null_error = "Error" # `$null->method()` throws `Error` (PHP);
                                    # JS default is `TypeError`.
throwable_is_root = true            # `Throwable` is the universal root; the
                                    # `Error` and `Exception` branches are
                                    # siblings, so `catch (Exception)` does not
                                    # catch `Error`s (matches via __types chain).
string_aware_relational = true      # `<`/`>`/`<=`/`>=`/`<=>` compare strings
                                    # lexicographically, else numeric/dynamic;
                                    # DateTime operands unboxed first.
supports_autoload = true            # undefined class ctor → spl_autoload_register
missing_arg_is_undefined = true     # a param default fires only when the arg is
                                    # OMITTED (padded `undefined`), not when an
                                    # explicit `null` is passed — `f(x: null)`
                                    # keeps `null`, doesn't fall back to default.
                                    # callback, then retry.
unified_array_map = true          # ONE `array` type: list + dict, autovivifying
concat_stringifies_operands = true # `.` stringifies both sides (true→"1", null→"", array→"Array")
function_scoped_variables = true   # `if (true) { $x = 1; } echo $x;` is legal — blocks don't scope
buffered_iterator_methods = true    # $gen->current()/next()/valid()/send()/
                                    # getReturn(); foreach buffers current value.
source_function_callable_aliases = true # String callables and dynamic name
                                        # dispatch resolve declared functions
                                        # through the common callable alias path.
self_keyword = "$this"              # PHP variables canonicalize with the $
                                    # sigil (see strip_dollar in walker.rs).
                                    # `$this` IS the scope name; matching
                                    # the canonical form is required for
                                    # `$this->prop` resolution inside methods.
constructor_name = "__construct"
case_sensitive = true              # VARIABLES are case-sensitive.
fold_callable_names = true         # FUNCTION and CLASS names are not. Declaring
                                    # the two halves separately replaced a
                                    # `profile.name == "php"` check inside
                                    # `LanguageProfile::lookup_builtin` — a
                                    # language-name gate living in the VM crate.
string_indexing = "zero_based"
switch_fallthrough = true           # PHP switch falls through like JS/C unless break/return/throw exits.
# PHP-specific
dynamic_add = false                 # `+` is numeric only; `.` is concat
# Route `class` declarations through common::classes::normalize_class
# + emit_class (see classnormalization.md). Magic methods like
# __toString / __invoke / __get / __set / __call canonicalise to the
# cross-language names (tostring / call / getattr / setattr).
uses_normalize_class = true

# ────────────────────────────────────────────────────────────────────────────
# BUILTINS — bare global function calls
# ────────────────────────────────────────────────────────────────────────────
#
# Phase 1 covers the most common ~80 builtins. Phase 2 will fill in the
# remaining ~120 from vybe_compiler_php's try_compile_builtin table.

[builtins]


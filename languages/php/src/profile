# ────────────────────────────────────────────────────────────────────────────
# NAMESPACES — none. PHP namespaces are flattened by the walker.
# ────────────────────────────────────────────────────────────────────────────

[namespaces]
use_dotnet = false
roots = []
extra_imports = []

# ────────────────────────────────────────────────────────────────────────────
# ESM DEFAULTS — Component Model host packages.
#
# Any qualified call whose first segment matches one of these resolves
# directly to a host call, no profile builtin entry required.
# E.g. `\Vybe\Http\Response\set_status(404)` →
#   host call `(module="vybe:http/response", name="set_status")`.
# ────────────────────────────────────────────────────────────────────────────

[[esm_default]]
kind = "package-root"
prefix = "vybe"
module_root = "vybe:"

[[esm_default]]
kind = "package-root"
prefix = "wasi"
module_root = "wasi:"

[[esm_default]]
kind = "package-root"
prefix = "wasm"
module_root = "wasm:"

# ── builtinslotplan.md step 4 ────────────────────────────────────────────
# PHP's own spellings. Step 3's census measured `function g(array $xs)`
# producing the hint `array`, which no shared classifier reads.
[builtin_types]
string = ["string"]
int    = ["int"]
double = ["float"]
bool   = ["bool"]
array  = ["array", "iterable"]

# PHP's OVERRIDES of the platform default slot table — builtinslotplan.md §2a.
#
# `<=>` is the primitive; `<` / `<=` / `>` / `>=` are its sign against 0 (§2f).
# Declaring it here is what replaced THREE mechanisms that all answered the
# same question: the `string_aware_relational` profile bool, the name-keyed
# `LanguageHooks::relational_compare` callback, and the shared emitter building
# `<=>` out of two `<`/`>` calls.
[builtin_slots.string]
compare = "common:php.compare3"
# PHP counts UTF-8 BYTES: `strlen("café")` is 5 where the platform default
# (`host:ecma:string:length`) counts UTF-16 units and answers 4. Until
# `common:str_byte_length` existed there was nothing on the platform to bind
# here — php's counter was private to its own adapter, which is exactly the
# fork `builtinslotplan.md` §1 set out to remove.
len = "common:str_byte_length"
# `==` / `!=`. PHP's loose equality coerces (`"1" == 1` is true) and is NOT the
# platform's `ops::emit_dyn_eq`.
#
# This was a WALKER REWRITE to a `__php_loose_eq(...)` call plus a PHP-SOURCE
# prelude function, pulled in by a substring scan of the AST text
# (`needs.class_helpers`). The profile never declared the identifier, so the
# call reached neither the prelude reliably nor the `emit_php_loose_eq` emitter
# that already existed — and `$a == $b` on two equal strings answered a raw,
# untyped `0`. Literals were unaffected because they constant-fold first, which
# is why it survived.
eq = "common:php.loose_eq"
# `!=` / `<>` is its own target, not `eq` negated: the emitter materializes a
# real Bool and `emit_dyn_not` would discard that, printing `0` for
# `bool(false)`.
ne = "common:php.loose_ne"
# The cast `.` applies to each operand before concatenating. PHP renders `true`
# as "1", `false`/`null` as "", and an array as "Array" — none of which is the
# ECMA `String()` coercion the platform defaults to.
to_string = "common:php.concat_stringify"

# `+` on two arrays is UNION, not concatenation: keys present on the left win,
# so `[1,2,3] + [10,20,30,40]` is `[1,2,3,40]`. Arithmetic `+` on numbers is
# unaffected — this binding is only consulted for the non-numeric case.
[builtin_slots.array]
add = "common:php.add"

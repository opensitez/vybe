# ────────────────────────────────────────────────────────────────────────────
# VALUE METHODS — instance method calls on intrinsic types
# ────────────────────────────────────────────────────────────────────────────
#
# PHP's standard library is mostly bare functions, not methods. The handful
# of object-oriented APIs (DateTime, ArrayObject, SplStack, …) are wired
# up as instance methods here. The compiler routes them through the
# value_methods table the same way JS / VB do.

[known_types]
PDO = ["common", "php.pdo_new"]
mysqli = ["common", "php.mysqli_init"]

[value_methods]

toFixed          = { emit = "host:ecma:number:toFixed",           min_args = 0, max_args = 1 }
# The walker lowers `array_shift($a)` to `$a.shift()`, so this entry — not
# the `array_shift` builtin — is the live path. It must use the polymorphic
# shared primitive: a PHP array is an `Array` only when packed, a `Map` when
# keyed, and `ecma:array.shift` understands only the former.
shift            = { emit = "common:array_shift",                 min_args = 0, max_args = 0 }
unshift          = { emit = "host:ecma:array:unshift",            min_args = 1, max_args = 255 }
splice           = { emit = "host:ecma:array:splice",             min_args = 1, max_args = 255 }


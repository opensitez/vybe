[info]
name = "kotlin"
extensions = ["kt", "kts"]

[compiler]
# Declared types CONVERT the value they bind (assignment, declaration and
# parameter entry alike). Stated explicitly rather than inherited: the platform
# default is `true`, and inheriting it silently gave Python coercive semantics
# it never chose.
coerces_value_to_type_hint = true
# Kotlin `operator fun invoke` — an object is callable, so a call site probes the Call slot.
callable_objects = true
function_return = "explicit"
self_keyword = "this"
base_keyword = "super"
constructor_name = "__init__"
implicit_self_fields = true
case_sensitive = true
string_indexing = "zero_based"
entry_point = "main"
uses_normalize_class = true
uses_common_resolver = true
dynamic_add = true
# `dynamic_member_access` is deliberately NOT set. Kotlin declares its classes,
# so a member read resolves against the class model the way Java, Dart and C#
# do. On the dynamic path `this.n` compiled to the JS member sequence, whose
# `set_js_this_from_stack` is a no-op for a profile without
# `ambient_this_binding` — so the receiver it pushed was never consumed and
# stayed on the stack. `"x=" + this.n` then concatenated the RECEIVER with the
# field (`[object C]A`), and any arithmetic use trapped in `toF64`.
supports_spread_arguments = true
# Kotlin `Long` IS ecma BigInt — declared below as `[builtin_types] bigint =
# ["long"]`, which the shared emitter derives EVERYTHING from: the capability
# itself, the hint classification (a Long variable/param reads as bigint),
# and the mixing policy (declared integer spellings WIDEN — `1L + 2` is Long,
# `1L + 2.0` is Double — where ECMA's distinct-type BigInt throws). No flag.
ecma_array_method_dispatch = false
ecma_in_operator = true
has_undefined_value = true
# `Boolean` is a real Kotlin type, so a comparison's RESULT is a value, not a
# raw WASM i32 condition: `println(1 == 1)` must print `true`, not `1`. Same
# reason Go and C# declare it.
materialize_bool_results = true
# `7 / 2` is 3 but `7.0 / 2.0` is 3.5 — Kotlin truncates only when BOTH operands
# are integers. The walker used to force `(a / b) | 0` on every division, which
# made every result an integer; the shared emitter now decides from this flag
# plus the `[builtin_types] int` spellings below.
integer_division_on_slash = true
has_ecma_globals = true
ecma_object_literals = true
tuple_literals_tagged = true

# Free-call builtins with a KNOWN integer result — `values.size / 2` must
# truncate (Kotlin `Int / Int` is an Int), and the shared gate only trusts
# what it can type. `.size`/`.length` lower to `__coll_length` at walk time,
# so naming these here types every read without a walker rewrite.
[builtin_return_types]
__kt_int_div = "int"
__kt_long_to_int = "int"
# Long-producing helpers: "bigint" is the SHARED inference's spelling, so
# unary minus and mixed ops on their results route through ecma:bigint.
__kt_to_long = "bigint"
__kt_long_shl = "bigint"
__kt_long_shr = "bigint"
__kt_long_ushr = "bigint"
__coll_length = "int"
__len__ = "int"
__dict_size = "int"
__kt_set_size = "int"
__jvm_map_size = "int"

[array_methods]
map          = "__array_map"
filter       = "__array_filter"
forEach      = "__array_forEach"
find         = "__array_find"
findIndex    = "indexOf"
indexOf      = "indexOf"
lastIndexOf  = "lastIndexOf"
includes     = "includes"
contains     = "includes"
reduce       = "__array_reduce"
fold         = "__array_reduce"
sort         = "__array_sort"
sorted       = "__array_sort"
some         = "__array_some"
any          = "__array_some"
every        = "__array_every"
all          = "__array_every"
# NO `joinToString = "join"` alias here: the walker rewrites every
# `joinToString` to `__coll_join` (kotlin.join_to_string), which renders
# elements Kotlin-style and materializes dict-backed sets/maps first —
# the ECMA join answered the empty string on those.
slice        = "slice"
sortedBy     = "__array_sort_by_key"
sortedWith   = "__array_sort"
flatMap      = "__array_flat_map"


[builtins]
# I/O & Printing
#
# NOT the shared `print` target: that renders through `Value::Display`, which is
# ECMA console/inspect semantics (`listOf(1,2,3)` → `1,2,3`, a Map → `[object]`).
# Kotlin's `println` calls the value's `toString`, so it renders first — see
# `emitter/tostring.rs`.
println = { emit = "common:kotlin.print", min_args = 0, max_args = 1, slot = "to_string" }
print   = { emit = "common:kotlin.print", min_args = 0, max_args = 1, slot = "to_string" }
__kt_print_double = { emit = "common:kotlin.print_double", min_args = 0, max_args = 1 }

# Common Collections Primitives
#
# `slot = "..."` says which shared `ProtocolSlot` Kotlin's spelling fills —
# builtinslotplan.md §3e. Kotlin is a good fit for the COMPILE-TIME half of
# §2c: `val v: Long`, `fun f(s: String)` and `List<Int>` all carry a static
# hint, so `builtin_type_of` resolves the receiver and the binding substitutes
# the emit target with no runtime probe. The declaration is what makes that
# possible; without it `apply_builtin_slot_binding` returns at its first line.
__len__           = { emit = "common:kotlin.size_any", min_args = 1, max_args = 1, slot = "len" }
__coll_length     = { emit = "common:kotlin.size_any", min_args = 1, max_args = 1, slot = "len" }
__coll_get        = { emit = "common:collections.get", min_args = 2, max_args = 2, slot = "get_item" }
__coll_set        = { emit = "common:collections.set", min_args = 3, max_args = 3, slot = "set_item" }
__coll_push       = { emit = "common:collections.push", min_args = 2, max_args = 2 }
__coll_pop        = { emit = "common:collections.pop", min_args = 1, max_args = 1 }
__coll_contains   = { emit = "common:kotlin.contains_any", min_args = 2, max_args = 2, slot = "contains" }
__coll_indexOf    = { emit = "common:kotlin.index_of_any_recv", min_args = 2, max_args = 2 }
__coll_lastIndexOf= { emit = "common:kotlin.last_index_of_any_recv", min_args = 2, max_args = 2 }
__coll_removeAt   = { emit = "common:collections.remove_at", min_args = 2, max_args = 2 }
__coll_remove     = { emit = "common:collections.remove", min_args = 2, max_args = 2 }
__coll_insert     = { emit = "common:collections.insert", min_args = 3, max_args = 3 }
__coll_clear      = { emit = "common:collections.clear", min_args = 1, max_args = 1 }
__coll_sorted     = { emit = "common:collections.sorted", min_args = 1, max_args = 1 }
__coll_reverse    = { emit = "common:kotlin.reversed_any", min_args = 1, max_args = 1 }
__coll_join       = { emit = "common:kotlin.join_to_string", min_args = 2, max_args = 2 }
__coll_slice      = { emit = "common:collections.slice", min_args = 3, max_args = 3 }
__coll_sum        = { emit = "common:collections.sum", min_args = 1, max_args = 1 }
__coll_min        = { emit = "common:collections.min", min_args = 1, max_args = 1 }
__coll_max        = { emit = "common:collections.max", min_args = 1, max_args = 1 }
__jvm_add = { emit = "common:jvm.java.add", min_args = 2, max_args = 3 }
__jvm_map_size = { emit = "common:jvm.java.map_size", min_args = 1, max_args = 1 }
__jvm_list_iterator = { emit = "common:jvm.java.list_iterator", min_args = 1, max_args = 2 }
__jvm_iterator_next = { emit = "common:jvm.java.iterator_next", min_args = 1, max_args = 1 }
__jvm_iterator_has_next = { emit = "common:jvm.java.iterator_has_next", min_args = 1, max_args = 1 }
__jvm_iterator_remove = { emit = "common:jvm.java.iterator_remove", min_args = 1, max_args = 1 }

# Common Dict Primitives
__dict_size   = { emit = "common:dict.size",        min_args = 1, max_args = 1, slot = "len" }
__dict_get    = { emit = "common:dict.get_dynamic", min_args = 2, max_args = 2, slot = "get_item" }

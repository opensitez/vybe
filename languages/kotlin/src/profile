__kt_int_div       = { emit = "common:kotlin.int_div", min_args = 2, max_args = 2 }
__kt_long_to_int   = { emit = "common:kotlin.long_to_int", min_args = 1, max_args = 1 }
# `Math.fround` (ECMA-262 §21.3.2.17) IS f32: Kotlin `Float` arithmetic
# rounds each result to f32, so `Float.MAX_VALUE * 2` overflows to Infinity
# where the f64 value would stay finite.
__kt_fround        = { emit = "host:ecma:math:fround", min_args = 1, max_args = 1 }
# The ecma BigInt constructor, spelled the way the SHARED inference types as
# bigint — the Long-widening normalize wraps operands in it (never user code).
BigInt             = { emit = "host:ecma:bigint:BigInt", min_args = 1, max_args = 1 }
# `Number` is the demotion the same normalize uses for Long-into-Double
# arithmetic and Long range endpoints.
Number             = { emit = "host:ecma:number:Number", min_args = 1, max_args = 1 }
__kt_to_long       = { emit = "common:kotlin.to_long", min_args = 1, max_args = 1 }

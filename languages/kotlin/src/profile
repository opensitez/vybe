# never enumerated (the map printed `{}` while `m[k]` answered).
__dict_set    = { emit = "common:kotlin.dict_set_tracked", min_args = 3, max_args = 3, slot = "set_item" }
__dict_has    = { emit = "common:dict.has",         min_args = 2, max_args = 2, slot = "contains" }
__dict_delete = { emit = "common:kotlin.remove_any", min_args = 2, max_args = 3 }
__kt_map_put  = { emit = "common:kotlin.map_put", min_args = 3, max_args = 3 }
__kt_safe_get = { emit = "common:kotlin.safe_get", min_args = 2, max_args = 2 }

# Kotlin's spellings of the shared built-in types — builtinslotplan.md step 4a.
#
# The platform table (`vybe_ast::builtin_types::PLATFORM_SPELLINGS`) knows
# `string`, `int`, `long`, `double`, `float`, `boolean`, `char` already, so
# only the spellings it CANNOT name are declared here. The generic containers
# are the whole point: `List<Int>` / `Map<String, Int>` resolve to nothing in
# the platform table, and an unresolved receiver means no slot binding can ever
# fire (§3b's binding constraint).
#
# `?` never reaches here — the walker records nullability on the param/field
# and stores the bare type name, so `String?` and `String` are one spelling.
[builtin_types]
# `char` too: a Kotlin `Char` VALUE here is a one-char string (the walker
# lowers 'q' to "q"). The platform table classifies `char` as an integer,
# which made `val c: Char = 'q'` coerce through toF64 into NaN.
string = ["charsequence", "char"]
# Which spellings name an INTEGER, for the `/`-truncates decision above. The
# platform table already carries `int`/`long`/`short`/`byte`/`uint`/`ulong`/
# `ushort`; only Kotlin's unsigned byte is missing from it.
int    = ["ubyte"]
# Kotlin `Long` IS ecma BigInt — the DECLARATION the shared inference reads,
# so a Long-typed variable or parameter classifies bigint and the shared
# operator routing carries it (no walker conversion dance). Declaring an
# integer spelling here also means mixes WIDEN (Kotlin's rule) instead of
# throwing (ECMA's §21.2.1.1, which is about a distinct user-visible type).
bigint = ["long"]
array  = [
    "list", "list<*", "mutablelist", "mutablelist<*",
    "array", "array<*", "collection", "collection<*", "iterable", "iterable<*",
    "intarray", "longarray", "doublearray", "floatarray",
    "booleanarray", "chararray", "shortarray",
    # `bytearray` MUST be declared: the platform table classifies it as
    # BYTES (Python's bytearray → Uint8Array), whose get_item is
    # `uint8array.at` — undefined on Kotlin's plain-array ByteArray.
    "bytearray", "uintarray", "ubytearray", "ushortarray", "ulongarray",
]



# `ByteArray` is deliberately NOT listed under `array`: the platform table
# already classifies `bytearray` as `Bytes`, and a profile spelling wins over
# the platform one — declaring it here would silently un-bind every
# `(Bytes, slot)` pair for Kotlin.
map    = [
    "map", "map<*", "mutablemap", "mutablemap<*",
    "hashmap", "hashmap<*", "linkedhashmap", "linkedhashmap<*",
]
set    = [
    "set", "set<*", "mutableset", "mutableset<*",
    "hashset", "hashset<*", "linkedhashset", "linkedhashset<*",
]

# Kotlin's OVERRIDE of the platform default slot table — builtinslotplan.md §2a.
#
# `Double.toString()` in Kotlin ALWAYS carries a fraction: `2.0 * 3` prints
# `6.0`, not `6`. Nothing at runtime can produce that — every Kotlin number is
# one f64 and `6.0 == 6` — so the answer only exists in the STATIC type, which
# is precisely the compile-time half of §2c. `println` declares `slot =
# "to_string"`, so when `builtin_type_of` resolves its argument to `double`
# this binding replaces the generic renderer with the Double one; when the
# argument's type is not statically known, `common:kotlin.print` still runs and
# renders it the ordinary way.
[builtin_slots.double]
to_string = "common:kotlin.print_double"

# `m[k] = v` on a STATICALLY map-typed receiver binds through the slot table,
# which defaults to `common:dict.set_dynamic` — a bare `ARRAY_SET` with no
# `__keys` maintenance, so a NEW key never enumerated. Same defect, same fix
# as the `__dict_set` builtin above.
[builtin_slots.map]
set_item = "common:kotlin.dict_set_tracked"
# `m[k]` on a missing key answers js-undefined via the default dynamic get;
# Kotlin's absent is null (`map["gone"]` prints `null`, never `undefined`).
get_item = "common:kotlin.dict_get_null"

# `list[i]` out of range THROWS IndexOutOfBoundsException in Kotlin — the
# platform default (`common:collections.get`) answers undefined, per the
# documented out-of-range caveat on the shared binding.
[builtin_slots.array]
get_item = "common:kotlin.list_get_throwing"
# `Collections.unmodifiableList`/`singleton` views throw on write.
set_item = "common:kotlin.list_set_checked"
# Kotlin's `==` is `equals()` — STRUCTURAL for collections: sets and maps
# order-independent, lists in order. This is the same slot Python binds
# (`python.value_eq`); the platform fallback compares references.
eq = "common:kotlin.value_eq"

[builtin_slots.set]
len = "common:kotlin.set_size"
contains = "common:kotlin.set_has"
eq = "common:kotlin.value_eq"

# ── `in` is `contains()`, NOT a key/index test — NOT YET FIXED ──────────────
#
# `ecma_in_operator = true` above routes `in` to `ecma:object.hasIn`, which
# walks properties, so `x in list` is an INDEX test: `0 in listOf(5,6,7)`
# answers true and `5 in listOf(5,6,7)` answers false. Kotlin's `in` is
# `contains()` on every receiver, and `walker.rs:2009` rewrites BOTH
# `.contains(x)` and `.containsKey(x)` into `BinOp::In`, so all three share one
# path.
#
# Declaring `[builtin_slots.string|array|map] contains` makes the shared §2c
# probe fire and fixes the list cases — but measured 2026-07-31 it then takes
# the ARRAY leg for every receiver: `"a" in map` and `"ell" in "hello"` both
# break, and `containsKey` regresses from true to false. Root cause not yet
# understood; `dict.new` builds a plain Object with a `__keys` array (not an
# ECMA Map), so `isArray` should be false and the map leg should win.
#
# Left undeclared deliberately rather than shipped half-working.



# ── JDK surface, via the COMMON RESOLVER ────────────────────────────────────
#
# Kotlin can use every Java class library, and declares NOTHING to get them.
# `platforms/jvm` registers the `jvm.java` root; this one line names the tree root
# to resolve platform types against — the same single line csharp has as
# `type_scopes = ["dotnet"]`. `lookup_type_static_member` /
# `lookup_type_ctor_target` fold case on both the class and the member, so
# every JDK spelling resolves without per-language hardcoded class lists.

# The tree stores these as `Const` leaves too, but a bare member READ does not
# consult the tree — only calls do — so the constants also live here, which is
# the same mechanism C# uses for `bool.TrueString`.
[namespace_constants]
"kotlin.math.pi" = 3.141592653589793
"kotlin.math.e"  = 2.718281828459045

[namespaces]
type_scopes = ["jvm", "kotlin"]

[[esm_default]]
kind = "tree-mount"
prefix = "java"
path = "jvm.java"

[[esm_default]]
kind = "tree-ambient"
path = "jvm.java.lang"

[[esm_default]]
kind = "tree-mount"
prefix = "kotlin"
path = "kotlin"

[[esm_default]]
kind = "tree-ambient"
path = "kotlin"

[[esm_default]]
kind = "tree-ambient"
path = "kotlin.collections"

[[esm_default]]
kind = "tree-ambient"
path = "kotlin.math"

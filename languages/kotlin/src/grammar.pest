// Kotlin PEG Grammar for Vybe (Kotlin over WASM/ECMA)

WHITESPACE = _{ " " | "\t" | "\r" }
NEWLINE = { "\n" | "\r\n" }
COMMENT = _{ "//" ~ (!"\n" ~ ANY)* | "/*" ~ (!"*/" ~ ANY)* ~ "*/" }

eat_terminators = _{ (";" | NEWLINE)* }

// Keywords (atomic for proper word boundaries)
fun_kw         = @{ "fun" ~ !(ASCII_ALPHANUMERIC | "_") }
val_kw         = @{ "val" ~ !(ASCII_ALPHANUMERIC | "_") }
var_kw         = @{ "var" ~ !(ASCII_ALPHANUMERIC | "_") }
class_kw       = @{ "class" ~ !(ASCII_ALPHANUMERIC | "_") }
enum_kw        = @{ "enum" ~ !(ASCII_ALPHANUMERIC | "_") }
open_kw        = @{ "open" ~ !(ASCII_ALPHANUMERIC | "_") }
data_kw        = @{ "data" ~ !(ASCII_ALPHANUMERIC | "_") }
abstract_kw    = @{ "abstract" ~ !(ASCII_ALPHANUMERIC | "_") }
override_kw    = @{ "override" ~ !(ASCII_ALPHANUMERIC | "_") }
companion_kw   = @{ "companion" ~ !(ASCII_ALPHANUMERIC | "_") }
interface_kw   = @{ "interface" ~ !(ASCII_ALPHANUMERIC | "_") }
object_kw      = @{ "object" ~ !(ASCII_ALPHANUMERIC | "_") }
package_kw     = @{ "package" ~ !(ASCII_ALPHANUMERIC | "_") }
import_kw      = @{ "import" ~ !(ASCII_ALPHANUMERIC | "_") }
when_kw        = @{ "when" ~ !(ASCII_ALPHANUMERIC | "_") }
if_kw          = @{ "if" ~ !(ASCII_ALPHANUMERIC | "_") }
else_kw        = @{ "else" ~ !(ASCII_ALPHANUMERIC | "_") }
for_kw         = @{ "for" ~ !(ASCII_ALPHANUMERIC | "_") }
while_kw       = @{ "while" ~ !(ASCII_ALPHANUMERIC | "_") }
do_kw          = @{ "do" ~ !(ASCII_ALPHANUMERIC | "_") }
return_kw      = @{ "return" ~ !(ASCII_ALPHANUMERIC | "_") }
break_kw       = @{ "break" ~ !(ASCII_ALPHANUMERIC | "_") }
continue_kw    = @{ "continue" ~ !(ASCII_ALPHANUMERIC | "_") }
is_kw          = @{ "is" ~ !(ASCII_ALPHANUMERIC | "_") }
not_is_kw      = @{ "!is" ~ !(ASCII_ALPHANUMERIC | "_") }
as_kw          = @{ "as" ~ !(ASCII_ALPHANUMERIC | "_") }
safe_as_kw     = @{ "as?" ~ !(ASCII_ALPHANUMERIC | "_") }
in_kw          = @{ "in" ~ !(ASCII_ALPHANUMERIC | "_") }
not_in_kw      = @{ "!in" ~ !(ASCII_ALPHANUMERIC | "_") }
null_kw        = @{ "null" ~ !(ASCII_ALPHANUMERIC | "_") }
true_kw        = @{ "true" ~ !(ASCII_ALPHANUMERIC | "_") }
false_kw       = @{ "false" ~ !(ASCII_ALPHANUMERIC | "_") }
this_kw        = @{ "this" ~ !(ASCII_ALPHANUMERIC | "_") }
super_kw       = @{ "super" ~ !(ASCII_ALPHANUMERIC | "_") }
private_kw     = @{ "private" ~ !(ASCII_ALPHANUMERIC | "_") }
protected_kw   = @{ "protected" ~ !(ASCII_ALPHANUMERIC | "_") }
public_kw      = @{ "public" ~ !(ASCII_ALPHANUMERIC | "_") }
internal_kw    = @{ "internal" ~ !(ASCII_ALPHANUMERIC | "_") }
vararg_kw      = @{ "vararg" ~ !(ASCII_ALPHANUMERIC | "_") }
try_kw         = @{ "try" ~ !(ASCII_ALPHANUMERIC | "_") }
catch_kw       = @{ "catch" ~ !(ASCII_ALPHANUMERIC | "_") }
finally_kw     = @{ "finally" ~ !(ASCII_ALPHANUMERIC | "_") }
throw_kw       = @{ "throw" ~ !(ASCII_ALPHANUMERIC | "_") }
const_kw       = @{ "const" ~ !(ASCII_ALPHANUMERIC | "_") }
sealed_kw      = @{ "sealed" ~ !(ASCII_ALPHANUMERIC | "_") }
get_kw         = @{ "get" ~ !(ASCII_ALPHANUMERIC | "_") }
set_kw         = @{ "set" ~ !(ASCII_ALPHANUMERIC | "_") }
to_kw          = @{ "to" ~ !(ASCII_ALPHANUMERIC | "_") }
by_kw          = @{ "by" ~ !(ASCII_ALPHANUMERIC | "_") }
constructor_kw = @{ "constructor" ~ !(ASCII_ALPHANUMERIC | "_") }
typealias_kw   = @{ "typealias" ~ !(ASCII_ALPHANUMERIC | "_") }
infix_kw       = @{ "infix" ~ !(ASCII_ALPHANUMERIC | "_") }
inline_kw      = @{ "inline" ~ !(ASCII_ALPHANUMERIC | "_") }
inner_kw       = @{ "inner" ~ !(ASCII_ALPHANUMERIC | "_") }
operator_kw    = @{ "operator" ~ !(ASCII_ALPHANUMERIC | "_") }
suspend_kw     = @{ "suspend" ~ !(ASCII_ALPHANUMERIC | "_") }
tailrec_kw     = @{ "tailrec" ~ !(ASCII_ALPHANUMERIC | "_") }
lateinit_kw    = @{ "lateinit" ~ !(ASCII_ALPHANUMERIC | "_") }
final_kw       = @{ "final" ~ !(ASCII_ALPHANUMERIC | "_") }
external_kw    = @{ "external" ~ !(ASCII_ALPHANUMERIC | "_") }
noinline_kw    = @{ "noinline" ~ !(ASCII_ALPHANUMERIC | "_") }
crossinline_kw = @{ "crossinline" ~ !(ASCII_ALPHANUMERIC | "_") }
reified_kw     = @{ "reified" ~ !(ASCII_ALPHANUMERIC | "_") }

keyword = @{
    fun_kw | val_kw | var_kw | class_kw | enum_kw | open_kw | abstract_kw | override_kw
  | companion_kw | interface_kw | object_kw | package_kw | import_kw | when_kw | if_kw
  | else_kw | for_kw | while_kw | do_kw | return_kw | break_kw | continue_kw | is_kw
  | not_is_kw | as_kw | safe_as_kw | in_kw | not_in_kw | null_kw | true_kw | false_kw
  | this_kw | super_kw | private_kw | protected_kw | public_kw | internal_kw | vararg_kw
  | try_kw | catch_kw | finally_kw | throw_kw | const_kw | sealed_kw
}

// `out` and `where` are SOFT keywords in Kotlin — legal identifiers everywhere
// except the one position that gives them meaning. They are deliberately absent
// from `keyword` above: tests bind `val out = …`, and reserving the word would
// break every one of them.
out_kw         = @{ "out" ~ !(ASCII_ALPHANUMERIC | "_") }
where_kw       = @{ "where" ~ !(ASCII_ALPHANUMERIC | "_") }

identifier = @{ !keyword ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
dotted_name = @{ identifier ~ ("." ~ identifier)* }

// ── Generics ────────────────────────────────────────────────────────────────
// Declaration side (`class Box<T : Comparable<T>>`, `fun <T> id(x: T)`) and the
// `where` clause, which is the only way to state more than one bound per
// parameter. Erased at runtime — the walker records the NAMES so a type
// reference to `T` resolves, and drops the bounds.
type_params = !{ "<" ~ eat_terminators ~ type_param ~ (eat_terminators ~ "," ~ eat_terminators ~ type_param)* ~ eat_terminators ~ ">" }
type_param  = { annotation* ~ modifier* ~ variance? ~ identifier ~ (":" ~ type_ref)? }
variance    = { in_kw | out_kw }

where_clause    = { where_kw ~ type_constraint ~ ("," ~ type_constraint)* }
type_constraint = { identifier ~ ":" ~ type_ref }

// Program structure
program = { SOI ~ eat_terminators ~ package_decl? ~ eat_terminators ~ (import_decl ~ eat_terminators)* ~ (top_level_decl ~ eat_terminators)* ~ EOI }

package_decl = { package_kw ~ dotted_name ~ (";" | NEWLINE) }
import_decl  = { import_kw ~ dotted_name ~ ("." ~ "*")? ~ (as_kw ~ identifier)? ~ (";" | NEWLINE) }

top_level_decl = { label_decl? ~ (typealias_decl | interface_decl | enum_decl | function_decl | class_decl | object_decl | destructuring_decl | var_decl | statement) }

// Typealias
typealias_decl = { modifier* ~ typealias_kw ~ identifier ~ "=" ~ type_ref }

// Labels
label_decl = { identifier ~ "@" }

// Annotations
annotation = { "@" ~ type_ref ~ ("(" ~ eat_terminators ~ arg_list? ~ eat_terminators ~ ")")? ~ eat_terminators }

// Types (including function types)
type_ref = !{
    "(" ~ eat_terminators ~ (type_ref ~ (eat_terminators ~ "," ~ eat_terminators ~ type_ref)*)? ~ eat_terminators ~ ")" ~ "->" ~ type_ref
  | dotted_name ~ type_args? ~ "?"?
}

// A type ARGUMENT is not a type: `List<*>` is a star projection and
// `Array<out T>` carries use-site variance. Both were unparseable.
type_arg = { "*" | variance? ~ type_ref }

// Modifiers
modifier = {
    open_kw | data_kw | abstract_kw | override_kw | private_kw | protected_kw | public_kw
  | internal_kw | const_kw | sealed_kw | infix_kw | inline_kw | inner_kw | operator_kw
  | suspend_kw | tailrec_kw | lateinit_kw | final_kw | external_kw | noinline_kw
  | crossinline_kw | reified_kw
}

// Receiver prefix for extension functions
receiver_prefix = { identifier ~ "." }

// Functions
function_decl = {
    annotation* ~ modifier* ~ fun_kw ~ type_params? ~ receiver_prefix? ~ identifier ~ parameter_list ~ (":" ~ type_ref)? ~ where_clause? ~ (function_body_expr | block)?
}
function_body_expr = { "=" ~ expr }

parameter_list = { "(" ~ eat_terminators ~ (parameter ~ (eat_terminators ~ "," ~ eat_terminators ~ parameter)* ~ eat_terminators ~ ","?)? ~ eat_terminators ~ ")" }
parameter = { annotation* ~ vararg_kw? ~ identifier ~ ":" ~ type_ref ~ ("=" ~ expr)? }

// Variables, Properties & Destructuring
var_decl = !{
    annotation* ~ modifier* ~ (val_kw | var_kw) ~ (destructuring_target | identifier) ~ (":" ~ type_ref)? ~ ("=" ~ expr | by_kw ~ expr)? ~ eat_terminators ~ property_accessor*
}

destructuring_target = !{ "(" ~ eat_terminators ~ identifier ~ (eat_terminators ~ "," ~ eat_terminators ~ identifier)* ~ eat_terminators ~ ")" }

// An accessor may carry its own visibility and may have NO body at all —
// `var x = 1` + `private set` is how Kotlin spells a publicly-readable,
// privately-writable property. Requiring a body rejected that outright.
property_accessor = {
    modifier* ~ (get_kw | set_kw) ~ ("(" ~ (identifier ~ (":" ~ type_ref)?)? ~ ")")? ~ (":" ~ type_ref)? ~ (function_body_expr | block)?
}

destructuring_decl = !{
    annotation* ~ modifier* ~ (val_kw | var_kw) ~ destructuring_target ~ (":" ~ type_ref)? ~ ("=" ~ expr)?
}

// Enums
enum_decl = {
    annotation* ~ modifier* ~ enum_kw ~ class_kw ~ identifier ~ primary_constructor? ~ (":" ~ inheritance_list)? ~ "{" ~ eat_terminators ~ (enum_entry ~ (","? ~ eat_terminators ~ enum_entry)* ~ ","?)? ~ eat_terminators ~ (";" ~ eat_terminators ~ (class_member ~ eat_terminators)*)? ~ "}"
}
// An entry may override members for itself — `A { override fun f() = 1 }`.
enum_entry = { annotation* ~ identifier ~ ("(" ~ eat_terminators ~ arg_list? ~ eat_terminators ~ ")")? ~ class_body? }

// Interfaces. `fun interface` is a SAM conversion — `fun` is not a modifier, so
// it is spelled out here rather than added to `modifier` (which would let it
// prefix a class).
interface_decl = {
    annotation* ~ modifier* ~ fun_kw? ~ interface_kw ~ identifier ~ type_params? ~ (":" ~ inheritance_list)? ~ where_clause? ~ class_body?
}

// Classes & Secondary Constructors
class_decl = {
    annotation* ~ modifier* ~ class_kw ~ identifier ~ type_params? ~ primary_constructor? ~ (":" ~ inheritance_list)? ~ where_clause? ~ class_body?
}

// `class C private constructor(x: Int)` / `class C @Inject constructor(…)` —
// the primary constructor takes its own annotations, visibility and the
// `constructor` keyword. Only the parameter list is mandatory.
primary_constructor = { (annotation* ~ modifier* ~ constructor_kw)? ~ "(" ~ eat_terminators ~ (class_parameter ~ (eat_terminators ~ "," ~ eat_terminators ~ class_parameter)* ~ eat_terminators ~ ","?)? ~ eat_terminators ~ ")" }
class_parameter = { annotation* ~ modifier* ~ vararg_kw? ~ (val_kw | var_kw)? ~ identifier ~ ":" ~ type_ref ~ ("=" ~ expr)? }

inheritance_list = { inheritance_specifier ~ ("," ~ inheritance_specifier)* }
inheritance_specifier = { type_ref ~ ("(" ~ eat_terminators ~ arg_list? ~ eat_terminators ~ ")")? ~ (by_kw ~ delegate_expr)? }

// The delegate of `: I by <expr>` — NOT plain `expr`.
//
// A trailing lambda is a call suffix, so `class B(b: I) : I by b { fun f() … }`
// parsed the CLASS BODY as an argument to `b`: every member the class declared
// itself vanished and `b.f()` was called with a lambda. `{` after the delegate
// always opens the class body, never an argument.
delegate_expr = { primary ~ (!"{" ~ postfix_suffix)* }

class_body = { "{" ~ eat_terminators ~ (class_member ~ eat_terminators)* ~ "}" }
class_member = { init_block | secondary_constructor | companion_object | enum_decl | function_decl | var_decl | class_decl | object_decl | interface_decl }
init_block = { "init" ~ block }

secondary_constructor = { annotation* ~ modifier* ~ constructor_kw ~ parameter_list ~ (":" ~ (this_kw | super_kw) ~ "(" ~ eat_terminators ~ arg_list? ~ eat_terminators ~ ")")? ~ (block | eat_terminators) }

// `private companion object`, and a body is optional on every object form —
// `object Empty` and `data object Singleton` are complete declarations.
companion_object = { annotation* ~ modifier* ~ companion_kw ~ object_kw ~ identifier? ~ (":" ~ inheritance_list)? ~ class_body? }
object_decl = { annotation* ~ modifier* ~ object_kw ~ identifier ~ (":" ~ inheritance_list)? ~ class_body? }

// Block
block = { "{" ~ eat_terminators ~ (statement ~ eat_terminators)* ~ "}" }

// Statements
statement = {
    label_decl? ~ (
      typealias_decl
    | enum_decl
    | interface_decl
    | function_decl
    | class_decl
    | object_decl
    | destructuring_decl
    | var_decl
    | if_expr
    | when_expr
    | try_expr
    | throw_stmt
    | for_stmt
    | while_stmt
    | do_while_stmt
    | return_stmt
    | break_stmt
    | continue_stmt
    | expr_stmt
    )
}

return_stmt = { return_kw ~ ("@" ~ identifier)? ~ expr? }
break_stmt = { break_kw ~ ("@" ~ identifier)? }
continue_stmt = { continue_kw ~ ("@" ~ identifier)? }
throw_stmt = { throw_kw ~ expr }
expr_stmt = { expr }

for_stmt = { for_kw ~ "(" ~ eat_terminators ~ (for_destructure | identifier) ~ eat_terminators ~ in_kw ~ expr ~ ")" ~ (block | statement) }
for_destructure = { "(" ~ eat_terminators ~ identifier ~ (eat_terminators ~ "," ~ eat_terminators ~ identifier)* ~ eat_terminators ~ ")" }

while_stmt = { while_kw ~ "(" ~ expr ~ ")" ~ (block | statement) }
do_while_stmt = { do_kw ~ (block | statement) ~ while_kw ~ "(" ~ expr ~ ")" }

// Expressions (Precedence chain)
expr = { assignment }

assignment = { infix_expr ~ compound_op ~ expr | elvis }
compound_op = { "=" | "+=" | "-=" | "*=" | "/=" | "%=" }

elvis = { logical_or ~ (elvis_op ~ logical_or)* }
elvis_op = { "?:" }

logical_or = { logical_and ~ (or_op ~ logical_and)* }
or_op = { "||" }

logical_and = { equality ~ (and_op ~ equality)* }
and_op = { "&&" }

equality = { comparison ~ (eq_op ~ comparison)* }
eq_op = { "===" | "!==" | "==" | "!=" }

comparison = { range_expr ~ (comp_op ~ range_expr)* }
comp_op = { in_kw | not_in_kw | is_kw | not_is_kw | "<=" | ">=" | "<" | ">" }

range_expr = { additive ~ (range_op ~ additive)* }
range_op = { ".." }

additive = { multiplicative ~ (add_op ~ multiplicative)* }
add_op = { "+" | "-" }

multiplicative = { type_cast ~ (mult_op ~ type_cast)* }
mult_op = { "*" | "/" | "%" }

type_cast = { infix_expr ~ (cast_op ~ type_ref)* }
cast_op = { safe_as_kw | as_kw }

infix_expr = { unary ~ (infix_op ~ unary)* }
infix_op = { to_kw | "until" | "downTo" | "step" | "and" | "or" | "xor" | "shl" | "shr" | "ushr" | "matches" | "zip" | "union" | "intersect" | "plus" | "minus" }

unary = { prefix_op* ~ postfix }
prefix_op = { "!" | "-" | "+" | "++" | "--" }

postfix = { primary ~ postfix_suffix* }
postfix_suffix = { type_args | call_suffix | index_suffix | safe_call_suffix | member_suffix | null_assert_suffix | inc_suffix }

type_args = !{ "<" ~ eat_terminators ~ type_arg ~ (eat_terminators ~ "," ~ eat_terminators ~ type_arg)* ~ eat_terminators ~ ">" }

// A trailing lambda may replace the argument list entirely — `xs.filter { … }`,
// `forEach { … }`, `run { … }` are calls, not a member access followed by a
// block. Without the second alternative `xs.filter { it > 2 }` parsed as
// `xs.filter` and then a stray lambda, so `filter` was never called and the
// result was empty.
//
// The lambda must start on the SAME LINE as the callee: `NEWLINE` is a real
// token here rather than skipped whitespace, so a `{` on the next line cannot
// be captured as an argument to the expression above it.
call_suffix = {
    "(" ~ eat_terminators ~ arg_list? ~ eat_terminators ~ ")"? ~ eat_terminators ~ lambda_literal?
  | lambda_literal
}
index_suffix = { "[" ~ eat_terminators ~ arg_list ~ eat_terminators ~ "]" }
safe_call_suffix = { "?." ~ identifier }
member_suffix = { "." ~ identifier }
null_assert_suffix = { "!!" }
inc_suffix = { "++" | "--" }

arg_list = { eat_terminators ~ arg ~ (eat_terminators ~ "," ~ eat_terminators ~ arg)* ~ eat_terminators ~ ","? ~ eat_terminators }
arg = { (identifier ~ eat_terminators ~ "=") ~ eat_terminators ~ spread_op? ~ expr | spread_op? ~ expr }
spread_op = { "*" }

// Primary expressions
primary = {
    if_expr
  | when_expr
  | try_expr
  | object_expr
  | lambda_literal
  | "(" ~ expr ~ ")"
  | literal
  | identifier
  | this_expr
  | super_expr
}

// `this@Outer` reaches an outer receiver from an inner class or a scope
// function; `super<Base>.f()` picks WHICH supertype's default implementation to
// call when a class inherits two. Both are ordinary Kotlin and neither parsed.
this_expr  = { this_kw ~ ("@" ~ identifier)? }
super_expr = { super_kw ~ ("<" ~ type_ref ~ ">")? ~ ("@" ~ identifier)? }

object_expr = { object_kw ~ (":" ~ inheritance_list)? ~ class_body }

// If expression / statement
if_expr = { if_kw ~ "(" ~ expr ~ ")" ~ (block | statement) ~ (else_kw ~ (if_expr | block | statement))? }

// When expression / statement
when_expr = { when_kw ~ ("(" ~ expr ~ ")")? ~ "{" ~ eat_terminators ~ (when_entry ~ eat_terminators)* ~ "}" }
when_entry = { (when_condition ~ ("," ~ when_condition)* | else_kw) ~ "->" ~ (block | statement) }
when_condition = {
    (is_kw | not_is_kw) ~ type_ref
  | (in_kw | not_in_kw) ~ expr
  | range_condition
  | comparison_condition
  | expr
}

range_condition = { expr ~ ".." ~ expr }
comparison_condition = { (">=" | "<=" | ">" | "<" | "==" | "!=") ~ expr }

// Try expression / statement
try_expr = { try_kw ~ block ~ catch_clause* ~ finally_clause? }
catch_clause = { catch_kw ~ "(" ~ identifier ~ (":" ~ type_ref)? ~ ")" ~ block }
finally_clause = { finally_kw ~ block }

// Lambdas
lambda_literal = { "{" ~ lambda_params? ~ eat_terminators ~ (statement ~ eat_terminators)* ~ "}" }
lambda_params = { lambda_param ~ ("," ~ lambda_param)* ~ "->" }
lambda_param = { (lambda_destructure | identifier) ~ (":" ~ type_ref)? }
lambda_destructure = { "(" ~ identifier ~ ("," ~ identifier)* ~ ")" }

// Literals
literal = {
    null_kw
  | true_kw
  | false_kw
  | string_literal
  | char_literal
  | float_literal
  | int_literal
}

// Kotlin numeric literals: `_` grouping anywhere between digits, `0x`/`0b`
// prefixes, `u`/`U` unsigned and `L` long suffixes, `e` exponents and the
// `f`/`F` Float suffix. `float_literal` is tried first (see `literal`), so
// every alternative here must FAIL on an integer rather than half-match it:
// the fraction is mandatory in the first alternative so `1..3` stays a range
// and `12.toString()` stays a member call.
dec_digits = @{ ASCII_DIGIT ~ (ASCII_DIGIT | "_")* }
exponent   = @{ ("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+ }

int_literal = @{
    ("0x" | "0X") ~ ASCII_HEX_DIGIT ~ (ASCII_HEX_DIGIT | "_")* ~ int_suffix?
  | ("0b" | "0B") ~ ASCII_BIN_DIGIT ~ (ASCII_BIN_DIGIT | "_")* ~ int_suffix?
  | dec_digits ~ int_suffix?
}
int_suffix = @{ ("u" | "U")? ~ ("L" | "l") | ("u" | "U") }

float_literal = @{
    dec_digits ~ "." ~ dec_digits ~ exponent? ~ ("f" | "F")?
  | dec_digits ~ exponent ~ ("f" | "F")?
  | dec_digits ~ ("f" | "F")
}

string_literal = ${ raw_string_literal | plain_string_literal }
raw_string_literal = ${ "\"\"\"" ~ raw_string_content* ~ "\"\"\"" }
raw_string_content = ${ str_interpolated_expr | str_interpolated_var | raw_str_text }
raw_str_text = @{ !"\"\"\"" ~ ANY }

plain_string_literal = ${ "\"" ~ string_content* ~ "\"" }
string_content = ${ str_interpolated_expr | str_interpolated_var | str_escaped | str_text }
str_escaped = @{ "\\u" ~ ASCII_HEX_DIGIT{4} | "\\" ~ ANY }
str_interpolated_var = ${ "$" ~ identifier }
str_interpolated_expr = ${ "${" ~ (!"}" ~ ANY)* ~ "}" }
str_text = @{ (!"\"" ~ !"\\" ~ !"$") ~ ANY }

char_literal = ${ "'" ~ (char_escaped | char_text) ~ "'" }
char_escaped = @{ "\\u" ~ ASCII_HEX_DIGIT{4} | "\\" ~ ANY }
char_text = @{ (!"'" ~ !"\\") ~ ANY }


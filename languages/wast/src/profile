new_Panel            = { emit = "host:vybe:gui:new_Panel",            min_args = 0, max_args = 0   }
controlSetProperty   = { emit = "host:vybe:gui:controlSetProperty",   min_args = 3, max_args = 3   }
controlGetProperty   = { emit = "host:vybe:gui:controlGetProperty",   min_args = 2, max_args = 2   }
controlsAdd          = { emit = "host:vybe:gui:controlsAdd",          min_args = 2, max_args = 2   }

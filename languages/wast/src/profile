# WAST / WAT Compiler Profile
# ────────────────────────────
# Handles both .wat (WAT module only) and .wast (WAT + script commands).
# WAT is a subset of WAST — the same grammar and walker handle both.
#
# WAT functions are stack-based; the walker normalises them to the common AST:
#   - Binary ops (i32.add etc.) → BinOp
#   - Consts → literals
#   - local.get/set → Ident / Assign
#   - Everything else → Call(__instr_name_with_underscores, args)
#
# WAST script commands (assert_return, invoke, …) become top-level calls to
# __wast_* builtins defined here, which route to the vybe test harness.

[info]
name       = "wast"
extensions = ["wast", "wat"]

[compiler]
# Declared types CONVERT the value they bind (assignment, declaration and
# parameter entry alike). Stated explicitly rather than inherited: the platform
# default is `true`, and inheriting it silently gave Python coercive semantics
# it never chose.
coerces_value_to_type_hint = true
function_return  = "explicit"
self_keyword     = "this"
constructor_name = "constructor"
# namespaceplan.md: namespace-shaped entry points resolve through the
# common resolver — same flip as the other languages.
uses_common_resolver = true
case_sensitive   = true
string_indexing  = "zero_based"
# `+` is JS-shaped: numeric when both sides are numbers, string concat when a
# string is involved. Needed for WAT float text formatting ($log_f32/$log_f64).
dynamic_add      = true
# WASM has first-class function references: `ref.func $f` tears a function off
# into a funcref (REF_FUNC) instead of invoking it. Enables call_ref /
# call_indirect / ref.eq on real funcrefs.
function_references = true
# WASM multi-value: a `(result t1 t2 …)` function leaves N values on the stack.
# The walker emits a uniform tuple `return` (callee sets result_arity = N and
# pushes the elements unpacked) and a `[t0..tN] = call(…)` destructure on the
# caller side; the shared compiler's multi-value ABI consumes the raw N stack
# values directly (no heap-tuple alloc).
multi_value_tuple_returns = true

# ────────────────────────────────────────────────────────────────────────────
# BUILTINS
# Covers:
#   1. WAST script assertion helpers  → vybe test harness host fns
#   2. WAT runtime stubs              → WASM opcodes / host fns
#   3. Module lifecycle               → noop (handled at link time)
# ────────────────────────────────────────────────────────────────────────────

[builtins]

# ── Standard WASI output imports ─────────────────────────────────────────────
# WAT modules that import a log function (e.g. `(import "wasi:logging/logging"
# "log" (func $log ...))`) generate call-to-Ident("log") in the AST. These
# entries resolve them to the real `wasi:logging/logging` "log" host sink (the
# WASI logging proposal, which the runtime registers) — no custom dispatch.

log   = { emit = "host:wasi:logging/logging:log",   min_args = 1, max_args = 255 }
logf  = { emit = "host:wasi:logging/logging:log",   min_args = 1, max_args = 255 }
# Type-suffixed log imports (log_i64 / log_f32 / log_f64) are the same WASI "log"
# import bound to a typed local id; they all resolve to the one host sink.
log_i64 = { emit = "host:wasi:logging/logging:log", min_args = 1, max_args = 255 }
log_f32 = { emit = "host:wasi:logging/logging:log", min_args = 1, max_args = 255 }
log_f64 = { emit = "host:wasi:logging/logging:log", min_args = 1, max_args = 255 }

# ── String comparison: js-string-builtins host import ────────────────────────
# `string.compare` is NOT a stringref instruction (the stringref proposal has
# only `string.eq`/`string.is_usv_sequence`, and stringref was never merged into
# WASM 3.0 — its string story is the js-string-builtins host imports). WASM 3.0
# exposes ordering via the `wasm:js-string` `compare` import (returns -1/0/1 per
# the JS `<` operator). The walker lowers `string.compare` → `string_compare`;
# route that to the real host import (already registered in vybe_host).
string_compare = { emit = "host:wasm:js-string:compare", min_args = 2, max_args = 2 }

# ── vybe:gui imports ──────────────────────────────────────────────────────────
# WAT modules import these by local name; the profile resolves them to the
# vybe:gui host functions. String arguments are passed as any Value — the
# host functions format them via format!("{v}").

newForm              = { emit = "host:vybe:gui:newForm",              min_args = 0, max_args = 1   }
new_Button           = { emit = "host:vybe:gui:new_Button",           min_args = 0, max_args = 0   }

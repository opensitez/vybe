# WAST / WAT Compiler Profile
# ────────────────────────────
# Handles both .wat (WAT module only) and .wast (WAT + script commands).
# WAT is a subset of WAST — the same grammar and walker handle both.
#
# WAT functions are stack-based; the walker normalises them to the common AST:
#   - Binary ops (i32.add etc.) → BinOp
#   - Consts → literals
#   - local.get/set → Ident / Assign
#   - Everything else → Call(__instr_name_with_underscores, args)
#
# WAST script commands (assert_return, invoke, …) become top-level calls to
# __wast_* builtins defined here, which route to the vybe test harness.

[info]
name       = "wast"
extensions = ["wast", "wat"]

[compiler]
function_return  = "explicit"
self_keyword     = "this"
constructor_name = "constructor"
# namespaceplan.md: namespace-shaped entry points resolve through the
# common resolver — same flip as the other languages.
uses_common_resolver = true
case_sensitive   = true
string_indexing  = "zero_based"

# ────────────────────────────────────────────────────────────────────────────
# BUILTINS
# Covers:
#   1. WAST script assertion helpers  → vybe test harness host fns
#   2. WAT runtime stubs              → WASM opcodes / host fns
#   3. Module lifecycle               → noop (handled at link time)
# ────────────────────────────────────────────────────────────────────────────

[builtins]

# ── Standard WASI output imports ─────────────────────────────────────────────
# WAT modules that import (import "wasi:cli" "log" (func $log ...)) generate
# call-to-Ident("log") in the AST. These profile entries resolve them to the
# real wasi:cli host functions without any custom dispatch.

log   = { emit = "host:wasi:cli:log",   min_args = 1, max_args = 255 }
logf  = { emit = "host:wasi:cli:log",   min_args = 1, max_args = 255 }

# ── vybe:gui imports ──────────────────────────────────────────────────────────
# WAT modules import these by local name; the profile resolves them to the
# vybe:gui host functions. String arguments are passed as any Value — the
# host functions format them via format!("{v}").

newForm              = { emit = "host:vybe:gui:newForm",              min_args = 0, max_args = 1   }
new_Button           = { emit = "host:vybe:gui:new_Button",           min_args = 0, max_args = 0   }
new_Label            = { emit = "host:vybe:gui:new_Label",            min_args = 0, max_args = 0   }

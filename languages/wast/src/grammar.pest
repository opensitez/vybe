// ============================================================================
// WAST / WAT Grammar for vybex
// ============================================================================
// WAT  = WebAssembly Text Format (module syntax only)
// WAST = WAT + script commands (assert_return, assert_trap, invoke, register…)
//
// Both share the same grammar — WAT is a strict subset of WAST.
// Extensions vs the MVP grammar:
//   • Exceptions proposal: try/catch/catch_all/delegate/throw/rethrow
//   • Tail-call proposal: return_call / return_call_indirect
//   • Reference types: ref.null / ref.is_null / ref.func / ref.extern
//   • SIMD (v128): abbreviated instruction set
//   • Bulk memory: memory.init / memory.copy / memory.fill / table.init etc.
//   • Multi-value: multiple (result …) in typeuse
//   • Named modules in WAST: (module $name …)
//   • assert_suspension (threads proposal)
// ============================================================================

// ── Whitespace & Comments ────────────────────────────────────────────────────

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT    = _{ line_comment | block_comment | annotation }

// A line comment ends at EITHER line terminator. WAT counts CR and LF both,
// so `;; comment\0d` (a bare CR, `comments.wast` f2) ENDS here — terminating
// only on LF swallowed the `(return …)` on the next line and the function
// silently returned its first value instead.
line_comment  = _{ ";;" ~ (!("\n" | "\r") ~ ANY)* }
// Nested block comments per the spec
block_comment = _{ "(;" ~ (block_comment | (!";" ~ ANY) | (";" ~ !")"))* ~ ";)" }

// Custom annotations `(@id …)` (e.g. `(@metadata.code.branch_hint "\01")`).
// They carry only metadata (branch hints, name/code annotations) with no
// execution semantics, so they are skipped wherever they appear, like comments.
// `(@` never begins real code, so this is unambiguous. Strings are matched so a
// `)` inside a string literal does not close the group early.
// Comments are matched BEFORE the paren group: a `(; ) ;)` block comment or a
// `;; bla)` line comment inside an annotation carries an unbalanced `)` that
// would otherwise close the annotation early.
annotation  = _{ "(@" ~ annot_item* ~ ")" }
annot_group = _{ "(" ~ annot_item* ~ ")" }
annot_item  = _{ block_comment | line_comment | annot_group | string | (!("(" | ")") ~ ANY) }

// ── Atoms ────────────────────────────────────────────────────────────────────

// $identifier — the spec's full `idchar` set:
//   0-9 A-Z a-z ! # $ % & ' * + - . / : < = > ? @ \ ^ _ ` | ~
// plus the WASM 3.0 quoted form `$"…"`, which admits any string (including
// spaces and escapes) as a single identifier.
id = @{ "$" ~ (string | id_char+) }

id_char = _{
    ASCII_ALPHANUMERIC | "_" | "." | "-" | "+" | "*" | "/" | "\\"
  | "^" | "~" | "=" | "<" | ">" | "!" | "?" | "@" | "#" | "&"
  | "|" | ":" | "'" | "$" | "%" | "`"
}

// Numeric literals
hex_digit = _{ ASCII_HEX_DIGIT | "_" }
dec_digit = _{ ASCII_DIGIT | "_" }

integer = @{
    ("+" | "-")? ~ (
        "0x" ~ hex_digit+
      | dec_digit+
    // A number token must not be immediately followed by an identifier char:
    // WASM has no binary/octal prefixes, so `0b1010`/`0o777` are NOT `0` then
    // `b1010` — they are malformed number tokens and must be rejected.
    ) ~ !(ASCII_ALPHANUMERIC | "_")
}

float = @{
    ("+" | "-")? ~ (
        "nan:canonical"
      | "nan:arithmetic"
      | "nan:0x" ~ hex_digit+
      | "nan"
      | "inf"
      // A hex float MUST carry a "." or a "p" exponent; without one, "0x0F" is a
      // hex integer, not a float (the `integer` rule must win). Per the spec's
      // `hexfloat`, the `p`/`P` exponent is REQUIRED only when there is no dot:
      // `0xa0_ff.f141_a59a` is a valid hex float, `0x1_a_A_0_f` is an integer.
      | "0x" ~ hex_digit+ ~ (
            "." ~ hex_digit* ~ (("p" | "P") ~ ("+" | "-")? ~ dec_digit+)?
          | ("p" | "P") ~ ("+" | "-")? ~ dec_digit+
        )
      // Spec: `float ::= num '.' frac?` with `frac ::= ε | digit frac`, so the
      // fraction after the dot may be EMPTY — `0123456789.` and `0123456789.e19`
      // are both valid floats.
      | dec_digit+ ~ "." ~ dec_digit* ~ (("e" | "E") ~ ("+" | "-")? ~ dec_digit+)?
      | dec_digit+ ~ ("e" | "E") ~ ("+" | "-")? ~ dec_digit+
    )
}

// String literals — UTF-8 with WAT escape sequences
string_char = _{
    "\\" ~ (
        "n" | "t" | "r" | "\\" | "\"" | "'"
      | "u{" ~ ASCII_HEX_DIGIT+ ~ "}"
      | ASCII_HEX_DIGIT ~ ASCII_HEX_DIGIT
    )
  | (!("\"" | "\\") ~ ANY)
}
string = @{ "\"" ~ string_char* ~ "\"" }

// ── Types ─────────────────────────────────────────────────────────────────────

// Numeric / packed value types
num_type = @{ "i32" | "i64" | "f32" | "f64" }
vec_type = @{ "v128" }
// Reference types (MVP + reference-types + GC abbreviations). Longer tokens
// first so PEG's ordered choice never stops at a prefix (e.g. `nullexternref`
// before `nullref`). Each is a `(ref null <heaptype>)` shorthand per WASM 3.0.
ref_type = @{
    "nullexternref" | "nullfuncref" | "nullexnref" | "nullref"
  | "funcref" | "externref" | "anyref" | "eqref" | "i31ref"
  | "structref" | "arrayref" | "exnref" | "stringref"
}
// All value types
val_type = @{ "i32" | "i64" | "f32" | "f64" | "v128" | ref_type }

// ── Indices ───────────────────────────────────────────────────────────────────

index = { integer | id }

// ── Type use ──────────────────────────────────────────────────────────────────

// typeuse covers: (type $T) with optional param/result override, or just param*/result*
//
// Custom Descriptors adds an `(exact …)` wrapper, so a func import can demand
// its type EXACTLY rather than up to subtyping:
//   (import "" "" (func $1 (exact (type 0))))
//   (import "" "" (func $4 (exact (param i32) (result i64))))
// `"exact"` and the parens are literals and produce no pest children, so the
// inner pairs a walker sees are still `index` / `param` / `result` — the
// wrapper costs nothing downstream. Exactness constrains LINKING, which we do
// not subtype-check on func imports, so accepting it is the whole change.
// ⚠ The exact alternatives must come FIRST: `param* ~ result*` matches empty,
// so a leading bare alternative would succeed having consumed nothing and
// strand `(exact …)` as the next token.
typeuse = {
    "(" ~ "exact" ~ "(" ~ "type" ~ index ~ ")" ~ param* ~ result* ~ ")"
  | "(" ~ "exact" ~ param* ~ result* ~ ")"
  | "(" ~ "type" ~ index ~ ")" ~ param* ~ result*
  | param* ~ result*
}

// Extends val_type with GC reference types: (ref null? heaptype)
any_val_type = { "(" ~ "ref" ~ "null"? ~ (exact_heap_type | heap_type) ~ ")" | val_type }

// The type list may be EMPTY — `(func (param))` and `(func (result))` are the
// spec's explicit spellings of "no params" / "no results" (func_ptrs, type).
param  = { "(" ~ "param"  ~ id? ~ any_val_type* ~ ")" }
result = { "(" ~ "result" ~ any_val_type* ~ ")" }

// ── Instructions ──────────────────────────────────────────────────────────────

instr = { folded_instr | plain_instr }

// Folded S-expression form.
// (if …) and (try …) have special sub-block structure.
// (block …) and (loop …) have optional label + block_type.
// The trailing `instr_name` alternative matches any identifier, so `(then …)`,
// `(else …)`, `(catch …)` and `(catch_all …)` also match a generic `instr`.
// PEG `instr*` is greedy and never backs off, so it would swallow those
// sub-blocks and make the dedicated rule fail. Guard `instr*` with a negative
// lookahead so it stops at the sub-block that must follow.
folded_instr = {
    "(" ~ "if"  ~ id? ~ block_type* ~ (!then_block ~ !else_block ~ instr)* ~ then_block ~ else_block? ~ ")"
  | "(" ~ "try_table" ~ id? ~ block_type* ~ try_clause* ~ instr* ~ ")"
  | "(" ~ "block" ~ id? ~ block_type* ~ instr* ~ ")"
  | "(" ~ "loop"  ~ id? ~ block_type* ~ instr* ~ ")"
  | "(" ~ instr_name ~ instr_arg* ~ instr* ~ ")"
}

then_block      = { "(" ~ "then"      ~ instr* ~ ")" }
else_block      = { "(" ~ "else"      ~ instr* ~ ")" }

// Canonical exception-handling (WASM 3.0): a `try_table` names, per clause, a
// tag and a branch LABEL that a matching thrown exception transfers to. `_ref`
// clauses additionally push the caught `exnref`; `catch_all*` match any tag.
// Longest keyword first so `catch_all_ref` isn't shadowed by `catch`/`catch_all`.
try_clause = {
    "(" ~ "catch_all_ref" ~ index ~ ")"
  | "(" ~ "catch_all"     ~ index ~ ")"
  | "(" ~ "catch_ref"     ~ index ~ index ~ ")"
  | "(" ~ "catch"         ~ index ~ index ~ ")"
}

// Plain (non-folded) instruction
plain_instr = { instr_name ~ instr_arg* }

// ── Instruction names ─────────────────────────────────────────────────────────
// Ordered longest-match first within each group to avoid prefix ambiguity.
// All names are atomic so the full dotted token is consumed before instr_arg
// tries to match val_type (which shares the "i32"/"f64" prefix).

instr_name = @{
    // ── Control ──────────────────────────────────────────────────────────
    "block" | "loop" | "if" | "else" | "end"
    // ⚠ LONGEST FIRST. `instr_name` is an ordered choice in an atomic rule, so
    // a shorter alternative that is a PREFIX of a longer one wins and strands
    // the rest as an instruction argument: with `br_on_cast` listed first,
    // `br_on_cast_desc_eq` parsed as `br_on_cast` + a `_desc_eq` operand.
  | "br_on_cast_desc_eq_fail" | "br_on_cast_desc_eq"
  | "br_on_cast_fail" | "br_on_cast" | "br_on_non_null" | "br_on_null"
  | "br_table" | "br_if" | "br"
  | "return_call_indirect" | "return_call_ref" | "return_call"
  | "call_indirect_with_tag" | "call_return_with_tag" | "call_with_tag"
  | "call_indirect" | "call_ref" | "call"
  | "return" | "unreachable" | "nop"
    // ── Exception handling (canonical, WASM 3.0) ──────────────────────────
  | "try_table" | "throw_ref" | "throw"
    // ── Parametric ────────────────────────────────────────────────────────
  | "select" | "drop"
    // ── Variable ──────────────────────────────────────────────────────────
  | "local.tee" | "local.set" | "local.get"
  | "global.set" | "global.get"
    // ── Table ─────────────────────────────────────────────────────────────
  | "table.init" | "table.copy" | "table.grow" | "table.size" | "table.fill"
  | "table.get"  | "table.set"
    // ── Memory ────────────────────────────────────────────────────────────
  | "memory.init" | "memory.copy" | "memory.fill" | "memory.grow" | "memory.size"
  | "i32.load8_s"  | "i32.load8_u"  | "i32.load16_s" | "i32.load16_u"
  | "i64.load8_s"  | "i64.load8_u"  | "i64.load16_s" | "i64.load16_u"
  | "i64.load32_s" | "i64.load32_u"
  | "i32.load" | "i64.load" | "f32.load" | "f64.load"
  | "i32.store8"  | "i32.store16"
  | "i64.store8"  | "i64.store16" | "i64.store32"
  | "i32.store" | "i64.store" | "f32.store" | "f64.store"
    // ── i32 ───────────────────────────────────────────────────────────────
  | "i32.const"
  | "i32.clz" | "i32.ctz" | "i32.popcnt"
  | "i32.add" | "i32.sub" | "i32.mul"
  | "i32.div_s" | "i32.div_u" | "i32.rem_s" | "i32.rem_u"
  | "i32.and" | "i32.or" | "i32.xor"
  | "i32.shl" | "i32.shr_s" | "i32.shr_u" | "i32.rotl" | "i32.rotr"
  | "i32.eqz" | "i32.eq" | "i32.ne"
  | "i32.lt_s" | "i32.lt_u" | "i32.gt_s" | "i32.gt_u"
  | "i32.le_s" | "i32.le_u" | "i32.ge_s" | "i32.ge_u"
  | "i32.wrap_i64"
  | "i32.trunc_sat_f32_s" | "i32.trunc_sat_f32_u"
  | "i32.trunc_sat_f64_s" | "i32.trunc_sat_f64_u"
  | "i32.trunc_f32_s" | "i32.trunc_f32_u"
  | "i32.trunc_f64_s" | "i32.trunc_f64_u"
  | "i32.reinterpret_f32"
  | "i32.extend8_s" | "i32.extend16_s"
    // ── i64 ───────────────────────────────────────────────────────────────
  | "i64.const"
  | "i64.clz" | "i64.ctz" | "i64.popcnt"
  | "i64.add" | "i64.sub" | "i64.mul"
  | "i64.div_s" | "i64.div_u" | "i64.rem_s" | "i64.rem_u"
  | "i64.and" | "i64.or" | "i64.xor"
  | "i64.shl" | "i64.shr_s" | "i64.shr_u" | "i64.rotl" | "i64.rotr"
  | "i64.eqz" | "i64.eq" | "i64.ne"
  | "i64.lt_s" | "i64.lt_u" | "i64.gt_s" | "i64.gt_u"
  | "i64.le_s" | "i64.le_u" | "i64.ge_s" | "i64.ge_u"
  | "i64.extend_i32_s" | "i64.extend_i32_u"
  | "i64.trunc_sat_f32_s" | "i64.trunc_sat_f32_u"
  | "i64.trunc_sat_f64_s" | "i64.trunc_sat_f64_u"
  | "i64.trunc_f32_s" | "i64.trunc_f32_u"
  | "i64.trunc_f64_s" | "i64.trunc_f64_u"
  | "i64.reinterpret_f64"
  | "i64.extend8_s" | "i64.extend16_s" | "i64.extend32_s"
    // ── f32 ───────────────────────────────────────────────────────────────
  | "f32.const"
  | "f32.abs" | "f32.neg" | "f32.ceil" | "f32.floor" | "f32.trunc" | "f32.nearest" | "f32.sqrt"
  | "f32.add" | "f32.sub" | "f32.mul" | "f32.div"
  | "f32.min" | "f32.max" | "f32.copysign"
  | "f32.eq" | "f32.ne" | "f32.lt" | "f32.gt" | "f32.le" | "f32.ge"
  | "f32.convert_i32_s" | "f32.convert_i32_u"
  | "f32.convert_i64_s" | "f32.convert_i64_u"
  | "f32.demote_f64" | "f32.reinterpret_i32"
    // ── f64 ───────────────────────────────────────────────────────────────
  | "f64.const"
  | "f64.abs" | "f64.neg" | "f64.ceil" | "f64.floor" | "f64.trunc" | "f64.nearest" | "f64.sqrt"
  | "f64.add" | "f64.sub" | "f64.mul" | "f64.div"
  | "f64.min" | "f64.max" | "f64.copysign"
  | "f64.eq" | "f64.ne" | "f64.lt" | "f64.gt" | "f64.le" | "f64.ge"
  | "f64.convert_i32_s" | "f64.convert_i32_u"
  | "f64.convert_i64_s" | "f64.convert_i64_u"
  | "f64.promote_f32" | "f64.reinterpret_i64"
    // ── Reference types ───────────────────────────────────────────────────
  | "ref.null" | "ref.is_null" | "ref.func"
    // ── wasm:js-string builtins (merged proposal) ─────────────────────────
  | "string.const"
    // ── GC / WasmGC struct ops ────────────────────────────────────────────
    // Longest-first: `struct.new` would otherwise match the prefix of
    // `struct.new_desc` and strand `_desc` as an instruction argument.
  | "struct.new_default_desc" | "struct.new_desc"
  | "struct.new_default" | "struct.new"
  | "struct.get_s" | "struct.get_u" | "struct.get"
  | "struct.set"
    // ── SIMD v128 ─────────────────────────────────────────────────────────
    // Every lane op is matched generically (i8x16.*, i16x8.*, …, v128.*) and
    // maps 1:1 to a VM opcode resolved via `Op::from_wasm_name` at emit time —
    // there is no per-instruction list here or in the emitter.
  | ("i8x16" | "i16x8" | "i32x4" | "i64x2" | "f32x4" | "f64x2" | "v128") ~ "." ~ (ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")*)
    // ── Generic mnemonic (GC, ref, table, bulk-memory: data.drop, ref.cast,
    //    array.get, i31.get_s, call_ref, …) ────────────────────────────────
    // Any remaining dotted-or-plain instruction name is matched generically and
    // maps 1:1 to a VM opcode resolved via `Op::from_wasm_name` at emit time —
    // no per-instruction list here or in the emitter. Placed last so the
    // explicit control-flow names above (which need block_type / folded
    // grammar) still win.
  | (ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")*) ~ ("." ~ (ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")*))*
}

// ── Instruction arguments ─────────────────────────────────────────────────────
// Priority: mem_arg > block_type > ref_type_arg > folded_instr > id > index >
// string > float > integer > bare_val_type
// bare_val_type is last and only matches when NOT followed by "." to avoid
// consuming "i32" when "i32.add" is the next token.

// A reftype IMMEDIATE — `(ref $t)` / `(ref null $t)` on `ref.test`, `ref.cast`,
// `br_on_cast`. It has to be its own alternative, ahead of `folded_instr`,
// because `ref` satisfies the generic `instr_name` rule and the whole thing
// would otherwise match as a folded instruction. That matters for more than
// tidiness: a plain instruction must be able to hand back a folded operand it
// absorbed (the spec allows no folded operands on a plain instr), and doing
// that blindly would hand back this immediate too.
ref_type_arg = { "(" ~ "ref" ~ "null"? ~ (exact_heap_type | heap_type) ~ ")" }

instr_arg = {
    mem_arg
  | block_type
  | ref_type_arg
  | folded_instr
  | id
  | string
  | float
  | integer
  | bare_lane_type
  | bare_val_type
  | bare_heap_type
}

// Heap-type immediate for ref.null / ref.cast / ref.test / … (`func`, `extern`,
// `any`, `string`, …). The trailing guard stops it consuming an instruction
// name (`array.get`) or a longer word (`structref`); `$id` targets stay on the
// `id` arg above.
bare_heap_type = @{
    ("funcref" | "externref" | "func" | "extern" | "exn" | "any" | "eq" | "i31"
    | "struct" | "array" | "string" | "none" | "noextern" | "nofunc" | "noexn")
    ~ !(ASCII_ALPHANUMERIC | "_" | ".")
}

bare_val_type  = @{ val_type ~ !("." | ASCII_ALPHANUMERIC | "_") }
// SIMD lane types as immediates (i8x16, i16x8, i32x4, i64x2, f32x4, f64x2)
bare_lane_type = @{ val_lane_type ~ !("." | ASCII_ALPHANUMERIC | "_") }

// Memory immediate: offset=N or align=N
mem_arg = @{ ("offset=" ~ integer) | ("align=" ~ integer) }

// Block type annotation (inside block/loop/if)
block_type = {
    "(" ~ "type"   ~ index ~ ")"
  | "(" ~ "result" ~ any_val_type+ ~ ")"
  | "(" ~ "param"  ~ id? ~ val_type+ ~ ")"
}

// ── Module fields ─────────────────────────────────────────────────────────────

module_field = {
    func_field
  | import_field
  | export_field
  | table_field
  | memory_field
  | global_field
  | elem_field
  | data_field
  | type_field
  | tag_field
  | call_tag_field
  | func_switch_field
  | start_field
}

// ── Function ──────────────────────────────────────────────────────────────────

func_field = {
    "(" ~ "func" ~ id? ~ export_inline* ~ import_inline? ~ typeuse ~ func_call_tags* ~ local* ~ instr* ~ ")"
}

// `(func … (call_tag $t*))` — declares which call tags this func's `funcref`
// handles. Declaring ANY replaces the default (its own canonical tag).
func_call_tags = { "(" ~ "call_tag" ~ index+ ~ ")" }

// `any_val_type*`, not `+`: `(local)` is the spec's explicit "declare no
// locals" group (func.wast:81), exactly like the already-fixed empty `(param)`
// / `(result)`. With `+` it did not match `local` at all and fell through to
// being read as a FOLDED INSTRUCTION named `local` — "undefined is not
// callable" at run time, killing the whole function.
local = { "(" ~ "local" ~ id? ~ any_val_type* ~ ")" }

export_inline = { "(" ~ "export" ~ string ~ ")" }
import_inline = { "(" ~ "import" ~ string ~ string ~ ")" }

// ── Import ────────────────────────────────────────────────────────────────────

import_field = { "(" ~ "import" ~ string ~ string ~ import_desc ~ ")" }

import_desc = {
    "(" ~ "func"   ~ id? ~ typeuse ~ ")"
  | "(" ~ "table"  ~ id? ~ table_type ~ ")"
  | "(" ~ "memory" ~ id? ~ mem_type ~ ")"
  | "(" ~ "global" ~ id? ~ global_type ~ ")"
  | "(" ~ "tag"    ~ id? ~ tag_type ~ ")"
  // "Similarly, one can import and export call tags." A call tag is a module
  // entity, so it appears in the import descriptor alongside the others.
  | "(" ~ "call_tag" ~ id? ~ typeuse ~ ")"
}

// ── Export ────────────────────────────────────────────────────────────────────

export_field = { "(" ~ "export" ~ string ~ export_desc ~ ")" }

export_desc = {
    "(" ~ "func"   ~ index ~ ")"
  | "(" ~ "table"  ~ index ~ ")"
  | "(" ~ "memory" ~ index ~ ")"
  | "(" ~ "global" ~ index ~ ")"
  | "(" ~ "tag"    ~ index ~ ")"
}

// ── Table ─────────────────────────────────────────────────────────────────────

// A table's element type is any reftype, including the typed forms
// `(ref null $t)` / `(ref func)`. The optional trailing `folded_instr` is the
// WASM 3.0 table INITIALISER expression — `(table $t 10 funcref (ref.null func))`.
// The inline `(elem …)` abbreviation takes either a bare funcidx list or full
// element expressions (`(ref.func $f)`, `(ref.null func)`).
table_field = {
    "(" ~ "table" ~ id? ~ export_inline* ~ import_inline? ~ table_type ~ folded_instr? ~ ")"
  | "(" ~ "table" ~ id? ~ export_inline* ~ addr_type? ~ ref_val_type ~ "(" ~ "elem" ~ (elem_item+ | index*) ~ ")" ~ ")"
}

// A table, like a memory, may state its INDEX type (`(table i64 1 funcref)` —
// memory64). Same bare-literal treatment as `mem_type`: the limits are what the
// walker reads, and the keyword must not be mistaken for one.
table_type = { addr_type? ~ integer ~ integer? ~ ref_val_type }

// `i64` = the memory64 proposal's 64-bit index space, `i32` = the default.
// CAPTURED, not silent: the walker records it on the declaration so every
// address, count and `memory.size`/`table.size` result is read at the right
// width. The trailing guard stops it matching the head of a longer word.
addr_type = @{ ("i64" | "i32") ~ !(ASCII_ALPHANUMERIC | "_") }

// ── Memory ────────────────────────────────────────────────────────────────────

// The inline `(memory (data "…"))` abbreviation declares a memory sized to hold
// exactly the data plus an active segment at offset 0 (start, float_exprs).
memory_field = {
    "(" ~ "memory" ~ id? ~ export_inline* ~ import_inline? ~ mem_type ~ ")"
  | "(" ~ "memory" ~ id? ~ export_inline* ~ addr_type? ~ inline_memory_data ~ ")"
}

inline_memory_data = { "(" ~ "data" ~ string* ~ ")" }

// Optional address-type keyword (`i64` = memory64 proposal, `i32` = default),
// then the min (and optional max) page limits. The keyword is a bare literal so
// it doesn't appear as a captured pair — the walker still reads just the limits.
mem_type = { addr_type? ~ integer ~ integer? }

// ── Global ────────────────────────────────────────────────────────────────────

global_field = {
    "(" ~ "global" ~ id? ~ export_inline* ~ import_inline? ~ global_type ~ instr* ~ ")"
}

global_type = {
    "(" ~ "mut" ~ any_val_type ~ ")"
  | any_val_type
}

// ── Tag (exceptions proposal) ─────────────────────────────────────────────────

tag_field = { "(" ~ "tag" ~ id? ~ export_inline* ~ import_inline? ~ tag_type ~ ")" }

// ── Call tags (proposals/call-tags) ───────────────────────────────────────────
// A CALL tag is a distinct entity from the EH `tag` above: that one names an
// exception type, this one names a CALLING CONVENTION over a signature.
//
//   (call_tag $t (param ...) (result ...))            ;; canonical for the type
//   (call_tag $t (param ...) (result ...) (fallback $f))
//
// `(fallback $f)` is the Overview's optional handler on `call_tag.new`; with no
// fallback the tag is canonical and an unhandled call TRAPS. Importable and
// exportable like any other entity, which is what lets a module keep a tag
// private — the proposal's stated security property.
call_tag_field = {
    "(" ~ "call_tag" ~ id? ~ export_inline* ~ import_inline? ~ call_tag_canon? ~ typeuse ~ call_tag_fallback? ~ ")"
}
// `(canon)` selects `call_tag.canon $functype` — the tag INTERNED per
// signature, which is what `call_indirect` is defined in terms of. Without it a
// declaration is `call_tag.new`: a FRESH identity over that signature. The
// Overview makes the fall-back handler optional on `new`, NOT the freshness, so
// two differently-named tags over one signature must stay distinct.
call_tag_canon = { "(" ~ "canon" ~ ")" }
call_tag_fallback = { "(" ~ "fallback" ~ index ~ ")" }

// `func_switch ($call_tag $func)* $func_switch?` — "an alternative to `func`".
// It has no type and cannot be called directly; `ref.func` on it yields a
// funcref that switches on the tag it is called with.
func_switch_field = {
    "(" ~ "func_switch" ~ id? ~ export_inline* ~ func_switch_arm* ~ func_switch_forward? ~ ")"
}
func_switch_arm = { "(" ~ "case" ~ index ~ index ~ ")" }
func_switch_forward = { "(" ~ "forward" ~ index ~ ")" }
// A tagtype IS a typeuse: `(type $t)`, an inline `(param …)*`/`(result …)*`, or
// both. `result*` is not optional decoration — a tag with results is what
// `tag.wast` asserts INVALID ("non-empty tag result type"), and the file cannot
// reach that assertion if the text does not parse. The `(func …)` form is the
// legacy spelling some fixtures still use.
tag_type  = {
    "(" ~ "func" ~ param* ~ result* ~ ")"
  | "(" ~ "type" ~ index ~ ")" ~ param* ~ result*
  | param* ~ result*
}

// ── Element segment ───────────────────────────────────────────────────────────

elem_field = {
    "(" ~ "elem" ~ id? ~ elem_mode? ~ ref_val_type? ~ elem_item* ~ ")"
  | "(" ~ "elem" ~ id? ~ elem_mode? ~ "func"? ~ index* ~ ")"
}

// An element expression: an explicit `(item <expr>)` or a bare folded const
// expression (`(ref.func $f)`, `(ref.null func)`, `(global.get $g)`). Both
// forms carry the initializer for one table slot.
elem_item = { ("(" ~ "item" ~ instr* ~ ")") | folded_instr }

// Active offset (`(offset …)` or the abbreviated single folded instr like
// `(i32.const 0)`), an explicit `(table …)(offset …)`, or `declare`. Mirrors
// `data_mode`. The `func` keyword in the element list is optional, so bare
// funcidx lists (`(elem $e $f1 $f2)`, `(elem (i32.const 0) $f1)`) parse.
elem_mode = {
    "(" ~ "table" ~ index ~ ")" ~ ("(" ~ "offset" ~ instr* ~ ")" | folded_instr)
  | "(" ~ "offset" ~ instr* ~ ")"
  | "declare"
  | folded_instr
}

// ── Data segment ──────────────────────────────────────────────────────────────

data_field = {
    "(" ~ "data" ~ id? ~ data_mode? ~ string* ~ ")"
}

data_mode = {
    "(" ~ "memory" ~ index ~ ")" ~ "(" ~ "offset" ~ instr* ~ ")"
  | "(" ~ "memory" ~ index ~ ")" ~ folded_instr
  | "(" ~ "offset" ~ instr* ~ ")"
  | folded_instr
}

// ── Type definition ───────────────────────────────────────────────────────────

type_field     = { "(" ~ "type" ~ id? ~ (sub_type | desc_clauses ~ composite_type) ~ ")" }
// Standard subtyping: `(sub $Base? (struct …))` / `(sub final $Base? …)`.
sub_type       = { "(" ~ "sub" ~ "final"? ~ index* ~ desc_clauses ~ composite_type ~ ")" }
// ── Custom Descriptors proposal ───────────────────────────────────────────
// `(describes $x)` and `(descriptor $y)` sit between the supertype vector and
// the composite type, in that order — the binary format nests them the same
// way (`describingcomptype` wraps `describedcomptype` wraps `comptype`,
// Overview.md §"Describes and Desciptor Clauses", 0x4C then 0x4D).
//
// A type may carry BOTH, which is what makes meta-descriptor chains
// (`$foo` → `$foo.desc` → `$foo.meta-desc`) expressible.
// Silent (`_`) so `composite_type` stays a DIRECT child of `type_field` and
// `sub_type` — every existing walker arm matches on it positionally.
desc_clauses      = _{ describes_clause? ~ descriptor_clause? }
describes_clause  = { "(" ~ "describes" ~ index ~ ")" }
descriptor_clause = { "(" ~ "descriptor" ~ index ~ ")" }
composite_type = { struct_type | array_type | func_type | struct_subtype | array_subtype | cont_type }
struct_type    = { "(" ~ "struct" ~ field_def* ~ ")" }
array_type     = { "(" ~ "array" ~ (field_def | storage_type) ~ ")" }
// Legacy GC-MVP subtype forms (fields/storage followed by the supertype index).
struct_subtype = { "(" ~ "struct_subtype" ~ field_def* ~ index ~ ")" }
array_subtype  = { "(" ~ "array_subtype" ~ (field_def | storage_type) ~ index ~ ")" }
// Continuation type (stack-switching proposal): `(cont $func_type)`.
cont_type      = { "(" ~ "cont" ~ index ~ ")" }
// `(field t1 t2 t3)` is the abbreviation for three consecutive unnamed fields
// (a NAMED field declares exactly one).
// A NAMED field declares exactly one; an unnamed `(field)` is the abbreviation
// for ZERO fields, which `(struct (field))` uses and `struct_type`'s `field_def*`
// then contributes nothing for.
field_def      = { "(" ~ "field" ~ (id ~ storage_type | storage_type*) ~ ")" }
storage_type   = { "(" ~ "mut" ~ (val_type | packed_type | ref_val_type) ~ ")" | val_type | packed_type | ref_val_type }
packed_type    = @{ "i8" | "i16" }
ref_val_type   = { "(" ~ "ref" ~ "null"? ~ (exact_heap_type | heap_type) ~ ")" | ref_type }
// `(exact $T)` — Custom Descriptors §"Exact Types". An exact reference is a
// subtype of its base heap type but NOT a supertype of that type's declared
// subtypes, which is what makes `struct.new_desc`'s descriptor operand sound.
// Only DEFINED types have exact versions: the binary format encodes the index
// as a plain `u32` precisely so an exact ABSTRACT heap type cannot be spelled.
exact_heap_type = { "(" ~ "exact" ~ index ~ ")" }
// A heap type is an abstract name, a `$id`, or a NUMERIC type index — `(ref 0)`
// and `(param (ref 1))` address the type section positionally (ref, type-rec).
heap_type      = @{ "func" | "extern" | "exn" | "any" | "eq" | "i31" | "data" | "struct" | "array" | "string" | "none" | "noextern" | "nofunc" | "noexn" | id | integer }
func_type      = { "(" ~ "func" ~ param* ~ result* ~ ")" }

// ── Start ─────────────────────────────────────────────────────────────────────

start_field = { "(" ~ "start" ~ index ~ ")" }

// ── Module ────────────────────────────────────────────────────────────────────

// `(module definition …)` declares a module WITHOUT instantiating it (the
// instance form then instantiates it by name). The keyword is CAPTURED, not a
// bare literal: the walker has to suppress every instantiation effect for it.
// Walking one as an ordinary module allocates its declared memories and tables
// — `(module definition (table 0xffff_ffff funcref))` (table.wast:9) is a
// ~70GB `resize` and `(module definition (memory 65536))` (memory.wast:8) is
// 4GiB, both for a module the spec never instantiates.
module_definition_kw = { "definition" }
module = { "(" ~ "module" ~ module_definition_kw? ~ id? ~ (module_field | rec_group)* ~ ")" }

// A recursion group `(rec (type …) …)` makes its type definitions mutually
// recursive. The rule stays SILENT and splices its members straight into the
// module, which is how every consumer (prescan and walk) already sees them —
// `Rule::module_field` is matched at 17 one-level loops and a wrapper pair
// would have to be flattened at every one.
//
// ⛔ THE BOUNDARY IS NO LONGER INVISIBLE, and the old comment's reasoning
// ("a TYPE-IDENTITY property, not a structural one") stopped being true the
// moment validation arrived. Rec-group MEMBERSHIP is what the custom-descriptor
// rules turn on, and it alone decides which diagnostic is correct:
//
//   (type (descriptor 1) (struct))                       "descriptor type is outside rec group"
//   (rec (type (descriptor 1) (struct)) (type (struct)))  "type is not described by its descriptor"
//
// Same types, same clauses, same indices — only the `rec` differs. So the
// group's EXTENT is emitted as two zero-consumer marker pairs while its members
// stay spliced. All 17 loops filter FOR `module_field`, so a new sibling rule
// is ignored by every one of them.
//
// ⛔ `rec_end` matches the CLOSING PAREN rather than being zero-width: a
// `{ "" }` rule is a question about what pest does with an empty match, and
// there is no reason to ask it when the delimiter is right there.
rec_group = _{ "(" ~ rec_begin ~ module_field* ~ rec_end }
rec_begin = { "rec" }
rec_end   = { ")" }

// ── WAST Script Commands ──────────────────────────────────────────────────────

// (invoke id? "name" expr*)  — id selects a named module instance
invoke_cmd = { "(" ~ "invoke" ~ id? ~ string ~ expr* ~ ")" }

// (assert_return action result*)
assert_return = { "(" ~ "assert_return" ~ action ~ result_val* ~ ")" }

// (assert_trap action "message")  — runtime trap
assert_trap = { "(" ~ "assert_trap" ~ action ~ string ~ ")" }

// (assert_trap (module …) "message")  — instantiation trap
assert_instantiation_trap = { "(" ~ "assert_trap" ~ module ~ string ~ ")" }

// (assert_exception action)  — the action must throw an EXCEPTION.
//
// Carries no message, unlike `assert_trap`: the spec asserts only that an
// exception escaped, never which tag. This is the directive the exception
// suite is built on — `throw.wast`, `throw_ref.wast` and `try_table.wast` are
// unparseable without it, which is why none of them had ever run.
assert_exception = { "(" ~ "assert_exception" ~ action ~ ")" }

// (assert_invalid (module …) "message")  — validation error
assert_invalid = { "(" ~ "assert_invalid" ~ module_or_binary ~ string ~ ")" }

// (assert_malformed (module …) "message")  — parse/decode error
assert_malformed = { "(" ~ "assert_malformed" ~ module_or_binary ~ string ~ ")" }

// (assert_unlinkable (module …) "message")  — link error
assert_unlinkable = { "(" ~ "assert_unlinkable" ~ module_or_binary ~ string ~ ")" }

// (assert_exhaustion action "message")  — stack overflow
assert_exhaustion = { "(" ~ "assert_exhaustion" ~ action ~ string ~ ")" }

// (assert_suspension action "message")  — threads proposal
assert_suspension = { "(" ~ "assert_suspension" ~ action ~ string ~ ")" }

// (register "name" id?)  — register module under a name for imports
register_cmd = { "(" ~ "register" ~ string ~ id? ~ ")" }

// (get id? "name")  — read a global export
get_cmd = { "(" ~ "get" ~ id? ~ string ~ ")" }

// Action: invoke or get
action = { invoke_cmd | get_cmd }

// ── Result values (expected in assert_return) ─────────────────────────────────

result_val = {
    "(" ~ "i32.const" ~ integer ~ ")"
  | "(" ~ "i64.const" ~ integer ~ ")"
  | "(" ~ "f32.const" ~ (float | integer) ~ ")"
  | "(" ~ "f64.const" ~ (float | integer) ~ ")"
  // Lanes may be FLOATS, not only integers: an `f32x4`/`f64x2` expectation is
  // written `(v128.const f32x4 1.5 nan:canonical …)`. `float` must come first
  // — against `1.5` the `integer` rule would match the leading "1" and leave
  // ".5" unconsumed.
  | "(" ~ "v128.const" ~ val_lane_type ~ (float | integer)+ ~ ")"
  // The heap type is optional: a bare `(ref.null)` expects "null of ANY heap
  // type", the reftype-agnostic spelling used by ref_null / select.
  | "(" ~ "ref.null"   ~ heap_type? ~ ")"
  | "(" ~ "ref.extern" ~ integer? ~ ")"
  // A HOST reference carries the same payload as `ref.extern` — `externalize`
  // and `internalize` move a value between the two spellings (gc/extern).
  | "(" ~ "ref.host"   ~ integer? ~ ")"
  | "(" ~ "ref.func"   ~ ")"
  // Abstract heap-type expectations: "a non-null reference OF THIS KIND",
  // with no payload to compare. `ref.array`/`ref.struct` must precede the
  // shorter `ref.any` etc. only if one were a prefix of another; they are not.
  | "(" ~ ("ref.array" | "ref.struct" | "ref.i31" | "ref.eq" | "ref.any" | "ref.exn") ~ ")"
  | "(" ~ "f32.const"  ~ "nan:canonical" ~ ")"
  | "(" ~ "f32.const"  ~ "nan:arithmetic" ~ ")"
  | "(" ~ "f64.const"  ~ "nan:canonical" ~ ")"
  | "(" ~ "f64.const"  ~ "nan:arithmetic" ~ ")"
  // `(either r1 r2 …)` — the relaxed-simd proposal's NONDETERMINISM: the
  // implementation may answer any one of the listed results and be conforming.
  // Listed last so a concrete result is always matched first.
  | "(" ~ "either" ~ result_val* ~ ")"
}

// Lane type for v128.const in result_val
val_lane_type = @{
    "i8x16" | "i16x8" | "i32x4" | "i64x2" | "f32x4" | "f64x2"
}

// ── Inline expressions (invoke arguments) ─────────────────────────────────────

expr = {
    "(" ~ "i32.const" ~ integer ~ ")"
  | "(" ~ "i64.const" ~ integer ~ ")"
  | "(" ~ "f32.const" ~ (float | integer) ~ ")"
  | "(" ~ "f64.const" ~ (float | integer) ~ ")"
  // Float lanes — see the note on `result_val`'s v128.const.
  | "(" ~ "v128.const" ~ val_lane_type ~ (float | integer)+ ~ ")"
  | "(" ~ "ref.null"   ~ heap_type ~ ")"
  | "(" ~ "ref.extern" ~ integer ~ ")"
  | "(" ~ "ref.host"   ~ integer ~ ")"
  | "(" ~ "ref.func"   ~ index ~ ")"
}

// ── Module or binary/quote (for assert_malformed/invalid/unlinkable) ──────────
// The binary/quote forms must precede plain `module`: the plain rule cannot
// consume the `binary`/`quote` keyword and would fail mid-way. `id?` because
// the spec allows `(module $M binary "…")`.

// ⚠ `definition` COMBINES WITH `binary`/`quote`. It used to appear only on the
// plain `module` rule, so `(module definition binary "…")` matched nothing:
// the plain rule accepted `definition` but then wanted module FIELDS, and the
// binary alternative had no `definition?`. Custom Descriptors'
// `exact-func-import.wast` opens with exactly that spelling.
module_or_binary = {
    "(" ~ "module" ~ module_definition_kw? ~ id? ~ "binary" ~ string+ ~ ")"
  | "(" ~ "module" ~ module_definition_kw? ~ id? ~ "quote"  ~ string+ ~ ")"
  | module
}

// ── Top-level WAST program ────────────────────────────────────────────────────

// Top-level embedded modules: `(module binary "…")` (raw bytes) and
// `(module quote "…")` (deferred text). Must precede `module` since the plain
// module rule can't consume the `binary`/`quote` keyword.
module_binary_cmd = { "(" ~ "module" ~ module_definition_kw? ~ id? ~ "binary" ~ string+ ~ ")" }
module_quote_cmd  = { "(" ~ "module" ~ module_definition_kw? ~ id? ~ "quote"  ~ string+ ~ ")" }

script_cmd = {
    module_binary_cmd
  | module_quote_cmd
  // A COMPONENT is a top-level definition in its own right, not a module
  // field. It must precede `module`: `(component (core module …))` nests a
  // module inside itself, and the plain module rule cannot consume the
  // `component` keyword.
  | component
  | module
  | assert_return
  | assert_instantiation_trap
  | assert_trap
  | assert_invalid
  | assert_malformed
  | assert_unlinkable
  | assert_exhaustion
  | assert_suspension
  | assert_exception
  | invoke_cmd
  | register_cmd
  | get_cmd
  // A script may write a module's fields BARE at the top level — the implicit
  // single-module abbreviation (`(func) (memory 0) (func (export "f"))`). Last,
  // so a real command always wins; its shape is a module's, so it walks as one.
  | inline_module
}

inline_module = { module_field+ }

program = { SOI ~ script_cmd* ~ EOI }

// ═════════════════════════════════════════════════════════════════════════════
// Component Model text format
// ═════════════════════════════════════════════════════════════════════════════
//
// Everything above this line is CORE WebAssembly — `(module …)`. The Component
// Model defines a SECOND, outer text format that wraps core modules and carries
// the pieces core WASM has no syntax for: the type space, instances, aliases,
// and above all the CANON SECTION, which is where `canon lift` / `canon lower`
// and the 46 canonical built-ins actually live.
//
// Transcribed from `proposals/component-model/design/mvp/Explainer.md`, EBNF
// blocks 0-14. Gate legend (`Explainer.md:49`): ungated = WASI 0.2, 🔀 = 0.3,
// 🧵/🧵② = threads, 📝 error-context, 🪺 nested namespaces, 🔗 canonical
// interface names, 🐘 memory64, 🗺️ map, 🏷️ implements, 🪙 value imports.
//
// Rules are prefixed `comp_`/`core_` where a bare spelling would collide with
// the core grammar above (`type_field`, `start_field`, `module`, …). The two
// index spaces are kept apart in the RULE NAMES for the same reason `CalleeRef`
// keeps them apart in the runtime: `core:funcidx` and `funcidx` are different
// spaces, and one integer serving both is how a mis-wired definition ends up
// looking correct.
//
// Validation is deliberately NOT done here. This front end parses; it has no
// typed validator (see the `assert_invalid` note above), so where the spec's
// well-formedness is a TYPING rule rather than a syntax rule this grammar is
// permissive and the walker refuses. `bind-id(X)` is the visible case: it
// admits an `<id>?` after the sort keyword in every externtype position.

// ── §2 component / definition ────────────────────────────────────────────────

component = { "(" ~ "component" ~ id? ~ component_definition* ~ ")" }

component_definition = {
    core_module_def
  | core_instance_def
  | core_type_def
  | component
  | comp_instance
  | comp_alias
  | canon
  | comp_start
  | comp_import
  | comp_export
  | comp_value
  | comp_type
}

// core-prefix(<X>): where <X> parses `(Y …)`, core-prefix parses `(core Y …)`.
// A `(core module …)` body is a plain core module — same fields, same walker.
core_module_def   = { "(" ~ "core" ~ "module" ~ module_definition_kw? ~ id? ~ (module_field | rec_group)* ~ ")" }
core_instance_def = { "(" ~ "core" ~ "instance" ~ id? ~ core_instanceexpr ~ ")" }
core_type_def     = { "(" ~ "core" ~ "type" ~ id? ~ (core_moduletype | sub_type | composite_type) ~ ")" }

// ── §3 core:instance ─────────────────────────────────────────────────────────

core_instanceexpr   = { core_instantiate | core_inlineexport* }
core_instantiate    = { "(" ~ "instantiate" ~ index ~ core_instantiatearg* ~ ")" }
core_instantiatearg = { "(" ~ "with" ~ string ~ "(" ~ "instance" ~ (core_inlineexport+ | index) ~ ")" ~ ")" }
core_inlineexport   = { "(" ~ "export" ~ string ~ core_externidx ~ ")" }
core_externidx      = { "(" ~ core_sort ~ index ~ string* ~ ")" }
core_sort           = @{ ("func" | "table" | "memory" | "global" | "tag" | "type" | "module" | "instance") ~ !name_char }

// ── §4 instance ──────────────────────────────────────────────────────────────

comp_instance    = { "(" ~ "instance" ~ id? ~ instanceexpr ~ ")" }
instanceexpr     = { comp_instantiate | inlineexport* }
comp_instantiate = { "(" ~ "instantiate" ~ index ~ instantiatearg* ~ ")" }
instantiatearg   = { "(" ~ "with" ~ string ~ ("(" ~ "instance" ~ inlineexport+ ~ ")" | externidx) ~ ")" }
inlineexport     = { "(" ~ "export" ~ externnamelit ~ versionsuffix? ~ externidx ~ ")" }

// §1 + §6. The trailing `<name>+` is the sortidx alias sugar of block 6:
// `(func $i "a" "b")` names an export path THROUGH instance $i.
externidx = {
    "(" ~ "core" ~ core_sort ~ index ~ string* ~ ")"
  | "(" ~ comp_sort_kw ~ index ~ string* ~ ")"
  | index
}

comp_sort_kw = @{ ("component" | "instance" | "func" | "type" | "value") ~ !name_char }
sort_c       = { "core" ~ core_sort | comp_sort_kw }

// ── §5 alias ─────────────────────────────────────────────────────────────────

comp_alias = {
    "(" ~ "alias" ~ "core" ~ "export" ~ index ~ string        ~ "(" ~ "core" ~ core_sort ~ id? ~ ")" ~ ")"
  | "(" ~ "alias" ~ "export" ~ index ~ externnamelit          ~ "(" ~ sort_c ~ id? ~ ")" ~ ")"
  | "(" ~ "alias" ~ "outer"  ~ index ~ index                  ~ "(" ~ outeraliassort ~ id? ~ ")" ~ ")"
}

outeraliassort = { "core" ~ ("module" | "type") | "component" | "type" }

// ── §7 core:moduletype ───────────────────────────────────────────────────────

core_moduletype  = { "(" ~ "module" ~ core_moduledecl* ~ ")" }
core_moduledecl  = { core_importdecl | core_exportdecl | core_alias_outer | type_field }
core_importdecl  = { "(" ~ "import" ~ string ~ string ~ import_desc ~ ")" }
// strip-id: an exportdecl's externtype carries NO binder.
core_exportdecl  = { "(" ~ "export" ~ string ~ import_desc ~ ")" }
core_alias_outer = { "(" ~ "alias" ~ "outer" ~ index ~ index ~ "(" ~ "type" ~ id? ~ ")" ~ ")" }

// ── §8 type / deftype / defvaltype / functype / componenttype / instancetype ─

comp_type = { "(" ~ "type" ~ id? ~ deftype ~ ")" }

deftype = { resourcetype | functype_c | componenttype | instancetype | defvaltype }

defvaltype = {
    prim_valtype
  | "(" ~ "record"  ~ record_field+ ~ ")"
  | "(" ~ "variant" ~ variant_case+ ~ ")"
  // 🔧 fixed-length list: `(list <valtype> <u32>)`.
  | "(" ~ "list"    ~ valtype ~ integer? ~ ")"
  | "(" ~ "tuple"   ~ valtype+ ~ ")"
  | "(" ~ "flags"   ~ labellit+ ~ ")"
  | "(" ~ "enum"    ~ labellit+ ~ ")"
  | "(" ~ "option"  ~ valtype ~ ")"
  | "(" ~ "result"  ~ valtype? ~ result_err? ~ ")"
  | "(" ~ "map"     ~ keytype ~ valtype ~ ")"     // 🗺️
  | "(" ~ "own"     ~ index ~ ")"
  | "(" ~ "borrow"  ~ index ~ ")"
  | "(" ~ "stream"  ~ valtype? ~ ")"              // 🔀
  | "(" ~ "future"  ~ valtype? ~ ")"              // 🔀
}

// The boundary guard is load-bearing: without it `s8` matches the head of a
// user label and `string` matches the head of nothing useful at all.
prim_valtype = @{
    ("bool" | "s8" | "s16" | "s32" | "s64" | "u8" | "u16" | "u32" | "u64"
   | "f32" | "f64" | "char" | "string" | "error-context") ~ !name_char
}

// 🗺️ keytype — the primitives a map key may take (no float, no error-context).
keytype = @{
    ("bool" | "s8" | "s16" | "s32" | "s64" | "u8" | "u16" | "u32" | "u64"
   | "char" | "string") ~ !name_char
}

// valtype ::= <typeidx> | <defvaltype>. `defvaltype` first — a primitive name
// is neither an integer nor a `$id`, so the two can never both match.
valtype      = { defvaltype | index }
record_field = { "(" ~ "field" ~ labellit ~ valtype ~ ")" }
variant_case = { "(" ~ "case" ~ labellit ~ valtype? ~ ")" }
result_err   = { "(" ~ "error" ~ valtype ~ ")" }

// 🐘 the `(rep i64)` form.
resourcetype  = { "(" ~ "resource" ~ "(" ~ "rep" ~ resource_rep ~ ")" ~ resource_dtor? ~ ")" }
resource_rep  = @{ ("i32" | "i64") ~ !name_char }
resource_dtor = { "(" ~ "dtor" ~ core_funcidx_ref ~ ")" }

functype_c    = { "(" ~ "func" ~ id? ~ async_kw? ~ func_param_c* ~ func_result_c? ~ ")" }
func_param_c  = { "(" ~ "param"  ~ labellit ~ valtype ~ ")" }
func_result_c = { "(" ~ "result" ~ valtype ~ ")" }
async_kw      = @{ "async" ~ !name_char }

componenttype = { "(" ~ "component" ~ id? ~ componentdecl* ~ ")" }
instancetype  = { "(" ~ "instance"  ~ id? ~ instancedecl*  ~ ")" }
componentdecl = { importdecl | instancedecl }
instancedecl  = { core_type_def | comp_type | comp_alias | exportdecl }
importdecl    = { "(" ~ "import" ~ externnamelit ~ attribute* ~ externtype ~ ")" }
exportdecl    = { "(" ~ "export" ~ externnamelit ~ attribute* ~ externtype ~ ")" }

// The `id?`s below are `bind-id(X)`: "bind-id(X) parses '(' sort <id>? Y ')'
// when X parses '(' sort Y ')'". Every spec use of externtype — importdecl,
// exportdecl, comp_import, and `canon lift` — is a bind-id use.
//
// The binder is not decoration. `canon lift`'s `(func $f (type $ft))` is what
// DEFINES `$f` in the component's FUNCTION index space, and `canon lower`'s
// callee is a component funcidx. Without it the lift -> lower round trip
// cannot be spelled at all, which is why `canon lift` was unreachable: not a
// missing walk, a missing binder.
//
// functype_c / componenttype / instancetype already carry their own `id?`.
externtype = {
    "(" ~ "core" ~ "module" ~ id? ~ core_moduledecl* ~ ")"
  | "(" ~ "value" ~ id? ~ valuebound ~ ")"                 // 🪙
  | "(" ~ "type"  ~ id? ~ typebound  ~ ")"
  | "(" ~ comp_sort_kw ~ id? ~ "(" ~ "type" ~ index ~ ")" ~ ")"
  | functype_c
  | componenttype
  | instancetype
}

typebound  = { "(" ~ "eq" ~ index ~ ")" | "(" ~ "sub" ~ "resource" ~ ")" }
valuebound = { "(" ~ "eq" ~ index ~ ")" | valtype }         // 🪙

// ── §9/§10 canon ─────────────────────────────────────────────────────────────
//
// The canon section. Each row is a DEFINITION with immediates, not an opcode —
// which is exactly what `CanonDef` in the runtime records. Rows are spelled out
// by SHAPE rather than collapsed into one permissive `<name> <arg>* (core func)`
// rule, because the per-row arity IS the fidelity: a generic rule would happily
// accept `(canon thread.index 5 (core func))`.

canon      = { "(" ~ "canon" ~ canon_body ~ ")" }
canon_body = { canon_lift | canon_lower | canon_builtin }

canon_lift  = { "lift"  ~ core_funcidx_ref ~ canonopt* ~ externtype }
canon_lower = { "lower" ~ funcidx_ref ~ canonopt* ~ core_func_bind }

core_func_bind   = { "(" ~ "core" ~ "func" ~ id? ~ ")" }

// The trailing `string*` is block 6's sortidx sugar — `(core func $i "run")`
// addresses an export named "run" THROUGH core instance `$i`. It is not an
// optional flourish: it is how a `canon lift` names the core function it
// wraps, because the callee lives inside an instance, not in the component's
// own core function space.
funcidx_ref      = { "(" ~ "func" ~ index ~ string* ~ ")" | index }
core_funcidx_ref = { "(" ~ "core" ~ "func"   ~ index ~ string* ~ ")" | index }
core_memidx_ref  = { "(" ~ "core" ~ "memory" ~ index ~ string* ~ ")" | index }
core_tableidx_ref= { "(" ~ "core" ~ "table"  ~ index ~ string* ~ ")" | index }
core_typeidx_ref = { "(" ~ "core" ~ "type"   ~ index ~ string* ~ ")" | index }

canonopt = {
    string_encoding_opt
  | "(" ~ "memory"      ~ core_memidx_ref  ~ ")"
  | "(" ~ "realloc"     ~ core_funcidx_ref ~ ")"
  | "(" ~ "post-return" ~ core_funcidx_ref ~ ")"
  | "(" ~ "callback"    ~ core_funcidx_ref ~ ")"   // 🔀
  | async_kw                                        // 🔀
}

// latin1+utf16 FIRST — `utf16` is not a prefix of it, but `string-encoding=`
// is shared, and ordering by descending length is the habit that keeps a later
// edit from introducing the bug rather than merely avoiding it today.
string_encoding_opt = @{ "string-encoding=" ~ ("latin1+utf16" | "utf16" | "utf8") ~ !name_char }

cancellable_kw = @{ "cancellable" ~ !name_char }
shared_kw      = @{ "shared" ~ !name_char }

canon_builtin = {
    canon_thread_new_indirect
  | canon_spawn_indirect
  | canon_spawn_ref
  | canon_avail_par
  | canon_ctx
  | canon_task_return
  | canon_ws_mem
  | canon_ty_opts
  | canon_ty_async
  | canon_ty
  | canon_async_only
  | canon_cancellable
  | canon_errctx_opts
  | canon_nullary
}

// `<name> (core func $id?)`
canon_nullary = { canon_nullary_op ~ core_func_bind }
canon_nullary_op = @{
    ("backpressure.inc" | "backpressure.dec" | "task.cancel"
   | "waitable-set.new" | "waitable-set.drop" | "waitable.join"
   | "subtask.drop" | "thread.index" | "thread.resume-later"
   | "error-context.drop") ~ !name_char
}

// `<name> <typeidx> (core func $id?)`
canon_ty = { canon_ty_op ~ index ~ core_func_bind }
canon_ty_op = @{
    ("resource.new" | "resource.drop" | "resource.rep"
   | "stream.drop-readable" | "stream.drop-writable" | "stream.new"
   | "future.drop-readable" | "future.drop-writable" | "future.new") ~ !name_char
}

// `<name> <typeidx> <canonopt>* (core func $id?)`
canon_ty_opts = { canon_ty_opts_op ~ index ~ canonopt* ~ core_func_bind }
canon_ty_opts_op = @{
    ("stream.read" | "stream.write" | "future.read" | "future.write") ~ !name_char
}

// `<name> <typeidx> async? (core func $id?)`
canon_ty_async = { canon_ty_async_op ~ index ~ async_kw? ~ core_func_bind }
canon_ty_async_op = @{
    ("stream.cancel-read" | "stream.cancel-write"
   | "future.cancel-read" | "future.cancel-write") ~ !name_char
}

// `<name> <valtype> <u32> (core func $id?)`
canon_ctx = { canon_ctx_op ~ valtype ~ integer ~ core_func_bind }
canon_ctx_op = @{ ("context.get" | "context.set") ~ !name_char }

// `task.return (result <valtype>)? <canonopt>* (core func $id?)`
canon_task_return    = { canon_task_return_op ~ func_result_c? ~ canonopt* ~ core_func_bind }
canon_task_return_op = @{ "task.return" ~ !name_char }

// `<name> cancellable? (memory …) (core func $id?)`
canon_ws_mem = { canon_ws_mem_op ~ cancellable_kw? ~ "(" ~ "memory" ~ core_memidx_ref ~ ")" ~ core_func_bind }
canon_ws_mem_op = @{ ("waitable-set.wait" | "waitable-set.poll") ~ !name_char }

// `subtask.cancel async? (core func $id?)`
canon_async_only    = { canon_async_only_op ~ async_kw? ~ core_func_bind }
canon_async_only_op = @{ "subtask.cancel" ~ !name_char }

// `<name> cancellable? (core func $id?)` — the 🧵 handoff family. Ordered
// LONGEST FIRST: `thread.suspend` is a proper prefix of
// `thread.suspend-then-resume`, so a shortest-first list would match the head
// of the compound row and then fail on the tail.
canon_cancellable = { canon_cancellable_op ~ cancellable_kw? ~ core_func_bind }
canon_cancellable_op = @{
    ("thread.suspend-then-resume" | "thread.suspend-then-promote"
   | "thread.yield-then-resume"   | "thread.yield-then-promote"
   | "thread.suspend" | "thread.yield") ~ !name_char
}

// `<name> <canonopt>* (core func $id?)` — 📝
canon_errctx_opts = { canon_errctx_op ~ canonopt* ~ core_func_bind }
canon_errctx_op = @{ ("error-context.new" | "error-context.debug-message") ~ !name_char }

// 🧵 `thread.new-indirect <core:typeidx> <core:tableidx> (core func $id?)`
canon_thread_new_indirect    = { canon_thread_new_indirect_op ~ core_typeidx_ref ~ core_tableidx_ref ~ core_func_bind }
canon_thread_new_indirect_op = @{ "thread.new-indirect" ~ !name_char }

// 🧵② the spawn family — `shared?` comes BEFORE the type immediate.
canon_spawn_ref      = { canon_spawn_ref_op ~ shared_kw? ~ core_typeidx_ref ~ core_func_bind }
canon_spawn_ref_op   = @{ "thread.spawn-ref" ~ !name_char }
canon_spawn_indirect = { canon_spawn_indirect_op ~ shared_kw? ~ core_typeidx_ref ~ core_tableidx_ref ~ core_func_bind }
canon_spawn_indirect_op = @{ "thread.spawn-indirect" ~ !name_char }
canon_avail_par      = { canon_avail_par_op ~ shared_kw? ~ core_func_bind }
canon_avail_par_op   = @{ "thread.available-parallelism" ~ !name_char }

// ── §11 value 🪙 ─────────────────────────────────────────────────────────────

comp_value = { "(" ~ "value" ~ id? ~ valtype ~ comp_val ~ ")" }

comp_val = {
    comp_val_kw
  | "(" ~ "some"    ~ comp_val ~ ")"
  | "(" ~ "ok"      ~ comp_val ~ ")"
  | "(" ~ "error"   ~ comp_val ~ ")"
  | "(" ~ "record"  ~ comp_val+ ~ ")"
  | "(" ~ "variant" ~ labellit ~ comp_val? ~ ")"
  | "(" ~ "list"    ~ comp_val* ~ ")"
  | "(" ~ "tuple"   ~ comp_val+ ~ ")"
  | "(" ~ "flags"   ~ labellit* ~ ")"
  | "(" ~ "enum"    ~ labellit ~ ")"
  | "(" ~ "binary"  ~ string+ ~ ")"
  | char_lit
  | float
  | integer
  | string
}

// `nan` is a <f64canon> spelling, not an identifier — the guard keeps it from
// eating the head of a `none`-like label.
comp_val_kw = @{ ("false" | "true" | "none" | "nan" | "ok" | "error") ~ !name_char }
char_lit    = @{ "'" ~ ("\\" ~ ANY | !"'" ~ ANY) ~ "'" }

// ── §12 start 🪙 ─────────────────────────────────────────────────────────────

comp_start   = { "(" ~ "start" ~ index ~ start_value* ~ start_result* ~ ")" }
start_value  = { "(" ~ "value" ~ index ~ ")" }
start_result = { "(" ~ "result" ~ "(" ~ "value" ~ id? ~ ")" ~ ")" }

// ── §13 import / export / attribute ──────────────────────────────────────────

comp_import = { "(" ~ "import" ~ externnamelit ~ attribute* ~ externtype ~ ")" }
comp_export = { "(" ~ "export" ~ id? ~ externnamelit ~ attribute* ~ externidx ~ externtype? ~ ")" }

attribute       = { versionsuffix | implements_attr | externid_attr }
versionsuffix   = { "(" ~ "versionsuffix" ~ string ~ ")" }   // 🔗
implements_attr = { "(" ~ "implements" ~ externnamelit ~ ")" }  // 🏷️
externid_attr   = { "(" ~ "external-id" ~ string ~ ")" }        // 🏷️

// ── §14 names ────────────────────────────────────────────────────────────────
//
// An externname is NOT an arbitrary string. `label` is kebab-case with a
// same-case rule per fragment, and `interfacename` carries the namespace and
// the OPTIONAL VERSION. That version is why this block matters here: the spec
// spells it `'@' <valid semver>`, and this tree has been using `@N` as a
// canonidx smuggled through an import name. Once the canon section is real,
// `@` means a version and nothing else.

externnamelit = ${ "\"" ~ externname ~ "\"" }
externname    = { interfacename | plainname }

plainname = {
    "[constructor]" ~ label
  | "[method]" ~ label ~ "." ~ label
  | "[static]" ~ label ~ "." ~ label
  | label
}

labellit = ${ "\"" ~ label ~ "\"" }
label    = @{ first_fragment ~ ("-" ~ fragment)* }

first_fragment = _{ first_acronym | first_word }
first_word     = _{ ASCII_ALPHA_LOWER ~ (ASCII_DIGIT | ASCII_ALPHA_LOWER)* }
first_acronym  = _{ ASCII_ALPHA_UPPER ~ (ASCII_DIGIT | ASCII_ALPHA_UPPER)* }
fragment       = _{ acronym | word }
word           = _{ (ASCII_DIGIT | ASCII_ALPHA_LOWER)+ }
acronym        = _{ (ASCII_DIGIT | ASCII_ALPHA_UPPER)+ }

// 🪺 the nested form is `<namespace>+ <words> <projection>+`; the unnested one
// is the same shape with exactly one of each, so one rule with `+` covers both.
interfacename    = @{ namespace+ ~ words ~ projection+ ~ interfaceversion? }
namespace        = _{ words ~ ":" }
words            = _{ first_word ~ ("-" ~ word)* }
projection       = _{ "/" ~ label }
interfaceversion = _{ "@" ~ (ASCII_DIGIT | ASCII_ALPHA | "." | "-" | "+")+ }

// ⚠ `!name_char` must be applied INSIDE an atomic (`@`) rule. In a normal rule
// pest inserts implicit whitespace between `"lit"` and the lookahead, so the
// guard ends up testing the FIRST CHARACTER OF THE NEXT TOKEN instead of the
// character after the keyword — `(canon subtask.cancel async …)` then fails
// because `a` is a name char. Every keyword guard above is therefore its own
// `@{ "…" ~ !name_char }` rule, never an inline literal.
//
// The identifier-continuation set shared by every `!name_char` boundary guard
// above. `-` and `.` are IN it: `thread.suspend` must not match the head of
// `thread.suspend-then-resume`, and `s8` must not match the head of `s8-foo`.
name_char = _{ ASCII_ALPHANUMERIC | "-" | "." | "_" | "+" }

# Visual Basic .NET Compiler Profile
# ───────────────────────────────────
# Full port of vybe_compiler_vb builtins.rs (900 lines) + compiler settings

[info]
name = "vb"
extensions = ["vb"]

[compiler]
# Declared types CONVERT the value they bind (assignment, declaration and
# parameter entry alike). Stated explicitly rather than inherited: the platform
# default is `true`, and inheriting it silently gave Python coercive semantics
# it never chose.
coerces_value_to_type_hint = true
# `CInt("abc")` / `CLng("abc")` throw InvalidCastException.
numeric_cast_invalid_error = "InvalidCastException"
numeric_cast_invalid_message = "Conversion from string to type 'Integer' is not valid."
# VB `For` gives the loop variable a fresh binding per iteration, so closures
# capture the per-iteration value (like JS `let`-in-`for`).
for_loop_per_iteration_binding = true
# VB auto-invokes a bare reference to a parameterless function (like Ruby).
bare_name_invokes_parameterless_function = true
reflection_type_naming = "dotnet"   # .NET BCL: System.* root + primitive naming
# namespaceplan.md (dotnet phase): qualified System.* chains resolve through
# the common resolver over the dotnet.* tree; legacy cascade is the fallback
# during the transition.
uses_common_resolver = true
function_return = "result_slot"        # VB uses FunctionName = value AND Return
result_slot_name = "__result__"        # internal — not user-visible (VB users
                                       # write `FunctionName := X`, not
                                       # `Result := X`). Keeps user classes
                                       # named `Result` from being shadowed.
self_keyword = "me"
base_keyword = "mybase"
constructor_name = "New"               # Sub New()
enum_as_ordinals = false
case_sensitive = false
# VB is over ECMA/.NET: `Boolean` is an ECMA boolean, not a C-style i32.
# Materialize comparison + bool-decl results as real booleans so
# `Dim f As Boolean = True`, `f = True`, and `n > 3` behave/print as
# `True`/`False` instead of flattening to `1`/`0` (mirrors csharp).
materialize_bool_results = true
# VB `+` concatenates when an operand is a String (String + String → concat),
# and adds numerically otherwise — the same string-aware `+` as C#/Java/Dart.
# `&` is the dedicated concat operator (BinOp::Concat); `+` still needs this so
# `"A" + "B"` yields "AB" instead of NaN from a purely-numeric add.
dynamic_add = true
string_indexing = "one_based"          # Mid(), InStr() are 1-based
array_upper_bound_inclusive = true     # Dim arr(5) means 0..5 inclusive (6 elements)
parens_for_index = true                # arr(i) not arr[i] — () is both call and index
entry_point = "main"                   # auto-call Main if defined
# VB-specific compiler behaviors
byref_boxing = true                    # ByRef args wrapped in single-element arrays for call-by-reference
with_block = true                      # With obj ... End With — bare .Member resolves to With target
new_with_initializer = true            # New Foo() With { .Prop = val }
new_from_initializer = true            # New List(Of T) From { items }
linq_queries = true                    # LINQ query syntax compiled to method chains
# Route `class` declarations through common::classes::normalize_class
# + emit_class (see classnormalization.md). VB walker already injects
# implicit MyBase.New() and AddHandler statements into ctor bodies;
# the normalizer maps method names to canonical (ToString →
# tostring, GetEnumerator → iterator, etc.) and populates the class's
# `auto_init_methods` when InitializeComponent is defined.
uses_normalize_class = true
# VB `Async Function` returns a Task/Task(Of T). Under the shared runtime that
# is the same fulfilled/rejected promise shape used by the common await emitter.
async_wraps_body_in_try = true

# ────────────────────────────────────────────────────────────────────────────
# BUILTINS — every function/method the VB compiler knows about
# ────────────────────────────────────────────────────────────────────────────
#
# emit formats:
#   "print"                    → common::io::emit_print
#   "str_length"               → common::strings::emit_length
#   "opcode:<op>"              → single WASM opcode (e.g. f64_abs)
#   "host:<module>:<func>"     → call_import(module, func)
#   "intrinsic:<name>"         → multi-opcode sequence handled by compiler
#   "mutate:add"               → in-place mutation (Inc/Dec)
#   "noop"                     → emit nothing (no-op stub)
#   "namespace_chain"          → resolve via global namespace objects

[builtins]

# `Type.GetType("Name")` — static type lookup by name. Resolution is the shared
# dynamic-symbol path; .NET yields null on a miss rather than throwing, and the
# result is the type's NAME so it agrees with `typeof(X)`.
__vybe_type_get = { emit = "intrinsic:symbol_probe", min_args = 1, max_args = 1 }


endswith      = { emit = "common:str_ends_with",    min_args = 1, max_args = 1 }
contains      = { emit = "common:str_contains",     min_args = 1, max_args = 1 }

# ⛔ THESE ROWS SHADOW A DECLARED LEAF, AND THAT IS CURRENTLY LOAD-BEARING.
#
# Every `System.String` member here IS declared on the dotnet tree, and the
# tree is where they belong — a `[value_methods]` row wins outright, so the
# leaf underneath has never run. Routing to it was MEASURED and the leaf
# answers wrongly:
#
#   Replace / Split / Substring  -> `null`   (`vb_string_methods`)
#   PadLeft / PadRight           -> wrong width
#   Trim/TrimStart/TrimEnd(chars)-> `null` for the ParamArray form, and the
#                                   single-char form leaves a char behind
#   IndexOf / Contains (C#)      -> -1 / False where VB answers 6 / True
#
# ⇒ the blocker is NOT a missing declaration. It is that
# `platforms/dotnet/.../string_adapter.rs` was dead code for as long as these
# rows existed. Fix those emitters against `tools/vbrun` / `tools/csrun`, then
# delete this block — the leaves and their return types are already in place.

# LINQ surface lives once in the shared .NET component resolver
# (`platforms/dotnet/.../component_classes_linq.rs`, class `IEnumerable`),
# resolved by receiver type — or by method name for untyped receivers on the
# .NET path — so VB declares NO per-function LINQ entries. Same shared surface
# and `generators.rs`-backed adapters as C#.


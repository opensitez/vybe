# ────────────────────────────────────────────────────────────────────────────
# ARRAY HIGHER-ORDER METHODS (HOF)
# ────────────────────────────────────────────────────────────────────────────
# These trigger the compiler's HOF dispatch (emit_for_in loops).
# Method names are lowercase (VB is case-insensitive).

# Return types of builtin free functions, for inference on chained member access
# (e.g. `Environ("PATH").Length`). Keyed case-insensitively (VB).
[builtin_return_types]
Command = "String"
Environ = "String"
Timer   = "Double"

# DateTime field-extractor functions: `Year(d)` → `d.Year` (applied only when the
# argument is a DateTime). Function name (case-insensitive) → DateTime field.
[datetime_field_functions]
Year   = "Year"
Month  = "Month"
Day    = "Day"
Hour   = "Hour"
Minute = "Minute"
Second = "Second"
Weekday = "DayOfWeek"

[array_methods]
findindex     = "__array_findIndex"
find          = "__array_find"
findlast      = "__array_findLast"
findlastindex = "__array_findLastIndex"
findall       = "__array_filter"
trueforall    = "__array_every"
convertall    = "__array_map"
exists        = "__array_some"
removeall     = "__array_removeAll"
foreach       = "__array_forEach"

# ────────────────────────────────────────────────────────────────────────────
# .NET NAMESPACE RESOLUTION
# ────────────────────────────────────────────────────────────────────────────

[namespaces]
# Use the .NET BCL namespace resolution from vybe_compiler_common::dotnet.
# This gives us 60+ namespace roots, default imports, known constants,
# resolve_dotted_name(), and the full .NET resolution order
# (locals → fields → FQN → imports → known types).
use_dotnet = true
use_dotnet_resolver = true

# Additional default imports specific to VB (beyond the common .NET ones)
extra_imports = [
  "microsoft.visualbasic",
]

# ────────────────────────────────────────────────────────────────────────────
# KNOWN TYPES — constructor mappings for New TypeName()
# ────────────────────────────────────────────────────────────────────────────

[known_types]
# name = [host_module, host_function]
#
# Constructor fallbacks for `New TypeName()` when the dotnet wrapper
# Component Model adapter doesn't handle the type. Most .NET-shape
# classes lower at compile time and bypass this table entirely.
#
# Retired entries (handled by compile-time adapters):
#   stringbuilder, regex, streamreader, streamwriter, task, thread,
#   process, queue, stack, hashset — all dispatch through dotnet wrapper
#   Common emit paths (`stringbuilder_adapter`, `stream_io_adapter`,
#   `threading::emit_*`, `process_adapter`, `collections.new`).
"string"         = ["common", "dotnet.string_from_chars"]

# ────────────────────────────────────────────────────────────────────────────
# NAMESPACE CONSTANTS — compile-time float/string values for property accesses
# ────────────────────────────────────────────────────────────────────────────

[namespace_constants]
"comparemethod.binary" = 0.0
"comparemethod.text" = 1.0
"vbtab" = "\t"
"vbcrlf" = "\r\n"
"vbnewline" = "\r\n"


# ── Math — WASM opcodes (zero overhead) ─────────────────────────────────────

abs           = { emit = "opcode:f64_abs",     min_args = 1, max_args = 1 }
fix           = { emit = "opcode:f64_trunc",   min_args = 1, max_args = 1 }
# The unsigned view a `UInteger`/`UShort`/`Byte` result needs after a bitwise
# op — the lane is signed, so `Not 0UI` lands as -1 without it. Emitted by the
# walker, never written in source.
"__vb_as_unsigned32" = { emit = "common:bits.as_unsigned32", min_args = 1, max_args = 1 }
int           = { emit = "opcode:f64_floor",   min_args = 1, max_args = 1 }
sqr           = { emit = "opcode:f64_sqrt",    min_args = 1, max_args = 1 }
# VB `Round`/`Math.Round` is BANKER'S rounding — `Round(2.5)` is 2, `Round(3.5)`
# is 4 — the same default as .NET, and `vybe_ast`'s `MidpointPolicy` table names
# VB under `HalfEven` explicitly. This row said `common:round`, which dispatches
# to `ecma:math.round`: JAVASCRIPT rounding, i.e. half-AWAY-from-zero, so
# `Round(2.5)` answered 3. C# has had the correct row all along
# (`languages/csharp/src/profile`), which is the whole argument for sharing one.
#
# One arg only, like C#'s: the two-arg `Round(x, digits)` form never reaches this
# row — the walker intercepts `"round" if arguments.len() >= 2` first.
round         = { emit = "common:math.round_half_even", min_args = 1, max_args = 1 }
# `System.Numerics` / `Int128` width discipline — the same rows the C# profile
# carries. The emitters they name live in `platforms/dotnet`, which VB already
# runs on, so this is a binding, not a second implementation.
"__vybe_bi_is_num" = { emit = "common:dotnet.i128_is_numeric", min_args = 1, max_args = 1 }
"__vybe_bi_is_pow2" = { emit = "common:dotnet.i128_is_pow2", min_args = 1, max_args = 1 }

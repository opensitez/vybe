// vybe Grammar for pest parser
// Case-insensitive parsing

WHITESPACE = _{ " " | "\t" | line_continuation }
COMMENT = _{ ("'" | (^"REM" ~ !(ASCII_ALPHANUMERIC | "_"))) ~ (!NEWLINE ~ ANY)* }
NEWLINE = { "\r\n" | "\n" | "\r" }
ASCII_OCT_DIGIT = _{ '0'..'7' }
ASCII_BIN_DIGIT = _{ "0" | "1" }

// Line continuation: underscore at end of line joins the next line
// Must NOT match identifiers containing "_" — only matches "_" followed by optional whitespace and newline
line_continuation = _{ "_" ~ (" " | "\t")* ~ ("\r\n" | "\n" | "\r") }

// Program structure
program = { SOI ~ line* ~ EOI }
line = _{ xml_namespace_imports_statement | imports_statement | option_directive | attribute_line | statement_line | NEWLINE | COMMENT }
option_directive = {
    ^"Option" ~ (
        ((^"Explicit" | ^"Strict" | ^"Infer") ~ (^"On" | ^"Off"))
        | (^"Compare" ~ (^"Binary" | ^"Text"))
    ) ~ (NEWLINE | EOI)
}
statement_line = {
    (
        (sub_decl | function_decl)
        | (statement ~ (":" ~ statement)*)
    ) ~ COMMENT? ~ (NEWLINE | EOI)
}

// Attributes: <Extension()> is captured; all other attributes are silently consumed
extension_attribute = { "<" ~ (^"Runtime.CompilerServices.")? ~ ^"Extension" ~ "(" ~ ")" ~ ">" ~ (WHITESPACE* ~ "_" ~ WHITESPACE* ~ (NEWLINE | EOI))? }
attribute = _{ "<" ~ (!(">" ~ WHITESPACE* ~ ("_" ~ WHITESPACE* ~ (NEWLINE | EOI))?) ~ ANY)* ~ ">" ~ (WHITESPACE* ~ "_" ~ WHITESPACE* ~ (NEWLINE | EOI))? }
attribute_line = { (extension_attribute ~ (NEWLINE | EOI)?) | (attribute ~ (NEWLINE | EOI)?) }

// Imports statement — captured for namespace resolution
// Supports: Imports System.IO
//           Imports IO = System.IO  (alias)
imports_alias = { identifier ~ "=" }
imports_statement = { ^"Imports" ~ imports_alias? ~ type_name ~ (NEWLINE | EOI | ":") }
xml_namespace_imports_statement = { ^"Imports" ~ "<" ~ xml_attribute ~ ">" ~ (NEWLINE | EOI | ":") }

// Statements
statement = _{
    namespace_decl
    | module_decl
    | class_decl
    | interface_decl
    | structure_decl
    | enum_decl
    | delegate_sub_decl
    | delegate_function_decl
    | sub_decl
    | function_decl
    | const_statement
    | dim_statement
    // `Static total As Integer` is a DECLARATION and belongs beside `Dim`. It
    // used to sit after `call_statement`, which never left it a turn: `Static`
    // is in the `keyword` list, so `identifier` rejected it, but `postfix` fell
    // through to `primary`'s un-keyword-guarded `member_identifier`, matched
    // `Static` as a bare name, and then the rest of the line had nowhere to go.
    | static_statement
    | redim_statement
    | erase_statement
    | set_statement
    | mid_assign_statement
    | lset_statement
    | rset_statement
    | dot_compound_assign_statement
    | dot_assign_statement
    | me_assign_statement
    | mybase_assign_statement
    | compound_assign_statement
    | assign_statement
    | single_line_if_statement
    | if_statement
    | for_each_statement
    | for_statement
    | while_statement
    | do_loop_statement
    | select_statement
    | with_statement
    | using_statement
    | try_statement
    | continue_statement
    | exit_statement
    | throw_statement
    | yield_statement
    | return_statement
    | on_error_statement
    | resume_statement
    | goto_statement
    | label_statement
    | addhandler_statement
    | removehandler_statement
    | raiseevent_statement
    | line_input_statement
    | open_statement
    | close_statement
    | print_file_statement
    | write_file_statement
    | input_file_statement
    | call_statement
    | synclock_statement
    | expression_statement
}
// Atomic, for the same word-boundary reason as `new_keyword` below:
// `Dim x As NewThing` must not read as `Dim x As New Thing`.
dim_new_keyword = @{ ^"New" ~ !(ASCII_ALPHANUMERIC | "_") }
array_rank_spec = { "(" ~ (array_bounds | array_rank_commas)? ~ ")" }
array_rank_commas = { ","+ }
dim_declaration_part = {
    identifier ~
    array_rank_spec* ~
    (^"As" ~ dim_new_keyword? ~ type_name ~ ("(" ~ nl_skip ~ argument_list? ~ nl_skip ~ ")")? ~ (from_initializer | with_initializer)?)? ~
    // VB 10+ implicit line continuation: a break after `=` continues the
    // statement, which is how a multi-line XML literal is written —
    //     Dim userXml As XElement =
    //         <User>…</User>
    // ⛔ The skip is LEADING only. A TRAILING one would swallow the statement's
    // own line terminator, which is what cost 18 tests when `nl_skip` was put
    // around `argument_list` instead of inside its parentheses.
    ("=" ~ nl_skip ~ expression)?
}

dim_statement = {
    ^"Dim" ~ dim_declaration_part ~ ("," ~ dim_declaration_part)*
}

// `Static x = 1, y = 2` — same comma-separated declarator list `Dim` already
// had, so it reuses `dim_declaration_part` (initializer optional, exactly like
// `Dim`).
static_statement = { ^"Static" ~ dim_declaration_part ~ ("," ~ dim_declaration_part)* }
// `As type_name` is optional: with Option Infer on (the default), `Const v = 5`
// infers from the initializer. `parse_const_statement` already builds `type_hint`
// opportunistically, so the absent clause needs no walker change.
//
// `Const` gets its OWN part rather than reusing `dim_declaration_part`, because
// a Const REQUIRES an initializer — reusing Dim's would silently accept
// `Const x As Integer`, which real VB rejects.
const_declaration_part = { identifier ~ (^"As" ~ type_name)? ~ "=" ~ expression }
const_statement = { visibility_modifier? ~ ^"Const" ~ const_declaration_part ~ ("," ~ const_declaration_part)* }
set_statement = { ^"Set" ~ identifier ~ "=" ~ expression }
lset_statement = { ^"LSet" ~ l_value_expression ~ "=" ~ expression }
rset_statement = { ^"RSet" ~ l_value_expression ~ "=" ~ expression }
mid_assign_statement = { ^"Mid" ~ "(" ~ l_value_expression ~ "," ~ expression ~ ("," ~ expression)? ~ ")" ~ "=" ~ expression }
compound_assign_op = { "+=" | "-=" | "*=" | "/=" | "\\=" | "&=" | "^=" | "<<=" | ">>=" }
l_value_expression = { (generic_type_reference | identifier) ~ ( ("." ~ member_identifier) | ("(" ~ nl_skip ~ argument_list? ~ nl_skip ~ ")") )* }
compound_assign_statement = { l_value_expression ~ compound_assign_op ~ expression }
assign_statement = { l_value_expression ~ "=" ~ expression }
preserve_keyword = { ^"Preserve" }
redim_statement = { ^"ReDim" ~ preserve_keyword? ~ identifier ~ "(" ~ array_bounds ~ ")" }
erase_statement = { ^"Erase" ~ identifier }
// `RaiseEvent c.Step2()` — the event may be reached through a receiver, so the
// target is a member access, not only a bare name.
raiseevent_statement = { ^"RaiseEvent" ~ (member_access | identifier) ~ ("(" ~ nl_skip ~ argument_list? ~ nl_skip ~ ")")? }
yield_statement = { ^"Yield" ~ expression? }

// Array support
array_bound = @{ (!("," | ")") ~ ANY)+ }
array_bounds = { array_bound ~ ("," ~ array_bound)* }
array_literal = { "{" ~ NEWLINE* ~ (expression ~ (NEWLINE* ~ "," ~ NEWLINE* ~ expression)*)? ~ NEWLINE* ~ "}" }

// Control flow
single_line_if_statement = {
    ^"If" ~ expression ~ ^"Then" ~ single_line_stmt ~ (^"Else" ~ single_line_stmt)?
}
single_line_stmt = _{
    yield_statement
    | return_statement
    | throw_statement
    | exit_statement
    | continue_statement
    // `If c Then GoTo L` is the single most common single-line If in VB. Without
    // this it fell through to `expression_statement`, where `primary`'s
    // un-keyword-guarded `member_identifier` matched `GoTo` as a bare name and
    // left `L` dangling — a parse error on the whole line.
    | goto_statement
    | erase_statement
    | set_statement
    | mid_assign_statement
    | lset_statement
    | rset_statement
    | dot_assign_statement
    | me_assign_statement
    | mybase_assign_statement
    | compound_assign_statement
    | assign_statement
    | addhandler_statement
    | removehandler_statement
    | call_statement
    | expression_statement
}

if_statement = {
    ^"If" ~ expression ~ ^"Then" ~ (NEWLINE | EOI)
    ~ if_body
    ~ elseif_block*
    ~ else_block?
    ~ if_end
}
if_body = { (!if_control ~ line)* }
if_control = { ^"ElseIf" | ^"Else" | if_end }
elseif_block = { ^"ElseIf" ~ expression ~ ^"Then" ~ (NEWLINE | EOI) ~ if_body }
else_block = { ^"Else" ~ (NEWLINE | EOI) ~ if_body }
if_end = { ^"End" ~ ^"If" }

for_statement = {
    ^"For" ~ identifier ~ (^"As" ~ type_name)? ~ "=" ~ expression ~ ^"To" ~ expression ~ (^"Step" ~ expression)?
    ~ (for_inline_body | for_block_body)
}
for_inline_body = _{ ":" ~ !for_end ~ statement ~ (":" ~ !for_end ~ statement)* ~ ":" ~ for_end }
for_block_body = _{ (NEWLINE | EOI) ~ (!for_end ~ line)* ~ for_end }
for_end = { ^"Next" ~ identifier? }

for_each_statement = {
    ^"For" ~ ^"Each" ~ identifier ~ (^"As" ~ type_name)? ~ ^"In" ~ expression
    ~ (for_each_inline_body | for_each_block_body)
}
for_each_inline_body = _{ ":" ~ !for_end ~ statement ~ (":" ~ !for_end ~ statement)* ~ ":" ~ for_end }
for_each_block_body = _{ (NEWLINE | EOI) ~ (!for_end ~ line)* ~ for_end }

while_statement = {
    ^"While" ~ expression ~ (NEWLINE | EOI)
    ~ (!while_end ~ line)*
    ~ while_end
}
while_end = { ^"Wend" | ^"End" ~ ^"While" }

do_loop_statement = {
    ^"Do" ~ (do_while_kw ~ expression | do_until_kw ~ expression)? ~ (NEWLINE | EOI)
    ~ (!do_end ~ line)*
    ~ do_end
}
do_end = { ^"Loop" ~ (do_while_kw ~ expression | do_until_kw ~ expression)? }
do_while_kw = { ^"While" }
do_until_kw = { ^"Until" }

select_statement = {
    ^"Select" ~ ^"Case" ~ expression ~ (NEWLINE | EOI)
    ~ case_block*
    ~ case_else?
    ~ select_end
}

// `!case_else_kw`: `Else` is in the `keyword` list, but `primary` falls back to
// `member_identifier`, which is NOT keyword-guarded — so `Case Else` matched
// `case_block` with the condition `Ident("Else")` and the default arm silently
// vanished. The boundary keeps `Case ElseFlag` a normal condition.
case_block = {
    ^"Case" ~ !case_else_kw ~ case_conditions ~ (NEWLINE | EOI)
    ~ (!case_control ~ line)*
}

case_conditions = { case_condition ~ ("," ~ case_condition)* }

case_condition = {
    case_is_kw ~ case_is_op ~ expression   // Case Is > 10, Case Is = 5, Case Is <> 4
    | expression ~ ^"To" ~ expression      // Case 1 To 10
    | expression                           // Case 5
}

case_else_kw = @{ ^"Else" ~ !(ASCII_ALPHANUMERIC | "_") }
case_is_kw = @{ ^"Is" ~ !(ASCII_ALPHANUMERIC | "_") }
// `Case Is` takes the full comparison set, not `comp_op`: that rule sits at the
// `comparison` precedence level, where `=` and `<>` belong to `eq_op` one level
// up. Listed longest-first — `"<"` before `"<>"` would eat the `<` of `<>`.
case_is_op = { "<=" | ">=" | "<>" | "<" | ">" | "=" }

case_else = {
    ^"Case" ~ case_else_kw ~ (NEWLINE | EOI)
    ~ (!select_end ~ line)*
}

case_control = _{ ^"Case" | select_end }
select_end = { ^"End" ~ ^"Select" }

// With...End With
with_statement = {
    ^"With" ~ expression ~ (
        (":" ~ !with_end ~ statement ~ (":" ~ !with_end ~ statement)* ~ ":"? ~ with_end)
        | ((NEWLINE | EOI) ~ (!with_end ~ line)* ~ with_end)
    )
}
with_end = { ^"End" ~ ^"With" }

using_statement = {
    ^"Using" ~ using_resource_decl ~ ("," ~ using_resource_decl)* ~ (NEWLINE | EOI)
    ~ (!using_end ~ line)*
    ~ using_end
}
// The `As`/`=` clause is OPTIONAL: `Using r` acquires an ALREADY-BOUND
// resource, which real VB allows and which this rule rejected outright.
using_resource_decl = {
    identifier ~ (^"As" ~ (new_expression | type_name ~ "=" ~ expression) | "=" ~ expression)?
}
using_end = { ^"End" ~ ^"Using" }

// Dot-member access for With blocks: .Property = value, .Method(args)
dot_assign_statement = { "." ~ member_identifier ~ ("." ~ member_identifier)* ~ "=" ~ expression }
dot_compound_assign_statement = { "." ~ member_identifier ~ ("." ~ member_identifier)* ~ compound_assign_op ~ expression }
dot_call_statement = { "." ~ member_identifier ~ ("." ~ member_identifier)* ~ "(" ~ nl_skip ~ argument_list? ~ nl_skip ~ ")" }
dot_member_access = { "." ~ member_identifier ~ ("." ~ member_identifier)* }

// Try-Catch-Finally
try_statement = {
    ^"Try" ~ (NEWLINE | EOI)
    ~ try_body
    ~ catch_block*
    ~ finally_block?
    ~ try_end
}
try_body = { (!try_control ~ line)* }
catch_block = { ^"Catch" ~ (identifier ~ ^"As" ~ type_name)? ~ (^"When" ~ expression)? ~ (NEWLINE | EOI) ~ try_body }
finally_block = { ^"Finally" ~ (NEWLINE | EOI) ~ try_body }
try_end = { ^"End" ~ ^"Try" }
try_control = _{ (^"Catch" | ^"Finally" | try_end) ~ !(ASCII_ALPHANUMERIC | "_") }

throw_statement = { ^"Throw" ~ expression? }
continue_statement = { ^"Continue" ~ (^"Do" | ^"For" | ^"While") }

exit_statement = { ^"Exit" ~ exit_type }
exit_type = { ^"Sub" | ^"Function" | ^"For" | ^"Do" | ^"Select" | ^"Try" | ^"Property" | ^"While" }
return_statement = { ^"Return" ~ expression? }

// GoTo / Labels
// A VB line label may be an integer as well as a name (`10:` … `GoTo 10`), the
// VB6 legacy spelling. `line_label` is a named rule so the walker's
// `into_inner().next()` finds a pair either way. Real VB requires the colon on a
// numeric label (`BC30801`), so the two label forms share one rule.
goto_statement = { ^"GoTo" ~ (identifier | line_label) }
label_statement = { (identifier | line_label) ~ ":" }
line_label = @{ ASCII_DIGIT+ }

// On Error (VB6/VB.NET structured error handling)
on_error_statement = {
    ^"On" ~ ^"Error" ~ (
        ^"Resume" ~ ^"Next"
        | ^"GoTo" ~ (^"0" | "-1" | identifier)
    )
}
// `next_kw` is BOUNDARY-GUARDED and atomic: as a bare `^"Next"` it matched the
// first four letters of `Resume NextLine`, leaving `Line` dangling and killing
// the line. Same shape as `case_else_kw` above.
next_kw = @{ ^"Next" ~ !(ASCII_ALPHANUMERIC | "_") }
resume_statement = { ^"Resume" ~ (next_kw | identifier | line_label)? }

// VB6 File I/O statements
open_statement = { ^"Open" ~ expression ~ ^"For" ~ file_mode ~ ^"As" ~ "#"? ~ expression }
file_mode = { ^"Input" | ^"Output" | ^"Append" | ^"Binary" | ^"Random" }
close_statement = { ^"Close" ~ !(ASCII_ALPHANUMERIC | "_") ~ ("#"? ~ expression ~ ("," ~ "#"? ~ expression)*)? }
print_file_statement = { ^"Print" ~ "#" ~ expression ~ "," ~ argument_list? }
write_file_statement = { ^"Write" ~ "#" ~ expression ~ "," ~ argument_list? }
input_file_statement = { ^"Input" ~ "#" ~ expression ~ "," ~ identifier ~ ("," ~ identifier)* }
line_input_statement = { ^"Line" ~ ^"Input" ~ "#" ~ expression ~ "," ~ identifier }

// Procedure declarations
// sub_modifier covers: Public, Private, Protected, Friend, Overrides, Overloads, Shared, etc.
virtual_keyword = @{ ^"Virtual" ~ !(ASCII_ALPHANUMERIC | "_") }
sub_modifier_keyword = { ^"Overrides" | ^"Overloads" | ^"Shared" | ^"Iterator" | ^"Widening" | ^"Narrowing" | ^"MustOverride" | ^"Overridable" | virtual_keyword | ^"NotOverridable" | ^"Shadows" }
sub_modifier = _{ visibility_modifier | sub_modifier_keyword | partial_keyword | async_kw }
sub_name = { identifier | member_identifier | ^"New" }
function_name = { identifier | member_identifier }
handles_clause = { ^"Handles" ~ dotted_identifier ~ ("," ~ dotted_identifier)* }
implements_target = { type_name ~ ("." ~ member_identifier)? }
implements_member_clause = { ^"Implements" ~ implements_target ~ ("," ~ implements_target)* }
sub_decl = {
    attribute_line* ~
    sub_modifier* ~ ^"Sub" ~ sub_name ~ generic_suffix? ~ "(" ~ nl_skip ~ param_list? ~ nl_skip ~ ")" ~ handles_clause? ~ implements_member_clause?
    ~ (sub_expr_body | sub_inline_body | sub_block_body | abstract_body)
}
abstract_body = { &(NEWLINE | EOI) }
sub_expr_body = { "=>" ~ statement }
sub_inline_body = { ":" ~ (statement ~ ":")* ~ sub_end }
sub_block_body = { (NEWLINE | EOI) ~ (!sub_end ~ line)* ~ sub_end }
sub_end = { ^"End" ~ ^"Sub" }

function_decl = {
    attribute_line* ~
    sub_modifier* ~ ^"Function" ~ function_name ~ generic_suffix? ~ "(" ~ nl_skip ~ param_list? ~ nl_skip ~ ")" ~ (^"As" ~ type_name)? ~ implements_member_clause?
    ~ (func_expr_body | func_inline_body | func_block_body | abstract_body)
}
func_expr_body = { "=>" ~ expression }
func_inline_body = { ":" ~ (statement ~ ":")* ~ func_end }
func_block_body = { (NEWLINE | EOI) ~ (!func_end ~ line)* ~ func_end }
func_end = { ^"End" ~ ^"Function" }

operator_decl = {
    attribute_line* ~
    sub_modifier* ~ ^"Operator" ~ operator_symbol ~ "(" ~ nl_skip ~ param_list? ~ nl_skip ~ ")" ~ (^"As" ~ type_name)?
    ~ (operator_inline_body | operator_block_body | abstract_body)
}
operator_symbol = { ^"IsTrue" | ^"IsFalse" | ^"CType" | ^"Like" | "<>" | ">=" | "<=" | "=" | "+" | "-" | "*" | "/" | "\\" | ^"Mod" | ^"Not" | ">" | "<" }
operator_inline_body = { ":" ~ (statement ~ ":")* ~ operator_end }
operator_block_body = { (NEWLINE | EOI) ~ (!operator_end ~ line)* ~ operator_end }
operator_end = { ^"End" ~ ^"Operator" }

param_list = { param ~ (nl_skip ~ "," ~ nl_skip ~ param)* }
pass_type_keyword = { ^"ByVal" | ^"ByRef" }
optional_keyword = { ^"Optional" }
paramarray_keyword = { ^"ParamArray" }
// `ParamArray` appears on BOTH sides of `ByVal` because real VB writes
// `ByVal ParamArray items() As Integer`, and the rank spec takes commas:
// `Sub Mutate(arr(,) As Integer)` declares a 2-D array parameter.
param = { attribute* ~ paramarray_keyword? ~ optional_keyword? ~ pass_type_keyword? ~ optional_keyword? ~ paramarray_keyword? ~ identifier ~ ("(" ~ ","* ~ ")")? ~ nullable_marker? ~ (^"As" ~ type_name)? ~ ("=" ~ expression)? }
nullable_marker = { "?" }

// Module declarations (VB.NET style - members are implicitly shared)
module_decl = {
    attribute_line* ~
    (^"Public" | ^"Private" | ^"Friend")? ~ ^"Module" ~ identifier
    ~ (module_inline_body | module_block_body)
}
module_member = _{ auto_property_line | property_decl | sub_decl | function_decl | const_statement_line | custom_event_decl | event_line | delegate_line | field_line | dim_line | class_decl | interface_decl | structure_decl | enum_decl | NEWLINE | COMMENT }
module_inline_member = _{ auto_property_decl | property_decl | sub_decl | function_decl | const_statement | custom_event_decl | event_decl | delegate_sub_decl | delegate_function_decl | field_decl | dim_statement | class_decl | interface_decl | structure_decl | enum_decl }
module_inline_body = _{ (":" ~ module_end) | (":" ~ module_inline_member ~ (":" ~ module_inline_member)* ~ ":" ~ module_end) }
module_block_body = _{ (NEWLINE | EOI) ~ (!module_end ~ module_member)* ~ module_end }
module_end = { ^"End" ~ ^"Module" }
const_statement_line = _{ const_statement ~ (NEWLINE | EOI) }

// Class declarations
partial_keyword = { ^"Partial" }
inherits_statement = { ^"Inherits" ~ type_name ~ ("," ~ type_name)* }
inherits_line = _{ inherits_statement ~ (NEWLINE | EOI) }
visibility_modifier = { ^"Public" | ^"Private" | ^"Protected" | ^"Friend" }

class_decl = {
    attribute_line* ~
    class_modifier* ~ ^"Class" ~ identifier ~ generic_suffix?
    ~ (class_inline_body | class_block_body)
}
class_member = _{ class_decl | interface_decl | structure_decl | auto_property_line | property_decl | operator_decl | sub_decl | function_decl | const_statement_line | custom_event_decl | event_line | delegate_line | field_line | dim_line | enum_decl | imports_statement | attribute_line | NEWLINE | COMMENT }
class_inline_clause = _{ inherits_statement | implements_statement | class_decl | interface_decl | structure_decl | auto_property_decl | property_decl | operator_decl | sub_decl | function_decl | const_statement | custom_event_decl | event_decl | delegate_sub_decl | delegate_function_decl | field_decl | dim_statement | enum_decl | imports_statement }
class_inline_body = _{ (":" ~ class_end) | (":" ~ class_inline_clause ~ (":" ~ class_inline_clause)* ~ ":" ~ class_end) }
class_block_body = _{
    (NEWLINE | EOI)
    ~ inherits_line?
    ~ implements_line?
    ~ (!class_end ~ class_member)*
    ~ class_end
}
class_modifier = _{ partial_keyword | must_inherit_keyword | not_inheritable_keyword | sub_modifier_keyword | visibility_modifier }
must_inherit_keyword = { ^"MustInherit" }
not_inheritable_keyword = { ^"NotInheritable" }

class_end = { ^"End" ~ ^"Class" }
dim_line = _{ dim_statement ~ (NEWLINE | EOI) }

// Interface declarations
implements_statement = { ^"Implements" ~ type_name ~ ("," ~ type_name)* }
implements_line = _{ implements_statement ~ (NEWLINE | EOI) }

interface_decl = {
    attribute_line* ~ visibility_modifier? ~ ^"Interface" ~ identifier ~ generic_suffix? ~ (NEWLINE | EOI | ":")
    ~ inherits_line?
    ~ (!interface_end ~ (inherits_statement ~ ":" | interface_decl | delegate_line | interface_sub | interface_function | interface_property | interface_event | NEWLINE | COMMENT))*
    ~ interface_end
}
interface_end = { ^"End" ~ ^"Interface" }
interface_member_modifier = _{ default_keyword | ^"Shadows" | ^"ReadOnly" | ^"WriteOnly" }
interface_sub = { (^"Shadows")? ~ ^"Sub" ~ sub_name ~ generic_suffix? ~ "(" ~ nl_skip ~ param_list? ~ nl_skip ~ ")" ~ (NEWLINE | EOI | ":") }
interface_function = { (^"Shadows")? ~ ^"Function" ~ function_name ~ generic_suffix? ~ "(" ~ nl_skip ~ param_list? ~ nl_skip ~ ")" ~ (^"As" ~ type_name)? ~ (NEWLINE | EOI | ":") }
interface_property = { interface_member_modifier* ~ ^"Property" ~ identifier ~ ("(" ~ nl_skip ~ param_list? ~ nl_skip ~ ")")? ~ (^"As" ~ type_name)? ~ (NEWLINE | EOI | ":") }
interface_event = { ^"Event" ~ identifier ~ (^"As" ~ type_name | "(" ~ nl_skip ~ param_list? ~ nl_skip ~ ")")? ~ (NEWLINE | EOI | ":") }

// Structure declarations
structure_decl = {
    attribute_line* ~ visibility_modifier? ~ ^"Structure" ~ identifier ~ generic_suffix?
    ~ (structure_inline_body | structure_block_body)
}
structure_member = _{ class_decl | interface_decl | structure_decl | auto_property_line | property_decl | operator_decl | sub_decl | function_decl | const_statement_line | custom_event_decl | event_line | field_line | dim_line | enum_decl | attribute_line | NEWLINE | COMMENT }
structure_inline_clause = _{ implements_statement | class_decl | interface_decl | structure_decl | auto_property_decl | property_decl | operator_decl | sub_decl | function_decl | const_statement | custom_event_decl | event_decl | field_decl | dim_statement | enum_decl }
structure_inline_body = _{ (":" ~ structure_end) | (":" ~ structure_inline_clause ~ (":" ~ structure_inline_clause)* ~ ":" ~ structure_end) }
structure_block_body = _{ (NEWLINE | EOI) ~ implements_line? ~ (!structure_end ~ structure_member)* ~ structure_end }
structure_end = { ^"End" ~ ^"Structure" }

// Namespace blocks
namespace_decl = {
    ^"Namespace" ~ dotted_identifier ~ (NEWLINE | EOI | ":")
    ~ (!namespace_end ~ (":" | class_decl | module_decl | interface_decl | structure_decl | enum_decl | namespace_decl | NEWLINE | COMMENT))*
    ~ namespace_end
}
namespace_end = { ^"End" ~ ^"Namespace" }

// Event declarations
event_header = { sub_modifier* ~ (^"Custom")? ~ ^"Event" ~ identifier ~ (^"As" ~ type_name | "(" ~ nl_skip ~ param_list? ~ nl_skip ~ ")")? ~ implements_member_clause? }
event_decl = { event_header }
event_line = _{ event_decl ~ (NEWLINE | EOI) }
custom_event_decl = { event_header ~ (NEWLINE | EOI | ":") ~ custom_event_accessor* ~ ^"End" ~ ^"Event" }
custom_event_accessor = {
    visibility_modifier? ~ (^"AddHandler" | ^"RemoveHandler" | ^"RaiseEvent") ~ "(" ~ nl_skip ~ param_list? ~ nl_skip ~ ")" ~ (NEWLINE | EOI | ":")
    ~ (!custom_event_accessor_end ~ line)*
    ~ custom_event_accessor_end ~ (NEWLINE | EOI | ":")?
}
custom_event_accessor_end = _{ ^"End" ~ (^"AddHandler" | ^"RemoveHandler" | ^"RaiseEvent") }

// Delegate declarations
delegate_sub_decl = { visibility_modifier? ~ ^"Delegate" ~ ^"Sub" ~ identifier ~ generic_suffix? ~ "(" ~ nl_skip ~ param_list? ~ nl_skip ~ ")" }
delegate_function_decl = { visibility_modifier? ~ ^"Delegate" ~ ^"Function" ~ identifier ~ generic_suffix? ~ "(" ~ nl_skip ~ param_list? ~ nl_skip ~ ")" ~ (^"As" ~ type_name)? }
delegate_line = _{ (delegate_sub_decl | delegate_function_decl) ~ (NEWLINE | EOI) }

// Enum declarations
enum_decl = {
    attribute_line* ~ (^"Public" | ^"Private" | ^"Friend")? ~ ^"Enum" ~ identifier ~ (^"As" ~ type_name)?
    ~ (enum_inline_body | enum_block_body)
}
enum_inline_body = _{ ":" ~ (enum_member_inline ~ ":")* ~ enum_end }
enum_member_inline = { member_identifier ~ ("=" ~ expression)? }
enum_block_body = _{ (NEWLINE | EOI) ~ (!enum_end ~ (enum_member | NEWLINE | COMMENT))* ~ enum_end }
enum_member = { member_identifier ~ ("=" ~ expression)? ~ (NEWLINE | EOI) }
enum_end = { ^"End" ~ ^"Enum" }

// Field declarations: now support Friend, WithEvents, and dotted type names
withevents_keyword = { ^"WithEvents" }
field_modifier = _{ visibility_modifier | sub_modifier_keyword | withevents_keyword | ^"ReadOnly" }
field_decl = { field_modifier* ~ identifier ~ array_rank_spec? ~ (^"As" ~ dim_new_keyword? ~ type_name ~ ("(" ~ nl_skip ~ argument_list? ~ nl_skip ~ ")")?)? ~ ("=" ~ expression)? }
field_line = _{ field_decl ~ (NEWLINE | EOI) }

default_keyword = { ^"Default" }
property_modifier = _{
    default_keyword
    | visibility_modifier
    | sub_modifier_keyword
    | withevents_keyword
    | ^"Custom"
    | ^"ReadOnly"
    | ^"WriteOnly"
}

// Auto-implemented property: Public Property Name As String [= defaultValue]
auto_property_modifier = {
    visibility_modifier
    | ^"Shared"
    | ^"ReadOnly"
    | ^"Default"
    | ^"Overrides"
    | ^"Overridable"
    | ^"NotOverridable"
    | ^"Overloads"
    | ^"Shadows"
    | ^"WithEvents"
    | ^"Custom"
}
auto_property_accessor = { visibility_modifier? ~ (^"Get" | ^"Set") }
auto_property_accessor_block = { "{" ~ auto_property_accessor ~ (";" ~ auto_property_accessor)* ~ ";"? ~ "}" }
auto_property_decl = {
    attribute_line* ~ auto_property_modifier* ~ ^"Property" ~ identifier ~ !"(" ~ (^"As" ~ dim_new_keyword? ~ type_name ~ from_initializer?)? ~ implements_member_clause? ~ auto_property_accessor_block? ~ ("=" ~ expression)?
}
auto_property_line = _{ auto_property_decl ~ ((NEWLINE ~ !(visibility_modifier? ~ (^"Get" | ^"Set"))) | EOI) }

property_decl = {
    attribute_line* ~ property_modifier* ~ ^"Property" ~ identifier ~ ("(" ~ nl_skip ~ param_list? ~ nl_skip ~ ")")? ~ (^"As" ~ type_name)? ~ implements_member_clause?
    ~ (property_expr_body | ((NEWLINE | EOI | ":") ~ ((property_get | property_set | NEWLINE)* ~ property_end)?))
}
property_expr_body = { "=>" ~ expression }

property_get = {
    visibility_modifier? ~ ^"Get" ~ (
        (COMMENT? ~ (NEWLINE | EOI) ~ (!get_end ~ line)* ~ get_end)
        | (":" ~ (statement ~ ":")* ~ get_end ~ ":"?)
    )
}

property_set = {
    visibility_modifier? ~ ^"Set" ~ ("(" ~ param ~ ")")? ~ (
        (COMMENT? ~ (NEWLINE | EOI) ~ (!set_end ~ line)* ~ set_end)
        | (":" ~ (statement ~ ":")* ~ set_end ~ ":"?)
    )
}

property_end = { ^"End" ~ ^"Property" }
get_end = { ^"End" ~ ^"Get" }
set_end = { ^"End" ~ ^"Set" }

// Expressions

// Lambda Expressions
// ⛔ `Async` AND a return type are BOTH part of the lambda header. A lambda
// declares them exactly as `function_decl` does — `Task.Run(Async Function() …)`
// and `Function(x As Integer) As Integer` are ordinary VB — and neither was
// accepted, so the whole enclosing STATEMENT failed to parse. Ten corpus files
// die on the `Async` form alone, most of them `xs.Select(Async Function(n) …)`.
// ⛔ `as_kw`, NOT a bare `^"As"`. A lambda's body follows the header with
// nothing between them, so an unanchored `As` matched the first two letters of
// `AscW(c)` and the return-type clause swallowed the call:
// `Array.ConvertAll(chars, Function(c) AscW(c))` parsed as params `(c)`,
// return type `cW`, body `(c)` — and answered `A,B,C` instead of `65,66,67`.
// A wrong ANSWER, not a parse failure. `function_decl` has the same bare form
// and gets away with it only because a declaration never puts an expression
// right after the parameter list.
as_kw = @{ ^"As" ~ !(ASCII_ALPHANUMERIC | "_") }

lambda_expression = {
    (async_kw? ~ ^"Function" ~ "(" ~ nl_skip ~ param_list? ~ nl_skip ~ ")" ~ (as_kw ~ type_name)? ~ (expression | (NEWLINE | EOI) ~ (!func_end ~ line)* ~ func_end))
    | (async_kw? ~ ^"Sub" ~ "(" ~ nl_skip ~ param_list? ~ nl_skip ~ ")" ~ (sub_end | statement | (NEWLINE | EOI) ~ (!sub_end ~ line)* ~ sub_end))
}

expression = { logical_imp }

logical_imp = { logical_eqv ~ (imp_op ~ logical_eqv)* }
logical_eqv = { logical_xor ~ (eqv_op ~ logical_xor)* }
logical_xor = { logical_or ~ (xor_op ~ logical_or)* }
logical_or = { logical_and ~ (or_op ~ logical_and)* }
logical_and = { not_condition ~ (and_op ~ not_condition)* }
not_condition = { not_op? ~ equality } // Not binds tighter than And
equality = { comparison ~ (eq_op ~ comparison)* }
comparison = { bit_shift ~ (comp_op ~ bit_shift | like_op ~ bit_shift)* }
// ⛔ `&` is its OWN precedence level, LOOSER than `+`/`-`. VB's table is
// `* /` > `\` > `Mod` > `+ -` > `&` > `<< >>` > comparisons. Sharing a level
// with `+` made `"a" & 1 + 2` left-associate into `("a" & 1) + 2`; MEASURED
// against `tools/vbrun`, real VB prints `a3` and we printed `a12`. Silent
// wrong ANSWERS, not failures — and the test harness itself concatenates
// around arithmetic on every line.
bit_shift = { concat ~ (shift_op ~ concat)* }
concat = { additive ~ (concat_op ~ additive)* }
concat_op = { "&" }
// ⛔ `\` (integer division) and `Mod` are each their OWN level, LOOSER than
// `*` `/` and TIGHTER than `+` `-`. Sharing one level made them left-associate
// with `*`: MEASURED against `tools/vbrun`, `6 \ 2 * 3` is `1` (we said 9) and
// `10 Mod 4 * 2` is `2` (we said 4). Silent wrong ANSWERS, not failures.
additive = { modulo ~ (add_op ~ modulo)* }
modulo = { intdiv ~ (mod_op ~ intdiv)* }
intdiv = { multiplicative ~ (intdiv_op ~ multiplicative)* }
multiplicative = { unary ~ (mult_op ~ unary)* }
unary = { (await_op | neg_op | pos_op)? ~ exponent }
exponent = { postfix ~ (exp_op ~ postfix)* }
postfix = { primary ~ member_chain* }

imp_op = { ^"Imp" }
eqv_op = { ^"Eqv" }
xor_op = { ^"Xor" }
or_op = { ^"OrElse" | ^"Or" }
and_op = { ^"AndAlso" | ^"And" }
eq_op = { ^"=" | ^"<>" | ^"IsNot" | ^"Is" }
comp_op = { ^"<=" | ^">=" | "<" | ">" }
like_op = { ^"Like" }
shift_op = { "<<" | ">>" }
add_op = { "+" | "-" }
mult_op = { "*" | "/" }
intdiv_op = { "\\" }
// Atomic: a non-atomic rule lets pest skip whitespace before the lookahead, so
// the word boundary never fires and `Mod` would match inside `Mode`.
mod_op = @{ ^"Mod" ~ !(ASCII_ALPHANUMERIC | "_") }
exp_op = { "^" }
not_op = @{ ^"Not" ~ !(ASCII_ALPHANUMERIC | "_") } // Atomic: No implicit whitespace before lookahead
neg_op = { "-" }
pos_op = { "+" }
await_op = { ^"Await" }

// Me keyword rules
me_keyword = @{ ^"Me" ~ !(ASCII_ALPHANUMERIC | "_") }
async_kw = { ^"Async" }
me_member_call = { me_keyword ~ ("." ~ member_identifier)+ ~ "(" ~ nl_skip ~ argument_list? ~ nl_skip ~ ")" }
me_member_access = { me_keyword ~ ("." ~ member_identifier)+ }
me_assign_statement = { me_keyword ~ ("." ~ member_identifier)+ ~ "=" ~ expression }

// MyBase keyword rules
mybase_keyword = @{ ^"MyBase" ~ !(ASCII_ALPHANUMERIC | "_") }
mybase_member_call = { mybase_keyword ~ ("." ~ member_identifier)+ ~ "(" ~ nl_skip ~ argument_list? ~ nl_skip ~ ")" }
mybase_member_access = { mybase_keyword ~ ("." ~ member_identifier)+ }
mybase_assign_statement = { mybase_keyword ~ "." ~ l_value_expression ~ "=" ~ expression }

// Dotted identifier: System.Windows.Forms.Button
dotted_identifier = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* ~ ("." ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")*)* }

primary = _{
    nameof_expression
    | gettype_expression
    | typeof_expression
    | cast_expression
    | anonymous_new_expression
    | new_expression
    | literal
    | lambda_expression
    | if_expression
    | aggregate_expression
    | query_expression
    | xml_literal
    | me_member_call
    | me_member_access
    | me_keyword
    | mybase_member_call
    | mybase_member_access
    | mybase_keyword
    | dot_member_access
    | member_call
    | generic_type_reference
    | call_expression
    | member_access
    | addressof_expr
    | identifier
    // `member_identifier` is deliberately NOT keyword-guarded so `x.Close` and
    // `Enum E : Error = 3` work. In EXPRESSION position that same permissiveness
    // let a keyword that BEGINS A STATEMENT match as a bare name and swallow the
    // rest of the line — a parse error on a construct the grammar already
    // supports. It happened three times: `Case Else` matched `case_block` with
    // the condition `Ident("Else")`; `Static x As Integer` died because
    // `call_statement` reached here first; and `SyncLock obj` still does, for 19
    // corpus tests, because `synclock_statement` sits AFTER `call_statement` in
    // the `statement` alternation. The first two were patched by REORDERING
    // alternatives, which fixes one spelling and leaves the trap armed.
    //
    // `statement_head` is the guard instead of the whole `keyword` list, because
    // the VB6 I/O verbs (`Open`, `Close`, `Input`, `Write`, `Print`, `Line`) are
    // in `keyword` yet are ordinary names in expression position — their
    // statements are already matched earlier in the alternation.
    | (!statement_head ~ member_identifier)
    | tuple_literal
    | "(" ~ expression ~ ")"
}

/// Keywords that can only START a statement, so they are never a bare name in
/// expression position. Boundary-guarded: `Resume` must not match `ResumeFlag`.
///
/// ⛔ ATOMIC (`@`) is load-bearing. As `_{ … ~ !(ASCII_ALPHANUMERIC|"_") }` pest
/// inserts implicit WHITESPACE before the lookahead, so `SyncLock lockObj`
/// matched the keyword, skipped the space, tested the boundary against `l` of
/// `lockObj`, failed — and the guard silently never fired.
statement_head = @{
    (^"SyncLock" | ^"Static" | ^"Erase" | ^"ReDim" | ^"Preserve" | ^"GoTo"
    | ^"Resume" | ^"Throw" | ^"Yield" | ^"AddHandler" | ^"RemoveHandler"
    | ^"RaiseEvent" | ^"Using" | ^"Try" | ^"Catch" | ^"Finally" | ^"Continue"
    | ^"Exit" | ^"Return" | ^"Dim" | ^"Const" | ^"LSet" | ^"RSet" | ^"Wend"
    | ^"Loop" | ^"Then" | ^"Else" | ^"End" | ^"Handles" | ^"Implements"
    | ^"Inherits" | ^"Namespace" | ^"Imports" | ^"Declare")
    ~ !(ASCII_ALPHANUMERIC | "_")
}

nameof_expression = { ^"NameOf" ~ "(" ~ dotted_identifier ~ ")" }
gettype_expression = { ^"GetType" ~ "(" ~ type_name ~ ")" }

// TypeOf...Is expression
typeof_expression = { ^"TypeOf" ~ postfix ~ (^"IsNot" | ^"Is") ~ type_name }

// Type cast expressions: CType(expr, Type), DirectCast(expr, Type), TryCast(expr, Type)
cast_expression = { (^"CType" | ^"DirectCast" | ^"TryCast") ~ "(" ~ expression ~ "," ~ type_name ~ ")" }
// CType(...).Method() as a statement
cast_member_call = { cast_expression ~ member_chain+ }

// Inline If expression: If(cond, true, false) or If(value, default)
if_expression = { ^"If" ~ "(" ~ expression ~ "," ~ expression ~ ("," ~ expression)? ~ ")" }

aggregate_expression = { ^"Aggregate" ~ identifier ~ (^"As" ~ type_name)? ~ ^"In" ~ expression ~ ^"Into" ~ aggregate_call ~ ("," ~ aggregate_call)* }
aggregate_call = { identifier ~ "(" ~ nl_skip ~ argument_list? ~ nl_skip ~ ")" }

// New expression: supports dotted identifiers like New System.Windows.Forms.Button()
// Also supports generic types like New List(Of String), New Dictionary(Of String, Integer)
// Also supports array initializers: New Task() {task1, task2}
// Also supports collection initializers: New List(Of T) From { expr, ... }
// Also supports object initializers: New Type() With { .Prop = expr, ... }
// ⛔ `new_keyword`, NOT a bare `^"New"`: without the word-boundary guard
// `newX` parses as `New X`.
//
// The guard MUST live inside an ATOMIC rule, as `keyword` and `call_keyword`
// already spell it — in a non-atomic rule pest inserts implicit WHITESPACE
// between `^"New"` and the lookahead, so the lookahead would test the
// character after the SPACE and reject the legal `New Foo()`.
new_keyword = @{ ^"New" ~ !(ASCII_ALPHANUMERIC | "_") }
anonymous_new_expression = { new_keyword ~ WHITESPACE* ~ with_initializer }
new_expression = { new_keyword ~ WHITESPACE* ~ dotted_identifier ~ generic_suffix? ~ ("(" ~ nl_skip ~ argument_list? ~ nl_skip ~ ")")? ~ array_type_suffix* ~ (from_initializer | with_initializer | array_literal)? }
from_initializer = { ^"From" ~ "{" ~ NEWLINE* ~ (expression ~ (NEWLINE* ~ "," ~ NEWLINE* ~ expression)*)? ~ NEWLINE* ~ "}" }
with_initializer = { ^"With" ~ "{" ~ NEWLINE* ~ (member_initializer ~ (NEWLINE* ~ "," ~ NEWLINE* ~ member_initializer)*)? ~ NEWLINE* ~ "}" }
key_initializer_modifier = { ^"Key" }
member_initializer = { key_initializer_modifier? ~ "." ~ member_identifier ~ "=" ~ expression }

call_expression = { identifier ~ generic_suffix? ~ "(" ~ nl_skip ~ argument_list? ~ nl_skip ~ ")" }
generic_type_reference = { dotted_identifier ~ generic_suffix }
member_chain_invoke = { "(" ~ nl_skip ~ argument_list? ~ nl_skip ~ ")" }
member_chain_call = { "." ~ member_identifier ~ generic_suffix? ~ "(" ~ nl_skip ~ argument_list? ~ nl_skip ~ ")" }
member_chain_xml_descendant_axis = { "..." ~ "<" ~ xml_name ~ ">" }
member_chain_xml_child_axis = { "." ~ "<" ~ xml_name ~ ">" }
// VB's third XML axis: `xml.@id` reads an ATTRIBUTE. The child (`.<name>`) and
// descendant (`...<name>`) axes were both here; this one was not, so every
// attribute read was a parse error.
member_chain_xml_attribute_axis = { "." ~ "@" ~ xml_name }
member_chain_access = { "." ~ member_identifier }
// VB's null-conditional operators, `a?.B`, `a?.B()` and `a?(i)`. Each WRAPS the
// plain chain rule rather than restating it, so the walker reuses one code path
// and only marks the result — restating them is how the two spellings drift.
// ⛔ `member_chain_null_call` must precede `member_chain_null_access`: PEG takes
// the first alternative that succeeds, and the access rule matches the call's
// prefix.
member_chain_null_invoke = { "?" ~ member_chain_invoke }
member_chain_null_call = { "?" ~ member_chain_call }
member_chain_null_access = { "?" ~ member_chain_access }
member_chain = { member_chain_xml_descendant_axis | member_chain_xml_child_axis | member_chain_xml_attribute_axis | member_chain_null_invoke | member_chain_null_call | member_chain_null_access | member_chain_invoke | member_chain_call | member_chain_access }
member_call = { identifier ~ member_chain+ }
call_statement = {
    call_keyword? ~ (
        cast_member_call
        | me_member_call
        | mybase_member_call
        | member_call
        | member_access
        | call_expression
        | identifier ~ argument_list
        | identifier
        | postfix
    )
}
expression_statement = { dot_call_statement | dot_member_access | postfix }

// AddHandler / RemoveHandler
addressof_expr = { ^"AddressOf" ~ dotted_identifier }
event_target = { cast_expression ~ ("." ~ member_identifier)+ | dotted_identifier }
addhandler_statement = { ^"AddHandler" ~ event_target ~ "," ~ expression }
removehandler_statement = { ^"RemoveHandler" ~ event_target ~ "," ~ expression }

member_access = { identifier ~ ("." ~ member_identifier)+ }
named_argument = { identifier ~ ":=" ~ expression }
omitted_argument = { &("," | ")") }
first_argument = { named_argument | expression }
trailing_argument = { named_argument | expression | omitted_argument }
argument = { first_argument | trailing_argument }
// VB.NET IMPLICIT LINE CONTINUATION: a line break is legal after `(` and after
// each `,` in an argument list, with no trailing `_`. The grammar only knew the
// explicit form, so `New XDocument(` / `ThreadPool.QueueUserWorkItem(` /
// `Switch(` at end of line were parse errors.
//
// `nl_skip` is SILENT and spells the newline itself rather than reusing
// `NEWLINE`, which is a normal rule: a `NEWLINE` pair appearing inside
// `argument_list` would be handed to the walker's positional `into_inner()`
// scan as if it were an argument.
// ⛔ `nl_skip` must NOT bracket the whole list. `call_statement` has a
// PAREN-LESS form (`Foo a, b`), where a trailing `nl_skip` swallows the
// statement's own line terminator and `statement_line` then fails demanding a
// NEWLINE — measured at 18 tests. It goes around the COMMAS here, and inside
// the parentheses at the call sites.
nl_skip = _{ ("\r\n" | "\n" | "\r" | " " | "\t")* }
argument_list = { first_argument ~ (nl_skip ~ "," ~ nl_skip ~ trailing_argument)* }
tuple_literal = { "(" ~ tuple_element ~ ("," ~ tuple_element)+ ~ ","? ~ ")" }
tuple_element = { (identifier ~ ":=")? ~ expression }

// Literals
literal = _{
    array_literal
    | date_literal
    | interpolated_string
    | string_literal
    | numeric_literal
    | boolean_literal
    | nothing_literal
}

nothing_literal = { ^"Nothing" }

date_literal = @{ "#" ~ (!"#" ~ ANY)+ ~ "#" }
// Interpolated string: $"text {expr} text" — captured as raw token, decomposed in Rust parser
// ⛔ A HOLE MAY CONTAIN QUOTES: `$"{If(b, "yes", "no")}"` is valid VB, and
// scanning for the next `"` ended the literal at `"yes` — the whole statement
// then failed to parse. `{{`/`}}` come FIRST so an escaped brace is not read
// as the start of a hole.
interpolated_string = @{ "$\"" ~ ("{{" | "}}" | interpolation_hole | "\"\"" | (!("\"") ~ ANY))* ~ "\"" }
interpolation_hole = @{ "{" ~ ("{{" | "}}" | (!"}" ~ ANY))* ~ "}" }
string_literal = @{ "\"" ~ ("\"\"" | (!"\"" ~ ANY))* ~ "\"" ~ (^"C")? }
// Numeric literals: decimal/hex/octal/binary, separators, exponent, and VB type chars.
numeric_literal = @{
    (("&" ~ (^"H") ~ ASCII_HEX_DIGIT ~ (ASCII_HEX_DIGIT | "_")*)
    | ("&" ~ (^"O") ~ ASCII_OCT_DIGIT ~ (ASCII_OCT_DIGIT | "_")*)
    | ("&" ~ (^"B") ~ ASCII_BIN_DIGIT ~ (ASCII_BIN_DIGIT | "_")*)
    | (ASCII_DIGIT ~ (ASCII_DIGIT | "_")* ~ ("." ~ ASCII_DIGIT ~ (ASCII_DIGIT | "_")*)? ~ ((^"E") ~ ("+" | "-")? ~ ASCII_DIGIT ~ (ASCII_DIGIT | "_")*)?))
    ~ (^"US" | ^"UI" | ^"UL" | ^"F" | ^"D" | ^"L" | ^"R" | ^"S" | ^"I" | "!" | "#" | "@" | "%" | "&")?
}
boolean_literal = { ^"True" | ^"False" }

// Types: support dotted type names like System.Windows.Forms.Form
type_name = {
    tuple_type
    |
    (
        (^"Integer" | ^"Long" | ^"Single" | ^"Double" | ^"String" | ^"Boolean" | ^"Variant" | ^"Object")
        ~ !(ASCII_ALPHANUMERIC | "_")
        | identifier
        | dotted_identifier
    ) ~ fixed_length_suffix? ~ (generic_suffix | array_type_suffix)? ~ ("." ~ member_identifier ~ (generic_suffix | array_type_suffix)?)* ~ "*"* ~ "?"?
}

tuple_type = { "(" ~ tuple_type_element ~ ("," ~ tuple_type_element)+ ~ ")" }
tuple_type_element = { (identifier ~ ^"As")? ~ type_name }
fixed_length_suffix = { "*" ~ numeric_literal }
array_type_suffix = { "(" ~ ","* ~ ")" }
generic_suffix = { "(" ~ ^"Of" ~ generic_param ~ ("," ~ generic_param)* ~ ")" }
generic_param = { (^"In" | ^"Out")? ~ type_name ~ (^"As" ~ generic_constraint)? }
generic_constraint = { "{" ~ generic_constraint_item ~ ("," ~ generic_constraint_item)* ~ "}" | generic_constraint_item }
generic_constraint_item = { ^"Class" | ^"Structure" | ^"New" | type_name }

// Identifiers
identifier = @{ "[" ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* ~ "]" | !keyword ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
// Member identifier: allows keywords like Next, Close, Open, etc. as method/property names after a dot
// The bracketed form is VB's ESCAPED IDENTIFIER: `[Error]` names a member
// called `Error` even though `Error` is a keyword, and real VB REQUIRES the
// brackets there (`Public Enum L : Error = 3` does not compile). `identifier`
// above already carries the same alternative; this rule did not, so an escaped
// name was a parse error in every member position — enum members, `.Member`
// access, sub/function names.
//
// Purely additive: the rule is atomic and the plain alternative still starts at
// `ASCII_ALPHA | "_"`, so any source that parses today parses identically. The
// walker strips the brackets with `normalize_vb_identifier`, which already
// existed for `identifier`.
member_identifier = @{ "[" ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* ~ "]" | (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

// Keywords
keyword = _{
    (^"Me" | ^"If" | ^"Then" | ^"Else" | ^"End" | ^"Sub" | ^"Function" | ^"Dim" | ^"ReDim" | ^"Preserve" | ^"Const" | ^"As" | ^"For" | ^"To" | ^"Step" | ^"Next" | ^"While" | ^"Wend" | ^"Do" | ^"Loop" | ^"Until" | ^"Exit" | ^"Return" | ^"Yield" | ^"Call" | ^"True" | ^"False" | ^"Nothing" | ^"Not" | ^"Or" | ^"And" | ^"Xor" | ^"Eqv" | ^"Imp" | ^"Mod" | ^"Module" | ^"Class" | ^"Private" | ^"Public" | ^"ByVal" | ^"ByRef" | ^"Select" | ^"Case" | ^"Try" | ^"Catch" | ^"Finally" | ^"Continue" | ^"New" | ^"When" | ^"Partial" | ^"Friend" | ^"Protected" | ^"Overrides" | ^"Overloads" | ^"Shared" | ^"Iterator" | ^"WithEvents" | ^"Handles" | ^"Imports" | ^"Is" | ^"IsNot" | ^"AndAlso" | ^"OrElse" | ^"Optional" | ^"ParamArray" | ^"MyBase" | ^"MustOverride" | ^"Overridable" | ^"NotOverridable" | ^"With" | ^"Each" | ^"In" | ^"Enum" | ^"Open" | ^"Close" | ^"Input" | ^"Write" | ^"Append" | ^"Binary" | ^"Random" | ^"RaiseEvent" | ^"TypeOf" | ^"Throw" | ^"AddHandler" | ^"RemoveHandler" | ^"GoTo" | ^"Static" | ^"Interface" | ^"Structure" | ^"Delegate" | ^"Event" | ^"Resume" | ^"Namespace" | ^"Using" | ^"SyncLock" | ^"Compare")
    ~ !(ASCII_ALPHANUMERIC | "_")
}

call_keyword = @{ ^"Call" ~ !(ASCII_ALPHANUMERIC | "_") }

// ── LINQ Query Syntax ──
query_expression = { from_clause ~ NEWLINE* ~ query_body }
from_clause = { ^"From" ~ identifier ~ (^"As" ~ type_name)? ~ ^"In" ~ expression ~ ("," ~ identifier ~ (^"As" ~ type_name)? ~ ^"In" ~ expression)* }
query_body = { (query_operator ~ NEWLINE*)* ~ select_or_group_clause? }
query_operator = { group_join_query_clause | join_query_clause | where_clause | order_by_clause | skip_while_clause | take_while_clause | skip_clause | take_clause | distinct_clause | let_clause | group_by_query_clause }

where_clause = { ^"Where" ~ expression }
order_by_clause = { ^"Order" ~ ^"By" ~ ordering ~ ("," ~ ordering)* }
ordering = { expression ~ (^"Ascending" | ^"Descending")? }
skip_while_clause = { ^"Skip" ~ ^"While" ~ expression }
take_while_clause = { ^"Take" ~ ^"While" ~ expression }
skip_clause = { ^"Skip" ~ expression }
take_clause = { ^"Take" ~ expression }
distinct_clause = { ^"Distinct" }
let_clause = { ^"Let" ~ let_binding ~ ("," ~ let_binding)* }
let_binding = { identifier ~ "=" ~ expression }
group_by_query_clause = { ^"Group" ~ ^"By" ~ group_key ~ ("," ~ group_key)* ~ ^"Into" ~ identifier }
group_key = { (identifier ~ "=")? ~ expression }
join_query_clause = { ^"Join" ~ (!NEWLINE ~ ANY)* }
group_join_query_clause = { ^"Group" ~ ^"Join" ~ (!NEWLINE ~ ANY)* }

select_or_group_clause = { select_clause | group_clause }
select_clause = { ^"Select" ~ expression ~ ("," ~ expression)* }
group_clause = { ^"Group" ~ (expression ~ ("," ~ expression)*)? ~ ^"By" ~ expression ~ (^"Into" ~ expression)? }

// ── XML Literals ──
xml_literal = { xml_document | xml_element }
xml_document = { xml_declaration? ~ xml_element }
xml_declaration = { "<?xml" ~ xml_attribute* ~ "?>" }

xml_element = {
    "<" ~ xml_name ~ xml_attribute* ~ "/>"
    | "<" ~ xml_name ~ xml_attribute* ~ ">" ~ xml_content* ~ "</" ~ xml_name ~ ">"
}

xml_name = @{ (ASCII_ALPHA | "_" | ":") ~ (ASCII_ALPHANUMERIC | "_" | ":" | "-" | ".")* }
xml_attribute = { xml_name ~ "=" ~ (string_literal | xml_embedded_expression) }
xml_content = {
    xml_element
    | xml_comment
    | xml_cdata
    | xml_embedded_expression
    | xml_text
}

xml_text = @{ (!("<" | "<%=") ~ ANY)+ }
xml_comment = { "<!--" ~ (!"-->" ~ ANY)* ~ "-->" }
xml_cdata = { "<![CDATA[" ~ (!"]]>" ~ ANY)* ~ "]]>" }
xml_embedded_expression = { "<%=" ~ expression ~ "%>" }

// ── Threading / SyncLock ──
synclock_statement = {
    ^"SyncLock" ~ expression ~ (NEWLINE | EOI)
    ~ (!synclock_end ~ line)*
    ~ synclock_end
}
synclock_end = { ^"End" ~ ^"SyncLock" }

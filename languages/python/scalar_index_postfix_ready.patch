+    // certifies one lexical scalar, so construct exactly that context-neutral
+    // operand from its consumed span; scope normalization remains deferred.
+    let Some(source)=ast.source else {return;};
+    let operand=&source[op.start+1..op.end-1];
+    let text=operand.trim();

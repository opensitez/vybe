+        "True"=>Rule::true_kw,"False"=>Rule::false_kw,"None"=>Rule::none_kw,
+        _ if text.as_bytes().first().is_some_and(u8::is_ascii_digit)=>Rule::numeric_literal,
+        _=>Rule::identifier,

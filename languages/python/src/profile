# Python Compiler Profile
# ────────────────────────
# Port of vybe_compiler_python builtins, value methods, module aliases.

[info]
name = "python"
extensions = ["py", "pyw"]

[compiler]
function_return = "explicit"
self_keyword = "self"
constructor_name = "__init__"
# namespaceplan.md: namespace-shaped entry points resolve through the
# common resolver (compiler::resolver) — completes the Phase 2 opt-in
# (imports already bind through ESM+CM at link time).
uses_common_resolver = true
enum_as_ordinals = false
case_sensitive = true
string_indexing = "zero_based"
# `a[::0]` raises `ValueError: slice step cannot be zero` (CPython). The
# shared slices emitter (vybe_emitter::slices) reads this property.
slice_step_zero_raises = true
# `(1, 2, 3)` is a tuple, not a list: array-backed but tagged so
# repr/type()/slicing distinguish it. Read by the shared tuple lowering.
tuple_literals_tagged = true
base_keyword = "super"
dynamic_add = true
# Route bracket reads/writes (`d['k']`, `d['k'] = v`) through the dynamic
# collection-key path (string keys → struct_get/set, numeric → array_get/set)
# instead of the numeric-only ARRAY_GET path. Without this, `d['a']` coerces
# the string key to f64 and traps. Same flag JS uses.
dynamic_member_access = true
materialize_bool_results = true
class_introspection_metadata = true
class_multiple_inheritance = true
# NOTE: Python's `a[-1]` (offset-from-end) is NOT handled by the shared
# `negative_index_wraps` compiler flag — that flag blindly emits `key < 0`
# on every subscript and traps on string dict keys (`d['a']`). Instead the
# Python walker normalizes from-end offsets (see `python_index_operand`),
# the same way C# rewrites `arr[^N]`. Keeping this a walker concern leaves
# the shared compiler generic and lets dict string keys pass through.
# Route `return a, b` / `a, b = f()` through WASM multi-value — a
# uniform-tuple-return function gets chunk.result_arity = N set and
# callers destructure straight off the stack instead of materialising
# a heap tuple. See compiler/mod.rs `collect_multi_return_functions`.
multi_value_tuple_returns = true
# Route `class` declarations through common::classes::normalize_class
# + emit_class (see classnormalization.md). Walker-level normalisation
# of Python's dunder methods to canonical cross-language names.
uses_normalize_class = true

# ────────────────────────────────────────────────────────────────────────────
# BUILTINS — bare global function calls
# ────────────────────────────────────────────────────────────────────────────

[builtins]

# ── Internal operators (emitter adapters) ────────────────────────────────────
__pyadd__       = { emit = "common:python.pyadd",            min_args = 2, max_args = 2 }
__pyneg__       = { emit = "common:python.pyneg",            min_args = 1, max_args = 1 }
__pylt__        = { emit = "common:python.pylt",             min_args = 2, max_args = 2 }
__pygt__        = { emit = "common:python.pygt",             min_args = 2, max_args = 2 }
__pyle__        = { emit = "common:python.pyle",             min_args = 2, max_args = 2 }
__pyge__        = { emit = "common:python.pyge",             min_args = 2, max_args = 2 }
__pymul__       = { emit = "common:python.pymul",            min_args = 2, max_args = 2 }
__pysub__       = { emit = "common:python.pysub",            min_args = 2, max_args = 2 }
__pytruediv__   = { emit = "common:python.pytruediv",        min_args = 2, max_args = 2 }
__pyfloordiv__  = { emit = "common:python.pyfloordiv",       min_args = 2, max_args = 2 }
__pymod__       = { emit = "common:python.pymod",            min_args = 2, max_args = 2 }
__pypow__       = { emit = "common:python.pypow",            min_args = 2, max_args = 2 }
__py_obj_entries__     = { emit = "host:ecma:object:entries",    min_args = 1, max_args = 1 }
__py_map_from_entries__ = { emit = "host:ecma:map:fromEntries",  min_args = 1, max_args = 1 }
# `eval`/`exec` → universal compiler-as-a-service. The walker injects the
# language ("python") + mode; trailing args are globals/locals namespace dicts.
__vybe_eval     = { emit = "host:vybe:eval:eval",            min_args = 3, max_args = 5 }
# From-end offset normalization for subscripts (`a[-1]` → `a[len-1]`), applied
# by the walker's `python_index_operand`. Safe for dict keys (only wraps
# negative numbers on sequences).
__py_from_end__ = { emit = "common:python.from_end",         min_args = 2, max_args = 2 }
# Python float display (`4.0`, not `4`). Applied by the walker only to values
# statically known to be floats — see `expr_is_python_float`.
__py_float_repr__ = { emit = "common:python.float_repr",     min_args = 1, max_args = 1 }
# Polymorphic membership (`x in y`): string substring / array element / dict key.
# Set literals are normalized to `.has()` upstream; this covers the rest and
# routes around the buggy shared `BinOp::In` array-classification for objects.
__py_contains__ = { emit = "common:python.contains",         min_args = 2, max_args = 2 }
# bytes constructor — build a real Uint8Array (ObjectKind::TypedArray) from an
# array of octets. The VM indexes/iterates it natively; display is detected at
# runtime via arraybuffer.isView. `.encode()` and `bytes(...)` route here too.
__py_bytes_new__ = { emit = "host:ecma:uint8array:new",       min_args = 1, max_args = 1 }
# bytes.hex() → lowercase hex string; bytes.fromhex(s) → bytes.
__py_bytes_hex__    = { emit = "host:ecma:uint8array:toHex",   min_args = 1, max_args = 1 }
__py_bytes_fromhex__ = { emit = "host:ecma:uint8array:fromHex", min_args = 1, max_args = 1 }


# ESM DEFAULTS — Python namespace objects → host modules, ECMA-262 §16.2 shape
# ────────────────────────────────────────────────────────────────────────────

# Component-Model package roots (namespaceplan.md Phase 1): literal host
# prefix chains (`vybe.gui.setProperty(...)`, `wasi.cli.log(...)`) resolve
# through the common resolver's package-root step — the same data the
# hardcoded `vybe|wasi|wasm` prefix arm used to embody in code.

[[esm_default]]
kind = "package-root"
prefix = "vybe"
module_root = "vybe:"

[[esm_default]]
kind = "package-root"
prefix = "wasi"
module_root = "wasi:"

[[esm_default]]
kind = "package-root"
prefix = "wasm"
module_root = "wasm:"

[[esm_default]]
kind = "namespace"
alias = "math"
module = "ecma:math"

[[esm_default]]
kind = "namespace"
alias = "os"
module = "wasi:filesystem"

[[esm_default]]
kind = "namespace"
alias = "sys"
module = "wasi:cli"

[[esm_default]]
kind = "namespace"
alias = "json"
module = "ecma:json"

# json module export surface (namespaceplan.md mount-with-rename): Python's
# names differ from the canonical ECMA export names, so `from json import
# dumps` binds `dumps` → ecma:json.stringify through the standard ESM
# Named-import path.

[[esm_default]]
kind = "module-export"
module = "json"
name = "dumps"
target_module = "ecma:json"
target_name = "stringify"

[[esm_default]]
kind = "module-export"
module = "json"
name = "loads"
target_module = "ecma:json"
target_name = "parse"

# Python `re` module → `ecma:regexp` (the spec-aligned ECMA-262 §22
# RegExp surface). Pattern-first language idioms (`re.search(pat, s)`)
# are bridged via stdlib adapter chunks; `re` namespace itself just
# routes identifier lookup to `ecma:regexp`.
[[esm_default]]
kind = "namespace"
alias = "re"
module = "ecma:regexp"

[[esm_default]]
kind = "namespace"
alias = "random"
module = "ecma:math"

[[esm_default]]
kind = "namespace"
alias = "time"
module = "wasi:clocks/wall-clock"

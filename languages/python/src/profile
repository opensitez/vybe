# `slot = "to_string"` says `str()` fills the shared `ToString` slot, so when
# the argument's built-in type is statically a float the emit is rewritten to
# `[builtin_slots.double] to_string` below and `str(0.0)` answers "0.0" rather
# than ECMA `String()`'s "0". Any other argument type keeps `python.str`.
str             = { emit = "common:python.str",              min_args = 0, max_args = 1, slot = "to_string" }
bool            = { emit = "common:dyn_to_bool",            min_args = 1, max_args = 1 }
chr             = { emit = "common:str_from_char_code",     min_args = 1, max_args = 1 }
# `ord` is a CODE POINT, not a UTF-16 unit: `ord("\U0001F600")` is 128512,

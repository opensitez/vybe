# ── enum ────────────────────────────────────────────────────────────────────
# `auto()` never reaches runtime: it is resolved against the members declared
# before it while the class body is still a class body (`resolve_enum_auto` in
# the walker), which is the only place that information exists.
# `@unique` validates that no two members share a value and returns the class
# unchanged — with distinct values, which is the only shape the compiler can
# see, that IS the identity.
"enum.unique" = { emit = "common:python.first_arg", min_args = 1, max_args = 1 }


# ────────────────────────────────────────────────────────────────────────────
# ESM DEFAULTS — Python namespace objects → host modules, ECMA-262 §16.2 shape
# ────────────────────────────────────────────────────────────────────────────

# Component-Model package roots (namespaceplan.md Phase 1): literal host
# prefix chains (`vybe.gui.setProperty(...)`, `wasi.cli.log(...)`) resolve
# through the common resolver's package-root step — the same data the
# hardcoded `vybe|wasi|wasm` prefix arm used to embody in code.

[[esm_default]]
kind = "package-root"
prefix = "vybe"
module_root = "vybe:"

[[esm_default]]
kind = "package-root"
prefix = "wasi"
module_root = "wasi:"

[[esm_default]]
kind = "package-root"
prefix = "wasm"
module_root = "wasm:"

# `math` → `ecma:math`. This binds every name ECMA spells the same way
# (`hypot`, `atan2`, `log2`, …) with no per-name row. Names where the
# spellings differ (`pi` vs `PI`) or that are profile builtins (`sqrt` →
# `opcode:f64_sqrt`) are handled earlier, at walk time, by the named-import
# rewrite in the walker — so both mechanisms cover their own half.
[[esm_default]]
kind = "namespace"
alias = "math"
module = "ecma:math"

[[esm_default]]
kind = "namespace"
alias = "os"
module = "wasi:filesystem"

[[esm_default]]
kind = "namespace"
alias = "sys"
module = "wasi:cli"

[[esm_default]]
kind = "namespace"
alias = "json"
module = "ecma:json"

# mount-with-rename (namespaceplan.md §"Source-name ≠ canonical-name"): Python
# spells these differently from the ECMA exports a named import would otherwise
# look for. NOTE these bind the RAW ecma fn, so `from json import dumps` does
# not get the Map-aware adapter the dotted form uses — see
# `project_python_file_io_and_os` memory. Removing them unbinds the name
# entirely (the tree is not consulted for named imports yet), which is worse.
[[esm_default]]
kind = "module-export"
module = "json"
name = "dumps"
target_module = "ecma:json"
target_name = "stringify"

[[esm_default]]
kind = "module-export"
module = "json"
name = "loads"
target_module = "ecma:json"
target_name = "parse"

# json module export surface (namespaceplan.md mount-with-rename): Python's
# names differ from the canonical ECMA export names, so `from json import
# dumps` binds `dumps` → ecma:json.stringify through the standard ESM
# Named-import path.

# Python `re` module → `ecma:regexp` (the spec-aligned ECMA-262 §22
# RegExp surface). Pattern-first language idioms (`re.search(pat, s)`)
# are bridged via stdlib adapter chunks; `re` namespace itself just
# routes identifier lookup to `ecma:regexp`.
[[esm_default]]
kind = "namespace"
alias = "re"
module = "ecma:regexp"

[[esm_default]]
kind = "namespace"
alias = "random"
module = "ecma:math"

[[esm_default]]
kind = "namespace"
alias = "time"
module = "wasi:clocks/wall-clock"

# Return types of string-producing builtins, so the type-directed `+` path
# treats `'lit' + str(self.attr)` as string concatenation (not numeric add).
[builtin_return_types]
str = "str"
repr = "str"
# `float(x)` IS a float — without this the call has no type and `str(float(3))`
# could not reach `[builtin_slots.double] to_string`, printing "3" for "3.0".
float = "float"
__py_float_repr__ = "str"
chr = "str"
hex = "str"
oct = "str"
bin = "str"
input = "str"
format = "str"

# ── builtinslotplan.md step 4 ────────────────────────────────────────────
# Python's own spellings for the built-in types. Step 3's census measured
# `def f(s: str)` producing the hint `str`, which reached the platform's
# shared classifiers and failed them — so an annotated Python program
# resolved no receiver at all. The fix is Python declaring `str`, not `str`
# being appended to a shared list.
#
# `*` marks where a spelling need not match: `list[*` is a prefix.
[builtin_types]
string = ["str"]
int    = ["int"]
double = ["float"]
bool   = ["bool"]
bytes  = ["bytes", "bytearray"]
array  = ["list", "list[*", "tuple", "tuple[*"]
map    = ["dict", "dict[*"]
set    = ["set", "set[*", "frozenset"]

# ── Protocol slot bindings — builtinslotplan.md §2a/§2c ────────────────────
#
# `x in y`. Python cannot resolve `y`'s type at compile time in idiomatic code
# (§3b measured this), so the shared emitter probes `y` at RUN time and
# dispatches to whichever of these three applies. The shared compiler used to
# hold Python's three answers itself, behind `is_python_profile()`.
#
# The dict/object leg is deliberately `hasIn` and not the platform default
# `common:dict.has`: `in` on a Python object must see inherited members, so it
# walks the prototype chain. Sets land here too and `hasIn` answers correctly
# for them.
[builtin_slots.string]
contains = "host:ecma:string:includes"
# Python counts CODE POINTS: `len("😀")` is 1 and `len("a😀b")` is 3, where the
# platform default (`host:ecma:string:length`) counts UTF-16 units and answers
# 2 and 4. `unifiedstringplan.md` Axis 1 names this unit `scalar`, and python is
# the only language on it.
#
# This is the unit as a DECLARED VALUE rather than a parameter threaded through
# the emitters — `unifiedstringplan.md` §3a — and it is what
# `builtinslotplan.md` §3i recorded as blocked on a code-point-length host
# function. No host function was needed: `common:str_scalar_length` counts with
# the string iterator, which already yields code points.
len = "common:str_scalar_length"

[builtin_slots.array]
contains = "common:collections.contains"
# `==` on two sets is order-independent, and on tuples/lists it is deep. This
# is the fallback the shared `==` uses when neither operand has a user
# `__eq__`; it was `LanguageHooks::value_eq`, keyed by language NAME.
eq = "common:python.value_eq"

[builtin_slots.map]
contains = "host:ecma:object:hasIn"

# `%` is FLOORED: the result takes the divisor's sign, so `-7 % 3` is 2 and
# `7 % -3` is -2. The platform default truncates (C, JS), so a language whose
# `%` floors declares it. Was `is_python_profile()` in the shared `BinOp::Mod`
# arm.
[builtin_slots.int]
mod = "common:math.floor_mod"

# A Python float ALWAYS displays with a fractional part — `str(4.0)` is "4.0"
# and `repr(-0.0)` is "-0.0" — where ECMA `String()` answers "4" and "0". That
# is a property of the TYPE, so declaring it once here covers every rendering
# site (`str()`, `repr()`, f-strings, `+` on a str) instead of the walker
# wrapping each expression it happens to know is a float.
[builtin_slots.double]
to_string = "common:python.float_repr"

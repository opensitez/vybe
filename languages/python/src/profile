# Python Compiler Profile
# ────────────────────────
# Port of vybe_compiler_python builtins, value methods, module aliases.

[info]
name = "python"
extensions = ["py", "pyw"]

[compiler]
# PEP 484: an annotation is DESCRIPTIVE, never coercive. `x: int = 3.7` keeps
# 3.7 and `def f(x: int)` called with 3.7 receives 3.7 — verified against
# python3. This was inheriting the platform default of `true`, so annotated
# declarations were being narrowed (`x: int = 3.7` gave 3). No language ever
# declared that default; it applied by omission.
coerces_value_to_type_hint = false
# NameError on an unresolvable read is NOT enabled yet: `resolvable` in
# bindings.rs consults only this file's own declarations, never the common
# resolver, so host builtins look undeclared. Enabling it cost 47 tests with the
# strict-mode carve-out removed and 1 with it kept. The error type/message are
# already profile-driven and ready:
#   unresolved_reference_throws = true
#   unresolved_reference_error = "NameError"
#   unresolved_reference_message = "name '{}' is not defined"
# Global namespace spelling — see crates/vybe_compiler/src/primitives/globals.rs
global_namespace = "globals"
global_namespace_is_call = true
# `|`/`&`/`-`/`^` on sets are set algebra (Pascal spells the same algebra
# `+`/`*`/`-`, declared as set_arithmetic_operators).
set_bitwise_operators = true
# Empty collections, "" and 0 are falsy; `__bool__`/`__len__` override.
truthiness_via_dunder_or_length = true
# `gen.send(v)` / `gen.throw(e)` / `gen.close()`.
generator_send_throw_close = true
# `a[i:j] = v` and `del a[i:j]` splice the sequence.
slice_assignment_splices = true
# Python `__call__` — an object is callable, so a call site probes the Call slot.
callable_objects = true
function_return = "explicit"
self_keyword = "self"
constructor_name = "__init__"
# namespaceplan.md: namespace-shaped entry points resolve through the
# common resolver (compiler::resolver) — completes the Phase 2 opt-in
# (imports already bind through ESM+CM at link time).
uses_common_resolver = true
enum_as_ordinals = false
case_sensitive = true
string_indexing = "zero_based"
# `a[::0]` raises `ValueError: slice step cannot be zero` (CPython). The
# shared slices emitter (vybe_emitter::slices) reads this property.
slice_step_zero_raises = true
# `(1, 2, 3)` is a tuple, not a list: array-backed but tagged so
# repr/type()/slicing distinguish it. Read by the shared tuple lowering.
tuple_literals_tagged = true
base_keyword = "super"
dynamic_add = true
# Route bracket reads/writes (`d['k']`, `d['k'] = v`) through the dynamic
# collection-key path (string keys → struct_get/set, numeric → array_get/set)
# instead of the numeric-only ARRAY_GET path. Without this, `d['a']` coerces
# the string key to f64 and traps. Same flag JS uses.
dynamic_member_access = true
materialize_bool_results = true
# `for k in dict` iterates KEYS (a dict is the same Map/Ordinary type as a JS
# object; iterating an object yields its keys). Sequences still yield values.
for_in_object_yields_keys = true
# NOTE: dict literals are no longer a profile flag. `{k: v}` is `ExprKind::Map`
# in the AST — the walker declares it, so int/tuple keys keeping their type is a
# property of the NODE, not of "this file happens to be python".
class_introspection_metadata = true
class_multiple_inheritance = true
# NOTE: Python's `a[-1]` (offset-from-end) is NOT handled by the shared
# `negative_index_wraps` compiler flag — that flag blindly emits `key < 0`
# on every subscript and traps on string dict keys (`d['a']`). Instead the
# Python walker normalizes from-end offsets (see `python_index_operand`),
# the same way C# rewrites `arr[^N]`. Keeping this a walker concern leaves
# the shared compiler generic and lets dict string keys pass through.
# Route `return a, b` / `a, b = f()` through WASM multi-value — a
# uniform-tuple-return function gets chunk.result_arity = N set and
# callers destructure straight off the stack instead of materialising
# a heap tuple. See primitives/mod.rs `collect_multi_return_functions`.
multi_value_tuple_returns = true
# Reading a method off an instance yields a fresh bound-method object (distinct
# per instance, own receiver) — CPython descriptor semantics: `C().f is C().f`
# is False. General object-model behavior gated on this property (JS/C#/Java
# bind at call and leave it false).
methods_bind_on_access = true
# Default argument expressions evaluate ONCE at definition time and the same
# object is reused on every call that omits the arg (the mutable-default
# "trap": `def f(a=[]); f() is f()` is True). General semantic gated on this
# property (JS/C# re-evaluate the default per call and leave it false).
default_args_evaluated_once = true
# Route `class` declarations through common::classes::normalize_class
# + emit_class (see classnormalization.md). Walker-level normalisation
# of Python's dunder methods to canonical cross-language names.
uses_normalize_class = true


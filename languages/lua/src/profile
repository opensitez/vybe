# Lua over ECMA/WASM — walker emits JS-shaped AST; compiler lowers via the
# same profile emits / host imports as JavaScript (Lua is JS with different names).
#
# Dotted names MUST be quoted — bare `string.len` is TOML nested-table syntax.

[info]
name = "lua"
extensions = ["lua"]

[compiler]
function_return = "explicit"
self_keyword = "self"
constructor_name = "constructor"
# namespaceplan.md: namespace-shaped entry points resolve through the
# common resolver — same flip as JS/PHP/dotnet/dart/java/python/ruby.
uses_common_resolver = true
case_sensitive = true
string_indexing = "zero_based"
array_indexing = "one_based"
lexical_block_scope = true
materialize_bool_results = true
coerces_value_to_type_hint = false
ambient_this_binding = false
dynamic_add = true
concat_stringifies_operands = true  # `..` stringifies both sides (numbers, booleans, …)
dynamic_numeric_dispatch = true
allow_trailing_comma = true
supports_spread_arguments = true
for_loop_per_iteration_binding = true
multi_value_tuple_returns = true
uses_normalize_class = true


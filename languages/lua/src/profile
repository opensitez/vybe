# ── string library — same emits as JS String / String.prototype ─────────────
# string.len(s)     ↔ s.length          (str_length → wasm:js-string:length)
# string.upper(s)   ↔ s.toUpperCase()   (opcode:str_to_upper)
# string.lower(s)   ↔ s.toLowerCase()   (opcode:str_to_lower)
# string.sub(s,…)   ↔ s.substring(…)    (opcode:str_substring)
# string.rep(s,n)   ↔ s.repeat(n)       (opcode:str_repeat)
# string.reverse(s) ↔ (str_reverse opcode)
# string.char(…)    ↔ String.fromCharCode(…)
# string.byte(s,i)  ↔ s.charCodeAt(i)   (opcode:str_char_code_at)
# string.find(…)    ↔ s.indexOf(…)      (opcode:str_index_of)
# string.gsub(…)    ↔ s.replaceAll(…)   (common:strings.replace → replaceAll)
# string.match(…)   ↔ s.match(…)        (host:ecma:regexp:match)
# string.format(…)  ↔ (sprintf — no JS twin)

"string.len" = { emit = "str_length", min_args = 1, max_args = 1 }
"string.upper" = { emit = "common:str_to_upper", min_args = 1, max_args = 1 }

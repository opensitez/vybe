# List/Iterable property-style accessors (zero-arg getters).
first         = { emit = "common:dart.list_first",     min_args = 0, max_args = 0 }
containsKey   = { emit = "host:ecma:object:has",       min_args = 1, max_args = 1 }
containsValue = { emit = "host:ecma:object:hasOwn",    min_args = 1, max_args = 1 }
keys          = { emit = "host:ecma:object:keys",      min_args = 0, max_args = 0 }
last          = { emit = "common:dart.list_last",      min_args = 0, max_args = 0 }
length        = { emit = "common:dart.length",         min_args = 0, max_args = 0 }

# Array/List instance methods
removeLast    = { emit = "common:collections.pop",     min_args = 0, max_args = 0 }
insert        = { emit = "host:ecma:array:splice",     min_args = 2, max_args = 2 }
sublist       = { emit = "host:ecma:array:slice",      min_args = 1, max_args = 2 }
join          = { emit = "common:collections.join",    min_args = 0, max_args = 1 }

module = "ecma:math"

[[esm_default]]
kind = "namespace"
alias = "json"
module = "ecma:json"

[[esm_default]]
kind = "namespace"
alias = "JSON"
module = "ecma:json"

[[esm_default]]
kind = "namespace"
alias = "http"
module = "wasi:http"

[[esm_default]]
kind = "namespace"
alias = "File"
module = "wasi:filesystem"

[[esm_default]]
kind = "namespace"
alias = "Directory"
module = "wasi:filesystem"

[[esm_default]]
kind = "namespace"
alias = "Map"
module = "ecma:map"

[[esm_default]]
kind = "namespace"
alias = "Set"
module = "ecma:set"

# DateTime / StringBuffer / Duration namespace aliases retired —
# these Dart types are constructed via the dotnet wrapper Component
# Model adapter (`new DateTime()` lowers through `datetime_adapter`,
# `new StringBuffer()` through `stringbuilder_adapter`). Method
# dispatch goes through the TypeRegistry vtable; no namespace
# fallback is needed.

# Random is resolved via known_types -> wasi:random/insecure. No namespace
# indirection needed.

[[esm_default]]
kind = "namespace"
alias = "Stopwatch"
module = "wasi:clocks/monotonic-clock"

[[esm_default]]
kind = "namespace"
alias = "RegExp"
module = "ecma:regexp"

# GUI namespace is now shared globally (added by add_shared_gui_namespace)
# instead of per-language duplication.
# Future / Stream / Process namespace aliases retired:
#   Future → JSPI promise (Op::PROMISE_*); no namespace object needed.
#   Stream → `wasi:io/streams` proposal; constructed via stream adapters.
#   Process → `node:child_process` (`spawnSync` / `execSync`); the
#     dotnet wrapper Component Model handles `Process.Start` for typed
#     receivers and lowers through `process_adapter`.

# Dart Isolate spawning compiles to Op::THREAD_SPAWN (WASM threads
# proposal) — no namespace object needed.

# Dart `utf8` / `base64` from `dart:convert` map to WHATWG primitives:
# `utf8` → TextEncoder/TextDecoder (`web:encoding`); `base64` → `btoa`/`atob`
# (also in `web:encoding`). Method dispatch (`utf8.encode` etc.) lowers
# through the dart adapter at compile time.
[[esm_default]]
kind = "namespace"
alias = "utf8"
module = "web:encoding"

[[esm_default]]
kind = "namespace"
alias = "base64"
module = "web:encoding"


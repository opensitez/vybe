lastIndexWhere = { emit = "common:dart.list_last_index_where", min_args = 1, max_args = 1 }
firstWhere    = { emit = "common:dart.list_first_where", min_args = 1, max_args = 1 }
lastWhere     = { emit = "common:dart.list_last_where", min_args = 1, max_args = 1 }


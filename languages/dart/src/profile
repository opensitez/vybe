__dart_base64_decode      = { emit = "common:dart.base64_decode",       min_args = 1, max_args = 1 }
__dart_base64_normalize   = { emit = "common:dart.base64_normalize",    min_args = 1, max_args = 1 }
__dart_base64url_encode   = { emit = "common:dart.base64url_encode",    min_args = 1, max_args = 1 }
__dart_base64url_decode   = { emit = "common:dart.base64url_decode",    min_args = 1, max_args = 1 }
__dart_base64url_normalize = { emit = "common:dart.base64url_normalize", min_args = 1, max_args = 1 }

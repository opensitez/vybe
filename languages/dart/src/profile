trimLeft      = { emit = "common:str_trim_start",      min_args = 0, max_args = 0 }
trimRight     = { emit = "common:str_trim_end",        min_args = 0, max_args = 0 }
startsWith    = { emit = "host:ecma:string:startsWith", min_args = 1, max_args = 2 }
endsWith      = { emit = "common:str_ends_with",       min_args = 1, max_args = 1 }
contains      = { emit = "common:dart.contains",       min_args = 1, max_args = 1 }

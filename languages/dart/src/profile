[namespaces]

# Namespace-tree roots this language resolves platform types against, and
# mounts ambiently so unqualified names resolve to their `Type` node.
#
# `dart` is this language's OWN root (`tree_register.rs`). It carried only
# function leaves until `dart.core` gained `Type` nodes, so listing it here
# would have found nothing; now it is what makes `StringBuffer()` construct
# through the shared ctor path and `sb.toString()` resolve by receiver type.
type_scopes = ["flutter", "dart"]
roots = []
extra_imports = []

# ── builtinslotplan.md step 4 ────────────────────────────────────────────
# Dart's own spellings. `String` already resolved through the platform
# table; the generic collections did not — step 3's census recorded
# `List<int>` and `Map<String,int>` reaching dispatch unresolved.
#
# `*` marks where a spelling need not match: `list<*` is a prefix, so it
# catches `List<int>` and `List<Map<String,int>>` alike.
[builtin_types]
string = ["string"]
int    = ["int"]
double = ["double", "num"]
bool   = ["bool"]
array  = ["list", "list<*"]
map    = ["map", "map<*"]
set    = ["set", "set<*"]
# NOT declared here: `bigint`. Dart's `BigInt` is a DISTINCT type — `x + 1` on
# one is a compile error, not a widening — and declaring a spelling is also
# declaring that the language's integers widen into each other (Kotlin's
# `Long`). `"bigint"` is already a PLATFORM spelling, so the inference
# classifies it without any language declaration; what Dart needs is for the
# inference to REACH that answer, which `[builtin_return_types]` below does.

# Builtins whose result type is known — the shared inference reads this for a
# free-call callee, and `"bigint"` is its own spelling for an ECMA BigInt.
#
# Every `BigInt` construction normalises onto `__dart_bigint_from` in the
# walker, so this ONE line types `BigInt.from(n)`, `BigInt.zero`, `BigInt.one`
# and `BigInt.two` alike, and `var a = BigInt.from(12)` carries the type to
# every later `a * b`, `a % b`, `a ~/ b` and `-a`.
[builtin_return_types]
__dart_bigint_from = "bigint"

# Dart's OVERRIDES of the platform default slot table — builtinslotplan.md §2a.
#
# The platform binds `map`/`get_item` to `common:dict.get_dynamic`, which
# answers `undefined` for a missing key. Dart's answer is `null`, and the
# difference is observable: `factory_from_json_optional_string_null` reads
# `json['body']` from an empty `Map<String, dynamic>` and requires null.
# Measured 2026-07-31 — binding the default centrally broke exactly that test,
# which is why the pair stayed unbound until a language could override it.
#
# Every language has a different right answer on a MISS (`undefined` in JS,
# `null` here, `KeyError` in Python, `null`+warning in PHP) and they all agree
# on a HIT, so this belongs in the language, not the shared table.
[builtin_slots.map]
get_item = "common:dart.index_get"

# Dart records/tuples compare by VALUE, not identity. This is the fallback the
# shared `==` uses when neither operand has a user `operator ==`; it was
# `LanguageHooks::value_eq`, keyed by language NAME (builtinslotplan.md §3c).
[builtin_slots.array]
eq = "common:dart.value_eq"
# NO `to_string` row here, and that is a MEASURED dead end rather than an
# oversight. `[1, 2, 3].toString()` answers the JS `1,2,3` and a map answers
# `[object Object]`, where dart specifies `[1, 2, 3]` and `{a: 1, b: 2}` —
# and `dart.to_string` already renders both correctly, which is why
# `print(list)` and `"$list"` are right. The call never reaches it: the
# `x.ToString()` probe in the shared `calls.rs` sets its "primitive" flag only
# for typeof `number|i32|i64|string|boolean`, so an array or map (typeof
# `object`) skips the slot branch entirely and falls through to prototype
# dispatch — `ecma:value.invokeMethod(obj, "toString")`. Declaring the row here
# changes nothing while that branch is unreachable for these types, so it is
# left undeclared rather than sitting inert. Fixing it means teaching that
# probe to honour a STATICALLY known builtin type, which is a shared-compiler
# change.

# How ONE interpolated part becomes a string. Measured against real `dart`:
# `"${[1, 2]}"` is `[1, 2]`, where the shared ECMA coercion gives the JS
# `1,2`. `print([1, 2])` already rendered correctly via `dart.to_string` — the
# same renderer, which interpolation simply never consulted.
[builtin_slots.string]
to_string = "common:dart.to_string"

[builtin_slots.bool]
to_string = "common:dart.to_string"

# A Dart `double` ALWAYS shows a fractional part — `5.toDouble()` prints `5.0`
# and `(-0.0)` prints `-0.0` — where the general renderer above (and ECMA
# `String()`) answer `5` and `0`. That is a property of the TYPE, so the more
# specific row wins wherever the expression is statically a double, and every
# rendering site gets it from this one declaration instead of the walker
# wrapping each expression it happens to recognise.
[builtin_slots.double]
to_string = "common:dart.double_to_string"

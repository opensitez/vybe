# Dart Compiler Profile
# ─────────────────────
# Covers dart:core, dart:math, dart:io, dart:convert, dart:async.
# Collection HOF methods (map, where, forEach, reduce) go through
# [array_methods] for proper compiler_common loop emission.

[info]
name = "dart"
extensions = ["dart"]

[compiler]
# Declared types CONVERT the value they bind (assignment, declaration and
# parameter entry alike). Stated explicitly rather than inherited: the platform
# default is `true`, and inheriting it silently gave Python coercive semantics
# it never chose.
coerces_value_to_type_hint = true
function_return = "explicit"
self_keyword = "this"
base_keyword = "super"
constructor_name = "__init__"    # Dart unnamed constructors handled by walker
enum_as_ordinals = false
case_sensitive = true
string_indexing = "zero_based"
# Route `class` declarations through common::classes::normalize_class
# + emit_class (see classnormalization.md).
uses_normalize_class = true
# Dart instance calls use the same receiver semantics as ECMAScript classes:
# `this` is supplied by member-call dispatch rather than as a source-visible
# positional parameter. Reuse the common prototype emitter path used by JS.
class_method_dispatch = "prototype"
# NOT `ecma_new_dispatch`. Tried and MEASURED 2026-08-09: declaring it changed
# neither the ctor-in-a-method aliasing nor the static-field aliasing, so the
# missing `[[Construct]]` protocol is not what makes a dart constructor reuse
# the ambient receiver. The selection at `expressions.rs:4361` is — a `New`
# emit prefers the RAW `<Class>$arityN` global whenever it is already in
# `defined_globals` and the bare `<Class>` arity DISPATCHER otherwise, and only
# the dispatcher allocates. Inside the class's own method the `$arityN` global
# is always defined.
# namespaceplan.md: namespace-shaped entry points resolve through the
# common resolver (compiler::resolver) instead of the legacy hardcoded
# arms — same flip as JS/VB/C#/PHP/C, driven by the esm_default data below.
uses_common_resolver = true
entry_point = "main"
# Dart `+` on strings concatenates (per dart:core String.+).
dynamic_add = true
# Dart operator overloads are method dispatch (`operator +`, `operator ==`,
# etc.), not ECMA ToPrimitive coercion. This puts Dart on the same shared rich
# operator machinery as Python/C# while preserving `dynamic_add` as the
# primitive/string fallback.
ecma_operator_coercion = false
# Dart `bool` is a real boolean (like C#), not a C-style int: comparison and
# equality results print as `true`/`false`. Materialize them so `print(a == b)`
# / `print(x < y)` render correctly instead of `1`/`0`.
materialize_bool_results = true
# Dart records `(1, 2)` / `(x: 1, y: 2)` are a first-class type distinct from
# List: array-backed but tagged so `.$1` positional + `.name` by-name access,
# repr `(1, 2)`, and structural `==` behave as records, not lists. Same shared
# lowering (vybe_emitter::tuples) as Python tuples / C# ValueTuple.
tuple_literals_tagged = true
# `sync*` / `async*` markers make generators statically detectable — route
# them through the lazy spec-generator machinery (like JS/PHP) instead of
# the eager run-to-completion fallback, so `for (v in gen())` with `break`
# and infinite generators suspend per yield.
has_generators = true
ecma_promise_methods = true
throwable_is_root = true
# Dart `obj(args)` dispatches through an instance `call` method. The class
# normalizer binds that spelling to `ProtocolSlot::Call`; this property enables
# the shared call-site probe for object callees, the same concept path used by
# Python `__call__`, PHP `__invoke`, and Kotlin `operator fun invoke`.
callable_objects = true

# ────────────────────────────────────────────────────────────────────────────
# BUILTINS — bare global function calls
# ────────────────────────────────────────────────────────────────────────────

[builtins]

# `identical(a, b)` is Dart's reference equality, materialized as Dart bool.
identical           = { emit = "common:dart.identical",          min_args = 2, max_args = 2 }
# `Isolate.spawn`'s engine — the same row go spells `__go_spawn`: the wrapped
# entry closure runs on a `wasi:threads.thread-spawn` thread and answers a
# Task handle, which the walker hands to the `Isolate` core class's ctor.
__dart_isolate_spawn = { emit = "common:threading.task_run",     min_args = 1, max_args = 1 }
# `Isolate.spawnUri` throws `IsolateSpawnException` — running a second
# program from a URI is unsupported, and the spec failure shape beats a
# silent no-op.
__dart_isolate_spawn_uri = { emit = "common:dart.isolate_spawn_uri", min_args = 0, max_args = 0 }

# ── I/O ──────────────────────────────────────────────────────────────────────

print               = { emit = "common:dart.print",              min_args = 1, max_args = 1 }
# `StringBuffer` is NOT a builtin: it is a `dart.core` TYPE node
# (`tree_register.rs`), so `StringBuffer()` constructs through the shared ctor
# path — which stamps `__type`/`__types` — and its members resolve by RECEIVER
# TYPE. A `[builtins]` entry here would intercept the call first, emit the
# backing struct with no identity, and put the members back on the
# receiver-blind `[value_methods]` table.
RegExp              = { emit = "common:dart.regexp_new",         min_args = 1, max_args = 4 }
Map                 = { emit = "common:dart.map_new",            min_args = 0, max_args = 0 }
SplayTreeMap        = { emit = "common:dart.sorted_map_new",     min_args = 0, max_args = 0 }
Queue               = { emit = "common:dart.stream_empty",       min_args = 0, max_args = 0 }
# `Expando` is NOT a map row: the walker builds `{__type: "Expando", __wm}`
# over the identity-keyed `ecma:weakmap` (a dart map's property keys COERCE,
# so two distinct Objects collided onto one entry).
__dart_expando_wm_new = { emit = "host:ecma:weakmap:new",        min_args = 0, max_args = 0 }
MapEntry            = { emit = "common:dart.map_entry",          min_args = 2, max_args = 2 }
"Map.from"          = { emit = "common:dart.map_from",           min_args = 1, max_args = 1 }
"Map.of"            = { emit = "common:dart.map_from",           min_args = 1, max_args = 1 }
"Map.unmodifiable"  = { emit = "common:dart.map_unmodifiable",   min_args = 1, max_args = 1 }
"__dart_map_unmodifiable_entries" = { emit = "common:dart.map_unmodifiable_entries", min_args = 1, max_args = 1 }
"Map.fromEntries"   = { emit = "common:dart.map_from_entries",   min_args = 1, max_args = 1 }
"Map.fromIterables" = { emit = "common:dart.map_from_iterables", min_args = 2, max_args = 2 }
"Map.identity"      = { emit = "common:dart.map_new",            min_args = 0, max_args = 0 }
"Set.from"          = { emit = "common:dart.set_from",           min_args = 1, max_args = 1 }
# `LinkedHashMap`/`LinkedHashSet` ARE the default Map/Set: the shared map and
# set are insertion-ordered (JS-map semantics), which is exactly the linked
# variants' contract, so the linked spellings alias the plain rows.
LinkedHashMap       = { emit = "common:dart.map_new",            min_args = 0, max_args = 0 }
"LinkedHashMap.from" = { emit = "common:dart.map_from",          min_args = 1, max_args = 1 }
"LinkedHashMap.of"  = { emit = "common:dart.map_from",           min_args = 1, max_args = 1 }
LinkedHashSet       = { emit = "common:dart.set_new",            min_args = 0, max_args = 0 }
"LinkedHashSet.from" = { emit = "common:dart.set_from",          min_args = 1, max_args = 1 }
"LinkedHashSet.of"  = { emit = "common:dart.set_from",           min_args = 1, max_args = 1 }
"Set.of"            = { emit = "common:dart.set_from",           min_args = 1, max_args = 1 }
"Set.unmodifiable"  = { emit = "common:dart.set_unmodifiable",   min_args = 1, max_args = 1 }
"Set.identity"      = { emit = "common:dart.set_new",            min_args = 0, max_args = 0 }
SplayTreeSet        = { emit = "common:dart.set_new",            min_args = 0, max_args = 0 }
"Queue.from"        = { emit = "common:dart.list_from",          min_args = 1, max_args = 1 }
# The twelve exception rows are GONE — six public names and their six
# `__dart_*` walker aliases. `Exception`, `FormatException`, `Error`,
# `StateError`, `ArgumentError`, `RangeError` and `UnimplementedError` are
# `dart:core` CLASSES (`core_classes/exceptions.rs`), so construction takes the
# ordinary `ExprKind::New` path and identity comes from a real rtt plus the
# `__types` chain `compile_class` stamps — not from an anonymous struct with a
# canonicalized `__type` string.
__dart_stack_trace  = { emit = "common:dart.stack_trace",        min_args = 1, max_args = 1 }
# builtinslotplan.md step 5 — `dart.index_get` probes `wasm:js-string.test`
# before every index. A statically-typed receiver skips the probe.
__dart_index_get    = { emit = "common:dart.index_get",          min_args = 2, max_args = 2, slot = "get_item" }
__dart_index_set    = { emit = "common:dart.index_set",          min_args = 3, max_args = 3 }
__dart_set_from     = { emit = "common:dart.set_from",           min_args = 1, max_args = 1 }
__dart_clear        = { emit = "common:dart.clear",              min_args = 1, max_args = 1 }
__dart_lookup       = { emit = "common:dart.lookup",             min_args = 2, max_args = 2 }
__dart_to_string    = { emit = "common:dart.to_string",          min_args = 1, max_args = 1 }
__dart_for_in_iterable = { emit = "common:dart.for_in_iterable", min_args = 1, max_args = 1 }
__dart_eq           = { emit = "common:dart.eq",                 min_args = 2, max_args = 2 }
__dart_is_null      = { emit = "common:dart.is_null",            min_args = 1, max_args = 1 }
__dart_is_empty     = { emit = "common:dart.is_empty",           min_args = 1, max_args = 1 }
__dart_is_not_empty = { emit = "common:dart.is_not_empty",       min_args = 1, max_args = 1 }
__dart_length       = { emit = "common:dart.length",             min_args = 1, max_args = 1 }
__dart_hash_code    = { emit = "common:dart.hash_code",          min_args = 1, max_args = 1 }
__dart_runtime_type = { emit = "common:dart.runtime_type",       min_args = 1, max_args = 1 }
__dart_type_to_string = { emit = "common:dart.type_to_string",   min_args = 1, max_args = 1 }
__dart_is_list_of_int = { emit = "common:dart.is_list_of_int",   min_args = 1, max_args = 1 }
__dart_double_to_string = { emit = "common:dart.double_to_string", min_args = 1, max_args = 1 }
__dart_nullable_double_to_string = { emit = "common:dart.nullable_double_to_string", min_args = 1, max_args = 1 }
# `Duration` is not here: it is a `dart.core` CLASS (`core_classes/duration.rs`), so
# `Duration(...)` is an ordinary construction and its members dispatch on the
# receiver. The wrapper this replaces was an anonymous struct with a `__type`
# STRING, which is why `d1 + d2` had no `+` to find.
# `DateTime` is not here either — it is a CLASS (`core_classes/datetime.rs`).
# `DateTime(y, m, d, …)`, `DateTime.utc(…)` and `DateTime.now()` are all
# rewritten by the walker into a construction of it, so the two Duration shapes
# the note here used to describe are gone: `a.difference(b)` is a method on the
# class and returns a real `Duration`.
#
# The epoch→calendar reads below are BARE host getters — no adapter code. The
# two that are not bare are the two CONVENTIONS: Dart numbers months from 1 and
# weekdays Monday=1, which `vybe_ast::datetime` owns as `MonthIndexing` and
# `WeekdayBase` and `primitives::datetime` applies. Spelling either as
# arithmetic in the class body would be a fourth copy of a rule the AST already
# states.
__dart_date_utc     = { emit = "host:ecma:date:UTC",             min_args = 6, max_args = 6 }
__dart_date_now     = { emit = "host:ecma:date:now",             min_args = 0, max_args = 0 }
__dart_date_year    = { emit = "host:ecma:date:getUTCFullYear",  min_args = 1, max_args = 1 }
__dart_date_day     = { emit = "host:ecma:date:getUTCDate",      min_args = 1, max_args = 1 }
__dart_date_hour    = { emit = "host:ecma:date:getUTCHours",     min_args = 1, max_args = 1 }
__dart_date_minute  = { emit = "host:ecma:date:getUTCMinutes",   min_args = 1, max_args = 1 }
__dart_date_second  = { emit = "host:ecma:date:getUTCSeconds",   min_args = 1, max_args = 1 }
__dart_date_millisecond = { emit = "host:ecma:date:getUTCMilliseconds", min_args = 1, max_args = 1 }
__dart_date_month   = { emit = "common:dart.date_month",         min_args = 1, max_args = 1 }
__dart_date_weekday = { emit = "common:dart.date_weekday",       min_args = 1, max_args = 1 }
"Future.value"      = { emit = "host:ecma:promise:resolve",       min_args = 1, max_args = 1 }
"Future.error"      = { emit = "host:ecma:promise:reject",        min_args = 1, max_args = 1 }
"Future.sync"       = { emit = "common:dart.future_call0",        min_args = 1, max_args = 1 }
"Future.microtask"  = { emit = "common:dart.future_call0",        min_args = 1, max_args = 1 }
"Future.delayed"    = { emit = "common:dart.future_delayed",      min_args = 1, max_args = 2 }
"Stream.fromIterable" = { emit = "common:dart.identity",         min_args = 1, max_args = 1 }
"Stream.value"      = { emit = "common:dart.stream_value",        min_args = 1, max_args = 1 }
"Stream.empty"      = { emit = "common:dart.stream_empty",        min_args = 0, max_args = 0 }
"Stream.error"      = { emit = "common:dart.stream_error",        min_args = 1, max_args = 1 }
"Promise.resolve"   = { emit = "host:ecma:promise:resolve",       min_args = 1, max_args = 1 }
"Promise.reject"    = { emit = "host:ecma:promise:reject",        min_args = 1, max_args = 1 }
"Promise.all"       = { emit = "host:ecma:promise:all",           min_args = 1, max_args = 1 }
"Promise.race"      = { emit = "host:ecma:promise:race",          min_args = 1, max_args = 1 }
"Promise.try"       = { emit = "host:ecma:promise:try",           min_args = 1, max_args = 1 }
# Kept so `dart.core.Duration.zero` stays in the namespace tree — the tree is
# built FROM these dotted keys. The walker rewrites the SPELLING to
# `Duration(0)`, a construction of the class, before this emit is reached.
"Duration.zero"     = { emit = "common:dart.duration_zero",      min_args = 0, max_args = 0 }
# A dotted key is a TYPE and its STATIC member written as one flat string.
# `tree_register.rs` splits each at the dot and registers the member under its
# owner's `statics`, so these lines are the DATA a real namespace is built
# from — `dart.core.Uri.parse` walks the tree today. They cannot simply be
# deleted: this table is that namespace's source. What retires is the flat
# table's role as a RESOLUTION path (namespaceplan Phase 6), not the data.
# `Uri` is a CLASS (`core_classes/uri.rs`). Its four named constructors keep
# their keys here — the tree is built FROM them, so deleting the rows would
# delete `dart.core.Uri.parse` from the namespace — but the walker rewrites each
# SPELLING into a `Uri(...)` construction before the emit is reached, exactly as
# `Duration.zero` above does. The emits therefore never fire.
"Uri.parse"         = { emit = "common:dart.url_parse",          min_args = 1, max_args = 1 }
"Uri.http"          = { emit = "common:dart.url_parse",          min_args = 2, max_args = 4 }
"Uri.https"         = { emit = "common:dart.url_parse",          min_args = 2, max_args = 4 }
"Uri.file"          = { emit = "common:dart.url_parse",          min_args = 1, max_args = 1 }

# The URL domain, through the shared codec `primitives::url` — one parse, one
# component model. `Uri`'s constructor calls these; nothing else does.
__dart_url_parse    = { emit = "common:dart.url_parse",          min_args = 1, max_args = 1 }
__dart_url_scheme   = { emit = "common:dart.url_scheme",         min_args = 1, max_args = 1 }
__dart_url_host     = { emit = "common:dart.url_host",           min_args = 1, max_args = 1 }
__dart_url_port     = { emit = "common:dart.url_port",           min_args = 1, max_args = 1 }
__dart_url_path     = { emit = "common:dart.url_path",           min_args = 1, max_args = 1 }
__dart_url_query    = { emit = "common:dart.url_query",          min_args = 1, max_args = 1 }
__dart_url_fragment = { emit = "common:dart.url_fragment",       min_args = 1, max_args = 1 }
__dart_url_user     = { emit = "common:dart.url_user",           min_args = 1, max_args = 1 }
__dart_url_pass     = { emit = "common:dart.url_pass",           min_args = 1, max_args = 1 }
__dart_url_decode   = { emit = "common:dart.url_decode",         min_args = 1, max_args = 1 }
# No `__dart_url_encode`. Nothing calls it: the class reassembles a URI from
# components that were decoded on the way in and are written back verbatim, so
# there is no encode side. A row with no caller is exactly what this conversion
# is removing — it goes back when a member needs it.
"List.filled"       = { emit = "common:dart.list_filled",        min_args = 2, max_args = 2 }
"List.generate"     = { emit = "common:dart.list_generate",      min_args = 2, max_args = 3 }
"List.from"         = { emit = "common:dart.list_from",          min_args = 1, max_args = 2 }
"List.of"           = { emit = "common:dart.list_from",          min_args = 1, max_args = 2 }
"List.unmodifiable" = { emit = "common:dart.list_unmodifiable",  min_args = 1, max_args = 1 }
# Kept as its own key even though the walker normalises the SPELLING onto
# `__dart_bigint_from` below: the `dart.core.BigInt` namespace node is built
# FROM these dotted keys, so deleting one deletes `dart.core.BigInt.from` from
# the tree along with it.
"BigInt.from"       = { emit = "host:ecma:bigint:BigInt",        min_args = 1, max_args = 1 }
"BigInt.parse"      = { emit = "common:dart.bigint_parse",       min_args = 1, max_args = 2 }
"BigInt.gcd"        = { emit = "common:dart.bigint_gcd",         min_args = 2, max_args = 2 }
# `BigInt.from` normalises in the walker onto this name — the same rewrite
# `BigInt.zero`/`one`/`two` already used — so ONE spelling carries every
# BigInt construction and `[builtin_return_types]` below can type it.
#
# The emit is the `ecma:bigint` host constructor DIRECTLY rather than through
# `common:dart.bigint_from`, which was only ever a one-line wrapper around it.
# Stating the host target is what turns BigInt semantics on: the shared
# compiler derives `bigint_enabled` from the DECLARATIONS (a `[builtin_types]`
# bigint spelling, a builtin reaching `ecma:bigint`, or a BigInt literal), and
# an opaque `common:` name reaches none of them. With it off, every `*`, `%`,
# `~/` and unary `-` on a BigInt fell through to f64 arithmetic and produced
# NaN even though the VALUE was a real ECMA BigInt all along.
"__dart_bigint_from" = { emit = "host:ecma:bigint:BigInt",       min_args = 1, max_args = 1 }
"__dart_bigint_compare_to" = { emit = "common:dart.bigint_compare_to", min_args = 2, max_args = 2 }
"__dart_bigint_idiv" = { emit = "common:dart.bigint_idiv",       min_args = 2, max_args = 2 }
"__dart_bigint_mod"  = { emit = "common:dart.bigint_mod",        min_args = 2, max_args = 2 }
"__dart_compare_to"  = { emit = "common:dart.compare_to",        min_args = 2, max_args = 2 }
"String.fromCharCode" = { emit = "host:wasm:js-string:fromCharCode", min_args = 1, max_args = 1 }
"String.fromCharCodes" = { emit = "common:dart.string_from_char_codes", min_args = 1, max_args = 1 }
"__dart_string_code_units" = { emit = "common:dart.string_code_units", min_args = 1, max_args = 1 }
"__dart_string_runes" = { emit = "common:dart.string_runes", min_args = 1, max_args = 1 }

# ── String functions ─────────────────────────────────────────────────────────

"int.parse"         = { emit = "common:dart.int_parse",          min_args = 1, max_args = 2 }
"double.parse"      = { emit = "common:dart.double_parse",       min_args = 1, max_args = 1 }

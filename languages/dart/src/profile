# ────────────────────────────────────────────────────────────────────────────
# ESM DEFAULTS — Dart library prefixes → host modules, ECMA-262 §16.2 shape
# ────────────────────────────────────────────────────────────────────────────

# Component-Model package roots (namespaceplan.md Phase 1): literal host
# prefix chains (`vybe.gui.setProperty(...)`, `wasi.cli.log(...)`) resolve
# through the common resolver's package-root step — the same data the
# hardcoded `vybe|wasi|wasm` prefix arm used to embody in code.

# The `dart:` libraries, mounted ambiently — the data form of Dart's implicit
# `dart:core` import, and the same shape java uses for `jvm.java.lang` and
# csharp for `dotnet.system`. An unqualified chain (`Uri.parse`, `int.parse`)
# searches these roots in declaration order, so a type's statics resolve by
# walking the TREE instead of matching a dotted string key in `[builtins]`.
# `dart.core.Uri.parse` stays reachable fully-qualified from anywhere.

[[esm_default]]
kind = "tree-ambient"
path = "dart.core"

[[esm_default]]
kind = "tree-ambient"
path = "dart.async"

[[esm_default]]
kind = "tree-ambient"
path = "dart.collection"

[[esm_default]]
kind = "tree-ambient"
path = "dart.io"

[[esm_default]]
kind = "package-root"
prefix = "vybe"
module_root = "vybe:"

[[esm_default]]
kind = "package-root"
prefix = "wasi"
module_root = "wasi:"

[[esm_default]]
kind = "package-root"
prefix = "wasm"
module_root = "wasm:"

[[esm_default]]
kind = "namespace"
alias = "math"
module = "ecma:math"

[[esm_default]]
kind = "namespace"
alias = "Math"
module = "ecma:math"

[[esm_default]]
kind = "namespace"
alias = "json"
module = "ecma:json"

[[esm_default]]
kind = "namespace"
alias = "JSON"
module = "ecma:json"

# `package:http` is a URL-based client (`http.get(url)`), a shape WASI 0.3 does
# not provide — `wasi:http/client.send` takes a request *resource*, not a URL.
# `node:http` exposes the URL-based `get`/`request`, so it backs this alias.
# (Bare `wasi:http` is a WASI *package* name, not an importable interface, and
# is registered by nobody.)
[[esm_default]]
kind = "namespace"
alias = "http"
module = "node:http"

[[esm_default]]
kind = "namespace"
alias = "Map"
module = "ecma:map"

[[esm_default]]
kind = "namespace"
alias = "Set"
module = "ecma:set"

# DateTime / StringBuffer / Duration namespace aliases retired.
# `StringBuffer` is a `dart.core` TYPE node (`tree_register.rs`) —
# construction and member dispatch both resolve from that one
# registration. The claim this comment used to make, that these lower
# through dotnet's `stringbuilder_adapter`/`datetime_adapter`, was never
# true for Dart: the emits are `dart.sb_*` in `emitter/string_adapter.rs`.

# Random is resolved via known_types -> wasi:random/insecure. No namespace
# indirection needed.

[[esm_default]]
kind = "namespace"
alias = "Stopwatch"
module = "wasi:clocks/monotonic-clock"

[[esm_default]]
kind = "namespace"
alias = "RegExp"
module = "ecma:regexp"

# GUI namespace is now shared globally (added by add_shared_gui_namespace)
# instead of per-language duplication.
# Future / Stream / Process namespace aliases retired:
#   Future → JSPI promise (Op::PROMISE_*); no namespace object needed.
#   Stream → `wasi:io/streams` proposal; constructed via stream adapters.
#   Process → `node:child_process` (`spawnSync` / `execSync`); the
#     dotnet wrapper Component Model handles `Process.Start` for typed
#     receivers and lowers through `process_adapter`.

# Dart Isolate spawning compiles to Op::THREAD_SPAWN (WASM threads
# proposal) — no namespace object needed.

# Dart `utf8` / `base64` from `dart:convert` map to WHATWG primitives:
# `utf8` → TextEncoder/TextDecoder (`web:encoding`); `base64` → `btoa`/`atob`
# (also in `web:encoding`). Method dispatch (`utf8.encode` etc.) lowers
# through the dart adapter at compile time.
[[esm_default]]
kind = "namespace"
alias = "utf8"
module = "web:encoding"

[[esm_default]]
kind = "namespace"
alias = "base64"
module = "web:encoding"


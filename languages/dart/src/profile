# Dart Compiler Profile
# ─────────────────────
# Covers dart:core, dart:math, dart:io, dart:convert, dart:async.
# Collection HOF methods (map, where, forEach, reduce) go through
# [array_methods] for proper compiler_common loop emission.

[info]
name = "dart"
extensions = ["dart"]

[compiler]
function_return = "explicit"
self_keyword = "this"
base_keyword = "super"
constructor_name = "__init__"    # Dart unnamed constructors handled by walker
enum_as_ordinals = false
case_sensitive = true
string_indexing = "zero_based"
# Route `class` declarations through common::classes::normalize_class
# + emit_class (see classnormalization.md).
uses_normalize_class = true
# namespaceplan.md: namespace-shaped entry points resolve through the
# common resolver (compiler::resolver) instead of the legacy hardcoded
# arms — same flip as JS/VB/C#/PHP/C, driven by the esm_default data below.
uses_common_resolver = true
entry_point = "main"
# Dart `+` on strings concatenates (per dart:core String.+).
dynamic_add = true
# Dart `bool` is a real boolean (like C#), not a C-style int: comparison and
# equality results print as `true`/`false`. Materialize them so `print(a == b)`
# / `print(x < y)` render correctly instead of `1`/`0`.
materialize_bool_results = true
# Dart records `(1, 2)` / `(x: 1, y: 2)` are a first-class type distinct from
# List: array-backed but tagged so `.$1` positional + `.name` by-name access,
# repr `(1, 2)`, and structural `==` behave as records, not lists. Same shared
# lowering (vybe_emitter::tuples) as Python tuples / C# ValueTuple.
tuple_literals_tagged = true
# `sync*` / `async*` markers make generators statically detectable — route
# them through the lazy spec-generator machinery (like JS/PHP) instead of
# the eager run-to-completion fallback, so `for (v in gen())` with `break`
# and infinite generators suspend per yield.
has_generators = true

# ────────────────────────────────────────────────────────────────────────────
# BUILTINS — bare global function calls
# ────────────────────────────────────────────────────────────────────────────

[builtins]

# `identical(a, b)` is Dart's reference equality — the same comparison C#
# spells `Object.ReferenceEquals`, so it shares that emit.
identical           = { emit = "common:ref_eq",                  min_args = 2, max_args = 2 }

# ── I/O ──────────────────────────────────────────────────────────────────────

print               = { emit = "common:dart.print",              min_args = 1, max_args = 1 }
StringBuffer        = { emit = "common:dart.sb_new",             min_args = 0, max_args = 0 }
RegExp              = { emit = "common:dart.regexp_new",         min_args = 1, max_args = 4 }
Duration            = { emit = "common:dart.duration_new",       min_args = 0, max_args = 1 }
DateTime            = { emit = "common:dart.datetime_new",       min_args = 3, max_args = 6 }
"DateTime.utc"      = { emit = "common:dart.datetime_utc",       min_args = 3, max_args = 6 }
"Duration.zero"     = { emit = "common:dart.duration_zero",      min_args = 0, max_args = 0 }
"Uri.parse"         = { emit = "common:dart.uri_parse",          min_args = 1, max_args = 1 }
"Uri.http"          = { emit = "common:dart.uri_http",           min_args = 2, max_args = 4 }
"Uri.https"         = { emit = "common:dart.uri_https",          min_args = 2, max_args = 4 }
"Uri.file"          = { emit = "common:dart.uri_file",           min_args = 1, max_args = 1 }
"List.filled"       = { emit = "common:dart.list_filled",        min_args = 2, max_args = 2 }

# ── String functions ─────────────────────────────────────────────────────────

"int.parse"         = { emit = "intrinsic:cint",         min_args = 1, max_args = 1 }
"double.parse"      = { emit = "host:ecma:number:Number",         min_args = 1, max_args = 1 }
"num.parse"         = { emit = "host:ecma:number:Number",         min_args = 1, max_args = 1 }

# ── Math functions (dart:math) ───────────────────────────────────────────────

"math.sqrt"         = { emit = "opcode:f64_sqrt",                min_args = 1, max_args = 1 }
"math.min"          = { emit = "opcode:f64_min",                 min_args = 2, max_args = 2 }
"math.max"          = { emit = "opcode:f64_max",                 min_args = 2, max_args = 2 }
"math.pow"          = { emit = "host:ecma:math:pow",             min_args = 2, max_args = 2 }
"math.sin"          = { emit = "host:ecma:math:sin",             min_args = 1, max_args = 1 }
"math.cos"          = { emit = "host:ecma:math:cos",             min_args = 1, max_args = 1 }
"math.tan"          = { emit = "host:ecma:math:tan",             min_args = 1, max_args = 1 }
"math.asin"         = { emit = "host:ecma:math:asin",            min_args = 1, max_args = 1 }
"math.acos"         = { emit = "host:ecma:math:acos",            min_args = 1, max_args = 1 }
"math.atan"         = { emit = "host:ecma:math:atan",            min_args = 1, max_args = 1 }
"math.atan2"        = { emit = "host:ecma:math:atan2",           min_args = 2, max_args = 2 }
"math.exp"          = { emit = "host:ecma:math:exp",             min_args = 1, max_args = 1 }
"math.log"          = { emit = "host:ecma:math:log",             min_args = 1, max_args = 1 }

# ── Type conversion ─────────────────────────────────────────────────────────

"int.tryParse"      = { emit = "intrinsic:cint",         min_args = 1, max_args = 1 }
"double.tryParse"   = { emit = "host:ecma:number:Number",         min_args = 1, max_args = 1 }

# ── JSON (dart:convert) ─────────────────────────────────────────────────────

jsonEncode          = { emit = "host:ecma:json:stringify",        min_args = 1, max_args = 1 }
jsonDecode          = { emit = "host:ecma:json:parse",            min_args = 1, max_args = 1 }

# ── Date / Time ─────────────────────────────────────────────────────────────

"DateTime.now"      = { emit = "host:ecma:date:now",    min_args = 0, max_args = 0 }

# ── File I/O (dart:io) ──────────────────────────────────────────────────────

"File.readAsString"     = { emit = "host:wasi:filesystem:readFile",   min_args = 1, max_args = 1 }
"File.writeAsString"    = { emit = "host:wasi:filesystem:writeFile",  min_args = 2, max_args = 2 }

# ── Environment ─────────────────────────────────────────────────────────────

"Platform.environment"  = { emit = "host:wasi:cli:getEnv",       min_args = 1, max_args = 1 }

# ────────────────────────────────────────────────────────────────────────────
# VALUE METHODS — instance method calls on values
# ────────────────────────────────────────────────────────────────────────────

[value_methods]

# String instance methods
toUpperCase   = { emit = "common:strings.to_upper",   min_args = 0, max_args = 0 }
toLowerCase   = { emit = "common:strings.to_lower",   min_args = 0, max_args = 0 }
trim          = { emit = "common:strings.trim",        min_args = 0, max_args = 0 }
trimLeft      = { emit = "common:str_trim_start",      min_args = 0, max_args = 0 }
trimRight     = { emit = "common:str_trim_end",        min_args = 0, max_args = 0 }
startsWith    = { emit = "host:ecma:string:startsWith", min_args = 1, max_args = 2 }
endsWith      = { emit = "common:str_ends_with",       min_args = 1, max_args = 1 }
contains      = { emit = "common:str_contains",        min_args = 1, max_args = 1 }
indexOf       = { emit = "host:ecma:string:indexOf",   min_args = 1, max_args = 2 }
lastIndexOf   = { emit = "common:str_last_index_of",   min_args = 1, max_args = 2 }
replaceAll    = { emit = "common:strings.replace",     min_args = 2, max_args = 2 }
split         = { emit = "common:strings.split",       min_args = 1, max_args = 1 }
substring     = { emit = "common:strings.substring",   min_args = 1, max_args = 2 }
padLeft       = { emit = "host:ecma:string:padStart",  min_args = 1, max_args = 2 }
padRight      = { emit = "host:ecma:string:padEnd",    min_args = 1, max_args = 2 }
toString      = { emit = "common:dart.to_string",      min_args = 0, max_args = 0 }
codeUnitAt    = { emit = "common:str_char_code_at",    min_args = 1, max_args = 1 }
isEmpty       = { emit = "common:dart.is_empty",       min_args = 0, max_args = 0 }
isNotEmpty    = { emit = "common:dart.is_not_empty",   min_args = 0, max_args = 0 }
isEven        = { emit = "common:dart.is_even",        min_args = 0, max_args = 0 }
isOdd         = { emit = "common:dart.is_odd",         min_args = 0, max_args = 0 }
compareTo     = { emit = "common:dart.compare_to",     min_args = 1, max_args = 1 }
replaceFirst  = { emit = "host:ecma:string:replace",   min_args = 2, max_args = 2 }
runes         = { emit = "host:ecma:array:from",        min_args = 0, max_args = 0 }
write         = { emit = "common:dart.sb_write",       min_args = 1, max_args = 1 }
writeln       = { emit = "common:dart.sb_writeln",     min_args = 0, max_args = 1 }
writeAll      = { emit = "common:dart.sb_write_all",   min_args = 1, max_args = 2 }
writeCharCode = { emit = "common:dart.sb_write_char_code", min_args = 1, max_args = 1 }
clear         = { emit = "common:dart.sb_clear",       min_args = 0, max_args = 0 }
hasMatch      = { emit = "common:dart.regexp_has_match", min_args = 1, max_args = 1 }
firstMatch    = { emit = "common:dart.regexp_first_match", min_args = 1, max_args = 1 }
allMatches    = { emit = "common:dart.regexp_all_matches", min_args = 1, max_args = 1 }
group         = { emit = "common:dart.regexp_group",   min_args = 1, max_args = 1 }
abs           = { emit = "common:dart.abs",            min_args = 0, max_args = 0 }
floor         = { emit = "common:dart.num_floor",      min_args = 0, max_args = 0 }
ceil          = { emit = "common:dart.num_ceil",       min_args = 0, max_args = 0 }
round         = { emit = "common:dart.num_round",      min_args = 0, max_args = 0 }
truncate      = { emit = "common:dart.num_truncate",   min_args = 0, max_args = 0 }
toInt         = { emit = "common:dart.num_truncate",   min_args = 0, max_args = 0 }
toDouble      = { emit = "common:dart.num_to_double",  min_args = 0, max_args = 0 }
remainder     = { emit = "common:dart.num_remainder",  min_args = 1, max_args = 1 }
isNegative    = { emit = "common:dart.num_is_negative", min_args = 0, max_args = 0 }
sign          = { emit = "common:dart.num_sign",       min_args = 0, max_args = 0 }
negate        = { emit = "common:dart.duration_negate", min_args = 0, max_args = 0 }

# ────────────────────────────────────────────────────────────────────────────
# BUILTIN TYPE SPELLINGS — go names the platform table cannot
# ────────────────────────────────────────────────────────────────────────────
# The platform table (`vybe_ast::builtin_types::PLATFORM_SPELLINGS`) already
# carries `int`/`int8..64`/`uint*`/`byte`/`float`; go's own floating spellings
# and the `rune` alias are declared here so a declared local classifies as a
# number and the shared provably-numeric operator fold can fire (§3c: the
# language declares its spellings, the shared compiler never names one).
[builtin_types]
double = ["float64", "float32"]
int    = ["rune", "uintptr"]


# Go Compiler Profile
# ───────────────────
# Covers Go core: packages, functions, structs, interfaces, slices, maps,
# methods, control flow. Goroutines lower to the shared thread/task emitter;
# channel/select support is compile-oriented in the frontend.

[info]
name = "go"
extensions = ["go"]

[compiler]
# Declared types CONVERT the value they bind (assignment, declaration and
# parameter entry alike). Stated explicitly rather than inherited: the platform
# default is `true`, and inheriting it silently gave Python coercive semantics
# it never chose.
coerces_value_to_type_hint = true
function_return = "explicit"
# `func (r *T) M()` mutates the receiver; `func (r T) M()` gets a copy.
pointer_receiver_methods = true
self_keyword = "this"
constructor_name = "constructor"
# namespaceplan.md: namespace-shaped entry points resolve through the
# common resolver — same flip as the other languages.
uses_common_resolver = true
enum_as_ordinals = false
case_sensitive = true
string_indexing = "zero_based"
entry_point = "main"
dynamic_add = true
uses_normalize_class = true
materialize_bool_results = true


# ── net/url primitives (WHATWG URL host, shared with JS) ─────────────────────
"__go_url_parse"  = { emit = "host:web:url:parse",                     min_args = 1, max_args = 2 }
# The SHARED percent codec, not a per-language reimplementation. `QueryEscape`
# is byte-identical to python `quote_plus` (`+` for space, `~` left alone) —
# measured against real `go` and `python3`.
"__go_url_esc"    = { emit = "host:ecma:string:encodeURIComponent",    min_args = 1, max_args = 1 }
"__go_url_qesc"   = { emit = "common:url.encode_form_rfc3986",         min_args = 1, max_args = 1 }
# `QueryUnescape` decodes `+` back to a space; plain `__go_url_unesc` does not
# and must stay rfc3986 — `__go_url_parse_query` already handles `+` itself.
"__go_url_qunesc" = { emit = "common:url.decode_form",                 min_args = 1, max_args = 1 }
"__go_url_unesc"  = { emit = "host:ecma:string:decodeURIComponent",    min_args = 1, max_args = 1 }

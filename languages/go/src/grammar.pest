// @grameo optimize native_choices native_rule_heads native_tokens native_token_failures ascii_xid
// @grameo choice_heads statement operand if_operand range_operand literal
// @grameo pratt expression atom=unary_expression trailing=preserve
// @grameo operator expression go_or_op precedence=1 fixity=infix_left
// @grameo operator expression go_and_op precedence=2 fixity=infix_left
// @grameo operator expression go_rel_op precedence=3 fixity=infix_left
// @grameo operator expression go_add_op precedence=4 fixity=infix_left
// @grameo operator expression go_mul_op precedence=5 fixity=infix_left
// @grameo pratt if_expression atom=if_unary_expression trailing=preserve
// @grameo operator if_expression go_or_op precedence=1 fixity=infix_left
// @grameo operator if_expression go_and_op precedence=2 fixity=infix_left
// @grameo operator if_expression go_rel_op precedence=3 fixity=infix_left
// @grameo operator if_expression go_add_op precedence=4 fixity=infix_left
// @grameo operator if_expression go_mul_op precedence=5 fixity=infix_left
// @grameo pratt range_expression atom=range_unary_expression trailing=preserve
// @grameo operator range_expression go_or_op precedence=1 fixity=infix_left
// @grameo operator range_expression go_and_op precedence=2 fixity=infix_left
// @grameo operator range_expression go_rel_op precedence=3 fixity=infix_left
// @grameo operator range_expression go_add_op precedence=4 fixity=infix_left
// @grameo operator range_expression go_mul_op precedence=5 fixity=infix_left
// Go Grammar for pest parser — FIXED
// Key fixes:
//   1. statement is NON-SILENT so function bodies are non-empty
//   2. binary_op: longer ops before shorter (>= before >, <= before <, etc.)
//   3. for_clause update position: no trailing ";" required
//   4. while-style for: expression ~ block_statement captured together
//   5. Semicolons are optional on most statements (Go's lexer inserts them)

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{ line_comment | block_comment }
line_comment = _{ "//" ~ (!("\n" | "\r") ~ ANY)* }
block_comment = _{ "/*" ~ (!"*/" ~ ANY)* ~ "*/" }

// ── Program ─────────────────────────────────────────────────────────────────

program = { SOI ~ package_clause ~ import_declarations? ~ (top_level_declaration ~ ";"?)* ~ EOI }

// ── Package ─────────────────────────────────────────────────────────────────

package_clause = { !keyword_package_glued ~ "package" ~ ident_name ~ ";"? }

// ── Imports ─────────────────────────────────────────────────────────────────

import_declarations = { import_declaration+ }

import_declaration = {
    !keyword_import_glued ~ "import" ~ (import_group | import_spec) ~ ";"?
}

import_group = { "(" ~ (import_spec ~ ";"?)* ~ ")" }

import_spec = {
    (ident_name | "." | "_")? ~ string_literal
}

// ── Top-level declarations ──────────────────────────────────────────────────

top_level_declaration = _{
    method_declaration
    | function_declaration
    | declaration
}

declaration = _{
    var_declaration
    | const_declaration
    | type_declaration
}

// ── Variable declarations ───────────────────────────────────────────────────

var_declaration = {
    !keyword_var_glued ~ "var" ~ (var_group | var_spec)
}

var_group = { "(" ~ (var_spec ~ ";"?)* ~ ")" }

var_spec = {
    ident_list ~ type_annotation? ~ ("=" ~ expression_list)? ~ ";"?
}

blank_ident = { "_" }
ident_list = { (ident_name | blank_ident) ~ ("," ~ (ident_name | blank_ident))* }
expression_list = { expression ~ ("," ~ expression)* }

// ── Constant declarations ───────────────────────────────────────────────────

const_declaration = {
    !keyword_const_glued ~ "const" ~ (const_group | const_spec)
}

const_group = { "(" ~ (const_spec ~ ";"?)* ~ ")" }

const_spec = {
    ident_list ~ type_annotation? ~ ("=" ~ expression_list)? ~ ";"?
}

// ── Type declarations ───────────────────────────────────────────────────────

type_declaration = {
    !keyword_type_glued ~ "type" ~ (type_group | type_spec)
}

type_group = { "(" ~ (type_spec ~ ";"?)* ~ ")" }

type_spec = {
    ident_name ~ type_params? ~ ("=" ~ type_annotation | type_annotation) ~ ";"?
}

// ── Generic type parameters (erased in the walker) ──────────────────────────

type_params = { "[" ~ type_param_decl ~ ("," ~ type_param_decl)* ~ ","? ~ "]" }
type_param_decl = { ident_list ~ type_constraint }
type_constraint = { type_constraint_term ~ ("|" ~ type_constraint_term)* }
type_constraint_term = { "~"? ~ type_annotation }
type_arguments = { "[" ~ type_annotation ~ ("," ~ type_annotation)* ~ "]" }

// ── Function declarations ───────────────────────────────────────────────────

function_declaration = {
    !keyword_func_glued ~ "func" ~ ident_name ~ type_params? ~ signature ~ (function_body | ";")
}

method_declaration = {
    "func" ~ receiver ~ ident_name ~ signature ~ (function_body | ";")
}

receiver = {
    "(" ~ ((ident_name ~ type_annotation) | type_annotation) ~ ")"
}

signature = {
    "(" ~ parameter_list? ~ ")" ~ result?
}

result = {
    "(" ~ parameter_list? ~ ")"
    | type_annotation
}

parameter_list = { parameter_decl ~ ("," ~ parameter_decl)* ~ ","? }

variadic_parameter_type = { "..." ~ type_annotation }

parameter_decl = {
    ident_list ~ variadic_parameter_type
    | ident_list ~ type_annotation
    | variadic_parameter_type
    | type_annotation
}

function_body = { block_statement }

// ── Statements ──────────────────────────────────────────────────────────────
// CRITICAL: statement is NON-SILENT so pest produces Rule::statement nodes.
// Walker dispatches on the inner child rule.

statement = {
    empty_statement
    | labeled_statement
    | block_statement
    | if_statement
    | switch_statement
    | select_statement
    | for_statement
    | return_statement
    | break_statement
    | continue_statement
    | fallthrough_statement
    | goto_statement
    | defer_statement
    | go_statement
    | send_statement
    | short_var_declaration
    | inc_dec_statement
    | assignment_statement
    | var_declaration
    | const_declaration
    | type_declaration
    | expression_statement
}

empty_statement = { ";" }

labeled_statement = { ident_name ~ ":" ~ !("=") ~ statement? }

block_statement = { "{" ~ statement_list ~ "}" }

statement_list = { (statement ~ ";"?)* }

expression_statement = { expression ~ ";"? }

// assignment before expression_statement; assign_op covers "="
assignment_statement = {
    expression_list ~ assign_op ~ expression_list ~ ";"?
}

assign_op = {
    "<<=" | ">>="
    | "+=" | "-=" | "*=" | "/=" | "%="
    | "&^=" | "&=" | "|=" | "^="
    | "="
}

short_var_declaration = {
    ident_list ~ ":=" ~ expression_list ~ ";"?
}

// inc_dec: trailing ";" is OPTIONAL (needed in for-update position)
inc_dec_statement = {
    unary_expression ~ ("++" | "--") ~ ";"?
}

// ── If statement ────────────────────────────────────────────────────────────

if_statement = {
    !keyword_if_glued ~ "if" ~ if_init? ~ if_expression ~ block_statement ~ else_clause?
}

// if_init: short statement before the condition (not followed by ";" literally —
// the ";" is consumed by short_var_declaration / assignment_statement)
if_init = _{
    short_var_declaration
    | assignment_statement
}

else_clause = { !keyword_else_glued ~ "else" ~ (if_statement | block_statement) }

// ── Switch statement ────────────────────────────────────────────────────────

switch_statement = {
    expr_switch_stmt
    | type_switch_stmt
}

expr_switch_stmt = {
    !keyword_switch_glued ~ "switch" ~ switch_init? ~ expression? ~ "{" ~ expr_case_clause* ~ "}"
}

switch_init = _{
    switch_short_var_init
    | switch_assignment_init
    | switch_inc_dec_init
    | switch_expression_init
}

switch_short_var_init = {
    ident_list ~ ":=" ~ expression_list ~ ";"
}

switch_assignment_init = {
    expression_list ~ assign_op ~ expression_list ~ ";"
}

switch_inc_dec_init = {
    unary_expression ~ ("++" | "--") ~ ";"
}

switch_expression_init = {
    expression ~ ";"
}

expr_case_clause = {
    expr_switch_case ~ ":" ~ statement_list
}

expr_switch_case = {
    !keyword_case_glued ~ "case" ~ expression_list
    | kw_default
}

select_statement = {
    "select" ~ "{" ~ select_clause* ~ "}"
}

select_clause = {
    select_case_clause
    | select_default_clause
}

select_case_clause = {
    !keyword_case_glued ~ "case" ~ select_comm_clause ~ ":" ~ statement_list?
}

select_default_clause = {
    "default" ~ ":" ~ statement_list?
}

select_comm_clause = {
    select_send_clause
    | select_receive_clause
}

select_send_clause = {
    unary_expression ~ "<-" ~ expression
}

select_receive_clause = {
    (ident_list ~ (":=" | "="))? ~ expression
}

kw_default = @{ "default" ~ !(ASCII_ALPHANUMERIC | "_") }

type_switch_stmt = {
    !keyword_switch_glued ~ "switch" ~ switch_init? ~ type_switch_guard ~ "{" ~ type_case_clause* ~ "}"
}

type_switch_guard = {
    (ident_name ~ ":=")? ~ type_switch_subject ~ "." ~ "(" ~ "type" ~ ")"
}

type_switch_subject = {
    operand ~ type_switch_postfix*
}

type_switch_postfix = _{
    selector
    | index
    | three_index_slice
    | two_index_slice
    | call
}

type_case_clause = {
    type_switch_case ~ ":" ~ statement_list
}

type_switch_case = {
    !keyword_case_glued ~ "case" ~ type_list
    | kw_default
}

type_list = { (type_annotation | nil_literal) ~ ("," ~ (type_annotation | nil_literal))* }

// ── For statement ───────────────────────────────────────────────────────────
// Order matters: for_clause (has ";") must be tried before while-style.
// "for expr block" = while-style; "for block" = infinite loop.

for_statement = {
    (!keyword_for_glued ~ "for" ~ for_clause
    | !keyword_for_glued ~ "for" ~ range_clause
    | !keyword_for_glued ~ "for" ~ unary_expression ~ block_statement
    | !keyword_for_glued ~ "for" ~ expression ~ block_statement
    | !keyword_for_glued ~ "for" ~ block_statement) ~ ";"?
}

// for_init may have trailing ";" (short_var_declaration includes it)
// for_update does NOT require ";" — i++ before "{" is valid
for_clause = {
    for_init? ~ ";" ~ expression? ~ ";" ~ for_update? ~ block_statement
}

for_init = _{
    for_short_var_nosemi
    | for_inc_dec
    | for_assign_nosemi
    | expression
}

for_short_var_nosemi = { ident_list ~ ":=" ~ expression_list }

// Update: no trailing ";" required
for_update = _{
    for_inc_dec
    | for_assign_nosemi
    | expression
}

for_inc_dec = { unary_expression ~ ("++" | "--") }

for_assign_nosemi = { expression_list ~ assign_op ~ expression_list }

range_clause = {
    (ident_list ~ (":=" | "=") | expression_list ~ "=")? ~ !keyword_range_glued ~ "range" ~ range_expression ~ block_statement
}

// ── Jump statements ─────────────────────────────────────────────────────────

return_keyword = @{ "return" ~ !(ASCII_ALPHANUMERIC | "_") }
return_statement = { return_keyword ~ expression_list? ~ ";"? }
break_statement    = { !keyword_break_glued ~ "break"    ~ ident_name? ~ ";"? }
continue_statement = { !keyword_continue_glued ~ "continue" ~ ident_name? ~ ";"? }
fallthrough_statement = { !keyword_fallthrough_glued ~ "fallthrough" ~ ";"? }
goto_statement     = { !keyword_goto_glued ~ "goto"     ~ ident_name  ~ ";"? }

// ── Defer / Go ──────────────────────────────────────────────────────────────

defer_statement = { !keyword_defer_glued ~ "defer" ~ expression ~ ";"? }
go_statement    = { !keyword_go_glued ~ "go"    ~ expression ~ ";"? }

// ── Send statement ──────────────────────────────────────────────────────────

send_statement = { unary_expression ~ "<-" ~ expression ~ ";"? }

// ── Expressions ─────────────────────────────────────────────────────────────
// Flat precedence chain — walker uses op.as_str() to determine the operator.

expression = { unary_expression ~ (binary_op ~ unary_expression)* }

if_expression = { if_unary_expression ~ (binary_op ~ if_unary_expression)* }

range_expression = { range_unary_expression ~ (binary_op ~ range_unary_expression)* }

unary_expression = {
    unary_op ~ unary_expression
    | primary
}

if_unary_expression = {
    unary_op ~ if_unary_expression
    | if_primary
}

range_unary_expression = {
    unary_op ~ range_unary_expression
    | range_primary
}

// atomic so word-boundary works for identifier-adjacent ops
unary_op = @{ "-" | "+" | "!" | "^" | "*" | "&" | "<-" }

// CRITICAL: longer ops FIRST to prevent premature match
binary_op = @{
    "||"
    | "&&"
    | "==" | "!="
    | "<<" | ">>"
    // `<` must not swallow the arrow: Go's lexer is maximal-munch, so `<-`
    // is ALWAYS one token. Without the guard, `ch <- 42` followed by a
    // line starting with `<-recv` parsed as ONE send of `42 < -recv`.
    | "<=" | ">=" | ("<" ~ !"-") | ">"
    | "+"  | "-"  | "|" | "^"
    | "*"  | "/"  | "%" | "&^" | "&"
}

// Go's five binary precedence levels (spec "Operator precedence"). Each class
// selects the token `binary_op` matches, so captures stay `binary_op`. The
// class heads are atomic: a lookahead inside a token must see the adjacent
// character, not the next token after trivia (`x < -1` is `<` then `-1`).
go_or_op  = _{ &"||" ~ binary_op }
go_and_op = _{ &"&&" ~ binary_op }
go_rel_op = _{ &go_rel_head ~ binary_op }
go_add_op = _{ &go_add_head ~ binary_op }
go_mul_op = _{ &go_mul_head ~ binary_op }
go_rel_head = @{ "==" | "!=" | "<=" | ">=" | ("<" ~ !("<" | "-")) | (">" ~ !">") }
go_add_head = @{ "+" | "-" | ("|" ~ !"|") | "^" }
go_mul_head = @{ "*" | "/" | "%" | "<<" | ">>" | "&^" | ("&" ~ !"&") }

// ── Primary expressions ─────────────────────────────────────────────────────

primary = {
    operand ~ postfix_op*
}

if_primary = {
    if_operand ~ postfix_op*
}

range_primary = {
    range_operand ~ postfix_op*
}

postfix_op = _{
    selector
    | generic_instantiation
    | index
    | three_index_slice
    | two_index_slice
    | type_assertion
    | call
}

operand = {
    literal
    | "(" ~ expression ~ ")"
    | type_conversion
    | slice_conversion
    | interface_conversion
    | composite_literal
    | function_literal
    | ident_name
}

if_operand = {
    literal
    | "(" ~ expression ~ ")"
    | type_conversion
    | slice_conversion
    | interface_conversion
    | function_literal
    | ident_name
    | composite_literal
}

range_operand = {
    literal
    | "(" ~ expression ~ ")"
    | type_conversion
    | slice_conversion
    | interface_conversion
    | function_literal
    | ident_name
    | composite_literal
}

slice_conversion = {
    "[]" ~ ident_name ~ "(" ~ expression ~ ")"
}

interface_conversion = {
    interface_type ~ "(" ~ expression ~ ")"
}

type_conversion = {
    "(" ~ type_annotation ~ ")" ~ "(" ~ expression ~ ")"
}

selector       = { "." ~ ident_name }
generic_instantiation = { type_arguments ~ &"(" }
index          = { "[" ~ expression ~ "]" }
two_index_slice   = { "[" ~ expression? ~ ":" ~ expression? ~ "]" }
three_index_slice = { "[" ~ expression? ~ ":" ~ expression ~ ":" ~ expression ~ "]" }
type_assertion = { "." ~ "(" ~ type_annotation ~ ")" }
call           = { "(" ~ argument_list? ~ ")" }
argument_list  = { argument ~ ("," ~ argument)* ~ ","? }
spread_suffix  = { "..." }
argument       = { (expression | type_annotation) ~ spread_suffix? }

// ── Literals ────────────────────────────────────────────────────────────────

literal = {
    numeric_literal
    | string_literal
    | bool_literal
    | nil_literal
    | rune_literal
}

// atomic with word boundary so "true" doesn't match "trueValue"
bool_literal = @{ ("true" | "false") ~ !(ASCII_ALPHANUMERIC | "_") }
nil_literal  = @{ "nil"              ~ !(ASCII_ALPHANUMERIC | "_") }

// ── Composite literals ───────────────────────────────────────────────────────

composite_literal = {
    literal_type ~ literal_value
}

// Order: map and slice/array types before bare ident to avoid ambiguity
literal_type = {
    "map" ~ "[" ~ type_annotation ~ "]" ~ type_annotation
    | "[" ~ "..." ~ "]" ~ type_annotation
    | "[" ~ expression ~ "]" ~ type_annotation
    | "[]" ~ type_annotation
    | struct_type
    | ident_name ~ selector+ ~ type_arguments?
    | ident_name ~ type_arguments
    | ident_name
}

literal_value = { "{" ~ element_list? ~ "}" }

element_list = { keyed_element ~ ("," ~ keyed_element)* ~ ","? }

// Go spec "Composite literals": Key = FieldName | Expression | LiteralValue.
// Single-token keys keep their own captures; any other key is an element
// (`token.ADD: x`, `f(x): v`, `n + 1: v`), parsed once whether or not a
// value follows.
keyed_element = {
    (string_literal | signed_numeric_key | numeric_literal | bool_literal | rune_literal | composite_literal | literal_value | ident_name) ~ ":" ~ element
    | element ~ (":" ~ element)?
}

element = {
    literal_value
    | expression
}

// ── Function literals ────────────────────────────────────────────────────────

function_literal = {
    "func" ~ signature ~ function_body
}

// ── Struct type ──────────────────────────────────────────────────────────────

struct_type = {
    "struct" ~ "{" ~ field_decl* ~ "}"
}

field_decl = {
    ident_list ~ type_annotation ~ string_literal? ~ ";"?
    | type_annotation ~ string_literal? ~ ";"?
}

// ── Interface type ───────────────────────────────────────────────────────────

interface_type = {
    "interface" ~ "{" ~ interface_member* ~ "}"
}

interface_member = {
    ident_name ~ signature ~ ";"?
    | type_constraint ~ ";"?
}

// ── Type annotations ─────────────────────────────────────────────────────────

type_annotation = {
    function_type
    | pointer_type
    | "[]" ~ type_annotation
    | "[" ~ expression ~ "]" ~ type_annotation
    | "map" ~ "[" ~ type_annotation ~ "]" ~ type_annotation
    | channel_type
    | struct_type
    | interface_type
    | ident_name ~ "." ~ ident_name ~ type_arguments?
    | ident_name ~ type_arguments
    | ident_name
}

pointer_type  = { "*"     ~ type_annotation }
channel_type  = { !keyword_chan_glued ~ "chan"  ~ "<-"? ~ type_annotation | "<-" ~ !keyword_chan_glued ~ "chan" ~ type_annotation }
function_type = { "func"  ~ signature }

// ── Rune literals ────────────────────────────────────────────────────────────

rune_literal = @{
    "'" ~ (
        "\\" ~ "U" ~ ASCII_HEX_DIGIT ~ ASCII_HEX_DIGIT ~ ASCII_HEX_DIGIT ~ ASCII_HEX_DIGIT ~ ASCII_HEX_DIGIT ~ ASCII_HEX_DIGIT ~ ASCII_HEX_DIGIT ~ ASCII_HEX_DIGIT
        | "\\" ~ "u" ~ ASCII_HEX_DIGIT ~ ASCII_HEX_DIGIT ~ ASCII_HEX_DIGIT ~ ASCII_HEX_DIGIT
        | "\\" ~ "x" ~ ASCII_HEX_DIGIT ~ ASCII_HEX_DIGIT
        | "\\" ~ ANY
        | (!"'" ~ ANY)
    ) ~ "'"
}

// ── Numeric literals ─────────────────────────────────────────────────────────

numeric_literal = @{ numeric_literal_core ~ "i"? ~ !(ASCII_ALPHANUMERIC | "_") }

signed_numeric_key = @{ ("+" | "-") ~ numeric_literal_core ~ "i"? ~ !(ASCII_ALPHANUMERIC | "_") }

numeric_literal_core = _{
    ("0x" | "0X") ~ ((ASCII_HEX_DIGIT | "_")+ ~ ("." ~ (ASCII_HEX_DIGIT | "_")*)? | "." ~ (ASCII_HEX_DIGIT | "_")+) ~ ("p" | "P") ~ ("+" | "-")? ~ ASCII_DIGIT+
    | ("0x" | "0X") ~ (ASCII_HEX_DIGIT | "_")+
    | ("0o" | "0O") ~ (ASCII_OCT_DIGIT | "_")+
    | ("0b" | "0B") ~ ("0" | "1" | "_")+
    | ASCII_DIGIT ~ (ASCII_DIGIT | "_")* ~ "." ~ (ASCII_DIGIT | "_")* ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)?
    | "." ~ ASCII_DIGIT ~ (ASCII_DIGIT | "_")* ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)?
    | ASCII_DIGIT ~ (ASCII_DIGIT | "_")* ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)?
}

// ── String literals ──────────────────────────────────────────────────────────

string_literal = @{
    "`" ~ (!"`" ~ ANY)* ~ "`"
    | "\"" ~ ("\\\"" | "\\\\" | (!"\"" ~ ANY))* ~ "\""
}

// ── Identifiers ──────────────────────────────────────────────────────────────

ident_name = @{
    !strict_keyword ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")*
}

// ── Keywords ─────────────────────────────────────────────────────────────────
// Go keywords (spec "Keywords") match only as whole words. Where an
// identifier character may follow a keyword in its rule (`break Label`,
// `if x`, `var v`), the keyword is `!keyword_X_glued ~ "X"`: the atomic
// `_glued` rule sees the character right after the keyword and the literal
// reports the expected keyword at a syntax error. Where only punctuation
// follows (`map[`, `struct{`, `func(`), the literal alone is a whole word.
// Neither form changes the capture tree.
keyword_break_glued = @{ "break" ~ (ASCII_ALPHANUMERIC | "_") }
keyword_case_glued = @{ "case" ~ (ASCII_ALPHANUMERIC | "_") }
keyword_chan_glued = @{ "chan" ~ (ASCII_ALPHANUMERIC | "_") }
keyword_const_glued = @{ "const" ~ (ASCII_ALPHANUMERIC | "_") }
keyword_continue_glued = @{ "continue" ~ (ASCII_ALPHANUMERIC | "_") }
keyword_defer_glued = @{ "defer" ~ (ASCII_ALPHANUMERIC | "_") }
keyword_else_glued = @{ "else" ~ (ASCII_ALPHANUMERIC | "_") }
keyword_fallthrough_glued = @{ "fallthrough" ~ (ASCII_ALPHANUMERIC | "_") }
keyword_for_glued = @{ "for" ~ (ASCII_ALPHANUMERIC | "_") }
keyword_func_glued = @{ "func" ~ (ASCII_ALPHANUMERIC | "_") }
keyword_go_glued = @{ "go" ~ (ASCII_ALPHANUMERIC | "_") }
keyword_goto_glued = @{ "goto" ~ (ASCII_ALPHANUMERIC | "_") }
keyword_if_glued = @{ "if" ~ (ASCII_ALPHANUMERIC | "_") }
keyword_import_glued = @{ "import" ~ (ASCII_ALPHANUMERIC | "_") }
keyword_package_glued = @{ "package" ~ (ASCII_ALPHANUMERIC | "_") }
keyword_range_glued = @{ "range" ~ (ASCII_ALPHANUMERIC | "_") }
keyword_switch_glued = @{ "switch" ~ (ASCII_ALPHANUMERIC | "_") }
keyword_type_glued = @{ "type" ~ (ASCII_ALPHANUMERIC | "_") }
keyword_var_glued = @{ "var" ~ (ASCII_ALPHANUMERIC | "_") }


strict_keyword = _{
    ( "break" | "case" | "chan" | "const" | "continue"
    | "default" | "defer" | "else" | "fallthrough" | "for"
    | "func" | "go" | "goto" | "if" | "import"
    | "interface" | "map" | "package" | "range" | "return"
    | "select" | "struct" | "switch" | "type" | "var"
    | "true" | "false" | "nil" )
    ~ !(ASCII_ALPHANUMERIC | "_")
}

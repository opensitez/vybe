# Fortran Compiler Profile
# ────────────────────────────────────────

[info]
name = "fortran"
extensions = ["f90", "f95", "f03", "f08", "f18", "f"]

[compiler]
# Declared types CONVERT the value they bind (assignment, declaration and
# parameter entry alike). Stated explicitly rather than inherited: the platform
# default is `true`, and inheriting it silently gave Python coercive semantics
# it never chose.
coerces_value_to_type_hint = true
# A LOGICAL is a VALUE, not a branch condition that happened to be stored.
# Without this, `emit_relational_from_compare3` leaves the raw i32 a comparison
# produces, so `b = (1 == 2)` put `0` in a LOGICAL and `print *, b` wrote `0`
# where gfortran writes `F`. Every other language that has booleans declares it.
materialize_bool_results = true
# `intent(out)` arrives default-initialized.
out_params_default_initialized = true
# An omitted trailing `optional ::` dummy argument is passed as undefined.
pads_trailing_optional_arg = true
# `allocate(a(n,m))` names every dimension.
allocate_takes_dimension_list = true
# `a(lo:hi)` includes both endpoints.
slice_bounds_inclusive = true
# Derived types are value types — assignment copies, mutations write back.
user_types_are_value_types = true
# `a = 0` fills every element.
array_assign_broadcasts_scalar = true
# Arguments alias the caller's object.
args_pass_by_reference = true
# Module variables compile before contained procedures.
class_body_declarations_before_procedures = true
# `real :: a(3,4)` declares the shape; the declaration allocates it.
array_bounds_declare_fixed_shape = true
# `a + b` on arrays is elementwise.
array_arithmetic_elementwise = true
# A method call on a value-type receiver writes the receiver back.
member_call_writes_receiver_back = true
# `TypeName(args)` constructs a derived type — no `new`.
bare_name_constructs_value_type = true
# A procedure in an INTERFACE block is callable under the interface name.
interface_block_is_generic_alias = true
function_return = "result_slot"        # Fortran uses result variable or function name
# ⛔ INTERNAL, not user-visible. A Fortran function returns through its own NAME
# or an explicit `result(name)` clause — it never spells the bare word `result`,
# so that word is an ordinary identifier and programs use it constantly. Left at
# the default `"Result"` the implicit slot collided with every such variable
# (Fortran is case-insensitive, so `Result` and `result` canonicalise together):
# reads and writes landed on different storage, which showed up as `where`
# leaving unmasked elements null. Pascal keeps the default because Pascal source
# really does write `Result := X`; VB set its own for this same reason.
result_slot_name = "__fortran_result__"
self_keyword = ""
base_keyword = ""
constructor_name = ""
# namespaceplan.md: namespace-shaped entry points resolve through the
# common resolver — same flip as the other languages.
uses_common_resolver = true
enum_as_ordinals = false
case_sensitive = false                 # Fortran is case-insensitive
string_indexing = "one_based"          # Fortran strings are 1-based
array_upper_bound_inclusive = true     # do i=1,10 means 1..10 inclusive
parens_for_index = true                # Fortran uses () for array indexing
entry_point = "main"
hoist_var = false
dynamic_add = false
commonjs_require = false
byref_boxing = false
with_block = false
new_with_initializer = false
new_from_initializer = false
linq_queries = false

# ────────────────────────────────────────────────────────────────────────────
# BUILTINS — Fortran intrinsic functions
# ────────────────────────────────────────────────────────────────────────────

[builtins]

# ── I/O ──────────────────────────────────────────────────────────────────────

__print       = { emit = "print",                          min_args = 0, max_args = 255 }
# The numeric value of a token read from an INTERNAL file. Internal name, so
# no ordinary Fortran procedure can collide with it.
__fortran_to_number = { emit = "host:ecma:number:Number",  min_args = 1, max_args = 1 }

# ── TRANSFER: the bit pattern, not a conversion ─────────────────────────────
# `transfer(x, 0)` reinterprets the BITS — `transfer(3.14, 0)` is 1078523331,
# not 3. The same operation Go spells `math.Float32bits`, so it binds the SAME
# shared primitives rather than growing a Fortran copy. Default `real` is 4
# bytes. TRANSFER is `UnaryOp::Reinterpret` now — an AST node, not a row.

# `INQUIRE(file=…)` — the same `wasi:filesystem` surface python and php bind.
__fortran_file_exists = { emit = "host:wasi:filesystem:exists",   min_args = 1, max_args = 1 }
__fortran_file_size   = { emit = "host:wasi:filesystem:fileSize", min_args = 1, max_args = 1 }
# One FIELD of a formatted internal read: the characters a descriptor covers.
__fortran_substring   = { emit = "host:ecma:string:substring",    min_args = 2, max_args = 3 }

# ── C ABI: sqlite3, reached through `bind(c)` ────────────────────────────────
# The adapter and the tree leaves are platform-owned
# (`platforms/libc/src/emitter/sqlite_adapter.rs`); these rows only make the
# BARE symbol callable, because the bare-call path does not consult the
# resolver's tree yet — the same reason C carries an identical `SDL_*` block
# with the same note. Delete this block when the call path reads the tree, not
# the platform registration.
"sqlite3_open"            = { emit = "common:libc.sqlite3.sqlite3_open",            min_args = 2, max_args = 2 }
"sqlite3_open_v2"         = { emit = "common:libc.sqlite3.sqlite3_open_v2",         min_args = 4, max_args = 4 }
"sqlite3_close"           = { emit = "common:libc.sqlite3.sqlite3_close",           min_args = 1, max_args = 1 }
"sqlite3_close_v2"        = { emit = "common:libc.sqlite3.sqlite3_close_v2",        min_args = 1, max_args = 1 }
"sqlite3_exec"            = { emit = "common:libc.sqlite3.sqlite3_exec",            min_args = 5, max_args = 5 }
"sqlite3_prepare"         = { emit = "common:libc.sqlite3.sqlite3_prepare",         min_args = 5, max_args = 5 }
"sqlite3_prepare_v2"      = { emit = "common:libc.sqlite3.sqlite3_prepare_v2",      min_args = 5, max_args = 5 }
"sqlite3_finalize"        = { emit = "common:libc.sqlite3.sqlite3_finalize",        min_args = 1, max_args = 1 }
"sqlite3_reset"           = { emit = "common:libc.sqlite3.sqlite3_reset",           min_args = 1, max_args = 1 }
"sqlite3_errmsg"          = { emit = "common:libc.sqlite3.sqlite3_errmsg",          min_args = 1, max_args = 1 }
"sqlite3_errcode"         = { emit = "common:libc.sqlite3.sqlite3_errcode",         min_args = 1, max_args = 1 }
"sqlite3_extended_errcode" = { emit = "common:libc.sqlite3.sqlite3_extended_errcode", min_args = 1, max_args = 1 }

# ── Math — WASM opcodes ─────────────────────────────────────────────────────

abs           = { emit = "opcode:f64_abs",                 min_args = 1, max_args = 1 }
sqrt          = { emit = "opcode:f64_sqrt",                min_args = 1, max_args = 1 }
floor         = { emit = "opcode:f64_floor",               min_args = 1, max_args = 1 }
ceiling       = { emit = "opcode:f64_ceil",                min_args = 1, max_args = 1 }
trunc         = { emit = "opcode:f64_trunc",               min_args = 1, max_args = 1 }
# gfortran: `nint(2.5)`=3, `nint(-2.5)`=-3 — ties AWAY FROM ZERO. `f64.nearest`
# is ties-to-even and got 3 of those 4 wrong.
round         = { emit = "common:math.round_half_away",    min_args = 1, max_args = 1 }
nint          = { emit = "common:math.round_half_away",    min_args = 1, max_args = 1 }
min           = { emit = "common:fortran.min",             min_args = 2, max_args = 255 }
max           = { emit = "common:fortran.max",             min_args = 2, max_args = 255 }
real          = { emit = "opcode:f64_from_i32",            min_args = 1, max_args = 1 }
dble          = { emit = "opcode:f64_from_i32",            min_args = 1, max_args = 1 }
int           = { emit = "common:to_int",                  min_args = 1, max_args = 1 }

# ── Math — host calls ───────────────────────────────────────────────────────

sin           = { emit = "host:ecma:math:sin",             min_args = 1, max_args = 1 }
cos           = { emit = "host:ecma:math:cos",             min_args = 1, max_args = 1 }
tan           = { emit = "host:ecma:math:tan",             min_args = 1, max_args = 1 }
asin          = { emit = "host:ecma:math:asin",            min_args = 1, max_args = 1 }
acos          = { emit = "host:ecma:math:acos",            min_args = 1, max_args = 1 }
atan          = { emit = "host:ecma:math:atan",            min_args = 1, max_args = 1 }
atan2         = { emit = "host:ecma:math:atan2",           min_args = 2, max_args = 2 }
sinh          = { emit = "host:ecma:math:sinh",            min_args = 1, max_args = 1 }
cosh          = { emit = "host:ecma:math:cosh",            min_args = 1, max_args = 1 }
tanh          = { emit = "host:ecma:math:tanh",            min_args = 1, max_args = 1 }
exp           = { emit = "host:ecma:math:exp",             min_args = 1, max_args = 1 }
log           = { emit = "host:ecma:math:log",             min_args = 1, max_args = 1 }
log10         = { emit = "host:ecma:math:log10",           min_args = 1, max_args = 1 }
mod           = { emit = "common:expressions.f64_mod",     min_args = 2, max_args = 2 }
modulo        = { emit = "common:expressions.f64_mod",     min_args = 2, max_args = 2 }
sign          = { emit = "host:ecma:math:sign",            min_args = 2, max_args = 2 }
random_number = { emit = "host:ecma:math:random",          min_args = 0, max_args = 0 }

# ── F2008 math — existing primitives, no new machinery ───────────────────────
#
# `erf`/`erfc`/`tgamma`/`lgamma` are already registered by `platforms/libc`
# (`emitter/tree_register.rs`) and dispatched there, so Fortran only has to
# name them. Fortran spells two of them differently: `gamma` IS C's `tgamma`
# and `log_gamma` IS `lgamma`.
erf           = { emit = "common:libc.math.erf",           min_args = 1, max_args = 1 }
erfc          = { emit = "common:libc.math.erfc",          min_args = 1, max_args = 1 }
gamma         = { emit = "common:libc.math.tgamma",        min_args = 1, max_args = 1 }
log_gamma     = { emit = "common:libc.math.lgamma",        min_args = 1, max_args = 1 }

# The inverse hyperbolics and `hypot` are ECMA math, same as `sinh`/`cosh`
# above — F2008 added them to Fortran, they were never missing from the host.
asinh         = { emit = "host:ecma:math:asinh",           min_args = 1, max_args = 1 }
acosh         = { emit = "host:ecma:math:acosh",           min_args = 1, max_args = 1 }
atanh         = { emit = "host:ecma:math:atanh",           min_args = 1, max_args = 1 }
hypot         = { emit = "host:ecma:math:hypot",           min_args = 2, max_args = 2 }

# IEEE_ARITHMETIC's two predicates are ECMA's two predicates, exactly — same
# question, same answer for every operand. Declared here rather than folded in
# the walker so a program that defines its own is still the one that wins.
ieee_is_nan    = { emit = "host:ecma:number:isNaN",        min_args = 1, max_args = 1 }
ieee_is_finite = { emit = "host:ecma:number:isFinite",     min_args = 1, max_args = 1 }
__fortran_log2 = { emit = "host:ecma:math:log2",           min_args = 1, max_args = 1 }

# Bessel — implemented in `platforms/libc/src/emitter/bessel.rs` and registered
# as `libc.math.*`, so C reaches the same code through <math.h>.
bessel_j0     = { emit = "common:libc.math.j0",             min_args = 1, max_args = 1 }
bessel_j1     = { emit = "common:libc.math.j1",             min_args = 1, max_args = 1 }
bessel_jn     = { emit = "common:libc.math.jn",             min_args = 2, max_args = 2 }
bessel_y0     = { emit = "common:libc.math.y0",             min_args = 1, max_args = 1 }
bessel_y1     = { emit = "common:libc.math.y1",             min_args = 1, max_args = 1 }
bessel_yn     = { emit = "common:libc.math.yn",             min_args = 2, max_args = 2 }
# `erfc_scaled` is NOT `exp(x*x)*erfc(x)` computed literally — both factors
# overflow/underflow well before the product does. It gets its own kernel.
erfc_scaled   = { emit = "common:libc.math.erfcx",          min_args = 1, max_args = 1 }

# ── F2008 bit counting ───────────────────────────────────────────────────────
#
# The only bit intrinsics that are NOT here: every other one folds to an
# operator in the walker (`iand` is `BitAnd`, `btest` is a shift and a compare).
# Counting bits has no operator, and is one core WASM opcode —
# `i32.popcnt` / `i32.clz` / `i32.ctz`. These route to the SHARED bit family in
# `primitives/bits.rs` — the same code the `UnaryOp::PopCount` node emits — so
# Fortran, Go, Java and C# reach one implementation. Default INTEGER is kind 4,
# hence the 32-bit lane; a `kind=8` operand would name the 64-bit row.
# `SPACING(x)` and `NEAREST(x, s)` are the ULP and the adjacent representable
# value. Both used to be computed ARITHMETICALLY in the walker, which is one ULP
# too far coming DOWN out of a power of two — the spacing halves there.
# Default `real` is kind 4, so the DEFAULT lane is f32 — `SPACING(1.0)` is 2^-23,
# not 2^-52. The walker folds a kind-8 operand onto the `*64` rows instead.
spacing       = { emit = "common:math.ulp32",              min_args = 1, max_args = 1 }
__vybe_ulp64      = { emit = "common:math.ulp64",          min_args = 1, max_args = 1 }
__vybe_next_up32  = { emit = "common:math.next_up32",      min_args = 1, max_args = 1 }
__vybe_next_up64  = { emit = "common:math.next_up64",      min_args = 1, max_args = 1 }
__vybe_next_dn32  = { emit = "common:math.next_down32",    min_args = 1, max_args = 1 }
__vybe_next_dn64  = { emit = "common:math.next_down64",    min_args = 1, max_args = 1 }

popcnt        = { emit = "common:bits.popcnt32",           min_args = 1, max_args = 1 }
leadz         = { emit = "common:bits.clz32",              min_args = 1, max_args = 1 }
trailz        = { emit = "common:bits.ctz32",              min_args = 1, max_args = 1 }

# `parity(mask)` — an odd number of true elements. Not a bit intrinsic; F2008
# introduced it alongside them. It is a BUILTIN and not a walker fold precisely
# because a builtin can be shadowed: the suite contains a program with its own
# `recursive integer function parity(n, even_only)`, and a fold — which fires on
# the name, before any declaration is known — would hijack it.
parity        = { emit = "common:fortran.parity",          min_args = 1, max_args = 1 }

# ── String functions ─────────────────────────────────────────────────────────

len           = { emit = "common:strings.length",          min_args = 1, max_args = 1 }
size          = { emit = "common:array_length",            min_args = 1, max_args = 1 }
rank          = { emit = "common:collections.rank",        min_args = 1, max_args = 1 }
len_trim      = { emit = "common:fortran.len_trim",        min_args = 1, max_args = 1 }
trim          = { emit = "common:str_trim_end",            min_args = 1, max_args = 1 }
adjustl       = { emit = "common:str_trim_start",          min_args = 1, max_args = 1 }
adjustr       = { emit = "common:str_trim_end",            min_args = 1, max_args = 1 }
char          = { emit = "host:ecma:string:fromCharCode",  min_args = 1, max_args = 1 }
ichar         = { emit = "host:ecma:string:charCodeAt",    min_args = 1, max_args = 1 }
index         = { emit = "intrinsic:fortran_index",       min_args = 2, max_args = 3 }
scan          = { emit = "intrinsic:fortran_scan",        min_args = 2, max_args = 3 }
verify        = { emit = "intrinsic:fortran_verify",      min_args = 2, max_args = 3 }
str_split     = { emit = "host:ecma:string:split",        min_args = 2, max_args = 2 }
str_getcsv    = { emit = "intrinsic:str_getcsv",          min_args = 1, max_args = 4 }
repeat        = { emit = "common:str_repeat",              min_args = 2, max_args = 2 }
to_upper      = { emit = "common:str_to_upper",            min_args = 1, max_args = 1 }
to_lower      = { emit = "common:str_to_lower",            min_args = 1, max_args = 1 }
array_join    = { emit = "intrinsic:array_join",          min_args = 2, max_args = 2 }
# Matrix multiply — emitter in emitter/math_adapter.rs.
matmul        = { emit = "common:fortran.matmul",         min_args = 2, max_args = 2 }
sprintf       = { emit = "common:sprintf.format",        min_args = 1, max_args = 255 }
# One `print`/`write` item, rendered. A LOGICAL writes `T`/`F` and everything
# else takes the general rendering, decided by asking the VALUE at run time.
__fortran_io_str = { emit = "common:fortran.io_str",     min_args = 1, max_args = 1 }
# Whether an argument arrived as a whole array — what `merge` asks of its mask
# and of each source before deciding to index it or broadcast it.
__fortran_is_array = { emit = "common:fortran.is_array", min_args = 1, max_args = 1 }

# ── Misc ─────────────────────────────────────────────────────────────────────

stop          = { emit = "noop",                           min_args = 0, max_args = 1 }
# `STOP <code>` / `ERROR STOP <code>` — the walker lowers the coded form here.
# `exit-with-code` is the WASI arm that carries a real status; plain `exit`
# only distinguishes ok from error.
__fortran_stop = { emit = "host:wasi:cli/exit:exit-with-code", min_args = 1, max_args = 1 }

# ────────────────────────────────────────────────────────────────────────────
# VALUE METHODS
# ────────────────────────────────────────────────────────────────────────────

[value_methods]
# `all`/`any`/`count` with no `dim` ask about every element whatever the rank,
# so they flatten the mask first — a rank-2 mask is a nest, and mapping over a
# nest visits ROWS, which are arrays and therefore always truthy.
flat = { emit = "host:ecma:array:flat", min_args = 0, max_args = 1 }

[array_methods]
map      = "__array_map"
reduce   = "__array_reduce"
flatMap  = "__array_flat_map"
# `all`/`any` lower to `.every`/`.some`. Undeclared, they resolved only where
# the receiver's type was already known — so `all(m)` worked and `all(m, dim=1)`,
# whose receiver is a lambda parameter holding one lane, answered `null`.
some     = "__array_some"
every    = "__array_every"
# `maxloc`/`minloc`/`findloc` are built out of `.indexOf` and `.findLastIndex`
# on the array. Undeclared, those calls answered null — and the index-to-Fortran
# conversion is `idx < 0 ? 0 : idx + 1`, where `null` fails the test and then
# `null + 1` is 1. That is why EVERY locator answered 1 regardless of the data.
# This table is what the dispatch consults; a name it does not carry never
# reaches the arm that implements it.
indexOf       = "__array_index_of"
findLastIndex = "__array_find_last_index"
# The MASKED locator forms search with a predicate rather than by value.
findIndex     = "__array_findIndex"
filter        = "__array_filter"

# ────────────────────────────────────────────────────────────────────────────
# BUILT-IN TYPE SPELLINGS
# ────────────────────────────────────────────────────────────────────────────
# Fortran's own names for the shared built-ins. Declared HERE so shared code
# stops carrying them: `normalize_fortran_dispatch_type` used to hardcode
# `integer`/`real`/`logical` in `primitives/overloads.rs`, which is a
# per-language table in a shared crate.
#
# Every spelling admits a KIND suffix, so all four are prefix matches:
# `integer(kind=4)`, `real(kind=8)`, `logical(kind=1)`, `character(len=*)`.
# `double precision` has no kind form and is written exactly.

[builtin_types]
int    = ["integer*"]
double = ["real*", "double precision"]
bool   = ["logical*"]

# ────────────────────────────────────────────────────────────────────────────
# NAMESPACE CONSTANTS
# ────────────────────────────────────────────────────────────────────────────

[namespace_constants]

# ────────────────────────────────────────────────────────────────────────────
# ESM DEFAULTS — none. Fortran has no ambient host module imports.
# ────────────────────────────────────────────────────────────────────────────


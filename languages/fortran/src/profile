# Fortran Compiler Profile
# ────────────────────────────────────────

[info]
name = "fortran"
extensions = ["f90", "f95", "f03", "f08", "f18", "f"]

[compiler]
# Declared types CONVERT the value they bind (assignment, declaration and
# parameter entry alike). Stated explicitly rather than inherited: the platform
# default is `true`, and inheriting it silently gave Python coercive semantics
# it never chose.
coerces_value_to_type_hint = true
# `intent(out)` arrives default-initialized.
out_params_default_initialized = true
# An omitted trailing `optional ::` dummy argument is passed as undefined.
pads_trailing_optional_arg = true
# `allocate(a(n,m))` names every dimension.
allocate_takes_dimension_list = true
# `a(lo:hi)` includes both endpoints.
slice_bounds_inclusive = true
# Derived types are value types — assignment copies, mutations write back.
user_types_are_value_types = true
# `a = 0` fills every element.
array_assign_broadcasts_scalar = true
# Arguments alias the caller's object.
args_pass_by_reference = true
# Module variables compile before contained procedures.
class_body_declarations_before_procedures = true
# `real :: a(3,4)` declares the shape; the declaration allocates it.
array_bounds_declare_fixed_shape = true
# `a + b` on arrays is elementwise.
array_arithmetic_elementwise = true
# A method call on a value-type receiver writes the receiver back.
member_call_writes_receiver_back = true
# `TypeName(args)` constructs a derived type — no `new`.
bare_name_constructs_value_type = true
# A procedure in an INTERFACE block is callable under the interface name.
interface_block_is_generic_alias = true
function_return = "result_slot"        # Fortran uses result variable or function name
self_keyword = ""
base_keyword = ""
constructor_name = ""
# namespaceplan.md: namespace-shaped entry points resolve through the
# common resolver — same flip as the other languages.
uses_common_resolver = true
enum_as_ordinals = false
case_sensitive = false                 # Fortran is case-insensitive
string_indexing = "one_based"          # Fortran strings are 1-based
array_upper_bound_inclusive = true     # do i=1,10 means 1..10 inclusive
parens_for_index = true                # Fortran uses () for array indexing
entry_point = "main"
hoist_var = false
dynamic_add = false
commonjs_require = false
byref_boxing = false
with_block = false
new_with_initializer = false
new_from_initializer = false
linq_queries = false

# ────────────────────────────────────────────────────────────────────────────
# BUILTINS — Fortran intrinsic functions
# ────────────────────────────────────────────────────────────────────────────

[builtins]

# ── I/O ──────────────────────────────────────────────────────────────────────

__print       = { emit = "print",                          min_args = 0, max_args = 255 }

# ── Math — WASM opcodes ─────────────────────────────────────────────────────

abs           = { emit = "opcode:f64_abs",                 min_args = 1, max_args = 1 }
sqrt          = { emit = "opcode:f64_sqrt",                min_args = 1, max_args = 1 }
floor         = { emit = "opcode:f64_floor",               min_args = 1, max_args = 1 }
ceiling       = { emit = "opcode:f64_ceil",                min_args = 1, max_args = 1 }
trunc         = { emit = "opcode:f64_trunc",               min_args = 1, max_args = 1 }
round         = { emit = "opcode:f64_nearest",             min_args = 1, max_args = 1 }
nint          = { emit = "opcode:f64_nearest",             min_args = 1, max_args = 1 }
min           = { emit = "common:fortran.min",             min_args = 2, max_args = 255 }
max           = { emit = "common:fortran.max",             min_args = 2, max_args = 255 }
real          = { emit = "opcode:f64_from_i32",            min_args = 1, max_args = 1 }
dble          = { emit = "opcode:f64_from_i32",            min_args = 1, max_args = 1 }
int           = { emit = "common:to_int",                  min_args = 1, max_args = 1 }

# ── Math — host calls ───────────────────────────────────────────────────────

sin           = { emit = "host:ecma:math:sin",             min_args = 1, max_args = 1 }
cos           = { emit = "host:ecma:math:cos",             min_args = 1, max_args = 1 }
tan           = { emit = "host:ecma:math:tan",             min_args = 1, max_args = 1 }
asin          = { emit = "host:ecma:math:asin",            min_args = 1, max_args = 1 }
acos          = { emit = "host:ecma:math:acos",            min_args = 1, max_args = 1 }
atan          = { emit = "host:ecma:math:atan",            min_args = 1, max_args = 1 }
atan2         = { emit = "host:ecma:math:atan2",           min_args = 2, max_args = 2 }
sinh          = { emit = "host:ecma:math:sinh",            min_args = 1, max_args = 1 }
cosh          = { emit = "host:ecma:math:cosh",            min_args = 1, max_args = 1 }
tanh          = { emit = "host:ecma:math:tanh",            min_args = 1, max_args = 1 }
exp           = { emit = "host:ecma:math:exp",             min_args = 1, max_args = 1 }
log           = { emit = "host:ecma:math:log",             min_args = 1, max_args = 1 }
log10         = { emit = "host:ecma:math:log10",           min_args = 1, max_args = 1 }
mod           = { emit = "common:expressions.f64_mod",     min_args = 2, max_args = 2 }
modulo        = { emit = "common:expressions.f64_mod",     min_args = 2, max_args = 2 }
sign          = { emit = "host:ecma:math:sign",            min_args = 2, max_args = 2 }
random_number = { emit = "host:ecma:math:random",          min_args = 0, max_args = 0 }

# ── F2008 math — existing primitives, no new machinery ───────────────────────
#
# `erf`/`erfc`/`tgamma`/`lgamma` are already registered by `platforms/libc`
# (`emitter/tree_register.rs`) and dispatched there, so Fortran only has to
# name them. Fortran spells two of them differently: `gamma` IS C's `tgamma`
# and `log_gamma` IS `lgamma`.
erf           = { emit = "common:libc.math.erf",           min_args = 1, max_args = 1 }
erfc          = { emit = "common:libc.math.erfc",          min_args = 1, max_args = 1 }
gamma         = { emit = "common:libc.math.tgamma",        min_args = 1, max_args = 1 }
log_gamma     = { emit = "common:libc.math.lgamma",        min_args = 1, max_args = 1 }

# The inverse hyperbolics and `hypot` are ECMA math, same as `sinh`/`cosh`
# above — F2008 added them to Fortran, they were never missing from the host.
asinh         = { emit = "host:ecma:math:asinh",           min_args = 1, max_args = 1 }
acosh         = { emit = "host:ecma:math:acosh",           min_args = 1, max_args = 1 }
atanh         = { emit = "host:ecma:math:atanh",           min_args = 1, max_args = 1 }
hypot         = { emit = "host:ecma:math:hypot",           min_args = 2, max_args = 2 }

# Bessel — implemented in `platforms/libc/src/emitter/bessel.rs` and registered
# as `libc.math.*`, so C reaches the same code through <math.h>.
bessel_j0     = { emit = "common:libc.math.j0",             min_args = 1, max_args = 1 }
bessel_j1     = { emit = "common:libc.math.j1",             min_args = 1, max_args = 1 }
bessel_jn     = { emit = "common:libc.math.jn",             min_args = 2, max_args = 2 }
bessel_y0     = { emit = "common:libc.math.y0",             min_args = 1, max_args = 1 }
bessel_y1     = { emit = "common:libc.math.y1",             min_args = 1, max_args = 1 }
bessel_yn     = { emit = "common:libc.math.yn",             min_args = 2, max_args = 2 }
# `erfc_scaled` is NOT `exp(x*x)*erfc(x)` computed literally — both factors
# overflow/underflow well before the product does. It gets its own kernel.
erfc_scaled   = { emit = "common:libc.math.erfcx",          min_args = 1, max_args = 1 }

# ── F2008 bit counting ───────────────────────────────────────────────────────
#
# The only bit intrinsics that are NOT here: every other one folds to an
# operator in the walker (`iand` is `BitAnd`, `btest` is a shift and a compare).
# Counting bits has no operator, and is one core WASM opcode —
# `i32.popcnt` / `i32.clz` / `i32.ctz` — emitted in `emitter/bit_adapter.rs`.
popcnt        = { emit = "common:fortran.popcnt",          min_args = 1, max_args = 1 }
leadz         = { emit = "common:fortran.leadz",           min_args = 1, max_args = 1 }
trailz        = { emit = "common:fortran.trailz",          min_args = 1, max_args = 1 }

# `parity(mask)` — an odd number of true elements. Not a bit intrinsic; F2008
# introduced it alongside them. It is a BUILTIN and not a walker fold precisely
# because a builtin can be shadowed: the suite contains a program with its own
# `recursive integer function parity(n, even_only)`, and a fold — which fires on
# the name, before any declaration is known — would hijack it.
parity        = { emit = "common:fortran.parity",          min_args = 1, max_args = 1 }

# ── String functions ─────────────────────────────────────────────────────────

len           = { emit = "common:strings.length",          min_args = 1, max_args = 1 }
size          = { emit = "common:array_length",            min_args = 1, max_args = 1 }
rank          = { emit = "common:collections.rank",        min_args = 1, max_args = 1 }
len_trim      = { emit = "common:fortran.len_trim",        min_args = 1, max_args = 1 }
trim          = { emit = "common:str_trim_end",            min_args = 1, max_args = 1 }
adjustl       = { emit = "common:str_trim_start",          min_args = 1, max_args = 1 }
adjustr       = { emit = "common:str_trim_end",            min_args = 1, max_args = 1 }
char          = { emit = "host:ecma:string:fromCharCode",  min_args = 1, max_args = 1 }
ichar         = { emit = "host:ecma:string:charCodeAt",    min_args = 1, max_args = 1 }
index         = { emit = "intrinsic:fortran_index",       min_args = 2, max_args = 3 }
scan          = { emit = "intrinsic:fortran_scan",        min_args = 2, max_args = 3 }
verify        = { emit = "intrinsic:fortran_verify",      min_args = 2, max_args = 3 }
str_split     = { emit = "host:ecma:string:split",        min_args = 2, max_args = 2 }
str_getcsv    = { emit = "intrinsic:str_getcsv",          min_args = 1, max_args = 4 }
repeat        = { emit = "common:str_repeat",              min_args = 2, max_args = 2 }
to_upper      = { emit = "common:str_to_upper",            min_args = 1, max_args = 1 }
to_lower      = { emit = "common:str_to_lower",            min_args = 1, max_args = 1 }
array_join    = { emit = "intrinsic:array_join",          min_args = 2, max_args = 2 }
# Matrix multiply — emitter in emitter/math_adapter.rs.
matmul        = { emit = "common:fortran.matmul",         min_args = 2, max_args = 2 }
sprintf       = { emit = "common:sprintf.format",        min_args = 1, max_args = 255 }

# ── Misc ─────────────────────────────────────────────────────────────────────

stop          = { emit = "noop",                           min_args = 0, max_args = 1 }
# `STOP <code>` / `ERROR STOP <code>` — the walker lowers the coded form here.
# `exit-with-code` is the WASI arm that carries a real status; plain `exit`
# only distinguishes ok from error.
__fortran_stop = { emit = "host:wasi:cli/exit:exit-with-code", min_args = 1, max_args = 1 }

# ────────────────────────────────────────────────────────────────────────────

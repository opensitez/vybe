// C# Grammar for pest parser
// Covers everything vybe_parser_csharp supports
//
// C# uses ";" terminators, so newlines are whitespace (no ASI needed).
// Generics are recognized and stripped (no type-specific compilation).
// Keyword operators use atomic @{} rules for word boundaries.

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{ line_comment | block_comment }
line_comment = _{ "//" ~ (!"\n" ~ ANY)* }
block_comment = _{ "/*" ~ (!"*/" ~ ANY)* ~ "*/" }

// ── Program ─────────────────────────────────────────────────────────────────

program = { SOI ~ program_item* ~ EOI }

program_item = _{
    using_directive
    | namespace_declaration
    | type_declaration
    | statement
}

// ── Using directives ────────────────────────────────────────────────────────

using_directive = { "using" ~ using_directive_body ~ ";" }
using_directive_body = { using_static_directive | using_alias_directive | dotted_name }
using_static_directive = { "static" ~ dotted_name }
using_alias_directive = { ident_name ~ "=" ~ type_name }

global_qualifier = @{ "global::" }
global_qualified_name = @{ global_qualifier ~ ident_name ~ ("." ~ ident_name)* }
dotted_name = @{ global_qualifier? ~ ident_name ~ ("." ~ ident_name)* }

// ── Namespace ───────────────────────────────────────────────────────────────

namespace_declaration = {
    "namespace" ~ dotted_name ~ ("{" ~ program_item* ~ "}" | ";")
}

// ── Type declarations ───────────────────────────────────────────────────────

// `attribute_list*`, not `?` — §22.3 allows any number of bracketed sections
// on one target, and `class_member` already says so. Only the TOP-LEVEL form
// capped it at one, so `[A]\n[B]\nclass Thing{}` failed at the second.
type_declaration = _{
    attribute_list* ~ (record_struct_declaration | record_declaration | class_declaration | struct_declaration | interface_declaration | enum_declaration | delegate_declaration)
}

attribute_list = { "[" ~ (!"]" ~ ANY)* ~ "]" }

// ── Class ───────────────────────────────────────────────────────────────────

class_declaration = {
    class_modifiers ~ "class" ~ ident_name ~ generic_params? ~ primary_constructor_params? ~ base_list? ~ where_clauses? ~ class_body
}

primary_constructor_params = { "(" ~ (param ~ ("," ~ param)*)? ~ ")" }

// `where T : new()`, `where T : class`, `where T : IComparable<T>`, etc.
// Captured by the grammar but ignored by the walker — generic
// constraints are runtime-erased in the dynamic VM. Multiple
// constraints can chain.
where_clauses = _{ where_clause+ }
where_clause = { "where" ~ ident_name ~ ":" ~ where_constraint ~ ("," ~ where_constraint)* }
where_constraint = {
    "new" ~ "(" ~ ")"
    | "class" ~ !(ASCII_ALPHANUMERIC | "_")
    | "struct" ~ !(ASCII_ALPHANUMERIC | "_")
    | type_name
}

class_modifiers = { modifier* }

modifier = {
    "public" | "private" | "protected" | "internal"
    | static_kw | abstract_kw | sealed_kw | partial_kw
    | virtual_kw | override_kw | readonly_kw | "new"
    | async_kw | "const" | "volatile" | "extern" | required_kw | file_kw
}

// C# 11 `file` — file-local type visibility, and a CONTEXTUAL keyword like
// `required` beside it: it means "visible only in this file" in modifier
// position and stays a legal identifier everywhere else, so it is matched
// here and not reserved. A `file` type is `internal` narrowed to one file,
// and we compile a file at a time, so the narrowing is already in force.
file_kw = @{ "file" ~ !(ASCII_ALPHANUMERIC | "_") }

// C# 11 `required` — a CONTEXTUAL keyword: it only means "must be set by
// an object initializer" in modifier position, and stays a legal
// identifier everywhere else, so it is matched here and not reserved.
required_kw = @{ "required" ~ !(ASCII_ALPHANUMERIC | "_") }
static_kw = @{ "static" ~ !(ASCII_ALPHANUMERIC | "_") }
abstract_kw = @{ "abstract" ~ !(ASCII_ALPHANUMERIC | "_") }
sealed_kw = @{ "sealed" ~ !(ASCII_ALPHANUMERIC | "_") }
partial_kw = @{ "partial" ~ !(ASCII_ALPHANUMERIC | "_") }
virtual_kw = @{ "virtual" ~ !(ASCII_ALPHANUMERIC | "_") }
override_kw = @{ "override" ~ !(ASCII_ALPHANUMERIC | "_") }
readonly_kw = @{ "readonly" ~ !(ASCII_ALPHANUMERIC | "_") }
async_kw = @{ "async" ~ !(ASCII_ALPHANUMERIC | "_") }

generic_params = _{ "<" ~ generic_param_list ~ ">" }
generic_param_list = _{ generic_param ~ ("," ~ generic_param)* }
generic_param = _{ generic_variance? ~ ident_name }
generic_variance = _{ "in" | "out" }

base_list = { ":" ~ type_name ~ argument_list? ~ ("," ~ type_name)* }

class_body = { "{" ~ class_member* ~ "}" }

// ── Class members ───────────────────────────────────────────────────────────

class_member = {
    attribute_list* ~ class_modifiers ~ (
        // Nested type declarations — class / struct / interface / enum
        // can all appear as inner members per ECMA-334 §15.3.
        record_struct_declaration
        | record_declaration
        | class_declaration
        | struct_declaration
        | interface_declaration
        | enum_declaration
        | operator_declaration
        | explicit_interface_indexer_declaration
        | indexer_declaration
        | destructor_declaration
        | constructor_declaration
        | explicit_interface_method_declaration
        | explicit_interface_property_declaration
        | method_declaration
        | property_declaration
        | event_declaration
        | field_declaration
    )
}

// `public static T operator +(T a, T b) { ... }` — operator overloads.
// Walker lowers to a static method named `op_Addition` / `op_Equality`
// per ECMA-335 — the call-site dispatch (primitives/calls.rs) maps the
// binary `a + b` form back via the same canonical name when both
// operands are class instances.
operator_declaration = {
    ((conversion_operator_kind ~ "operator" ~ type_name) | (type_name ~ "operator" ~ operator_symbol)) ~
        "(" ~ param_list? ~ ")" ~
        (block_statement | expression_body)
}
conversion_operator_kind = { "implicit" | "explicit" }
operator_symbol = @{
    "==" | "!=" | "<=" | ">=" | "<<" | ">>" | "++" | "--"
    | "true" | "false"
    | "+" | "-" | "*" | "/" | "%" | "&" | "|" | "^"
    | "~" | "!" | "<" | ">"
}

// `public T this[Type idx] { get; set; }` — indexer property.
// Walker lowers to a Property named `__index__` with one parameter,
// so `obj[i]` lookups go through the same getter / setter machinery as
// regular properties.
// `System.Collections.IEnumerable.GetEnumerator()` — the interface may be
// named by its full path, not just a bare identifier (§15.6.7).
// ⛔ Each extra segment must be FOLLOWED by another dot. This rule is atomic
// and pest does not backtrack out of a successful repetition, so a plain
// `("." ~ ident_name)*` would swallow `.GetEnumerator` as well and then fail
// the specifier's own trailing `.` — breaking the single-segment spellings
// that already worked. The lookahead stops it exactly one segment short.
explicit_interface_name = @{ ident_name ~ ("." ~ ident_name ~ &".")* ~ generic_type_args? }
explicit_interface_specifier = { explicit_interface_name ~ "." }
indexer_name = { explicit_interface_specifier? ~ "this" }
explicit_interface_indexer_declaration = {
    type_name ~ explicit_interface_name ~ "." ~ "this" ~ "[" ~ param_list ~ "]" ~ property_body
}
indexer_declaration = {
    type_name ~ indexer_name ~ "[" ~ param_list ~ "]" ~ (property_body | expression_body)
}

// Constructor: ClassName(params) : base/this(args) { body }
// Also: `ClassName(params) => single_expr;` (C# 7+ expression-bodied ctor)
constructor_declaration = {
    ident_name ~ "(" ~ param_list? ~ ")" ~ constructor_initializer? ~ (block_statement | expression_body)
}

// `~ClassName() { ... }` — finalizer (ECMA-334 §15.13). Takes no parameters,
// has no modifiers and no return type. Must precede `constructor_declaration`
// in `class_member`: both are "name then parens", and only the leading `~`
// tells them apart.
destructor_declaration = {
    "~" ~ ident_name ~ "(" ~ ")" ~ (block_statement | expression_body)
}

constructor_initializer = {
    ":" ~ (base_kw | this_kw) ~ "(" ~ argument_list? ~ ")"
}

// Property: Type Name { get; set; } | { get { } set { } } | => expr;
// (C# 6+ expression-bodied read-only property is `Type Name => expr;`)
property_name = { explicit_interface_specifier? ~ ident_name }
explicit_interface_property_declaration = {
    type_name ~ explicit_interface_name ~ "." ~ ident_name ~ (expression_body | property_body ~ ("=" ~ expression ~ ";")?)
}
property_declaration = {
    type_name ~ property_name ~ (expression_body | property_body ~ ("=" ~ expression ~ ";")?)
}

property_body = {
    "{" ~ accessor+ ~ "}"
}

accessor = {
    class_modifiers ~ ("get" | "set" | "init") ~ (block_statement | expression_body | ";")
}

// Event: event EventHandler Click;
event_declaration = {
    // Field-like `event T E;` OR custom accessors `event T E { add {…} remove {…} }`.
    "event" ~ type_name ~ ident_name ~ (";" | "{" ~ event_accessor+ ~ "}")
}
event_accessor = { ("add" | "remove") ~ block_statement }

// Method: ReturnType Name(params) { body }
// Generic methods may declare per-method `where` constraints which we
// capture-and-discard, same as on the class.
method_name = { explicit_interface_specifier? ~ ident_name }
explicit_interface_method_declaration = {
    type_name ~ explicit_interface_name ~ "." ~ ident_name ~ generic_params? ~ "(" ~ param_list? ~ ")" ~
        where_clauses? ~ (block_statement | expression_body | ";")
}
method_declaration = {
    type_name ~ method_name ~ generic_params? ~ "(" ~ param_list? ~ ")" ~
        where_clauses? ~ (block_statement | expression_body | ";")
}

// Expression-bodied member (C# 6+): `=> expr;`. Lowers to `{ return expr; }`
// in the walker. Same rule serves methods, properties, indexers, operators.
// C# 7.0 §12.18: a `throw` EXPRESSION is legal in an expression body (also
// ternary arms and `??` operands — those routes come with their own tests).
// The walker normalizes `=> throw e` to a `{ throw e; }` body: the common
// tree keeps throw as a statement, and the quirk stays in the language layer.
expression_body   = { "=>" ~ (throw_expression | expression) ~ ";" }
throw_expression  = { "throw" ~ expression }

// Field: Type name = value; or Type name;
field_declaration = {
    type_name ~ var_declarator_list ~ ";"
}

var_declarator_list = { var_declarator ~ ("," ~ var_declarator)* }

// C# array initializer literal — `int[] arr = { 1, 2, 3 };` desugars to
// `new int[] { 1, 2, 3 }` per ECMA-334 §17.7. The bare-brace form is
// only allowed in variable / field declarators; the walker materialises
// the missing `new T[]` prefix from the declared type.
// ⚠ `System.Index idx = ^2;` IS STILL A PARSE ERROR, DELIBERATELY.
//
// Allowing `range_argument | from_end_index` here parses it — and produced a
// program that printed NOTHING and exited 0, which is worse than the error it
// replaced. `walk_index_part` is the only consumer of `from_end_index` and it
// lowers `^N` to `len(RECEIVER) - N`; a declarator has no receiver, because
// `Index` and `Range` are VALUES that carry "from the end" until something
// applies them. That is a value representation, not a grammar rule, and the
// grammar must not accept what nothing can build.
var_declarator = { ident_name ~ ("=" ~ ref_initializer? ~ (array_initializer | expression))? }

// The `ref` in `= ref val`. Consumed and discarded: what it aliases is decided
// by the declaration, not by the initializer.
ref_initializer = @{ "ref" ~ WHITESPACE+ ~ !("readonly" ~ !(ASCII_ALPHANUMERIC | "_")) }

// ── Struct ──────────────────────────────────────────────────────────────────

struct_declaration = {
    class_modifiers ~ ref_struct_kw? ~ "struct" ~ ident_name ~ generic_params? ~ primary_constructor_params? ~ base_list? ~ where_clauses? ~ class_body
}

// C# 7.2 `ref struct` / `readonly ref struct` — a stack-only struct. Everything
// the modifier means is a COMPILE-TIME restriction (no heap, no boxing, no
// async capture); the declared SHAPE is an ordinary struct, so it is accepted
// here and the walker needs no arm for it.
ref_struct_kw = @{ "ref" ~ !(ASCII_ALPHANUMERIC | "_") }

// ── Interface ───────────────────────────────────────────────────────────────

interface_declaration = {
    class_modifiers ~ "interface" ~ ident_name ~ generic_params? ~ base_list? ~ where_clauses? ~ interface_body
}

interface_body = { "{" ~ interface_member* ~ "}" }

interface_member = {
    attribute_list* ~ class_modifiers ~ (
        interface_operator_declaration
        | type_name ~ (
        ident_name ~ (
            // method — `;` (abstract) OR a default body (C# 8 default interface
            // methods: `T M() => expr;` or `T M() { ... }`).
            generic_params? ~ "(" ~ param_list? ~ ")" ~ where_clauses? ~ (expression_body | block_statement | ";")
            | "{" ~ ("get" ~ ";")? ~ ("set" ~ ";")? ~ "}"       // property
        )
        | "this" ~ "[" ~ param_list ~ "]" ~ "{" ~ ("get" ~ ";")? ~ ("set" ~ ";")? ~ "}"
        )
    )
}

interface_operator_declaration = {
    ((conversion_operator_kind ~ "operator" ~ type_name) | (type_name ~ "operator" ~ operator_symbol)) ~
        "(" ~ param_list? ~ ")" ~ ";"
}

// ── Enum ────────────────────────────────────────────────────────────────────

enum_declaration = {
    // Optional underlying type: `enum E : byte { ... }`. The values are still
    // plain integers at runtime, so the walker ignores the base type.
    class_modifiers ~ "enum" ~ ident_name ~ (":" ~ type_name)? ~ ("{" ~ enum_member_list? ~ ","? ~ "}")
}

enum_member_list = { enum_member ~ ("," ~ enum_member)* }

enum_member = { ident_name ~ ("=" ~ expression)? }

// ── Record ──────────────────────────────────────────────────────────────────

record_base_clause = { ":" ~ type_name ~ ("(" ~ argument_list? ~ ")")? }
record_struct_declaration = {
    class_modifiers ~ "record" ~ "struct" ~ ident_name ~ ("(" ~ param_list? ~ ")")? ~ record_base_clause? ~ (class_body | ";")
}
record_declaration = {
    class_modifiers ~ "record" ~ ident_name ~ ("(" ~ param_list? ~ ")")? ~ record_base_clause? ~ (class_body | ";")
}

// ── Delegate ────────────────────────────────────────────────────────────────

delegate_declaration = {
    class_modifiers ~ "delegate" ~ type_name ~ ident_name ~ generic_params? ~ "(" ~ param_list? ~ ")" ~ ";"
}

// ── Statements ──────────────────────────────────────────────────────────────

statement = _{
    empty_statement
    | block_statement
    | checked_statement
    // `label:` prefix — lowered to `StmtKind::Labeled`, the same structured
    // control-flow path C `goto`/labels use. Before the declaration/expression
    // arms so the `ident :` prefix is recognized as a label.
    | labeled_statement
    | goto_statement
    // `var (a, b) = f();` — tuple deconstruction declaration. Listed
    // before `local_var_declaration` so the `(` token is committed to
    // the deconstruction parse before the general `var name = expr;`
    // path consumes `var`.
    | tuple_deconstruction_decl
    // C# 7+ local functions / C# 9+ top-level functions:
    // `ReturnType Name(params) { body }`. Listed before
    // `local_var_declaration` so the `(` after the name commits to
    // the local-function parse rather than failing the var parse.
    | local_function_decl
    | using_declaration
    | unsafe_statement
    | fixed_statement
    | local_var_declaration
    | if_statement
    | for_statement
    | foreach_statement
    | while_statement
    | do_while_statement
    | switch_statement
    | return_statement
    | yield_statement
    | break_statement
    | continue_statement
    | throw_statement
    | try_statement
    | using_statement
    | lock_statement
    | expression_statement
}

// Local / top-level function. Same shape as a class method but lives
// in a statement context. Walker emits `StmtKind::FunctionDecl`.
local_function_decl = {
    class_modifiers ~ type_name ~ ident_name ~ generic_params? ~ "(" ~ param_list? ~ ")" ~
        where_clauses? ~ (block_statement | expression_body)
}

empty_statement = { ";" }

block_statement = { "{" ~ statement* ~ "}" }

checked_statement = { ("checked" | "unchecked") ~ block_statement }
unsafe_statement = { "unsafe" ~ block_statement }
fixed_statement = { "fixed" ~ "(" ~ local_var_declaration_no_semi ~ ")" ~ statement }

// ── Variable declaration ────────────────────────────────────────────────────

local_var_declaration = {
    const_kw? ~ ref_readonly_local? ~ (var_kw | type_name) ~ var_declarator_list ~ ";"
}

// §13.6.3 local constants. `const` was a `modifier` — reachable on a class
// MEMBER and nowhere else — so `const int step = 5;` inside a method failed at
// the type. Accepted and dropped: immutability is enforced at compile time in
// C#, and nothing downstream reads it.
const_kw = @{ "const" ~ !(ASCII_ALPHANUMERIC | "_") }

// `ref readonly int r = ref val;` — a read-only alias (§9.7, §12.7.3).
//
// ⛔ Only the READONLY form. A `ref readonly` local cannot be written through,
// so the sole way any program can distinguish it from a copy is to mutate the
// SOURCE and read the alias again — and the walker lowers it to a copy on
// exactly that basis.
//
// A mutable `ref int alias = ref val;` is deliberately left unparsed. It is a
// true alias: `alias = 99` must be visible through `val`, which needs a
// per-declarator reference binding the AST does not carry (`reference_binding`
// is a MODULE-wide directive, not a per-declaration one). Accepting it here
// would turn a visible parse failure into a silently wrong answer.
ref_readonly_local = @{ "ref" ~ WHITESPACE+ ~ "readonly" ~ !(ASCII_ALPHANUMERIC | "_") }

var_kw = @{ "var" ~ !(ASCII_ALPHANUMERIC | "_") }

// `var (a, b, c) = expr;` — tuple deconstruction declaration.
// Introduces N fresh locals and destructures an N-tuple into them.
// Pairs with the compiler's multi-value receive path when the RHS is
// a direct call to a multi-return function.
// ECMA-334 §12.21.2 gives deconstruction two DECLARING spellings, and only the
// first parsed: one leading `var` covering every element, or a type on each
// element individually. The second form carries no `var` at all, so a file
// using `(string tag, int val) = item;` failed at the parser and never reached
// the deconstruction lowering below — which handles it unchanged, because the
// per-element types are declarations, not part of the lowered pattern.
tuple_deconstruction_decl = {
    var_kw ~ tuple_binding_list ~ "=" ~ expression ~ ";"
    | tuple_declaration_list ~ "=" ~ expression ~ ";"
}

// Each element declares its own name: `(int a, string b)`, `(var a, var b)`.
//
// Requires TWO tokens per element, which is what keeps this from swallowing
// `(a, b) = e` — assignment to already-declared variables, a parenthesized
// expression the ordinary assignment path owns. Two or more elements, matching
// `tuple_type`: a one-element `(int a)` is a parenthesized declaration, not a
// tuple.
tuple_declaration_list = {
    "(" ~ tuple_declaration_element ~ ("," ~ tuple_declaration_element)+ ~ ")"
}

tuple_declaration_element = {
    tuple_declaration_list
    | var_kw ~ ident_name
    | type_name ~ ident_name
}

tuple_binding_list = {
    "(" ~ tuple_binding_pattern ~ ("," ~ tuple_binding_pattern)* ~ ")"
}

tuple_binding_pattern = {
    ident_name
    | tuple_binding_list
}

// ── If ──────────────────────────────────────────────────────────────────────

if_statement = {
    "if" ~ "(" ~ expression ~ ")" ~ statement ~ (else_if_clause)* ~ else_clause?
}

else_if_clause = {
    "else" ~ "if" ~ "(" ~ expression ~ ")" ~ statement
}

else_clause = {
    "else" ~ statement
}

// ── For ─────────────────────────────────────────────────────────────────────

for_statement = {
    "for" ~ "(" ~ for_init? ~ ";" ~ expression? ~ ";" ~ for_update? ~ ")" ~ statement
}

for_init = { local_var_declaration_no_semi | expression_list }

local_var_declaration_no_semi = {
    (var_kw | type_name) ~ var_declarator_list
}

for_update = { expression_list }

expression_list = { expression ~ ("," ~ expression)* }

// ── Foreach ─────────────────────────────────────────────────────────────────

foreach_statement = {
    // `await foreach (...)` — async-stream consumption. The optional marker
    // flags the loop `is_async` so it drains via the shared async-iterator
    // path (`Symbol.asyncIterator`), exactly like JS `for await (...)`.
    foreach_await_marker? ~ "foreach" ~ "(" ~ (var_kw | type_name) ~ foreach_target ~ in_kw ~ expression ~ ")" ~ statement
}
foreach_await_marker = @{ "await" ~ !(ASCII_ALPHANUMERIC | "_") }

// `goto label;`, `goto case <expr>;`, `goto default;`. The walker lowers the
// label form via the relooper (structured control flow); `goto case`/`default`
// are switch-scoped jumps.
goto_kw = @{ "goto" ~ !(ASCII_ALPHANUMERIC | "_") }
goto_statement = { goto_kw ~ goto_target ~ ";" }
goto_target = { ("case" ~ expression) | "default" | ident_name }
// `label:` — a standalone label (goto target). Kept separate from the
// following statement so the relooper sees a flat `StmtKind::Label` marker,
// matching C's `lower_c_gotos` block-splitting.
labeled_statement = { ident_name ~ ":" ~ !":" }

foreach_target = { foreach_tuple_target | ident_name }
foreach_tuple_target = { "(" ~ ident_name ~ ("," ~ ident_name)+ ~ ","? ~ ")" }

// ── While / Do-while ────────────────────────────────────────────────────────

while_statement = { "while" ~ "(" ~ expression ~ ")" ~ statement }

do_while_statement = { "do" ~ statement ~ "while" ~ "(" ~ expression ~ ")" ~ ";" }

// ── Switch ──────────────────────────────────────────────────────────────────

switch_statement = {
    "switch" ~ "(" ~ expression ~ ")" ~ "{" ~ switch_section* ~ "}"
}

switch_section = {
    switch_label+ ~ statement+
}

switch_label = {
    case_value_label
    | case_pattern_label
    | "default" ~ ":"
}

// A `[` after `case` is always a list pattern (`case [1, 2]:`), never a value —
// the negative lookahead keeps it out of the expression path so it reaches
// `case_pattern_label`.
case_value_label = { "case" ~ !"[" ~ expression ~ ":" }
case_pattern_label = { "case" ~ switch_case_pattern ~ ("when" ~ expression)? ~ ":" }
switch_case_pattern = { pattern_clause }

// ── Jump statements ─────────────────────────────────────────────────────────

return_statement = { "return" ~ expression? ~ ";" }
break_statement = { "break" ~ ";" }
continue_statement = { "continue" ~ ";" }
throw_statement = { "throw" ~ expression? ~ ";" }

/// `yield return expr;` / `yield break;` — C# generator syntax. Any
/// method body that contains `yield return`/`yield break` is treated
/// as a generator; the compiler sets `chunk.is_generator = true` and
/// each `yield return` lowers to `Op::SUSPEND`. `yield break` ends the
/// generator (maps to `return`).
yield_statement = {
    "yield" ~ "return" ~ expression ~ ";"
    | "yield" ~ "break" ~ ";"
}

// ── Try / Catch / Finally ───────────────────────────────────────────────────

try_statement = {
    "try" ~ block_statement ~ catch_clause* ~ finally_clause?
}

// `catch (T e) when (cond) { ... }` — the optional `when` filter
// guards the catch arm. Walker lowers it to `if (!cond) throw e;`
// at the top of the catch body so the compiler stays unaware.
catch_clause = {
    "catch" ~ ("(" ~ type_name ~ ident_name? ~ ")")? ~ catch_when_filter? ~ block_statement
}
catch_when_filter = {
    "when" ~ "(" ~ expression ~ ")"
}

finally_clause = { "finally" ~ block_statement }

// ── Using statement ─────────────────────────────────────────────────────────

using_declaration = {
    "using" ~ (var_kw | type_name) ~ ident_name ~ "=" ~ expression ~ ";"
}

using_statement = {
    "using" ~ "(" ~ (var_kw | type_name) ~ ident_name ~ "=" ~ expression ~ ")" ~ statement
    // §13.14 also takes a plain EXPRESSION — `using (r) { … }` over an
    // already-declared disposable. Second, so the declaring form above still
    // wins: `var x = e` is not an expression and would fail here anyway, but
    // relying on that would make the order load-bearing by accident.
    | "using" ~ "(" ~ expression ~ ")" ~ statement
}

// ── Lock statement ──────────────────────────────────────────────────────────

lock_statement = {
    "lock" ~ "(" ~ expression ~ ")" ~ statement
}

// ── Expression statement ────────────────────────────────────────────────────

expression_statement = { expression ~ ";" }

// ── Expressions ─────────────────────────────────────────────────────────────

expression = { query_expression | assignment_expression }

query_expression = { q_from_clause ~ query_body }
q_from_clause = { "from" ~ ident_name ~ "in" ~ expression }
query_body = { query_body_clause* ~ query_select_or_group_clause ~ query_continuation? }
query_body_clause = { q_from_clause | q_let_clause | q_where_clause | q_join_clause | q_orderby_clause }
query_select_or_group_clause = { q_select_clause | q_group_clause }
query_continuation = { "into" ~ ident_name ~ query_body }
q_where_clause = { "where" ~ expression }
q_let_clause = { "let" ~ ident_name ~ "=" ~ expression }
q_join_clause = { "join" ~ ident_name ~ "in" ~ expression ~ "on" ~ expression ~ "equals" ~ expression }
q_orderby_clause = { "orderby" ~ q_ordering ~ ("," ~ q_ordering)* }
q_ordering = { expression ~ q_order_direction? }
q_order_direction = { "ascending" | "descending" }
q_select_clause = { "select" ~ expression }
q_group_clause = { "group" ~ expression ~ "by" ~ expression }

assignment_expression = {
    lambda_expression
    | conditional_expression ~ (assignment_op ~ assignment_expression)?
}

assignment_op = {
    ">>=" | "<<=" |
    "+=" | "-=" | "*=" | "/=" | "%=" |
    "&=" | "|=" | "^=" |
    "??=" |
    "="
}

// Lambda: (params) => expr/body  or  x => expr/body
lambda_expression = {
    async_kw? ~ ("(" ~ param_list? ~ ")" | ident_name) ~ "=>" ~ lambda_body
}

lambda_body = { block_statement | expression }

conditional_expression = {
    null_coalesce_expr ~ ("?" ~ expression ~ ":" ~ expression)?
}

// Null coalescing
null_coalesce_expr = { logical_or ~ (nullcoalesce_op ~ (throw_expression | logical_or))* }
nullcoalesce_op = { "??" ~ !"=" }

// Logical OR
logical_or = { logical_and ~ (or_op ~ logical_and)* }
or_op = { "||" ~ !"=" }

// Logical AND
logical_and = { bitwise_or ~ (and_op ~ bitwise_or)* }
and_op = { "&&" ~ !"=" }

// Bitwise OR
bitwise_or = { bitwise_xor ~ (bitor_op ~ bitwise_xor)* }
bitor_op = { "|" ~ !("=" | "|") }

// Bitwise XOR
bitwise_xor = { bitwise_and ~ (bitxor_op ~ bitwise_and)* }
bitxor_op = { "^" ~ !"=" }

// Bitwise AND
bitwise_and = { equality ~ (bitand_op ~ equality)* }
bitand_op = { "&" ~ !("=" | "&") }

// Equality
equality = { relational ~ (equality_op ~ relational)* }
equality_op = { "==" | "!=" }

// Relational + type testing + shift
// is/as are postfix-style (no right operand in the binary chain).
// `switch` (C# 8 expression) and `with` (C# 9 record clone) are also
// postfix here.
relational = { additive ~ (type_test | switch_expr_postfix | with_expr_postfix | binary_relational)* }

// `record_value with { Prop = val, ... }` — clone-and-modify (C# 9
// records). Walker lowers to `(rec, props) → cloneObject(rec, props)`.
with_expr_postfix = {
    "with" ~ object_initializer
}
type_test = {
    is_kw ~ pattern_clause
    | as_kw ~ type_name
}

// C# 8 switch expression: `expr switch { pattern => result, ... }`.
// Walker lowers each arm into a nested ternary so we don't need a
// dedicated SwitchExpr AST node.
switch_expr_postfix = {
    "switch" ~ "{" ~ switch_arm ~ ("," ~ switch_arm)* ~ ","? ~ "}"
}
switch_arm = {
    switch_pattern ~ ("when" ~ expression)? ~ "=>" ~ expression
}
switch_pattern = { switch_pat_and ~ ("or" ~ switch_pat_and)* }
switch_pat_and = { switch_pat_primary ~ ("and" ~ switch_pat_primary)* }
switch_pat_primary = {
    list_pattern
    | "_" ~ !(ASCII_ALPHANUMERIC | "_")
    | (">=" | "<=" | ">" | "<") ~ expression
    | var_kw ~ ident_name
    // Before `type_name ~ ident_name` and the `expression` fallback: both would
    // consume the type and leave `{ … }` stranded.
    | property_pattern
    | type_name ~ ident_name
    | expression
}

// C# pattern matching surfaces under `is` (and switch expressions).
// We cover the spec's core forms — null / not-null / constant / type
// (with optional ident binding), relational, and property patterns.
// List patterns still fall through to the type-name path.
pattern_clause = {
    "not" ~ pattern_atom
    | pattern_atom ~ (pattern_and_kw ~ pattern_atom)*
}
pattern_and_kw = { "and" }
pattern_atom = {
    list_pattern                   // `is [1, 2]` / `is [var a, .., var b]`
    | null_kw                      // `is null`
    | true_kw                      // `is true`
    | false_kw                     // `is false`
    | char_literal                 // `is 'x'`
    | negative_numeric_pattern     // `is -5` — before numeric_literal, which is unsigned
    | numeric_literal              // `is 0`
    | string_literal               // `is "x"`
    | relational_pattern           // `is >= 0`
    | tuple_pattern                // `is (1, _)`
    | var_pattern                  // `is var x`
    // Before the bare-type alternative: both start with a type, and that one
    // would otherwise consume `Point` and leave `{ X: 1 }` unparsed.
    | property_pattern             // `is Point { X: 1, Y: var y }`
    | pattern_type ~ ident_name?   // `is string s` / `is int`
}
// C# 8 property pattern. The type is optional (`is { Length: 0 }` tests the
// members of whatever the subject already is). Each subpattern's value is a
// full `pattern_clause`, so `{ Lo: >=1 and <=9 }` nests naturally.
// The trailing designation (`is Point { X: 1 } p`) must not swallow a following
// `when` guard — `Item { Q: var q } when q > 10` would otherwise bind a variable
// named `when` and strand the guard.
property_pattern = {
    pattern_type? ~ "{" ~ (property_subpattern ~ ("," ~ property_subpattern)*)? ~ ","? ~ "}" ~ (!when_kw ~ ident_name)?
}
when_kw = @{ "when" ~ !(ASCII_ALPHANUMERIC | "_") }
// A subpattern value admits `or` (`{ Kind: "err" or "fail" }`), which
// `pattern_clause` itself does not.
// ⛔ THE NAME IS A CHAIN. C# 10 extended property patterns nest without a
// nested brace: `is { Info.Code: 1 }` is `is { Info: { Code: 1 } }`. Matching
// one `ident_name` failed the whole `is` at the dot, so every extended pattern
// was a parse error rather than a semantic gap.
property_subpattern = { ident_name ~ ("." ~ ident_name)* ~ ":" ~ property_pattern_value }
property_pattern_value = { pattern_clause ~ (pattern_or_kw ~ pattern_clause)* }
pattern_or_kw = { "or" }
pattern_type = { base_type ~ generic_type_args? ~ array_rank* }
// `numeric_literal` is unsigned, so a negative constant pattern needs its own
// rule — `{ D: -5 }` / `is -5`.
negative_numeric_pattern = { "-" ~ numeric_literal }
relational_pattern = { (">=" | "<=" | ">" | "<") ~ expression }
tuple_pattern = { "(" ~ tuple_pattern_item ~ ("," ~ tuple_pattern_item)+ ~ ","? ~ ")" }
tuple_pattern_item = { "_" ~ !(ASCII_ALPHANUMERIC | "_") | expression }
var_pattern = { var_kw ~ ident_name }
// C# 11 list patterns: `is [1, 2]`, `[var a, _, var b]`, slices `[.., 7]`,
// `[1, .., 5]`, `[var head, ..var rest]`. A `slice_pattern` (`..`) may appear
// at most once; everything else is a per-element `pattern_clause` or `_`.
list_pattern = { "[" ~ (list_pattern_elem ~ ("," ~ list_pattern_elem)*)? ~ ","? ~ "]" }
list_pattern_elem = { slice_pattern | list_discard | pattern_clause }
slice_pattern = { ".." ~ (var_kw ~ ident_name)? }
list_discard = { "_" ~ !(ASCII_ALPHANUMERIC | "_") }
binary_relational = { relational_op ~ additive }
relational_op = {
    shift_op | "<=" | ">=" | "<" ~ !"<" | ">" ~ !">"
}
shift_op = { ">>" ~ !(">" | "=") | "<<" ~ !"=" }

// Additive
additive = { multiplicative ~ (additive_op ~ multiplicative)* }
additive_op = { "+" ~ !("+" | "=") | "-" ~ !("-" | "=") }

// Multiplicative
multiplicative = { unary ~ (multiplicative_op ~ unary)* }
multiplicative_op = { "*" ~ !("*" | "=") | "/" ~ !"=" | "%" ~ !"=" }

// Unary
unary = {
    cast_expression
    | unary_op ~ unary
    | postfix
}

// C# explicit cast: `(TypeName)expr`. Restricted to recognised type
// names to avoid ambiguity with parenthesised expressions
// (`(x)+y` should still parse as add of `(x)` and `+y`). Primitive
// type keywords always indicate a cast; user-defined type names
// are heuristic — pest backtracks to the postfix path if the
// alternative doesn't fit.
cast_expression = { "(" ~ cast_type ~ ")" ~ unary }
cast_type = {
    base_type ~ generic_type_args? ~ nullable_marker? ~ pointer_marker* ~ array_rank*
    | tuple_type
}

// Keyword operators — atomic for word boundaries
this_kw = @{ "this" ~ !(ASCII_ALPHANUMERIC | "_") }
base_kw = @{ "base" ~ !(ASCII_ALPHANUMERIC | "_") }
true_kw = @{ "true" ~ !(ASCII_ALPHANUMERIC | "_") }
false_kw = @{ "false" ~ !(ASCII_ALPHANUMERIC | "_") }
null_kw = @{ "null" ~ !(ASCII_ALPHANUMERIC | "_") }
typeof_kw = @{ "typeof" ~ !(ASCII_ALPHANUMERIC | "_") }
nameof_kw = @{ "nameof" ~ !(ASCII_ALPHANUMERIC | "_") }
default_kw = @{ "default" ~ !(ASCII_ALPHANUMERIC | "_") }
new_kw = @{ "new" ~ !(ASCII_ALPHANUMERIC | "_") }
is_kw = @{ "is" ~ !(ASCII_ALPHANUMERIC | "_") }
as_kw = @{ "as" ~ !(ASCII_ALPHANUMERIC | "_") }
in_kw = @{ "in" ~ !(ASCII_ALPHANUMERIC | "_") }
await_kw = @{ "await" ~ !(ASCII_ALPHANUMERIC | "_") }

unary_op = {
    "-" ~ !("-" | "=")
    | "+" ~ !("+" | "=")
    | "*" ~ !("*" | "=")
    | "&" ~ !"="
    | "!" ~ !"="
    | "~"
    | "++"
    | "--"
    | await_kw
}

postfix = { call_expression ~ postfix_op? }
postfix_op = { "++" | "--" }

// ── Call / Member / Index chain ─────────────────────────────────────────────

call_expression = {
    (stackalloc_expression | new_expression | primary) ~ call_chain*
}

// `stackalloc T[n]` / `stackalloc T[n] { a, b }`. Stack allocation has no
// meaning on a GC/array runtime — a `Span<T>` IS the array — so this parses to
// the same shape as `new T[n] { … }` and the walker lowers it identically.
stackalloc_expression = {
    stackalloc_kw ~ type_name_for_new ~ "[" ~ expression? ~ "]" ~ array_initializer?
}
stackalloc_kw = @{ "stackalloc" ~ !(ASCII_ALPHANUMERIC | "_") }

new_expression = {
    // C# 7 tuple-typed array creation: `new (int Id, string Tag)[] { (1, "A") }`.
    // `tuple_type` already absorbs the trailing `[]` through its `array_rank*`.
    //
    // MUST come before the target-typed arm below, which would otherwise try
    // to read `int Id, string Tag` as an ARGUMENT LIST and fail the parse.
    // The initializer is REQUIRED, not optional, and that is what keeps
    // `new (x, y)` — target-typed new with two arguments — parsing as a call:
    // its operands are identifiers, so they satisfy `base_type` and would
    // otherwise match `tuple_type` here.
    new_kw ~ tuple_type ~ array_initializer
    |
    // C# 9 target-typed new: `new()` / `new() { ... }`. The walker
    // normalizes the initializer shape; the declaration's type hint
    // supplies the target type downstream.
    new_kw ~ "(" ~ argument_list? ~ ")" ~ (object_initializer | array_initializer)?
    |
    // C# 3+ implicit-typed array creation: `new[] { 1, 2 }`. The
    // element type is inferred from the initializer.
    new_kw ~ "[" ~ "]" ~ array_initializer
    |
    // C# 3+ anonymous type: `new { Name = x, x.Age }`. No type name; the
    // walker lowers it to a property-bag object, inferring member names for
    // bare member-access elements (`x.Age` → property `Age`).
    new_kw ~ anonymous_initializer
    | new_kw ~ type_name_for_new ~ (
        // Multi-bracket forms `new int[3][]`, `new int[3,4]`, `new int[5]`,
        // `new int[]` — a sequence of bracketed dimensions, optionally
        // followed by an array initializer for the leading dimensions.
        ("[" ~ (expression ~ ("," ~ expression)*)? ~ "]")+ ~ array_initializer?
        | "(" ~ argument_list? ~ ")" ~ (object_initializer | array_initializer)? // new Foo(args) { }
        // `object_initializer` BEFORE `array_initializer` — both start with
        // `{` but `Prop = value` shapes only match the object form, while
        // `array_initializer` would greedily consume them as ASSIGN
        // expressions and lose the property names.
        | object_initializer                                // new Foo { prop = val }
        | array_initializer                                 // new int[] { 1, 2 }
    )?
}

// The trailing `?` is C# 8 element/type nullability (`new string?[3]`).
// Only consumed when `[` follows, so `new C() ? a : b` — where the `?` is a
// TERNARY — keeps parsing as before.
type_name_for_new = { type_name_for_new_segment ~ ("." ~ type_name_for_new_segment)* ~ ("?" ~ &"[")? }
type_name_for_new_segment = { ident_or_keyword ~ generic_type_args? }

// §12.8.18 also admits the UNBOUND form — `typeof(List<>)`,
// `typeof(Dictionary<,>)` — where the commas state the arity and no argument
// is named. It is only legal inside `typeof`, but accepting it generally costs
// nothing: `<>` and `<,>` are not valid anywhere else, so no other construct
// can match them by accident.
generic_type_args = _{
    "<" ~ type_name ~ ("," ~ type_name)* ~ ">"
    | unbound_generic_args
}

unbound_generic_args = { "<" ~ ","* ~ ">" }

// Collection initializer literal — accepts either flat expressions
// (`new int[] { 1, 2, 3 }`, `new List<int> { 1, 2 }`,
// `new HashSet<int> { 1, 2 }`) or nested-brace pairs/tuples
// (`new Dictionary<K,V> { { "a", 1 } }`, `int[,] m = { { 1, 2 } }`).
// The walker dispatches on the receiver type to decide whether nested
// braces become Object properties (Dictionary) or nested Array
// literals (multi-dim).
array_initializer = { "{" ~ (collection_element ~ ("," ~ collection_element)*)? ~ ","? ~ "}" }
indexer_initializer = { "[" ~ expression ~ "]" ~ "=" ~ expression }
collection_element = {
    indexer_initializer
    | "{" ~ (expression ~ ("," ~ expression)*)? ~ ","? ~ "}"
    | expression
}

object_initializer = { "{" ~ (initializer_member ~ ("," ~ initializer_member)*)? ~ ","? ~ "}" }

initializer_member = { ident_name ~ "=" ~ expression }

// Anonymous-type initializer: each member is either `Name = expr` or a bare
// expression whose name is inferred (`x.Age` → `Age`, `id` → `id`).
anonymous_initializer = { "{" ~ (anonymous_member ~ ("," ~ anonymous_member)*)? ~ ","? ~ "}" }
anonymous_member = { (ident_name ~ "=" ~ !"=")? ~ expression }

call_chain = {
    "?." ~ ident_or_keyword                              // null-conditional member
    | "?[" ~ index_expression ~ "]"                    // null-conditional indexer
    | "(" ~ argument_list? ~ ")"                          // call
    | "." ~ ident_or_keyword ~ generic_type_args?         // member access
    | "[" ~ index_expression ~ "]"                        // index / range / from-end
    | null_forgiving                                      // `x!` — compile-time only, emits nothing
}
// C# 8 null-forgiving `!`: whole meaning is "suppress the nullability
// warning" — there is no runtime half, so the walker skips the segment.
// The lookahead keeps `x != y` and `x!` at expression end out: only `!`
// followed by more chain is the operator.
null_forgiving = { "!" ~ &("." | "[" | "(") }

// C# 8 index-from-end: `arr[^1]` is `arr[arr.Length - 1]`. C# 8 ranges:
// `arr[1..3]`, `arr[..^1]`, `arr[^3..]`, `arr[..]`. Multi-dimensional
// arrays use comma-separated indices (`m[0, 0]`) which lower to a
// flattened single-arg index since our backing array is a 1-D shape
// (the walker concatenates the args via repeated index lookups in
// nested arrays). The walker maps each shape onto Index / Range AST
// nodes.
index_expression = {
    from_end_index ~ ".." ~ from_end_index?               // `arr[^3..]` / `arr[^3..^1]`
    | from_end_index ~ ".." ~ expression                  // `arr[^3..5]`
    | from_end_index                                       // `arr[^1]`
    | expression ~ ".." ~ from_end_index                  // `arr[1..^1]`
    | expression ~ ("..") ~ expression?                   // `arr[1..3]` / `arr[1..]`
    | (".." ~ from_end_index)                             // `arr[..^1]`
    | (".." ~ expression?)                                // `arr[..5]` / `arr[..]`
    | expression ~ ("," ~ expression)+                    // `m[i, j]` multi-dim
    | expression                                           // `arr[i]`
}

from_end_index = { "^" ~ expression }

// `1..4`, `..4`, `1..`, `^3..^1` in a VALUE position. Same shapes as
// `index_expression`'s range arms, minus the non-range ones — a bare
// `expression` here would match everything and the `..` would never be seen.
// ⛔ ENDPOINTS ARE SIMPLE PRIMARIES, NOT `expression`.
//
// This rule is tried BEFORE `expression` in `argument`, so its cost is paid on
// every argument in the program, whether or not a range is present. Written
// with `expression` endpoints it parsed each argument in full, failed on the
// absent `..`, backtracked and parsed it again — doubling per nesting level.
// Measured: `__P((new Label("")==new Label("")).ToString())` took 176 SECONDS
// of CPU on a 729-byte file, which reads as a hang and was very nearly filed
// as one.
//
// A simple primary fails fast, and it is also all a range endpoint can
// usefully be: `1..4`, `^3..^1`, `..n`, `arr.Length..`. Anything richer needs
// parentheses, which `primary_range_endpoint` accepts.
range_argument = {
    range_endpoint? ~ ".." ~ range_endpoint?
}

range_endpoint = {
    from_end_index
    | "(" ~ expression ~ ")"
    | numeric_literal
    | dotted_name
}

argument_list = { argument ~ ("," ~ argument)* ~ ","? }

argument = {
    // C# `out var x` — declares a fresh local from the call site.
    "out" ~ (var_kw | type_name) ~ ident_name
    | ("ref" | "out") ~ expression
    // Named argument: `name: expr`. The leading ident is reified as
    // `ident_name` so the walker can extract it; the colon disambiguates
    // from the bare-expression alternative below.
    | ident_name ~ ":" ~ !":" ~ expression
    // A `System.Range` used as an ordinary VALUE — `nums.Take(1..4)`. §12.8.12
    // makes `a..b` an expression, not indexer-only syntax, but `..` appears in
    // this grammar solely inside `index_expression`, so a range reaching an
    // argument position failed the parse at the first dot.
    //
    // Declared here rather than in `expression`: `..` there would have to be
    // disambiguated against `slice_pattern`, `collection_expression_element`
    // and the index forms, and every one of those already owns its own `..`.
    | range_argument
    | expression
}

// ── Primary expressions ─────────────────────────────────────────────────────

primary = {
    tuple_literal                    // (a, b, c) — must come before paren_expr
    | "(" ~ expression ~ ")"           // parenthesized
    | collection_expression
    | typeof_expression
    | nameof_expression
    | default_expression
    | checked_expression
    | raw_interpolated_string
    | raw_string
    | interpolated_string
    | verbatim_string
    | char_literal
    | this_kw
    | base_kw
    | true_kw
    | false_kw
    | null_kw
    | numeric_literal
    | string_literal
    | primitive_type_ident
    | generic_type_expr
    | global_qualified_name
    | ident_name
}

// C# 12 collection expression: `[1, 2, ..items]`. Target typing is
// handled in the walker/normalizer; the expression shape here is the
// common JS-style array literal with spread elements.
collection_expression = { "[" ~ (collection_expression_element ~ ("," ~ collection_expression_element)*)? ~ ","? ~ "]" }
collection_expression_element = { ".." ~ expression | expression }

generic_type_expr = { base_type ~ generic_type_args }

// C# tuple literal: (1, "x", true) or named (Name: "Alice", Age: 30).
// At least 2 elements (1-element is just paren_expr). The named form
// per ECMA-334 §11.7.4 — each element optionally prefixed with `Name:`
// which becomes an Item-aliased property on the tuple.
tuple_literal = { "(" ~ tuple_element ~ ("," ~ tuple_element)+ ~ ","? ~ ")" }
tuple_element = { (ident_name ~ ":" ~ !":")? ~ expression }

// C# allows primitive type names as identifier prefixes for static method calls:
// `string.Join(",", arr)`, `int.Parse("42")`, `bool.Parse("true")`, etc.
primitive_type_ident = @{
    ("string" | "int" | "double" | "float" | "bool" | "char" | "long" | "byte"
    | "short" | "decimal" | "object" | "uint" | "ulong" | "ushort" | "sbyte")
    ~ !(ASCII_ALPHANUMERIC | "_")
}

typeof_expression = { typeof_kw ~ "(" ~ type_name ~ ")" }
nameof_expression = { nameof_kw ~ "(" ~ dotted_name ~ ")" }
default_expression = { default_kw ~ ("(" ~ type_name ~ ")")? }
checked_expression = { ("checked" | "unchecked") ~ "(" ~ expression ~ ")" }

// ── Interpolated strings ────────────────────────────────────────────────────
// Parsed atomically as a raw string, then split into parts in the walker.
// This prevents pest's WHITESPACE from eating spaces between text and {expr}.

interpolated_string = @{
    ("$@\"" | "@$\"" | "$\"") ~ interp_content* ~ "\""
}

interp_content = _{ interp_escape_open | interp_escape_close | interp_hole | interp_char }
interp_escape_open = _{ "{{" }
interp_escape_close = _{ "}}" }
interp_hole = _{ "{" ~ (!"}" ~ ANY)* ~ "}" }
interp_char = _{ !"\"" ~ !"{" ~ ANY }

// ── Verbatim strings ────────────────────────────────────────────────────────

verbatim_string = @{ "@\"" ~ ("\"\"" | !"\"" ~ ANY)* ~ "\"" }

// ── Raw strings ────────────────────────────────────────────────────────────
// C# raw strings use a delimiter of 3+ quotes. Pest cannot back-reference the
// delimiter length, so cover the lengths used by the conformance tests and put
// longer delimiters first so `""""""x""""""` is not consumed as `"""`.

raw_interpolated_string = @{
    "$" ~ (raw_string_empty_7 | raw_string_7 | raw_string_6 | raw_string_empty | raw_string_5 | raw_string_4 | raw_string_3)
}

raw_string = @{
    raw_string_empty_7 | raw_string_7 | raw_string_6 | raw_string_empty | raw_string_5 | raw_string_4 | raw_string_3
}

raw_string_empty_7 = { "\"\"\"\"\"\"\"" }
raw_string_7 = { "\"\"\"\"\"\"\"" ~ (!"\"\"\"\"\"\"\"" ~ ANY)* ~ "\"\"\"\"\"\"\"" }
raw_string_6 = { "\"\"\"\"\"\"" ~ (!"\"\"\"\"\"\"" ~ ANY)* ~ "\"\"\"\"\"\"" }
raw_string_empty = { "\"\"\"\"\"\"" }
raw_string_5 = { "\"\"\"\"\"" ~ (!"\"\"\"\"\"" ~ ANY)* ~ "\"\"\"\"\"" }
raw_string_4 = { "\"\"\"\"" ~ (!"\"\"\"\"" ~ ANY)* ~ "\"\"\"\"" }
raw_string_3 = { "\"\"\"" ~ (!"\"\"\"" ~ ANY)* ~ "\"\"\"" }

// ── Char literal ────────────────────────────────────────────────────────────

char_literal = @{ "'" ~ (
    "\\u" ~ ASCII_HEX_DIGIT{4}
    | "\\U" ~ ASCII_HEX_DIGIT{8}
    | "\\x" ~ ASCII_HEX_DIGIT+
    | "\\" ~ ANY
    | !"'" ~ ANY
) ~ "'" }

// ── Literals ────────────────────────────────────────────────────────────────

numeric_literal = @{
    ("0x" | "0X") ~ ASCII_HEX_DIGIT ~ (ASCII_HEX_DIGIT | "_")* ~ numeric_suffix?
    | ("0b" | "0B") ~ ('0'..'1') ~ ('0'..'1' | "_")* ~ numeric_suffix?
    // Decimal: a `.` followed by another `.` is NOT a decimal point — it's a
    // range operator (`1..3`). Negative lookahead prevents the literal from
    // greedily eating the first `.` of a range.
    | ASCII_DIGIT ~ (ASCII_DIGIT | "_")* ~ "." ~ !"." ~ ASCII_DIGIT ~ (ASCII_DIGIT | "_")* ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT ~ (ASCII_DIGIT | "_")*)? ~ numeric_suffix?
    | "." ~ ASCII_DIGIT ~ (ASCII_DIGIT | "_")* ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT ~ (ASCII_DIGIT | "_")*)? ~ numeric_suffix?
    | ASCII_DIGIT ~ (ASCII_DIGIT | "_")* ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT ~ (ASCII_DIGIT | "_")*)? ~ numeric_suffix?
}

numeric_suffix = @{ "UL" | "ul" | "LU" | "lu" | "f" | "F" | "d" | "D" | "m" | "M" | "L" | "l" | "U" | "u" }

// ECMA-334 §6.4.5.6 UTF-8 literals spell `u8` as a SUFFIX — `"abc"u8`. The
// prefix arm here (`u8"abc"`) is not C# and matched nothing; every real
// occurrence failed the parse at the character after the closing quote.
//
// The suffix is consumed and dropped: it selects the literal's TYPE
// (`ReadOnlySpan<byte>` rather than `string`), and this grammar does not carry
// types. `utf8_suffix` is captured so the walker can see it if the byte
// representation ever needs to differ.
string_literal = @{
    "\"" ~ ("\\\"" | "\\\\" | "\\n" | "\\t" | "\\r" | "\\0" | !"\"" ~ ANY)* ~ "\""
    ~ utf8_suffix?
}

utf8_suffix = @{ "u8" ~ !(ASCII_ALPHANUMERIC | "_") }

// ── Type names ──────────────────────────────────────────────────────────────

type_name = {
    tuple_type
    | base_type ~ generic_type_args? ~ nullable_marker? ~ pointer_marker* ~ array_rank*
}

// C# tuple type: `(int, string)` or `(int x, string y)`. Element names
// are accepted but discarded — they're documentation, not part of
// the lowered type. At least 2 elements (1-element form collides with
// parenthesized type expressions).
tuple_type = {
    "(" ~ tuple_type_element ~ ("," ~ tuple_type_element)+ ~ ","? ~ ")"
    ~ nullable_marker? ~ array_rank*
}

tuple_type_element = {
    base_type ~ generic_type_args? ~ nullable_marker? ~ pointer_marker* ~ array_rank* ~ ident_name?
}

base_type = @{
    ("int" | "string" | "double" | "float" | "bool" | "char" | "long" | "byte"
    | "short" | "decimal" | "object" | "void" | "dynamic" | "var"
    | "uint" | "ulong" | "ushort" | "sbyte" | "nint" | "nuint")
    ~ !(ASCII_ALPHANUMERIC | "_")
    | dotted_name
}

nullable_marker = { "?" }
pointer_marker = { "*" }
array_rank = { "[" ~ ","* ~ "]" }

// ── Parameters ──────────────────────────────────────────────────────────────

param_list = { param ~ ("," ~ param)* ~ ","? }

param = {
    attribute_list* ~ param_modifier? ~ type_name ~ ident_name ~ ("=" ~ expression)?
    | attribute_list* ~ param_modifier? ~ ident_name ~ ("=" ~ expression)?
}

// `scoped` (C# 11) narrows a ref-like parameter's LIFETIME — it may not
// escape the callee. That is a compile-time escape-analysis restriction with
// no run-time component, so it is accepted and dropped, exactly like the
// `readonly` half of `ref readonly`.
// ⛔ `in` WAS REACHABLE ONLY AFTER `scoped`. A bare `in int a` — C# 7.2's
// read-only by-reference parameter, and the ordinary spelling — matched no
// alternative, so the whole declaration was a parse error.
//
// ⛔ AND EVERY WORD HERE NEEDS ITS BOUNDARY. As bare strings, `"out"` matches
// the first three characters of a parameter named `outValue` and leaves
// `Value` to be read as the type: a mis-parse, not an error, which is the
// pitfall `add_vybex_language.md` documents. `@{ … ~ !(ALNUM|"_") }` is the
// shape that refuses.
param_modifier = {
    scoped_kw ~ (ref_readonly_kw | ref_kw | out_kw | in_kw)?
    | params_kw
    | ref_readonly_kw
    | ref_kw
    | out_kw
    | in_kw
    | this_kw
}

// `in_kw` and `this_kw` are already defined above — `foreach (x in y)` and the
// `: this(...)` initializer — and one definition per word is the point.
ref_kw = @{ "ref" ~ !(ASCII_ALPHANUMERIC | "_") }
out_kw = @{ "out" ~ !(ASCII_ALPHANUMERIC | "_") }
params_kw = @{ "params" ~ !(ASCII_ALPHANUMERIC | "_") }

scoped_kw = @{ "scoped" ~ !(ASCII_ALPHANUMERIC | "_") }

// `ref readonly p` passes BY REFERENCE and forbids writing through it — the
// aliasing half is `ref`, the rest is a compile-time restriction.
ref_readonly_kw = @{ "ref" ~ WHITESPACE+ ~ "readonly" ~ !(ASCII_ALPHANUMERIC | "_") }

// ── Identifiers ─────────────────────────────────────────────────────────────

ident_name = @{
    !strict_keyword ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")*
}

ident_or_keyword = @{
    (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")*
}

strict_keyword = _{
    ("abstract" | "as" | "base" | "bool" | "break" | "byte" | "case" | "catch"
    | "char" | "checked" | "class" | "const" | "continue" | "decimal" | "default"
    | "delegate" | "do" | "double" | "else" | "enum" | "event" | "explicit"
    | "extern" | "false" | "finally" | "fixed" | "float" | "for" | "foreach"
    | "goto" | "if" | "implicit" | "in" | "int" | "interface" | "internal"
    | "is" | "lock" | "long" | "namespace" | "new" | "null" | "object"
    | "operator" | "out" | "override" | "params" | "private" | "protected"
    | "public" | "readonly" | "ref" | "return" | "sbyte" | "sealed" | "short"
    | "sizeof" | "static" | "string" | "struct" | "switch" | "this" | "throw"
    | "true" | "try" | "typeof" | "uint" | "ulong" | "unchecked" | "unsafe"
    | "ushort" | "using" | "virtual" | "void" | "volatile" | "while")
    ~ !(ASCII_ALPHANUMERIC | "_")
}

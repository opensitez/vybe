# ────────────────────────────────────────────────────────────────────────────
# BUILT-IN SLOTS
# ────────────────────────────────────────────────────────────────────────────
# Widening a `char` to an integer reads its UTF-16 code point: `(int)'A'` is 65.
# That is the char/int COERCION SLOT (builtinslotplan.md §2a) and it is declared
# here rather than decided by a language check in the shared compiler.
[builtin_slots.char]
int = "common:strings.char_code"

# `x.ToString()` on a value that turns out to be a primitive at runtime is the
# built-in string conversion, not a member lookup. Declaring WHICH conversion is
# what lets the shared compiler run that probe without asking who the language
# is — it reads this binding (builtinslotplan.md §2c, the runtime path).
[builtin_slots.string]
to_string = "host:ecma:string:String"

[builtin_slots.int]
to_string = "host:ecma:string:String"
# The MIRROR of `[builtin_slots.char] int`: `(char)65` is "A". Both directions
# are declared here so a cast cannot resolve one way and not the other.
char = "common:strings.from_char_code"

[builtin_slots.double]
to_string = "host:ecma:string:String"

[builtin_slots.bool]
# `.NET` renders a bool `True`/`False`; ECMA `String()` renders `true`/`false`.
# Both are right for their own language, so this is a property of the TYPE in
# THIS language, not a general rule — the same reason `[builtin_slots.double]`
# exists. Pointing it at ECMA meant `b.ToString()` answered `true`, while
# `(6 % 2 == 0).ToString()` answered `True` because that route reaches the
# `CStr` intrinsic instead: one value, two renderings, decided by which path
# the expression happened to take.
#
# `dotnet.tostring_runtime` is the .NET renderer already used for the general
# `ToString` builtin above, and powershell already declares it as its own bool
# row — so this adds no mechanism, it points an existing slot at the renderer
# that was always correct for .NET.
to_string = "common:dotnet.tostring_runtime"

# C# Compiler Profile
# ────────────────────
# Full port of vybe_compiler_csharp builtins — Console, Math, Convert, String,
# collections, LINQ, GUI, threading, type operations.

[info]
name = "csharp"
extensions = ["cs"]

[compiler]
# Declared types CONVERT the value they bind (assignment, declaration and
# parameter entry alike). Stated explicitly rather than inherited: the platform
# default is `true`, and inheriting it silently gave Python coercive semantics
# it never chose.
coerces_value_to_type_hint = true
reflection_type_naming = "dotnet"   # .NET BCL: System.* root + primitive naming
# namespaceplan.md (dotnet phase): qualified System.* chains resolve through
# the common resolver over the dotnet.* tree; legacy cascade is the fallback
# during the transition.
uses_common_resolver = true
function_return = "explicit"
self_keyword = "this"
base_keyword = "base"
constructor_name = "ctor"
enum_as_ordinals = true
case_sensitive = true
# C# is over ECMA: `bool`/`System.Boolean` is an ECMA boolean, not a C-style
# i32. Materialize comparison + bool-decl results as real booleans so
# `bool f = 5>3`, `flag switch{true=>…}`, and `n.HasValue` behave/print as
# `True`/`False` instead of flattening to `1`/`0`.
materialize_bool_results = true
# `5 / 2 == 2`: `/` truncates when both operands are integers (C# / Java / C /
# Go semantics). VB opts out — its `/` is always real division, `\` is integer.
integer_division_on_slash = true
string_indexing = "zero_based"
entry_point = "Main"
dynamic_add = true
# Route `class` declarations through common::classes::normalize_class
# + emit_class (see classnormalization.md).
uses_normalize_class = true
# C#: `return (a, b);` with `ValueTuple` syntax maps to WASM multi-value
# at the ABI boundary. Destructure-side (`var (a, b) = f();`) isn't in
# the grammar yet, so today only the callee-side saving applies —
# non-destructure callers get the N values auto-repacked into an array.
# When/if tuple-deconstruction lands in the grammar, the existing
# `detect_multi_value_receive` path will light up automatically.
multi_value_tuple_returns = true
# A C# tuple `(1, 2)` is the same runtime value as a tuple from any other
# language: an array carrying the hidden `__tuple` tag so repr/type can tell
# tuple from list. Shared lowering in vybe_emitter::tuples (emit_tag).
tuple_literals_tagged = true

# ────────────────────────────────────────────────────────────────────────────
# BUILTINS — bare global function calls and dotted static calls
# ────────────────────────────────────────────────────────────────────────────


[builtins]

# `Type.GetType("Name")` — static type lookup by name. Resolution is the shared
# dynamic-symbol path; .NET yields null on a miss rather than throwing, and the
# result is the type's NAME so it agrees with `typeof(X)`.
__vybe_type_get = { emit = "intrinsic:symbol_probe", min_args = 1, max_args = 1 }

# ── I/O ──────────────────────────────────────────────────────────────────────

"Array.isArray"           = { emit = "common:ref_is_array",       min_args = 1, max_args = 1 }

# ── Bit casts ────────────────────────────────────────────────────────────────
#
# `BitConverter` reads STORAGE: `SingleToInt32Bits(1.0f)` is 1065353216, not 1.
# These did not resolve at all before. `common:bits.*` is the shared family that
# Fortran's TRANSFER, Go's `Float32bits` and Java's `floatToIntBits` reach
# through the same `UnaryOp::Reinterpret` node.
# .NET `Math.Round` is BANKER'S rounding by default — `Math.Round(2.5)` is 2,
# confirmed with `dotnet run`. It did not resolve at all before.
# ⛔ `max_args = 1` MEANT THE DIGITS FORM NEVER ARRIVED. `Math.Round(d, 2)`
# answered `2` — the emitter rounded the DIGIT COUNT, because the shared
# `math.round_half_even` primitive takes one operand and the row capped the
# call there. `System.Math.Round(d, 2)` went through the .NET tree instead and
# was correct all along, which is what made this read as a caller bug.
# Routed to the .NET emitter, which has handled `(value, digits)` and
# `(value, digits, mode)` from the start. Its one-operand path is `F64_NEAREST`
# — IEEE roundTiesToEven, the same policy `HalfEven` names — so the arity-1
# behaviour this row already had is unchanged.
"Math.Round" = { emit = "common:dotnet.system.math.round", min_args = 1, max_args = 3 }

"BitConverter.SingleToInt32Bits" = { emit = "common:bits.reinterpret_i32", min_args = 1, max_args = 1 }
"BitConverter.Int32BitsToSingle" = { emit = "common:bits.reinterpret_f32", min_args = 1, max_args = 1 }
"BitConverter.DoubleToInt64Bits" = { emit = "common:bits.reinterpret_i64", min_args = 1, max_args = 1 }
"BitConverter.Int64BitsToDouble" = { emit = "common:bits.reinterpret_f64", min_args = 1, max_args = 1 }
# `Int128`/`UInt128` width discipline. The synthesized classes in
# `platforms/dotnet/.../numerics_classes.rs` call these; they cannot be written
# in C# source because ECMA's `asIntN`/`asUintN` have no C# spelling.

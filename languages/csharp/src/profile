"__csharp_str_starts_with" = { emit = "common:str_starts_with",     min_args = 2, max_args = 2 }
"__csharp_str_ends_with"   = { emit = "common:str_ends_with",       min_args = 2, max_args = 2 }
"__csharp_str_index_of"    = { emit = "common:strings.index_of",    min_args = 2, max_args = 3 }
"__csharp_str_to_upper"    = { emit = "common:strings.to_upper",    min_args = 1, max_args = 1 }
"__csharp_str_to_lower"    = { emit = "common:strings.to_lower",    min_args = 1, max_args = 1 }
"__csharp_str_trim"        = { emit = "common:strings.trim",        min_args = 1, max_args = 1 }
"__csharp_str_split"       = { emit = "common:strings.split",       min_args = 2, max_args = 3 }
"__csharp_str_replace"     = { emit = "common:strings.replace",     min_args = 3, max_args = 3 }
"__csharp_str_substring"   = { emit = "common:strings.substring",   min_args = 2, max_args = 3 }
"__csharp_str_pad_left"    = { emit = "common:str_pad_start",       min_args = 3, max_args = 3 }
"__csharp_str_pad_right"   = { emit = "common:str_pad_end",         min_args = 3, max_args = 3 }
"__csharp_str_length"      = { emit = "common:strings.length",      min_args = 1, max_args = 1 }
"__csharp_str_char_code_at" = { emit = "common:str_char_code_at",   min_args = 2, max_args = 2 }
"__dotnet_string_contains"  = { emit = "common:dotnet.string_contains",      min_args = 2, max_args = 3 }
"__dotnet_string_compare"   = { emit = "common:dotnet.string_compare",       min_args = 2, max_args = 3 }
"__dotnet_string_starts_with" = { emit = "common:dotnet.string_starts_with", min_args = 2, max_args = 3 }
"__dotnet_string_ends_with" = { emit = "common:dotnet.string_ends_with",     min_args = 2, max_args = 3 }
"__dotnet_string_index_of"  = { emit = "common:dotnet.string_index_of",      min_args = 2, max_args = 3 }
"__dotnet_string_last_index_of" = { emit = "common:dotnet.string_last_index_of", min_args = 2, max_args = 3 }
"__dotnet_string_equals"    = { emit = "common:dotnet.string_equals",        min_args = 2, max_args = 3 }
"__csharp_array_clone"     = { emit = "common:collections.clone",   min_args = 1, max_args = 1 }
"__csharp_delegate_combine" = { emit = "common:delegates.combine",  min_args = 2, max_args = 2 }
"__csharp_delegate_remove"  = { emit = "common:delegates.remove",   min_args = 2, max_args = 2 }
"__csharp_to_string"       = { emit = "common:dotnet.tostring",     min_args = 1, max_args = 1 }
"__csharp_object_assign"   = { emit = "common:reflection.assign",   min_args = 2, max_args = 255 }


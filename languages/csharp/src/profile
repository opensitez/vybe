# C# Compiler Profile
# ────────────────────
# Full port of vybe_compiler_csharp builtins — Console, Math, Convert, String,
# collections, LINQ, GUI, threading, type operations.

[info]
name = "csharp"
extensions = ["cs"]

[compiler]
field_hiding = true            # static-type field resolution: subclass field hides parent, distinct slots
reflection_type_naming = "dotnet"   # .NET BCL: System.* root + primitive naming
# namespaceplan.md (dotnet phase): qualified System.* chains resolve through
# the common resolver over the dotnet.* tree; legacy cascade is the fallback
# during the transition.
uses_common_resolver = true
function_return = "explicit"
self_keyword = "this"
base_keyword = "base"
constructor_name = "ctor"
enum_as_ordinals = true
case_sensitive = true
# C# is over ECMA: `bool`/`System.Boolean` is an ECMA boolean, not a C-style
# i32. Materialize comparison + bool-decl results as real booleans so
# `bool f = 5>3`, `flag switch{true=>…}`, and `n.HasValue` behave/print as
# `True`/`False` instead of flattening to `1`/`0`.
materialize_bool_results = true
# `5 / 2 == 2`: `/` truncates when both operands are integers (C# / Java / C /
# Go semantics). VB opts out — its `/` is always real division, `\` is integer.
integer_division_on_slash = true
string_indexing = "zero_based"
entry_point = "Main"
dynamic_add = true
# Route `class` declarations through common::classes::normalize_class
# + emit_class (see classnormalization.md).
uses_normalize_class = true
# C#: `return (a, b);` with `ValueTuple` syntax maps to WASM multi-value
# at the ABI boundary. Destructure-side (`var (a, b) = f();`) isn't in
# the grammar yet, so today only the callee-side saving applies —
# non-destructure callers get the N values auto-repacked into an array.
# When/if tuple-deconstruction lands in the grammar, the existing
# `detect_multi_value_receive` path will light up automatically.
multi_value_tuple_returns = true
# A C# tuple `(1, 2)` is the same runtime value as a tuple from any other
# language: an array carrying the hidden `__tuple` tag so repr/type can tell
# tuple from list. Shared lowering in vybe_emitter::tuples (emit_tag).
tuple_literals_tagged = true

# ────────────────────────────────────────────────────────────────────────────
# BUILTINS — bare global function calls and dotted static calls
# ────────────────────────────────────────────────────────────────────────────

[builtins]

# ── I/O ──────────────────────────────────────────────────────────────────────

"Console.Error"           = { emit = "host:wasi:cli:error",       min_args = 0, max_args = 255 }
"Array.isArray"           = { emit = "common:ref_is_array",       min_args = 1, max_args = 1 }
"__csharp_object_get"     = { emit = "host:ecma:object:get",      min_args = 2, max_args = 2 }

# ── Math — shorthand resolves through the shared `System.Math` Dotnet tree ──

# ── Type conversion ──────────────────────────────────────────────────────────
#
# `Convert.*`, primitive `<T>.Parse`, and `Int32.TryParse` resolve through the
# shared .NET namespace tree registered by `platforms/dotnet`.
"decimal.Round"      = { emit = "common:dotnet.system.math.round", min_args = 1, max_args = 2 }
"Decimal.Round"      = { emit = "common:dotnet.system.math.round", min_args = 1, max_args = 2 }
"decimal.Truncate"   = { emit = "common:dotnet.system.math.truncate", min_args = 1, max_args = 1 }
"Decimal.Truncate"   = { emit = "common:dotnet.system.math.truncate", min_args = 1, max_args = 1 }
"decimal.Floor"      = { emit = "common:dotnet.system.math.floor", min_args = 1, max_args = 1 }
"decimal.Ceiling"    = { emit = "common:dotnet.system.math.ceiling", min_args = 1, max_args = 1 }
"decimal.Abs"        = { emit = "common:dotnet.system.math.abs", min_args = 1, max_args = 1 }

# ── String static methods ────────────────────────────────────────────────────

"str_repeat"          = { emit = "common:str_repeat",             min_args = 2, max_args = 2 }

# C# walker-private string lowering helpers. These avoid generic member-call
# fallback for C# string methods that overlap with .NET collection methods.
"__csharp_str_contains"    = { emit = "common:str_includes",        min_args = 2, max_args = 2 }
"__csharp_str_starts_with" = { emit = "common:str_starts_with",     min_args = 2, max_args = 2 }
"__csharp_str_ends_with"   = { emit = "common:str_ends_with",       min_args = 2, max_args = 2 }
"__csharp_str_index_of"    = { emit = "common:strings.index_of",    min_args = 2, max_args = 3 }
"__csharp_str_to_upper"    = { emit = "common:strings.to_upper",    min_args = 1, max_args = 1 }
"__csharp_str_to_lower"    = { emit = "common:strings.to_lower",    min_args = 1, max_args = 1 }
"__csharp_str_trim"        = { emit = "common:strings.trim",        min_args = 1, max_args = 1 }
"__csharp_str_split"       = { emit = "common:strings.split",       min_args = 2, max_args = 3 }
"__csharp_str_replace"     = { emit = "common:strings.replace",     min_args = 3, max_args = 3 }
"__csharp_str_substring"   = { emit = "common:strings.substring",   min_args = 2, max_args = 3 }
"__csharp_str_pad_left"    = { emit = "common:str_pad_start",       min_args = 3, max_args = 3 }
"__csharp_str_pad_right"   = { emit = "common:str_pad_end",         min_args = 3, max_args = 3 }
"__csharp_str_length"      = { emit = "common:strings.length",      min_args = 1, max_args = 1 }
"__csharp_str_char_code_at" = { emit = "common:str_char_code_at",   min_args = 2, max_args = 2 }
"__csharp_array_clone"     = { emit = "common:collections.clone",   min_args = 1, max_args = 1 }
"__csharp_delegate_combine" = { emit = "common:delegates.combine",  min_args = 2, max_args = 2 }
"__csharp_delegate_remove"  = { emit = "common:delegates.remove",   min_args = 2, max_args = 2 }
"__csharp_to_string"       = { emit = "common:dotnet.tostring",     min_args = 1, max_args = 1 }

# ── Array static methods ────────────────────────────────────────────────────
# All shared with VB via `common:dotnet.array_*` adapters in
# `crates/vybex/src/emitter/dotnet/core/array_adapter.rs`.

# ── Object static methods ───────────────────────────────────────────────────

"Object.assign"      = { emit = "host:ecma:object:assign",       min_args = 2, max_args = 255 }
"Object.Equals"       = { emit = "common:dyn_eq",                 min_args = 2, max_args = 2 }
"Object.ReferenceEquals" = { emit = "common:ref_eq",              min_args = 2, max_args = 2 }

# ── Environment ──────────────────────────────────────────────────────────────

# ── Threading ────────────────────────────────────────────────────────────────
# Routes through compiler_common::threading which uses real WASM threading
# opcodes (thread_spawn, thread_join, atomic_*) — NOT Vybe-specific host calls.
# Standard WASM runtimes that support the threads proposal get proper threading
# without needing the Vybe host. Sleep uses the standard `wasi:clocks` import.

# ── Layout no-ops ────────────────────────────────────────────────────────────

"SuspendLayout"   = { emit = "noop", min_args = 0, max_args = 0 }
"ResumeLayout"    = { emit = "noop", min_args = 0, max_args = 1 }
"PerformLayout"   = { emit = "noop", min_args = 0, max_args = 0 }

# ────────────────────────────────────────────────────────────────────────────
# VALUE METHODS — instance methods called on values
# ────────────────────────────────────────────────────────────────────────────

[value_methods]

# String instance methods
ToUpper       = { emit = "common:strings.to_upper",   min_args = 0, max_args = 0 }
ToLower       = { emit = "common:strings.to_lower",   min_args = 0, max_args = 0 }
Trim          = { emit = "common:strings.trim",        min_args = 0, max_args = 0 }
TrimStart     = { emit = "common:str_trim_start",      min_args = 0, max_args = 0 }
TrimEnd       = { emit = "common:str_trim_end",        min_args = 0, max_args = 0 }
StartsWith    = { emit = "common:str_starts_with",     min_args = 1, max_args = 1 }
EndsWith      = { emit = "common:str_ends_with",       min_args = 1, max_args = 1 }
Contains      = { emit = "common:str_includes",        min_args = 1, max_args = 1 }
Replace       = { emit = "common:strings.replace",     min_args = 2, max_args = 2 }
Split         = { emit = "common:strings.split",       min_args = 1, max_args = 2 }
Substring     = { emit = "common:strings.substring",   min_args = 1, max_args = 2 }
IndexOf       = { emit = "common:strings.index_of",    min_args = 1, max_args = 2 }
LastIndexOf   = { emit = "common:str_last_index_of",   min_args = 1, max_args = 2 }
PadLeft       = { emit = "common:str_pad_start",       min_args = 1, max_args = 2 }
PadRight      = { emit = "common:str_pad_end",         min_args = 1, max_args = 2 }
ToString      = { emit = "common:dotnet.tostring_runtime", min_args = 0, max_args = 1 }
ToCharArray   = { emit = "common:str_split",           min_args = 0, max_args = 0 }
Insert        = { emit = "common:dotnet.str_insert",   min_args = 2, max_args = 2 }
Remove        = [
    { emit = "common:dotnet.str_remove_start", min_args = 1, max_args = 1 },
    { emit = "common:dotnet.str_remove_range", min_args = 2, max_args = 2 },
]

# Array/List instance methods
# Add has two overloads: list.Add(item) (1 arg) and dict.Add(key, value) (2 args)
Add           = [
    { emit = "common:collections.push", min_args = 1, max_args = 1 },
    { emit = "common:dict.set_dynamic", min_args = 2, max_args = 2 },
]
Clear         = { emit = "host:ecma:array:clear",      min_args = 0, max_args = 0 }
Reverse       = { emit = "common:collections.reverse",       min_args = 0, max_args = 0 }
Sort          = [
    { emit = "common:dotnet.sort_in_place",        min_args = 0, max_args = 0 },
    { emit = "common:dotnet.sort_with_comparator", min_args = 1, max_args = 1 },
]
join          = { emit = "common:collections.join",    min_args = 1, max_args = 1 }
GetType       = { emit = "common:ref_typeof",          min_args = 0, max_args = 0 }
# Delegate introspection: the invocation list as a plain array of handlers,
# so `.Length` / `.Contains(h)` work off it.
GetInvocationList = { emit = "common:delegates.invocation_list", min_args = 0, max_args = 0 }
Equals        = { emit = "common:dyn_eq",              min_args = 1, max_args = 1 }

# LINQ surface lives once in the shared .NET component resolver
# (`platforms/dotnet/.../component_classes_linq.rs`, class `IEnumerable`).
# Dispatch resolves it by receiver type — or, for untyped receivers on the
# .NET path, by method name — so there are NO per-function LINQ entries here.
# The adapters drain any receiver (array, List<T>, generator, cross-language
# iterable) through `generators.rs`. Only List/Dictionary mutators that are
# not `IEnumerable` extension methods remain in the profile.
AddRange           = { emit = "common:dotnet.list_add_range",             min_args = 1, max_args = 1 }
EntriesSorted      = { emit = "common:dotnet.sorted_dictionary_entries",  min_args = 0, max_args = 0 }

# Dictionary methods
ContainsKey   = { emit = "common:dict.has",            min_args = 1, max_args = 1 }
ContainsValue = { emit = "invoke:ContainsValue",        min_args = 1, max_args = 1 }
TryGetValue   = { emit = "invoke:TryGetValue",          min_args = 1, max_args = 2 }

# Queue/Stack methods
Enqueue       = { emit = "common:collections.push",          min_args = 1, max_args = 1 }
Dequeue       = { emit = "common:collections.shift",         min_args = 0, max_args = 0 }
Push          = { emit = "common:collections.push",          min_args = 1, max_args = 1 }
Pop           = { emit = "common:collections.pop",           min_args = 0, max_args = 0 }
Peek          = { emit = "invoke:Peek",                 min_args = 0, max_args = 0 }

# ────────────────────────────────────────────────────────────────────────────
# ESM DEFAULTS — C# namespace objects → host modules, ECMA-262 §16.2 shape
# ────────────────────────────────────────────────────────────────────────────

# namespaceplan.md (dotnet phase): `System.*` qualified chains resolve by
# walking the global namespace tree at `dotnet.system.*` — the surface the
# dotnet platform registers from its component-model descriptors. One
# resolver for every language; the platform contributes data only.

[[esm_default]]
kind = "tree-mount"
prefix = "System"
path = "dotnet.system"

# `Convert` namespace alias retired — `Convert.To*` methods lower at
# compile time through the dotnet wrapper Component Model dispatch.
# The namespace object itself is still registered in
# `vybe_host::namespaces::convert` (binding `ToInt32` → `ecma:number.parseInt`
# etc.) for any dynamic identifier-resolution path.

[[esm_default]]
kind = "namespace"
alias = "Object"
module = "ecma:object"

# Task / Thread / Interlocked are compiler-only now: Task.Run / Thread.Start
# compile to Op::THREAD_SPAWN, Interlocked.* compiles to WASM atomic opcodes,
# Thread.Sleep uses wasi:clocks/sleep. No ESM namespace object is needed —
# the compiler intercepts these calls directly.

# ────────────────────────────────────────────────────────────────────────────
# KNOWN TYPES — constructor mappings for new TypeName()
# ────────────────────────────────────────────────────────────────────────────

[known_types]
# Constructor fallbacks for `new TypeName()` when the dotnet wrapper
# Component Model adapter doesn't handle the type. Most .NET-shape
# classes lower at compile time and bypass this table entirely.
#
# Retired entries:
#   Exception family, StringBuilder, Timer — all routed through dotnet
#   wrapper Common emit (no `vybe:types/{exception,sb,timer}New` host fns).

# ────────────────────────────────────────────────────────────────────────────
# NAMESPACE CONSTANTS — property access, NOT function call
# ────────────────────────────────────────────────────────────────────────────

# ────────────────────────────────────────────────────────────────────────────
# ARRAY METHODS — higher-order methods routed to compiler_common::loops
# ────────────────────────────────────────────────────────────────────────────

[array_methods]
ForEach   = "__array_forEach"
# LINQ extension methods (`Where`, `Any`, `All`, `OrderBy`, `Aggregate`, ...)
# live in the shared .NET `IEnumerable` surface, not in per-language array
# aliases.
# List<T> instance-method aliases — same HOF semantics, different names per
# .NET BCL. Routes through the same compiler_common loop emitters.
Find       = "__array_find"
FindAll    = "__array_filter"
Exists     = "__array_some"
TrueForAll = "__array_every"
ConvertAll = "__array_map"

[namespace_constants]
"bool.TrueString"       = "True"
"bool.FalseString"      = "False"

[namespaces]
# Use the .NET BCL namespace resolution from the shared dotnet module.
# Installs Form, Button, TextBox, Label, Panel, Size, Point, etc. as
# callable globals before the user program is compiled, so `new Form()`
# / `new Button()` in C# source resolves the same way it does in VB.
# Without this the auto-base-call in `public class MyForm : Form {}`
# sees `Form` as `undefined` and traps at runtime.
use_dotnet = true
# Route C# through the shared .NET dotted-name resolver as well. The
# resolver now bails out for user-defined types before trying namespace
# imports, so `MathUtils.Fact(5)` still uses the normal static-method path
# while real .NET namespace/type calls share the same surface as VB.
use_dotnet_resolver = true

# Ambient tree roots — .NET default Imports/using context as data: bare
# qualified chains (`Thread.Sleep`, `File.ReadAllText`, `Regex.IsMatch`)
# search under these tree paths in order.

[[esm_default]]
kind = "tree-ambient"
path = "dotnet.system"

[[esm_default]]
kind = "tree-ambient"
path = "dotnet.system.windows.forms"

[[esm_default]]
kind = "tree-ambient"
path = "dotnet.system.text"

[[esm_default]]
kind = "tree-ambient"
path = "dotnet.system.io"

[[esm_default]]
kind = "tree-ambient"
path = "dotnet.system.diagnostics"

[[esm_default]]
kind = "tree-ambient"
path = "dotnet.system.threading"

[[esm_default]]
kind = "tree-ambient"
path = "dotnet.system.collections"

[[esm_default]]
kind = "tree-ambient"
path = "dotnet.system.collections.generic"

[[esm_default]]
kind = "tree-ambient"
path = "dotnet.system.collections.concurrent"

[[esm_default]]
kind = "tree-ambient"
path = "dotnet.system.net"

[[esm_default]]
kind = "tree-ambient"
path = "dotnet.system.net.http"

[[esm_default]]
kind = "tree-ambient"
path = "dotnet.system.net.sockets"

[[esm_default]]
kind = "tree-ambient"
path = "dotnet.system.data"

[[esm_default]]
kind = "tree-ambient"
path = "dotnet.system.data.sqlclient"

[[esm_default]]
kind = "tree-ambient"
path = "dotnet.system.data.oledb"

[[esm_default]]

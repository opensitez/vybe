# ────────────────────────────────────────────────────────────────────────────
# VALUE METHODS — instance methods called on values
# ────────────────────────────────────────────────────────────────────────────

[value_methods]

# String instance methods are NOT declared here. `System.String` is a .NET
# type, so its members are leaves on the dotnet tree
# (`component_classes_system.rs`, class `String`) and one shared resolver
# answers them for every .NET frontend.
#
# ⛔ A `[value_methods]` row SHADOWS the leaf — it wins outright, and the leaf
# becomes dead code that never runs. That is what kept `Substring`, `Split`,
# `IndexOf` and friends on the JS-shaped `common:strings.*` emits while
# `dotnet.string_*` (which carries .NET's own bounds and culture behaviour)
# sat unreachable.
#
# The rows removed here (`ToUpper ToLower Trim TrimStart TrimEnd StartsWith
# EndsWith Contains Replace Split Substring IndexOf LastIndexOf PadLeft
# PadRight ToCharArray Insert Remove`) existed because the tree declared only
# some OVERLOADS — `Trim(chars)` but no `Trim()`, `Contains(value, comparison)`
# but no `Contains(value)`. An incomplete .NET surface is a bug in the tree,
# and that is where it is fixed.

ToString      = { emit = "common:dotnet.tostring_runtime", min_args = 0, max_args = 1 }

# ⚠ STILL SHADOWING, each for a MEASURED reason — not because the leaf is
# missing. All four are declared on the tree and the tree answers wrongly:
#   Trim/TrimStart/TrimEnd — `dotnet.string_trim_*_chars` mishandles its
#     arities (see the same note in the VB profile).
#   Split  — `dotnet.string_split` ignores the count argument, so
#     `"a:b:c:d".Split(':', 2)` returns 4 segments instead of 2.
#   ToCharArray — reached from a LITERAL receiver it is not found at all.
#
# ⛔ That last one is the general gap: `resolve_receiver_type_hint` answers
# `None` for a literal, so `"  hi  ".TrimStart()` never reaches the tree while
# the identical call on a typed local does. Until a literal carries its type,
# any String member a test calls on a literal needs a row here.
Trim          = { emit = "common:strings.trim",         min_args = 0, max_args = 0 }
TrimStart     = { emit = "common:str_trim_start",       min_args = 0, max_args = 0 }
TrimEnd       = { emit = "common:str_trim_end",         min_args = 0, max_args = 0 }
Split         = { emit = "common:strings.split",        min_args = 1, max_args = 2 }
Replace       = { emit = "common:strings.replace",     min_args = 2, max_args = 2 }
Substring     = { emit = "common:strings.substring",   min_args = 1, max_args = 2 }
PadLeft       = { emit = "common:str_pad_start",       min_args = 1, max_args = 2 }
PadRight      = { emit = "common:str_pad_end",         min_args = 1, max_args = 2 }
Insert        = { emit = "common:dotnet.str_insert",   min_args = 2, max_args = 2 }
Remove        = [
    { emit = "common:dotnet.str_remove_start", min_args = 1, max_args = 1 },
    { emit = "common:dotnet.str_remove_range", min_args = 2, max_args = 2 },
]
ToUpper       = { emit = "common:strings.to_upper",   min_args = 0, max_args = 0 }
ToLower       = { emit = "common:strings.to_lower",   min_args = 0, max_args = 0 }
StartsWith    = { emit = "common:str_starts_with",    min_args = 1, max_args = 1 }
EndsWith      = { emit = "common:str_ends_with",      min_args = 1, max_args = 1 }
ToCharArray   = { emit = "common:str_split",            min_args = 0, max_args = 0 }

# ⚠ OPEN, and NOT caused by moving these members onto the tree: in C#,
# `s.IndexOf("World")` answers -1 and `s.Contains("World")` answers False,
# while VB reaches the SAME leaves and answers 6 and True. Restoring the
# profile rows does not change either answer, which is what proves the rows
# were never the deciding factor — something resolves ahead of both. The
# two-argument form works (`s.IndexOf("World", 0)` → 6), so it is the
# one-argument call shape on the C# side.

# NOT a .NET member: the JS array spelling, and the only producer left is the
# `new string(charArray)` lowering, which has no String constructor to reach.
join          = { emit = "common:collections.join",    min_args = 1, max_args = 1 }
GetType       = { emit = "common:ref_typeof",          min_args = 0, max_args = 0 }
# Delegate introspection: the invocation list as a plain array of handlers,
# so `.Length` / `.Contains(h)` work off it.
GetInvocationList = { emit = "common:delegates.invocation_list", min_args = 0, max_args = 0 }
Equals        = { emit = "common:dyn_eq",              min_args = 1, max_args = 1 }

# LINQ surface lives once in the shared .NET component resolver
# (`platforms/dotnet/.../component_classes_linq.rs`, class `IEnumerable`).
# Dispatch resolves it by receiver type — or, for untyped receivers on the
# .NET path, by method name — so there are NO per-function LINQ entries here.
# The adapters drain any receiver (array, List<T>, generator, cross-language
# iterable) through `generators.rs`; collection mutators and dictionary/queue/
# stack methods resolve through the shared dotnet collection descriptor.

# ────────────────────────────────────────────────────────────────────────────
# ESM DEFAULTS — C# namespace objects → host modules, ECMA-262 §16.2 shape
# ────────────────────────────────────────────────────────────────────────────

# namespaceplan.md (dotnet phase): `System.*` qualified chains resolve by
# walking the global namespace tree at `dotnet.system.*` — the surface the
# dotnet platform registers from its component-model descriptors. One
# resolver for every language; the platform contributes data only.

[[esm_default]]
kind = "tree-mount"
prefix = "System"
path = "dotnet.System"

# `Convert` namespace alias retired — `Convert.To*` methods lower at
# compile time through the dotnet wrapper Component Model dispatch.
# The namespace object itself is still registered in
# `vybe_host::namespaces::convert` (binding `ToInt32` → `ecma:number.parseInt`
# etc.) for any dynamic identifier-resolution path. C# record `with` lowering
# calls a walker-private helper routed through
# `common:reflection.assign`; `System.Object` comes from the dotnet tree.

# Task / Thread / Interlocked are compiler-only now: Task.Run / Thread.Start
# compile to Op::THREAD_SPAWN, Interlocked.* compiles to WASM atomic opcodes,
# Thread.Sleep uses wasi:clocks/sleep. No ESM namespace object is needed —
# the compiler intercepts these calls directly.


join          = { emit = "common:collections.join",    min_args = 1, max_args = 1 }
GetType       = { emit = "common:ref_typeof",          min_args = 0, max_args = 0 }
# Delegate introspection: the invocation list as a plain array of handlers,
# so `.Length` / `.Contains(h)` work off it.
GetInvocationList = { emit = "common:delegates.invocation_list", min_args = 0, max_args = 0 }
Equals        = { emit = "common:dyn_eq",              min_args = 1, max_args = 1 }

# LINQ surface lives once in the shared .NET component resolver
# (`platforms/dotnet/.../component_classes_linq.rs`, class `IEnumerable`).
# Dispatch resolves it by receiver type — or, for untyped receivers on the
# .NET path, by method name — so there are NO per-function LINQ entries here.
# The adapters drain any receiver (array, List<T>, generator, cross-language
# iterable) through `generators.rs`; collection mutators and dictionary/queue/
# stack methods resolve through the shared dotnet collection descriptor.

# ────────────────────────────────────────────────────────────────────────────
# ESM DEFAULTS — C# namespace objects → host modules, ECMA-262 §16.2 shape
# ────────────────────────────────────────────────────────────────────────────

# namespaceplan.md (dotnet phase): `System.*` qualified chains resolve by
# walking the global namespace tree at `dotnet.system.*` — the surface the
# dotnet platform registers from its component-model descriptors. One
# resolver for every language; the platform contributes data only.

[[esm_default]]
kind = "tree-mount"
prefix = "System"
path = "dotnet.system"

# `Convert` namespace alias retired — `Convert.To*` methods lower at
# compile time through the dotnet wrapper Component Model dispatch.
# The namespace object itself is still registered in
# `vybe_host::namespaces::convert` (binding `ToInt32` → `ecma:number.parseInt`
# etc.) for any dynamic identifier-resolution path. C# record `with` lowering
# calls a walker-private helper routed through
# `common:reflection.assign`; `System.Object` comes from the dotnet tree.

# Task / Thread / Interlocked are compiler-only now: Task.Run / Thread.Start
# compile to Op::THREAD_SPAWN, Interlocked.* compiles to WASM atomic opcodes,
# Thread.Sleep uses wasi:clocks/sleep. No ESM namespace object is needed —
# the compiler intercepts these calls directly.

# ────────────────────────────────────────────────────────────────────────────
# KNOWN TYPES — constructor mappings for new TypeName()
# ────────────────────────────────────────────────────────────────────────────

[known_types]
# Constructor fallbacks for `new TypeName()` when the dotnet wrapper
# Component Model adapter doesn't handle the type. Most .NET-shape
# classes lower at compile time and bypass this table entirely.
#
# Retired entries:
#   Exception family, StringBuilder, Timer — all routed through dotnet
#   wrapper Common emit (no `vybe:types/{exception,sb,timer}New` host fns).

# ────────────────────────────────────────────────────────────────────────────
# NAMESPACE CONSTANTS — property access, NOT function call
# ────────────────────────────────────────────────────────────────────────────

[namespace_constants]
"bool.TrueString"       = "True"
"bool.FalseString"      = "False"

[namespaces]
# Enable .NET runtime surface semantics; namespace lookup is data-driven by
# the common resolver through the tree mounts and ambient imports below.
use_dotnet = true
source_imports_are_namespaces = true

# Types under this namespace-tree path dispatch at RUNTIME through the type
# registry rather than through this language's value-method tables — `xs.Add(v)`
# on a .NET collection must reach the collection's own method, not an array
# builtin that happens to share the name. A PATH, not a language switch: the
# answer depends on where the declaring type lives.
runtime_collection_scope = ["dotnet", "system", "collections"]

# Namespace-tree roots this language resolves platform types against. `Button`
# / `Form` / `Dictionary` are .NET catalog entries, so member access on a
# statically-typed receiver looks them up under `dotnet`.
type_scopes = ["dotnet"]

# Ambient tree roots — .NET default Imports/using context as data: bare
# qualified chains (`Thread.Sleep`, `File.ReadAllText`, `Regex.IsMatch`)
# search under these tree paths in order.

[[esm_default]]
kind = "tree-ambient"
path = "dotnet.system"


WHITESPACE = _{ " " | "\t" | "\r" }
NEWLINE = _{ "\r\n" | "\n" | "\r" }
COMMENT = _{ block_comment | line_comment }
block_comment = _{ "<#" ~ (!"#>" ~ ANY)* ~ "#>" }
line_comment = _{ "#" ~ (!NEWLINE ~ ANY)* }

terminator = _{ ";" | NEWLINE }
separator = _{ WHITESPACE | terminator }
eat_terminators = _{ terminator* }
eat_separators = _{ separator* }
// Whitespace and newlines only — never a ";", so it can sit next to a rule
// that needs the ";" itself (the `for` header).
eat_ws_nl = _{ (WHITESPACE | NEWLINE)* }

program = { SOI ~ eat_separators ~ (statement ~ eat_separators)* ~ EOI }

// Entry point for re-parsing a captured text fragment as an expression.
expr_entry = { SOI ~ expression ~ EOI }

statement = _{
    labeled_stmt
  | label_decl
  | trap_stmt
  | named_block
  | namespace_decl
  | enum_decl
  | class_decl
  | function_decl
  | param_stmt
  | if_stmt
  | foreach_stmt
  | for_stmt
  | while_stmt
  | do_while_stmt
  | try_stmt
  | switch_stmt
  | return_stmt
  | throw_stmt
  | break_stmt
  | continue_stmt
  | using_stmt
  | attribute_stmt
  | assignment_stmt
  | increment_stmt
  | expr_stmt
  | COMMENT
  | command_stmt
}

block = { "{" ~ eat_separators ~ (statement ~ eat_separators)* ~ "}" }

// `:outer while (…) { … }` — a loop label, and `break outer` / `continue outer`
// target it. A label may also stand alone on its own line.
label_decl = @{ ":" ~ (ASCII_ALPHANUMERIC | "_")+ }
labeled_stmt = { label_decl ~ eat_separators ~ (while_stmt | for_stmt | foreach_stmt | do_while_stmt | switch_stmt) }

// `trap { … }` — a statement-level error handler.
trap_stmt = { kw_trap ~ type_literal? ~ block }

// `begin` / `process` / `end` / `clean` blocks of an advanced function.
named_block = { (kw_begin | kw_process | kw_end | kw_clean) ~ block }

ws = _{ " " | "\t" | "\r" }
ws1 = _{ (" " | "\t" | "\r")+ }

// ── Keyword tokens ──────────────────────────────────────────────────────────
// Each keyword is an ATOMIC rule carrying its own word boundary. A non-atomic
// `^"class" ~ ws1` can never match: pest skips the implicit WHITESPACE before
// evaluating `ws1`, so the separator it is looking for is already gone. Putting
// the boundary inside an atomic rule is the documented fix.
kw_class     = @{ ^"class" ~ !ident_tail }
kw_enum      = @{ ^"enum" ~ !ident_tail }
kw_function  = @{ ^"function" ~ !ident_tail }
kw_namespace = @{ ^"namespace" ~ !ident_tail }
kw_param     = @{ ^"param" ~ !ident_tail }
kw_if        = @{ ^"if" ~ !ident_tail }
kw_elseif    = @{ ^"elseif" ~ !ident_tail }
kw_else      = @{ ^"else" ~ !ident_tail }
kw_while     = @{ ^"while" ~ !ident_tail }
kw_until     = @{ ^"until" ~ !ident_tail }
kw_foreach   = @{ ^"foreach" ~ !ident_tail }
kw_for       = @{ ^"for" ~ !ident_tail }
kw_switch    = @{ ^"switch" ~ !ident_tail }
kw_do        = @{ ^"do" ~ !ident_tail }
kw_try       = @{ ^"try" ~ !ident_tail }
kw_catch     = @{ ^"catch" ~ !ident_tail }
kw_finally   = @{ ^"finally" ~ !ident_tail }
kw_return    = @{ ^"return" ~ !ident_tail }
kw_throw     = @{ ^"throw" ~ !ident_tail }
kw_break     = @{ ^"break" ~ !ident_tail }
kw_continue  = @{ ^"continue" ~ !ident_tail }
kw_using     = @{ ^"using" ~ !ident_tail }
kw_in        = @{ ^"in" ~ !ident_tail }
kw_base      = @{ ^"base" ~ !ident_tail }
kw_default   = @{ ^"default" ~ !ident_tail }
kw_trap      = @{ ^"trap" ~ !ident_tail }
kw_begin     = @{ ^"begin" ~ !ident_tail }
kw_process   = @{ ^"process" ~ !ident_tail }
kw_end       = @{ ^"end" ~ !ident_tail }
kw_clean     = @{ ^"clean" ~ !ident_tail }
ident_tail   = _{ ASCII_ALPHANUMERIC | "_" | "-" }

IDENT = @{ (ASCII_ALPHANUMERIC | "_" | "-" )+ }
DOT_NAME = @{ (ASCII_ALPHANUMERIC | "_" | "-" | "." )+ }
namespace_name = @{ DOT_NAME }
DOTTED_NAME = @{ (ASCII_ALPHANUMERIC | "_" | "-" | "." )+ }

var_ref = @{ "$" ~ ("{" ~ (!"}" ~ ANY)+ ~ "}" | (ASCII_ALPHANUMERIC | "_" | ":")+) }

namespace_decl = { kw_namespace ~ namespace_name ~ block }

class_decl = { kw_class ~ IDENT ~ class_heritage? ~ class_body }

// `enum Color { Red; Green = 2 }`. Members are separated by newlines, `;` or
// `,` interchangeably, and a value is optional — an unvalued member takes the
// previous one plus one, which the walker fills in.
enum_decl   = { kw_enum ~ IDENT ~ eat_separators ~ "{" ~ eat_separators ~ (enum_member ~ eat_separators ~ (("," | ";") ~ eat_separators)?)* ~ "}" }
enum_member = { IDENT ~ (ws* ~ "=" ~ ws* ~ ternary_expr)? }
class_heritage = { ":" ~ ws* ~ DOTTED_NAME ~ (ws* ~ "," ~ ws* ~ DOTTED_NAME)* }
class_body = { "{" ~ eat_separators ~ (class_member_decl ~ eat_separators)* ~ "}" }

// PowerShell class members. A METHOD declares a return type (`[string] Speak()`);
// a CONSTRUCTOR is the same shape without one and named for the class. That is
// the real disambiguator in the language, so it is the one used here.
class_member_decl = _{ ps_method | ps_constructor | ps_property | class_function_decl | constructor_decl }
class_modifier = @{ (^"static" | ^"hidden") ~ !(ASCII_ALPHANUMERIC | "_") }
ps_method = { (class_modifier ~ eat_separators)* ~ type_literal ~ eat_separators ~ member_name ~ eat_separators ~ function_params ~ eat_separators ~ block }
ps_constructor = { (class_modifier ~ eat_separators)* ~ IDENT ~ eat_separators ~ function_params ~ eat_separators ~ ctor_base? ~ eat_separators ~ block }
ctor_base = { ":" ~ eat_separators ~ kw_base ~ eat_separators ~ "(" ~ eat_separators ~ arg_list? ~ eat_separators ~ ")" }
ps_property = { (class_modifier ~ eat_separators)* ~ type_literal? ~ eat_separators ~ var_ref ~ (ws* ~ "=" ~ ws* ~ ternary_expr)? }
class_function_decl = { kw_function ~ function_name ~ function_params? ~ block }
constructor_decl = { ^"constructor" ~ function_params? ~ block }

function_decl = { kw_function ~ function_name ~ function_params? ~ block }
param_stmt = { kw_param ~ eat_separators ~ "(" ~ eat_separators ~ function_param_list? ~ eat_separators ~ ")" }
function_name = @{ IDENT | var_ref }
function_params = { "(" ~ eat_separators ~ function_param_list? ~ eat_separators ~ ")" }
function_param_list = { function_param ~ (eat_separators ~ "," ~ eat_separators ~ function_param)* }
function_param = { (type_literal ~ eat_separators)* ~ (var_ref | IDENT) ~ (ws* ~ "=" ~ ws* ~ ternary_expr)? }

if_stmt = { kw_if ~ condition_expr ~ block ~ (eat_separators ~ elseif_stmt)* ~ (eat_separators ~ else_stmt)? }
elseif_stmt = { kw_elseif ~ condition_expr ~ block }
else_stmt = { kw_else ~ block }

while_stmt = { kw_while ~ condition_expr ~ block }

foreach_stmt = { kw_foreach ~ "(" ~ eat_separators ~ var_ref ~ kw_in ~ paren_body ~ eat_separators ~ ")" ~ block }

switch_stmt = { kw_switch ~ switch_flag* ~ "(" ~ eat_separators ~ paren_body ~ eat_separators ~ ")" ~ eat_separators ~ "{" ~ eat_separators ~ (switch_case ~ eat_separators)* ~ "}" }
switch_flag = @{ "-" ~ (ASCII_ALPHANUMERIC)+ }
switch_case = { switch_default_case | switch_case_value }
switch_default_case = { kw_default ~ switch_case_body }
switch_case_value = { expression ~ ws* ~ switch_case_body }
switch_case_body = { "{" ~ eat_separators ~ (statement ~ eat_separators)* ~ "}" }

for_stmt = { kw_for ~ eat_ws_nl ~ "(" ~ eat_ws_nl ~ for_init? ~ eat_ws_nl ~ ";" ~ eat_ws_nl ~ for_cond? ~ eat_ws_nl ~ ";" ~ eat_ws_nl ~ for_update? ~ eat_ws_nl ~ ")" ~ eat_ws_nl ~ block }
for_init = { simple_statement }
for_cond = { expression }
for_update = { simple_statement }
simple_statement = _{ assignment_stmt | increment_stmt | expr_statement }
expr_statement = { expression }

// `$a, $b = 1, 2` destructures — every lvalue before the `=` takes one element.
assignment_stmt = { lvalue ~ (ws* ~ "," ~ ws* ~ lvalue)* ~ ws* ~ assignment_op ~ eat_ws_nl ~ rhs_value }
// RHS may be a pipeline: `$x = Get-Item | Select-Object -First 1`.
// It may also be a STATEMENT — `$r = switch ($v) { … }` and `$r = if (…) { … }`
// are ordinary PowerShell, where the value is whatever the taken branch output.
// Tried before `command_pipeline` so `switch` is not read as a command name.
rhs_value = _{
    (expression ~ &(ws* ~ (terminator | EOI | "}")))
  | value_stmt
  | command_pipeline
}
// Branching statements only. A LOOP used as a value collects EVERY iteration's
// output into an array, which the lambda-and-return lowering cannot express —
// listing loops here would make `$s = foreach (…) { … }` return null silently
// instead of failing where the gap is.
value_stmt = { switch_stmt | if_stmt | try_stmt }
increment_stmt = { lvalue ~ ws* ~ increment_op }
lvalue = { type_literal? ~ var_ref ~ (member_get | index_get)* }
assignment_op = { "??=" | "||=" | "&&=" | "<<=" | ">>=" | "**=" | "+=" | "-=" | "*=" | "/=" | "%=" | "&=" | "|=" | "^=" | "=" }
increment_op = { "++" | "--" }

do_while_stmt = { kw_do ~ block ~ eat_separators ~ do_while_tail }
do_while_tail = _{ do_while_while | do_while_until }
do_while_while = { kw_while ~ condition_expr }
do_while_until = { kw_until ~ condition_expr }

try_stmt = { kw_try ~ block ~ (eat_separators ~ catch_clause)* ~ (eat_separators ~ finally_clause)? }
catch_clause = { kw_catch ~ catch_header? ~ block }
catch_header = { "(" ~ ws* ~ var_ref ~ ws* ~ ")" | type_literal }
finally_clause = { kw_finally ~ block }

return_stmt = { kw_return ~ rhs_value? }
throw_stmt = { kw_throw ~ expression? }
break_stmt = { kw_break ~ (integer | label_name)? }
continue_stmt = { kw_continue ~ (integer | label_name)? }
label_name = @{ (ASCII_ALPHANUMERIC | "_")+ }
integer = @{ ASCII_DIGIT+ }

using_stmt = { kw_using ~ using_target }
using_target = { kw_namespace ~ DOTTED_NAME | DOTTED_NAME | var_ref }

// A bracketed run that ends the line is an attribute, not a cast: the `&`
// lookahead is what keeps `[int]$x = 5` an assignment.
expr_stmt = { &("(" | "$" | "[" | "@" | "\"" | "'" | "!" | "-" | ASCII_DIGIT) ~ expression ~ &(ws* ~ (terminator | EOI | "}")) }

attribute_stmt = { type_literal+ ~ !(ws* ~ (var_ref | "::" | "." | "[" | "(" | "@" | "\"" | "'")) }

condition_expr = { "(" ~ eat_separators ~ paren_body ~ eat_separators ~ ")" }

// A parenthesised group holds a PIPELINE, not just an expression: `(Get-Item)`,
// `($x | Measure-Object)`. Try the pure expression first and require it to reach
// the closing paren — if it stops short (a bare command head, or a `|`), fall
// back to the command pipeline form.
paren_body = _{ (expression ~ &(eat_separators ~ ")")) | command_pipeline }
command_pipeline = { pipeline_head ~ (ws* ~ "|" ~ eat_ws_nl ~ command_segment)* }
pipeline_head = _{ (expression ~ &(ws* ~ ("|" | ")"))) | command_segment }

// ────────────────────────────────────────────────────────────────────────────
// Command / pipeline layer (PowerShell "command mode")
//
// In command mode a bare token is a STRING argument, not an identifier, and
// `-Name` is a parameter rather than an operator. That mode split is real
// PowerShell semantics, so the token model stays — but every token that is not
// a bare word is parsed by the expression grammar below, so there is exactly
// one place that knows operator precedence.
// ────────────────────────────────────────────────────────────────────────────
// `.` (dot-source) and `&` (call) are invocation operators, not member access:
// they are only these when followed by whitespace.
invoke_op = @{ ("." | "&") ~ &(" " | "\t") }
command_stmt = { pipeline_expr ~ (ws* ~ chain_op ~ eat_ws_nl ~ pipeline_expr)* }
chain_op = @{ "&&" | "||" }
// A `|` may end a line and continue on the next.
pipeline_expr = { command_segment ~ (ws* ~ "|" ~ eat_ws_nl ~ command_segment)* }
// NOTE: no explicit separator between head and args — pest skips implicit
// WHITESPACE between terms in a non-atomic rule, so an explicit `ws1` here
// would never match (the whitespace is already consumed).
command_segment = { invoke_op? ~ command_head ~ command_arg* ~ redirection? }
// `> file`, `>> file`, `2>&1`
redirection = { redirect_op ~ command_token? }
redirect_op = @{ ASCII_DIGIT? ~ (">>" | ">") ~ ("&" ~ ASCII_DIGIT)? }
command_head = { !keyword ~ !(number ~ !command_name_char) ~ command_token }
command_name_char = _{ ASCII_ALPHANUMERIC | "_" | "-" | "." | ":" | "\\" | "/" }
command_arg = { command_param | command_token }
command_param = @{ "-" ~ (ASCII_ALPHANUMERIC | "_")+ ~ (":" ~ (!(WHITESPACE | NEWLINE | ";" | "|") ~ ANY)+)? }
// A command ARGUMENT takes its whole postfix chain: `$b.Count`, `$x.F()`,
// `[math]::Abs(1)`. Matching a bare `var_ref` here split `$b.Count` into
// two arguments.
command_value = { (var_ref | paren_expr | type_literal) ~ postfix_op* }
command_token = { quoted_string | single_quoted_string | script_block | sub_expr | array_expr | hash_literal | splat_ref | command_value | bare_token }
script_block = {
    "{" ~ (script_block | quoted_string | single_quoted_string | (!("{" | "}") ~ ANY))* ~ "}"
}
bare_token = @{ (!("|" | NEWLINE | ";" | "{" | "}" | "(" | ")" | "\"" | "'" | WHITESPACE) ~ ANY)+ }

keyword = @{ (^"if" | ^"elseif" | ^"else" | ^"while" | ^"foreach" | ^"for" | ^"switch" | ^"do" | ^"try" | ^"catch" | ^"finally" | ^"return" | ^"throw" | ^"break" | ^"continue" | ^"using" | ^"param" | ^"class" | ^"enum" | ^"namespace" | ^"function") ~ !(ASCII_ALPHANUMERIC | "_" | "-") }
ws_boundary = _{ WHITESPACE | NEWLINE | "{" | "}" | "(" | ")" | ";" | "|" }

// ────────────────────────────────────────────────────────────────────────────
// Expression grammar — the ONE place operator precedence is defined.
//
// PowerShell precedence, lowest to highest:
//   -or/-xor  <  -and  <  comparison  <  range  <  additive  <  multiplicative
//             <  exponent  <  unary/cast  <  postfix  <  primary
// ────────────────────────────────────────────────────────────────────────────
ident_char = _{ ASCII_ALPHANUMERIC | "_" }

// `,` is PowerShell's array-construction operator: `$a = 1,2,3`. It lives at the
// top of the expression chain, so list contexts that split on commas themselves
// (argument lists, `@(…)` elements, hash values) use `ternary_expr` instead.
expression = { comma_expr }
comma_expr = { ternary_expr ~ (ws* ~ "," ~ ws* ~ ternary_expr)* }

ternary_expr = { coalesce ~ (ws* ~ "?" ~ !"?" ~ ws* ~ ternary_expr ~ ws* ~ ":" ~ ws* ~ ternary_expr)? }

// `$a ?? $b` — null-coalescing. Parsed under the ternary so the `??` is taken
// before the ternary's single `?` can claim its first character.
coalesce    = { logical_or ~ (ws* ~ coalesce_op ~ ws* ~ logical_or)* }
coalesce_op = @{ "??" }

logical_or  = { logical_and ~ (ws* ~ or_op ~ ws* ~ logical_and)* }
or_op       = @{ "-" ~ (^"or" | ^"xor") ~ !ident_char }

logical_and = { comparison ~ (ws* ~ and_op ~ ws* ~ comparison)* }
and_op      = @{ "-" ~ ^"and" ~ !ident_char }

// `-replace` / `-split` / `-join` take a comma-separated ARGUMENT LIST on the
// right, the same way `-f` does: `$s -replace 'a', 'b'` is a two-argument
// replace, not a comparison against the array `('b')`. They are split out from
// `cmp_op` so only these three spellings admit the comma — `-eq` keeps its
// single operand and nothing else in the chain changes shape.
comparison  = {
    format_expr ~ (ws* ~ (list_cmp_op ~ ws* ~ cmp_list | cmp_op ~ ws* ~ format_expr))*
}
list_cmp_op = @{ "-" ~ (^"c" | ^"i")? ~ (^"replace" | ^"split" | ^"join") ~ !ident_char }
cmp_list    = { format_expr ~ (ws* ~ "," ~ ws* ~ format_expr)* }

// `-f` is .NET composite formatting and its right operand is an ARRAY LITERAL:
// `"{0} {1}" -f $a, $b` passes two format arguments, it does not build a list
// whose first element is a formatted string. Comma binds tighter than `-f` in
// PowerShell, so the argument list is spelled out here rather than inherited
// from the top-level comma rule.
format_expr = { range_expr ~ (ws* ~ format_op ~ ws* ~ format_args)? }
format_op   = @{ "-" ~ ^"f" ~ !ident_char }
format_args = { range_expr ~ (ws* ~ "," ~ ws* ~ range_expr)* }
// The bare word must be tried BEFORE the case-modifier form: `e?` is greedy in
// a PEG and does not backtrack, so `("c"|"i")? ~ cmp_word` would consume the
// `i` of `-is` / `-in` and then fail to match a word.
cmp_op      = @{ "-" ~ (cmp_word | (^"c" | ^"i") ~ cmp_word) ~ !ident_char }
// Longest-first: `like` before `le`, `notin` before `not`, `isnot` before `is`.
cmp_word    = _{
    ^"notcontains" | ^"notlike" | ^"notmatch" | ^"notin"
  | ^"contains"
  | ^"like" | ^"match" | ^"isnot"
  | ^"band" | ^"bor" | ^"bxor" | ^"shl" | ^"shr"
  | ^"eq" | ^"ne" | ^"ge" | ^"gt" | ^"le" | ^"lt" | ^"is" | ^"in"
}

range_expr  = { additive ~ (ws* ~ ".." ~ ws* ~ additive)? }

additive    = { multiplicative ~ (ws* ~ add_op ~ ws* ~ multiplicative)* }
// `-` is subtraction only when NOT followed by a letter — that keeps `-eq`,
// `-and`, `-not`, … out of the additive level.
add_op      = @{ "+" ~ !"+" | "-" ~ !(ASCII_ALPHA | "-") }

multiplicative = { power ~ (ws* ~ mul_op ~ ws* ~ power)* }
mul_op      = @{ "*" ~ !"*" | "/" | "%" }

power       = { unary ~ (ws* ~ pow_op ~ ws* ~ unary)* }
pow_op      = @{ "**" }

unary       = { unary_op ~ ws* ~ unary | cast_expr | postfix }
unary_op    = @{
    "++"
  | "--"
  | "!"
  | "-" ~ (^"not" | ^"bnot" | ^"join" | ^"split") ~ !ident_char
  | "-" ~ !(ASCII_ALPHA | "-")
  | "+" ~ !"+"
}
cast_expr   = { type_literal ~ ws* ~ unary }

postfix     = { primary ~ postfix_op* }
postfix_op  = _{ method_call | static_call | static_member | member_get | index_get }
method_call = { "." ~ member_name ~ "(" ~ eat_separators ~ arg_list? ~ eat_separators ~ ")" }
static_call = { "::" ~ member_name ~ "(" ~ eat_separators ~ arg_list? ~ eat_separators ~ ")" }
static_member = { "::" ~ member_name }
member_get  = { "." ~ (member_name | var_ref) }
index_get   = { "[" ~ eat_separators ~ expression ~ eat_separators ~ "]" }
member_name = @{ (ASCII_ALPHANUMERIC | "_")+ }
arg_list    = { ternary_expr ~ (eat_separators ~ "," ~ eat_separators ~ ternary_expr)* }

primary = _{
    here_string_double
  | here_string_single
  | sub_expr
  | paren_expr
  | array_expr
  | hash_literal
  | splat_ref
  | script_block_expr
  | number
  | quoted_string
  | single_quoted_string
  | var_ref
  | type_literal
  | bare_word
}

paren_expr   = { "(" ~ eat_separators ~ paren_body ~ eat_separators ~ ")" }
// `$( … )` and `@( … )` hold statements, not just one expression — but a lone
// expression is the common case and is NOT a `statement`: `expr_stmt` demands a
// terminator, `EOI` or `}` after it and a `)` is none of those, so `$(1 + 2)`
// failed the whole rule and fell through to a command call on `$`.
sub_expr     = { "$(" ~ eat_separators ~ sub_body ~ eat_separators ~ ")" }
// `value_stmt` is listed for the same reason `rhs_value` lists it: `$(if (…) {
// … })` is ordinary PowerShell, and without it the `if` parsed as a bare
// statement whose value nothing collected, so the subexpression was empty.
// It reuses the branch-value lowering `$x = if (…) { … }` already goes through.
sub_body     = _{ (expression ~ &(eat_separators ~ ")")) | (value_stmt ~ &(eat_separators ~ ")")) | (statement ~ eat_separators)* }
// Elements may be commands too: `@(Get-ChildItem)`.
array_expr   = { "@(" ~ eat_separators ~ (array_element ~ eat_separators ~ (("," | ";") ~ eat_separators ~ array_element ~ eat_separators)*)? ~ ")" }
array_element = _{ (ternary_expr ~ &(eat_separators ~ ("," | ")"))) | command_pipeline }
hash_literal = { "@{" ~ eat_separators ~ (hash_entry ~ eat_separators ~ (("," | ";")? ~ eat_separators ~ hash_entry ~ eat_separators)*)? ~ ")"? ~ "}" }
hash_entry   = { hash_key ~ ws* ~ "=" ~ ws* ~ ternary_expr }
hash_key     = { quoted_string | single_quoted_string | number | bare_word }
script_block_expr = { "{" ~ eat_separators ~ (statement ~ eat_separators)* ~ "}" }

number = @{
    "0" ~ (^"b") ~ ASCII_BIN_DIGIT+
  | "0" ~ (^"x") ~ ASCII_HEX_DIGIT+
  | ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? ~ (^"e" ~ ("+" | "-")? ~ ASCII_DIGIT+)? ~ (^"kb" | ^"mb" | ^"gb" | ^"tb" | ^"pb" | ^"l" | ^"d")?
  | "." ~ ASCII_DIGIT+
}

// Balanced brackets, so `[int[]]` and `[Collections.Generic.List[string]]` work
// while `[System.Math]::Abs(…)` stops at its OWN closing bracket rather than
// swallowing the `::Abs` that follows.
type_literal = @{ "[" ~ type_body ~ "]" }
type_body    = _{ (!("[" | "]") ~ ANY | "[" ~ type_body ~ "]")* }
bare_word    = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_" | "-")* }
// Splatting: `@args` spreads a collection/hashtable into a call's arguments.
splat_ref    = @{ "@" ~ (ASCII_ALPHANUMERIC | "_")+ }

here_string_double = @{ "@\"" ~ (!(NEWLINE ~ "\"@") ~ ANY)* ~ NEWLINE ~ "\"@" }
here_string_single = @{ "@'" ~ (!(NEWLINE ~ "'@") ~ ANY)* ~ NEWLINE ~ "'@" }
// A `$( … )` inside a double-quoted string holds CODE, and that code may spell
// its own double-quoted strings: `"B=$("lit".ToUpper())"`. Scanning the body as
// "any character that is not a quote" ended the outer string at the inner one,
// so the tail leaked out as literal text — `$("x" + "y")` rendered as itself.
// The subexpression is therefore matched as a balanced region BEFORE the
// catch-all, and nests through `quoted_string` recursively.
//
// `""` is PowerShell's escape for a literal quote inside a double-quoted string
// (the backtick form `` `" `` is handled by the escape alternative).
quoted_string = @{ "\"" ~ ( "\"\"" | "\\\"" | "\\\\" | "`" ~ ANY | interp_sub | (!"\"" ~ ANY) )* ~ "\"" }
interp_sub    = @{ "$(" ~ interp_part* ~ ")" }
nested_paren  = @{ "(" ~ interp_part* ~ ")" }
interp_part   = _{ "`" ~ ANY | quoted_string | single_quoted_string | nested_paren | (!")" ~ !"(" ~ ANY) }
single_quoted_string = @{ "'" ~ ( "''" | (!"'" ~ ANY) )* ~ "'" }

[info]
name = "powershell"
extensions = ["ps", "ps1", "psm1", "psd1"]

[compiler]
# Declared types CONVERT the value they bind (assignment, declaration and
# parameter entry alike). Stated explicitly rather than inherited: the platform
# default is `true`, and inheriting it silently gave Python coercive semantics
# it never chose.
coerces_value_to_type_hint = true
# The implicit-output rule is applied by the walker (`implicit_return`), which
# rewrites a trailing expression statement into a `Return` — one mechanism, not
# two, so the shared compiler stays generic.
function_return = "explicit"
case_sensitive = false
self_keyword = "this"
constructor_name = "constructor"
uses_common_resolver = true

# Route class declarations through `normalize_class.rs` -> `NormalClass` ->
# the shared `class_normalize::emit::emit_class_from_ast` pipeline, the same
# path C# and VB take. Without this the normalizer is registered but never
# consulted, so constructors are never wired.
uses_normalize_class = true

# Every PowerShell class method is overridable — the language has no `virtual`
# keyword to mark one with, so a derived method always replaces its base.
#
# Shared code decides virtuality once, from the marks a walker sets plus this
# flag, and a method that is not virtual binds DIRECTLY to the declared type's
# body. So a receiver whose declared type differs from its runtime type —
# `[Base]$x = [Derived]::new()` — runs `Base`'s method without it.
methods_virtual_by_default = true

# PowerShell exceptions ARE .NET exceptions and this compiler models those on
# the ECMA `Error` shape — non-enumerable `Message`/`InnerException` fields plus
# the `instanceof` chain. Without the flag, `class E : System.Exception` got
# NONE of it: `$e.Message` was empty and `$e -is [System.Exception]` was false,
# because both branches in `classes.rs` that give a user class its parent's
# exception shape are gated on this. Declared rather than hand-rolled — the
# shape already exists, PowerShell simply never asked for it.
ecma_error_object_shape = true

# `(5 -eq 5)` is the boolean $true, not 1 — comparisons must materialize as real
# booleans or every `$result -ne $true` check compares a number to a bool.
materialize_bool_results = true

# `$arr[-1]` is the LAST element — PowerShell indexes from the end for negatives.
negative_index_wraps = true

# NOT `dynamic_add`. `compile_binop`'s `Add` arm tests that flag FIRST and
# returns, so setting it means `[builtin_slots.array] add` below is never
# consulted — the two are alternatives, not layers. `dynamic_add`'s own
# behaviour (string concat when either side is a string, else numeric) is
# preserved: the slot target falls through to exactly that emit for every
# operand that is not an array.
#
# It is also not PowerShell's rule on its own: `dynamic_add` concatenates
# whenever EITHER operand is a string, so it answers `'55'` for `5 + '5'` where
# PowerShell answers `10`. The result takes the LEFT operand's type.

[builtins]
# `System.Numerics` / `Int128` width discipline — the same rows csharp and vb
# carry. The emitters live in `platforms/dotnet`, which powershell already
# runs on, so this is a binding, not a third implementation.
"__vybe_bi_is_num" = { emit = "common:dotnet.i128_is_numeric", min_args = 1, max_args = 1 }
"__vybe_bi_is_pow2" = { emit = "common:dotnet.i128_is_pow2", min_args = 1, max_args = 1 }
"__vybe_bi_hex"     = { emit = "common:dotnet.i128_hex",     min_args = 2, max_args = 2 }
"__vybe_bi_str"     = { emit = "common:dotnet.i128_str",     min_args = 1, max_args = 1 }
"__vybe_bi_sign"    = { emit = "common:dotnet.i128_sign",    min_args = 1, max_args = 1 }
"__vybe_bi_abs"     = { emit = "common:dotnet.i128_abs",     min_args = 1, max_args = 1 }
"__vybe_bi_is_even" = { emit = "common:dotnet.i128_is_even", min_args = 1, max_args = 1 }
"__vybe_bi_cmp"     = { emit = "common:dotnet.i128_cmp",     min_args = 2, max_args = 2 }
"__vybe_bi_clamp"   = { emit = "common:dotnet.i128_clamp",   min_args = 3, max_args = 3 }
"__vybe_bi_min"     = { emit = "common:dotnet.i128_min",     min_args = 2, max_args = 2 }
"__vybe_bi_max"     = { emit = "common:dotnet.i128_max",     min_args = 2, max_args = 2 }
"__vybe_bi_add"  = { emit = "common:dotnet.i128_add",  min_args = 2, max_args = 2 }
"__vybe_bi_sub"  = { emit = "common:dotnet.i128_sub",  min_args = 2, max_args = 2 }
"__vybe_bi_mul"  = { emit = "common:dotnet.i128_mul",  min_args = 2, max_args = 2 }
"__vybe_bi_div"  = { emit = "common:dotnet.i128_div",  min_args = 2, max_args = 2 }
"__vybe_bi_rem"  = { emit = "common:dotnet.i128_rem",  min_args = 2, max_args = 2 }
"__vybe_bi_and"  = { emit = "common:dotnet.i128_and",  min_args = 2, max_args = 2 }
"__vybe_bi_or"   = { emit = "common:dotnet.i128_or",   min_args = 2, max_args = 2 }
"__vybe_bi_xor"  = { emit = "common:dotnet.i128_xor",  min_args = 2, max_args = 2 }
"__vybe_bi_eq"   = { emit = "common:dotnet.i128_eq",   min_args = 2, max_args = 2 }
"__vybe_bi_ne"   = { emit = "common:dotnet.i128_ne",   min_args = 2, max_args = 2 }
"__vybe_bi_lt"   = { emit = "common:dotnet.i128_lt",   min_args = 2, max_args = 2 }
"__vybe_bi_le"   = { emit = "common:dotnet.i128_le",   min_args = 2, max_args = 2 }
"__vybe_bi_gt"   = { emit = "common:dotnet.i128_gt",   min_args = 2, max_args = 2 }
"__vybe_bi_ge"   = { emit = "common:dotnet.i128_ge",   min_args = 2, max_args = 2 }
"__vybe_int128_wrap"  = { emit = "common:dotnet.int128_wrap",  min_args = 1, max_args = 1 }
"__vybe_uint128_wrap" = { emit = "common:dotnet.uint128_wrap", min_args = 1, max_args = 1 }
"__vybe_int128_shl"   = { emit = "common:dotnet.int128_shl",   min_args = 2, max_args = 2 }
"__vybe_int128_shr"   = { emit = "common:dotnet.int128_shr",   min_args = 2, max_args = 2 }

"write-output" = { emit = "print", min_args = 0, max_args = 255 }
"write-host" = { emit = "print", min_args = 0, max_args = 255 }

echo = { emit = "print", min_args = 0, max_args = 255 }
"get-date" = { emit = "common:dotnet.datetime_now", min_args = 0, max_args = 0 }
exit = { emit = "common:control_flow.exit", min_args = 0, max_args = 1 }
# `[System.Array]::Sort($arr)` after the walker attaches the `CompareTo`
# comparator. In place, like .NET's.
__ps_sort_with = { emit = "common:collections.sort_func", min_args = 2, max_args = 2 }
# `[char]::IsUpper($c)` etc. A PowerShell `[char]` is a one-character string,
# which is exactly what these shared primitives take.
__ps_char_is_upper  = { emit = "common:str_is_upper",     min_args = 1, max_args = 1 }
__ps_char_is_lower  = { emit = "common:str_is_lower",     min_args = 1, max_args = 1 }
__ps_char_is_digit  = { emit = "common:str_is_digit",     min_args = 1, max_args = 1 }
__ps_char_is_letter = { emit = "common:str_is_alpha",     min_args = 1, max_args = 1 }
__ps_char_is_alnum  = { emit = "common:str_is_alnum",     min_args = 1, max_args = 1 }
__ps_char_is_space  = { emit = "common:str_is_space",     min_args = 1, max_args = 1 }
__ps_char_to_upper  = { emit = "common:strings.to_upper", min_args = 1, max_args = 1 }
__ps_char_to_lower  = { emit = "common:strings.to_lower", min_args = 1, max_args = 1 }
# `[int]$x` — see `emit_to_int`: banker's rounding, a numeric parse, or a code
# point, decided by the runtime value.
__ps_to_int = { emit = "common:powershell.to_int", min_args = 1, max_args = 1 }
# `$obj.$name` — a COMPUTED member read. `ExprKind::Index` was the obvious node
# and it is the wrong one: indexing an OBJECT with a non-literal key falls
# through to array indexing, so `$h[$k]` answered EMPTY where `$h['A']` worked.
# `dict.get_dynamic` is the shared primitive for a by-value key.
__ps_member_dyn = { emit = "common:powershell.member_dyn", min_args = 2, max_args = 2 }
__ps_index_set  = { emit = "common:powershell.index_set",  min_args = 3, max_args = 3 }
__ps_index_get  = { emit = "common:powershell.index_get",  min_args = 2, max_args = 2 }
__ps_out_null   = { emit = "common:powershell.out_null",   min_args = 1, max_args = 1 }
# A pipeline whose stream holds ONE item is that item — see `emit_unwrap_single`.
__ps_unwrap_single = { emit = "common:powershell.unwrap_single", min_args = 1, max_args = 1 }
__ps_splat_arg  = { emit = "common:powershell.splat_arg",  min_args = 3, max_args = 3 }
# `1 / 0` THROWS in PowerShell rather than answering infinity — see
# `emit_divide`. ⛔A `[builtin_slots.int] div` row does NOT reach a plain
# numeric divide: `emit_rich_binop` consults only a USER operator method before
# falling back to `F64_DIV`.
__ps_divide     = { emit = "common:powershell.divide",    min_args = 2, max_args = 2 }
# `*` — the same LEFT-OPERAND rule as `+`. ⛔`[builtin_slots.array] mul` does
# NOT work: `compile_binop` consults that table in its `Add` arm and not in its
# `Mul` arm, so the row is declared and never read (measured).
__ps_multiply   = { emit = "common:powershell.multiply",  min_args = 2, max_args = 2 }
# `$obj.PSObject` — see `emit_psobject`. Two arguments: the target, and a fresh
# `List[string]` for `TypeNames` that the walker builds the ordinary way.
__ps_psobject   = { emit = "common:powershell.psobject",  min_args = 2, max_args = 2 }
# `$obj.PSObject.Properties.Add($d)` — see `emit_prop_add`.
__ps_prop_add   = { emit = "common:powershell.prop_add",  min_args = 2, max_args = 2 }
# `New-Object byte[] 4` — a sized array of the element type's zero value.
__ps_repeat     = { emit = "common:collections.repeat_value", min_args = 2, max_args = 2 }
# `$env:X = 5` stores the STRING "5" — the environment is string→string.
__ps_to_string  = { emit = "common:powershell.to_display", min_args = 1, max_args = 1 }

# The other output streams. They are real writes in PowerShell, and the tests
# only require that they emit rather than fail, so they share `print`.
"write-verbose"     = { emit = "print", min_args = 0, max_args = 255 }
"write-warning"     = { emit = "print", min_args = 0, max_args = 255 }
"write-debug"       = { emit = "print", min_args = 0, max_args = 255 }
"write-information" = { emit = "print", min_args = 0, max_args = 255 }
"write-error"       = { emit = "print", min_args = 0, max_args = 255 }

# The alias MAPPING is applied by the walker (`apply_aliases`), which rewrites
# every call that uses one. Nothing is left to do at runtime.
"set-alias"    = { emit = "noop", min_args = 0, max_args = 255 }
"new-alias"    = { emit = "noop", min_args = 0, max_args = 255 }
"remove-alias" = { emit = "noop", min_args = 0, max_args = 255 }

# JSON is `primitives/json.rs`, the shared serializer. NOT `host:ecma:json:*`
# directly: the bare `stringify` renders an object with no own enumerable
# properties as `{}`, which is what a `[PSCustomObject]` looks like to it, and
# the shared `parseOrNull` is the one go and pascal already use.
"convertto-json"   = { emit = "common:powershell.to_json",   min_args = 1, max_args = 3 }
"convertfrom-json" = { emit = "common:powershell.from_json", min_args = 1, max_args = 2 }

# `@( … )` — synthesized by the walker, never written by a user. The flattening
# rule is a runtime question about each operand, so it cannot be answered by the
# shape of the array literal.
__ps_array     = { emit = "common:powershell.ensure_array", min_args = 0, max_args = 255 }

# `Select-Object -First n` / `-Skip n`. The shared slice primitive takes
# [array, start, end] — all three, always: `Clone` binds the same emitter with
# `max_args = 0` and answers an EMPTY array for exactly that reason, so the
# walker passes explicit bounds rather than relying on defaults that do not
# exist. Synthesized by the walker, never written by a user.
__ps_slice     = { emit = "common:collections.slice", min_args = 3, max_args = 3 }

# `Measure-Object`. The cmdlet answers an OBJECT of statistics, so the walker
# builds the object literal and reaches each statistic through one of these.
# Synthesized by the walker, never written by a user.
__ps_count     = { emit = "common:collections.length", min_args = 1, max_args = 1 }

# `ConvertFrom-Csv`. `csv.parse_document` is the SHARED CSV grammar — a newline
# inside a quoted field is content, so the document cannot be pre-split into
# lines. Naming the columns is this language's job and stays in the walker.
__ps_csv_rows     = { emit = "common:csv.parse_document",       min_args = 3, max_args = 3 }
__ps_from_entries = { emit = "host:ecma:object:fromEntries",    min_args = 1, max_args = 1 }
__ps_sum       = { emit = "common:collections.sum",    min_args = 1, max_args = 1 }
__ps_max       = { emit = "common:collections.max",    min_args = 1, max_args = 1 }
__ps_min       = { emit = "common:collections.min",    min_args = 1, max_args = 1 }

# `Out-Null` discards its input. As a pipeline stage the walker drops the value
# outright; reached as a plain command there is nothing to emit.
"out-null"     = { emit = "noop", min_args = 0, max_args = 255 }
"write-progress" = { emit = "noop", min_args = 0, max_args = 255 }

# VALUE METHODS — instance methods called on values
# PowerShell is case-insensitive, but keep canonical and lowercase
# variants to cover both canonical profile wiring and normalized lookup paths.
[value_methods]

# `Count` / `Length` ARE the shared `Len` slot — the one `vybe_ast` documents as
# "len() / length / size / Count". `slot = "len"` is how pascal's `count`,
# python's `len`, php's `strlen` and kotlin's `size` say the same thing, and it
# is the question the shared layer actually asks:
# `lookup_value_method(field, 0).slot == ProtocolSlot::Len`.
#
# ⛔This REPLACES a walker rewrite that folded both spellings onto the literal
# name `length` before anything else could see them. That fold was a two-entry
# name table doing a protocol slot's job, and it defeated the shared layer's own
# protection — `expressions.rs` refuses the generic length when
# `receiver_class_declares_member(object, field)` says the receiver's class
# declares that member, but `field` had already become `length`, which no
# PowerShell class declares. MEASURED against pwsh 7.6.4:
# `class C { [int]$Count = 9 }` answered 9 there and EMPTY here;
# `[PSCustomObject]@{ Count = 7; Name = "g"; Group = @(1,2) }` answered 7 there
# and 3 here — the object's KEY COUNT, which is a plausible-looking number and
# so hid the bug.
#
# The slot is a FALLBACK, not an override: a declared member is resolved before
# `[value_methods]` is consulted (see the `CompareTo` note below), which is what
# makes a type carrying its own `Count` reach its own value again.
Count    = { emit = "common:collections.length", min_args = 0, max_args = 0, slot = "len" }
count    = { emit = "common:collections.length", min_args = 0, max_args = 0, slot = "len" }
Length   = { emit = "common:collections.length", min_args = 0, max_args = 0, slot = "len" }
length   = { emit = "common:collections.length", min_args = 0, max_args = 0, slot = "len" }

ToString = { emit = "common:dotnet.tostring_runtime", min_args = 0, max_args = 1 }
tostring = { emit = "common:dotnet.tostring_runtime", min_args = 0, max_args = 1 }

# `$x.GetType()` is .NET's, and `dotnet.get_type` already answers it for C# and
# VB: a descriptor carrying `Name`, read off the value's own class name, its
# `__type`, or `typeof` in that order. The corpus asks for `.Name` 53 times
# against four for every other Type member.
GetType = { emit = "common:dotnet.get_type", min_args = 0, max_args = 0 }
gettype = { emit = "common:dotnet.get_type", min_args = 0, max_args = 0 }

# `@{ … }.ContainsKey(k)` / `.Add(k, v)` — the HASHTABLE spellings.
#
# A PowerShell `@{}` is a bare object with no `__type`, so it reaches no tree
# leaf; these rows are the fallback that answers for it. A `Dictionary` names a
# REGISTERED type and resolves through the tree to `ecma:map` instead, which is
# what keeps the two storages apart.
#
# ⛔These were a walker rewrite keyed on SPELLING AND ARITY, applied whatever
# the receiver was. A `Dictionary` is an `ecma:map`, so its `Add` wrote an
# object PROPERTY while `Count`, `Keys` and `$d[k]` read the map — two halves of
# one object, each self-consistent, disagreeing with each other.
ContainsKey = { emit = "host:ecma:object:has", min_args = 1, max_args = 1 }
containskey = { emit = "host:ecma:object:has", min_args = 1, max_args = 1 }

# ────────────────────────────────────────────────────────────────────────────
# `System.String` INSTANCE MEMBERS
# ────────────────────────────────────────────────────────────────────────────
#
# These names are also leaves on the dotnet tree (`component_classes_system.rs`,
# class `String`), and a `[value_methods]` row SHADOWS the leaf. They are
# declared here anyway because a tree leaf resolves only on a receiver whose
# type is known at COMPILE time, and a PowerShell variable carries no declared
# type: `$s = "hi"` walks to a plain `Assign`, so `resolve_receiver_type_hint`
# answers `None` and the leaf is unreachable. `[string]$s = "hi"` DOES reach it
# — that asymmetry is what these rows close.
#
# A literal receiver has the same gap in every .NET frontend, which is why the
# csharp profile carries the same set.
#
# ⛔`[value_methods]` is language-global: a row fires on EVERY receiver, not
# just a string. `Contains`, `IndexOf` and `LastIndexOf` are therefore NOT here
# — arrays spell them too, and `[builtin_slots.array] contains` already answers
# the `-contains` / `-in` operator with the collection meaning. One spelling,
# two receivers, needs runtime dispatch rather than a row.
Trim          = { emit = "common:strings.trim",        min_args = 0, max_args = 0 }
TrimStart     = { emit = "common:str_trim_start",      min_args = 0, max_args = 0 }
TrimEnd       = { emit = "common:str_trim_end",        min_args = 0, max_args = 0 }
ToUpper       = { emit = "common:strings.to_upper",    min_args = 0, max_args = 0 }
ToLower       = { emit = "common:strings.to_lower",    min_args = 0, max_args = 0 }
# The dotnet spellings, not `common:str_*`: these accept the optional
# `StringComparison` argument and read its ordinal, which the ECMA-shaped
# two-operand primitives have no room for.
StartsWith    = { emit = "common:dotnet.string_starts_with", min_args = 1, max_args = 2 }
EndsWith      = { emit = "common:dotnet.string_ends_with",   min_args = 1, max_args = 2 }
Replace       = { emit = "common:strings.replace",     min_args = 2, max_args = 2 }
Split         = { emit = "common:strings.split",       min_args = 1, max_args = 2 }
# .NET `Substring(start[, length])` takes a LENGTH; the ECMA `substring` host
# call takes an END INDEX, so `"HeLLo".Substring(1, 3)` answers `eL` through it
# and `eLL` through the dotnet adapter. `dotnet.string_substring` also carries
# .NET's own bounds check.
Substring     = { emit = "common:dotnet.string_substring", min_args = 1, max_args = 2 }
# The pad character is OPTIONAL in .NET and defaults to a space. The
# `common:str_pad_*` primitives require it — `"hi".PadLeft(5)` answers `null`
# through them — and the dotnet adapter supplies the default.
PadLeft       = { emit = "common:dotnet.string_pad_left",  min_args = 1, max_args = 2 }
PadRight      = { emit = "common:dotnet.string_pad_right", min_args = 1, max_args = 2 }
ToCharArray   = { emit = "common:str_split",           min_args = 0, max_args = 0 }
Normalize     = { emit = "common:dotnet.string_normalize",     min_args = 0, max_args = 1 }
IsNormalized  = { emit = "common:dotnet.string_is_normalized",  min_args = 0, max_args = 1 }
# `IndexOfAny(char[])` takes a SET, so it collides with no collection spelling.
IndexOfAny    = { emit = "common:dotnet.string_index_of_any",      min_args = 1, max_args = 3 }
LastIndexOfAny = { emit = "common:dotnet.string_last_index_of_any", min_args = 1, max_args = 3 }

Equals        = { emit = "common:object.equals",       min_args = 1, max_args = 2 }
# `CompareTo` and `GetHashCode` are `System.Object` members, so EVERY value has
# them — `(5).CompareTo(3)`, `$str.CompareTo($other)`, `$obj.GetHashCode()`.
# Both answered `undefined is not callable`, and the shared primitives that
# implement them already existed; nothing was missing but the binding.
#
# ⛔A user class that DECLARES `CompareTo`/`GetHashCode` still wins: a declared
# member is resolved before `[value_methods]` is consulted, which is what makes
# these safe as a universal fallback rather than an override.
CompareTo     = { emit = "common:powershell.compare_to", min_args = 1, max_args = 1 }
GetHashCode   = { emit = "common:object.hash_code",    min_args = 0, max_args = 0 }
# NO `Insert` / `Remove`. `str_insert` does not exist, and `str_splice` — the
# nearest primitive — takes FOUR operands (string, index, count, insert), so a
# two-argument mapping compiles and then fails at runtime inside the splice.
# They need a walker rewrite into substring arithmetic, not a profile line.

# Hashtable surface. `@{…}` walks to `ExprKind::Object` — a bare struct with no
# `__keys` sidecar — so the `common:dict.*` primitives are the WRONG family here.
# MEASURED: `dict.keys` reads `__keys` and, per its own comment, returns an EMPTY
# ARRAY when that field is absent, so `$h.Keys` answered `[]` on every hashtable
# while `$h.Count` (a different path) answered 2. `ecma:object.*` is the
# object-shaped surface for exactly this representation; dart binds `containsKey`
# the same way.
#
# `Keys` / `Values` / `GetEnumerator` reach here at arity 0. `ContainsKey` and
# friends do NOT — the runtime collection registry claims those names first (see
# the `[namespaces] runtime_collection_scope` note) and they are rewritten in the
# walker instead.
# ⛔An ARRAY enumerates its VALUES and a hashtable its KEY/VALUE PAIRS — one row
# cannot say both, and `object:entries` said the hashtable answer for both. See
# `emit_get_enumerator`.
GetEnumerator = { emit = "common:powershell.get_enumerator", min_args = 0, max_args = 0 }
getenumerator = { emit = "common:powershell.get_enumerator", min_args = 0, max_args = 0 }
Keys          = { emit = "host:ecma:object:keys",      min_args = 0, max_args = 0 }
keys          = { emit = "host:ecma:object:keys",      min_args = 0, max_args = 0 }
Values        = { emit = "host:ecma:object:values",    min_args = 0, max_args = 0 }
values        = { emit = "host:ecma:object:values",    min_args = 0, max_args = 0 }

# Walker-rewrite targets. These names are PowerShell-private, so the runtime
# collection registry never sees them and the lookup lands here. Proven with a
# throwaway `HasKeyProbe` binding: identical emitter and arity, but the private
# name answered `True` where `ContainsKey` reached undefined.
__ps_ht_haskey   = { emit = "host:ecma:object:has",    min_args = 1, max_args = 1 }
__ps_ht_delkey   = { emit = "host:ecma:object:delete", min_args = 1, max_args = 1 }
__ps_ht_add      = { emit = "host:ecma:object:set",    min_args = 2, max_args = 2 }
__ps_ht_keys     = { emit = "host:ecma:object:keys",   min_args = 0, max_args = 0 }
__ps_ht_values   = { emit = "host:ecma:object:values", min_args = 0, max_args = 0 }
# `$a -join ','`. See the `Join` note in the collection surface below.
__ps_join        = { emit = "common:collections.join", min_args = 0, max_args = 1 }

# DateTime instance surface. Every one of these already exists in
# `platforms/dotnet` — the same emitters C# and VB reach — so `(Get-Date).AddDays(1)`
# needs a binding, not an implementation.

# Collection surface.
# `Add` names a LIST at one argument and a HASHTABLE at two, so the arity picks
# the storage. A `Dictionary` never reaches here — it is a registered type and
# the tree answers first with `ecma:map`.
Add           = { emit = "common:powershell.collection_add", min_args = 1, max_args = 255 }
# `Insert` is bound here for the SAME reason `Add` is. The dotnet tree already
# has `List[T].Insert`, but a TREE leaf only resolves on a receiver whose type
# is known at COMPILE time: `$l = [List[string]]::new(); $l.Insert(0,"A")` works
# and `$h.L.Insert(0,"A")` on the identical object is
# `undefined is not callable`. Anything reached through a field, a pipeline or
# `$obj.psobject.TypeNames` is untyped by then. `Add` sitting here and Lists
# still working is the precedent.
Insert        = { emit = "common:collections.insert",  min_args = 2, max_args = 2 }
Clear         = { emit = "common:collections.clear",   min_args = 0, max_args = 0 }
# `collections.slice` wants [array, start, end]; a 0-arg `Clone` pushed only the
# receiver, so the host call read two garbage operands and answered an EMPTY
# array. `collections.clone` IS that emitter with `0`/`i32::MAX` supplied.
Clone         = { emit = "common:collections.clone",   min_args = 0, max_args = 0 }
Reverse       = { emit = "common:collections.reverse", min_args = 0, max_args = 0 }
# PowerShell's `.Sort()` sorts IN PLACE (verified against `/usr/local/bin/pwsh`:
# `$a.Sort()` leaves `$a` sorted and evaluates to nothing). `collections.sorted`
# returns a NEW array and leaves the receiver untouched, so every in-place caller
# read the original order back.
Sort          = { emit = "common:collections.sort",    min_args = 0, max_args = 0 }
# ⛔NO `Join` ROW. The name is claimed shared-side before `[value_methods]` is
# consulted — `join` never reaches value-method dispatch at all (proven with
# `VYBE_SLOT_AUDIT=1`: `Sort`/`Clone`/`Add` print a census line, `join` does
# not), and the call answered the EMPTY STRING. `-join` is lowered to the
# PowerShell-private `__ps_join` below for exactly the reason the hashtable
# rewrites exist. Arrays have no `.Join()` method in PowerShell, so the private
# spelling costs no user-visible surface.
Concat        = { emit = "common:collections.concat",  min_args = 1, max_args = 1 }
concat        = { emit = "common:collections.concat",  min_args = 1, max_args = 1 }

# `Contains` and `IndexOf` are shared spellings across strings and collections.
# `invoke:` here found nothing to invoke — `"abc".Contains("b")` answered false
# and `IndexOf` answered undefined. The string primitives are the ones the tests
# exercise; `[builtin_slots.array] contains` still covers the collection side of
# `-contains` / `-in`.
# MEASURED: a lowercase `contains` key here DOES bind `.Contains()` to the string
# primitive (`"hello".Contains("ell")` flips false -> true), but it then also
# beats `[builtin_slots.array] contains` for the `-contains` OPERATOR, which
# starts calling `substring` on an array. One spelling, two receivers: the method
# needs runtime dispatch, which means an emitter. The operator is the far more
# common construct in this corpus, so the slot keeps the name and `.Contains()`
# stays wrong — visibly, not silently.

[array_methods]
# PowerShell's .ForEach() yields the results, so it maps rather than iterates.
ForEach   = "__array_map"
Where     = "__array_filter"

# ────────────────────────────────────────────────────────────────────────────
# builtinslotplan.md — built-in type spellings and slot bindings
# ────────────────────────────────────────────────────────────────────────────

[builtin_types]
string = ["string", "str"]
int    = ["int", "integer"]
double = ["double", "float", "decimal"]
bool   = ["bool", "boolean"]
array  = ["array"]
map    = ["hashtable", "dictionary"]

# PowerShell follows .NET stringification rules for interpolation, `Write-Output`,
# and value printing. This makes `Format-` style calls and `${expr}` interpolation
# stay consistent with `ToString()` and `ToString("F")`.
[builtin_slots.string]
# The slot the shared interpolation arm reads. `dotnet.tostring_runtime` alone
# is the .NET rendering, which is right for numbers and wrong for the three
# values PowerShell spells differently: `$null` is "" not "null", `$true` is
# "True" not "true", and `"$arr"` joins on `$OFS` (a space) not a comma.
# `powershell.to_display` handles those three and delegates everything else
# back to the same .NET emitter, so no formatting is lost.
to_string = "common:powershell.to_display"

# `-contains` / `-in` on an array are membership over VALUES; the shared
# collections primitive is the same one Pascal and Python bind here.
[builtin_slots.array]
contains = "common:collections.contains"
# `[builtin_slots.array] add` is the target for EVERY `+`, not just the array
# case — binding `collections.concat` here once made `10 + 5` evaluate to `5`.
# So it takes a target that DISPATCHES at runtime, the same shape PHP uses:
# array on the left appends, string concatenates, number adds.
add = "common:powershell.add"

[builtin_slots.int]
to_string = "common:dotnet.tostring_runtime"

# The MIRROR of `[builtin_slots.char] int`: `[char]65` is "A". Both directions
# are declared so a cast cannot resolve one way and not the other.
char = "common:powershell.to_char"

[builtin_slots.double]
to_string = "common:dotnet.tostring_runtime"

[builtin_slots.bool]
to_string = "common:dotnet.tostring_runtime"

# Widening a `char` to an integer reads its UTF-16 code point: `[int]'A'` is 65.
# That is the char/int COERCION SLOT (builtinslotplan.md §2a) and it is declared
# here rather than decided by a language check in the shared compiler.
[builtin_slots.char]
int = "common:powershell.to_int"

# ────────────────────────────────────────────────────────────────────────────

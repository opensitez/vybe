[info]
name = "powershell"
extensions = ["ps", "ps1", "psm1", "psd1"]

[compiler]
# Declared types CONVERT the value they bind (assignment, declaration and
# parameter entry alike). Stated explicitly rather than inherited: the platform
# default is `true`, and inheriting it silently gave Python coercive semantics
# it never chose.
coerces_value_to_type_hint = true
# The implicit-output rule is applied by the walker (`implicit_return`), which
# rewrites a trailing expression statement into a `Return` — one mechanism, not
# two, so the shared compiler stays generic.
function_return = "explicit"
case_sensitive = false
self_keyword = "this"
constructor_name = "constructor"
uses_common_resolver = true

# Route class declarations through `normalize_class.rs` -> `NormalClass` ->
# the shared `class_normalize::emit::emit_class_from_ast` pipeline, the same
# path C# and VB take. Without this the normalizer is registered but never
# consulted, so constructors are never wired.
uses_normalize_class = true

# `(5 -eq 5)` is the boolean $true, not 1 — comparisons must materialize as real
# booleans or every `$result -ne $true` check compares a number to a bool.
materialize_bool_results = true

# `$arr[-1]` is the LAST element — PowerShell indexes from the end for negatives.
negative_index_wraps = true

# `+` concatenates when a string is involved and adds numerically otherwise:
# `'a' + 'b'` is `'ab'`, `1 + 2` is `3`. PowerShell actually types the result
# from the LEFT operand (`5 + '5'` is `10`, `'5' + 5` is `'55'`), where this
# emits `'55'` for both; the left-operand rule needs a runtime-dispatching
# target, which would mean an emitter.
dynamic_add = true

[builtins]

"write-output" = { emit = "print", min_args = 0, max_args = 255 }
"write-host" = { emit = "print", min_args = 0, max_args = 255 }

echo = { emit = "print", min_args = 0, max_args = 255 }
"get-date" = { emit = "common:dotnet.datetime_now", min_args = 0, max_args = 0 }
exit = { emit = "common:control_flow.exit", min_args = 0, max_args = 1 }

# The other output streams. They are real writes in PowerShell, and the tests
# only require that they emit rather than fail, so they share `print`.
"write-verbose"     = { emit = "print", min_args = 0, max_args = 255 }
"write-warning"     = { emit = "print", min_args = 0, max_args = 255 }
"write-debug"       = { emit = "print", min_args = 0, max_args = 255 }
"write-information" = { emit = "print", min_args = 0, max_args = 255 }
"write-error"       = { emit = "print", min_args = 0, max_args = 255 }

# `Out-Null` discards its input. As a pipeline stage the walker drops the value
# outright; reached as a plain command there is nothing to emit.
"out-null"     = { emit = "noop", min_args = 0, max_args = 255 }
"write-progress" = { emit = "noop", min_args = 0, max_args = 255 }

# VALUE METHODS — instance methods called on values
# PowerShell is case-insensitive, but keep canonical and lowercase
# variants to cover both canonical profile wiring and normalized lookup paths.
[value_methods]

ToString = { emit = "common:dotnet.tostring_runtime", min_args = 0, max_args = 1 }
tostring = { emit = "common:dotnet.tostring_runtime", min_args = 0, max_args = 1 }

# .NET method spellings, routed to the SAME shared emitters C#/VB use. The
# language is case-insensitive, so `case_sensitive = false` in [compiler] makes
# one canonical spelling cover `ToUpper` / `toupper` / `TOUPPER`.
ToUpper       = { emit = "common:strings.to_upper",    min_args = 0, max_args = 0 }
ToLower       = { emit = "common:strings.to_lower",    min_args = 0, max_args = 0 }
Trim          = { emit = "common:strings.trim",        min_args = 0, max_args = 1 }
TrimStart     = { emit = "common:str_trim_start",      min_args = 0, max_args = 1 }
TrimEnd       = { emit = "common:str_trim_end",        min_args = 0, max_args = 1 }
StartsWith    = { emit = "common:str_starts_with",     min_args = 1, max_args = 1 }
EndsWith      = { emit = "common:str_ends_with",       min_args = 1, max_args = 1 }
Replace       = { emit = "common:strings.replace",     min_args = 2, max_args = 2 }
Split         = { emit = "common:strings.split",       min_args = 1, max_args = 2 }
Substring     = { emit = "common:strings.substring",   min_args = 1, max_args = 2 }
PadLeft       = { emit = "common:str_pad_start",       min_args = 1, max_args = 2 }
PadRight      = { emit = "common:str_pad_end",         min_args = 1, max_args = 2 }
ToCharArray   = { emit = "common:str_split",           min_args = 0, max_args = 0 }
Equals        = { emit = "common:object.equals",       min_args = 1, max_args = 2 }
# NO `Insert` / `Remove`. `str_insert` does not exist, and `str_splice` — the
# nearest primitive — takes FOUR operands (string, index, count, insert), so a
# two-argument mapping compiles and then fails at runtime inside the splice.
# They need a walker rewrite into substring arithmetic, not a profile line.

# Hashtable surface. `@{…}` walks to `ExprKind::Object`, so these are the shared
# dict primitives — the same ones Python's dict methods bind.
# Both spellings: the lookup that reaches these is the CANONICALIZED name, so a
# `case_sensitive = false` profile needs the folded key present — measured on
# `Contains`, where only the lowercase spelling bound.
ContainsKey   = { emit = "common:dict.has",            min_args = 1, max_args = 1 }
containskey   = { emit = "common:dict.has",            min_args = 1, max_args = 1 }
ContainsValue = { emit = "common:collections.contains", min_args = 1, max_args = 1 }
containsvalue = { emit = "common:collections.contains", min_args = 1, max_args = 1 }
Remove        = { emit = "common:dict.delete",         min_args = 1, max_args = 1 }
remove        = { emit = "common:dict.delete",         min_args = 1, max_args = 1 }
GetEnumerator = { emit = "common:dict.items",          min_args = 0, max_args = 0 }
getenumerator = { emit = "common:dict.items",          min_args = 0, max_args = 0 }
Keys          = { emit = "common:dict.keys",           min_args = 0, max_args = 0 }
keys          = { emit = "common:dict.keys",           min_args = 0, max_args = 0 }
Values        = { emit = "common:dict.values",         min_args = 0, max_args = 0 }
values        = { emit = "common:dict.values",         min_args = 0, max_args = 0 }

# Collection surface.
Add           = { emit = "common:collections.push",    min_args = 1, max_args = 255 }
Clear         = { emit = "common:collections.clear",   min_args = 0, max_args = 0 }
Clone         = { emit = "common:collections.slice",   min_args = 0, max_args = 0 }
Reverse       = { emit = "common:collections.reverse", min_args = 0, max_args = 0 }
Sort          = { emit = "common:collections.sorted",  min_args = 0, max_args = 1 }
Join          = { emit = "common:collections.join",    min_args = 0, max_args = 1 }

# `Contains` and `IndexOf` are shared spellings across strings and collections.
# `invoke:` here found nothing to invoke — `"abc".Contains("b")` answered false
# and `IndexOf` answered undefined. The string primitives are the ones the tests
# exercise; `[builtin_slots.array] contains` still covers the collection side of
# `-contains` / `-in`.
# MEASURED: a lowercase `contains` key here DOES bind `.Contains()` to the string
# primitive (`"hello".Contains("ell")` flips false -> true), but it then also
# beats `[builtin_slots.array] contains` for the `-contains` OPERATOR, which
# starts calling `substring` on an array. One spelling, two receivers: the method
# needs runtime dispatch, which means an emitter. The operator is the far more
# common construct in this corpus, so the slot keeps the name and `.Contains()`
# stays wrong — visibly, not silently.
Contains      = { emit = "common:str_contains",        min_args = 1, max_args = 1 }
IndexOf       = { emit = "common:str_index_of",        min_args = 1, max_args = 2 }
LastIndexOf   = { emit = "common:str_last_index_of",   min_args = 1, max_args = 2 }

[array_methods]
# PowerShell's .ForEach() yields the results, so it maps rather than iterates.
ForEach   = "__array_map"
Where     = "__array_filter"

# ────────────────────────────────────────────────────────────────────────────
# builtinslotplan.md — built-in type spellings and slot bindings
# ────────────────────────────────────────────────────────────────────────────

[builtin_types]
string = ["string", "str"]
int    = ["int", "integer"]
double = ["double", "float", "decimal"]
bool   = ["bool", "boolean"]
array  = ["array"]
map    = ["hashtable", "dictionary"]

# PowerShell follows .NET stringification rules for interpolation, `Write-Output`,
# and value printing. This makes `Format-` style calls and `${expr}` interpolation
# stay consistent with `ToString()` and `ToString("F")`.
[builtin_slots.string]
to_string = "common:dotnet.tostring_runtime"

# `-contains` / `-in` on an array are membership over VALUES; the shared
# collections primitive is the same one Pascal and Python bind here.
[builtin_slots.array]
contains = "common:collections.contains"
# NO `add` slot here. `[builtin_slots.array] add` is not "the array case of `+`"
# — `compile_binop` takes it as the target for EVERY `+`, which is why PHP binds
# a runtime-dispatching `common:php.add` rather than a collection primitive.
# Binding `collections.concat` here made `10 + 5` evaluate to `5`. PowerShell's
# `+` is string-concat-or-numeric, which is what `dynamic_add` above emits;
# array concatenation is the remaining gap and needs a runtime-dispatching
# target, not a slot.

[builtin_slots.int]
to_string = "common:dotnet.tostring_runtime"

[builtin_slots.double]
to_string = "common:dotnet.tostring_runtime"

[builtin_slots.bool]
to_string = "common:dotnet.tostring_runtime"

# ────────────────────────────────────────────────────────────────────────────
# .NET NAMESPACE RESOLUTION
# ────────────────────────────────────────────────────────────────────────────

[namespaces]
# Enable .NET runtime surface semantics; namespace lookup is data-driven by
# the common resolver through the tree mounts and ambient imports below.
use_dotnet = true
source_imports_are_namespaces = true

# Types under this namespace-tree path dispatch at RUNTIME through the type
# registry rather than through this language's value-method tables — `xs.Add(v)`
# on a .NET collection must reach the collection's own method, not an array
# builtin that happens to share the name. A PATH, not a language switch: the
# answer depends on where the declaring type lives.
runtime_collection_scope = ["dotnet", "system", "collections"]

# Namespace-tree roots this language resolves platform types against. `Button`
# / `Form` / `Dictionary` are .NET catalog entries, so member access on a
# statically-typed receiver looks them up under `dotnet`.
type_scopes = ["dotnet"]

